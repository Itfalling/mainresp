        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">AnimationPlayer</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationPlayer
	SCRIPT TYPE:  ModuleScript (shared animation core)
	WHERE:        ReplicatedStorage/Shared/Animation/AnimationPlayer
	DEPENDENCIES: Shared.Config.AnimationConfig, Shared.Util.Signal, Shared.Util.AssetId,
	              Shared.Animation.ProceduralFallback

	One AnimationPlayer per rig (R15 character, NPC or animal). Used by the
	client AnimationController (local character) and the server
	AnimationService (NPCs / animals) so there is exactly ONE implementation of
	loading, caching, priorities, markers and cleanup.

	  local player = AnimationPlayer.new(character, { EnableFallback = true })
	  local handle = player:Play("HammerSwing", {
	      Markers = { HammerHit = function() applyBuildProgress() end },
	  })
	  handle.Ended:Connect(function() end)

	Handles behave the same for real and placeholder animations:
	  * real Id        -> AnimationTrack + GetMarkerReachedSignal
	                      (+ watchdog if the uploaded animation forgot a marker)
	  * placeholder Id -> "virtual" track: markers fire at AnimationConfig times,
	                      Ended fires after Length / Speed.
	So gameplay code NEVER uses arbitrary task.wait() for animation timing.
]]

local RunService = game:GetService("RunService")

local Shared = script.Parent.Parent
local AnimationConfig = require(Shared.Config.AnimationConfig)
local AssetId = require(Shared.Util.AssetId)
local Signal = require(Shared.Util.Signal)
local ProceduralFallback = require(script.Parent.ProceduralFallback)

export type PlayOptions = {
	Speed: number?,
	FadeTime: number?,
	Weight: number?,
	Force: boolean?, -- play even if a non-interruptible animation is running
	Markers: { [string]: (handle: any) -> () }?,
}

local animationCache: { [string]: Animation } = {}
local warnedOnce: { [string]: boolean } = {}

local function warnOnce(key: string, message: string)
	if not warnedOnce[key] then
		warnedOnce[key] = true
		warn(message)
	end
end

local function getAnimationObject(id: string): Animation
	local animation = animationCache[id]
	if not animation then
		animation = Instance.new("Animation")
		animation.AnimationId = id
		animationCache[id] = animation
	end
	return animation
end

---------------------------------------------------------------------------
-- Handle
---------------------------------------------------------------------------

local Handle = {}
Handle.__index = Handle

function Handle.new(owner: any, name: string, def: any, speed: number)
	local self = setmetatable({
		Name = name,
		Def = def,
		Owner = owner,
		Speed = speed,
		Playing = true,
		Track = nil :: AnimationTrack?,
		Ended = Signal.new(),
		_callbacks = {} :: { [string]: { (any) -> () } },
		_connections = {} :: { RBXScriptConnection },
		_connectedMarkers = {} :: { [string]: boolean },
		_reached = {} :: { [string]: boolean },
		_threads = {} :: { thread },
		_stopFallback = nil :: (() -> ())?,
		_cycle = 0,
	}, Handle)
	return self
end

function Handle:IsPlaying(): boolean
	return self.Playing
end

function Handle:_reach(markerName: string, cycle: number?)
	if not self.Playing then
		return
	end
	if cycle and cycle ~= self._cycle then
		return
	end
	self._reached[markerName] = true
	local callbacks = self._callbacks[markerName]
	if callbacks then
		for _, callback in callbacks do
			task.spawn(callback, self)
		end
	end
	self.Owner.MarkerReached:Fire(self.Name, markerName, self)
end

function Handle:_connectRealMarker(markerName: string)
	local track = self.Track
	if not track or self._connectedMarkers[markerName] then
		return
	end
	self._connectedMarkers[markerName] = true
	table.insert(self._connections, track:GetMarkerReachedSignal(markerName):Connect(function()
		self:_reach(markerName)
	end))
end

function Handle:OnMarker(markerName: string, callback: (any) -> ())
	local list = self._callbacks[markerName]
	if not list then
		list = {}
		self._callbacks[markerName] = list
	end
	table.insert(list, callback)
	self:_connectRealMarker(markerName)
end

-- Schedules one virtual cycle: configured markers + end/loop.
function Handle:_scheduleVirtualCycle()
	self._cycle += 1
	local cycle = self._cycle
	local speed = math.max(self.Speed, 0.01)
	for markerName, time in self.Def.Markers do
		table.insert(self._threads, task.delay(time / speed, function()
			self:_reach(markerName, cycle)
		end))
	end
	table.insert(self._threads, task.delay(self.Def.Length / speed, function()
		if not self.Playing or cycle ~= self._cycle then
			return
		end
		if self.Def.Looped then
			self:_scheduleVirtualCycle()
		else
			self:_finish()
		end
	end))
end

-- Real tracks: fire any configured marker the uploaded animation never sent.
function Handle:_scheduleWatchdogs()
	if self.Def.Looped then
		return
	end
	local speed = math.max(self.Speed, 0.01)
	for markerName, time in self.Def.Markers do
		self:_connectRealMarker(markerName)
		table.insert(self._threads, task.delay(time / speed + AnimationConfig.MarkerWatchdogGrace, function()
			if self.Playing and not self._reached[markerName] then
				warnOnce(
					self.Name .. ":" .. markerName,
					("[Animation] '%s' never fired marker '%s' — add it in the Animation Editor. Firing from config timing."):format(self.Name, markerName)
				)
				self:_reach(markerName)
			end
		end))
	end
end

function Handle:_finish()
	if not self.Playing then
		return
	end
	self.Playing = false
	for _, connection in self._connections do
		connection:Disconnect()
	end
	table.clear(self._connections)
	for _, thread in self._threads do
		if coroutine.status(thread) == "suspended" then
			pcall(task.cancel, thread)
		end
	end
	table.clear(self._threads)
	if self._stopFallback then
		self._stopFallback()
		self._stopFallback = nil
	end
	if self.Owner._handles[self.Name] == self then
		self.Owner._handles[self.Name] = nil
	end
	self.Ended:Fire(self)
	self.Ended:DisconnectAll()
end

function Handle:Stop(fadeTime: number?)
	if not self.Playing then
		return
	end
	local track = self.Track
	if track then
		track:Stop(fadeTime or self.Def.FadeOut)
	end
	self:_finish()
end

function Handle:SetSpeed(speed: number)
	self.Speed = math.max(speed, 0.01)
	local track = self.Track
	if track then
		track:AdjustSpeed(self.Speed)
	end
end

---------------------------------------------------------------------------
-- AnimationPlayer
---------------------------------------------------------------------------

local AnimationPlayer = {}
AnimationPlayer.__index = AnimationPlayer

function AnimationPlayer.new(rig: Model, options: { EnableFallback: boolean? }?)
	local self = setmetatable({
		Rig = rig,
		MarkerReached = Signal.new(), -- (animationName, markerName, handle)
		_tracks = {} :: { [string]: AnimationTrack },
		_handles = {} :: { [string]: any },
		_enableFallback = options ~= nil and options.EnableFallback == true and AnimationConfig.UseProceduralFallback,
		_destroyed = false,
	}, AnimationPlayer)
	return self
end

function AnimationPlayer:_getAnimator(): Animator?
	local controller: Instance? = self.Rig:FindFirstChildOfClass("Humanoid") or self.Rig:FindFirstChildOfClass("AnimationController")
	if not controller then
		return nil
	end
	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator and RunService:IsServer() then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	return animator
end

-- Returns (and caches) the AnimationTrack, or nil for placeholder ids.
function AnimationPlayer:LoadTrack(name: string): AnimationTrack?
	local cached = self._tracks[name]
	if cached then
		return cached
	end
	local def = AnimationConfig.Get(name)
	if not def or AssetId.IsPlaceholder(def.Id) then
		return nil
	end
	local animator = self:_getAnimator()
	if not animator then
		warnOnce("NoAnimator:" .. self.Rig:GetFullName(), "[Animation] No Animator found on " .. self.Rig:GetFullName())
		return nil
	end
	local ok, track = pcall(animator.LoadAnimation, animator, getAnimationObject(def.Id))
	if not ok or not track then
		warnOnce("LoadFail:" .. name, ("[Animation] Failed to load '%s' (%s): %s"):format(name, def.Id, tostring(track)))
		return nil
	end
	local priority = (Enum.AnimationPriority :: any)[def.Priority]
	if priority then
		track.Priority = priority
	end
	track.Looped = def.Looped
	self._tracks[name] = track
	return track
end

-- Preload tracks so the first swing has no hitch.
function AnimationPlayer:Preload(names: { string })
	for _, name in names do
		self:LoadTrack(name)
	end
end

function AnimationPlayer:_blockedByNonInterruptible(): boolean
	for _, handle in self._handles do
		if handle.Playing and handle.Def.Interruptible == false and not handle.Def.Looped then
			return true
		end
	end
	return false
end

function AnimationPlayer:Play(name: string, options: PlayOptions?): any
	if self._destroyed then
		return nil
	end
	local opts: PlayOptions = options or {}
	local def = AnimationConfig.Get(name)
	if not def then
		warnOnce("Unknown:" .. name, "[Animation] Unknown animation '" .. name .. "' (add it to AnimationConfig)")
		return nil
	end
	if not opts.Force and self:_blockedByNonInterruptible() then
		return nil
	end

	local existing = self._handles[name]
	if existing then
		existing:Stop(0.05)
	end

	local speed = opts.Speed or 1
	local handle = Handle.new(self, name, def, speed)
	self._handles[name] = handle

	if opts.Markers then
		for markerName, callback in opts.Markers do
			handle:OnMarker(markerName, callback)
		end
	end

	local track = self:LoadTrack(name)
	if track then
		handle.Track = track
		-- Mark the handle before connecting so OnMarker callbacks registered above hook the track.
		for markerName in handle._callbacks do
			handle:_connectRealMarker(markerName)
		end
		table.insert(handle._connections, track.Stopped:Connect(function()
			-- With deferred signals a Stop()+Play() on the same cached track can
			-- deliver the old Stopped after the new Play; ignore it in that case.
			if track.IsPlaying then
				return
			end
			handle:_finish()
		end))
		track:Play(opts.FadeTime or def.FadeIn, opts.Weight or 1, speed)
		handle:_scheduleWatchdogs()
	else
		handle:_scheduleVirtualCycle()
		if self._enableFallback and ProceduralFallback.HasStyle(def.Fallback) then
			handle._stopFallback = ProceduralFallback.Play(self.Rig, def.Fallback, def.Length / math.max(speed, 0.01), def.Looped)
		end
	end

	return handle
end

function AnimationPlayer:Stop(name: string, fadeTime: number?)
	local handle = self._handles[name]
	if handle then
		handle:Stop(fadeTime)
	end
end

function AnimationPlayer:StopAll(fadeTime: number?)
	for _, handle in table.clone(self._handles) do
		handle:Stop(fadeTime)
	end
end

function AnimationPlayer:IsPlaying(name: string): boolean
	local handle = self._handles[name]
	return handle ~= nil and handle.Playing
end

function AnimationPlayer:GetHandle(name: string): any
	return self._handles[name]
end

function AnimationPlayer:SetSpeed(name: string, speed: number)
	local handle = self._handles[name]
	if handle then
		handle:SetSpeed(speed)
	end
end

function AnimationPlayer:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:StopAll(0)
	for _, track in self._tracks do
		track:Destroy()
	end
	table.clear(self._tracks)
	self.MarkerReached:DisconnectAll()
end

return AnimationPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">ProceduralFallback</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ProceduralFallback
	SCRIPT TYPE:  ModuleScript (shared, prototyping aid)
	WHERE:        ReplicatedStorage/Shared/Animation/ProceduralFallback
	DEPENDENCIES: Shared.Util.R15

	PROTOTYPE-ONLY arm poses used while AnimationConfig still has placeholder
	ids. It gently rotates the R15 shoulder Motor6D.C0 values so you can see
	swing timing line up with markers during development.

	  * Only the R15 RightShoulder / LeftShoulder motors are touched.
	  * The Animator never writes C0, so this never fights real animations.
	  * Changes made on a client are local to that client (not replicated).
	  * Disabled entirely by AnimationConfig.UseProceduralFallback = false, and
	    never used for animations that have a real Id.
]]

local RunService = game:GetService("RunService")

local R15 = require(script.Parent.Parent.Util.R15)

type Key = { T: number, R: Vector3, L: Vector3? }
type Style = { Keys: { Key } }

-- Angles are degrees applied to shoulder C0 (X+ raises the arm forward/up).
local STYLES: { [string]: Style } = {
	Hold = { Keys = { { T = 0, R = Vector3.new(25, 0, 0) }, { T = 1, R = Vector3.new(25, 0, 0) } } },
	Carry = { Keys = { { T = 0, R = Vector3.new(60, 0, 8), L = Vector3.new(60, 0, -8) }, { T = 1, R = Vector3.new(60, 0, 8), L = Vector3.new(60, 0, -8) } } },
	Swing = { Keys = {
		{ T = 0, R = Vector3.new(25, 0, 0) },
		{ T = 0.4, R = Vector3.new(160, 0, 0) },
		{ T = 0.5, R = Vector3.new(40, 0, 0) },
		{ T = 1, R = Vector3.new(25, 0, 0) },
	} },
	HeavySwing = { Keys = {
		{ T = 0, R = Vector3.new(25, 0, 0) },
		{ T = 0.45, R = Vector3.new(175, 0, 0), L = Vector3.new(120, 0, 0) },
		{ T = 0.56, R = Vector3.new(30, 0, 0), L = Vector3.new(30, 0, 0) },
		{ T = 1, R = Vector3.new(25, 0, 0) },
	} },
	Dig = { Keys = {
		{ T = 0, R = Vector3.new(20, 0, 0), L = Vector3.new(20, 0, 0) },
		{ T = 0.35, R = Vector3.new(75, 0, 0), L = Vector3.new(75, 0, 0) },
		{ T = 0.55, R = Vector3.new(5, 0, 0), L = Vector3.new(5, 0, 0) },
		{ T = 1, R = Vector3.new(20, 0, 0), L = Vector3.new(20, 0, 0) },
	} },
	Till = { Keys = {
		{ T = 0, R = Vector3.new(20, 0, 0) },
		{ T = 0.4, R = Vector3.new(115, 0, 0) },
		{ T = 0.55, R = Vector3.new(15, 0, 0) },
		{ T = 1, R = Vector3.new(20, 0, 0) },
	} },
	Reach = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.5, R = Vector3.new(65, 0, 0) },
		{ T = 1, R = Vector3.new(0, 0, 0) },
	} },
	Pour = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.3, R = Vector3.new(70, 0, -20) },
		{ T = 1, R = Vector3.new(70, 0, -20) },
	} },
	Wave = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.2, R = Vector3.new(170, 0, -20) },
		{ T = 0.35, R = Vector3.new(170, 0, 20) },
		{ T = 0.5, R = Vector3.new(170, 0, -20) },
		{ T = 0.65, R = Vector3.new(170, 0, 20) },
		{ T = 0.8, R = Vector3.new(170, 0, 0) },
		{ T = 1, R = Vector3.new(0, 0, 0) },
	} },
	Cheer = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0), L = Vector3.new(0, 0, 0) },
		{ T = 0.25, R = Vector3.new(170, 0, 20), L = Vector3.new(170, 0, -20) },
		{ T = 0.5, R = Vector3.new(150, 0, 10), L = Vector3.new(150, 0, -10) },
		{ T = 0.75, R = Vector3.new(170, 0, 20), L = Vector3.new(170, 0, -20) },
		{ T = 1, R = Vector3.new(0, 0, 0), L = Vector3.new(0, 0, 0) },
	} },
	Point = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.2, R = Vector3.new(90, 0, 0) },
		{ T = 0.8, R = Vector3.new(90, 0, 0) },
		{ T = 1, R = Vector3.new(0, 0, 0) },
	} },
	Cast = { Keys = {
		{ T = 0, R = Vector3.new(25, 0, 0) },
		{ T = 0.35, R = Vector3.new(165, 0, 0) },
		{ T = 0.5, R = Vector3.new(60, 0, 0) },
		{ T = 1, R = Vector3.new(40, 0, 0) },
	} },
	Reel = { Keys = {
		{ T = 0, R = Vector3.new(40, 0, 0), L = Vector3.new(35, 0, 0) },
		{ T = 0.5, R = Vector3.new(55, 0, 10), L = Vector3.new(45, 0, 0) },
		{ T = 1, R = Vector3.new(40, 0, 0), L = Vector3.new(35, 0, 0) },
	} },
}

type Entry = { Style: Style, Start: number, Duration: number, Looped: boolean }
type RigState = {
	Rig: Model,
	Right: Motor6D?,
	Left: Motor6D?,
	RightOriginal: CFrame?,
	LeftOriginal: CFrame?,
	Base: Entry?,
	Action: Entry?,
}

local ProceduralFallback = {}

local states: { [Model]: RigState } = {}
local stepConnection: RBXScriptConnection? = nil

local function sample(keys: { Key }, alpha: number, useLeft: boolean): Vector3
	local function valueOf(key: Key): Vector3
		if useLeft then
			return key.L or Vector3.zero
		end
		return key.R
	end
	if alpha <= keys[1].T then
		return valueOf(keys[1])
	end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if alpha <= b.T then
			local span = math.max(b.T - a.T, 1e-3)
			local t = (alpha - a.T) / span
			t = t * t * (3 - 2 * t) -- smoothstep for less robotic motion
			return valueOf(a):Lerp(valueOf(b), t)
		end
	end
	return valueOf(keys[#keys])
end

local function toAngles(degrees: Vector3): CFrame
	return CFrame.Angles(math.rad(degrees.X), math.rad(degrees.Y), math.rad(degrees.Z))
end

local function restore(state: RigState)
	if state.Right and state.RightOriginal then
		state.Right.C0 = state.RightOriginal
	end
	if state.Left and state.LeftOriginal then
		state.Left.C0 = state.LeftOriginal
	end
end

local function step()
	local now = os.clock()
	for rig, state in states do
		if not rig.Parent then
			states[rig] = nil
			continue
		end
		local action = state.Action
		if action and not action.Looped and now - action.Start >= action.Duration then
			state.Action = nil
			action = nil
		end
		local entry = action or state.Base
		if not entry then
			restore(state)
			states[rig] = nil
			continue
		end
		local elapsed = now - entry.Start
		local alpha = if entry.Looped then (elapsed % entry.Duration) / entry.Duration else math.clamp(elapsed / entry.Duration, 0, 1)
		if state.Right and state.RightOriginal then
			state.Right.C0 = state.RightOriginal * toAngles(sample(entry.Style.Keys, alpha, false))
		end
		if state.Left and state.LeftOriginal then
			state.Left.C0 = state.LeftOriginal * toAngles(sample(entry.Style.Keys, alpha, true))
		end
	end
	if next(states) == nil and stepConnection then
		stepConnection:Disconnect()
		stepConnection = nil
	end
end

function ProceduralFallback.HasStyle(styleName: string?): boolean
	return styleName ~= nil and STYLES[styleName] ~= nil
end

-- Returns a stop function. Safe to call on any rig; no-ops for non-R15 rigs.
function ProceduralFallback.Play(rig: Model, styleName: string, duration: number, looped: boolean): () -> ()
	local style = STYLES[styleName]
	if not style or not R15.IsR15(rig) then
		return function() end
	end

	local state = states[rig]
	if not state then
		local right = R15.GetMotor(rig, "RightShoulder")
		local left = R15.GetMotor(rig, "LeftShoulder")
		local newState: RigState = {
			Rig = rig,
			Right = right,
			Left = left,
			RightOriginal = right and right.C0,
			LeftOriginal = left and left.C0,
		}
		states[rig] = newState
		state = newState
	end
	assert(state)

	local entry: Entry = { Style = style, Start = os.clock(), Duration = math.max(duration, 0.05), Looped = looped }
	if looped then
		state.Base = entry
	else
		state.Action = entry
	end

	if not stepConnection then
		stepConnection = RunService.Heartbeat:Connect(step)
	end

	return function()
		local current = states[rig]
		if not current then
			return
		end
		if current.Base == entry then
			current.Base = nil
		end
		if current.Action == entry then
			current.Action = nil
		end
	end
end

return ProceduralFallback
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Building</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">BuildingModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildingModels
	SCRIPT TYPE:  ModuleScript (shared)
	WHERE:        ReplicatedStorage/Shared/Building/BuildingModels
	DEPENDENCIES: Shared.Config.BuildingConfig

	Procedural, low-poly models for every building in BuildingConfig. Shared so
	the client's ghost preview and the server's real building are identical.

	Every part carries a "Stage" attribute (0 = always present). Construction
	reveals stages one hammer hit at a time (spec §11: foundation → walls →
	roof → details), via BuildingModels.SetStage().

	Model contract:
	  * PrimaryPart "Base": invisible footprint-sized plate used for overlap
	    checks and selection.
	  * WorldPivot = base centre on the ground, front facing -Z.
	To use real art instead, put a Model with the building id in
	ServerStorage/Buildings (see docs/ASSETS.md); tag its parts with Stage.
]]

local TweenService = game:GetService("TweenService")

local BuildingConfig = require(script.Parent.Parent.Config.BuildingConfig)

local BuildingModels = {}

local C = {
	Wood = Color3.fromRGB(170, 120, 72),
	WoodDark = Color3.fromRGB(112, 76, 46),
	Plaster = Color3.fromRGB(246, 234, 204),
	Stone = Color3.fromRGB(160, 158, 150),
	StoneDark = Color3.fromRGB(120, 118, 112),
	RoofRed = Color3.fromRGB(190, 78, 58),
	RoofBrown = Color3.fromRGB(120, 72, 52),
	RoofBlue = Color3.fromRGB(70, 110, 170),
	BarnRed = Color3.fromRGB(178, 58, 46),
	White = Color3.fromRGB(245, 245, 240),
	Glass = Color3.fromRGB(155, 215, 245),
	Leaf = Color3.fromRGB(80, 170, 70),
	Soil = Color3.fromRGB(105, 72, 45),
	Water = Color3.fromRGB(70, 160, 220),
	Warm = Color3.fromRGB(255, 200, 120),
}

type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	Wedge: boolean?,
	CanCollide: boolean?,
	Transparency: number?,
}

local function part(model: Model, stage: number, props: PartProps): BasePart
	local newPart: BasePart
	if props.Wedge then
		newPart = Instance.new("WedgePart")
	else
		local block = Instance.new("Part")
		block.Shape = props.Shape or Enum.PartType.Block
		newPart = block
	end
	newPart.Name = props.Name or "Piece"
	newPart.Anchored = true
	newPart.Size = props.Size
	newPart.CFrame = props.CFrame
	newPart.Color = props.Color
	newPart.Material = props.Material or Enum.Material.SmoothPlastic
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	local canCollide = if props.CanCollide == nil then true else props.CanCollide
	newPart.CanCollide = canCollide
	newPart.Transparency = props.Transparency or 0
	newPart:SetAttribute("Stage", stage)
	newPart:SetAttribute("BaseTransparency", newPart.Transparency)
	newPart:SetAttribute("BaseCanCollide", canCollide)
	newPart.Parent = model
	return newPart
end

local function cylinderY(height: number, diameter: number): (Vector3, CFrame)
	-- Roblox cylinders run along X; rotate so they stand up.
	return Vector3.new(height, diameter, diameter), CFrame.Angles(0, 0, math.rad(90))
end

-- Gable roof: two sloped wedges + two triangular gable ends.
local function gableRoof(model: Model, stageRoofA: number, stageRoofB: number, width: number, depth: number, baseY: number, rise: number, zOffset: number, color: Color3, gableColor: Color3)
	local halfDepth = depth / 2 + 0.8
	part(model, stageRoofA, {
		Name = "RoofFront",
		Wedge = true,
		Size = Vector3.new(width + 1.6, rise, halfDepth),
		CFrame = CFrame.new(0, baseY + rise / 2, zOffset - halfDepth / 2),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	part(model, stageRoofB, {
		Name = "RoofBack",
		Wedge = true,
		Size = Vector3.new(width + 1.6, rise, halfDepth),
		CFrame = CFrame.new(0, baseY + rise / 2, zOffset + halfDepth / 2) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	local gableWidth = (width - 0.6) / 2
	for _, z in { zOffset - (depth / 2 - 0.3), zOffset + (depth / 2 - 0.3) } do
		part(model, stageRoofB, {
			Name = "GableL",
			Wedge = true,
			Size = Vector3.new(0.6, rise, gableWidth),
			CFrame = CFrame.new(-gableWidth / 2, baseY + rise / 2, z) * CFrame.Angles(0, math.rad(90), 0),
			Color = gableColor,
		})
		part(model, stageRoofB, {
			Name = "GableR",
			Wedge = true,
			Size = Vector3.new(0.6, rise, gableWidth),
			CFrame = CFrame.new(gableWidth / 2, baseY + rise / 2, z) * CFrame.Angles(0, math.rad(-90), 0),
			Color = gableColor,
		})
	end
	part(model, stageRoofB, {
		Name = "Ridge",
		Size = Vector3.new(width + 1.8, 0.5, 0.6),
		CFrame = CFrame.new(0, baseY + rise, zOffset),
		Color = C.WoodDark,
		Material = Enum.Material.Wood,
	})
end

type HouseParams = {
	Width: number,
	Depth: number,
	WallHeight: number,
	RoofRise: number,
	WallColor: Color3,
	WallMaterial: Enum.Material,
	RoofColor: Color3,
	Steps: number,
	ZOffset: number?,
}

-- Walls with a door (front, -Z) and windows; 10 build groups mapped onto Steps.
local function house(model: Model, p: HouseParams)
	local function stage(group: number): number
		return math.max(1, math.ceil(group * p.Steps / 10))
	end
	local w, d, h = p.Width, p.Depth, p.WallHeight
	local z0 = p.ZOffset or 0
	local floorY = 0.6

	-- 1 foundation
	part(model, stage(1), { Name = "Foundation", Size = Vector3.new(w + 0.4, 1.6, d + 0.4), CFrame = CFrame.new(0, -0.5, z0), Color = C.Stone, Material = Enum.Material.Cobblestone })
	-- 2 floor + corner posts
	part(model, stage(2), { Name = "Floor", Size = Vector3.new(w - 0.2, 0.3, d - 0.2), CFrame = CFrame.new(0, 0.45, z0), Color = C.Wood, Material = Enum.Material.WoodPlanks })
	for _, x in { -(w / 2 - 0.45), w / 2 - 0.45 } do
		for _, z in { -(d / 2 - 0.45), d / 2 - 0.45 } do
			part(model, stage(2), { Name = "Post", Size = Vector3.new(0.9, h, 0.9), CFrame = CFrame.new(x, floorY + h / 2, z0 + z), Color = C.WoodDark, Material = Enum.Material.Wood })
		end
	end
	-- 3 back wall
	part(model, stage(3), { Name = "WallBack", Size = Vector3.new(w - 1.2, h, 0.6), CFrame = CFrame.new(0, floorY + h / 2, z0 + d / 2 - 0.3), Color = p.WallColor, Material = p.WallMaterial })
	-- 4 left wall + window
	part(model, stage(4), { Name = "WallLeft", Size = Vector3.new(0.6, h, d - 1.2), CFrame = CFrame.new(-(w / 2 - 0.3), floorY + h / 2, z0), Color = p.WallColor, Material = p.WallMaterial })
	part(model, stage(4), { Name = "WindowL", Size = Vector3.new(0.7, 2, 2.4), CFrame = CFrame.new(-(w / 2 - 0.3), floorY + h * 0.55, z0), Color = C.Glass, Material = Enum.Material.Glass, Transparency = 0.2 })
	-- 5 right wall + window
	part(model, stage(5), { Name = "WallRight", Size = Vector3.new(0.6, h, d - 1.2), CFrame = CFrame.new(w / 2 - 0.3, floorY + h / 2, z0), Color = p.WallColor, Material = p.WallMaterial })
	part(model, stage(5), { Name = "WindowR", Size = Vector3.new(0.7, 2, 2.4), CFrame = CFrame.new(w / 2 - 0.3, floorY + h * 0.55, z0), Color = C.Glass, Material = Enum.Material.Glass, Transparency = 0.2 })
	-- 6 front wall around the door
	local span = (w - 1.2) / 2
	local segment = span - 1.2
	for _, side in { -1, 1 } do
		part(model, stage(6), { Name = "WallFront", Size = Vector3.new(segment, h, 0.6), CFrame = CFrame.new(side * (1.2 + segment / 2), floorY + h / 2, z0 - (d / 2 - 0.3)), Color = p.WallColor, Material = p.WallMaterial })
		part(model, stage(6), { Name = "WindowF", Size = Vector3.new(math.min(2, segment - 0.8), 1.8, 0.7), CFrame = CFrame.new(side * (1.2 + segment / 2), floorY + h * 0.55, z0 - (d / 2 - 0.3)), Color = C.Glass, Material = Enum.Material.Glass, Transparency = 0.2 })
	end
	part(model, stage(6), { Name = "Lintel", Size = Vector3.new(2.4, h - 4.6, 0.6), CFrame = CFrame.new(0, floorY + 4.6 + (h - 4.6) / 2, z0 - (d / 2 - 0.3)), Color = p.WallColor, Material = p.WallMaterial })
	-- 7-8 roof
	gableRoof(model, stage(7), stage(8), w, d, floorY + h, p.RoofRise, z0, p.RoofColor, p.WallColor)
	-- 9 chimney
	part(model, stage(9), { Name = "Chimney", Size = Vector3.new(1.4, p.RoofRise + 2.4, 1.4), CFrame = CFrame.new(w / 4, floorY + h + (p.RoofRise + 2.4) / 2, z0 + d / 4), Color = C.StoneDark, Material = Enum.Material.Brick })
	-- 10 door + step + flower boxes
	part(model, stage(10), { Name = "Door", Size = Vector3.new(2.2, 4.4, 0.3), CFrame = CFrame.new(0, floorY + 2.2, z0 - (d / 2 - 0.05)), Color = C.WoodDark, Material = Enum.Material.Wood })
	part(model, stage(10), { Name = "Knob", Shape = Enum.PartType.Ball, Size = Vector3.new(0.3, 0.3, 0.3), CFrame = CFrame.new(0.7, floorY + 2.2, z0 - (d / 2 + 0.15)), Color = Color3.fromRGB(240, 200, 80), CanCollide = false })
	part(model, stage(10), { Name = "Step", Size = Vector3.new(3.2, 0.5, 1.4), CFrame = CFrame.new(0, 0.25, z0 - (d / 2 + 0.6)), Color = C.Stone, Material = Enum.Material.Slate })
	for _, side in { -1, 1 } do
		part(model, stage(10), { Name = "FlowerBox", Size = Vector3.new(math.min(2.2, segment - 0.6), 0.5, 0.6), CFrame = CFrame.new(side * (1.2 + segment / 2), floorY + h * 0.55 - 1.2, z0 - (d / 2 + 0.3)), Color = C.Wood, Material = Enum.Material.Wood, CanCollide = false })
		part(model, stage(10), { Name = "Flowers", Size = Vector3.new(math.min(2, segment - 0.8), 0.5, 0.4), CFrame = CFrame.new(side * (1.2 + segment / 2), floorY + h * 0.55 - 0.8, z0 - (d / 2 + 0.3)), Color = Color3.fromRGB(255, 120, 150), CanCollide = false })
	end
end

local function fenceLine(model: Model, stage: number, from: Vector3, to: Vector3, height: number, gap: number?)
	local direction = to - from
	local length = direction.Magnitude
	local unit = direction.Unit
	local center = (from + to) / 2
	local look = CFrame.lookAt(center, center + unit)
	if gap and gap > 0 then
		-- Two rail segments leaving a gate gap in the middle.
		local segment = (length - gap) / 2
		for _, sign in { -1, 1 } do
			local segmentCenter = center + unit * sign * (gap / 2 + segment / 2)
			local segmentLook = CFrame.lookAt(segmentCenter, segmentCenter + unit)
			for _, y in { height * 0.4, height * 0.8 } do
				part(model, stage, { Name = "Rail", Size = Vector3.new(0.25, 0.3, segment), CFrame = segmentLook + Vector3.new(0, y, 0), Color = C.Wood, Material = Enum.Material.Wood })
			end
		end
	else
		for _, y in { height * 0.4, height * 0.8 } do
			part(model, stage, { Name = "Rail", Size = Vector3.new(0.25, 0.3, length), CFrame = look + Vector3.new(0, y, 0), Color = C.Wood, Material = Enum.Material.Wood })
		end
	end
	local posts = math.max(2, math.floor(length / 3.2) + 1)
	for index = 0, posts - 1 do
		local point = from + unit * (length * index / (posts - 1))
		local inGap = gap and gap > 0 and (point - center).Magnitude < gap / 2
		if not inGap then
			part(model, stage, { Name = "Post", Size = Vector3.new(0.4, height, 0.4), CFrame = CFrame.new(point + Vector3.new(0, height / 2, 0)), Color = C.WoodDark, Material = Enum.Material.Wood })
		end
	end
end

local BUILDERS: { [string]: (Model, any) -> () } = {}

BUILDERS.SmallCottage = function(model, def)
	house(model, { Width = 10, Depth = 10, WallHeight = 7, RoofRise = 4, WallColor = C.Plaster, WallMaterial = Enum.Material.SmoothPlastic, RoofColor = C.RoofRed, Steps = def.Steps })
end

BUILDERS.WoodenCabin = function(model, def)
	house(model, { Width = 14, Depth = 12, WallHeight = 7.5, RoofRise = 4.5, WallColor = Color3.fromRGB(150, 100, 60), WallMaterial = Enum.Material.WoodPlanks, RoofColor = C.RoofBrown, Steps = def.Steps })
end

BUILDERS.StoneHouse = function(model, def)
	house(model, { Width = 14, Depth = 14, WallHeight = 8.5, RoofRise = 5, WallColor = C.Stone, WallMaterial = Enum.Material.Cobblestone, RoofColor = C.RoofBlue, Steps = def.Steps })
end

BUILDERS.Barn = function(model, def)
	local s = function(group: number): number
		return math.max(1, math.ceil(group * def.Steps / 7))
	end
	local w, d, h, z0 = 14, 12, 8, -5
	part(model, s(1), { Name = "Foundation", Size = Vector3.new(w + 0.4, 1.6, d + 0.4), CFrame = CFrame.new(0, -0.5, z0), Color = C.Stone, Material = Enum.Material.Cobblestone })
	part(model, s(1), { Name = "Floor", Size = Vector3.new(w - 0.2, 0.3, d - 0.2), CFrame = CFrame.new(0, 0.45, z0), Color = C.Wood, Material = Enum.Material.WoodPlanks })
	for _, x in { -(w / 2 - 0.45), w / 2 - 0.45 } do
		for _, z in { -(d / 2 - 0.45), d / 2 - 0.45 } do
			part(model, s(2), { Name = "Post", Size = Vector3.new(0.9, h, 0.9), CFrame = CFrame.new(x, 0.6 + h / 2, z0 + z), Color = C.White })
		end
	end
	part(model, s(2), { Name = "WallBack", Size = Vector3.new(w - 1.2, h, 0.6), CFrame = CFrame.new(0, 0.6 + h / 2, z0 + d / 2 - 0.3), Color = C.BarnRed, Material = Enum.Material.WoodPlanks })
	for _, side in { -1, 1 } do
		part(model, s(3), { Name = "WallSide", Size = Vector3.new(0.6, h, d - 1.2), CFrame = CFrame.new(side * (w / 2 - 0.3), 0.6 + h / 2, z0), Color = C.BarnRed, Material = Enum.Material.WoodPlanks })
	end
	local doorWidth = 4.4
	local segment = (w - 1.2 - doorWidth) / 2
	for _, side in { -1, 1 } do
		part(model, s(4), { Name = "WallFront", Size = Vector3.new(segment, h, 0.6), CFrame = CFrame.new(side * (doorWidth / 2 + segment / 2), 0.6 + h / 2, z0 - (d / 2 - 0.3)), Color = C.BarnRed, Material = Enum.Material.WoodPlanks })
	end
	part(model, s(4), { Name = "Lintel", Size = Vector3.new(doorWidth, h - 6, 0.6), CFrame = CFrame.new(0, 0.6 + 6 + (h - 6) / 2, z0 - (d / 2 - 0.3)), Color = C.BarnRed, Material = Enum.Material.WoodPlanks })
	gableRoof(model, s(5), s(6), w, d, 0.6 + h, 5, z0, C.RoofBrown, C.BarnRed)
	-- Open barn doors with the classic white X.
	for _, side in { -1, 1 } do
		local doorCFrame = CFrame.new(side * (doorWidth / 2 + 1.1), 0.6 + 3, z0 - (d / 2 + 0.2))
		part(model, s(6), { Name = "Door", Size = Vector3.new(2.2, 6, 0.3), CFrame = doorCFrame, Color = C.BarnRed, Material = Enum.Material.WoodPlanks })
		part(model, s(6), { Name = "DoorX1", Size = Vector3.new(0.3, 6.4, 0.2), CFrame = doorCFrame * CFrame.new(0, 0, -0.2) * CFrame.Angles(0, 0, math.rad(20)), Color = C.White, CanCollide = false })
		part(model, s(6), { Name = "DoorX2", Size = Vector3.new(0.3, 6.4, 0.2), CFrame = doorCFrame * CFrame.new(0, 0, -0.2) * CFrame.Angles(0, 0, math.rad(-20)), Color = C.White, CanCollide = false })
	end
	-- 7: fenced pen in front (z 1..11) with a trough and hay.
	fenceLine(model, s(7), Vector3.new(-6.6, 0, 1.2), Vector3.new(-6.6, 0, 10.6), 3)
	fenceLine(model, s(7), Vector3.new(6.6, 0, 1.2), Vector3.new(6.6, 0, 10.6), 3)
	fenceLine(model, s(7), Vector3.new(-6.6, 0, 10.6), Vector3.new(6.6, 0, 10.6), 3, 3)
	part(model, s(7), { Name = "Trough", Size = Vector3.new(4, 1, 1.2), CFrame = CFrame.new(-4, 0.5, 2.4), Color = C.WoodDark, Material = Enum.Material.Wood })
	part(model, s(7), { Name = "Hay", Size = Vector3.new(2, 1.4, 1.4), CFrame = CFrame.new(4.5, 0.7, 2.4), Color = Color3.fromRGB(225, 195, 90), Material = Enum.Material.Grass })
end

BUILDERS.ChickenCoop = function(model, def)
	local s = function(group: number): number
		return math.max(1, math.ceil(group * def.Steps / 5))
	end
	local w, d, h, z0, lift = 8, 6, 4, -2.6, 1.4
	for _, x in { -(w / 2 - 0.4), w / 2 - 0.4 } do
		for _, z in { -(d / 2 - 0.4), d / 2 - 0.4 } do
			part(model, s(1), { Name = "Stilt", Size = Vector3.new(0.6, lift, 0.6), CFrame = CFrame.new(x, lift / 2, z0 + z), Color = C.WoodDark, Material = Enum.Material.Wood })
		end
	end
	part(model, s(1), { Name = "Floor", Size = Vector3.new(w, 0.3, d), CFrame = CFrame.new(0, lift, z0), Color = C.Wood, Material = Enum.Material.WoodPlanks })
	part(model, s(2), { Name = "WallBack", Size = Vector3.new(w, h, 0.4), CFrame = CFrame.new(0, lift + h / 2, z0 + d / 2 - 0.2), Color = Color3.fromRGB(240, 210, 150), Material = Enum.Material.WoodPlanks })
	for _, side in { -1, 1 } do
		part(model, s(2), { Name = "WallSide", Size = Vector3.new(0.4, h, d - 0.8), CFrame = CFrame.new(side * (w / 2 - 0.2), lift + h / 2, z0), Color = Color3.fromRGB(240, 210, 150), Material = Enum.Material.WoodPlanks })
		part(model, s(2), { Name = "WallFront", Size = Vector3.new(w / 2 - 0.8, h, 0.4), CFrame = CFrame.new(side * (w / 4 + 0.4), lift + h / 2, z0 - (d / 2 - 0.2)), Color = Color3.fromRGB(240, 210, 150), Material = Enum.Material.WoodPlanks })
	end
	gableRoof(model, s(3), s(3), w, d, lift + h, 2.5, z0, C.RoofRed, Color3.fromRGB(240, 210, 150))
	part(model, s(4), { Name = "Ramp", Size = Vector3.new(1.4, 0.2, 1.6), CFrame = CFrame.new(0, lift / 2, z0 - d / 2 - 0.7) * CFrame.Angles(math.rad(-35), 0, 0), Color = C.Wood, Material = Enum.Material.WoodPlanks })
	part(model, s(4), { Name = "Nest", Size = Vector3.new(1.6, 0.6, 1.2), CFrame = CFrame.new(w / 2 + 0.6, lift + 1, z0), Color = Color3.fromRGB(225, 195, 90), Material = Enum.Material.Grass, CanCollide = false })
	fenceLine(model, s(5), Vector3.new(-4.6, 0, 0.6), Vector3.new(-4.6, 0, 6.6), 2)
	fenceLine(model, s(5), Vector3.new(4.6, 0, 0.6), Vector3.new(4.6, 0, 6.6), 2)
	fenceLine(model, s(5), Vector3.new(-4.6, 0, 6.6), Vector3.new(4.6, 0, 6.6), 2, 2)
end

BUILDERS.StorageChest = function(model, _def)
	part(model, 1, { Name = "Body", Size = Vector3.new(3.4, 2.2, 2.6), CFrame = CFrame.new(0, 1.1, 0), Color = Color3.fromRGB(150, 95, 52), Material = Enum.Material.Wood })
	part(model, 1, { Name = "BandL", Size = Vector3.new(0.3, 2.25, 2.65), CFrame = CFrame.new(-1.2, 1.1, 0), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Metal })
	part(model, 1, { Name = "BandR", Size = Vector3.new(0.3, 2.25, 2.65), CFrame = CFrame.new(1.2, 1.1, 0), Color = Color3.fromRGB(90, 90, 95), Material = Enum.Material.Metal })
	part(model, 2, { Name = "Lid", Size = Vector3.new(3.5, 0.9, 2.7), CFrame = CFrame.new(0, 2.65, 0), Color = Color3.fromRGB(150, 95, 52), Material = Enum.Material.Wood })
	part(model, 2, { Name = "Lock", Size = Vector3.new(0.5, 0.6, 0.2), CFrame = CFrame.new(0, 2.2, -1.35), Color = Color3.fromRGB(255, 200, 60), Material = Enum.Material.Metal, CanCollide = false })
end

BUILDERS.Well = function(model, _def)
	local ringSize, ringRotation = cylinderY(2.6, 5)
	part(model, 1, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = ringSize, CFrame = CFrame.new(0, 1.3, 0) * ringRotation, Color = C.Stone, Material = Enum.Material.Cobblestone })
	local waterSize, waterRotation = cylinderY(0.2, 4)
	part(model, 1, { Name = "Water", Shape = Enum.PartType.Cylinder, Size = waterSize, CFrame = CFrame.new(0, 2.5, 0) * waterRotation, Color = C.Water, Material = Enum.Material.Glass, CanCollide = false, Transparency = 0.3 })
	for _, x in { -2.2, 2.2 } do
		part(model, 2, { Name = "Post", Size = Vector3.new(0.5, 5, 0.5), CFrame = CFrame.new(x, 2.5 + 2.4, 0), Color = C.WoodDark, Material = Enum.Material.Wood })
	end
	part(model, 2, { Name = "Crossbar", Size = Vector3.new(4.9, 0.4, 0.4), CFrame = CFrame.new(0, 6.6, 0), Color = C.WoodDark, Material = Enum.Material.Wood })
	gableRoof(model, 3, 3, 4.8, 3.2, 7.2, 1.6, 0, C.RoofRed, C.WoodDark)
	part(model, 3, { Name = "Bucket", Size = Vector3.new(0.8, 0.8, 0.8), CFrame = CFrame.new(0, 5, 0), Color = C.WoodDark, Material = Enum.Material.Wood, CanCollide = false })
end

BUILDERS.WoodenFence = function(model, _def)
	fenceLine(model, 1, Vector3.new(-1.8, 0, 0), Vector3.new(1.8, 0, 0), 3.2)
end

BUILDERS.StonePath = function(model, _def)
	local shades = { Color3.fromRGB(175, 172, 165), Color3.fromRGB(155, 152, 146), Color3.fromRGB(185, 180, 170), Color3.fromRGB(165, 160, 150) }
	local index = 0
	for _, x in { -0.95, 0.95 } do
		for _, z in { -0.95, 0.95 } do
			index += 1
			part(model, 1, { Name = "Stone", Size = Vector3.new(1.8, 0.3, 1.8), CFrame = CFrame.new(x, 0.15, z) * CFrame.Angles(0, math.rad(index * 7), 0), Color = shades[index], Material = Enum.Material.Slate })
		end
	end
end

BUILDERS.Bench = function(model, _def)
	part(model, 1, { Name = "Seat", Size = Vector3.new(5.6, 0.4, 1.6), CFrame = CFrame.new(0, 1.5, 0), Color = C.Wood, Material = Enum.Material.WoodPlanks })
	part(model, 1, { Name = "Back", Size = Vector3.new(5.6, 1.4, 0.3), CFrame = CFrame.new(0, 2.5, 0.7), Color = C.Wood, Material = Enum.Material.WoodPlanks })
	for _, x in { -2.4, 2.4 } do
		for _, z in { -0.55, 0.55 } do
			part(model, 1, { Name = "Leg", Size = Vector3.new(0.4, 1.3, 0.4), CFrame = CFrame.new(x, 0.65, z), Color = C.WoodDark, Material = Enum.Material.Wood })
		end
	end
end

BUILDERS.FlowerBed = function(model, _def)
	part(model, 1, { Name = "Soil", Size = Vector3.new(3.4, 0.5, 3.4), CFrame = CFrame.new(0, 0.25, 0), Color = C.Soil, Material = Enum.Material.Ground })
	for _, spec in { { 0, -1.8, 4, 0.4 }, { 0, 1.8, 4, 0.4 }, { -1.8, 0, 0.4, 3.2 }, { 1.8, 0, 0.4, 3.2 } } do
		part(model, 1, { Name = "Border", Size = Vector3.new(spec[3], 0.7, spec[4]), CFrame = CFrame.new(spec[1], 0.35, spec[2]), Color = C.Wood, Material = Enum.Material.Wood })
	end
	local colors = { Color3.fromRGB(255, 105, 130), Color3.fromRGB(255, 212, 80), Color3.fromRGB(185, 125, 255), Color3.fromRGB(255, 255, 255) }
	local index = 0
	for _, x in { -1, 0, 1 } do
		for _, z in { -1, 0, 1 } do
			index += 1
			part(model, 1, { Name = "Stem", Size = Vector3.new(0.15, 1, 0.15), CFrame = CFrame.new(x, 1, z), Color = C.Leaf, CanCollide = false })
			part(model, 1, { Name = "Bloom", Shape = Enum.PartType.Ball, Size = Vector3.new(0.7, 0.7, 0.7), CFrame = CFrame.new(x, 1.55, z), Color = colors[index % #colors + 1], CanCollide = false })
		end
	end
end

BUILDERS.Lantern = function(model, _def)
	part(model, 1, { Name = "Foot", Size = Vector3.new(1.4, 0.4, 1.4), CFrame = CFrame.new(0, 0.2, 0), Color = C.StoneDark, Material = Enum.Material.Slate })
	part(model, 1, { Name = "Pole", Size = Vector3.new(0.4, 6, 0.4), CFrame = CFrame.new(0, 3.2, 0), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Metal })
	local lamp = part(model, 1, { Name = "Lamp", Size = Vector3.new(1, 1.3, 1), CFrame = CFrame.new(0, 6.6, 0), Color = C.Warm, Material = Enum.Material.Neon, CanCollide = false })
	part(model, 1, { Name = "Cap", Size = Vector3.new(1.4, 0.3, 1.4), CFrame = CFrame.new(0, 7.4, 0), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Metal })
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1.4
	light.Color = C.Warm
	light.Parent = lamp
end

BUILDERS.Campfire = function(model, _def)
	for index = 1, 8 do
		local angle = index / 8 * math.pi * 2
		part(model, 1, { Name = "Stone", Size = Vector3.new(0.9, 0.7, 0.9), CFrame = CFrame.new(math.cos(angle) * 1.5, 0.35, math.sin(angle) * 1.5) * CFrame.Angles(0, angle, 0), Color = C.StoneDark, Material = Enum.Material.Slate })
	end
	for index = 1, 3 do
		local angle = index / 3 * math.pi
		part(model, 2, { Name = "Log", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 0.5, 0.5), CFrame = CFrame.new(0, 0.45, 0) * CFrame.Angles(0, angle, math.rad(10)), Color = C.WoodDark, Material = Enum.Material.Wood })
	end
	local core = part(model, 2, { Name = "FireCore", Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(0, 0.8, 0), Color = Color3.fromRGB(255, 150, 50), Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.4 })
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 5
	fire.Parent = core
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Parent = core
end

-- Builds the model at the origin (base centre on the ground, front = -Z).
function BuildingModels.Build(buildingId: string): Model
	local def = BuildingConfig.Get(buildingId)
	assert(def, "Unknown building " .. tostring(buildingId))
	local model = Instance.new("Model")
	model.Name = buildingId
	local base = part(model, 0, {
		Name = "Base",
		Size = Vector3.new(def.Footprint.X, 0.2, def.Footprint.Y),
		CFrame = CFrame.new(0, 0.1, 0),
		Color = Color3.new(1, 1, 1),
		CanCollide = false,
		Transparency = 1,
	})
	local builder = BUILDERS[buildingId]
	if builder then
		builder(model, def)
	end
	model.PrimaryPart = base
	model.WorldPivot = CFrame.new()
	return model
end

-- Shows parts whose Stage <= stage. animate = fade newly revealed parts in.
function BuildingModels.SetStage(model: Model, stage: number, animate: boolean?)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local partStage = descendant:GetAttribute("Stage")
			if type(partStage) == "number" and partStage > 0 then
				local visible = partStage <= stage
				local baseTransparency = descendant:GetAttribute("BaseTransparency")
				local target = if visible then (if type(baseTransparency) == "number" then baseTransparency else 0) else 1
				local baseCollide = descendant:GetAttribute("BaseCanCollide")
				descendant.CanCollide = visible and baseCollide ~= false
				if animate and visible and descendant.Transparency >= 0.99 and target < 0.99 then
					TweenService:Create(descendant, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Transparency = target }):Play()
				else
					descendant.Transparency = target
				end
				for _, child in descendant:GetChildren() do
					if child:IsA("Light") or child:IsA("Fire") or child:IsA("ParticleEmitter") then
						child.Enabled = visible
					end
				end
			end
		end
	end
end

-- Turns a model into a see-through, non-colliding placement preview.
function BuildingModels.MakeGhost(model: Model)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local baseTransparency = descendant:GetAttribute("BaseTransparency")
			descendant.Transparency = if type(baseTransparency) == "number" and baseTransparency >= 0.99 then 1 else 0.45
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
			descendant.Anchored = true
		elseif descendant:IsA("Light") or descendant:IsA("Fire") or descendant:IsA("ParticleEmitter") then
			descendant.Enabled = false
		end
	end
end

-- Number of hammer hits to finish this building.
function BuildingModels.GetSteps(buildingId: string): number
	local def = BuildingConfig.Get(buildingId)
	return if def then def.Steps else 1
end

return BuildingModels
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">AnimalConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/AnimalConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Animals, their products and the (gentle) care model.

	CARE LOOP:  Feed (costs Food) -> happiness up, production starts
	            -> after ProduceTime the product is READY -> Milk / Collect
	Happiness only drops while an animal is hungry, never below
	HappinessFloor, and high happiness gives a bonus product. Everything is
	computed from timestamps (Shared/Util/AnimalMath) — no per-frame work.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local AnimalConfig = {
	FullnessDurationMinutes = 12, -- a full animal gets hungry after this long
	HungryBelow = 25, -- fullness % at which it counts as hungry
	HappinessDecayPerMinute = 2, -- only while hungry
	HappinessFloor = 30,
	StartHappiness = 70,
	FeedHappiness = 15,
	PetHappiness = 8,
	PetCooldown = 30,
	BonusProduceAtHappiness = 80,
	WanderInterval = 2.5,
	ActiveRange = 160, -- animals only wander while a player is this close

	Animals = {
		Cow = {
			DisplayName = "Cow", Icon = "🐄", Price = 120, UnlockLevel = 1,
			Housing = "Barn", Food = "Wheat", FoodAmount = 1,
			Produce = "Milk", ProduceTime = 90, ProduceAmount = 1,
			ProduceVerb = "Milk Cow", ProduceTool = "Bucket", ProduceAnimation = "MilkCow", ProduceMarker = "Milk",
			ProduceVFX = "MilkSplash", ProduceSound = "Milk", WalkSpeed = 3, Voice = "CowMoo",
			Variants = {
				{ Id = "Brown", Weight = 50, Body = Color3.fromRGB(125, 85, 55), Spots = Color3.fromRGB(245, 240, 230) },
				{ Id = "Spotted", Weight = 42, Body = Color3.fromRGB(245, 245, 240), Spots = Color3.fromRGB(45, 40, 40) },
				{ Id = "Golden", Weight = 3, Body = Color3.fromRGB(245, 200, 70), Spots = Color3.fromRGB(255, 240, 180), ProduceBonus = 1 },
			},
		},
		Chicken = {
			DisplayName = "Chicken", Icon = "🐔", Price = 50, UnlockLevel = 1,
			Housing = "ChickenCoop", Food = "Wheat", FoodAmount = 1,
			Produce = "Egg", ProduceTime = 60, ProduceAmount = 1,
			ProduceVerb = "Collect Eggs", ProduceTool = nil, ProduceAnimation = "PickCrop", ProduceMarker = "Pick",
			ProduceVFX = "Sparkle", ProduceSound = "Harvest", WalkSpeed = 4, Voice = "ChickenCluck",
			Variants = {
				{ Id = "White", Weight = 55, Body = Color3.fromRGB(250, 250, 245), Spots = Color3.fromRGB(230, 60, 50) },
				{ Id = "Brown", Weight = 40, Body = Color3.fromRGB(170, 110, 60), Spots = Color3.fromRGB(230, 60, 50) },
				{ Id = "Golden", Weight = 3, Body = Color3.fromRGB(250, 205, 70), Spots = Color3.fromRGB(230, 60, 50), ProduceBonus = 1 },
			},
		},
	},

	Order = { "Cow", "Chicken" },

	Items = {
		Milk = { DisplayName = "Milk", Category = "AnimalProducts", Rarity = "Common", SellValue = 30, Icon = "🥛", Description = "Fresh milk from a happy cow." },
		Egg = { DisplayName = "Egg", Category = "AnimalProducts", Rarity = "Common", SellValue = 15, Icon = "🥚", Description = "A freshly laid egg." },
	},
}

for animalId, animal in AnimalConfig.Animals do
	animal.Id = animalId
end

return TableUtil.DeepFreeze(AnimalConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">AnimationConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/AnimationConfig
	DEPENDENCIES: Shared.Util.TableUtil

	!!! EVERY Id BELOW IS A PLACEHOLDER — NO REAL ANIMATIONS SHIP WITH THIS PROJECT !!!
	Replace "rbxassetid://PLACEHOLDER" with your uploaded R15 animation ids.
	See docs/ASSETS.md for how to author/upload them and which markers to add.

	Until an Id is real, AnimationPlayer:
	  * still fires every marker at the `Markers` times below (so gameplay works),
	  * still fires Ended after `Length` seconds,
	  * optionally plays a tiny procedural arm pose (`Fallback`) on the local
	    character so you can SEE the timing while prototyping.
	When you paste in a real Id nothing else changes: markers come from the
	animation itself (a watchdog still fires any marker the animation forgot).

	Field reference (spec §74):
		Id            rbxassetid:// of the uploaded animation
		Purpose       what gameplay it supports
		Priority      Core | Idle | Movement | Action | Action2 | Action3 | Action4
		Length        seconds (at Speed 1). Used for placeholder timing.
		Looped        loops until stopped
		Markers       { MarkerName = timeInSeconds } — gameplay reacts to these
		MarkerEffects { MarkerName = { Sound = "<SoundConfig id>", VFX = "<VFXConfig id>", Shake = number } }
		BodyParts     which R15 parts the animation should key (documentation for animators)
		Start / End   start + end conditions (documentation)
		Interruptible can a new action cut it off
		Fallback      procedural placeholder pose style (see ProceduralFallback)
		AnimateSlot   (Movement only) { childName, animationName } inside the default Animate script

	Priority rules (spec §73):
		Movement -> Movement | Tool actions -> Action | Building -> Action
		Fishing -> Action2 | Major interactions -> Action2
		Celebration -> Action3 | Death -> Action4
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER = "rbxassetid://PLACEHOLDER"

local ARMS = "RightUpperArm, RightLowerArm, RightHand, LeftUpperArm, LeftLowerArm, LeftHand, UpperTorso"
local FULL_BODY = "All R15 parts"

local function anim(def: { [string]: any })
	def.Id = def.Id or PLACEHOLDER
	def.Priority = def.Priority or "Action"
	def.Length = def.Length or 1
	def.Looped = def.Looped or false
	def.Markers = def.Markers or {}
	def.MarkerEffects = def.MarkerEffects or {}
	if def.Interruptible == nil then
		def.Interruptible = true
	end
	def.FadeIn = def.FadeIn or 0.1
	def.FadeOut = def.FadeOut or 0.15
	def.BodyParts = def.BodyParts or ARMS
	return def
end

local AnimationConfig = {
	-- Show procedural arm poses for placeholder animations (local player only).
	-- Purely a prototyping aid — set false once real animations are in.
	UseProceduralFallback = true,

	-- If a REAL animation is missing a configured marker, fire it anyway this
	-- many seconds after its configured time (and warn once).
	MarkerWatchdogGrace = 0.15,

	Categories = {
		Movement = {
			Idle = anim({ Purpose = "Standing idle", Priority = "Idle", Looped = true, Length = 2, BodyParts = FULL_BODY, AnimateSlot = { "idle", "Animation1" } }),
			Walk = anim({ Purpose = "Walking", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "walk", "WalkAnim" }, Markers = { Footstep = 0.25 } }),
			Run = anim({ Purpose = "Running", Priority = "Movement", Looped = true, Length = 0.8, BodyParts = FULL_BODY, AnimateSlot = { "run", "RunAnim" }, Markers = { Footstep = 0.2 } }),
			Jump = anim({ Purpose = "Jump start", Priority = "Movement", Length = 0.4, BodyParts = FULL_BODY, AnimateSlot = { "jump", "JumpAnim" } }),
			Fall = anim({ Purpose = "Falling", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "fall", "FallAnim" } }),
			Climb = anim({ Purpose = "Climbing", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "climb", "ClimbAnim" } }),
			Swim = anim({ Purpose = "Swimming", Priority = "Movement", Looped = true, Length = 1.2, BodyParts = FULL_BODY, AnimateSlot = { "swim", "Swim" } }),
			SwimIdle = anim({ Purpose = "Treading water", Priority = "Movement", Looped = true, Length = 2, BodyParts = FULL_BODY, AnimateSlot = { "swimidle", "SwimIdle" } }),
		},

		Tools = {
			ToolHoldIdle = anim({ Purpose = "Generic one-handed tool hold", Looped = true, Length = 2, Fallback = "Hold", Start = "Tool equipped", End = "Tool unequipped" }),
			AxeIdle = anim({ Purpose = "Holding an axe", Looped = true, Length = 2, Fallback = "Hold", Start = "Axe equipped", End = "Axe unequipped" }),
			AxeSwing = anim({
				Purpose = "Chop a tree",
				Length = 0.6,
				Markers = { Hit = 0.3 },
				MarkerEffects = { Hit = { Sound = "AxeSwing" } },
				Fallback = "Swing",
				Start = "UseTool with axe equipped",
				End = "Animation finishes (cooldown = ToolConfig UseCooldown)",
			}),
			AxeHeavySwing = anim({ Purpose = "Final chop / heavy hit", Length = 0.9, Markers = { Hit = 0.5 }, MarkerEffects = { Hit = { Sound = "AxeSwing", Shake = 0.25 } }, Fallback = "HeavySwing" }),
			PickaxeIdle = anim({ Purpose = "Holding a pickaxe", Looped = true, Length = 2, Fallback = "Hold" }),
			PickaxeSwing = anim({ Purpose = "Mine a rock", Length = 0.65, Markers = { Hit = 0.32 }, MarkerEffects = { Hit = { Sound = "PickaxeSwing" } }, Fallback = "Swing" }),
			PickaxeHeavySwing = anim({ Purpose = "Break a rock", Length = 0.95, Markers = { Hit = 0.52 }, MarkerEffects = { Hit = { Sound = "PickaxeSwing", Shake = 0.3 } }, Fallback = "HeavySwing" }),
			ShovelDig = anim({ Purpose = "Dig clay/sand", Length = 0.8, Markers = { Dig = 0.45 }, MarkerEffects = { Dig = { Sound = "ShovelDig", VFX = "DirtPuff" } }, Fallback = "Dig", BodyParts = FULL_BODY }),
			ShovelDigHeavy = anim({ Purpose = "Dig treasure", Length = 1.1, Markers = { Dig = 0.6 }, MarkerEffects = { Dig = { Sound = "ShovelDig", VFX = "DirtPuff" } }, Fallback = "Dig", BodyParts = FULL_BODY }),
			HoeTill = anim({ Purpose = "Till soil", Length = 0.7, Markers = { Till = 0.38 }, MarkerEffects = { Till = { Sound = "HoeTill", VFX = "DirtPuff" } }, Fallback = "Till" }),
			HoeSwing = anim({ Purpose = "Alias swing for hoe", Length = 0.7, Markers = { Till = 0.38 }, Fallback = "Till" }),
			WaterStart = anim({ Purpose = "Raise watering can", Length = 0.3, Fallback = "Pour" }),
			WaterLoop = anim({ Purpose = "Pouring water", Looped = true, Length = 0.8, Markers = { Water = 0.4 }, MarkerEffects = { Water = { VFX = "WaterSplash" } }, Fallback = "Pour" }),
			WaterEnd = anim({ Purpose = "Lower watering can", Length = 0.3, Fallback = "Pour" }),
		},

		Building = {
			BuildIdle = anim({ Purpose = "Holding hammer / build stance", Looped = true, Length = 2, Fallback = "Hold" }),
			-- Spec §74 reference timeline: 0.00 prepare, 0.16 raise, 0.31 HammerHit, 0.35 progress, 0.40 VFX, 0.65 end.
			HammerSwing = anim({
				Purpose = "Advance construction by one step",
				Length = 0.65,
				Markers = { HammerHit = 0.31 },
				MarkerEffects = { HammerHit = { Sound = "HammerHit", VFX = "BuildDust", Shake = 0.1 } },
				Fallback = "Swing",
				Start = "Player hammers a construction site",
				End = "Animation finishes; loop again if still building",
			}),
			HammerHeavy = anim({ Purpose = "Final hammer hit", Length = 0.9, Markers = { HammerHit = 0.5 }, MarkerEffects = { HammerHit = { Sound = "HammerHit", VFX = "BuildDust", Shake = 0.3 } }, Fallback = "HeavySwing" }),
			CarryMaterials = anim({ Purpose = "Carrying planks/stone", Looped = true, Length = 1, Fallback = "Carry" }),
			PlaceWood = anim({ Purpose = "Place a wood piece", Length = 0.7, Markers = { WoodPlace = 0.4 }, MarkerEffects = { WoodPlace = { Sound = "WoodPlace", VFX = "BuildDust" } }, Fallback = "Reach" }),
			PlaceStone = anim({ Purpose = "Place a stone piece", Length = 0.8, Markers = { StonePlace = 0.45 }, MarkerEffects = { StonePlace = { Sound = "StonePlace", VFX = "BuildDust" } }, Fallback = "Reach" }),
			SawWood = anim({ Purpose = "Sawing", Looped = true, Length = 0.6, Markers = { Saw = 0.3 }, MarkerEffects = { Saw = { Sound = "Saw" } }, Fallback = "Dig" }),
			PlantConstruction = anim({ Purpose = "Plant the construction stake", Length = 0.8, Markers = { Effect = 0.45 }, MarkerEffects = { Effect = { Sound = "ConstructionStart", VFX = "BuildDust" } }, Fallback = "Dig" }),
			Paint = anim({ Purpose = "Paint a structure", Looped = true, Length = 0.8, Markers = { Paint = 0.4 }, MarkerEffects = { Paint = { Sound = "Paint" } }, Fallback = "Wave" }),
			BuildFinish = anim({ Purpose = "Last touch on a building", Priority = "Action2", Length = 1, Markers = { BuildFinish = 0.55 }, MarkerEffects = { BuildFinish = { Sound = "BuildComplete", VFX = "BuildComplete", Shake = 0.35 } }, Fallback = "HeavySwing" }),
			CelebrateBuild = anim({ Purpose = "Celebrate a finished build", Priority = "Action3", Length = 1.4, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		Farming = {
			TillGround = anim({ Purpose = "Till a soil tile", Length = 0.7, Markers = { Till = 0.38 }, MarkerEffects = { Till = { Sound = "HoeTill", VFX = "DirtPuff" } }, Fallback = "Till" }),
			PlantSeed = anim({ Purpose = "Plant a seed", Length = 0.9, Markers = { Plant = 0.5 }, MarkerEffects = { Plant = { Sound = "PlantSeed", VFX = "DirtPuff" } }, Fallback = "Reach", BodyParts = FULL_BODY }),
			WaterPlant = anim({ Purpose = "Water a crop", Length = 1.2, Markers = { Water = 0.5 }, MarkerEffects = { Water = { Sound = "Watering", VFX = "WaterSplash" } }, Fallback = "Pour" }),
			HarvestCrop = anim({ Purpose = "Harvest a mature crop", Length = 0.8, Markers = { Pick = 0.42 }, MarkerEffects = { Pick = { Sound = "Harvest", VFX = "LeafBurst" } }, Fallback = "Reach", BodyParts = FULL_BODY }),
			PickCrop = anim({ Purpose = "Pick fruit from a plant", Length = 0.6, Markers = { Pick = 0.3 }, MarkerEffects = { Pick = { Sound = "Harvest", VFX = "LeafBurst" } }, Fallback = "Reach" }),
			CarryBasket = anim({ Purpose = "Carry a harvest basket", Looped = true, Length = 1, Fallback = "Carry" }),
			CelebrateHarvest = anim({ Purpose = "Big harvest celebration", Priority = "Action3", Length = 1.3, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		AnimalCare = {
			FeedAnimal = anim({ Purpose = "Feed an animal", Priority = "Action2", Length = 1, Markers = { Feed = 0.5 }, MarkerEffects = { Feed = { Sound = "Feed", VFX = "Hearts" } }, Fallback = "Reach" }),
			MilkCow = anim({ Purpose = "Milk a cow", Priority = "Action2", Length = 1.6, Markers = { Milk = 0.6 }, MarkerEffects = { Milk = { Sound = "Milk", VFX = "MilkSplash" } }, Fallback = "Dig", BodyParts = FULL_BODY, Interruptible = false }),
			PetAnimal = anim({ Purpose = "Pet an animal", Priority = "Action2", Length = 1.2, Markers = { Pet = 0.5 }, MarkerEffects = { Pet = { Sound = "Pet", VFX = "Hearts" } }, Fallback = "Wave" }),
			CarryBucket = anim({ Purpose = "Carry a bucket", Looped = true, Length = 1, Fallback = "Hold" }),
			FillTrough = anim({ Purpose = "Fill a feeding trough", Priority = "Action2", Length = 1.2, Markers = { Pour = 0.6 }, MarkerEffects = { Pour = { Sound = "Watering" } }, Fallback = "Pour" }),
		},

		Fishing = {
			FishingIdle = anim({ Purpose = "Holding the rod", Priority = "Action", Looped = true, Length = 2, Fallback = "Hold" }),
			FishingCast = anim({ Purpose = "Cast the line", Priority = "Action2", Length = 0.9, Markers = { Cast = 0.45 }, MarkerEffects = { Cast = { Sound = "FishingCast" } }, Fallback = "Cast" }),
			FishingWait = anim({ Purpose = "Waiting for a bite", Priority = "Action2", Looped = true, Length = 3, Fallback = "Hold" }),
			FishingBite = anim({ Purpose = "Rod jerks on a bite", Priority = "Action2", Length = 0.4, Markers = { Splash = 0.1 }, MarkerEffects = { Splash = { Sound = "FishBite", VFX = "WaterSplash" } }, Fallback = "Reel" }),
			FishingReel = anim({ Purpose = "Reeling in", Priority = "Action2", Looped = true, Length = 0.6, Markers = { Reel = 0.3 }, MarkerEffects = { Reel = { Sound = "Reel" } }, Fallback = "Reel" }),
			FishingStruggle = anim({ Purpose = "Fighting a strong fish", Priority = "Action2", Looped = true, Length = 0.8, Fallback = "Reel" }),
			FishingCatch = anim({ Purpose = "Pull the fish out", Priority = "Action2", Length = 1, Markers = { Catch = 0.5 }, MarkerEffects = { Catch = { Sound = "FishCatch", VFX = "WaterSplash" } }, Fallback = "HeavySwing" }),
			FishingFail = anim({ Purpose = "Fish escapes", Priority = "Action2", Length = 0.8, Fallback = "Reach" }),
			FishingCelebrate = anim({ Purpose = "Rare catch celebration", Priority = "Action3", Length = 1.5, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		Crafting = {
			CraftStart = anim({ Purpose = "Begin crafting", Length = 0.5, Fallback = "Reach" }),
			CraftWork = anim({ Purpose = "Crafting loop", Looped = true, Length = 0.7, Markers = { CraftHit = 0.35 }, MarkerEffects = { CraftHit = { Sound = "CraftHit" } }, Fallback = "Swing" }),
			CraftFinish = anim({ Purpose = "Crafting done", Priority = "Action2", Length = 0.8, Markers = { Effect = 0.4 }, MarkerEffects = { Effect = { Sound = "CraftComplete", VFX = "Sparkle" } }, Fallback = "Cheer" }),
		},

		Social = {
			Wave = anim({ Purpose = "Wave", Priority = "Action3", Length = 1.5, Fallback = "Wave" }),
			Cheer = anim({ Purpose = "Cheer", Priority = "Action3", Length = 1.3, BodyParts = FULL_BODY, Fallback = "Cheer" }),
			Celebrate = anim({ Purpose = "Level up / unlock celebration", Priority = "Action3", Length = 1.6, BodyParts = FULL_BODY, Fallback = "Cheer" }),
			Sit = anim({ Purpose = "Sit on benches", Priority = "Action3", Looped = true, Length = 2, BodyParts = FULL_BODY }),
			Point = anim({ Purpose = "Point at something", Priority = "Action3", Length = 1.2, Fallback = "Point" }),
		},

		-- Non-humanoid rigs (AnimationController). Used from Phase 6.
		Cow = {
			CowIdle = anim({ Purpose = "Cow idle", Priority = "Idle", Looped = true, Length = 3, BodyParts = "Cow rig" }),
			CowWalk = anim({ Purpose = "Cow walk", Priority = "Movement", Looped = true, Length = 1.2, BodyParts = "Cow rig" }),
			CowEat = anim({ Purpose = "Cow eating", Looped = true, Length = 2, BodyParts = "Cow rig", Markers = { Chew = 1 } }),
			CowDrink = anim({ Purpose = "Cow drinking", Looped = true, Length = 2, BodyParts = "Cow rig" }),
			CowHappy = anim({ Purpose = "Cow happy hop", Priority = "Action2", Length = 1.2, BodyParts = "Cow rig" }),
			CowSleep = anim({ Purpose = "Cow sleeping", Priority = "Idle", Looped = true, Length = 4, BodyParts = "Cow rig" }),
			CowMilk = anim({ Purpose = "Cow being milked", Priority = "Action2", Length = 1.6, BodyParts = "Cow rig" }),
			CowHitReaction = anim({ Purpose = "Cow startled", Priority = "Action2", Length = 0.6, BodyParts = "Cow rig" }),
			CowInteract = anim({ Purpose = "Cow looks at player", Priority = "Action", Length = 1.2, BodyParts = "Cow rig" }),
		},
	},

	-- Built below: flat lookup { [AnimationName] = def } (names must be unique).
	Index = {} :: { [string]: any },
}

for categoryName, entries in AnimationConfig.Categories do
	for name, def in entries do
		assert(AnimationConfig.Index[name] == nil, "Duplicate animation name: " .. name)
		def.Name = name
		def.Category = categoryName
		AnimationConfig.Index[name] = def
	end
end

function AnimationConfig.Get(name: string)
	return AnimationConfig.Index[name]
end

return TableUtil.DeepFreeze(AnimationConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">BuildConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/BuildConfig
	DEPENDENCIES: GameConfig, Shared.Util.TableUtil

	Placement rules shared by the client preview (BuildController) and the
	server validator (BuildService), so both always agree.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local GameConfig = require(script.Parent.GameConfig)

local BuildConfig = {
	GridSize = GameConfig.BuildGridSize,
	Rotations = { 0, 90, 180, 270 },
	MaxSlope = 4, -- max terrain height difference (studs) across a footprint
	PlacementRange = 80, -- how far from the player a building can be placed
	EdgeMargin = 1, -- footprint corners must be this far inside unlocked land
	PlaceCooldown = 0.5,
	HammerRange = 16,
	HammerCooldown = 0.45,
	OverlapShrink = 0.4, -- shrink overlap boxes so neighbours can touch

	-- Island model folders whose contents block placement.
	BlockingFolders = { "Buildings", "Landmarks", "Interactables", "Resources", "Crops", "FishingSpots", "AreaMarkers", "Decorations", "Animals" },
}

return TableUtil.DeepFreeze(BuildConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">BuildingConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildingConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/BuildingConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every placeable structure. Models are procedural (Shared/Building/
	BuildingModels) so the game runs with no uploaded meshes; each model part
	carries a Stage number so construction reveals the building piece by
	piece — one stage per hammer hit (Steps).

		Cost        { Coins, Items = { Wood = n, ... } } charged atomically by BuildService
		Footprint   Vector2 studs (X, Z) at rotation 0
		Height      used for overlap checks
		Steps       hammer hits to finish construction
		UnlockLevel island level required
		Capacity    housing: animals it holds, e.g. { Cow = 2 }
		CapacityBonus  backpack capacity added when complete
		Pen         housing: island-local offset of the animal pen centre + radius
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local BuildingConfig = {
	RefundPercent = 0.5, -- deleting a building refunds this share of its cost

	Categories = {
		{ Id = "Homes", DisplayName = "Homes", Icon = "🏠" },
		{ Id = "Farm", DisplayName = "Farm", Icon = "🐄" },
		{ Id = "Utility", DisplayName = "Utility", Icon = "🧰" },
		{ Id = "Decoration", DisplayName = "Decor", Icon = "🌸" },
	},

	Buildings = {
		-- HOMES
		SmallCottage = {
			Category = "Homes", DisplayName = "Small Cottage", Icon = "🏡", Order = 1,
			Description = "A cosy first home for your island.",
			Cost = { Coins = 100, Items = { Wood = 30, Stone = 10 } },
			Footprint = Vector2.new(10, 10), Height = 12, Steps = 6, UnlockLevel = 1,
		},
		WoodenCabin = {
			Category = "Homes", DisplayName = "Wooden Cabin", Icon = "🛖", Order = 2,
			Description = "A roomy log cabin with a front porch.",
			Cost = { Coins = 250, Items = { Wood = 60, Stone = 25, Fiber = 10 } },
			Footprint = Vector2.new(14, 12), Height = 13, Steps = 8, UnlockLevel = 3,
		},
		StoneHouse = {
			Category = "Homes", DisplayName = "Stone House", Icon = "🏘️", Order = 3,
			Description = "Solid stone walls built to last.",
			Cost = { Coins = 600, Items = { Stone = 80, Wood = 40, Iron = 5 } },
			Footprint = Vector2.new(14, 14), Height = 15, Steps = 10, UnlockLevel = 6,
		},

		-- FARM
		Barn = {
			Category = "Farm", DisplayName = "Barn", Icon = "🐄", Order = 1,
			Description = "Houses 2 cows. Required before you can buy a cow.",
			Cost = { Coins = 150, Items = { Wood = 40, Stone = 15 } },
			Footprint = Vector2.new(14, 22), Height = 13, Steps = 7, UnlockLevel = 1,
			Capacity = { Cow = 2 }, Pen = { Offset = Vector2.new(0, 5.5), Radius = 4.5 },
		},
		ChickenCoop = {
			Category = "Farm", DisplayName = "Chicken Coop", Icon = "🐔", Order = 2,
			Description = "Houses 4 chickens. Required before you can buy chickens.",
			Cost = { Coins = 80, Items = { Wood = 25, Fiber = 5 } },
			Footprint = Vector2.new(10, 14), Height = 8, Steps = 5, UnlockLevel = 1,
			Capacity = { Chicken = 4 }, Pen = { Offset = Vector2.new(0, 3.5), Radius = 3 },
		},

		-- UTILITY
		StorageChest = {
			Category = "Utility", DisplayName = "Storage Chest", Icon = "📦", Order = 1,
			Description = "+100 backpack capacity while it stands on your island.",
			Cost = { Coins = 60, Items = { Wood = 20 } },
			Footprint = Vector2.new(4, 4), Height = 4, Steps = 2, UnlockLevel = 1, CapacityBonus = 100,
		},
		Well = {
			Category = "Utility", DisplayName = "Stone Well", Icon = "🪣", Order = 2,
			Description = "A charming stone well for your village square.",
			Cost = { Coins = 40, Items = { Stone = 20, Wood = 5 } },
			Footprint = Vector2.new(6, 6), Height = 8, Steps = 3, UnlockLevel = 1,
		},

		-- DECORATION
		WoodenFence = {
			Category = "Decoration", DisplayName = "Wooden Fence", Icon = "🚧", Order = 1,
			Description = "Line your fields and paths.",
			Cost = { Coins = 0, Items = { Wood = 4 } },
			Footprint = Vector2.new(4, 1), Height = 4, Steps = 1, UnlockLevel = 1,
		},
		StonePath = {
			Category = "Decoration", DisplayName = "Stone Path", Icon = "🪨", Order = 2,
			Description = "A tidy stone path tile.",
			Cost = { Coins = 0, Items = { Stone = 3 } },
			Footprint = Vector2.new(4, 4), Height = 1, Steps = 1, UnlockLevel = 1,
		},
		Bench = {
			Category = "Decoration", DisplayName = "Bench", Icon = "🪑", Order = 3,
			Description = "Take a break and admire your island.",
			Cost = { Coins = 5, Items = { Wood = 8 } },
			Footprint = Vector2.new(6, 2), Height = 4, Steps = 1, UnlockLevel = 1,
		},
		FlowerBed = {
			Category = "Decoration", DisplayName = "Flower Bed", Icon = "🌷", Order = 4,
			Description = "A splash of colour.",
			Cost = { Coins = 10, Items = { Fiber = 4 } },
			Footprint = Vector2.new(4, 4), Height = 3, Steps = 1, UnlockLevel = 1,
		},
		Lantern = {
			Category = "Decoration", DisplayName = "Lantern", Icon = "🏮", Order = 5,
			Description = "A warm light for evening strolls.",
			Cost = { Coins = 10, Items = { Wood = 3, Stone = 2 } },
			Footprint = Vector2.new(2, 2), Height = 7, Steps = 1, UnlockLevel = 1,
		},
		Campfire = {
			Category = "Decoration", DisplayName = "Campfire", Icon = "🔥", Order = 6,
			Description = "Crackling and cosy.",
			Cost = { Coins = 0, Items = { Wood = 6, Stone = 6 } },
			Footprint = Vector2.new(4, 4), Height = 3, Steps = 2, UnlockLevel = 1,
		},
	},
}

for buildingId, def in BuildingConfig.Buildings do
	def.Id = buildingId
	def.Cost.Items = def.Cost.Items or {}
end

function BuildingConfig.Get(buildingId: any)
	if type(buildingId) ~= "string" then
		return nil
	end
	return BuildingConfig.Buildings[buildingId]
end

return TableUtil.DeepFreeze(BuildingConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CropConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CropConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/CropConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every crop and the farm plot layout. Growth is DATA-DRIVEN and computed
	from server timestamps (Shared/Util/CropGrowth), so crops keep growing
	while the player is offline and nothing ticks per frame.

	Per crop:
		SeedCost      shop price per seed
		GrowTime      seconds from planting to harvestable (unwatered)
		Yield         {Min, Max} produce per harvest
		SellValue     base market price of one produce item
		UnlockLevel   island level required to buy the seed
		Shape         visual style: Grain | Root | Tall | Bush

	Generated items: "<Crop>" (Category Crops) and "<Crop>Seeds" (Category Seeds).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local CropConfig = {
	-- Watering multiplies growth speed from the moment it is watered.
	WaterSpeedMultiplier = 1.5,

	Stages = { "Seed", "Sprout", "Small Plant", "Growing", "Mature", "Harvestable" },

	Farm = {
		TileSize = 4,
		TileGap = 0.8,
		Columns = 4,
		Rows = 3,
		StarterTiles = 6, -- tiles usable on a new island (the shop sells more, up to Columns x Rows)
	},

	Crops = {
		Wheat = {
			DisplayName = "Wheat", Icon = "🌾", SeedCost = 5, GrowTime = 60, Yield = { Min = 2, Max = 3 }, SellValue = 8,
			UnlockLevel = 1, Shape = "Grain", Rarity = "Common",
			StalkColor = Color3.fromRGB(150, 190, 70), ProduceColor = Color3.fromRGB(235, 200, 90),
			Description = "Golden grain. Sell it, or feed it to your animals.",
		},
		Carrot = {
			DisplayName = "Carrot", Icon = "🥕", SeedCost = 10, GrowTime = 120, Yield = { Min = 2, Max = 3 }, SellValue = 16,
			UnlockLevel = 1, Shape = "Root", Rarity = "Common",
			StalkColor = Color3.fromRGB(80, 170, 60), ProduceColor = Color3.fromRGB(255, 140, 40),
			Description = "Crunchy and orange. Grows underground.",
		},
		Potato = {
			DisplayName = "Potato", Icon = "🥔", SeedCost = 15, GrowTime = 150, Yield = { Min = 3, Max = 4 }, SellValue = 14,
			UnlockLevel = 2, Shape = "Root", Rarity = "Common",
			StalkColor = Color3.fromRGB(90, 160, 70), ProduceColor = Color3.fromRGB(190, 150, 95),
			Description = "A hearty island staple.",
		},
		Corn = {
			DisplayName = "Corn", Icon = "🌽", SeedCost = 20, GrowTime = 180, Yield = { Min = 2, Max = 3 }, SellValue = 30,
			UnlockLevel = 3, Shape = "Tall", Rarity = "Uncommon",
			StalkColor = Color3.fromRGB(110, 180, 60), ProduceColor = Color3.fromRGB(250, 215, 60),
			Description = "Tall stalks with sweet golden cobs.",
		},
		SugarCane = {
			DisplayName = "Sugar Cane", Icon = "🎋", SeedCost = 25, GrowTime = 200, Yield = { Min = 3, Max = 4 }, SellValue = 26,
			UnlockLevel = 4, Shape = "Tall", Rarity = "Uncommon",
			StalkColor = Color3.fromRGB(130, 190, 90), ProduceColor = Color3.fromRGB(200, 230, 150),
			Description = "Sweet stalks bakers love.",
		},
		Tomato = {
			DisplayName = "Tomato", Icon = "🍅", SeedCost = 30, GrowTime = 240, Yield = { Min = 3, Max = 5 }, SellValue = 32,
			UnlockLevel = 5, Shape = "Bush", Rarity = "Uncommon",
			StalkColor = Color3.fromRGB(70, 150, 60), ProduceColor = Color3.fromRGB(230, 50, 45),
			Description = "Juicy red tomatoes on a leafy vine.",
		},
		Strawberry = {
			DisplayName = "Strawberry", Icon = "🍓", SeedCost = 45, GrowTime = 300, Yield = { Min = 4, Max = 6 }, SellValue = 36,
			UnlockLevel = 6, Shape = "Bush", Rarity = "Rare",
			StalkColor = Color3.fromRGB(60, 150, 70), ProduceColor = Color3.fromRGB(240, 40, 80),
			Description = "Sweet berries worth waiting for.",
		},
	},

	-- Display order in shops / seed picker.
	Order = { "Wheat", "Carrot", "Potato", "Corn", "SugarCane", "Tomato", "Strawberry" },

	Items = {} :: { [string]: any },
	SeedToCrop = {} :: { [string]: string },
}

for cropId, crop in CropConfig.Crops do
	local seedId = cropId .. "Seeds"
	crop.Id = cropId
	crop.Seed = seedId
	CropConfig.SeedToCrop[seedId] = cropId
	CropConfig.Items[cropId] = {
		DisplayName = crop.DisplayName,
		Category = "Crops",
		Rarity = crop.Rarity,
		SellValue = crop.SellValue,
		Icon = crop.Icon,
		Description = crop.Description,
	}
	CropConfig.Items[seedId] = {
		DisplayName = crop.DisplayName .. " Seeds",
		Category = "Seeds",
		Rarity = "Common",
		SellValue = math.max(1, math.floor(crop.SeedCost / 2)),
		Icon = "🌱",
		Description = ("Plant on a tilled farm tile. Grows %s in %ds."):format(crop.DisplayName, crop.GrowTime),
	}
end

return TableUtil.DeepFreeze(CropConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  EconomyConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/EconomyConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Currencies and global economy knobs. Item base prices live on the item
	definitions (ResourceConfig / CropConfig / FishConfig ...), never here and
	never inside scripts.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local EconomyConfig = {
	Currencies = {
		Coins = { DisplayName = "Island Coins", Icon = "🪙", Max = 1e12, Color = Color3.fromRGB(255, 200, 40) },
		Gems = { DisplayName = "Gems", Icon = "💎", Max = 1e9, Color = Color3.fromRGB(90, 200, 255) },
	},

	-- Multiplier applied to every sale.
	GlobalSellMultiplier = 1,

	-- MARKET DEMAND (spec §65): every DemandInterval seconds a few goods get a
	-- clearly announced price bonus, giving players a reason to switch strategy.
	DemandInterval = 600,
	DemandItemCount = 2,
	DemandBonus = { Min = 0.2, Max = 0.4 },
	DemandCategories = { Crops = true, Fish = true, AnimalProducts = true },
}

return TableUtil.DeepFreeze(EconomyConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">FishConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FishConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/FishConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Fish, fishing zones and the reel minigame tuning. The SERVER rolls which
	fish bites (the client never names a fish); the client only plays the
	minigame, and the server checks the reel took a plausible amount of time.

	Zones come from where the fishing spot is: the starter dock is "Shore";
	unlocking areas adds River / Ocean / Cave spots (IslandConfig area Content).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local FishConfig = {
	CastCooldown = 1,
	BiteDelay = { Min = 2.5, Max = 6 }, -- seconds; better rods shorten it
	HookWindow = 1.6, -- seconds the player has to react to a bite
	MaxReelTime = 30,
	SpotRange = 14, -- how close the player must stand to a fishing spot

	-- Relative chance per rarity (rods multiply the rarer ones by RodLuck^(rank-1)).
	RarityWeights = { Common = 60, Uncommon = 26, Rare = 10, Epic = 3.2, Legendary = 0.7, Mythic = 0.1 },
	RodLuckPerTier = 0.12,

	-- Reel minigame (client simulates; server uses MinReelTime to reject impossible catches).
	Minigame = {
		StartProgress = 0.25,
		GainRate = 0.38, -- progress / second while the fish is inside the zone
		LossRate = 0.22,
		DifficultyScale = 0.15, -- gain is divided by (1 + Difficulty * scale)
		ZoneSize = 0.3, -- minus 0.03 per difficulty
		IndicatorSize = 0.06,
		Gravity = 2.4,
		Lift = 2.6,
		MaxSpeed = 1.3,
	},

	Zones = {
		Shore = { DisplayName = "Shoreline", Fish = { "Bluegill", "Sardine", "Clownfish", "Pufferfish", "GoldenKoi" } },
		River = { DisplayName = "Willow River", Fish = { "Trout", "Catfish", "Salmon", "RainbowTrout", "RiverKing" } },
		Ocean = { DisplayName = "Coral Ocean", Fish = { "Mackerel", "Tuna", "Swordfish", "Sunfish", "Marlin" } },
		Cave = { DisplayName = "Starfall Pool", Fish = { "Glowfish", "CrystalFish", "Moonfish", "Starfin" } },
	},

	Fish = {
		Bluegill = { DisplayName = "Bluegill", Rarity = "Common", SellValue = 12, Weight = { 0.2, 0.8 }, Difficulty = 1, Color = Color3.fromRGB(90, 150, 220), Description = "A friendly little fish that loves the shallows." },
		Sardine = { DisplayName = "Sardine", Rarity = "Common", SellValue = 10, Weight = { 0.1, 0.4 }, Difficulty = 1, Color = Color3.fromRGB(170, 190, 210), Description = "Small, silver and always in a hurry." },
		Clownfish = { DisplayName = "Clownfish", Rarity = "Uncommon", SellValue = 30, Weight = { 0.2, 0.5 }, Difficulty = 2, Color = Color3.fromRGB(255, 140, 40), Description = "Bright orange with white stripes." },
		Pufferfish = { DisplayName = "Pufferfish", Rarity = "Rare", SellValue = 85, Weight = { 0.5, 2 }, Difficulty = 3, Color = Color3.fromRGB(230, 210, 120), Description = "Puffs up when surprised. Handle gently!" },
		GoldenKoi = { DisplayName = "Golden Koi", Rarity = "Epic", SellValue = 260, Weight = { 1.5, 4 }, Difficulty = 4, Color = Color3.fromRGB(255, 200, 40), Description = "A lucky golden fish said to bless islands." },

		Trout = { DisplayName = "Trout", Rarity = "Uncommon", SellValue = 35, Weight = { 0.8, 2.5 }, Difficulty = 2, Color = Color3.fromRGB(150, 170, 120), Description = "A speckled river swimmer." },
		Catfish = { DisplayName = "Catfish", Rarity = "Common", SellValue = 22, Weight = { 1, 4 }, Difficulty = 1, Color = Color3.fromRGB(120, 110, 90), Description = "Whiskered bottom-dweller." },
		Salmon = { DisplayName = "Salmon", Rarity = "Rare", SellValue = 95, Weight = { 2, 6 }, Difficulty = 3, Color = Color3.fromRGB(240, 130, 110), Description = "Strong swimmer that fights the current." },
		RainbowTrout = { DisplayName = "Rainbow Trout", Rarity = "Epic", SellValue = 280, Weight = { 2, 5 }, Difficulty = 4, Color = Color3.fromRGB(200, 120, 220), Description = "Shimmers in every colour." },
		RiverKing = { DisplayName = "River King", Rarity = "Legendary", SellValue = 650, Weight = { 8, 20 }, Difficulty = 5, Color = Color3.fromRGB(80, 200, 160), Description = "The ruler of Willow River." },

		Mackerel = { DisplayName = "Mackerel", Rarity = "Common", SellValue = 20, Weight = { 0.5, 1.5 }, Difficulty = 1, Color = Color3.fromRGB(80, 120, 150), Description = "Striped and speedy." },
		Tuna = { DisplayName = "Tuna", Rarity = "Uncommon", SellValue = 60, Weight = { 5, 20 }, Difficulty = 2, Color = Color3.fromRGB(60, 80, 140), Description = "A powerful ocean fish." },
		Swordfish = { DisplayName = "Swordfish", Rarity = "Rare", SellValue = 160, Weight = { 20, 60 }, Difficulty = 3, Color = Color3.fromRGB(90, 110, 170), Description = "Fast, proud and pointy." },
		Sunfish = { DisplayName = "Sunfish", Rarity = "Epic", SellValue = 380, Weight = { 40, 120 }, Difficulty = 4, Color = Color3.fromRGB(220, 220, 200), Description = "A gentle giant that sunbathes at the surface." },
		Marlin = { DisplayName = "Blue Marlin", Rarity = "Legendary", SellValue = 850, Weight = { 60, 200 }, Difficulty = 5, Color = Color3.fromRGB(40, 90, 200), Description = "The ultimate ocean trophy." },

		Glowfish = { DisplayName = "Glowfish", Rarity = "Rare", SellValue = 170, Weight = { 0.5, 2 }, Difficulty = 3, Color = Color3.fromRGB(120, 255, 200), Description = "Lights up the dark cave pool." },
		CrystalFish = { DisplayName = "Crystal Fish", Rarity = "Epic", SellValue = 460, Weight = { 1, 3 }, Difficulty = 4, Color = Color3.fromRGB(150, 230, 255), Description = "Scales as clear as glass." },
		Moonfish = { DisplayName = "Moonfish", Rarity = "Legendary", SellValue = 1000, Weight = { 2, 6 }, Difficulty = 5, Color = Color3.fromRGB(220, 220, 255), Description = "Only bites when the cave is perfectly still." },
		Starfin = { DisplayName = "Starfin", Rarity = "Mythic", SellValue = 3000, Weight = { 3, 8 }, Difficulty = 5, Color = Color3.fromRGB(255, 120, 220), Description = "A fish made of starlight. Almost a legend." },
	},

	Items = {} :: { [string]: any },
}

for fishId, fish in FishConfig.Fish do
	fish.Id = fishId
	FishConfig.Items[fishId] = {
		DisplayName = fish.DisplayName,
		Category = "Fish",
		Rarity = fish.Rarity,
		SellValue = fish.SellValue,
		Icon = "🐟",
		Description = fish.Description,
	}
end

-- Seconds a perfect player needs to fill the reel bar (server rejects faster catches).
function FishConfig.MinReelTime(difficulty: number): number
	local minigame = FishConfig.Minigame
	local gain = minigame.GainRate / (1 + difficulty * minigame.DifficultyScale)
	return (1 - minigame.StartProgress) / gain * 0.8
end

return TableUtil.DeepFreeze(FishConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  GameConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/GameConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Global game settings. Anything a designer might want to tune lives in a
	Config module — never hard-code these values inside services/controllers.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local GameConfig = {
	GameName = "Build Your Island",
	Version = "0.2.0 (First Playable Loop)",

	-- Turn OFF before publishing. Enables verbose logs + /debug output.
	Debug = true,

	StartingCoins = 100,
	StartingGems = 0,
	StartingIslandLevel = 1,
	AutosaveInterval = 60, -- seconds between autosave sweeps (only dirty profiles are written)
	BuildGridSize = 2, -- used by BuildService (Phase 3)
	MaxIslandsPerServer = 8, -- keep >= Players.MaxPlayers in Game Settings

	Character = {
		RequireR15 = true,
		-- If a non-R15 character spawns (Game Settings not set to R15), rebuild it
		-- as R15 from the player's HumanoidDescription. Game Settings > Avatar >
		-- R15 is still the recommended primary setup.
		ForceR15 = true,
		RespawnDelay = 3,
		WalkSpeed = 16,
		JumpHeight = 7.2,
	},

	Camera = {
		MinZoom = 6,
		MaxZoom = 70,
		DefaultFieldOfView = 70,
		MaxShakeIntensity = 1.2, -- hard cap so shakes never become unpleasant
	},

	Inventory = {
		StartingCapacity = 200, -- total resource units the backpack holds
		MaxStack = 9999,
	},

	Data = {
		StoreName = "BuildYourIsland_PlayerData_v1",
		KeyPrefix = "Player_",
		-- "Auto": use the real DataStore, but fall back to an in-memory mock in
		-- Studio when API access is disabled. true = always mock. false = never.
		UseMockDataStore = "Auto",
		LoadAttempts = 5,
		SaveAttempts = 4,
		RetryBaseDelay = 1, -- exponential backoff base (seconds)
		SessionLockTimeout = 1800, -- a lock older than this is considered dead
		LockRetryDelay = 6,
		LockRetries = 5, -- after this many waits the lock is taken over
		StudioStealLocks = true, -- Studio sessions are single-player; don't wait on stale locks
		KickOnLoadFailure = true,
		ShutdownSaveTimeout = 25,
		SizeWarningBytes = 3_500_000,
	},

	AntiExploit = {
		StrikeWindow = 60, -- seconds strikes are remembered for
		WarnStrikes = 10,
		KickStrikes = 40,
		KickEnabled = true,
		MovementCheckInterval = 1,
		MaxSpeedMultiplier = 1.75, -- x WalkSpeed before a movement strike
		MovementSlack = 12, -- studs/sec extra allowance (knockback, slopes, lag)
		TeleportGrace = 3, -- seconds after a server teleport that movement is not checked
		LargeCurrencyGain = 1_000_000, -- single gains above this are logged for review
	},

	-- UserIds allowed to run admin chat commands (see AdminService).
	AdminUserIds = {} :: { number },
	AdminsInStudio = true,

	-- What the Starter Chest on every new island contains.
	StarterKit = {
		Coins = 50,
		Items = { Wood = 10, Stone = 5, Fiber = 5, WheatSeeds = 6 },
		Tools = { "WoodenAxe", "WoodenPickaxe", "WoodenHammer", "WoodenHoe", "WoodenWateringCan", "WoodenFishingRod" },
	},

	-- Lighting / world presentation (WorldService applies these).
	World = {
		ClockTime = 14.5,
		Brightness = 2.2,
		Ambient = Color3.fromRGB(110, 110, 125),
		OutdoorAmbient = Color3.fromRGB(150, 150, 165),
		EnvironmentDiffuseScale = 1,
		EnvironmentSpecularScale = 1,
		Atmosphere = {
			Density = 0.28,
			Offset = 0.1,
			Color = Color3.fromRGB(199, 225, 255),
			Decay = Color3.fromRGB(120, 160, 200),
			Glare = 0.15,
			Haze = 1.2,
		},
		WaterColor = Color3.fromRGB(40, 170, 200),
		WaterTransparency = 0.6,
		WaterReflectance = 0.25,
		WaterWaveSize = 0.12,
		WaterWaveSpeed = 8,
		MaterialColors = {
			Grass = Color3.fromRGB(106, 190, 72),
			LeafyGrass = Color3.fromRGB(92, 170, 60),
			Sand = Color3.fromRGB(240, 220, 160),
			Rock = Color3.fromRGB(128, 124, 118),
			Ground = Color3.fromRGB(140, 105, 70),
		},
		OceanDepth = 18,
		SeabedThickness = 8,
		OceanMargin = 600,
		OceanTileSize = 512,
	},
}

return TableUtil.DeepFreeze(GameConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">InputConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InputConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/InputConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Maps abstract ACTIONS to physical inputs for keyboard/mouse and gamepad.
	Touch devices trigger the same actions through on-screen buttons that call
	InputController.Trigger(actionName). Gameplay code only ever listens to
	actions, never to raw keys — that is what keeps mobile/console support free.

	Note: the ProximityPrompt interact key is E (Roblox default). Build mode
	pauses prompts while it is open so Q / E can rotate the preview.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local InputConfig = {
	Actions = {
		UseTool = {
			Inputs = { Enum.UserInputType.MouseButton1 },
			Gamepad = { Enum.KeyCode.ButtonR2 },
		},
		ToggleInventory = {
			Inputs = { Enum.KeyCode.I, Enum.KeyCode.G },
			Gamepad = { Enum.KeyCode.ButtonY },
		},
		ToggleBuild = {
			Inputs = { Enum.KeyCode.B },
			Gamepad = { Enum.KeyCode.DPadUp },
		},
		Cancel = {
			Inputs = { Enum.KeyCode.X },
			Gamepad = { Enum.KeyCode.ButtonB },
		},
		HotbarNext = { Inputs = {}, Gamepad = { Enum.KeyCode.ButtonR1 } },
		HotbarPrevious = { Inputs = {}, Gamepad = { Enum.KeyCode.ButtonL1 } },
		Hotbar1 = { Inputs = { Enum.KeyCode.One }, Gamepad = {} },
		Hotbar2 = { Inputs = { Enum.KeyCode.Two }, Gamepad = {} },
		Hotbar3 = { Inputs = { Enum.KeyCode.Three }, Gamepad = {} },
		Hotbar4 = { Inputs = { Enum.KeyCode.Four }, Gamepad = {} },
		Hotbar5 = { Inputs = { Enum.KeyCode.Five }, Gamepad = {} },
		Hotbar6 = { Inputs = { Enum.KeyCode.Six }, Gamepad = {} },
		Hotbar7 = { Inputs = { Enum.KeyCode.Seven }, Gamepad = {} },
		Hotbar8 = { Inputs = { Enum.KeyCode.Eight }, Gamepad = {} },
		-- Build mode
		BuildPlace = { Inputs = { Enum.UserInputType.MouseButton1 }, Gamepad = { Enum.KeyCode.ButtonR2 } },
		RotateBuild = { Inputs = { Enum.KeyCode.R }, Gamepad = { Enum.KeyCode.ButtonX } },
		RotateBuildLeft = { Inputs = { Enum.KeyCode.Q }, Gamepad = { Enum.KeyCode.DPadLeft } },
		RotateBuildRight = { Inputs = { Enum.KeyCode.E }, Gamepad = { Enum.KeyCode.DPadRight } },
	},

	-- Minimum on-screen button size for touch (Roblox recommends >= 44px).
	MinTouchButtonSize = 64,
}

return TableUtil.DeepFreeze(InputConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">IslandConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/IslandConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Island geometry, server slots, starter layout and expansion areas.

	COORDINATES: everything here is ISLAND-LOCAL. (0, 0) is the centre of the
	starter island at sea level. +Z is the "front" of the island (spawn + dock
	side, always open ocean). Saved building/crop/animal positions are also
	island-local, so an island can load into any slot on any server.

	AREA CONTENT gives every expansion a reason to exist (spec §120):
	resource nodes to gather, a fishing zone, or a second farm plot.

	EXPANSION AREAS are circular land lobes attached to the starter island.
	`Angle` is measured in degrees from +Z towards +X. A locked area shows an
	underwater sandbar and a 🔒 sign on the starter shore; unlocking it raises
	the land (IslandService.TryUnlockArea).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local IslandConfig = {
	SeaLevel = 0,
	SurfaceHeight = 6, -- grass height above sea level
	BeachHeight = 3,
	ShallowsHeight = 1.5,
	BeachWidth = 6,
	ShallowsWidth = 14,
	SandbarDepth = 4, -- how far below the surface a locked area's sandbar sits
	LandDepth = 24, -- how deep island terrain extends below sea level

	-- Server slot grid. Islands are SlotSpacing studs apart so they never touch.
	SlotSpacing = 1000,
	SlotsPerRow = 4,

	BuildMargin = 4, -- keep builds this far inside area edges
	DefaultNameFormat = "%s's Island",
	NameMaxLength = 24,
	DefaultTheme = "Tropical",

	-- Order matters: it is the unlock progression shown in the UI.
	AreaOrder = { "Starter", "Forest", "Farm", "River", "Beach", "Mountain", "StarfallCove", "Mainland" },

	Areas = {
		Starter = {
			DisplayName = "Starter Island",
			Angle = 0,
			Distance = 0,
			Radius = 70,
			Biome = "Meadow",
			Unlock = nil,
			Reward = "Your home. Trees, rocks, a farm plot and a dock to fish from.",
			Content = { FishingZone = "Shore" }, -- trees/rocks/bushes are hand-placed in StarterLayout
		},
		Forest = {
			DisplayName = "Whispering Forest",
			Angle = 300,
			Distance = 112,
			Radius = 55,
			Biome = "Forest",
			Unlock = { Coins = 500, IslandLevel = 2 },
			Reward = "Dense woods full of pine trees and fiber bushes.",
			Content = { Nodes = { PineTree = 8, Tree = 3, FiberBush = 5 } },
		},
		Farm = {
			DisplayName = "Sunny Fields",
			Angle = 60,
			Distance = 112,
			Radius = 55,
			Biome = "Meadow",
			Unlock = { Coins = 1500, IslandLevel = 4, RequiresArea = "Forest" },
			Reward = "A second 12-tile farm plot on wide, flat fields.",
			Content = { Nodes = { Tree = 2, FiberBush = 2 }, FarmPlot = true },
		},
		River = {
			DisplayName = "Willow River",
			Angle = 100,
			Distance = 115,
			Radius = 55,
			Biome = "River",
			Unlock = { Coins = 4000, IslandLevel = 7, RequiresArea = "Farm" },
			Reward = "River fishing (trout & salmon) and riverbank clay.",
			Content = { Nodes = { ClayPatch = 5, Tree = 2 }, FishingZone = "River" },
		},
		Beach = {
			DisplayName = "Coral Beach",
			Angle = 260,
			Distance = 115,
			Radius = 55,
			Biome = "Beach",
			Unlock = { Coins = 8000, IslandLevel = 10, RequiresArea = "River" },
			Reward = "Ocean fishing (tuna, swordfish) and sand piles.",
			Content = { Nodes = { SandPile = 6, FiberBush = 2 }, FishingZone = "Ocean" },
		},
		Mountain = {
			DisplayName = "Stonepeak Mountain",
			Angle = 220,
			Distance = 120,
			Radius = 62,
			Biome = "Mountain",
			Unlock = { Coins = 15000, IslandLevel = 14, RequiresArea = "Beach" },
			Reward = "Rocks and iron deposits — the key to better tools.",
			Content = { Nodes = { Rock = 6, IronRock = 5 } },
		},
		StarfallCove = {
			DisplayName = "Starfall Cove",
			Angle = 140,
			Distance = 120,
			Radius = 55,
			Biome = "Cave",
			Unlock = { Coins = 40000, IslandLevel = 20, RequiresArea = "Mountain" },
			Reward = "Crystal clusters and an epic cave fishing pool.",
			Content = { Nodes = { CrystalRock = 4, IronRock = 2 }, FishingZone = "Cave" },
		},
		Mainland = {
			DisplayName = "Great Mainland",
			Angle = 180,
			Distance = 140,
			Radius = 85,
			Biome = "Meadow",
			Unlock = { Coins = 100000, IslandLevel = 30, RequiresArea = "StarfallCove" },
			Reward = "Huge build space plus ancient trees.",
			Content = { Nodes = { Tree = 6, PineTree = 4, Rock = 5, AncientTree = 3 } },
		},
	},

	-- Starter island layout (island-local XZ; Y is found by raycasting terrain).
	StarterLayout = {
		Spawn = Vector2.new(0, 40),
		SpawnFacing = Vector2.new(0, -1), -- look towards the island centre
		StarterChest = Vector2.new(-9, 28),
		IslandSign = Vector2.new(9, 31),
		MarketStall = Vector2.new(30, 32),
		FishingSpot = Vector2.new(12, 104), -- on the end of the dock
		HousePlot = { Center = Vector2.new(-24, -6), Size = Vector2.new(26, 22) },
		FarmPlot = { Center = Vector2.new(26, -2), Size = Vector2.new(20, 16) },
		Dock = { Start = Vector2.new(12, 76), Length = 32, Width = 8 },
		Hills = {
			{ Center = Vector2.new(0, -38), Radius = 16, Height = 5 },
		},
		Palms = {
			Vector2.new(19, 52),
			Vector2.new(-23, 50),
			Vector2.new(44, 10),
			Vector2.new(-42, 22),
			Vector2.new(-16, -48),
			Vector2.new(17, -46),
		},
		FlowerPatches = {
			Vector2.new(-4, 14),
			Vector2.new(12, 18),
			Vector2.new(-36, 8),
			Vector2.new(-38, -22),
		},
		-- Gatherable starter nodes (ResourceService).
		Nodes = {
			{ Type = "Tree", Position = Vector2.new(-45, 5) },
			{ Type = "Tree", Position = Vector2.new(-50, -12) },
			{ Type = "Tree", Position = Vector2.new(-33, -35) },
			{ Type = "Tree", Position = Vector2.new(38, -30) },
			{ Type = "Tree", Position = Vector2.new(52, -15) },
			{ Type = "Tree", Position = Vector2.new(-20, -56) },
			{ Type = "Rock", Position = Vector2.new(-8, -24) },
			{ Type = "Rock", Position = Vector2.new(12, -22) },
			{ Type = "Rock", Position = Vector2.new(-40, 38) },
			{ Type = "Rock", Position = Vector2.new(45, 45) },
			{ Type = "FiberBush", Position = Vector2.new(-28, 18) },
			{ Type = "FiberBush", Position = Vector2.new(22, 14) },
			{ Type = "FiberBush", Position = Vector2.new(2, -12) },
		},
	},
}

return TableUtil.DeepFreeze(IslandConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ItemConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ItemConfig
	SCRIPT TYPE:  ModuleScript (shared config / registry)
	WHERE:        ReplicatedStorage/Shared/Config/ItemConfig
	DEPENDENCIES: ResourceConfig, RarityConfig, Shared.Util.TableUtil

	The ONE registry of inventory item IDs. InventoryService refuses any ID not
	found here, and DataSchema quarantines unknown IDs in saved data.

	Adding a new item source in a later phase:
		1. Create e.g. CropConfig with an `Items` table in the same shape.
		2. Add it to SOURCES below.
	Nothing else needs to change.
]]

local Config = script.Parent
local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local RarityConfig = require(Config.RarityConfig)

local SOURCES = {
	require(Config.ResourceConfig),
	require(Config.CropConfig),
	require(Config.FishConfig),
	require(Config.AnimalConfig),
	-- Phase 8: require(Config.RecipeConfig),
}

export type ItemDef = {
	Id: string,
	DisplayName: string,
	Category: string,
	Rarity: string,
	SellValue: number,
	Icon: string,
	Image: string?,
	Description: string,
	MaxStack: number?,
}

local ItemConfig = {
	-- Inventory tabs, in display order.
	Categories = {
		{ Id = "All", DisplayName = "All", Icon = "🎒" },
		{ Id = "Resources", DisplayName = "Resources", Icon = "🪵" },
		{ Id = "Crops", DisplayName = "Crops", Icon = "🌽" },
		{ Id = "Seeds", DisplayName = "Seeds", Icon = "🌱" },
		{ Id = "Fish", DisplayName = "Fish", Icon = "🐟" },
		{ Id = "AnimalProducts", DisplayName = "Animal", Icon = "🥛" },
		{ Id = "Materials", DisplayName = "Materials", Icon = "⛏️" },
		{ Id = "Crafted", DisplayName = "Crafted", Icon = "🍞" },
		{ Id = "Tools", DisplayName = "Tools", Icon = "🪓" },
		{ Id = "Decorations", DisplayName = "Decor", Icon = "🌸" },
	},
	Items = {} :: { [string]: ItemDef },
}

for _, source in SOURCES do
	for id, def in source.Items do
		assert(ItemConfig.Items[id] == nil, "Duplicate item id: " .. id)
		assert(RarityConfig.Rarities[def.Rarity], "Unknown rarity on item " .. id)
		local item = table.clone(def)
		item.Id = id
		ItemConfig.Items[id] = item
	end
end

function ItemConfig.Get(itemId: string): ItemDef?
	return ItemConfig.Items[itemId]
end

function ItemConfig.Exists(itemId: any): boolean
	return type(itemId) == "string" and ItemConfig.Items[itemId] ~= nil
end

return TableUtil.DeepFreeze(ItemConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ProgressionConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ProgressionConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ProgressionConfig
	DEPENDENCIES: Shared.Util.TableUtil

	XP curves, level titles and XP SOURCES. The server awards XP by source id
	(ProgressionService.Award(player, "StarterChest")); the amount always comes
	from this table, never from a client.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local ProgressionConfig = {
	Player = {
		MaxLevel = 100,
	},
	Island = {
		MaxLevel = 100,
		-- Rename freely; the highest title whose Level <= island level is shown.
		Titles = {
			{ Level = 1, Title = "Starter Island" },
			{ Level = 5, Title = "Small Farmer" },
			{ Level = 10, Title = "Established Island" },
			{ Level = 20, Title = "Prosperous Island" },
			{ Level = 35, Title = "Island Builder" },
			{ Level = 50, Title = "Master Islander" },
		},
	},

	-- XP granted per action. Player = player XP, Island = island XP.
	Sources = {
		StarterChest = { Player = 25, Island = 40 },
		UnlockArea = { Player = 100, Island = 150 },
		ChopTree = { Player = 3, Island = 2 },
		MineRock = { Player = 3, Island = 2 },
		GatherFiber = { Player = 2, Island = 1 },
		BuildStep = { Player = 2, Island = 1 },
		BuildComplete = { Player = 20, Island = 25 },
		PlantCrop = { Player = 1, Island = 1 },
		HarvestCrop = { Player = 4, Island = 3 },
		CatchFish = { Player = 8, Island = 4 }, -- multiplied by rarity rank
		FeedAnimal = { Player = 2, Island = 1 },
		CollectProduce = { Player = 6, Island = 4 },
		BuyAnimal = { Player = 10, Island = 15 },
		SellItems = { Player = 2, Island = 2 },
	},
}

-- XP needed to go from `level` to `level + 1`.
function ProgressionConfig.PlayerXPForLevel(level: number): number
	return math.floor(60 * level ^ 1.45)
end

function ProgressionConfig.IslandXPForLevel(level: number): number
	return math.floor(50 * level ^ 1.5)
end

function ProgressionConfig.GetIslandTitle(level: number): string
	local title = ProgressionConfig.Island.Titles[1].Title
	for _, entry in ProgressionConfig.Island.Titles do
		if level >= entry.Level then
			title = entry.Title
		end
	end
	return title
end

return TableUtil.DeepFreeze(ProgressionConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">QuestConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  QuestConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/QuestConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Progression quests that double as the tutorial (spec §118/§119): each quest
	teaches one part of the core loop, and finishing it starts the next.

	Task events (recorded by QuestService from server-side signals only):
		CollectItem     Target = item id        (gathered, not bought)
		BuildComplete   Target = building id or category
		PlantCrop / HarvestCrop   Target = crop id (optional)
		CatchFish       Target = fish id (optional)
		SellItem        Target = item id (optional)
		BuyAnimal / BuyTool       Target = id
		FeedAnimal      Target = animal id
		CollectProduce  Target = item id (Milk, Egg)
		UnlockArea      Target = area id
		IslandLevel     progress = current island level (not additive)
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local QuestConfig = {
	Chain = { "StartYourIsland", "FirstAnimal", "GrowYourIsland", "Adventurer" },

	Quests = {
		StartYourIsland = {
			DisplayName = "START YOUR ISLAND",
			Tasks = {
				{ Id = "Wood", Text = "Collect 20 Wood", Hint = "Equip your Axe and chop trees", Event = "CollectItem", Target = "Wood", Amount = 20 },
				{ Id = "Stone", Text = "Collect 10 Stone", Hint = "Equip your Pickaxe and mine rocks", Event = "CollectItem", Target = "Stone", Amount = 10 },
				{ Id = "House", Text = "Build your first house", Hint = "Press B (or 🔨) and pick Small Cottage", Event = "BuildComplete", Target = "Homes", Amount = 1 },
				{ Id = "Plant", Text = "Plant 5 crops", Hint = "Till and plant tiles on your farm plot", Event = "PlantCrop", Amount = 5 },
				{ Id = "Fish", Text = "Catch 1 fish", Hint = "Walk to the end of the dock and fish", Event = "CatchFish", Amount = 1 },
				{ Id = "Sell", Text = "Sell 1 item", Hint = "Visit the market stall near your spawn", Event = "SellItem", Amount = 1 },
			},
			Reward = { Coins = 250, XP = 100, IslandXP = 150 },
		},
		FirstAnimal = {
			DisplayName = "RAISE YOUR FIRST ANIMAL",
			Tasks = {
				{ Id = "Barn", Text = "Build a Barn", Hint = "Build mode → Farm → Barn", Event = "BuildComplete", Target = "Barn", Amount = 1 },
				{ Id = "Cow", Text = "Buy a Cow", Hint = "Market stall → Buy → Animals", Event = "BuyAnimal", Target = "Cow", Amount = 1 },
				{ Id = "Feed", Text = "Feed your Cow", Hint = "Feeding costs 1 Wheat", Event = "FeedAnimal", Target = "Cow", Amount = 1 },
				{ Id = "Milk", Text = "Milk your Cow", Hint = "Wait until the milk is READY", Event = "CollectProduce", Target = "Milk", Amount = 1 },
			},
			Reward = { Coins = 300, XP = 150, IslandXP = 200 },
		},
		GrowYourIsland = {
			DisplayName = "GROW YOUR ISLAND",
			Tasks = {
				{ Id = "Harvest", Text = "Harvest 20 crops", Hint = "Water crops to grow them faster", Event = "HarvestCrop", Amount = 20 },
				{ Id = "Fish", Text = "Catch 5 fish", Hint = "Better rods find rarer fish", Event = "CatchFish", Amount = 5 },
				{ Id = "Sell", Text = "Sell 30 items", Hint = "Check the market demand bonus!", Event = "SellItem", Amount = 30 },
				{ Id = "Forest", Text = "Unlock Whispering Forest", Hint = "Use the 🔒 sign on your shore", Event = "UnlockArea", Target = "Forest", Amount = 1 },
			},
			Reward = { Coins = 500, XP = 250, IslandXP = 300 },
		},
		Adventurer = {
			DisplayName = "ISLAND ADVENTURER",
			Tasks = {
				{ Id = "Pickaxe", Text = "Buy a Stone Pickaxe", Hint = "Market stall → Buy → Tools", Event = "BuyTool", Target = "StonePickaxe", Amount = 1 },
				{ Id = "Cabin", Text = "Build a Wooden Cabin", Hint = "Needs Island Level 3", Event = "BuildComplete", Target = "WoodenCabin", Amount = 1 },
				{ Id = "Chicken", Text = "Collect 3 Eggs", Hint = "Build a Chicken Coop and buy chickens", Event = "CollectProduce", Target = "Egg", Amount = 3 },
				{ Id = "Level", Text = "Reach Island Level 5", Hint = "Everything you do grows your island", Event = "IslandLevel", Amount = 5 },
			},
			Reward = { Coins = 1000, XP = 400, IslandXP = 500 },
		},
	},
}

for questId, quest in QuestConfig.Quests do
	quest.Id = questId
end

function QuestConfig.NextQuest(questId: string): string?
	local index = table.find(QuestConfig.Chain, questId)
	if not index then
		return nil
	end
	return QuestConfig.Chain[index + 1]
end

return TableUtil.DeepFreeze(QuestConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">RarityConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  RarityConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/RarityConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Central rarity table used by items, fish, animals, drops and UI colors.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local RarityConfig = {
	Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" },

	Rarities = {
		Common = { Rank = 1, DisplayName = "Common", Color = Color3.fromRGB(170, 170, 170), ValueMultiplier = 1, Glow = false },
		Uncommon = { Rank = 2, DisplayName = "Uncommon", Color = Color3.fromRGB(96, 200, 90), ValueMultiplier = 1.5, Glow = false },
		Rare = { Rank = 3, DisplayName = "Rare", Color = Color3.fromRGB(70, 150, 255), ValueMultiplier = 3, Glow = false },
		Epic = { Rank = 4, DisplayName = "Epic", Color = Color3.fromRGB(170, 90, 255), ValueMultiplier = 6, Glow = true },
		Legendary = { Rank = 5, DisplayName = "Legendary", Color = Color3.fromRGB(255, 180, 40), ValueMultiplier = 15, Glow = true },
		Mythic = { Rank = 6, DisplayName = "Mythic", Color = Color3.fromRGB(255, 80, 150), ValueMultiplier = 40, Glow = true },
	},
}

function RarityConfig.Get(rarity: string?)
	return RarityConfig.Rarities[rarity or "Common"] or RarityConfig.Rarities.Common
end

return TableUtil.DeepFreeze(RarityConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">RemoteConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  RemoteConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/RemoteConfig
	DEPENDENCIES: Shared.Util.TableUtil

	The complete, centralized list of network remotes. Net creates exactly
	these (and nothing else) inside ReplicatedStorage/Remotes when the server
	boots. All names are declared up-front — including ones later phases will
	use — so remote names never change between phases.

	RateLimits: token bucket per player per remote. Rate = tokens/second,
	Burst = bucket size. Requests over the limit are dropped and reported to
	AntiExploitService.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local RemoteConfig = {
	-- Client -> Server requests (RemoteEvent). The server validates EVERYTHING.
	ClientToServer = {
		"ClientReady", -- client finished loading; server replies with a full StateSync
		"EquipToolRequest", -- (toolId: string?) nil/"" = unequip
		"UnlockAreaRequest", -- (areaId: string)
		"GatherRequest", -- Phase 2
		"BuildRequest", -- Phase 3
		"DeleteBuildRequest", -- Phase 3
		"MoveBuildRequest", -- Phase 3
		"PlantCropRequest", -- Phase 4
		"WaterCropRequest", -- Phase 4
		"HarvestCropRequest", -- Phase 4
		"FishingRequest", -- Phase 5
		"AnimalInteractRequest", -- Phase 6
		"MilkAnimalRequest", -- Phase 6
		"SellItemRequest", -- Phase 7
		"PurchaseRequest", -- Phase 7
		"UpgradeRequest", -- Phase 7
		"CraftRequest", -- Phase 8
		"QuestRequest", -- Phase 10
		"IslandPermissionRequest", -- Phase 12
		"IslandVisitRequest", -- Phase 12
		"SettingsRequest", -- Phase 16
	},

	-- Server -> Client pushes (RemoteEvent).
	ServerToClient = {
		"StateSync", -- replicated profile data (full snapshot, then batched path ops)
		"Notify", -- toast / banner / reward popup
		"PlaySound", -- positional or 2D sound from SoundConfig
		"PlayVFX", -- effect from VFXConfig
		"CameraShake", -- small, capped camera shake
		"AnimationCommand", -- server asks the owning client to play/stop an animation
		"OpenUI", -- server asks the client to open a screen (Market, SeedPicker)
		"FishingEvent", -- cast / bite / reel / result updates for the fishing minigame
	},

	DefaultRateLimit = { Rate = 5, Burst = 10 },

	RateLimits = {
		ClientReady = { Rate = 0.2, Burst = 3 },
		EquipToolRequest = { Rate = 6, Burst = 10 },
		UnlockAreaRequest = { Rate = 1, Burst = 3 },
		GatherRequest = { Rate = 4, Burst = 6 },
		BuildRequest = { Rate = 4, Burst = 6 },
		DeleteBuildRequest = { Rate = 2, Burst = 4 },
		MoveBuildRequest = { Rate = 2, Burst = 4 },
		PlantCropRequest = { Rate = 6, Burst = 12 },
		WaterCropRequest = { Rate = 6, Burst = 12 },
		HarvestCropRequest = { Rate = 6, Burst = 12 },
		FishingRequest = { Rate = 4, Burst = 8 },
		AnimalInteractRequest = { Rate = 3, Burst = 6 },
		MilkAnimalRequest = { Rate = 2, Burst = 4 },
		SellItemRequest = { Rate = 3, Burst = 6 },
		PurchaseRequest = { Rate = 2, Burst = 4 },
		UpgradeRequest = { Rate = 2, Burst = 4 },
		CraftRequest = { Rate = 3, Burst = 6 },
		QuestRequest = { Rate = 2, Burst = 5 },
		IslandPermissionRequest = { Rate = 1, Burst = 3 },
		IslandVisitRequest = { Rate = 0.5, Burst = 2 },
		SettingsRequest = { Rate = 2, Burst = 5 },
	},

	-- Built below: set of every valid remote name -> direction.
	Known = {} :: { [string]: string },
}

for _, name in RemoteConfig.ClientToServer do
	RemoteConfig.Known[name] = "ClientToServer"
end
for _, name in RemoteConfig.ServerToClient do
	assert(RemoteConfig.Known[name] == nil, "Duplicate remote name " .. name)
	RemoteConfig.Known[name] = "ServerToClient"
end

return TableUtil.DeepFreeze(RemoteConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ResourceConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ResourceConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ResourceConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Raw gatherable resources + the resource NODES (trees, rocks, bushes...)
	that drop them. SellValue is the ONLY place the base price of a resource
	is defined (the market reads it through ItemConfig).

	NODES
		Resource        item id dropped
		Health          hit points (a tool hit deals Power x DamagePerPower)
		ToolType        tool type required (nil = gathered by hand)
		MinTier         minimum ToolConfig tier order (1 Wooden, 2 Stone, 3 Iron...)
		Drops           {Min, Max} per break (+1 chance from the tool's ResourceBonus)
		Respawn         seconds hidden before the node regrows (pooled, never destroyed)
		Action          verb shown on the prompt ("[E] Chop Tree")
		Animation/Marker  hand-gathered nodes only; tool nodes use the tool's Use animation
		XPSource        ProgressionConfig source id

	Icon: emoji used by the UI until real icon images exist. Image: optional
	Roblox image id (placeholder until you upload art).

	Future phases add their own item tables (CropConfig, FishConfig,
	AnimalConfig products, RecipeConfig outputs); ItemConfig merges them.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER_IMAGE = "rbxassetid://PLACEHOLDER"

local ResourceConfig = {
	Items = {
		-- COMMON
		Wood = { DisplayName = "Wood", Category = "Resources", Rarity = "Common", SellValue = 2, Icon = "🪵", Image = PLACEHOLDER_IMAGE, Description = "Sturdy logs chopped from island trees. The backbone of every build." },
		Stone = { DisplayName = "Stone", Category = "Resources", Rarity = "Common", SellValue = 3, Icon = "🪨", Image = PLACEHOLDER_IMAGE, Description = "Solid rock mined with a pickaxe. Used for foundations and tools." },
		Fiber = { DisplayName = "Fiber", Category = "Resources", Rarity = "Common", SellValue = 2, Icon = "🌾", Image = PLACEHOLDER_IMAGE, Description = "Tough plant fibers used for rope, nets and baskets." },
		Clay = { DisplayName = "Clay", Category = "Resources", Rarity = "Common", SellValue = 4, Icon = "🟫", Image = PLACEHOLDER_IMAGE, Description = "Soft riverbank clay. Fire it into bricks and pots." },
		Sand = { DisplayName = "Sand", Category = "Resources", Rarity = "Common", SellValue = 2, Icon = "⏳", Image = PLACEHOLDER_IMAGE, Description = "Fine beach sand. Glassmakers love it." },
		Water = { DisplayName = "Water", Category = "Resources", Rarity = "Common", SellValue = 1, Icon = "💧", Image = PLACEHOLDER_IMAGE, Description = "Fresh water from a well or pump. Crops and animals need it." },

		-- ADVANCED
		Iron = { DisplayName = "Iron Ore", Category = "Materials", Rarity = "Uncommon", SellValue = 12, Icon = "⛓️", Image = PLACEHOLDER_IMAGE, Description = "Ore from the mountain. Smelt it into iron tools." },
		Copper = { DisplayName = "Copper Ore", Category = "Materials", Rarity = "Uncommon", SellValue = 10, Icon = "🟠", Image = PLACEHOLDER_IMAGE, Description = "Shiny orange ore used for pipes and machinery." },
		Gold = { DisplayName = "Gold Ore", Category = "Materials", Rarity = "Rare", SellValue = 45, Icon = "🟡", Image = PLACEHOLDER_IMAGE, Description = "Precious ore buried deep in the mountain." },
		Crystal = { DisplayName = "Crystal", Category = "Materials", Rarity = "Epic", SellValue = 120, Icon = "💎", Image = PLACEHOLDER_IMAGE, Description = "A glowing crystal found only in island caves." },
		StarShard = { DisplayName = "Star Shard", Category = "Materials", Rarity = "Legendary", SellValue = 400, Icon = "🌟", Image = PLACEHOLDER_IMAGE, Description = "A fragment of a fallen star. Appears during meteor showers." },
		AncientWood = { DisplayName = "Ancient Wood", Category = "Materials", Rarity = "Epic", SellValue = 150, Icon = "🌳", Image = PLACEHOLDER_IMAGE, Description = "Timber from trees older than the island itself." },
	},

	Nodes = {
		Tree = {
			DisplayName = "Oak Tree", Resource = "Wood", Health = 100, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 3, Max = 5 }, Respawn = 40, Action = "Chop", XPSource = "ChopTree", Model = "Oak",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "LeafBurst", FallOver = true,
		},
		PineTree = {
			DisplayName = "Pine Tree", Resource = "Wood", Health = 125, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 4, Max = 6 }, Respawn = 50, Action = "Chop", XPSource = "ChopTree", Model = "Pine",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "LeafBurst", FallOver = true,
		},
		AncientTree = {
			DisplayName = "Ancient Tree", Resource = "AncientWood", Health = 300, ToolType = "Axe", MinTier = 3, DamagePerPower = 25,
			Drops = { Min = 1, Max = 2 }, Respawn = 300, Action = "Chop", XPSource = "ChopTree", Model = "Ancient",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "Sparkle", FallOver = true,
		},
		Rock = {
			DisplayName = "Rock", Resource = "Stone", Health = 100, ToolType = "Pickaxe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 2, Max = 4 }, Respawn = 50, Action = "Mine", XPSource = "MineRock", Model = "Rock",
			HitSound = "RockHit", BreakSound = "RockBreak", HitVFX = "RockChips", BreakVFX = "RockChips", Shake = 0.12,
		},
		IronRock = {
			DisplayName = "Iron Deposit", Resource = "Iron", Health = 150, ToolType = "Pickaxe", MinTier = 2, DamagePerPower = 25,
			Drops = { Min = 1, Max = 3 }, Respawn = 90, Action = "Mine", XPSource = "MineRock", Model = "Iron",
			HitSound = "RockHit", BreakSound = "RockBreak", HitVFX = "RockChips", BreakVFX = "RockChips", Shake = 0.15,
		},
		CrystalRock = {
			DisplayName = "Crystal Cluster", Resource = "Crystal", Health = 200, ToolType = "Pickaxe", MinTier = 3, DamagePerPower = 25,
			Drops = { Min = 1, Max = 2 }, Respawn = 180, Action = "Mine", XPSource = "MineRock", Model = "Crystal",
			HitSound = "RockHit", BreakSound = "RockBreak", HitVFX = "Sparkle", BreakVFX = "Sparkle", Shake = 0.15,
		},
		FiberBush = {
			DisplayName = "Fiber Bush", Resource = "Fiber", Health = 1, ToolType = nil, MinTier = 0, DamagePerPower = 1,
			Drops = { Min = 2, Max = 3 }, Respawn = 30, Action = "Pick", XPSource = "GatherFiber", Model = "Bush",
			Animation = "PickCrop", Marker = "Pick", HitSound = "Harvest", HitVFX = "LeafBurst", BreakVFX = "LeafBurst",
		},
		SandPile = {
			DisplayName = "Sand Pile", Resource = "Sand", Health = 1, ToolType = nil, MinTier = 0, DamagePerPower = 1,
			Drops = { Min = 2, Max = 4 }, Respawn = 40, Action = "Scoop", XPSource = "GatherFiber", Model = "Sand",
			Animation = "PickCrop", Marker = "Pick", HitSound = "ShovelDig", HitVFX = "DirtPuff", BreakVFX = "DirtPuff",
		},
		ClayPatch = {
			DisplayName = "Clay Patch", Resource = "Clay", Health = 1, ToolType = "Shovel", MinTier = 1, DamagePerPower = 1,
			Drops = { Min = 2, Max = 3 }, Respawn = 45, Action = "Dig", XPSource = "GatherFiber", Model = "Clay",
			HitSound = "ShovelDig", HitVFX = "DirtPuff", BreakVFX = "DirtPuff",
		},
	},
}

return TableUtil.DeepFreeze(ResourceConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">ShopConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ShopConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ShopConfig
	DEPENDENCIES: CropConfig, AnimalConfig, Shared.Util.TableUtil

	Everything the island market sells. Seeds and animals are generated from
	CropConfig / AnimalConfig so prices live in exactly one place.

		Price       coins per purchase
		Items       extra item cost (tool upgrades)
		Grant       { Item = id, Amount } | { Tool = id } | { Animal = id } | { Upgrade = id, Amount }
		UnlockLevel island level required
		MaxOwned    for upgrades: how many times it can be bought
		Bulk        seeds can be bought in bundles of this size too

	Selling uses item SellValue (ItemConfig) x EconomyConfig multipliers x market demand.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local CropConfig = require(script.Parent.CropConfig)
local AnimalConfig = require(script.Parent.AnimalConfig)

local ShopConfig = {
	MarketRange = 30, -- player must be this close to their market stall to trade

	Categories = {
		{ Id = "Seeds", DisplayName = "Seeds", Icon = "🌱" },
		{ Id = "Animals", DisplayName = "Animals", Icon = "🐄" },
		{ Id = "Tools", DisplayName = "Tools", Icon = "🪓" },
		{ Id = "Upgrades", DisplayName = "Upgrades", Icon = "⬆️" },
	},

	-- Item categories the "Sell Everything" button sells (never seeds or tools).
	SellAllCategories = { Crops = true, Fish = true, AnimalProducts = true },

	Items = {
		-- TOOLS
		WoodenBucket = { Category = "Tools", DisplayName = "Wooden Bucket", Icon = "🪣", Price = 20, Grant = { Tool = "WoodenBucket" }, UnlockLevel = 1, Order = 1, Description = "Needed to milk cows." },
		WoodenShovel = { Category = "Tools", DisplayName = "Wooden Shovel", Icon = "🪏", Price = 40, Grant = { Tool = "WoodenShovel" }, UnlockLevel = 1, Order = 2, Description = "Dig clay by the river." },
		StoneAxe = { Category = "Tools", DisplayName = "Stone Axe", Icon = "🪓", Price = 150, Items = { Stone = 15 }, Grant = { Tool = "StoneAxe" }, UnlockLevel = 2, Order = 3, Description = "Chops trees in 2 hits instead of 4." },
		StonePickaxe = { Category = "Tools", DisplayName = "Stone Pickaxe", Icon = "⛏️", Price = 150, Items = { Stone = 15 }, Grant = { Tool = "StonePickaxe" }, UnlockLevel = 2, Order = 4, Description = "Mines faster and can break Iron deposits." },
		IronFishingRod = { Category = "Tools", DisplayName = "Iron Fishing Rod", Icon = "🎣", Price = 500, Items = { Wood = 20 }, Grant = { Tool = "IronFishingRod" }, UnlockLevel = 4, Order = 5, Description = "Faster bites and better luck with rare fish." },
		IronAxe = { Category = "Tools", DisplayName = "Iron Axe", Icon = "🪓", Price = 800, Items = { Iron = 10 }, Grant = { Tool = "IronAxe" }, UnlockLevel = 5, Order = 6, Description = "Cuts through Ancient Trees." },
		IronPickaxe = { Category = "Tools", DisplayName = "Iron Pickaxe", Icon = "⛏️", Price = 800, Items = { Iron = 10 }, Grant = { Tool = "IronPickaxe" }, UnlockLevel = 5, Order = 7, Description = "Mines Crystal clusters." },

		-- UPGRADES
		BiggerFarm = { Category = "Upgrades", DisplayName = "Bigger Farm", Icon = "🌾", Price = 100, Grant = { Upgrade = "FarmTiles", Amount = 3 }, MaxOwned = 2, UnlockLevel = 1, Order = 1, Description = "+3 farm tiles on your starter farm." },
		BiggerBackpack = { Category = "Upgrades", DisplayName = "Bigger Backpack", Icon = "🎒", Price = 150, Grant = { Upgrade = "Capacity", Amount = 100 }, MaxOwned = 5, UnlockLevel = 1, Order = 2, Description = "+100 backpack capacity." },
	},
}

for index, cropId in CropConfig.Order do
	local crop = CropConfig.Crops[cropId]
	ShopConfig.Items[crop.Seed] = {
		Category = "Seeds",
		DisplayName = crop.DisplayName .. " Seeds",
		Icon = crop.Icon,
		Price = crop.SeedCost,
		Grant = { Item = crop.Seed, Amount = 1 },
		Bulk = 5,
		UnlockLevel = crop.UnlockLevel,
		Order = index,
		Description = ("Grows in %ds · %d-%d %s per harvest · sells for %d 🪙 each"):format(
			crop.GrowTime,
			crop.Yield.Min,
			crop.Yield.Max,
			crop.DisplayName,
			crop.SellValue
		),
	}
end

for index, animalId in AnimalConfig.Order do
	local animal = AnimalConfig.Animals[animalId]
	ShopConfig.Items[animalId] = {
		Category = "Animals",
		DisplayName = animal.DisplayName,
		Icon = animal.Icon,
		Price = animal.Price,
		Grant = { Animal = animalId },
		UnlockLevel = animal.UnlockLevel,
		Order = index,
		Description = ("Needs a %s. Eats %s, gives %s."):format(animal.Housing, animal.Food, animal.Produce),
	}
end

for itemId, def in ShopConfig.Items do
	def.Id = itemId
end

return TableUtil.DeepFreeze(ShopConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  SoundConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/SoundConfig
	DEPENDENCIES: Shared.Util.TableUtil

	!!! EVERY Id BELOW IS A PLACEHOLDER — NO REAL SOUNDS SHIP WITH THIS PROJECT !!!
	Placeholder sounds are silently skipped (AudioController logs them once in
	Debug mode). Paste real "rbxassetid://<number>" ids from the Creator Store
	or your own uploads — see docs/ASSETS.md.

	Each important action has its OWN entry (spec §149: don't reuse one sound
	for everything) even though they are all placeholders today.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER = "rbxassetid://PLACEHOLDER"

local function sound(category: string, volume: number?, extra: { [string]: any }?)
	local def = {
		Id = PLACEHOLDER,
		Category = category,
		Volume = volume or 0.6,
		PlaybackSpeed = 1,
		PitchVariation = 0.05, -- random +/- speed so repeated hits don't sound robotic
		RollOffMaxDistance = 80,
	}
	if extra then
		for key, value in extra do
			def[key] = value
		end
	end
	return def
end

local SoundConfig = {
	-- Category volume mixers (multiplied with player settings in later phases).
	Categories = {
		UI = 0.8,
		Coins = 0.8,
		Tools = 0.9,
		Building = 0.9,
		Farming = 0.9,
		Fishing = 0.9,
		Animals = 0.8,
		Environment = 0.5,
		Progress = 1,
		Rewards = 1,
	},

	Sounds = {
		-- UI
		UIClick = sound("UI", 0.5, { PitchVariation = 0 }),
		UIOpen = sound("UI", 0.5),
		UIClose = sound("UI", 0.5),
		UINotify = sound("UI", 0.5),
		UIError = sound("UI", 0.5),

		-- Coins / rewards
		CoinGain = sound("Coins", 0.6),
		CoinSpend = sound("Coins", 0.5),
		ItemGain = sound("Rewards", 0.4),
		RareReward = sound("Rewards", 0.9, { PitchVariation = 0 }),

		-- Progression
		LevelUp = sound("Progress", 0.9, { PitchVariation = 0 }),
		IslandLevelUp = sound("Progress", 1, { PitchVariation = 0 }),
		AreaUnlock = sound("Progress", 1, { PitchVariation = 0 }),
		ChestOpen = sound("Rewards", 0.8),
		QuestComplete = sound("Progress", 0.8),

		-- Tools
		ToolEquip = sound("Tools", 0.5),
		AxeSwing = sound("Tools"),
		PickaxeSwing = sound("Tools"),
		HammerSwing = sound("Tools"),
		ShovelDig = sound("Tools"),
		HoeTill = sound("Tools"),
		Shears = sound("Tools"),
		WoodHit = sound("Tools", 0.7),
		TreeFall = sound("Tools", 0.9),
		RockHit = sound("Tools", 0.7),
		RockBreak = sound("Tools", 0.9),

		-- Building
		HammerHit = sound("Building"),
		WoodPlace = sound("Building"),
		StonePlace = sound("Building"),
		Saw = sound("Building"),
		Paint = sound("Building"),
		ConstructionStart = sound("Building"),
		BuildComplete = sound("Building", 0.9, { PitchVariation = 0 }),
		PlaceInvalid = sound("Building", 0.5),

		-- Farming
		PlantSeed = sound("Farming"),
		Watering = sound("Farming"),
		Harvest = sound("Farming"),

		-- Fishing
		FishingCast = sound("Fishing"),
		FishBite = sound("Fishing"),
		Reel = sound("Fishing", 0.4),
		FishCatch = sound("Fishing"),
		FishEscape = sound("Fishing"),

		-- Animals
		Feed = sound("Animals"),
		Milk = sound("Animals"),
		Pet = sound("Animals"),
		CowMoo = sound("Animals", 0.7),
		ChickenCluck = sound("Animals", 0.6),

		-- Crafting
		CraftHit = sound("Building"),
		CraftComplete = sound("Rewards"),

		-- Ambience (looped; used by the ambience system in Phase 13/18)
		AmbienceOcean = sound("Environment", 0.4, { Looped = true, PitchVariation = 0 }),
		AmbienceBirds = sound("Environment", 0.3, { Looped = true, PitchVariation = 0 }),
		AmbienceWind = sound("Environment", 0.25, { Looped = true, PitchVariation = 0 }),
		AmbienceNight = sound("Environment", 0.3, { Looped = true, PitchVariation = 0 }),
	},
}

return TableUtil.DeepFreeze(SoundConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">ToolConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ToolConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every tool in the game. Tools are generated from TYPES x TIERS so adding a
	new tier (or a new tool type) is one table entry.

	Tool ID format: <Tier><Type>, e.g. "WoodenAxe", "IronPickaxe".

	Stats:
		Power         how much "damage" one hit does to a tree/rock (Phase 2)
		Speed         use-speed multiplier (animation + cooldown)
		ResourceBonus chance (0..1) for +1 extra resource per drop
		UnlockLevel   player level required to buy/craft (Phase 7/8)
		Price         coin price in the shop (Phase 7)

	Visuals:
		Grip.Hand     R15 hand the tool attaches to ("RightHand" or "LeftHand")
		Grip.Offset   extra CFrame applied on top of the hand's grip attachment
		Shape         procedural placeholder model (see Server/Tools/ToolModelFactory)
		If ServerStorage/Tools/<ToolId> exists (a Model with a "Handle" part and
		a "Grip" Attachment), that art is used instead of the placeholder shape.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local ToolConfig = {
	HotbarSize = 8,

	Tiers = {
		Wooden = { Order = 1, DisplayName = "Wooden", Power = 1, Speed = 1.0, ResourceBonus = 0, UnlockLevel = 1, Price = 0, HeadColor = Color3.fromRGB(165, 115, 65), HeadMaterial = Enum.Material.Wood },
		Stone = { Order = 2, DisplayName = "Stone", Power = 2, Speed = 1.1, ResourceBonus = 0.05, UnlockLevel = 3, Price = 250, HeadColor = Color3.fromRGB(140, 140, 145), HeadMaterial = Enum.Material.Slate },
		Iron = { Order = 3, DisplayName = "Iron", Power = 3, Speed = 1.2, ResourceBonus = 0.1, UnlockLevel = 8, Price = 1500, HeadColor = Color3.fromRGB(205, 205, 215), HeadMaterial = Enum.Material.Metal },
		Gold = { Order = 4, DisplayName = "Gold", Power = 4, Speed = 1.35, ResourceBonus = 0.15, UnlockLevel = 15, Price = 8000, HeadColor = Color3.fromRGB(255, 200, 50), HeadMaterial = Enum.Material.Metal },
