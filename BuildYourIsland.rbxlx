  <Item class="StarterPlayer" referent="96">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CameraMaxZoomDistance">70</float>
      <float name="CameraMinZoomDistance">6</float>
      <float name="CharacterWalkSpeed">16</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="97">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="98">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ClientState
	SCRIPT TYPE:  ModuleScript (client)
	WHERE:        StarterPlayerScripts/Client/ClientState
	DEPENDENCIES: Shared.Net, Shared.Util.Signal

	READ-ONLY mirror of the local player's profile, fed by the server's
	StateSync remote (one full snapshot, then batched path updates). The
	client never writes here except by applying server packets — to change
	anything the client sends a request and waits for the server's update.

	Usage:
		ClientState.Observe("Coins", function(coins) ... end) -- fires now (if ready) + on every change
		ClientState.Get("Island", "Level")
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))

local ClientState = {}

ClientState.Ready = Signal.new() -- fires once, when the first full snapshot arrives
ClientState.Changed = Signal.new() -- (topLevelKey, path)

local data: { [string]: any }? = nil
local observers: { [string]: any } = {}

local function getSignal(key: string)
	local signal = observers[key]
	if not signal then
		signal = Signal.new()
		observers[key] = signal
	end
	return signal
end

local function notify(key: string, path: { string }?)
	local signal = observers[key]
	if signal and data then
		signal:Fire(data[key], path)
	end
	ClientState.Changed:Fire(key, path)
end

local function applyOp(op: { Path: { string }, Value: any })
	if not data or type(op.Path) ~= "table" or #op.Path == 0 then
		return
	end
	local node = data
	for index = 1, #op.Path - 1 do
		local key = op.Path[index]
		if type(node[key]) ~= "table" then
			node[key] = {}
		end
		node = node[key]
	end
	node[op.Path[#op.Path]] = op.Value
end

function ClientState.IsReady(): boolean
	return data ~= nil
end

function ClientState.WaitForReady()
	if not data then
		ClientState.Ready:Wait()
	end
end

-- ClientState.Get("Inventory", "Items", "Wood")
function ClientState.Get(...: string): any
	local node: any = data
	for _, key in { ... } do
		if type(node) ~= "table" then
			return nil
		end
		node = node[key]
	end
	return node
end

-- Calls callback(value) immediately if ready, then after every change to data[key].
function ClientState.Observe(key: string, callback: (value: any, path: { string }?) -> ())
	local connection = getSignal(key):Connect(callback)
	if data then
		task.spawn(callback, data[key], nil)
	end
	return connection
end

function ClientState.Init()
	Net.OnClientEvent("StateSync", function(packet: any)
		if type(packet) ~= "table" then
			return
		end
		if type(packet.Full) == "table" then
			local firstSnapshot = data == nil
			data = packet.Full
			for key in packet.Full do
				notify(key, nil)
			end
			if firstSnapshot then
				ClientState.Ready:Fire()
			end
		elseif type(packet.Ops) == "table" and data then
			-- Apply every op first, then notify each touched key once.
			local touched: { [string]: { string } } = {}
			for _, op in packet.Ops do
				applyOp(op)
				if type(op.Path) == "table" and op.Path[1] then
					touched[op.Path[1]] = op.Path
				end
			end
			for key, path in touched do
				notify(key, path)
			end
		end
	end)
end

function ClientState.Start()
	Net.FireServer("ClientReady")
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="100">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">AnimalController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/AnimalController
	DEPENDENCIES: Shared.Config.{AnimalConfig, ItemConfig}, Shared.Util.Format, Client.UI.{Components, Theme}

	Floating status over every animal (spec §34-§37, §101): name, a heart
	meter for happiness and what it needs RIGHT NOW —
	  🌾 Hungry  → feed it (1 Wheat)
	  ⏳ 0:42    → producing
	  🥛 READY!  → milk / collect
	Everything comes from attributes the server sets on the animal model
	(Status, Happiness, ReadyAt), so this never guesses. The countdown uses
	the synced server clock. Only animals near the camera are updated.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AnimalConfig = require(Shared.Config.AnimalConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local TAG = "Animal"
local LABEL_DISTANCE = 60
local UPDATE_INTERVAL = 0.5

local AnimalController = {}

type Label = { Gui: BillboardGui, Name: TextLabel, Hearts: TextLabel, Status: TextLabel }

local labels: { [Model]: Label } = {}

local function makeLabel(model: Model): Label?
	local body = model.PrimaryPart
	if not body then
		return nil
	end
	local gui = Create("BillboardGui", {
		Name = "AnimalLabel",
		Size = UDim2.fromOffset(160, 62),
		StudsOffset = Vector3.new(0, body.Size.Y / 2 + 2.6, 0),
		MaxDistance = LABEL_DISTANCE,
		LightInfluence = 0,
		Parent = body,
	})
	local name = Components.Label({ Size = UDim2.new(1, 0, 0, 22), TextSize = Theme.TextSize.Medium, TextColor3 = Theme.Colors.TextLight, Text = "", Parent = gui })
	Components.TextStroke(name)
	local hearts = Components.Label({ Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 22), TextSize = 13, Text = "", Parent = gui })
	local status = Components.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 39),
		BackgroundTransparency = 0.15,
		BackgroundColor3 = Theme.Colors.Outline,
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextLight,
		Text = "",
		Parent = gui,
	})
	Components.Corner(status, UDim.new(1, 0))
	local label = { Gui = gui, Name = name, Hearts = hearts, Status = status }
	labels[model] = label
	model.Destroying:Once(function()
		labels[model] = nil
	end)
	return label
end

local function heartsText(happiness: number): string
	local full = math.clamp(math.floor(happiness / 20 + 0.5), 0, 5)
	return string.rep("❤️", full) .. string.rep("🤍", 5 - full)
end

local function updateLabel(model: Model, label: Label, now: number)
	local def = AnimalConfig.Animals[model:GetAttribute("AnimalId") or ""]
	if not def then
		label.Gui.Enabled = false
		return
	end
	label.Gui.Enabled = true
	local variant = model:GetAttribute("Variant")
	label.Name.Text = (if variant == "Golden" then "✨ Golden " else "") .. def.DisplayName
	label.Name.TextColor3 = if variant == "Golden" then Theme.Colors.Coins else Theme.Colors.TextLight
	label.Hearts.Text = heartsText(tonumber(model:GetAttribute("Happiness")) or 0)

	local status = model:GetAttribute("Status")
	local produce = ItemConfig.Get(def.Produce)
	local produceIcon = if produce then produce.Icon else "✨"
	if status == "Ready" then
		label.Status.Text = ("%s READY! %s"):format(produceIcon, def.ProduceVerb)
		label.Status.BackgroundColor3 = Theme.Colors.Green
	elseif status == "Producing" then
		local readyAt = tonumber(model:GetAttribute("ReadyAt")) or now
		label.Status.Text = ("⏳ %s in %s"):format(def.Produce, Format.Duration(math.max(0, math.ceil(readyAt - now))))
		label.Status.BackgroundColor3 = Theme.Colors.Outline
	else
		local food = ItemConfig.Get(def.Food)
		label.Status.Text = ("%s Hungry — feed %d %s"):format(if food then food.Icon else "🍽️", def.FoodAmount, def.Food)
		label.Status.BackgroundColor3 = Theme.Colors.Orange
	end
end

local function updateAll()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = workspace:GetServerTimeNow()
	local eye = camera.CFrame.Position
	for _, instance in CollectionService:GetTagged(TAG) do
		if instance:IsA("Model") then
			local label = labels[instance]
			local near = (instance:GetPivot().Position - eye).Magnitude <= LABEL_DISTANCE + 10
			if near then
				label = label or makeLabel(instance)
				if label then
					updateLabel(instance, label, now)
				end
			elseif label then
				label.Gui.Enabled = false
			end
		end
	end
end

function AnimalController.Start()
	task.spawn(function()
		while true do
			updateAll()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return AnimalController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/AnimationController
	DEPENDENCIES: Shared.Net, Shared.Animation.AnimationPlayer, Shared.Config.AnimationConfig,
	              AudioController, VFXController, CameraController, Shared.Util.R15

	Client half of the centralized animation system. Owns ONE AnimationPlayer
	for the local R15 character (recreated on respawn; tracks are cached, never
	reloaded per play). Local playback replicates to other players through the
	Animator, and gives instant response to input.

	MarkerEffects in AnimationConfig are applied here automatically, so sound,
	VFX and camera shake always line up with the animation marker that caused
	them (spec §13, §74). Gameplay code subscribes to the same markers.

	API (spec §71):
		PlayAnimation(name, options?) -> handle | nil
		StopAnimation(name, fade?)
		StopAllAnimations(fade?)
		GetAnimation(name) -> handle | nil
		SetAnimationSpeed(name, speed)
		IsPlaying(name) -> boolean
		MarkerReached  Signal(animationName, markerName, handle)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local AnimationPlayer = require(Shared.Animation.AnimationPlayer)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Controllers = script.Parent
local AudioController = require(Controllers.AudioController)
local VFXController = require(Controllers.VFXController)
local CameraController = require(Controllers.CameraController)

local AnimationController = {}

AnimationController.MarkerReached = Signal.new()
AnimationController.CharacterReady = Signal.new() -- (character)

local current: any = nil
local character: Model? = nil

local function effectPosition(): Vector3?
	local root = R15.GetRootPart(character)
	if not root then
		return nil
	end
	-- Just in front of the character, near the ground — where tools make contact.
	return (root.CFrame * CFrame.new(0, -1.5, -3)).Position
end

local function onMarker(animationName: string, markerName: string, handle: any)
	local def = AnimationConfig.Get(animationName)
	local effects = def and def.MarkerEffects[markerName]
	if effects then
		local position = effectPosition()
		if position then
			if effects.Sound then
				AudioController.PlayAt(effects.Sound, position)
			end
			if effects.VFX then
				VFXController.Play(effects.VFX, position)
			end
		end
		if effects.Shake then
			CameraController.Shake(effects.Shake, 0.25)
		end
	end
	AnimationController.MarkerReached:Fire(animationName, markerName, handle)
end

local function setupCharacter(newCharacter: Model)
	if current then
		current:Destroy()
		current = nil
	end
	character = newCharacter
	local humanoid = newCharacter:WaitForChild("Humanoid", 10)
	if not humanoid then
		return
	end
	humanoid:WaitForChild("Animator", 10)
	if character ~= newCharacter then
		return -- respawned again while waiting
	end
	current = AnimationPlayer.new(newCharacter, { EnableFallback = true })
	current.MarkerReached:Connect(onMarker)

	-- Preload tool/building tracks that have real ids so the first swing has no hitch.
	local preload = {}
	for name in AnimationConfig.Categories.Tools do
		table.insert(preload, name)
	end
	for name in AnimationConfig.Categories.Building do
		table.insert(preload, name)
	end
	current:Preload(preload)
	AnimationController.CharacterReady:Fire(newCharacter)
end

function AnimationController.PlayAnimation(name: string, options: AnimationPlayer.PlayOptions?): any
	if not current then
		return nil
	end
	return current:Play(name, options)
end

function AnimationController.StopAnimation(name: string, fadeTime: number?)
	if current then
		current:Stop(name, fadeTime)
	end
end

function AnimationController.StopAllAnimations(fadeTime: number?)
	if current then
		current:StopAll(fadeTime)
	end
end

function AnimationController.GetAnimation(name: string): any
	return current and current:GetHandle(name)
end

function AnimationController.SetAnimationSpeed(name: string, speed: number)
	if current then
		current:SetSpeed(name, speed)
	end
end

function AnimationController.IsPlaying(name: string): boolean
	return current ~= nil and current:IsPlaying(name)
end

function AnimationController.Start()
	local player = Players.LocalPlayer
	player.CharacterAdded:Connect(setupCharacter)
	if player.Character then
		task.spawn(setupCharacter, player.Character)
	end

	Net.OnClientEvent("AnimationCommand", function(command: any)
		if type(command) ~= "table" then
			return
		end
		if command.Op == "Play" and type(command.Name) == "string" then
			AnimationController.PlayAnimation(command.Name, { Speed = command.Speed })
		elseif command.Op == "Stop" and type(command.Name) == "string" then
			AnimationController.StopAnimation(command.Name, command.Fade)
		elseif command.Op == "StopAll" then
			AnimationController.StopAllAnimations(command.Fade)
		elseif command.Op == "Speed" and type(command.Name) == "string" and type(command.Speed) == "number" then
			AnimationController.SetAnimationSpeed(command.Name, command.Speed)
		end
	end)
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AudioController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/AudioController
	DEPENDENCIES: Shared.Net, Shared.Config.{SoundConfig, GameConfig}, Shared.Util.AssetId, Client.ClientState

	Plays every sound from SoundConfig through small pools (2D + 3D), applying
	category volume, the player's SFX volume setting and a little random pitch.
	Placeholder ids are skipped silently (logged once when Debug is on), so the
	game runs cleanly before real audio is added.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RobloxSoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local SoundConfig = require(Shared.Config.SoundConfig)
local GameConfig = require(Shared.Config.GameConfig)
local AssetId = require(Shared.Util.AssetId)
local ClientState = require(script.Parent.Parent.ClientState)

local POOL_SIZE_2D = 8
local POOL_SIZE_3D = 12

local AudioController = {}

local pool2D: { Sound } = {}
local pool3D: { { Part: Part, Sound: Sound } } = {}
local next2D, next3D = 1, 1
local warned: { [string]: boolean } = {}
local random = Random.new()

local function resolve(name: string): any
	local def = SoundConfig.Sounds[name]
	if not def then
		if not warned[name] then
			warned[name] = true
			warn("[Audio] Unknown sound '" .. tostring(name) .. "'")
		end
		return nil
	end
	if AssetId.IsPlaceholder(def.Id) then
		if GameConfig.Debug and not warned[name] then
			warned[name] = true
			print("[Audio] '" .. name .. "' still uses a placeholder id — skipped")
		end
		return nil
	end
	return def
end

local function volumeFor(def: any): number
	local category = SoundConfig.Categories[def.Category] or 1
	local sfx = ClientState.Get("Settings", "SfxVolume")
	return def.Volume * category * (if type(sfx) == "number" then sfx else 0.8)
end

local function configure(sound: Sound, def: any)
	sound.SoundId = def.Id
	sound.Volume = volumeFor(def)
	sound.PlaybackSpeed = def.PlaybackSpeed * (1 + random:NextNumber(-def.PitchVariation, def.PitchVariation))
	sound.Looped = def.Looped == true
	sound.RollOffMaxDistance = def.RollOffMaxDistance
end

-- 2D sound (UI, personal rewards).
function AudioController.Play(name: string)
	local def = resolve(name)
	if not def then
		return
	end
	local sound = pool2D[next2D]
	next2D = next2D % POOL_SIZE_2D + 1
	sound:Stop()
	configure(sound, def)
	sound:Play()
end

-- 3D sound at a world position.
function AudioController.PlayAt(name: string, position: Vector3)
	local def = resolve(name)
	if not def then
		return
	end
	local emitter = pool3D[next3D]
	next3D = next3D % POOL_SIZE_3D + 1
	emitter.Sound:Stop()
	emitter.Part.CFrame = CFrame.new(position)
	configure(emitter.Sound, def)
	emitter.Sound:Play()
end

function AudioController.Init()
	for index = 1, POOL_SIZE_2D do
		local sound = Instance.new("Sound")
		sound.Name = "UISound" .. index
		sound.Parent = RobloxSoundService
		pool2D[index] = sound
	end

	local folder = Instance.new("Folder")
	folder.Name = "ClientAudio"
	folder.Parent = workspace
	for index = 1, POOL_SIZE_3D do
		local part = Instance.new("Part")
		part.Name = "AudioEmitter"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.one
		part.Parent = folder
		local sound = Instance.new("Sound")
		sound.Parent = part
		pool3D[index] = { Part = part, Sound = sound }
	end
end

function AudioController.Start()
	Net.OnClientEvent("PlaySound", function(name: string, position: Vector3?)
		if typeof(position) == "Vector3" then
			AudioController.PlayAt(name, position)
		else
			AudioController.Play(name)
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">BuildController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/BuildController
	DEPENDENCIES: Shared.Net, Shared.Building.BuildingModels, Shared.Config.{BuildingConfig, BuildConfig,
	              ItemConfig}, Shared.Util.{Placement, IslandLayout, Format}, Client.ClientState,
	              InputController, UIController, CameraController, InteractionController, AudioController,
	              Client.UI.{Components, Theme}

	BUILD MODE (spec §7-§9, §46-§48, §84). Press B (or the 🔨 button).

	  Top     "BUILD MODE" + category
	  Left    categories + building list (cost shows ✔ / ✖ as you can afford it)
	  Centre  a transparent GHOST that follows the mouse / your tap, snapped to
	          the grid, tinted GREEN (valid) or RED (invalid, with the reason)
	  Right   selected building info + PLACE / ROTATE / CANCEL (touch friendly)
	  Bottom  control hints

	  R rotate · Q / E turn · click (or PLACE) to build · X cancel · B exit
	  EDIT tab: click one of your buildings → MOVE or DELETE (50% refund).

	The preview runs the SAME rules as the server (Shared/Util/Placement,
	BuildConfig) so what looks valid is valid — but the server re-checks all of it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local BuildingModels = require(Shared.Building.BuildingModels)
local BuildingConfig = require(Shared.Config.BuildingConfig)
local BuildConfig = require(Shared.Config.BuildConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Placement = require(Shared.Util.Placement)
local Format = require(Shared.Util.Format)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local CameraController = require(script.Parent.CameraController)
local InteractionController = require(script.Parent.InteractionController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local VALID_COLOR = Color3.fromRGB(90, 230, 120)
local INVALID_COLOR = Color3.fromRGB(240, 80, 70)
local EDIT_COLOR = Color3.fromRGB(90, 170, 255)

local BuildController = {}

type Refs = {
	Root: Frame,
	Banner: TextLabel,
	Left: Frame,
	Tabs: { [string]: TextButton },
	List: ScrollingFrame,
	Right: Frame,
	InfoIcon: TextLabel,
	InfoName: TextLabel,
	InfoDescription: TextLabel,
	InfoCost: TextLabel,
	Status: TextLabel,
	PlaceButton: TextButton,
	RotateButton: TextButton,
	CancelButton: TextButton,
	MoveButton: TextButton,
	DeleteButton: TextButton,
	Hints: TextLabel,
	BuildButton: TextButton,
}

local refs: Refs
local active = false
local mode = "Menu" -- Menu | Placing | Editing | Moving
local category = "Homes"
local selectedId: string? = nil
local rotation = 0
local ghost: Model? = nil
local ghostHighlight: Highlight
local selectionHighlight: Highlight
local renderConnection: RBXScriptConnection? = nil
local releases: { () -> () } = {}
local pointer: Vector2? = nil -- last touch position (screen space)
local cards: { TextButton } = {}
local editTarget: Model? = nil
local deleteArmedUntil = 0

local current = { Valid = false, Reason = "", Center = Vector2.zero, Key = "" }
local lastValidation = 0

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

-- The island model's pivot IS the island origin (IslandBuilder pins WorldPivot).
local function myIsland(): Model?
	local folder = workspace:FindFirstChild("Islands")
	local island = folder and folder:FindFirstChild("Island_" .. player.UserId)
	return if island and island:IsA("Model") then island else nil
end

local function affordable(def: any): (boolean, string)
	local coins = ClientState.Get("Coins") or 0
	local items = ClientState.Get("Inventory", "Items") or {}
	local ok = true
	local lines = {}
	local needCoins = def.Cost.Coins or 0
	if needCoins > 0 then
		local has = coins >= needCoins
		ok = ok and has
		table.insert(lines, ("%s %s 🪙"):format(if has then "✔" else "✖", Format.Commas(needCoins)))
	end
	for itemId, amount in def.Cost.Items do
		local owned = items[itemId] or 0
		local has = owned >= amount
		ok = ok and has
		local item = ItemConfig.Get(itemId)
		table.insert(lines, ("%s %d/%d %s %s"):format(if has then "✔" else "✖", math.min(owned, amount), amount, if item then item.Icon else "", if item then item.DisplayName else itemId))
	end
	return ok, table.concat(lines, "\n")
end

local function islandLevel(): number
	return ClientState.Get("Island", "Level") or 1
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true

local function pointerRay(): Ray?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	if InputController.IsTouch() then
		local position = pointer or (camera.ViewportSize / 2)
		return camera:ScreenPointToRay(position.X, position.Y)
	end
	local mouse = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(mouse.X, mouse.Y)
end

local function groundHeight(worldX: number, worldZ: number, fallback: number): number
	groundParams.FilterDescendantsInstances = { workspace.Terrain }
	local result = workspace:Raycast(Vector3.new(worldX, fallback + 80, worldZ), Vector3.new(0, -200, 0), groundParams)
	return if result then result.Position.Y else fallback
end

local function blockingFolders(island: Model): { Instance }
	local list = {}
	for _, name in BuildConfig.BlockingFolders do
		local folder = island:FindFirstChild(name)
		if folder then
			table.insert(list, folder)
		end
	end
	return list
end

---------------------------------------------------------------------------
-- Ghost preview
---------------------------------------------------------------------------

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	ghostHighlight.Adornee = nil
	ghostHighlight.Enabled = false
end

local function makeGhost(buildingId: string)
	clearGhost()
	local model = BuildingModels.Build(buildingId)
	BuildingModels.MakeGhost(model)
	local def = BuildingConfig.Get(buildingId)
	local plate = Instance.new("Part")
	plate.Name = "FootprintPlate"
	plate.Anchored = true
	plate.CanCollide = false
	plate.CanQuery = false
	plate.CanTouch = false
	plate.Material = Enum.Material.Neon
	plate.Transparency = 0.55
	plate.Size = Vector3.new(def.Footprint.X, 0.15, def.Footprint.Y)
	plate.CFrame = CFrame.new(0, 0.1, 0)
	plate.Parent = model
	model.Parent = workspace.CurrentCamera
	ghost = model
	ghostHighlight.Adornee = model
	ghostHighlight.Enabled = true
end

-- Runs the same checks the server will run.
local function validate(def: any, island: Model, center: Vector2, localY: number, worldCFrame: CFrame, checkCost: boolean): (boolean, string)
	local size = Placement.FootprintSize(def.Footprint, rotation)
	local unlocked = ClientState.Get("Island", "UnlockedAreas") or { Starter = true }
	if not Placement.IsOnUnlockedLand(unlocked, center, size) then
		return false, "Not on your unlocked land"
	end
	local origin = island:GetPivot()
	local lowest, highest = localY, localY
	for _, corner in Placement.Corners(center, size) do
		local world = origin * CFrame.new(corner.X, 0, corner.Y)
		local height = groundHeight(world.X, world.Z, origin.Y) - origin.Y
		lowest = math.min(lowest, height)
		highest = math.max(highest, height)
	end
	if highest - lowest > BuildConfig.MaxSlope then
		return false, "Ground too steep"
	end
	local root = R15.GetRootPart(player.Character)
	if not root or (root.Position - worldCFrame.Position).Magnitude > BuildConfig.PlacementRange then
		return false, "Too far away — walk closer"
	end
	local shrink = BuildConfig.OverlapShrink
	local boxSize = Vector3.new(math.max(0.5, def.Footprint.X - shrink), def.Height, math.max(0.5, def.Footprint.Y - shrink))
	local boxCFrame = worldCFrame * CFrame.new(0, def.Height / 2 + 0.4, 0)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = blockingFolders(island)
	for _, hit in workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlap) do
		if not (editTarget and mode == "Moving" and hit:IsDescendantOf(editTarget)) then
			return false, "Something is in the way"
		end
	end
	local relative = boxCFrame:PointToObjectSpace(root.Position)
	if math.abs(relative.X) < def.Footprint.X / 2 + 1 and math.abs(relative.Z) < def.Footprint.Y / 2 + 1 then
		return false, "Step out of the way"
	end
	if checkCost then
		if islandLevel() < def.UnlockLevel then
			return false, ("Needs Island Level %d"):format(def.UnlockLevel)
		end
		local canAfford = affordable(def)
		if not canAfford then
			return false, "Not enough materials"
		end
	end
	return true, "Looks good! Click / PLACE to build"
end

local function currentDef(): any
	if mode == "Moving" and editTarget then
		return BuildingConfig.Get(editTarget:GetAttribute("BuildingId"))
	end
	return selectedId and BuildingConfig.Get(selectedId)
end

local function updateGhost()
	local def = currentDef()
	local island = myIsland()
	local ray = pointerRay()
	if not ghost or not def or not island or not ray then
		return
	end
	local exclude = { ghost }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	for _, name in { "ClientEffects", "ClientAudio" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
	if not hit then
		return
	end
	local origin = island:GetPivot()
	local localHit = origin:PointToObjectSpace(hit.Position)
	local size = Placement.FootprintSize(def.Footprint, rotation)
	local center = Placement.Snap(Vector2.new(localHit.X, localHit.Z), size)
	local worldCenter = origin * CFrame.new(center.X, 0, center.Y)
	local localY = groundHeight(worldCenter.X, worldCenter.Z, origin.Y) - origin.Y
	local worldCFrame = origin * Placement.LocalCFrame(Vector3.new(center.X, localY, center.Y), rotation)
	ghost:PivotTo(worldCFrame)

	local key = ("%d,%d,%d"):format(center.X * 10, center.Y * 10, rotation)
	local now = os.clock()
	if key ~= current.Key or now - lastValidation > 0.4 then
		lastValidation = now
		current.Key = key
		current.Center = center
		current.Valid, current.Reason = validate(def, island, center, localY, worldCFrame, mode == "Placing")
		local color = if current.Valid then VALID_COLOR else INVALID_COLOR
		ghostHighlight.FillColor = color
		ghostHighlight.OutlineColor = color
		local plate = ghost:FindFirstChild("FootprintPlate")
		if plate and plate:IsA("BasePart") then
			plate.Color = color
		end
		refs.Status.Text = (if current.Valid then "✔ " else "✖ ") .. current.Reason
		refs.Status.TextColor3 = if current.Valid then Theme.Colors.Green else Theme.Colors.Red
	end
end

local function startRender()
	if renderConnection then
		return
	end
	renderConnection = RunService.RenderStepped:Connect(updateGhost)
end

local function stopRender()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
end

---------------------------------------------------------------------------
-- UI state
---------------------------------------------------------------------------

local renderList: () -> ()

local function showInfo(def: any?)
	if not def then
		refs.InfoIcon.Text = "🔨"
		refs.InfoName.Text = if mode == "Editing" then "EDIT MODE" else "Pick a building"
		refs.InfoDescription.Text = if mode == "Editing" then "Click one of your buildings to move or remove it." else "Choose something from the list on the left."
		refs.InfoCost.Text = ""
		return
	end
	local _, costText = affordable(def)
	refs.InfoIcon.Text = def.Icon
	refs.InfoName.Text = string.upper(def.DisplayName)
	refs.InfoDescription.Text = ("%s\nFootprint %dx%d · %d hammer hits"):format(def.Description, def.Footprint.X, def.Footprint.Y, def.Steps)
	refs.InfoCost.Text = if mode == "Moving" then "Moving is free." else costText
end

local function updateButtons()
	local placing = mode == "Placing" or mode == "Moving"
	refs.PlaceButton.Visible = placing
	refs.PlaceButton.Text = if mode == "Moving" then "MOVE HERE" else "PLACE"
	refs.RotateButton.Visible = placing
	refs.CancelButton.Visible = placing or (mode == "Editing" and editTarget ~= nil)
	refs.MoveButton.Visible = mode == "Editing" and editTarget ~= nil
	refs.DeleteButton.Visible = mode == "Editing" and editTarget ~= nil
	refs.Status.Visible = placing
	refs.Left.Visible = not placing
	refs.Banner.Text = "🔨 BUILD MODE · " .. (if mode == "Editing" or mode == "Moving" then "EDIT" else string.upper(category))
	if InputController.IsTouch() then
		refs.Hints.Text = if placing then "Tap the ground to move · ⟳ to rotate · PLACE to build" else "Pick a building · tap ✕ to leave"
	else
		refs.Hints.Text = if placing then "Click to place · R rotate · Q/E turn · X cancel · B exit" else "Pick a building · B to exit"
	end
end

local function setMode(newMode: string)
	mode = newMode
	if mode == "Placing" or mode == "Moving" then
		startRender()
	else
		stopRender()
		clearGhost()
	end
	if mode ~= "Editing" and mode ~= "Moving" then
		editTarget = nil
		selectionHighlight.Adornee = nil
		selectionHighlight.Enabled = false
	end
	current.Key = ""
	updateButtons()
	showInfo(currentDef())
end

local function selectBuilding(buildingId: string)
	local def = BuildingConfig.Get(buildingId)
	if not def then
		return
	end
	if islandLevel() < def.UnlockLevel then
		UIController.Notify("Error", ("%s unlocks at Island Level %d."):format(def.DisplayName, def.UnlockLevel))
		return
	end
	selectedId = buildingId
	makeGhost(buildingId)
	setMode("Placing")
end

local function confirmPlacement()
	if mode ~= "Placing" and mode ~= "Moving" then
		return
	end
	if not current.Valid then
		AudioController.Play("PlaceInvalid")
		UIController.Notify("Error", current.Reason)
		return
	end
	if mode == "Moving" and editTarget then
		Net.FireServer("MoveBuildRequest", editTarget:GetAttribute("UniqueId"), current.Center.X, current.Center.Y, rotation)
		setMode("Editing")
		return
	end
	local def = currentDef()
	if not def then
		return
	end
	Net.FireServer("BuildRequest", { Op = "Place", BuildingId = def.Id, X = current.Center.X, Z = current.Center.Y, Rotation = rotation })
	AudioController.Play("UIClick")
	-- Decorations keep placing (fences, paths...); big buildings return to the menu.
	if def.Category == "Decoration" then
		current.Key = ""
	else
		BuildController.Exit()
	end
end

local function rotate(delta: number)
	if mode == "Placing" or mode == "Moving" then
		rotation = (rotation + delta) % 360
		current.Key = ""
		AudioController.Play("UIClick")
	end
end

local function cancel()
	if mode == "Placing" then
		setMode("Menu")
	elseif mode == "Moving" then
		setMode("Editing")
	elseif mode == "Editing" and editTarget then
		setMode("Editing")
	else
		BuildController.Exit()
	end
end

local function selectForEdit(model: Model)
	editTarget = model
	selectionHighlight.Adornee = model
	selectionHighlight.Enabled = true
	deleteArmedUntil = 0
	refs.DeleteButton.Text = "DELETE"
	updateButtons()
	local def = BuildingConfig.Get(model:GetAttribute("BuildingId"))
	showInfo(def)
	if def then
		local refundText = ("Delete refunds %d%% of the cost."):format(math.floor(BuildingConfig.RefundPercent * 100))
		refs.InfoCost.Text = refundText
	end
end

local function tryPickBuilding(screenPosition: Vector2?)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local ray = if screenPosition
		then camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
		else (function()
			local mouse = UserInputService:GetMouseLocation()
			return camera:ViewportPointToRay(mouse.X, mouse.Y)
		end)()
	local island = myIsland()
	local buildings = island and island:FindFirstChild("Buildings")
	if not buildings then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { buildings }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
	if not hit then
		return
	end
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	while model and model.Parent ~= buildings do
		model = model:FindFirstAncestorOfClass("Model")
	end
	if model and model:GetAttribute("OwnerUserId") == player.UserId then
		selectForEdit(model)
	end
end

---------------------------------------------------------------------------
-- UI construction
---------------------------------------------------------------------------

local function buildUI()
	local layer = UIController.GetModalLayer()
	local root = Create("Frame", { Name = "BuildMode", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = layer })

	local banner = Components.Label({
		Name = "Banner",
		Size = UDim2.fromOffset(420, 40),
		Position = UDim2.new(0.5, 0, 0, 76),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Orange,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Large,
		Text = "🔨 BUILD MODE",
		Parent = root,
	})
	Components.Corner(banner, UDim.new(1, 0))
	Components.Stroke(banner)
	Components.TextStroke(banner)

	-- LEFT: categories + list
	local left = Create("Frame", { Name = "Left", Size = UDim2.fromOffset(300, 470), Position = UDim2.fromOffset(110, 125), BackgroundColor3 = Theme.Colors.Panel, Parent = root })
	Components.Corner(left)
	Components.Stroke(left)
	local tabRow = Create("Frame", { Size = UDim2.new(1, -16, 0, 84), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, Parent = left }, {
		Create("UIGridLayout", { CellSize = UDim2.fromOffset(88, 38), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tabs = {}
	local tabDefs = table.clone(BuildingConfig.Categories)
	table.insert(tabDefs, { Id = "Edit", DisplayName = "Edit", Icon = "✏️" })
	for index, cat in tabDefs do
		local button = Components.Button({
			Name = cat.Id,
			Text = cat.Icon .. " " .. cat.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			TextSize = Theme.TextSize.Small,
			Parent = tabRow,
			OnClick = function()
				if cat.Id == "Edit" then
					setMode("Editing")
				else
					category = cat.Id
					setMode("Menu")
				end
				renderList()
			end,
		})
		button.LayoutOrder = index
		for _, child in button:GetChildren() do
			if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
				child:Destroy()
			end
		end
		tabs[cat.Id] = button
	end
	local list = Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, -16, 1, -104),
		Position = UDim2.fromOffset(8, 98),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = left,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	-- RIGHT: info + actions
	local right = Create("Frame", { Name = "Right", Size = UDim2.fromOffset(280, 430), Position = UDim2.new(1, -12, 0, 125), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Colors.Panel, Parent = root })
	Components.Corner(right)
	Components.Stroke(right)
	Components.Padding(right, 12)
	local infoIcon = Components.Label({ Size = UDim2.new(1, 0, 0, 56), TextSize = 48, Text = "🔨", Parent = right })
	local infoName = Components.Label({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 56), TextSize = Theme.TextSize.Large, Text = "", Parent = right })
	local infoDescription = Components.Label({ Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 86), Font = Theme.Fonts.Body, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = right })
	local infoCost = Components.Label({ Size = UDim2.new(1, 0, 0, 84), Position = UDim2.fromOffset(0, 148), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = right })
	local status = Components.Label({ Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 234), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Text = "", Parent = right })
	local placeButton = Components.Button({ Text = "PLACE", Color = Theme.Colors.Green, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 274), Parent = right, OnClick = confirmPlacement })
	local rotateButton = Components.Button({ Text = "⟳ ROTATE", Color = Theme.Colors.Blue, Size = UDim2.new(0.5, -4, 0, 44), Position = UDim2.fromOffset(0, 330), Parent = right, OnClick = function()
		rotate(90)
	end })
	local cancelButton = Components.Button({ Text = "CANCEL", Color = Theme.Colors.Red, Size = UDim2.new(0.5, -4, 0, 44), Position = UDim2.new(0.5, 4, 0, 330), Parent = right, OnClick = cancel })
	local moveButton = Components.Button({ Text = "MOVE", Color = Theme.Colors.Blue, Size = UDim2.new(0.5, -4, 0, 48), Position = UDim2.fromOffset(0, 274), Parent = right, OnClick = function()
		if editTarget then
			local uniqueId = editTarget:GetAttribute("UniqueId")
			local entry = ClientState.Get("Island", "Buildings", uniqueId)
			rotation = if entry and type(entry.Rotation) == "number" then entry.Rotation else 0
			makeGhost(tostring(editTarget:GetAttribute("BuildingId")))
			setMode("Moving")
		end
	end })
	local deleteButton = Components.Button({ Text = "DELETE", Color = Theme.Colors.Red, Size = UDim2.new(0.5, -4, 0, 48), Position = UDim2.new(0.5, 4, 0, 274), Parent = right, OnClick = function()
		if not editTarget then
			return
		end
		local now = os.clock()
		if now > deleteArmedUntil then
			-- Two taps to delete, so nothing is removed by accident.
			deleteArmedUntil = now + 3
			refs.DeleteButton.Text = "SURE?"
			return
		end
		Net.FireServer("DeleteBuildRequest", editTarget:GetAttribute("UniqueId"))
		setMode("Editing")
	end })

	local hints = Components.Label({
		Name = "Hints",
		Size = UDim2.fromOffset(640, 30),
		Position = UDim2.new(0.5, 0, 1, -118),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.2,
		BackgroundColor3 = Theme.Colors.Outline,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Small,
		Text = "",
		Parent = root,
	})
	Components.Corner(hints, UDim.new(1, 0))

	-- HUD button (left slot, under the bag).
	local buildButton = Components.Button({
		Name = "BuildButton",
		Text = "🔨",
		Color = Theme.Colors.Blue,
		Size = UDim2.fromOffset(76, 76),
		TextSize = 40,
		Parent = UIController.GetSlot("Left"),
		OnClick = function()
			BuildController.Toggle()
		end,
	})
	buildButton.LayoutOrder = 2
	Components.Corner(buildButton, UDim.new(1, 0))
	Components.Label({ Text = "Build", Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -4), TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextLight, Parent = buildButton })

	refs = {
		Root = root,
		Banner = banner,
		Left = left,
		Tabs = tabs,
		List = list,
		Right = right,
		InfoIcon = infoIcon,
		InfoName = infoName,
		InfoDescription = infoDescription,
		InfoCost = infoCost,
		Status = status,
		PlaceButton = placeButton,
		RotateButton = rotateButton,
		CancelButton = cancelButton,
		MoveButton = moveButton,
		DeleteButton = deleteButton,
		Hints = hints,
		BuildButton = buildButton,
	}
end

renderList = function()
	for id, button in refs.Tabs do
		local selected = (id == "Edit" and (mode == "Editing" or mode == "Moving")) or (id == category and mode ~= "Editing" and mode ~= "Moving")
		button.BackgroundColor3 = if selected then Theme.Colors.Coins else Theme.Colors.PanelAlt
	end
	local defs = {}
	if mode ~= "Editing" then
		for _, def in BuildingConfig.Buildings do
			if def.Category == category then
				table.insert(defs, def)
			end
		end
		table.sort(defs, function(a, b)
			return a.Order < b.Order
		end)
	end
	for index, def in defs do
		local card = cards[index]
		if not card then
			card = Create("TextButton", { Name = "Card", Size = UDim2.new(1, -8, 0, 70), BackgroundColor3 = Theme.Colors.PanelAlt, AutoButtonColor = true, Text = "", Parent = refs.List })
			Components.Corner(card, Theme.SmallCorner)
			Components.Stroke(card, Theme.Colors.Outline, 2)
			Components.Label({ Name = "Icon", Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(6, 7), TextSize = 40, Parent = card })
			Components.Label({ Name = "Title", Size = UDim2.new(1, -72, 0, 24), Position = UDim2.fromOffset(66, 6), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Parent = card })
			Components.Label({ Name = "Cost", Size = UDim2.new(1, -72, 0, 36), Position = UDim2.fromOffset(66, 30), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = Theme.Fonts.Bold, TextSize = 12, TextColor3 = Theme.Colors.TextMuted, Parent = card })
			card.Activated:Connect(function()
				local buildingId = card:GetAttribute("BuildingId")
				if type(buildingId) == "string" then
					AudioController.Play("UIClick")
					selectBuilding(buildingId)
				end
			end)
			cards[index] = card
		end
		local canAfford = affordable(def)
		local locked = islandLevel() < def.UnlockLevel
		card.Visible = true
		card.LayoutOrder = index
		card:SetAttribute("BuildingId", def.Id)
		local icon = card:FindFirstChild("Icon") :: TextLabel
		local title = card:FindFirstChild("Title") :: TextLabel
		local cost = card:FindFirstChild("Cost") :: TextLabel
		icon.Text = def.Icon
		title.Text = def.DisplayName
		local parts = {}
		if (def.Cost.Coins or 0) > 0 then
			table.insert(parts, Format.Commas(def.Cost.Coins) .. " 🪙")
		end
		for itemId, amount in def.Cost.Items do
			local item = ItemConfig.Get(itemId)
			table.insert(parts, amount .. " " .. (if item then item.Icon else itemId))
		end
		cost.Text = if locked then ("🔒 Island Level %d"):format(def.UnlockLevel) else table.concat(parts, "  ")
		cost.TextColor3 = if locked then Theme.Colors.TextMuted elseif canAfford then Theme.Colors.Green else Theme.Colors.Red
		card.BackgroundColor3 = if locked then Theme.Colors.PanelDark else Theme.Colors.PanelAlt
	end
	for index = #defs + 1, #cards do
		cards[index].Visible = false
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function BuildController.IsActive(): boolean
	return active
end

function BuildController.Enter()
	if active or UIController.IsAnyModalOpen() then
		return
	end
	active = true
	refs.Root.Visible = true
	UIController.GetSlot("Right").Visible = false
	UIController.SetModalOpen("Build", true)
	CameraController.SetMode("Build")
	table.insert(releases, InteractionController.PausePrompts())
	table.insert(releases, InputController.Block("UseTool"))
	setMode("Menu")
	renderList()
end

function BuildController.Exit()
	if not active then
		return
	end
	active = false
	setMode("Menu")
	refs.Root.Visible = false
	UIController.GetSlot("Right").Visible = true
	UIController.SetModalOpen("Build", false)
	CameraController.SetMode("Default")
	for _, release in releases do
		release()
	end
	table.clear(releases)
end

function BuildController.Toggle()
	if active then
		BuildController.Exit()
	else
		BuildController.Enter()
	end
end

function BuildController.Init()
	ghostHighlight = Instance.new("Highlight")
	ghostHighlight.Name = "BuildGhostHighlight"
	ghostHighlight.FillTransparency = 0.55
	ghostHighlight.OutlineTransparency = 0
	ghostHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	ghostHighlight.Enabled = false
	ghostHighlight.Parent = workspace.CurrentCamera

	selectionHighlight = Instance.new("Highlight")
	selectionHighlight.Name = "BuildSelectHighlight"
	selectionHighlight.FillColor = EDIT_COLOR
	selectionHighlight.OutlineColor = EDIT_COLOR
	selectionHighlight.FillTransparency = 0.7
	selectionHighlight.Enabled = false
	selectionHighlight.Parent = workspace.CurrentCamera

	buildUI()
end

function BuildController.Start()
	InputController.On("ToggleBuild", BuildController.Toggle)
	InputController.On("RotateBuild", function()
		rotate(90)
	end)
	InputController.On("RotateBuildRight", function()
		rotate(90)
	end)
	InputController.On("RotateBuildLeft", function()
		rotate(-90)
	end)
	InputController.On("Cancel", function()
		if active then
			cancel()
		end
	end)
	InputController.On("BuildPlace", function()
		if not active then
			return
		end
		if mode == "Editing" then
			tryPickBuilding(nil)
		else
			confirmPlacement()
		end
	end)
	UserInputService.TouchTapInWorld:Connect(function(position, processedByUI)
		if not active or processedByUI then
			return
		end
		pointer = position
		current.Key = ""
		if mode == "Editing" then
			tryPickBuilding(position)
		end
	end)
	-- Keep costs / locks fresh while the menu is open.
	for _, key in { "Coins", "Inventory", "Island" } do
		ClientState.Observe(key, function()
			if active and mode == "Menu" then
				renderList()
			end
		end)
	end
	InputController.DeviceChanged:Connect(function()
		if active then
			updateButtons()
		end
	end)
end

return BuildController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CameraController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/CameraController
	DEPENDENCIES: Shared.Net, Shared.Config.GameConfig, Client.ClientState

	Keeps Roblox's default R15 third-person camera (it already handles mobile,
	gamepad and collisions well) and layers on top:
	  * zoom limits + field of view per MODE (Default / Build / Fishing),
	  * gentle, CAPPED camera shake that only runs while shaking (no permanent
	    per-frame work) and respects the player's CameraShake setting,
	  * a short FOV "punch" for big moments.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local GameConfig = require(Shared.Config.GameConfig)
local ClientState = require(script.Parent.Parent.ClientState)

local SHAKE_BIND_NAME = "IslandCameraShake"

local MODES = {
	Default = { FieldOfView = GameConfig.Camera.DefaultFieldOfView },
	Build = { FieldOfView = GameConfig.Camera.DefaultFieldOfView + 6 }, -- Phase 3
	Fishing = { FieldOfView = GameConfig.Camera.DefaultFieldOfView - 6 }, -- Phase 5
}

local CameraController = {}

local mode = "Default"
local trauma = 0
local shakeDuration = 0.3
local shakeBound = false
local noiseSeed = math.random() * 1000

local function camera(): Camera?
	return workspace.CurrentCamera
end

local function stepShake(deltaTime: number)
	local cam = camera()
	if trauma <= 0 or not cam then
		RunService:UnbindFromRenderStep(SHAKE_BIND_NAME)
		shakeBound = false
		return
	end
	local time = os.clock() * 25
	local strength = trauma * trauma
	local pitch = math.noise(noiseSeed, time) * 0.035 * strength
	local yaw = math.noise(noiseSeed + 10, time) * 0.035 * strength
	local roll = math.noise(noiseSeed + 20, time) * 0.02 * strength
	-- Applied after the default camera script each frame, so it never accumulates.
	cam.CFrame *= CFrame.Angles(pitch, yaw, roll)
	trauma = math.max(0, trauma - deltaTime / math.max(shakeDuration, 0.05))
end

function CameraController.Shake(intensity: number, duration: number?)
	if ClientState.Get("Settings", "CameraShake") == false then
		return
	end
	trauma = math.clamp(math.max(trauma, intensity), 0, GameConfig.Camera.MaxShakeIntensity)
	shakeDuration = duration or 0.3
	if not shakeBound then
		shakeBound = true
		RunService:BindToRenderStep(SHAKE_BIND_NAME, Enum.RenderPriority.Camera.Value + 1, stepShake)
	end
end

function CameraController.SetMode(newMode: string)
	local def = MODES[newMode]
	local cam = camera()
	if not def or not cam then
		return
	end
	mode = newMode
	TweenService:Create(cam, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { FieldOfView = def.FieldOfView }):Play()
end

function CameraController.GetMode(): string
	return mode
end

-- Short FOV pulse for level ups / unlocks.
function CameraController.Punch(amount: number?)
	local cam = camera()
	if not cam then
		return
	end
	local base = MODES[mode].FieldOfView
	cam.FieldOfView = base + (amount or 4)
	TweenService:Create(cam, TweenInfo.new(0.5, Enum.EasingStyle.Back), { FieldOfView = base }):Play()
end

function CameraController.Init()
	local player = Players.LocalPlayer
	player.CameraMinZoomDistance = GameConfig.Camera.MinZoom
	player.CameraMaxZoomDistance = GameConfig.Camera.MaxZoom
end

function CameraController.Start()
	local cam = camera()
	if cam then
		cam.FieldOfView = MODES.Default.FieldOfView
	end
	Net.OnClientEvent("CameraShake", function(intensity: number, duration: number?)
		if type(intensity) == "number" then
			CameraController.Shake(intensity, duration)
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">FarmController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FarmController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/FarmController
	DEPENDENCIES: Shared.Net, Shared.Config.CropConfig, Shared.Util.{CropGrowth, Format},
	              UIController, InputController, InteractionController, AudioController,
	              Client.UI.{Components, Theme}

	Client side of farming (spec §24-§28). The server owns every tile; this
	only SHOWS things and forwards choices:
	  * SEED PICKER — when you plant on a tilled tile while carrying more than
	    one kind of seed, the server sends OpenUI{Screen="SeedPicker"}; picking
	    one fires PlantCropRequest(tileId, seedId).
	  * CROP LABELS — a small billboard over each planted tile with the crop,
	    its stage, a live countdown ("ready in 0:42"), 💧 when watered and a
	    bouncing "READY!" when it can be harvested. Countdown math is the same
	    shared CropGrowth module the server uses, fed by the tile's attributes
	    (TileState, CropId, PlantedAt, WateredAt) and the synced server clock.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local CropConfig = require(Shared.Config.CropConfig)
local CropGrowth = require(Shared.Util.CropGrowth)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local InteractionController = require(script.Parent.InteractionController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local TILE_TAG = "FarmTile"
local LABEL_DISTANCE = 55
local UPDATE_INTERVAL = 0.5

local FarmController = {}

type Label = { Gui: BillboardGui, Title: TextLabel, Status: TextLabel, Bar: Frame, Fill: Frame }

local labels: { [BasePart]: Label } = {}
local picker: Frame
local pickerList: Frame
local pickerTileId: string? = nil
local pickerReleases: { () -> () } = {}

---------------------------------------------------------------------------
-- Seed picker
---------------------------------------------------------------------------

local function closePicker()
	if not picker.Visible then
		return
	end
	picker.Visible = false
	pickerTileId = nil
	UIController.SetModalOpen("SeedPicker", false)
	for _, release in pickerReleases do
		release()
	end
	table.clear(pickerReleases)
end

local function openPicker(tileId: string, seeds: { any })
	for _, child in pickerList:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	for index, option in seeds do
		local seedId = option.Seed
		local cropId = type(seedId) == "string" and CropConfig.SeedToCrop[seedId]
		local crop = cropId and CropConfig.Crops[cropId]
		if crop then
			local button = Components.Button({
				Name = seedId,
				Text = "",
				Color = Theme.Colors.PanelAlt,
				Size = UDim2.fromOffset(120, 132),
				Parent = pickerList,
				OnClick = function()
					if pickerTileId then
						Net.FireServer("PlantCropRequest", pickerTileId, seedId)
						AudioController.Play("PlantSeed")
					end
					closePicker()
				end,
			})
			button.LayoutOrder = index
			for _, child in button:GetChildren() do
				if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
					child:Destroy()
				end
			end
			Components.Label({ Text = crop.Icon, Size = UDim2.new(1, 0, 0, 56), Position = UDim2.fromOffset(0, 6), TextSize = 44, Parent = button })
			Components.Label({ Text = crop.DisplayName, Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 64), TextSize = Theme.TextSize.Medium, Parent = button })
			Components.Label({
				Text = ("x%d · %s"):format(tonumber(option.Count) or 0, Format.Duration(crop.GrowTime)),
				Size = UDim2.new(1, -8, 0, 18),
				Position = UDim2.fromOffset(4, 88),
				Font = Theme.Fonts.Bold,
				TextSize = 13,
				TextColor3 = Theme.Colors.TextMuted,
				Parent = button,
			})
			Components.Label({
				Text = ("sells %d 🪙"):format(crop.SellValue),
				Size = UDim2.new(1, -8, 0, 18),
				Position = UDim2.fromOffset(4, 106),
				Font = Theme.Fonts.Bold,
				TextSize = 13,
				TextColor3 = Theme.Colors.Green,
				Parent = button,
			})
		end
	end
	pickerTileId = tileId
	if picker.Visible then
		return
	end
	picker.Visible = true
	Components.Bounce(picker, 0.06)
	UIController.SetModalOpen("SeedPicker", true)
	table.insert(pickerReleases, InteractionController.PausePrompts())
end

local function buildPicker()
	local panel, content = Components.Panel({
		Title = "🌱 PICK A SEED",
		Size = UDim2.fromOffset(560, 250),
		Parent = UIController.GetModalLayer(),
		OnClose = closePicker,
	})
	panel.Name = "SeedPicker"
	panel.Visible = false
	local list = Create("ScrollingFrame", {
		Name = "Seeds",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		Parent = content,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 10),
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4) }),
	})
	picker = panel
	pickerList = list
end

---------------------------------------------------------------------------
-- Crop labels
---------------------------------------------------------------------------

local function makeLabel(part: BasePart): Label
	local gui = Create("BillboardGui", {
		Name = "CropLabel",
		Size = UDim2.fromOffset(150, 58),
		StudsOffset = Vector3.new(0, 4.2, 0),
		MaxDistance = LABEL_DISTANCE,
		LightInfluence = 0,
		Enabled = false,
		Parent = part,
	})
	local title = Components.Label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextLight,
		Text = "",
		Parent = gui,
	})
	Components.TextStroke(title)
	local status = Components.Label({
		Name = "Status",
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 23),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextLight,
		Text = "",
		Parent = gui,
	})
	Components.TextStroke(status, Theme.Colors.Outline, 1.5)
	local bar = Create("Frame", {
		Name = "Bar",
		Size = UDim2.new(0.7, 0, 0, 9),
		Position = UDim2.new(0.15, 0, 0, 45),
		BackgroundColor3 = Theme.Colors.Outline,
		Parent = gui,
	})
	Components.Corner(bar, UDim.new(1, 0))
	local fill = Create("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.Green, Parent = bar })
	Components.Corner(fill, UDim.new(1, 0))
	local label = { Gui = gui, Title = title, Status = status, Bar = bar, Fill = fill }
	labels[part] = label
	part.Destroying:Once(function()
		labels[part] = nil
	end)
	return label
end

local function updateLabel(part: BasePart, label: Label, now: number)
	local state = part:GetAttribute("TileState")
	local cropId = part:GetAttribute("CropId")
	local crop = type(cropId) == "string" and CropConfig.Crops[cropId]
	if state ~= "Planted" or not crop then
		label.Gui.Enabled = false
		return
	end
	local entry = {
		CropId = cropId :: string,
		PlantedAt = part:GetAttribute("PlantedAt") :: number?,
		WateredAt = part:GetAttribute("WateredAt") :: number?,
	}
	local progress = CropGrowth.GetProgress(entry, now)
	local stage = CropGrowth.GetStage(entry, now)
	local watered = CropGrowth.IsWatered(entry)
	label.Gui.Enabled = true
	label.Title.Text = crop.Icon .. " " .. crop.DisplayName
	if progress >= 1 then
		label.Status.Text = "✨ READY! Harvest me"
		label.Status.TextColor3 = Theme.Colors.Coins
		label.Fill.BackgroundColor3 = Theme.Colors.Coins
		-- Gentle bounce so ready crops catch the eye.
		label.Gui.StudsOffset = Vector3.new(0, 4.2 + math.abs(math.sin(now * 3)) * 0.5, 0)
	else
		local remaining = CropGrowth.GetRemaining(entry, now)
		label.Status.Text = ("%s · %s%s"):format(CropConfig.Stages[stage], Format.Duration(math.ceil(remaining)), if watered then " 💧" else "")
		label.Status.TextColor3 = if watered then Color3.fromRGB(150, 215, 255) else Theme.Colors.TextLight
		label.Fill.BackgroundColor3 = if watered then Theme.Colors.Blue else Theme.Colors.Green
		label.Gui.StudsOffset = Vector3.new(0, 4.2, 0)
	end
	label.Fill.Size = UDim2.fromScale(progress, 1)
end

local function updateLabels()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = workspace:GetServerTimeNow()
	local eye = camera.CFrame.Position
	for _, instance in CollectionService:GetTagged(TILE_TAG) do
		if instance:IsA("BasePart") then
			local label = labels[instance]
			if (instance.Position - eye).Magnitude <= LABEL_DISTANCE + 10 then
				updateLabel(instance, label or makeLabel(instance), now)
			elseif label then
				label.Gui.Enabled = false
			end
		end
	end
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

function FarmController.Init()
	buildPicker()
end

function FarmController.Start()
	Net.OnClientEvent("OpenUI", function(payload: any)
		if type(payload) ~= "table" or payload.Screen ~= "SeedPicker" then
			return
		end
		if type(payload.TileId) ~= "string" or type(payload.Seeds) ~= "table" then
			return
		end
		if UIController.IsAnyModalOpen() and not picker.Visible then
			return
		end
		openPicker(payload.TileId, payload.Seeds)
	end)
	InputController.On("Cancel", closePicker)

	task.spawn(function()
		while true do
			updateLabels()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return FarmController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">FishingController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FishingController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/FishingController
	DEPENDENCIES: Shared.Net, Shared.Config.{FishConfig, RarityConfig, IslandConfig}, Shared.Util.R15,
	              InputController, UIController, ToolController, InteractionController,
	              AudioController, VFXController, CameraController, Client.UI.{Components, Theme}

	Client side of fishing (spec §29-§32). With a rod equipped, USE (click /
	R2 / the touch USE button) drives the whole thing:

	  Idle     USE → FishingRequest{Op="Cast"}   (the "[E] Fish" prompt works too)
	  Waiting  bobber floats on the water, line drawn with a Beam
	  Bite     "!" + splash + sound → USE within the hook window
	  Reeling  MINIGAME: HOLD USE to lift the green zone, keep the fish inside
	           it until the bar fills. Let it escape and the bar drains.
	  Result   catch card (rarity colour, weight, NEW!) or the escape reason

	The client never knows WHICH fish bit — only its rarity and difficulty.
	It reports Success/Fail with the server's one-time token; the server
	rejects catches faster than FishConfig.MinReelTime and grants the fish.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local FishConfig = require(Shared.Config.FishConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local ToolController = require(script.Parent.ToolController)
local InteractionController = require(script.Parent.InteractionController)
local AudioController = require(script.Parent.AudioController)
local VFXController = require(script.Parent.VFXController)
local CameraController = require(script.Parent.CameraController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local CAST_DISTANCE = 9
local CAST_TIMEOUT = 2.5 -- no Cast reply in this long → the server said no
local CAST_FLIGHT = 0.45
local START_GRACE = 0.9 -- seconds at the start of a reel where progress can't drain

local FishingController = {}

type Minigame = {
	Token: any,
	Difficulty: number,
	Rarity: string,
	ZoneSize: number,
	ZonePos: number,
	ZoneVel: number,
	FishPos: number,
	FishTarget: number,
	FishTimer: number,
	Progress: number,
	Elapsed: number,
	Finished: boolean,
}

local state: string = "Idle" -- Idle | Casting | Waiting | Bite | Hooking | Reeling
local castRequestedAt = 0
local random = Random.new()

local bobber: Model? = nil
local bobberBase: Vector3 = Vector3.zero
local castFrom: Vector3 = Vector3.zero
local castStartedAt = 0
local lineBeam: Beam? = nil
local rodAttachment: Attachment? = nil
local biteMark: BillboardGui? = nil
local renderConnection: RBXScriptConnection? = nil
local resumePrompts: (() -> ())? = nil
local minigame: Minigame? = nil

type Refs = {
	Status: TextLabel,
	Reel: Frame,
	ReelTitle: TextLabel,
	Track: Frame,
	Zone: Frame,
	Fish: TextLabel,
	ProgressFill: Frame,
	ReelHint: TextLabel,
	Card: Frame,
	CardIcon: TextLabel,
	CardTitle: TextLabel,
	CardRarity: TextLabel,
	CardInfo: TextLabel,
	CardNew: TextLabel,
}
local refs: Refs
local cardToken = 0

---------------------------------------------------------------------------
-- World visuals (all local, under the camera)
---------------------------------------------------------------------------

local function useHint(): string
	local device = InputController.GetDevice()
	if device == "Touch" then
		return "USE"
	elseif device == "Gamepad" then
		return "R2"
	end
	return "CLICK"
end

local function waterHeightAt(position: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	local hit = workspace:Raycast(position + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), params)
	return if hit then hit.Position.Y else IslandConfig.SeaLevel
end

local function rodTip(): Attachment?
	local character = player.Character
	if not character then
		return nil
	end
	if rodAttachment and rodAttachment.Parent and rodAttachment:IsDescendantOf(character) then
		return rodAttachment
	end
	local tip = character:FindFirstChild("Tip", true)
	local anchor: BasePart? = if tip and tip:IsA("BasePart") then tip else R15.GetPart(character, "RightHand")
	if not anchor then
		return nil
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "FishingLine"
	attachment.Position = if anchor.Name == "Tip" then Vector3.new(0, anchor.Size.Y / 2, 0) else Vector3.zero
	attachment.Parent = anchor
	rodAttachment = attachment
	return attachment
end

local function makeBobber(): Model
	local model = Instance.new("Model")
	model.Name = "Bobber"
	local ball = Instance.new("Part")
	ball.Name = "Float"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.7, 0.7, 0.7)
	ball.Color = Color3.fromRGB(235, 60, 55)
	ball.Material = Enum.Material.SmoothPlastic
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Parent = model
	local cap = Instance.new("Part")
	cap.Name = "Cap"
	cap.Shape = Enum.PartType.Cylinder
	cap.Size = Vector3.new(0.12, 0.72, 0.72)
	cap.Color = Color3.fromRGB(250, 250, 250)
	cap.Material = Enum.Material.SmoothPlastic
	cap.Anchored = true
	cap.CanCollide = false
	cap.CanQuery = false
	cap.CanTouch = false
	cap.CFrame = CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.rad(90))
	cap.Parent = model
	model.PrimaryPart = ball
	local attachment = Instance.new("Attachment")
	attachment.Name = "LineEnd"
	attachment.Parent = ball
	model.Parent = workspace.CurrentCamera
	return model
end

local function clearWorld()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
	if lineBeam then
		lineBeam:Destroy()
		lineBeam = nil
	end
	if bobber then
		bobber:Destroy()
		bobber = nil
	end
	biteMark = nil
end

local function showBiteMark(show: boolean)
	if not bobber then
		return
	end
	if show and not biteMark then
		local gui = Create("BillboardGui", {
			Name = "BiteMark",
			Size = UDim2.fromOffset(60, 60),
			StudsOffset = Vector3.new(0, 2.2, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			Parent = bobber.PrimaryPart,
		})
		local label = Components.Label({ Text = "!", Size = UDim2.fromScale(1, 1), TextSize = 54, TextColor3 = Theme.Colors.Red, Parent = gui })
		Components.TextStroke(label, Theme.Colors.TextLight, 3)
		Components.Bounce(label, 0.5)
		biteMark = gui
	elseif not show and biteMark then
		biteMark:Destroy()
		biteMark = nil
	end
end

local function renderWorld()
	if not bobber then
		return
	end
	local now = os.clock()
	local flight = math.clamp((now - castStartedAt) / CAST_FLIGHT, 0, 1)
	local position: Vector3
	if flight < 1 then
		-- Arc from the rod tip to the water.
		local flat = castFrom:Lerp(bobberBase, flight)
		position = flat + Vector3.new(0, math.sin(flight * math.pi) * 5, 0)
	elseif state == "Bite" then
		position = bobberBase + Vector3.new(math.sin(now * 40) * 0.08, -0.45 + math.sin(now * 25) * 0.12, 0)
	elseif state == "Hooking" or state == "Reeling" then
		position = bobberBase + Vector3.new(math.sin(now * 13) * 0.25, -0.3 + math.sin(now * 17) * 0.1, math.cos(now * 11) * 0.25)
	else
		position = bobberBase + Vector3.new(0, math.sin(now * 2.2) * 0.1, 0)
	end
	bobber:PivotTo(CFrame.new(position))

	local tip = rodTip()
	if tip and not lineBeam then
		local beam = Instance.new("Beam")
		beam.Name = "FishingLine"
		beam.Attachment0 = tip
		beam.Attachment1 = (bobber.PrimaryPart :: BasePart):FindFirstChild("LineEnd") :: Attachment
		beam.Width0 = 0.05
		beam.Width1 = 0.05
		beam.FaceCamera = true
		beam.Segments = 12
		beam.CurveSize0 = 0
		beam.CurveSize1 = -1.5
		beam.Color = ColorSequence.new(Color3.fromRGB(245, 245, 245))
		beam.LightInfluence = 0
		beam.Transparency = NumberSequence.new(0.15)
		beam.Parent = bobber
		lineBeam = beam
	elseif lineBeam and tip then
		lineBeam.Attachment0 = tip
	end
end

local function startBobber()
	clearWorld()
	local root = R15.GetRootPart(player.Character)
	if not root then
		return
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.1 then
		look = Vector3.new(0, 0, -1)
	end
	local target = root.Position + look.Unit * CAST_DISTANCE
	bobberBase = Vector3.new(target.X, waterHeightAt(target) + 0.15, target.Z)
	local tip = rodTip()
	castFrom = if tip then tip.WorldPosition else root.Position + Vector3.new(0, 2, 0)
	castStartedAt = os.clock()
	bobber = makeBobber()
	renderConnection = RunService.RenderStepped:Connect(renderWorld)
	task.delay(CAST_FLIGHT, function()
		if bobber and state ~= "Idle" then
			VFXController.Play("WaterSplash", bobberBase)
		end
	end)
end

---------------------------------------------------------------------------
-- UI
---------------------------------------------------------------------------

local function setStatus(text: string?, color: Color3?)
	refs.Status.Visible = text ~= nil
	if text then
		refs.Status.Text = text
		refs.Status.BackgroundColor3 = color or Theme.Colors.Outline
		Components.Bounce(refs.Status, 0.08)
	end
end

local function resetAll()
	state = "Idle"
	minigame = nil
	refs.Reel.Visible = false
	setStatus(nil)
	clearWorld()
	if resumePrompts then
		resumePrompts()
		resumePrompts = nil
	end
end

local function cancelFishing()
	if state == "Idle" then
		return
	end
	Net.FireServer("FishingRequest", { Op = "Cancel" })
	resetAll()
end

local function showCatch(fishId: string, weight: number, isNew: boolean)
	local fish = FishConfig.Fish[fishId]
	if not fish then
		return
	end
	local rarity = RarityConfig.Get(fish.Rarity)
	cardToken += 1
	local token = cardToken
	refs.CardIcon.Text = "🐟"
	refs.CardIcon.TextColor3 = fish.Color
	refs.CardTitle.Text = fish.DisplayName
	refs.CardRarity.Text = string.upper(rarity.DisplayName)
	refs.CardRarity.TextColor3 = rarity.Color
	refs.CardInfo.Text = ("%.1f kg · sells for %d 🪙"):format(weight, fish.SellValue)
	refs.CardNew.Visible = isNew
	local stroke = refs.Card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = rarity.Color
	end
	refs.Card.Visible = true
	Components.Bounce(refs.Card, 0.2)
	if rarity.Rank >= 4 then
		UIController.Banner(string.upper(rarity.DisplayName) .. " CATCH!", fish.DisplayName, "Reward")
	end
	task.delay(3.5, function()
		if cardToken == token then
			refs.Card.Visible = false
		end
	end)
end

local function buildUI()
	local layer = UIController.GetModalLayer()

	local status = Components.Label({
		Name = "FishingStatus",
		Size = UDim2.fromOffset(360, 40),
		Position = UDim2.new(0.5, 0, 1, -128),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = Theme.Colors.Outline,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Medium,
		Text = "",
		Visible = false,
		Parent = layer,
	})
	Components.Corner(status, UDim.new(1, 0))

	-- REEL MINIGAME -------------------------------------------------------
	local reel = Create("Frame", {
		Name = "ReelMinigame",
		Size = UDim2.fromOffset(190, 420),
		Position = UDim2.new(0.5, 150, 0.5, -10),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = layer,
	})
	Components.Corner(reel)
	Components.Stroke(reel, Theme.Colors.Outline, 4)
	local reelTitle = Components.Label({ Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), TextSize = Theme.TextSize.Large, Text = "", Parent = reel })
	Components.TextStroke(reelTitle, Theme.Colors.Outline, 2)
	local track = Create("Frame", {
		Name = "Track",
		Size = UDim2.fromOffset(70, 320),
		Position = UDim2.fromOffset(30, 42),
		BackgroundColor3 = Color3.fromRGB(60, 140, 210),
		ClipsDescendants = true,
		Parent = reel,
	}, {
		Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(120, 200, 255), Color3.fromRGB(30, 80, 160)),
		}),
	})
	Components.Corner(track, Theme.SmallCorner)
	Components.Stroke(track, Theme.Colors.Outline, 3)
	local zone = Create("Frame", {
		Name = "Zone",
		Size = UDim2.fromScale(1, 0.3),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Green,
		BackgroundTransparency = 0.25,
		Parent = track,
	})
	Components.Corner(zone, Theme.SmallCorner)
	Components.Stroke(zone, Theme.Colors.TextLight, 2)
	local fishIcon = Components.Label({
		Name = "Fish",
		Text = "🐟",
		Size = UDim2.fromOffset(44, 36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		TextSize = 32,
		ZIndex = 3,
		Parent = track,
	})
	local progressBack = Create("Frame", {
		Name = "Progress",
		Size = UDim2.fromOffset(26, 320),
		Position = UDim2.fromOffset(122, 42),
		BackgroundColor3 = Theme.Colors.PanelDark,
		ClipsDescendants = true,
		Parent = reel,
	})
	Components.Corner(progressBack, UDim.new(1, 0))
	Components.Stroke(progressBack, Theme.Colors.Outline, 3)
	local progressFill = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 0.25),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Coins,
		Parent = progressBack,
	})
	Components.Corner(progressFill, UDim.new(1, 0))
	local reelHint = Components.Label({
		Size = UDim2.new(1, -12, 0, 44),
		Position = UDim2.fromOffset(6, 368),
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		Text = "",
		Parent = reel,
	})

	-- CATCH CARD -----------------------------------------------------------
	local card = Create("Frame", {
		Name = "CatchCard",
		Size = UDim2.fromOffset(320, 150),
		Position = UDim2.new(0.5, 0, 0, 140),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = layer,
	})
	Components.Corner(card)
	Components.Stroke(card, Theme.Colors.Outline, 5)
	local cardIcon = Components.Label({ Size = UDim2.fromOffset(100, 100), Position = UDim2.fromOffset(12, 25), TextSize = 76, Text = "🐟", Parent = card })
	local cardRarity = Components.Label({ Size = UDim2.new(1, -130, 0, 22), Position = UDim2.fromOffset(118, 18), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Text = "", Parent = card })
	Components.TextStroke(cardRarity, Theme.Colors.Outline, 1.5)
	local cardTitle = Components.Label({ Size = UDim2.new(1, -130, 0, 34), Position = UDim2.fromOffset(118, 42), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Title, TextScaled = true, Text = "", Parent = card })
	local cardInfo = Components.Label({ Size = UDim2.new(1, -130, 0, 40), Position = UDim2.fromOffset(118, 80), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = card })
	local cardNew = Components.Label({
		Size = UDim2.fromOffset(70, 28),
		Position = UDim2.new(1, -10, 0, -12),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Red,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Medium,
		Text = "NEW!",
		Visible = false,
		Parent = card,
	})
	Components.Corner(cardNew, UDim.new(1, 0))
	Components.Stroke(cardNew)
	Components.Label({ Text = "YOU CAUGHT", Size = UDim2.fromOffset(120, 16), Position = UDim2.fromOffset(12, 8), Font = Theme.Fonts.Bold, TextSize = 12, TextColor3 = Theme.Colors.TextMuted, Parent = card })

	refs = {
