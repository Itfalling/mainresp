      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Net
	SCRIPT TYPE:  ModuleScript (shared networking layer)
	WHERE:        ReplicatedStorage/Shared/Net
	DEPENDENCIES: Shared.Config.RemoteConfig, Shared.Util.RateLimiter
	REQUIRED OBJECTS: none (the server creates ReplicatedStorage/Remotes)

	The only module allowed to touch RemoteEvents.
	  * Server: Net.Init() creates every remote listed in RemoteConfig.
	  * Unknown remote names error immediately (no random remote creation).
	  * Every client->server handler is automatically rate limited and wrapped
	    in pcall; violations are reported to AntiExploitService.
	  * After all services start, Net.FinalizeHandlers() drains remotes that no
	    phase handles yet, flagging clients that fire them.

	Server API:  Net.Init(), Net.OnServerEvent(name, fn(player, ...)),
	             Net.FireClient(name, player, ...), Net.FireAllClients(name, ...),
	             Net.FireClients(name, players, ...), Net.SetViolationHandler(fn),
	             Net.FinalizeHandlers()
	Client API:  Net.FireServer(name, ...), Net.OnClientEvent(name, fn(...))
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RemoteConfig = require(script.Parent.Config.RemoteConfig)
local RateLimiter = require(script.Parent.Util.RateLimiter)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"
local CLIENT_WAIT_TIMEOUT = 60

type ViolationHandler = (player: Player, reason: string, weight: number) -> ()

local Net = {}

local folder: Folder? = nil
local remotes: { [string]: RemoteEvent } = {}
local handledOnServer: { [string]: boolean } = {}
local violationHandler: ViolationHandler? = nil

local function reportViolation(player: Player, reason: string, weight: number)
	if violationHandler then
		violationHandler(player, reason, weight)
	end
end

local function getRemote(name: string): RemoteEvent
	local cached = remotes[name]
	if cached then
		return cached
	end
	assert(RemoteConfig.Known[name], ("[Net] Unknown remote '%s' — add it to RemoteConfig"):format(tostring(name)))

	if IS_SERVER then
		assert(folder, "[Net] Net.Init() must run on the server before remotes are used")
		local remote = folder:FindFirstChild(name)
		assert(remote and remote:IsA("RemoteEvent"), "[Net] Remote missing: " .. name)
		remotes[name] = remote
		return remote
	end

	if not folder then
		local found = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_WAIT_TIMEOUT)
		assert(found and found:IsA("Folder"), "[Net] ReplicatedStorage.Remotes never appeared (is the server running?)")
		folder = found
	end
	assert(folder)
	local remote = folder:WaitForChild(name, CLIENT_WAIT_TIMEOUT)
	assert(remote and remote:IsA("RemoteEvent"), "[Net] Remote missing on client: " .. name)
	remotes[name] = remote
	return remote
end

-- SERVER -------------------------------------------------------------------

function Net.Init()
	assert(IS_SERVER, "Net.Init is server-only")
	if folder then
		return
	end
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		warn("[Net] Replacing an existing ReplicatedStorage.Remotes folder")
		existing:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = FOLDER_NAME
	for name in RemoteConfig.Known do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = newFolder
	end
	newFolder.Parent = ReplicatedStorage
	folder = newFolder
end

function Net.SetViolationHandler(handler: ViolationHandler)
	violationHandler = handler
end

function Net.OnServerEvent(name: string, handler: (player: Player, ...any) -> ())
	assert(IS_SERVER, "OnServerEvent is server-only")
	assert(RemoteConfig.Known[name] == "ClientToServer", ("[Net] %s is not a client->server remote"):format(name))
	assert(not handledOnServer[name], ("[Net] %s already has a server handler (one owner per remote)"):format(name))
	handledOnServer[name] = true

	local limits = RemoteConfig.RateLimits[name] or RemoteConfig.DefaultRateLimit
	local limiter = RateLimiter.new(limits.Rate, limits.Burst)

	getRemote(name).OnServerEvent:Connect(function(player: Player, ...)
		if not limiter:Check(player) then
			reportViolation(player, "RateLimit:" .. name, 1)
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

-- Any client->server remote nobody handles yet (future phases) is drained so
-- the engine queue never fills, and firing it is treated as suspicious.
function Net.FinalizeHandlers()
	assert(IS_SERVER, "FinalizeHandlers is server-only")
	for _, name in RemoteConfig.ClientToServer do
		if not handledOnServer[name] then
			handledOnServer[name] = true
			getRemote(name).OnServerEvent:Connect(function(player: Player)
				reportViolation(player, "UnhandledRemote:" .. name, 2)
			end)
		end
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER, "FireClient is server-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	if player.Parent then
		getRemote(name):FireClient(player, ...)
	end
end

function Net.FireClients(name: string, players: { Player }, ...: any)
	for _, player in players do
		Net.FireClient(name, player, ...)
	end
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER, "FireAllClients is server-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	getRemote(name):FireAllClients(...)
end

-- CLIENT -------------------------------------------------------------------

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER, "FireServer is client-only")
	assert(RemoteConfig.Known[name] == "ClientToServer", ("[Net] %s is not a client->server remote"):format(name))
	getRemote(name):FireServer(...)
end

function Net.OnClientEvent(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "OnClientEvent is client-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="22">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">AssetId</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  AssetId
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/AssetId
	DEPENDENCIES: none

	This project ships WITHOUT real animation / sound asset IDs. Every asset
	slot uses the literal "rbxassetid://PLACEHOLDER". Systems call
	AssetId.IsPlaceholder() and gracefully fall back instead of erroring,
	so the game keeps working until real IDs are pasted into the configs.
]]

local AssetId = {}

AssetId.PLACEHOLDER = "rbxassetid://PLACEHOLDER"

function AssetId.IsPlaceholder(id: string?): boolean
	if id == nil or id == "" then
		return true
	end
	if string.find(id, "PLACEHOLDER", 1, true) then
		return true
	end
	return id == "rbxassetid://0"
end

return AssetId
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Format
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Format
	DEPENDENCIES: none

	Number / time formatting for UI.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa" }

function Format.Commas(value: number): string
	local text = tostring(math.floor(value))
	local negative = string.sub(text, 1, 1) == "-"
	if negative then
		text = string.sub(text, 2)
	end
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then
		formatted = string.sub(formatted, 2)
	end
	return (negative and "-" or "") .. formatted
end

-- 999 -> "999", 12_345 -> "12.3K", 4_500_000 -> "4.5M"
function Format.Abbreviate(value: number): string
	local absolute = math.abs(value)
	if absolute < 10_000 then
		return Format.Commas(value)
	end
	local tier = math.min(math.floor(math.log10(absolute) / 3), #SUFFIXES - 1)
	local scaled = value / 10 ^ (tier * 3)
	local text = string.format("%.1f", scaled)
	text = string.gsub(text, "%.0$", "")
	return text .. SUFFIXES[tier + 1]
end

function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">IslandLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  IslandLayout
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/IslandLayout
	DEPENDENCIES: Shared.Config.IslandConfig

	Pure math for island slots and areas. Shared so the server (validation) and
	client (build preview, UI) always agree on where land is.
]]

local IslandConfig = require(script.Parent.Parent.Config.IslandConfig)

local IslandLayout = {}

-- World-space origin (CFrame at sea level) of server island slot `index` (1-based).
function IslandLayout.GetSlotOrigin(index: number): CFrame
	local zeroBased = index - 1
	local column = zeroBased % IslandConfig.SlotsPerRow
	local row = zeroBased // IslandConfig.SlotsPerRow
	local x = column * IslandConfig.SlotSpacing
	local z = row * IslandConfig.SlotSpacing
	return CFrame.new(x, IslandConfig.SeaLevel, z)
end

-- Island-local XZ centre of an area.
function IslandLayout.GetAreaCenter(areaId: string): Vector2
	local area = IslandConfig.Areas[areaId]
	assert(area, "Unknown area " .. tostring(areaId))
	local angle = math.rad(area.Angle)
	return Vector2.new(math.sin(angle), math.cos(angle)) * area.Distance
end

-- Where the 🔒 unlock sign for an area stands: on the starter shore, facing it.
function IslandLayout.GetAreaMarkerPosition(areaId: string): Vector2
	local area = IslandConfig.Areas[areaId]
	local angle = math.rad(area.Angle)
	local direction = Vector2.new(math.sin(angle), math.cos(angle))
	return direction * (IslandConfig.Areas.Starter.Radius - 8)
end

-- Is an island-local XZ point inside the given area's circle (minus margin)?
function IslandLayout.IsInArea(areaId: string, localPoint: Vector2, margin: number?): boolean
	local area = IslandConfig.Areas[areaId]
	if not area then
		return false
	end
	local center = IslandLayout.GetAreaCenter(areaId)
	return (localPoint - center).Magnitude <= area.Radius - (margin or 0)
end

-- Is the point on land the owner has unlocked?
function IslandLayout.IsOnUnlockedLand(unlockedAreas: { [string]: boolean }, localPoint: Vector2, margin: number?): boolean
	for areaId, unlocked in unlockedAreas do
		if unlocked and IslandLayout.IsInArea(areaId, localPoint, margin) then
			return true
		end
	end
	return false
end

-- Largest distance from island centre any area can reach (used for cleanup bounds).
function IslandLayout.GetMaxExtent(): number
	local extent = 0
	for _, area: any in IslandConfig.Areas do
		extent = math.max(extent, area.Distance + area.Radius + IslandConfig.ShallowsWidth)
	end
	return extent
end

return IslandLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Maid
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Maid
	DEPENDENCIES: none

	Collects connections / instances / cleanup functions and releases them
	together. Used anywhere a system owns resources tied to a lifetime
	(a character, an island, an open UI panel...).
]]

export type Maid = {
	Give: <T>(self: Maid, task: T) -> T,
	Cleanup: (self: Maid) -> (),
	Destroy: (self: Maid) -> (),
}

local Maid = {}
Maid.__index = Maid

function Maid.new(): Maid
	return (setmetatable({ _tasks = {} }, Maid) :: any) :: Maid
end

function Maid.Give(self: any, item: any): any
	table.insert(self._tasks, item)
	return item
end

local function cleanupTask(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		if coroutine.status(item) == "suspended" then
			task.cancel(item)
		end
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Maid.Cleanup(self: any)
	local tasks = self._tasks
	self._tasks = {}
	-- Clean up in reverse order of registration (LIFO), like a stack.
	for i = #tasks, 1, -1 do
		local ok, err = pcall(cleanupTask :: any, tasks[i])
		if not ok then
			warn("[Maid] cleanup error:", err)
		end
	end
end

Maid.Destroy = Maid.Cleanup

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">R15</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  R15
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/R15
	DEPENDENCIES: none

	Single source of truth for R15 body-part and Motor6D names. Nothing in the
	project hard-codes R6 parts ("Torso", "Right Arm", ...). If you ever need
	R6 compatibility, add it HERE and nowhere else.
]]

local R15 = {}

R15.PartNames = table.freeze({
	"Head",
	"UpperTorso",
	"LowerTorso",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
	"HumanoidRootPart",
})

-- Motor6D name -> the body part that parents it in a standard R15 rig.
R15.MotorParents = table.freeze({
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
	LeftAnkle = "LeftFoot",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	RightAnkle = "RightFoot",
})

-- Attachments the tool system grips with.
R15.GripAttachments = table.freeze({
	RightHand = "RightGripAttachment",
	LeftHand = "LeftGripAttachment",
})

function R15.GetHumanoid(character: Model?): Humanoid?
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

function R15.GetRootPart(character: Model?): BasePart?
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function R15.GetPart(character: Model?, partName: string): BasePart?
	if not character then
		return nil
	end
	local part = character:FindFirstChild(partName)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

function R15.GetMotor(character: Model?, motorName: string): Motor6D?
	local parentName = R15.MotorParents[motorName]
	if not parentName then
		return nil
	end
	local parent = R15.GetPart(character, parentName)
	local motor = parent and parent:FindFirstChild(motorName)
	if motor and motor:IsA("Motor6D") then
		return motor
	end
	return nil
end

function R15.IsR15(character: Model?): boolean
	local humanoid = R15.GetHumanoid(character)
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return false
	end
	return R15.GetPart(character, "UpperTorso") ~= nil and R15.GetPart(character, "RightHand") ~= nil
end

function R15.IsAlive(character: Model?): boolean
	local humanoid = R15.GetHumanoid(character)
	return humanoid ~= nil and humanoid.Health > 0 and R15.GetRootPart(character) ~= nil
end

return R15
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  RateLimiter
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/RateLimiter
	DEPENDENCIES: none

	Token-bucket rate limiter. Each key (usually a Player) owns a bucket that
	refills at `rate` tokens per second up to `burst` tokens. Keys are held
	weakly so Player objects are released automatically when they leave.
]]

export type RateLimiter = {
	Rate: number,
	Burst: number,
	Check: (self: RateLimiter, key: any, cost: number?) -> boolean,
	Reset: (self: RateLimiter, key: any) -> (),
}

type Bucket = { Tokens: number, Last: number }

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(rate: number, burst: number): RateLimiter
	assert(rate > 0 and burst > 0, "RateLimiter needs positive rate and burst")
	local self = setmetatable({
		Rate = rate,
		Burst = burst,
		_buckets = setmetatable({} :: { [any]: Bucket }, { __mode = "k" }),
	}, RateLimiter)
	return (self :: any) :: RateLimiter
end

function RateLimiter.Check(self: any, key: any, cost: number?): boolean
	local price = cost or 1
	local now = os.clock()
	local bucket: Bucket? = self._buckets[key]
	if not bucket then
		bucket = { Tokens = self.Burst, Last = now }
		self._buckets[key] = bucket
	end
	assert(bucket)
	bucket.Tokens = math.min(self.Burst, bucket.Tokens + (now - bucket.Last) * self.Rate)
	bucket.Last = now
	if bucket.Tokens >= price then
		bucket.Tokens -= price
		return true
	end
	return false
end

function RateLimiter.Reset(self: any, key: any)
	self._buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Serializer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Serializer
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Serializer
	DEPENDENCIES: none

	Converts Roblox datatypes into DataStore-safe tables and back.
	Instances are NEVER saved; only plain data like:
		{ BuildingId = "WoodenCabin", Position = { X = 10, Y = 5, Z = -30 }, Rotation = 90 }
	All island positions are saved in ISLAND-LOCAL space so an island can be
	loaded into any server slot.
]]

export type SerializedVector3 = { X: number, Y: number, Z: number }

local Serializer = {}

local function round(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

function Serializer.Vector3(value: Vector3): SerializedVector3
	return { X = round(value.X, 0.01), Y = round(value.Y, 0.01), Z = round(value.Z, 0.01) }
end

function Serializer.ToVector3(data: any): Vector3?
	if type(data) ~= "table" then
		return nil
	end
	local x, y, z = data.X, data.Y, data.Z
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		return nil
	end
	if x ~= x or y ~= y or z ~= z then
		return nil
	end
	return Vector3.new(x, y, z)
end

-- Rotation is stored as a yaw angle in whole degrees (0..359).
function Serializer.Yaw(cframe: CFrame): number
	local _, yaw, _ = cframe:ToEulerAnglesYXZ()
	return round(math.deg(yaw), 1) % 360
end

function Serializer.ToCFrame(position: Vector3, yawDegrees: number): CFrame
	return CFrame.new(position) * CFrame.Angles(0, math.rad(yawDegrees), 0)
end

return Serializer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Signal
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Signal
	DEPENDENCIES: none

	Lightweight script signal used by services and controllers for in-process
	events (never for networking — that is Net's job).

	Usage:
		local changed = Signal.new()
		local conn = changed:Connect(function(a, b) end)
		changed:Fire(1, 2)
		conn:Disconnect()
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
	Destroy: (self: Signal) -> (),
}

type ConnectionImpl = {
	Connected: boolean,
	_signal: any,
	_fn: (...any) -> (),
	Disconnect: (self: ConnectionImpl) -> (),
}

local Connection = {}
Connection.__index = Connection

function Connection.Disconnect(self: ConnectionImpl)
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	local self = setmetatable({
		_handlers = {} :: { ConnectionImpl },
	}, Signal)
	return (self :: any) :: Signal
end

function Signal.Connect(self: any, fn: (...any) -> ()): Connection
	local connection = setmetatable({
		Connected = true,
		_signal = self,
		_fn = fn,
	}, Connection)
	table.insert(self._handlers, connection)
	return (connection :: any) :: Connection
end

function Signal.Once(self: any, fn: (...any) -> ()): Connection
	local connection: Connection
	connection = Signal.Connect(self, function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal.Fire(self: any, ...: any)
	-- Copy so handlers can disconnect while we iterate.
	local snapshot: { ConnectionImpl } = table.clone(self._handlers)
	for _, connection in snapshot do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal.Wait(self: any): ...any
	local thread = coroutine.running()
	Signal.Once(self, function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: any)
	for _, connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

function Signal.Destroy(self: any)
	Signal.DisconnectAll(self)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  TableUtil
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/TableUtil
	DEPENDENCIES: none
]]

local TableUtil = {}

function TableUtil.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value :: any do
		copy[TableUtil.DeepCopy(key)] = TableUtil.DeepCopy(child)
	end
	return (copy :: any) :: T
end

-- Fills in any keys missing from `target` using a deep copy of `template`.
-- Existing values are left untouched (type repair is DataSchema's job).
function TableUtil.Reconcile(target: { [any]: any }, template: { [any]: any })
	for key, templateValue in template do
		if target[key] == nil then
			target[key] = TableUtil.DeepCopy(templateValue)
		elseif type(templateValue) == "table" and type(target[key]) == "table" then
			TableUtil.Reconcile(target[key], templateValue)
		end
	end
end

function TableUtil.Count(dict: { [any]: any }): number
	local count = 0
	for _ in dict do
		count += 1
	end
	return count
end

function TableUtil.Keys<K>(dict: { [K]: any }): { K }
	local keys = {}
	for key in dict do
		table.insert(keys, key)
	end
	return keys
end

-- Recursively freezes a config table so accidental writes error loudly.
function TableUtil.DeepFreeze<T>(value: T): T
	if type(value) == "table" and not table.isfrozen(value :: any) then
		for _, child in value :: any do
			TableUtil.DeepFreeze(child)
		end
		table.freeze(value :: any)
	end
	return value
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Validate
	SCRIPT TYPE:  ModuleScript (shared utility, used mostly by the server)
	WHERE:        ReplicatedStorage/Shared/Util/Validate
	DEPENDENCIES: none

	Type guards for anything that crosses the network. Every RemoteEvent
	handler validates its arguments with these before touching game state.
	Never trust types coming from a client.
]]

local Validate = {}

function Validate.IsFinite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Validate.Number(value: any, min: number?, max: number?): boolean
	if not Validate.IsFinite(value) then
		return false
	end
	if min and value < min then
		return false
	end
	if max and value > max then
		return false
	end
	return true
end

function Validate.Integer(value: any, min: number?, max: number?): boolean
	return Validate.Number(value, min, max) and math.floor(value) == value
end

function Validate.String(value: any, maxLength: number?): boolean
	if type(value) ~= "string" then
		return false
	end
	if maxLength and #value > maxLength then
		return false
	end
	return utf8.len(value) ~= nil
end

-- Config identifiers: letters, digits and underscores only.
function Validate.Id(value: any): boolean
	return Validate.String(value, 64) and string.match(value, "^[%w_]+$") ~= nil
end

function Validate.Boolean(value: any): boolean
	return type(value) == "boolean"
end

function Validate.Vector3(value: any, maxMagnitude: number?): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	if not (Validate.IsFinite(value.X) and Validate.IsFinite(value.Y) and Validate.IsFinite(value.Z)) then
		return false
	end
	return maxMagnitude == nil or value.Magnitude <= maxMagnitude
end

function Validate.OneOf(value: any, allowed: { [any]: any }): boolean
	return value ~= nil and allowed[value] ~= nil
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="33">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="34">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">DataSchema</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  DataSchema
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Data/DataSchema
	DEPENDENCIES: Shared.Config.GameConfig, ItemConfig, ToolConfig, IslandConfig,
	              ProgressionConfig, Shared.Util.TableUtil

	Defines the saved player profile, migrates old versions and REPAIRS bad
	data instead of wiping it (spec §146):
	  * missing keys are filled from the template,
	  * wrong types are reset (old value moved to Quarantine),
	  * unknown item/tool/area ids are moved to Quarantine — NOT deleted — and
	    are restored automatically if a later update re-adds that id,
	  * numbers are clamped to sane, finite, integer ranges.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local ToolConfig = require(Shared.Config.ToolConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local TableUtil = require(Shared.Util.TableUtil)

local DataSchema = {}

DataSchema.CurrentVersion = 1

-- Top-level keys never sent to the client.
DataSchema.PrivateKeys = table.freeze({ Quarantine = true })

local TEMPLATE = {
	Version = DataSchema.CurrentVersion,

	Coins = GameConfig.StartingCoins,
	Gems = GameConfig.StartingGems,
	XP = 0,
	Level = 1,

	Inventory = {
		Items = {}, -- [itemId] = count
		Capacity = GameConfig.Inventory.StartingCapacity,
		Favorites = {}, -- [itemId] = true
	},

	Tools = {
		Owned = {}, -- [toolId] = true
		Hotbar = {}, -- array of toolIds (<= ToolConfig.HotbarSize)
		Equipped = "", -- "" = nothing
		Durability = {}, -- [toolId] = number (optional system)
	},

	Island = {
		IslandId = "",
		Name = "",
		Level = GameConfig.StartingIslandLevel,
		XP = 0,
		Theme = IslandConfig.DefaultTheme,
		Permission = "Private", -- Private | Friends | Public (Phase 12)
		UnlockedAreas = { Starter = true },
		Buildings = {}, -- Phase 3: { BuildingId, UniqueId, Position = {X,Y,Z}, Rotation, Variant }
		Decorations = {},
		Crops = {}, -- Phase 4: { CropId, Position, PlantedAt, GrowthStage, Watered }
		Animals = {}, -- Phase 6: { AnimalId, UniqueId, Position, Happiness, Hunger, ProduceReadyAt }
		Storage = {},
		Production = {}, -- Phase 8: production queues
		Likes = 0,
		Visits = 0,
	},

	Quests = { Active = {}, Completed = {}, DailyResetAt = 0 },
	Achievements = {},
	Collection = { Fish = {}, Crops = {}, Animals = {}, Items = {} },
	Recipes = {},
	Cosmetics = { Owned = {}, Equipped = {} },

	Stats = {
		PlayTime = 0,
		WoodCollected = 0,
		StoneCollected = 0,
		CropsHarvested = 0,
		FishCaught = 0,
		AnimalsOwned = 0,
		MilkCollected = 0,
		ItemsSold = 0,
		CoinsEarned = 0,
		BuildingsBuilt = 0,
		AreasUnlocked = 0,
		QuestsCompleted = 0,
		RareItemsFound = 0,
	},

	Settings = { CameraShake = true, MusicVolume = 0.5, SfxVolume = 0.8 },

	Flags = {
		StarterChestClaimed = false,
		FirstEquip = false,
		TutorialStep = 0,
	},

	Meta = { CreatedAt = 0, LastSavedAt = 0, LastJoinAt = 0, JoinCount = 0 },

	-- Data we could not validate, kept instead of deleted.
	Quarantine = { Items = {}, Tools = {}, Areas = {}, Values = {} },
}

function DataSchema.Template()
	return TableUtil.DeepCopy(TEMPLATE)
end

-- version -> function(data) upgrading FROM that version to version + 1
local MIGRATIONS: { [number]: (any) -> () } = {
	-- [1] = function(data) data.NewField = ... end,
}

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function cleanInteger(value: any, min: number, max: number, fallback: number): number
	if not isFiniteNumber(value) then
		return fallback
	end
	return math.clamp(math.floor(value), min, max)
end

-- Recursively resets values whose type does not match the template.
local function repairTypes(data: { [any]: any }, template: { [any]: any }, quarantine: { [any]: any }, path: string)
	for key, templateValue in template do
		local value = data[key]
		if value ~= nil and type(value) ~= type(templateValue) then
			quarantine[path .. tostring(key)] = value
			data[key] = TableUtil.DeepCopy(templateValue)
		elseif type(templateValue) == "table" and type(value) == "table" and next(templateValue) ~= nil then
			-- Only recurse into "shaped" tables (non-empty template tables).
			repairTypes(value, templateValue, quarantine, path .. tostring(key) .. ".")
		end
	end
end

function DataSchema.Migrate(data: any): any
	local version = if isFiniteNumber(data.Version) then data.Version else 1
	while version < DataSchema.CurrentVersion do
		local migrate = MIGRATIONS[version]
		if migrate then
			migrate(data)
		end
		version += 1
	end
	data.Version = DataSchema.CurrentVersion
	return data
end

-- Returns a repaired profile table. Never returns nil for a table input.
function DataSchema.Sanitize(raw: any): any
	local data = if type(raw) == "table" then raw else DataSchema.Template()
	DataSchema.Migrate(data)
	if type(data.Quarantine) ~= "table" then
		data.Quarantine = TableUtil.DeepCopy(TEMPLATE.Quarantine)
	end
	if type(data.Quarantine.Values) ~= "table" then
		data.Quarantine.Values = {}
	end
	TableUtil.Reconcile(data, TEMPLATE)
	repairTypes(data, TEMPLATE, data.Quarantine.Values, "")

	-- Currencies / levels
	data.Coins = cleanInteger(data.Coins, 0, EconomyConfig.Currencies.Coins.Max, TEMPLATE.Coins)
	data.Gems = cleanInteger(data.Gems, 0, EconomyConfig.Currencies.Gems.Max, TEMPLATE.Gems)
	data.Level = cleanInteger(data.Level, 1, ProgressionConfig.Player.MaxLevel, 1)
	data.XP = cleanInteger(data.XP, 0, math.huge, 0)
	data.Island.Level = cleanInteger(data.Island.Level, 1, ProgressionConfig.Island.MaxLevel, 1)
	data.Island.XP = cleanInteger(data.Island.XP, 0, math.huge, 0)
	data.Inventory.Capacity = cleanInteger(data.Inventory.Capacity, GameConfig.Inventory.StartingCapacity, 1_000_000, GameConfig.Inventory.StartingCapacity)

	-- Restore quarantined ids that are valid again (e.g. an item re-added in an update).
	local quarantine = data.Quarantine
	for itemId, count in quarantine.Items do
		if ItemConfig.Exists(itemId) then
			data.Inventory.Items[itemId] = (data.Inventory.Items[itemId] or 0) + count
			quarantine.Items[itemId] = nil
		end
	end
	for toolId in quarantine.Tools do
		if ToolConfig.Get(toolId) then
			data.Tools.Owned[toolId] = true
			quarantine.Tools[toolId] = nil
		end
	end
	for areaId in quarantine.Areas do
		if IslandConfig.Areas[areaId] then
			data.Island.UnlockedAreas[areaId] = true
			quarantine.Areas[areaId] = nil
		end
	end

	-- Inventory items
	for itemId, count in data.Inventory.Items do
		if not isFiniteNumber(count) or count <= 0 then
			data.Inventory.Items[itemId] = nil
		elseif not ItemConfig.Exists(itemId) then
			quarantine.Items[tostring(itemId)] = math.floor(count)
			data.Inventory.Items[itemId] = nil
		else
			data.Inventory.Items[itemId] = math.min(math.floor(count), GameConfig.Inventory.MaxStack)
		end
	end
	for itemId in data.Inventory.Favorites do
		if not ItemConfig.Exists(itemId) then
			data.Inventory.Favorites[itemId] = nil
		end
	end

	-- Tools
	for toolId, owned in data.Tools.Owned do
		if owned ~= true then
			data.Tools.Owned[toolId] = nil
		elseif not ToolConfig.Get(toolId) then
			quarantine.Tools[tostring(toolId)] = true
			data.Tools.Owned[toolId] = nil
		end
	end
	local hotbar = {}
	local seen = {}
	for _, toolId in data.Tools.Hotbar do
		if #hotbar >= ToolConfig.HotbarSize then
			break
		end
		if type(toolId) == "string" and data.Tools.Owned[toolId] and not seen[toolId] then
			seen[toolId] = true
			table.insert(hotbar, toolId)
		end
	end
	data.Tools.Hotbar = hotbar
	if data.Tools.Equipped ~= "" and not data.Tools.Owned[data.Tools.Equipped] then
		data.Tools.Equipped = ""
	end

	-- Island areas
	for areaId, unlocked in data.Island.UnlockedAreas do
		if unlocked ~= true then
			data.Island.UnlockedAreas[areaId] = nil
		elseif not IslandConfig.Areas[areaId] then
			quarantine.Areas[tostring(areaId)] = true
			data.Island.UnlockedAreas[areaId] = nil
		end
	end
	data.Island.UnlockedAreas.Starter = true
	if type(data.Island.Name) ~= "string" or #data.Island.Name > IslandConfig.NameMaxLength * 4 then
		data.Island.Name = ""
	end

	return data
end

-- Final guard before anything is written to the DataStore.
function DataSchema.IsSaveable(data: any): (boolean, string?)
	if type(data) ~= "table" then
		return false, "profile is not a table"
	end
	if data.Version ~= DataSchema.CurrentVersion then
		return false, "unexpected version"
	end
	if not isFiniteNumber(data.Coins) or data.Coins < 0 then
		return false, "invalid Coins"
	end
	if type(data.Inventory) ~= "table" or type(data.Inventory.Items) ~= "table" then
		return false, "invalid Inventory"
	end
	if type(data.Island) ~= "table" or type(data.Island.UnlockedAreas) ~= "table" then
		return false, "invalid Island"
	end
	return true, nil
end

return DataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">MockDataStore</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  MockDataStore
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Data/MockDataStore
	DEPENDENCIES: Shared.Util.TableUtil

	In-memory stand-in for a GlobalDataStore, used in Studio when "Enable
	Studio Access to API Services" is off. Same UpdateAsync/GetAsync contract,
	so DataService runs the exact same code path. Data lives only for the
	current play session.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TableUtil = require(ReplicatedStorage.Shared.Util.TableUtil)

local MockDataStore = {}
MockDataStore.__index = MockDataStore

function MockDataStore.new()
	return setmetatable({ _data = {} :: { [string]: any } }, MockDataStore)
end

function MockDataStore:GetAsync(key: string): any
	task.wait() -- simulate yielding like the real API
	return TableUtil.DeepCopy(self._data[key])
end

function MockDataStore:UpdateAsync(key: string, transform: (any, any) -> any): any
	task.wait()
	local result = transform(TableUtil.DeepCopy(self._data[key]), nil)
	if result == nil then
		return nil -- cancelled, mirrors the real API
	end
	self._data[key] = TableUtil.DeepCopy(result)
	return TableUtil.DeepCopy(result)
end

function MockDataStore:RemoveAsync(key: string): any
	local old = self._data[key]
	self._data[key] = nil
	return old
end

return MockDataStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="38">
        <Properties>
          <string name="Name">Island</string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">IslandBuilder</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandBuilder
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandBuilder
	DEPENDENCIES: Shared.Config.IslandConfig, Shared.Util.IslandLayout, Server.Island.IslandProps

	Builds and tears down the physical island for one slot:
	  * smooth-terrain land lobes (starter + each UNLOCKED area),
	  * underwater sandbars previewing LOCKED areas,
	  * the island Model and its standard folder layout,
	  * starter props (spawn pad, sign, chest, dock, plots, palms, flowers).

	All positions come from IslandConfig in island-local space and are
	converted with the slot origin, so the same island builds identically in
	any slot on any server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandLayout = require(Shared.Util.IslandLayout)
local IslandProps = require(script.Parent.IslandProps)

local IslandBuilder = {}

-- Folders every island model contains (later phases fill them).
IslandBuilder.FolderNames = {
	"Terrain",
	"Props",
	"Interactables",
	"AreaMarkers",
	"Buildings",
	"Decorations",
	"Resources",
	"Crops",
	"Animals",
	"Production",
	"FishingSpots",
}

local BIOME_SURFACE: { [string]: Enum.Material } = {
	Meadow = Enum.Material.Grass,
	Forest = Enum.Material.LeafyGrass,
	River = Enum.Material.Grass,
	Beach = Enum.Material.Sand,
	Mountain = Enum.Material.Rock,
	Cave = Enum.Material.Ground,
}

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.IgnoreWater = true

local function toWorld(origin: CFrame, localXZ: Vector2, y: number?): Vector3
	return (origin * CFrame.new(localXZ.X, y or 0, localXZ.Y)).Position
end

local function fillColumn(terrain: Terrain, center: Vector3, radius: number, bottom: number, top: number, material: Enum.Material)
	local height = top - bottom
	if height <= 0 or radius <= 0 then
		return
	end
	terrain:FillCylinder(CFrame.new(center.X, (top + bottom) / 2, center.Z), height, radius, material)
end

-- Raises one land lobe. `scale` (0..1] lets unlock animations grow the land.
function IslandBuilder.FillAreaLand(origin: CFrame, areaId: string, scale: number?)
	local area = IslandConfig.Areas[areaId]
	local terrain = workspace.Terrain :: Terrain
	local center = toWorld(origin, IslandLayout.GetAreaCenter(areaId))
	local sea = origin.Position.Y
	local bottom = sea - IslandConfig.LandDepth
	local s = scale or 1
	local radius = area.Radius * s
	local surface = BIOME_SURFACE[area.Biome] or Enum.Material.Grass

	fillColumn(terrain, center, radius + IslandConfig.ShallowsWidth * s, bottom, sea + IslandConfig.ShallowsHeight, Enum.Material.Sand)
	fillColumn(terrain, center, radius + IslandConfig.BeachWidth * s, bottom, sea + IslandConfig.BeachHeight, Enum.Material.Sand)
	fillColumn(terrain, center, radius, bottom, sea + IslandConfig.SurfaceHeight, surface)
end

function IslandBuilder.FillAreaSandbar(origin: CFrame, areaId: string)
	local area = IslandConfig.Areas[areaId]
	local center = toWorld(origin, IslandLayout.GetAreaCenter(areaId))
	local sea = origin.Position.Y
	fillColumn(workspace.Terrain :: Terrain, center, area.Radius, sea - IslandConfig.LandDepth, sea - IslandConfig.SandbarDepth, Enum.Material.Sand)
end

local function fillHills(origin: CFrame)
	for _, hill in IslandConfig.StarterLayout.Hills do
		-- Sink the ball so only a gentle `Height`-stud dome shows above the surface.
		local center = toWorld(origin, hill.Center, IslandConfig.SurfaceHeight + hill.Height - hill.Radius)
		local terrain = workspace.Terrain :: Terrain
		terrain:FillBall(center, hill.Radius, Enum.Material.Grass)
	end
end

-- Terrain height at an island-local XZ point (falls back to surface height).
function IslandBuilder.GroundCFrame(origin: CFrame, localXZ: Vector2, yawDegrees: number?): CFrame
	terrainParams.FilterDescendantsInstances = { workspace.Terrain }
	local top = toWorld(origin, localXZ, 80)
	local result = workspace:Raycast(top, Vector3.new(0, -160, 0), terrainParams)
	local y = if result then result.Position.Y else origin.Position.Y + IslandConfig.SurfaceHeight
	return CFrame.new(top.X, y, top.Z) * CFrame.Angles(0, math.rad(yawDegrees or 0), 0)
end

-- Yaw (degrees) that makes a prop's -Z face from `from` towards `to` (island-local).
local function facing(from: Vector2, to: Vector2): number
	local direction = to - from
	return math.deg(math.atan2(-direction.X, -direction.Y))
end

local function customProp(name: string): Model?
	local islands = ServerStorage:FindFirstChild("Islands")
	local props = islands and islands:FindFirstChild("Props")
	local template = props and props:FindFirstChild(name)
	if template and template:IsA("Model") then
		return template:Clone()
	end
	return nil
end

local function place(model: Model, parent: Instance, cframe: CFrame): Model
	model:PivotTo(cframe)
	model.Parent = parent
	return model
end

export type BuiltIsland = {
	Model: Model,
	Folders: { [string]: Folder },
	Sign: Model,
	Chest: Model,
	SpawnCFrame: CFrame,
}

function IslandBuilder.CreateModel(name: string, parent: Instance): (Model, { [string]: Folder })
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Default
	local folders = {}
	for _, folderName in IslandBuilder.FolderNames do
		local folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = model
		folders[folderName] = folder
	end
	model.Parent = parent
	return model, folders
end

-- Builds terrain + starter props. `unlocked` = profile Island.UnlockedAreas.
function IslandBuilder.Build(origin: CFrame, model: Model, folders: { [string]: Folder }, unlocked: { [string]: boolean }): BuiltIsland
	-- Terrain: locked sandbars first, then land (starter first so lobes merge onto it).
	for _, areaId in IslandConfig.AreaOrder do
		if not unlocked[areaId] then
			IslandBuilder.FillAreaSandbar(origin, areaId)
		end
	end
	for _, areaId in IslandConfig.AreaOrder do
		if unlocked[areaId] then
			IslandBuilder.FillAreaLand(origin, areaId)
		end
	end
	fillHills(origin)

	local layout = IslandConfig.StarterLayout
	local props = folders.Props
	local interactables = folders.Interactables

	-- Spawn
	local spawnYaw = facing(layout.Spawn, layout.Spawn + layout.SpawnFacing)
	local spawnGround = IslandBuilder.GroundCFrame(origin, layout.Spawn, spawnYaw)
	place(customProp("SpawnPad") or IslandProps.SpawnPad(), props, spawnGround)
	local spawnCFrame = spawnGround + Vector3.new(0, 4, 0)

	-- Island sign faces the spawn point.
	local sign = customProp("IslandSign") or IslandProps.Sign("My Island", "Island Level 1")
	place(sign, interactables, IslandBuilder.GroundCFrame(origin, layout.IslandSign, facing(layout.IslandSign, layout.Spawn)))

	-- Starter chest faces the spawn point.
	local chest = customProp("StarterChest") or IslandProps.StarterChest()
	place(chest, interactables, IslandBuilder.GroundCFrame(origin, layout.StarterChest, facing(layout.StarterChest, layout.Spawn)))

	-- Dock runs out to sea along +Z (local).
	local dockStart = layout.Dock.Start
	local dockCFrame = toWorld(origin, dockStart, 2.2)
	place(customProp("Dock") or IslandProps.Dock(layout.Dock.Length, layout.Dock.Width), props, CFrame.new(dockCFrame) * CFrame.Angles(0, math.pi, 0))

	-- Plots (Phase 3 building + Phase 4 farming use these zones).
	local housePlot = place(customProp("HousePlot") or IslandProps.Plot("HousePlot", layout.HousePlot.Size), props, IslandBuilder.GroundCFrame(origin, layout.HousePlot.Center))
	housePlot:SetAttribute("Zone", "House")
	local farmPlot = place(customProp("FarmPlot") or IslandProps.Plot("FarmPlot", layout.FarmPlot.Size), props, IslandBuilder.GroundCFrame(origin, layout.FarmPlot.Center))
	farmPlot:SetAttribute("Zone", "Farm")

	-- Decoration (non-harvestable; gatherable trees arrive in Phase 2).
	for index, position in layout.Palms do
		place(IslandProps.Palm(14 + (index % 3) * 2, index), folders.Decorations, IslandBuilder.GroundCFrame(origin, position, index * 47))
	end
	for index, position in layout.FlowerPatches do
		place(IslandProps.Flowers(index * 13), folders.Decorations, IslandBuilder.GroundCFrame(origin, position))
	end

	return {
		Model = model,
		Folders = folders,
		Sign = sign,
		Chest = chest,
		SpawnCFrame = spawnCFrame,
	}
end

-- Places the 🔒 marker for a locked area. Returns the marker model.
function IslandBuilder.CreateAreaMarker(origin: CFrame, parent: Instance, areaId: string, requirementText: string): Model
	local area = IslandConfig.Areas[areaId]
	local position = IslandLayout.GetAreaMarkerPosition(areaId)
	-- The rope + stake side faces out towards the locked land; the post faces home.
	local marker = IslandProps.LockMarker(area.DisplayName, requirementText)
	marker:SetAttribute("AreaId", areaId)
	return place(marker, parent, IslandBuilder.GroundCFrame(origin, position, facing(position, Vector2.zero)))
end

-- Clears all island terrain back to open ocean. Used when a player leaves.
function IslandBuilder.ClearTerrain(origin: CFrame, restoreOcean: (center: Vector3, radius: number) -> ())
	for _, areaId in IslandConfig.AreaOrder do
		local area = IslandConfig.Areas[areaId]
		local center = toWorld(origin, IslandLayout.GetAreaCenter(areaId))
		restoreOcean(center, area.Radius + IslandConfig.ShallowsWidth + 4)
	end
end

return IslandBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">IslandProps</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandProps
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandProps
	DEPENDENCIES: none

	Procedural low-poly props for the starter island (sign, chest, dock,
	palms, flowers, plots, locked-area markers). Every function builds the
	prop around the origin (base at Y = 0) and returns an unparented Model
	with WorldPivot at its base, ready for :PivotTo().

	To replace a prop with real art later, put a Model with the same name in
	ServerStorage/Islands/Props (e.g. "StarterChest"); IslandBuilder prefers
	art when it exists. Art must keep any "PromptAnchor" attachment and, for
	the chest, a "Lid" part.
]]

local IslandProps = {}

local COLORS = {
	Wood = Color3.fromRGB(165, 115, 70),
	WoodDark = Color3.fromRGB(120, 82, 50),
	SignBoard = Color3.fromRGB(215, 172, 115),
	ChestBody = Color3.fromRGB(150, 95, 52),
	Gold = Color3.fromRGB(255, 200, 60),
	Trunk = Color3.fromRGB(155, 115, 72),
	Leaves = Color3.fromRGB(70, 175, 75),
	LeavesDark = Color3.fromRGB(50, 145, 60),
	Stone = Color3.fromRGB(205, 200, 188),
	Soil = Color3.fromRGB(112, 76, 46),
	SoilDark = Color3.fromRGB(88, 58, 34),
	Text = Color3.fromRGB(70, 45, 25),
}

local FLOWER_COLORS = {
	Color3.fromRGB(255, 105, 130),
	Color3.fromRGB(255, 212, 80),
	Color3.fromRGB(185, 125, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 70),
}

type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	CanCollide: boolean?,
	Transparency: number?,
}

local function part(parent: Instance, props: PartProps): Part
	local newPart = Instance.new("Part")
	newPart.Name = props.Name or "Part"
	newPart.Anchored = true
	newPart.Shape = props.Shape or Enum.PartType.Block
	newPart.Size = props.Size
	newPart.CFrame = props.CFrame
	newPart.Color = props.Color
	newPart.Material = props.Material or Enum.Material.SmoothPlastic
	newPart.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	newPart.Transparency = props.Transparency or 0
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	newPart.Parent = parent
	return newPart
end

local function newModel(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	return model
end

local function finish(model: Model): Model
	model.WorldPivot = CFrame.new()
	return model
end

local function anchor(parent: BasePart, offset: Vector3)
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptAnchor"
	attachment.Position = offset
	attachment.Parent = parent
end

-- A sign whose readable face (Front / -Z) looks down -Z.
function IslandProps.Sign(title: string, subtitle: string): Model
	local model = newModel("IslandSign")
	part(model, { Name = "PostL", Size = Vector3.new(0.5, 5, 0.5), CFrame = CFrame.new(-2.6, 2.5, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	part(model, { Name = "PostR", Size = Vector3.new(0.5, 5, 0.5), CFrame = CFrame.new(2.6, 2.5, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	local board = part(model, { Name = "Board", Size = Vector3.new(6.4, 2.8, 0.35), CFrame = CFrame.new(0, 3.9, -0.1), Color = COLORS.SignBoard, Material = Enum.Material.Wood })
	part(model, { Name = "Roof", Size = Vector3.new(7, 0.3, 0.9), CFrame = CFrame.new(0, 5.45, -0.1), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	anchor(board, Vector3.new(0, -1, -0.5))

	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	gui.Parent = board

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.fromScale(0.92, 0.55)
	titleLabel.Position = UDim2.fromScale(0.04, 0.05)
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = COLORS.Text
	titleLabel.Text = title
	titleLabel.Parent = gui

	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Size = UDim2.fromScale(0.92, 0.32)
	subtitleLabel.Position = UDim2.fromScale(0.04, 0.62)
	subtitleLabel.Font = Enum.Font.FredokaOne
	subtitleLabel.TextScaled = true
	subtitleLabel.TextColor3 = COLORS.WoodDark
	subtitleLabel.Text = subtitle
	subtitleLabel.Parent = gui

	return finish(model)
end

function IslandProps.SetSignText(sign: Model, title: string, subtitle: string)
	local board = sign:FindFirstChild("Board")
	local gui = board and board:FindFirstChild("SignGui")
	if not gui then
		return
	end
	local titleLabel = gui:FindFirstChild("Title")
	local subtitleLabel = gui:FindFirstChild("Subtitle")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
	end
	if subtitleLabel and subtitleLabel:IsA("TextLabel") then
		subtitleLabel.Text = subtitle
	end
end

function IslandProps.StarterChest(): Model
	local model = newModel("StarterChest")
	local body = part(model, { Name = "Body", Size = Vector3.new(3.2, 1.8, 2.2), CFrame = CFrame.new(0, 0.9, 0), Color = COLORS.ChestBody, Material = Enum.Material.Wood })
	part(model, { Name = "BandL", Size = Vector3.new(0.3, 1.85, 2.25), CFrame = CFrame.new(-1.1, 0.9, 0), Color = COLORS.Gold, Material = Enum.Material.Metal })
	part(model, { Name = "BandR", Size = Vector3.new(0.3, 1.85, 2.25), CFrame = CFrame.new(1.1, 0.9, 0), Color = COLORS.Gold, Material = Enum.Material.Metal })
	local lid = part(model, { Name = "Lid", Size = Vector3.new(3.3, 0.7, 2.3), CFrame = CFrame.new(0, 2.15, 0), Color = COLORS.ChestBody, Material = Enum.Material.Wood })
	part(model, { Name = "Lock", Size = Vector3.new(0.5, 0.6, 0.2), CFrame = CFrame.new(0, 1.7, -1.15), Color = COLORS.Gold, Material = Enum.Material.Metal, CanCollide = false })
	anchor(body, Vector3.new(0, 0.8, 0))
	model.PrimaryPart = body
	-- Remember the closed lid pose relative to the body for OpenChest().
	lid:SetAttribute("ClosedOffset", body.CFrame:ToObjectSpace(lid.CFrame))
	return finish(model)
end

-- Rotates the lid open around its back edge.
function IslandProps.OpenChest(chest: Model)
	local body = chest:FindFirstChild("Body")
	local lid = chest:FindFirstChild("Lid")
	if not body or not lid or not body:IsA("BasePart") or not lid:IsA("BasePart") then
		return
	end
	local closed = lid:GetAttribute("ClosedOffset")
	if typeof(closed) ~= "CFrame" then
		return
	end
	local hinge = body.CFrame * closed * CFrame.new(0, -lid.Size.Y / 2, lid.Size.Z / 2)
	lid.CFrame = hinge * CFrame.Angles(math.rad(100), 0, 0) * CFrame.new(0, lid.Size.Y / 2, -lid.Size.Z / 2)
	local lock = chest:FindFirstChild("Lock")
	if lock and lock:IsA("BasePart") then
		lock.Transparency = 1
	end
end

-- Dock extends along -Z from its origin (rotate with PivotTo).
function IslandProps.Dock(length: number, width: number): Model
	local model = newModel("Dock")
	local plankDepth = 1.2
	local count = math.floor(length / (plankDepth + 0.15))
	for i = 0, count - 1 do
		local z = -(i * (plankDepth + 0.15) + plankDepth / 2)
		local shade = if i % 2 == 0 then COLORS.Wood else COLORS.Wood:Lerp(COLORS.WoodDark, 0.25)
		part(model, { Name = "Plank", Size = Vector3.new(width, 0.35, plankDepth), CFrame = CFrame.new(0, 0, z), Color = shade, Material = Enum.Material.WoodPlanks })
	end
	for z = 2, length, 6 do
		for _, x in { -width / 2 + 0.3, width / 2 - 0.3 } do
			part(model, { Name = "Post", Size = Vector3.new(0.6, 9, 0.6), CFrame = CFrame.new(x, -4, -z), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
		end
	end
	return finish(model)
end

function IslandProps.Palm(height: number, seed: number): Model
	local random = Random.new(seed)
	local model = newModel("PalmTree")
	local segments = 5
	local segmentHeight = height / segments
	local lean = random:NextNumber(-0.18, 0.18)
	local position = Vector3.zero
	for i = 1, segments do
		local offset = Vector3.new(lean * i * 0.6, segmentHeight, lean * i * 0.3)
		local center = position + offset / 2
		local thickness = 1.3 - i * 0.12
		part(model, {
			Name = "Trunk",
			Size = Vector3.new(thickness, segmentHeight + 0.2, thickness),
			CFrame = CFrame.lookAt(center, center + offset) * CFrame.Angles(-math.pi / 2, 0, 0),
			Color = if i % 2 == 0 then COLORS.Trunk else COLORS.Trunk:Lerp(COLORS.WoodDark, 0.3),
			Material = Enum.Material.Wood,
		})
		position += offset
	end
	local top = position
	for i = 1, 7 do
		local angle = (i / 7) * math.pi * 2 + random:NextNumber(-0.2, 0.2)
		local leaf = CFrame.new(top) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -2.6) * CFrame.Angles(math.rad(-22), 0, 0)
		part(model, {
			Name = "Leaf",
			Size = Vector3.new(1.4, 0.2, 5.4),
			CFrame = leaf,
			Color = if i % 2 == 0 then COLORS.Leaves else COLORS.LeavesDark,
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	for i = 1, 3 do
		local angle = i * 2.1
		part(model, {
			Name = "Coconut",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = CFrame.new(top + Vector3.new(math.cos(angle) * 0.6, -0.5, math.sin(angle) * 0.6)),
			Color = Color3.fromRGB(110, 80, 45),
			CanCollide = false,
		})
	end
	return finish(model)
end

function IslandProps.Flowers(seed: number): Model
	local random = Random.new(seed)
	local model = newModel("Flowers")
	for _ = 1, 9 do
		local x, z = random:NextNumber(-3, 3), random:NextNumber(-3, 3)
		local stemHeight = random:NextNumber(0.6, 1.2)
		part(model, { Name = "Stem", Size = Vector3.new(0.12, stemHeight, 0.12), CFrame = CFrame.new(x, stemHeight / 2, z), Color = COLORS.LeavesDark, CanCollide = false })
		part(model, {
			Name = "Bloom",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.55, 0.55, 0.55),
			CFrame = CFrame.new(x, stemHeight, z),
			Color = FLOWER_COLORS[random:NextInteger(1, #FLOWER_COLORS)],
			CanCollide = false,
		})
	end
	return finish(model)
end

-- kind: "HousePlot" | "FarmPlot". Size in studs (X, Z).
function IslandProps.Plot(kind: string, size: Vector2): Model
	local model = newModel(kind)
	local border = 0.6
	local height = 0.35
	local color = if kind == "FarmPlot" then COLORS.WoodDark else COLORS.Stone
	local material = if kind == "FarmPlot" then Enum.Material.Wood else Enum.Material.Cobblestone
	part(model, { Name = "EdgeN", Size = Vector3.new(size.X, height, border), CFrame = CFrame.new(0, height / 2, -size.Y / 2), Color = color, Material = material })
	part(model, { Name = "EdgeS", Size = Vector3.new(size.X, height, border), CFrame = CFrame.new(0, height / 2, size.Y / 2), Color = color, Material = material })
	part(model, { Name = "EdgeW", Size = Vector3.new(border, height, size.Y), CFrame = CFrame.new(-size.X / 2, height / 2, 0), Color = color, Material = material })
	part(model, { Name = "EdgeE", Size = Vector3.new(border, height, size.Y), CFrame = CFrame.new(size.X / 2, height / 2, 0), Color = color, Material = material })

	if kind == "FarmPlot" then
		local rows = math.floor((size.Y - 2) / 2.5)
		for i = 0, rows - 1 do
			local z = -size.Y / 2 + 1.8 + i * 2.5
			part(model, { Name = "SoilRow", Size = Vector3.new(size.X - 2, 0.3, 1.6), CFrame = CFrame.new(0, 0.12, z), Color = if i % 2 == 0 then COLORS.Soil else COLORS.SoilDark, Material = Enum.Material.Ground, CanCollide = false })
		end
	else
		part(model, { Name = "Pad", Size = Vector3.new(size.X - border, 0.12, size.Y - border), CFrame = CFrame.new(0, 0.06, 0), Color = Color3.fromRGB(226, 214, 180), Material = Enum.Material.Sand, CanCollide = false, Transparency = 0.35 })
	end
	return finish(model)
end

-- Marker on the starter shore for a locked expansion area. Faces -Z.
function IslandProps.LockMarker(areaName: string, requirementText: string): Model
	local model = newModel("AreaLock")
	local post = part(model, { Name = "Post", Size = Vector3.new(0.6, 6, 0.6), CFrame = CFrame.new(0, 3, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	part(model, { Name = "Banner", Size = Vector3.new(3.2, 2, 0.15), CFrame = CFrame.new(1.8, 4.8, 0), Color = Color3.fromRGB(90, 190, 255), Material = Enum.Material.Fabric, CanCollide = false })
	part(model, { Name = "RopeL", Size = Vector3.new(0.2, 0.2, 6), CFrame = CFrame.new(-2.5, 1.2, 0) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(220, 190, 130), CanCollide = false })
	part(model, { Name = "Stake", Size = Vector3.new(0.4, 2, 0.4), CFrame = CFrame.new(-5.5, 1, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	anchor(post, Vector3.new(0, -1.5, 0))
	model.PrimaryPart = post

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "LockBillboard"
	billboard.Size = UDim2.fromScale(9, 3.2)
	billboard.StudsOffset = Vector3.new(0, 4.5, 0)
	billboard.MaxDistance = 160
	billboard.LightInfluence = 0
	billboard.Parent = post

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 250, 238)
	frame.BackgroundTransparency = 0.05
	frame.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.2, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(70, 50, 30)
	stroke.Parent = frame

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "AreaName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(0.94, 0.55)
	nameLabel.Position = UDim2.fromScale(0.03, 0.04)
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.fromRGB(60, 40, 25)
	nameLabel.Text = "🔒 " .. areaName
	nameLabel.Parent = frame

	local requirementLabel = Instance.new("TextLabel")
	requirementLabel.Name = "Requirement"
	requirementLabel.BackgroundTransparency = 1
	requirementLabel.Size = UDim2.fromScale(0.94, 0.36)
	requirementLabel.Position = UDim2.fromScale(0.03, 0.58)
	requirementLabel.Font = Enum.Font.FredokaOne
	requirementLabel.TextScaled = true
	requirementLabel.TextColor3 = Color3.fromRGB(150, 100, 40)
	requirementLabel.Text = requirementText
	requirementLabel.Parent = frame

	return finish(model)
end

function IslandProps.SpawnPad(): Model
	local model = newModel("SpawnPad")
	part(model, {
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 9, 9),
		CFrame = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COLORS.Stone,
		Material = Enum.Material.Slate,
	})
	part(model, {
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.42, 6, 6),
		CFrame = CFrame.new(0, 0.22, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 210, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
	return finish(model)
end

return IslandProps
]]></string>
          </Properties>
        </Item>
