			Description = "Chops trees for wood.",
		},
		Pickaxe = {
			DisplayName = "Pickaxe",
			Icon = "⛏️",
			Shape = "Pickaxe",
			Tiers = { "Wooden", "Stone", "Iron", "Gold", "Crystal", "Mythic" },
			UseCooldown = 0.75,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
