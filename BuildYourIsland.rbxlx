          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AdminService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AdminService
	DEPENDENCIES: DataService, EconomyService, InventoryService, ProgressionService,
	              IslandService, ToolService, Shared.Config.GameConfig, Server.Util.Notify

	Secure chat commands (spec §139). Authorised = UserId in
	GameConfig.AdminUserIds, or anyone in Studio when AdminsInStudio = true.
	Commands are parsed on the SERVER — from server-created TextChatCommands
	(TextChatService) or Player.Chatted (legacy chat) — so nothing a client
	sends can run them. Every command goes through the normal services, so
	admin changes are validated, saved and replicated like any other change.

	  /givecoins <player|me> <amount>
	  /givegems <player|me> <amount>
	  /giveitem <player|me> <itemId> <amount>
	  /givetool <player|me> <toolId>
	  /givexp <player|me> <amount>
	  /giveislandxp <player|me> <amount>
	  /setislandlevel <player|me> <level>
	  /unlockarea <player|me> <areaId>     (charges nothing; bypasses requirements)
	  /growcrops <player|me>              finish every planted crop
	  /finishbuilds <player|me>           complete every construction site
	  /spawnanimal <player|me> <Cow|Chicken>  (needs free housing, no charge)
	  /readyanimals <player|me>           make every animal's product ready
	  /save <player|me>
	  /resetdata <player|me>               (Studio only)
	  /debug [player|me]
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local IslandConfig = require(Shared.Config.IslandConfig)

local Services = script.Parent
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local IslandService = require(Services.IslandService)
local ToolService = require(Services.ToolService)
local FarmService = require(Services.FarmService)
local BuildService = require(Services.BuildService)
local AnimalService = require(Services.AnimalService)
local Notify = require(script.Parent.Parent.Util.Notify)

local AdminService = {}

type Command = (admin: Player, args: { string }) -> string

local function isAdmin(player: Player): boolean
	if GameConfig.AdminsInStudio and RunService:IsStudio() then
		return true
	end
	return table.find(GameConfig.AdminUserIds, player.UserId) ~= nil
end

local function findPlayer(admin: Player, query: string?): Player?
	if not query or query == "" or string.lower(query) == "me" then
		return admin
	end
	local lowered = string.lower(query)
	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == lowered or string.lower(player.DisplayName) == lowered then
			return player
		end
	end
	for _, player in Players:GetPlayers() do
		if string.sub(string.lower(player.Name), 1, #lowered) == lowered then
			return player
		end
	end
	return nil
end

local function toInteger(text: string?): number?
	local value = tonumber(text)
	if value and value == value and math.abs(value) < 1e12 then
		return math.floor(value)
	end
	return nil
end

local COMMANDS: { [string]: Command } = {
	givecoins = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /givecoins <player|me> <amount>"
		end
		return if EconomyService.AddCoins(target, amount, "Admin:" .. admin.Name) then "Gave coins" else "Failed"
	end,
	givegems = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /givegems <player|me> <amount>"
		end
		return if EconomyService.AddGems(target, amount, "Admin:" .. admin.Name) then "Gave gems" else "Failed"
	end,
	giveitem = function(admin, args)
		local target, itemId, amount = findPlayer(admin, args[1]), args[2], toInteger(args[3] or "1")
		if not target or not itemId or not amount then
			return "Usage: /giveitem <player|me> <itemId> <amount>"
		end
		local added = InventoryService.AddItem(target, itemId, amount, "Admin:" .. admin.Name, { IgnoreCapacity = true })
		return ("Added %d %s"):format(added, itemId)
	end,
	givetool = function(admin, args)
		local target, toolId = findPlayer(admin, args[1]), args[2]
		if not target or not toolId then
			return "Usage: /givetool <player|me> <toolId>"
		end
		return if ToolService.GrantTool(target, toolId, "Admin:" .. admin.Name) then "Granted " .. toolId else "Unknown or already owned"
	end,
	givexp = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /givexp <player|me> <amount>"
		end
		ProgressionService.AddPlayerXP(target, amount, "Admin")
		return "Gave XP"
	end,
	giveislandxp = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /giveislandxp <player|me> <amount>"
		end
		ProgressionService.AddIslandXP(target, amount, "Admin")
		return "Gave island XP"
	end,
	setislandlevel = function(admin, args)
		local target, level = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not level then
			return "Usage: /setislandlevel <player|me> <level>"
		end
		ProgressionService.SetIslandLevel(target, level)
		return "Island level set"
	end,
	unlockarea = function(admin, args)
		local target, areaId = findPlayer(admin, args[1]), args[2]
		if not target or not areaId or not IslandConfig.Areas[areaId] then
			return "Usage: /unlockarea <player|me> <areaId>"
		end
		local unlock = IslandConfig.Areas[areaId].Unlock
		-- Grant exactly what the unlock needs, then go through the real unlock path.
		if unlock then
			ProgressionService.SetIslandLevel(target, math.max(DataService.Get(target, { "Island", "Level" }) or 1, unlock.IslandLevel or 1))
			if unlock.RequiresArea then
				DataService.Set(target, { "Island", "UnlockedAreas", unlock.RequiresArea }, true)
			end
			if (unlock.Coins or 0) > 0 then
				EconomyService.AddCoins(target, unlock.Coins, "Admin:unlockarea")
			end
		end
		local ok, message = IslandService.TryUnlockArea(target, areaId)
		return if ok then "Unlocked " .. areaId else tostring(message)
	end,
	growcrops = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /growcrops <player|me>"
		end
		FarmService.GrowAll(target)
		return "Crops grown"
	end,
	finishbuilds = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /finishbuilds <player|me>"
		end
		BuildService.FinishAll(target)
		return "Buildings finished"
	end,
	spawnanimal = function(admin, args)
		local target, animalId = findPlayer(admin, args[1]), args[2]
		if not target or not animalId then
			return "Usage: /spawnanimal <player|me> <Cow|Chicken>"
		end
		local ok, reason = AnimalService.AddAnimal(target, animalId)
		return if ok then "Spawned " .. animalId else tostring(reason)
	end,
	readyanimals = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /readyanimals <player|me>"
		end
		AnimalService.ReadyAll(target)
		return "Animals ready"
	end,
	save = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /save <player|me>"
		end
		return if DataService.SaveNow(target) then "Saved" else "Save failed (see output)"
	end,
	resetdata = function(admin, args)
		if not RunService:IsStudio() then
			return "resetdata is Studio-only"
		end
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /resetdata <player|me>"
		end
		DataService.ResetProfile(target)
		return "Profile reset — rejoin to rebuild the island"
	end,
	debug = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Player not found"
		end
		local island = IslandService.GetIsland(target)
		local data = DataService.GetData(target)
		local report = {
			Player = target.Name,
			IslandId = island and island.Id,
			Slot = island and island.SlotIndex,
			IslandLevel = data and data.Island.Level,
			Coins = data and data.Coins,
			Equipped = ToolService.GetEquippedId(target),
			Save = DataService.GetDebugState(target),
		}
		print("[Admin /debug]", HttpService:JSONEncode(report))
		return "Debug info printed to the server output"
	end,
}

local function onChatted(player: Player, message: string)
	if string.sub(message, 1, 1) ~= "/" then
		return
	end
	local parts = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(parts, 1) or "")
	local command = COMMANDS[name]
	if not command then
		return
	end
	if not isAdmin(player) then
		return
	end
	local ok, result = pcall(command, player, parts)
	if ok then
		Notify.Toast(player, "[Admin] " .. tostring(result), "🛠️")
	else
		warn("[AdminService] /" .. name .. " failed: " .. tostring(result))
		Notify.Error(player, "[Admin] Command failed")
	end
end

-- TextChatService: server-owned TextChatCommands fire Triggered on the server.
local function registerTextChatCommands()
	local folder = Instance.new("Folder")
	folder.Name = "IslandAdminCommands"
	for name in COMMANDS do
		local command = Instance.new("TextChatCommand")
		command.Name = name
		command.PrimaryAlias = "/" .. name
		command.AutocompleteVisible = false
		command.Triggered:Connect(function(source: TextSource, text: string)
			local player = Players:GetPlayerByUserId(source.UserId)
			if player then
				onChatted(player, text)
			end
		end)
		command.Parent = folder
	end
	folder.Parent = TextChatService
end

function AdminService.Start()
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		registerTextChatCommands()
		return
	end
	local function hook(player: Player)
		player.Chatted:Connect(function(message)
			onChatted(player, message)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">AnimalService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AnimalService
	DEPENDENCIES: DataService, IslandService, BuildService, InventoryService, ProgressionService,
	              InteractionService, ToolService, AnimationService, SoundService, VFXService,
	              Server.Island.AnimalModels, Shared.Config.AnimalConfig, Shared.Util.AnimalMath

	Animals that feel alive (spec §24-§28, §100, §114, §144).

	  * Every animal lives in a HOUSING building (Barn / Chicken Coop) and
	    wanders inside its pen. Buying needs free housing capacity.
	  * Care loop (AnimalMath, all timestamp-based):
	        [E] Feed (1 Wheat) -> happier, production starts
	        ... ProduceTime ... -> [E] Milk Cow / Collect Eggs (+bonus when happy)
	        [F] Pet (cooldown) -> happiness
	  * Server-authoritative: actions go through AnimationService.PerformAction
	    so the reward lands on the animation's Milk/Feed/Pet marker.
	  * Performance tiers: animals only wander while a player is within
	    ActiveRange; one shared loop, a few tweens — never per-frame AI.

	Model attributes (read by the client's billboards): AnimalId, UniqueId,
	Variant, Happiness, Status, ReadyAt, OwnerUserId. Tag: "Animal".
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local AnimalConfig = require(Shared.Config.AnimalConfig)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local AnimalMath = require(Shared.Util.AnimalMath)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local BuildService = require(Services.BuildService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local InteractionService = require(Services.InteractionService)
local ToolService = require(Services.ToolService)
local AnimationService = require(Services.AnimationService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local AnimalModels = require(script.Parent.Parent.Island.AnimalModels)
local Notify = require(script.Parent.Parent.Util.Notify)

local TAG = "Animal"
local STATUS_TICK = 2

type Animal = {
	UniqueId: string,
	AnimalId: string,
	Def: any,
	Owner: Player,
	Island: any,
	Model: Model,
	Body: BasePart,
	BodyOffset: CFrame,
	Home: CFrame,
	PenRadius: number,
	Moving: boolean,
	Status: string,
}

local AnimalService = {}

AnimalService.AnimalFed = Signal.new() -- (player, animalId)
AnimalService.ProduceCollected = Signal.new() -- (player, animalId, itemId, amount)
AnimalService.AnimalAdded = Signal.new() -- (player, animalId)

local animalsByIsland: { [string]: { [string]: Animal } } = {}
local random = Random.new()
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true

local function entryOf(animal: Animal): any
	return DataService.Get(animal.Owner, { "Island", "Animals", animal.UniqueId })
end

local function writeEntry(animal: Animal, changes: { [string]: any })
	local entry = entryOf(animal)
	if not entry then
		return
	end
	local updated = table.clone(entry)
	for key, value in changes do
		updated[key] = value
	end
	DataService.Set(animal.Owner, { "Island", "Animals", animal.UniqueId }, updated)
end

local function variantDef(def: any, variantId: string?): any
	for _, variant in def.Variants do
		if variant.Id == variantId then
			return variant
		end
	end
	return def.Variants[1]
end

local function rollVariant(def: any): string
	local total = 0
	for _, variant in def.Variants do
		total += variant.Weight
	end
	local roll = random:NextNumber(0, total)
	for _, variant in def.Variants do
		roll -= variant.Weight
		if roll <= 0 then
			return variant.Id
		end
	end
	return def.Variants[1].Id
end

---------------------------------------------------------------------------
-- Housing
---------------------------------------------------------------------------

local function housingSites(player: Player, animalId: string): { any }
	local list = {}
	for _, site in BuildService.GetSites(player) do
		if site.Def.Capacity and site.Def.Capacity[animalId] and BuildService.IsComplete(site) then
			table.insert(list, site)
		end
	end
	return list
end

local function residents(player: Player, housingId: string): number
	local count = 0
	for _, entry in DataService.Get(player, { "Island", "Animals" }) or {} do
		if entry.HousingId == housingId then
			count += 1
		end
	end
	return count
end

local function penOf(site: any): (CFrame, number)
	local pen = site.Def.Pen or { Offset = Vector2.zero, Radius = 3 }
	return site.Model:GetPivot() * CFrame.new(pen.Offset.X, 0, pen.Offset.Y), pen.Radius
end

-- Returns (housingSite?, reason?)
function AnimalService.FindHousing(player: Player, animalId: string): (any?, string?)
	local def = AnimalConfig.Animals[animalId]
	if not def then
		return nil, "Unknown animal."
	end
	local sitesList = housingSites(player, animalId)
	if #sitesList == 0 then
		return nil, ("Build a %s first to house a %s."):format(def.Housing == "ChickenCoop" and "Chicken Coop" or def.Housing, def.DisplayName)
	end
	for _, site in sitesList do
		if residents(player, site.UniqueId) < site.Def.Capacity[animalId] then
			return site, nil
		end
	end
	return nil, ("Your %s is full — build another one."):format(def.Housing == "ChickenCoop" and "Chicken Coop" or def.Housing)
end

---------------------------------------------------------------------------
-- Spawning
---------------------------------------------------------------------------

local function groundY(position: Vector3): number
	groundParams.FilterDescendantsInstances = { workspace.Terrain }
	local result = workspace:Raycast(position + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), groundParams)
	return if result then result.Position.Y else position.Y
end

local function statusText(animal: Animal, entry: any, now: number): string
	local status = AnimalMath.GetStatus(entry, now)
	if status == "Ready" then
		return animal.Def.ProduceVerb
	elseif status == "Hungry" then
		return ("Feed (%d %s)"):format(animal.Def.FoodAmount, animal.Def.Food)
	end
	return "Pet"
end

local function refresh(animal: Animal)
	local entry = entryOf(animal)
	if not entry then
		return
	end
	local now = os.time()
	local status = AnimalMath.GetStatus(entry, now)
	animal.Status = status
	local model = animal.Model
	model:SetAttribute("Status", status)
	model:SetAttribute("Happiness", math.floor(AnimalMath.GetHappiness(entry, now) + 0.5))
	model:SetAttribute("ReadyAt", entry.ProduceReadyAt)
	model:SetAttribute("FedAt", entry.FedAt)
	InteractionService.SetText(model, statusText(animal, entry, now), animal.Def.DisplayName)
end

local function spawnAnimal(player: Player, island: any, entry: any): Animal?
	local def = AnimalConfig.Animals[entry.AnimalId]
	if not def then
		return nil
	end
	local home: CFrame
	local radius = 3
	local site = BuildService.GetSite(entry.HousingId)
	if site then
		home, radius = penOf(site)
	else
		home = island.SpawnCFrame * CFrame.new(math.random(-6, 6), -4, math.random(-10, -4))
	end

	local model = AnimalModels.Build(entry.AnimalId, variantDef(def, entry.Variant))
	local body = model.PrimaryPart :: BasePart
	local bodyOffset = model:GetPivot():ToObjectSpace(body.CFrame)
	local start = CFrame.new(home.Position.X, groundY(home.Position), home.Position.Z) * CFrame.Angles(0, random:NextNumber(0, math.pi * 2), 0)
	model:PivotTo(start)
	model:SetAttribute("AnimalId", entry.AnimalId)
	model:SetAttribute("UniqueId", entry.UniqueId)
	model:SetAttribute("Variant", entry.Variant)
	model:SetAttribute("DisplayName", def.DisplayName)
	model:SetAttribute("OwnerUserId", island.OwnerUserId)
	model.Parent = island.Folders.Animals
	CollectionService:AddTag(model, TAG)

	local animal: Animal = {
		UniqueId = entry.UniqueId,
		AnimalId = entry.AnimalId,
		Def = def,
		Owner = player,
		Island = island,
		Model = model,
		Body = body,
		BodyOffset = bodyOffset,
		Home = home,
		PenRadius = radius,
		Moving = false,
		Status = "",
	}
	local list = animalsByIsland[island.Id]
	if not list then
		list = {}
		animalsByIsland[island.Id] = list
	end
	list[entry.UniqueId] = animal

	InteractionService.Attach(model, "Animal", { ObjectText = def.DisplayName, OwnerUserId = island.OwnerUserId, MaxDistance = 9 })
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		InteractionService.Attach(head, "AnimalPet", {
			ObjectText = def.DisplayName,
			OwnerUserId = island.OwnerUserId,
			KeyboardKeyCode = Enum.KeyCode.F,
			GamepadKeyCode = Enum.KeyCode.ButtonY,
			MaxDistance = 9,
		})
	end
	refresh(animal)
	return animal
end

local function findAnimal(player: Player, model: Instance): Animal?
	local animalModel = if model:IsA("Model") then model else model:FindFirstAncestorOfClass("Model")
	if not animalModel then
		return nil
	end
	local uniqueId = animalModel:GetAttribute("UniqueId")
	local island = IslandService.GetIslandFromInstance(animalModel)
	local list = island and animalsByIsland[island.Id]
	local animal = list and type(uniqueId) == "string" and list[uniqueId]
	if animal and IslandService.CanAccess(player, animal.Island, "Animals") then
		return animal
	end
	return nil
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

-- Plays e.g. "CowEat" on the animal rig if that animation exists in AnimationConfig.
local function playRig(animal: Animal, suffix: string)
	local name = animal.AnimalId .. suffix
	if AnimationConfig.Get(name) then
		AnimationService.PlayAnimation(animal.Model, name)
	end
end

local function faceAnimal(animal: Animal)
	-- Stop wandering while being cared for.
	animal.Moving = true
	task.delay(2.5, function()
		animal.Moving = false
	end)
end

local function pet(player: Player, animal: Animal)
	local entry = entryOf(animal)
	if not entry then
		return
	end
	local now = os.time()
	local wait = (entry.PettedAt or 0) + AnimalConfig.PetCooldown - now
	if wait > 0 then
		Notify.Toast(player, ("Your %s loved that! Pet again in %ds."):format(animal.Def.DisplayName, wait), "💕")
		return
	end
	faceAnimal(animal)
	AnimationService.PerformAction(player, "PetAnimal", "Pet", function()
		local current = entryOf(animal)
		if not current then
			return
		end
		local happiness = math.min(100, AnimalMath.GetHappiness(current, os.time()) + AnimalConfig.PetHappiness)
		writeEntry(animal, { Happiness = happiness, HappinessAt = os.time(), PettedAt = os.time() })
		VFXService.PlayAt("Hearts", animal.Body.Position + Vector3.new(0, 2, 0))
		GameSoundService.PlayAt(animal.Def.Voice, animal.Body.Position)
		refresh(animal)
	end)
end

local function feed(player: Player, animal: Animal)
	local def = animal.Def
	if InventoryService.GetCount(player, def.Food) < def.FoodAmount then
		Notify.Error(player, ("Your %s needs %d %s — grow some on your farm!"):format(def.DisplayName, def.FoodAmount, def.Food))
		return
	end
	faceAnimal(animal)
	AnimationService.PerformAction(player, "FeedAnimal", "Feed", function()
		local entry = entryOf(animal)
		if not entry or AnimalMath.GetStatus(entry, os.time()) ~= "Hungry" then
			return
		end
		if not InventoryService.RemoveItem(player, def.Food, def.FoodAmount, "FeedAnimal") then
			return
		end
		local now = os.time()
		local happiness = math.min(100, AnimalMath.GetHappiness(entry, now) + AnimalConfig.FeedHappiness)
		writeEntry(animal, {
			Happiness = happiness,
			HappinessAt = now,
			FedAt = now,
			ProduceReadyAt = now + math.floor(AnimalMath.ProduceDuration(animal.AnimalId, happiness)),
		})
		VFXService.PlayAt("Hearts", animal.Body.Position + Vector3.new(0, 2, 0))
		GameSoundService.PlayAt("Feed", animal.Body.Position)
		playRig(animal, "Eat")
		ProgressionService.Award(player, "FeedAnimal")
		refresh(animal)
		Notify.Toast(player, ("%s fed! %s will be ready soon."):format(def.DisplayName, def.Produce), "🌾")
		AnimalService.AnimalFed:Fire(player, animal.AnimalId)
	end)
end

local function collect(player: Player, animal: Animal)
	local def = animal.Def
	if def.ProduceTool then
		local tool = ToolService.EquipBestOfType(player, def.ProduceTool)
		if not tool then
			Notify.Error(player, ("You need a %s — buy one at the market."):format(def.ProduceTool))
			return
		end
	end
	faceAnimal(animal)
	AnimationService.PerformAction(player, def.ProduceAnimation, def.ProduceMarker, function()
		local entry = entryOf(animal)
		if not entry or AnimalMath.GetStatus(entry, os.time()) ~= "Ready" then
			return
		end
		local happiness = AnimalMath.GetHappiness(entry, os.time())
		local variant = variantDef(def, entry.Variant)
		local amount = def.ProduceAmount + (if happiness >= AnimalConfig.BonusProduceAtHappiness then 1 else 0) + (variant.ProduceBonus or 0)
		local added = InventoryService.AddItem(player, def.Produce, amount, "Animal")
		if added <= 0 then
			return
		end
		writeEntry(animal, { ProduceReadyAt = 0 })
		DataService.Increment(player, { "Stats", if def.Produce == "Milk" then "MilkCollected" else "EggsCollected" }, added)
		VFXService.PlayAt(def.ProduceVFX, animal.Body.Position + Vector3.new(0, 1, 0))
		GameSoundService.PlayAt(def.ProduceSound, animal.Body.Position)
		playRig(animal, "Happy")
		ProgressionService.Award(player, "CollectProduce")
		refresh(animal)
		AnimalService.ProduceCollected:Fire(player, animal.AnimalId, def.Produce, added)
	end)
end

local function onPrimary(player: Player, animal: Animal)
	local entry = entryOf(animal)
	if not entry then
		return
	end
	local status = AnimalMath.GetStatus(entry, os.time())
	if status == "Ready" then
		collect(player, animal)
	elseif status == "Hungry" then
		feed(player, animal)
	else
		pet(player, animal)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function AnimalService.CanAdd(player: Player, animalId: string): (boolean, string?)
	local site, reason = AnimalService.FindHousing(player, animalId)
	return site ~= nil, reason
end

function AnimalService.AddAnimal(player: Player, animalId: string): (boolean, string?)
	local def = AnimalConfig.Animals[animalId]
	local island = IslandService.GetIsland(player)
	if not def or not island then
		return false, "Unknown animal."
	end
	local site, reason = AnimalService.FindHousing(player, animalId)
	if not site then
		return false, reason
	end
	local uniqueId = HttpService:GenerateGUID(false)
	local now = os.time()
	local entry = {
		AnimalId = animalId,
		UniqueId = uniqueId,
		Variant = rollVariant(def),
		HousingId = site.UniqueId,
		Happiness = AnimalConfig.StartHappiness,
		HappinessAt = now,
		FedAt = 0,
		ProduceReadyAt = 0,
		PettedAt = 0,
	}
	DataService.Set(player, { "Island", "Animals", uniqueId }, entry)
	DataService.Increment(player, { "Stats", "AnimalsOwned" }, 1)
	local animal = spawnAnimal(player, island, entry)
	if animal then
		VFXService.PlayAt("Hearts", animal.Body.Position + Vector3.new(0, 2, 0))
		GameSoundService.PlayAt(def.Voice, animal.Body.Position)
	end
	local variantName = if entry.Variant ~= "Default" then entry.Variant .. " " else ""
	Notify.Banner(player, "NEW ANIMAL!", ("Meet your %s%s! Feed it %s."):format(variantName, def.DisplayName, def.Food), "Reward")
	ProgressionService.Award(player, "BuyAnimal")
	AnimalService.AnimalAdded:Fire(player, animalId)
	return true, nil
end

-- Admin/testing: make every animal's product ready now.
function AnimalService.ReadyAll(player: Player)
	local island = IslandService.GetIsland(player)
	for _, animal in (island and animalsByIsland[island.Id]) or {} do
		writeEntry(animal, { ProduceReadyAt = os.time() - 1, FedAt = os.time() })
		refresh(animal)
	end
end

local function wander(animal: Animal)
	if animal.Moving or not animal.Body.Parent then
		return
	end
	local angle = random:NextNumber(0, math.pi * 2)
	local distance = math.sqrt(random:NextNumber()) * animal.PenRadius
	local target = animal.Home.Position + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
	target = Vector3.new(target.X, groundY(target), target.Z)
	local current = animal.Model:GetPivot()
	local flat = Vector3.new(target.X - current.Position.X, 0, target.Z - current.Position.Z)
	if flat.Magnitude < 0.8 then
		return
	end
	local goal = CFrame.lookAt(target, target + flat.Unit) * animal.BodyOffset
	animal.Moving = true
	local tween = TweenService:Create(animal.Body, TweenInfo.new(flat.Magnitude / animal.Def.WalkSpeed, Enum.EasingStyle.Sine), { CFrame = goal })
	tween.Completed:Once(function()
		animal.Moving = false
	end)
	tween:Play()
end

local function playerNear(position: Vector3): boolean
	for _, player in Players:GetPlayers() do
		local root = R15.GetRootPart(player.Character)
		if root and (root.Position - position).Magnitude <= AnimalConfig.ActiveRange then
			return true
		end
	end
	return false
end

local function loadIsland(player: Player, island: any)
	animalsByIsland[island.Id] = {}
	for _, entry in DataService.Get(player, { "Island", "Animals" }) or {} do
		local ok, err = pcall(spawnAnimal, player, island, entry)
		if not ok then
			warn("[AnimalService] Could not load animal: " .. tostring(err))
		end
	end
end

function AnimalService.Init()
	InteractionService.RegisterKind("Animal", {
		ActionText = "Pet",
		Permission = "Animals",
		MaxDistance = 9,
		Cooldown = 0.4,
		Handler = function(player: Player, model: Instance)
			local animal = findAnimal(player, model)
			if animal then
				onPrimary(player, animal)
			end
		end,
	})
	InteractionService.RegisterKind("AnimalPet", {
		ActionText = "Pet",
		Permission = "Animals",
		MaxDistance = 9,
		Cooldown = 0.4,
		Handler = function(player: Player, head: Instance)
			local animal = findAnimal(player, head)
			if animal then
				pet(player, animal)
			end
		end,
	})

	-- Housing with animals can't be deleted out from under them.
	BuildService.SetDeleteGuard(function(player: Player, site: any)
		if site.Def.Capacity and residents(player, site.UniqueId) > 0 then
			return false, "Animals live here — it can't be removed while they do."
		end
		return true, nil
	end)
end

function AnimalService.Start()
	IslandService.IslandAssigned:Connect(function(player: Player, island: any)
		-- Buildings (housing) load in BuildService's handler first; defer so pens exist.
		task.defer(loadIsland, player, island)
	end)
	IslandService.IslandReleased:Connect(function(_player: Player, islandId: string)
		animalsByIsland[islandId] = nil
	end)
	BuildService.BuildingMoved:Connect(function(_player: Player, site: any)
		local list = animalsByIsland[site.Island.Id]
		for _, animal in list or {} do
			local entry = entryOf(animal)
			if entry and entry.HousingId == site.UniqueId then
				animal.Home, animal.PenRadius = penOf(site)
				animal.Model:PivotTo(CFrame.new(animal.Home.Position.X, groundY(animal.Home.Position), animal.Home.Position.Z))
			end
		end
	end)

	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(STATUS_TICK)
			elapsed += STATUS_TICK
			local doWander = elapsed >= AnimalConfig.WanderInterval
			if doWander then
				elapsed = 0
			end
			for _, list in animalsByIsland do
				for _, animal in list do
					if animal.Model.Parent then
						local entry = entryOf(animal)
						if entry and AnimalMath.GetStatus(entry, os.time()) ~= animal.Status then
							refresh(animal)
						end
						if doWander and random:NextNumber() < 0.45 and playerNear(animal.Home.Position) then
							wander(animal)
						end
					end
				end
			end
		end
	end)
end

return AnimalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">AnimationService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AnimationService
	DEPENDENCIES: Shared.Net, Shared.Animation.AnimationPlayer, Shared.Config.AnimationConfig,
	              Shared.Util.AssetId

	Server half of the centralized animation system (spec §71).
	  * Player characters: the OWNING CLIENT plays animations (responsive, and
	    Animator replication shows them to everyone). The server sends an
	    AnimationCommand to that client.
	  * NPCs / animals (server-owned rigs): played directly here through the
	    same shared AnimationPlayer.
	  * Movement animation overrides: real ids placed in
	    AnimationConfig.Movement are written into each character's default
	    Animate script on spawn.

	API (spec §71):
		PlayAnimation(rig, name, options?) -> handle | nil (nil for player rigs)
		StopAnimation(rig, name, fade?)
		StopAllAnimations(rig, fade?)
		GetAnimation(rig, name) -> handle
		SetAnimationSpeed(rig, name, speed)
		IsPlaying(rig, name) -> boolean   (server rigs only)

	SERVER-DRIVEN ACTIONS (spec §173: interaction + animation + marker together):
		PerformAction(player, animationName, markerName, onMarker, options?) -> boolean
	The owning client plays the animation (its MarkerEffects give the sound /
	VFX at the marker) and the server applies the gameplay result at the SAME
	marker time taken from AnimationConfig. A per-player busy lock stops
	actions overlapping or being spammed.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local AnimationPlayer = require(Shared.Animation.AnimationPlayer)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local AssetId = require(Shared.Util.AssetId)
local R15 = require(Shared.Util.R15)

local AnimationService = {}

local players: { [Model]: any } = {}
local busyUntil: { [Player]: number } = {}

local function getPlayerForRig(rig: Model): Player?
	return Players:GetPlayerFromCharacter(rig)
end

local function getPlayer(rig: Model)
	local animationPlayer = players[rig]
	if not animationPlayer then
		animationPlayer = AnimationPlayer.new(rig)
		players[rig] = animationPlayer
		rig.Destroying:Once(function()
			local existing = players[rig]
			if existing then
				existing:Destroy()
				players[rig] = nil
			end
		end)
	end
	return animationPlayer
end

function AnimationService.PlayAnimation(rig: Model, name: string, options: { Speed: number? }?): any
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "Play", Name = name, Speed = options and options.Speed })
		return nil
	end
	return getPlayer(rig):Play(name, options)
end

function AnimationService.StopAnimation(rig: Model, name: string, fadeTime: number?)
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "Stop", Name = name, Fade = fadeTime })
		return
	end
	local animationPlayer = players[rig]
	if animationPlayer then
		animationPlayer:Stop(name, fadeTime)
	end
end

function AnimationService.StopAllAnimations(rig: Model, fadeTime: number?)
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "StopAll", Fade = fadeTime })
		return
	end
	local animationPlayer = players[rig]
	if animationPlayer then
		animationPlayer:StopAll(fadeTime)
	end
end

function AnimationService.GetAnimation(rig: Model, name: string): any
	local animationPlayer = players[rig]
	return animationPlayer and animationPlayer:GetHandle(name)
end

function AnimationService.SetAnimationSpeed(rig: Model, name: string, speed: number)
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "Speed", Name = name, Speed = speed })
		return
	end
	local animationPlayer = players[rig]
	if animationPlayer then
		animationPlayer:SetSpeed(name, speed)
	end
end

function AnimationService.IsPlaying(rig: Model, name: string): boolean
	local animationPlayer = players[rig]
	return animationPlayer ~= nil and animationPlayer:IsPlaying(name)
end

function AnimationService.IsBusy(player: Player): boolean
	return (busyUntil[player] or 0) > os.clock()
end

export type ActionOptions = {
	Speed: number?,
	LockFraction: number?, -- share of the animation length the player stays busy (default 0.85)
}

-- Plays an action animation on the player's client and runs onMarker on the
-- server at the configured marker time. Returns false if the player is busy.
function AnimationService.PerformAction(player: Player, animationName: string, markerName: string?, onMarker: () -> (), options: ActionOptions?): boolean
	if AnimationService.IsBusy(player) then
		return false
	end
	local def = AnimationConfig.Get(animationName)
	if not def then
		warn("[AnimationService] Unknown action animation " .. tostring(animationName))
		return false
	end
	local speed = math.max((options and options.Speed) or 1, 0.1)
	local lockFraction = (options and options.LockFraction) or 0.85
	local markerTime = (markerName and def.Markers[markerName]) or def.Length * 0.5
	busyUntil[player] = os.clock() + def.Length / speed * lockFraction

	local character = player.Character
	if character then
		AnimationService.PlayAnimation(character, animationName, { Speed = speed })
	end
	task.delay(markerTime / speed, function()
		if player.Parent and player.Character == character and R15.IsAlive(character) then
			local ok, err = pcall(onMarker)
			if not ok then
				warn(("[AnimationService] Action %s failed: %s"):format(animationName, tostring(err)))
			end
		end
	end)
	return true
end

Players.PlayerRemoving:Connect(function(player)
	busyUntil[player] = nil
end)

-- Writes real Movement ids into the default Animate script (idle/walk/run...).
-- Placeholder ids are skipped, so Roblox's default R15 animations stay active.
function AnimationService.ApplyMovementOverrides(character: Model)
	local animate = character:FindFirstChild("Animate")
	if not animate then
		return
	end
	for _, def in AnimationConfig.Categories.Movement do
		local slot = def.AnimateSlot
		if slot and not AssetId.IsPlaceholder(def.Id) then
			local folder = animate:FindFirstChild(slot[1])
			local animation = folder and folder:FindFirstChild(slot[2])
			if animation and animation:IsA("Animation") then
				animation.AnimationId = def.Id
			end
		end
	end
end

return AnimationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AntiExploitService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AntiExploitService
	DEPENDENCIES: Shared.Net, Shared.Config.GameConfig, Shared.Util.R15

	Collects "strikes" for suspicious behaviour and acts on THRESHOLDS, never
	on a single odd event (spec §104). Sources:
	  * Net: remote rate-limit violations and calls to unhandled remotes
	  * Services: invalid ids / out-of-range requests (AntiExploitService.Flag)
	  * Movement sampling: impossible horizontal speed
	  * EconomyService: unusually large single currency gains (logged)

	Server teleports must call AllowTeleport(player) so they are not flagged.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local GameConfig = require(Shared.Config.GameConfig)
local R15 = require(Shared.Util.R15)

local Config = GameConfig.AntiExploit

type StrikeRecord = { Time: number, Weight: number, Reason: string }
type PlayerState = {
	Strikes: { StrikeRecord },
	Warned: boolean,
	LastPosition: Vector3?,
	LastSample: number,
	TeleportUntil: number,
}

local AntiExploitService = {}

local states: { [Player]: PlayerState } = {}

local function getState(player: Player): PlayerState
	local state = states[player]
	if not state then
		state = { Strikes = {}, Warned = false, LastPosition = nil, LastSample = os.clock(), TeleportUntil = 0 }
		states[player] = state
	end
	return state
end

local function totalStrikes(state: PlayerState): number
	local cutoff = os.clock() - Config.StrikeWindow
	local total = 0
	for i = #state.Strikes, 1, -1 do
		local strike = state.Strikes[i]
		if strike.Time < cutoff then
			table.remove(state.Strikes, i)
		else
			total += strike.Weight
		end
	end
	return total
end

-- Record suspicious behaviour. weight: 1 = mildly odd, 5 = clearly impossible.
function AntiExploitService.Flag(player: Player, reason: string, weight: number?)
	if not player.Parent then
		return
	end
	local state = getState(player)
	table.insert(state.Strikes, { Time = os.clock(), Weight = weight or 1, Reason = reason })
	local total = totalStrikes(state)

	if GameConfig.Debug then
		print(("[AntiExploit] %s flagged: %s (total %d)"):format(player.Name, reason, total))
	end
	if total >= Config.WarnStrikes and not state.Warned then
		state.Warned = true
		warn(("[AntiExploit] %s reached warning threshold (%d). Last reason: %s"):format(player.Name, total, reason))
	end
	if total >= Config.KickStrikes and Config.KickEnabled and not RunService:IsStudio() then
		warn(("[AntiExploit] Kicking %s (%d strikes). Last reason: %s"):format(player.Name, total, reason))
		player:Kick("Unusual activity was detected. Please rejoin.")
	end
end

-- Call right before/after any server-side teleport of a character.
function AntiExploitService.AllowTeleport(player: Player)
	local state = getState(player)
	state.TeleportUntil = os.clock() + Config.TeleportGrace
	state.LastPosition = nil
end

function AntiExploitService.RecordCurrencyChange(player: Player, currency: string, amount: number, reason: string)
	if amount >= Config.LargeCurrencyGain then
		warn(("[AntiExploit] Large %s gain for %s: %d (%s)"):format(currency, player.Name, amount, reason))
	end
end

local function sampleMovement()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = R15.GetRootPart(character)
		local humanoid = R15.GetHumanoid(character)
		local state = getState(player)
		if not root or not humanoid or humanoid.Health <= 0 then
			state.LastPosition = nil
			continue
		end
		local position = root.Position
		local last = state.LastPosition
		local elapsed = now - state.LastSample
		state.LastPosition = position
		state.LastSample = now
		if not last or now < state.TeleportUntil or elapsed <= 0 or humanoid.Sit then
			continue
		end
		local horizontal = Vector3.new(position.X - last.X, 0, position.Z - last.Z).Magnitude
		local speed = horizontal / elapsed
		local allowed = humanoid.WalkSpeed * Config.MaxSpeedMultiplier + Config.MovementSlack
		if speed > allowed then
			AntiExploitService.Flag(player, ("Speed %.0f > %.0f"):format(speed, allowed), 2)
		end
	end
end

function AntiExploitService.Init()
	Net.SetViolationHandler(function(player, reason, weight)
		AntiExploitService.Flag(player, reason, weight)
	end)
end

function AntiExploitService.Start()
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.MovementCheckInterval)
			sampleMovement()
		end
	end)
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">BuildService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/BuildService
	DEPENDENCIES: DataService, IslandService, EconomyService, InventoryService, ProgressionService,
	              InteractionService, ToolService, AnimationService, AntiExploitService, SoundService,
	              VFXService, Shared.Building.BuildingModels, Shared.Config.{BuildingConfig, BuildConfig},
	              Shared.Util.{Placement, Serializer, Validate}

	THE authority for buildings (spec §7-§12, §111, §141).

	PLACE   BuildRequest{Op="Place", BuildingId, X, Z, Rotation} (island-local X/Z)
	        -> validate (own island, id, unlock level, rotation, grid snap,
	           unlocked land, slope, overlap, distance, cooldown, cost)
	        -> charge coins + items atomically -> construction SITE appears
	BUILD   hammer the site: prompt "[E] Build" (server plays HammerSwing and
	        advances at the HammerHit marker) or swing an equipped hammer
	        (client sends BuildRequest{Op="Hammer", UniqueId} at its marker).
	        Each hit reveals the next Stage of the model; the last hit plays
	        HammerHeavy and the completion reveal (dust, sparkle, banner, XP).
	MOVE    MoveBuildRequest(uniqueId, X, Z, Rotation) — same validation, free.
	DELETE  DeleteBuildRequest(uniqueId) — refunds RefundPercent of the cost.

	Every building model knows OwnerUserId, IslandId, BuildingId, UniqueId.
	Saved in Island.Buildings[uniqueId] with island-local position.
]]

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local BuildingConfig = require(Shared.Config.BuildingConfig)
local BuildConfig = require(Shared.Config.BuildConfig)
local BuildingModels = require(Shared.Building.BuildingModels)
local Placement = require(Shared.Util.Placement)
local Serializer = require(Shared.Util.Serializer)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local InteractionService = require(Services.InteractionService)
local ToolService = require(Services.ToolService)
local AnimationService = require(Services.AnimationService)
local AntiExploitService = require(Services.AntiExploitService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local Notify = require(script.Parent.Parent.Util.Notify)

export type Site = {
	UniqueId: string,
	BuildingId: string,
	Def: any,
	Island: any,
	OwnerUserId: number,
	Model: Model,
	Label: TextLabel?,
}

local SITE_TAG = "ConstructionSite"

local BuildService = {}

BuildService.BuildingPlaced = Signal.new() -- (player, site)
BuildService.BuildingCompleted = Signal.new() -- (player, buildingId, def, site)
BuildService.BuildingRemoved = Signal.new() -- (player, uniqueId, buildingId)
BuildService.BuildingMoved = Signal.new() -- (player, site)

local sites: { [string]: Site } = {}
local sitesByIsland: { [string]: { [string]: Site } } = {}
local lastPlace: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local lastHammer: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local deleteGuard: ((Player, Site) -> (boolean, string?))? = nil

-- AnimalService installs this so housing with animals can't be deleted.
function BuildService.SetDeleteGuard(guard: (Player, Site) -> (boolean, string?))
	deleteGuard = guard
end

local function entryOf(site: Site): any
	local island = site.Island
	local owner = island and island.Owner
	return owner and DataService.Get(owner, { "Island", "Buildings", site.UniqueId })
end

function BuildService.GetSite(uniqueId: any): Site?
	if type(uniqueId) ~= "string" then
		return nil
	end
	return sites[uniqueId]
end

function BuildService.IsComplete(site: Site): boolean
	local entry = entryOf(site)
	return entry ~= nil and entry.State == "Complete"
end

-- All buildings on a player's island.
function BuildService.GetSites(player: Player): { Site }
	local island = IslandService.GetIsland(player)
	local list = {}
	if island and sitesByIsland[island.Id] then
		for _, site in sitesByIsland[island.Id] do
			table.insert(list, site)
		end
	end
	return list
end

function BuildService.CountComplete(player: Player, buildingId: string?, category: string?): number
	local count = 0
	for _, site in BuildService.GetSites(player) do
		if BuildService.IsComplete(site) and (buildingId == nil or site.BuildingId == buildingId) and (category == nil or site.Def.Category == category) then
			count += 1
		end
	end
	return count
end

---------------------------------------------------------------------------
-- Validation
---------------------------------------------------------------------------

local function overlapParams(island: any): OverlapParams
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local folders = {}
	for _, name in BuildConfig.BlockingFolders do
		local folder = island.Folders[name]
		if folder then
			table.insert(folders, folder)
		end
	end
	params.FilterDescendantsInstances = folders
	return params
end

-- Returns (ok, reason, worldCFrame, localPosition)
function BuildService.ValidatePlacement(player: Player, island: any, def: any, localX: number, localZ: number, rotation: number, ignore: Model?): (boolean, string?, CFrame?, Vector3?)
	if not Placement.IsValidRotation(rotation) then
		return false, "Invalid rotation.", nil, nil
	end
	local size = Placement.FootprintSize(def.Footprint, rotation)
	local center = Placement.Snap(Vector2.new(localX, localZ), size)
	if (center - Vector2.new(localX, localZ)).Magnitude > BuildConfig.GridSize then
		return false, "Invalid position.", nil, nil
	end

	local unlocked = IslandService.GetUnlockedAreas(island.Owner)
	if not Placement.IsOnUnlockedLand(unlocked, center, size) then
		return false, "That spot isn't on your unlocked land.", nil, nil
	end

	-- Slope: compare terrain height at the centre and corners.
	local originY = island.Origin.Position.Y
	local heights = { IslandService.GetGroundCFrame(island, center).Position.Y }
	for _, corner in Placement.Corners(center, size) do
		table.insert(heights, IslandService.GetGroundCFrame(island, corner).Position.Y)
	end
	local lowest, highest = math.huge, -math.huge
	for _, height in heights do
		lowest = math.min(lowest, height)
		highest = math.max(highest, height)
	end
	if highest - lowest > BuildConfig.MaxSlope then
		return false, "The ground is too steep here.", nil, nil
	end

	local localPosition = Vector3.new(center.X, heights[1] - originY, center.Y)
	local worldCFrame = island.Origin * Placement.LocalCFrame(localPosition, rotation)

	local shrink = BuildConfig.OverlapShrink
	local boxSize = Vector3.new(math.max(0.5, def.Footprint.X - shrink), def.Height, math.max(0.5, def.Footprint.Y - shrink))
	local boxCFrame = worldCFrame * CFrame.new(0, def.Height / 2 + 0.4, 0)
	for _, hit in workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlapParams(island)) do
		if not (ignore and hit:IsDescendantOf(ignore)) then
			return false, "Something is in the way.", nil, nil
		end
	end

	local root = R15.GetRootPart(player.Character)
	if not root or (root.Position - worldCFrame.Position).Magnitude > BuildConfig.PlacementRange then
		return false, "Move closer to build there.", nil, nil
	end
	-- Don't build on top of the player.
	local relative = boxCFrame:PointToObjectSpace(root.Position)
	if math.abs(relative.X) < def.Footprint.X / 2 + 1 and math.abs(relative.Z) < def.Footprint.Y / 2 + 1 then
		return false, "Step out of the way first!", nil, nil
	end
	return true, nil, worldCFrame, localPosition
end

---------------------------------------------------------------------------
-- Models / sites
---------------------------------------------------------------------------

local function buildModel(buildingId: string): Model
	local folder = ServerStorage:FindFirstChild("Buildings")
	local art = folder and folder:FindFirstChild(buildingId)
	if art and art:IsA("Model") and art.PrimaryPart then
		local clone = art:Clone()
		for _, descendant in clone:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				if descendant:GetAttribute("BaseTransparency") == nil then
					descendant:SetAttribute("BaseTransparency", descendant.Transparency)
					descendant:SetAttribute("BaseCanCollide", descendant.CanCollide)
				end
			end
		end
		return clone
	end
	return BuildingModels.Build(buildingId)
end

local function updateSiteLabel(site: Site, progress: number)
	if site.Label then
		site.Label.Text = ("🔨 %s  %d/%d"):format(site.Def.DisplayName, progress, site.Def.Steps)
	end
	InteractionService.SetText(site.Model, ("Build (%d/%d)"):format(progress, site.Def.Steps), site.Def.DisplayName)
end

local function addSiteVisuals(site: Site)
	local def = site.Def
	local model = site.Model
	local frame = Instance.new("Folder")
	frame.Name = "SiteFrame"
	local base = model.PrimaryPart :: BasePart
	for _, spec in {
		{ Vector3.new(def.Footprint.X, 0.3, 0.3), Vector3.new(0, 0.2, -def.Footprint.Y / 2) },
		{ Vector3.new(def.Footprint.X, 0.3, 0.3), Vector3.new(0, 0.2, def.Footprint.Y / 2) },
		{ Vector3.new(0.3, 0.3, def.Footprint.Y), Vector3.new(-def.Footprint.X / 2, 0.2, 0) },
		{ Vector3.new(0.3, 0.3, def.Footprint.Y), Vector3.new(def.Footprint.X / 2, 0.2, 0) },
	} do
		local edge = Instance.new("Part")
		edge.Name = "SiteEdge"
		edge.Anchored = true
		edge.CanCollide = false
		edge.Material = Enum.Material.Neon
		edge.Color = Color3.fromRGB(255, 190, 60)
		edge.Size = spec[1]
		edge.CFrame = base.CFrame * CFrame.new(spec[2])
		edge.Parent = frame
	end
	frame.Parent = model

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "SiteBillboard"
	billboard.Size = UDim2.fromScale(10, 1.6)
	billboard.StudsOffset = Vector3.new(0, def.Height * 0.5 + 3, 0)
	billboard.MaxDistance = 80
	billboard.LightInfluence = 0
	billboard.Parent = base
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 225, 120)
	label.TextStrokeTransparency = 0.2
	label.Parent = billboard
	site.Label = label

	CollectionService:AddTag(model, SITE_TAG)
	InteractionService.Attach(model, "ConstructionSite", {
		ObjectText = def.DisplayName,
		OwnerUserId = site.OwnerUserId,
		MaxDistance = math.max(12, math.max(def.Footprint.X, def.Footprint.Y) / 2 + 8),
	})
end

local function removeSiteVisuals(site: Site)
	local model = site.Model
	CollectionService:RemoveTag(model, SITE_TAG)
	InteractionService.Detach(model)
	local frame = model:FindFirstChild("SiteFrame")
	if frame then
		frame:Destroy()
	end
	local base = model.PrimaryPart
	local billboard = base and base:FindFirstChild("SiteBillboard")
	if billboard then
		billboard:Destroy()
	end
	site.Label = nil
end

local function spawnSite(island: any, entry: any): Site?
	local def = BuildingConfig.Get(entry.BuildingId)
	local position = Serializer.ToVector3(entry.Position)
	if not def or not position then
		return nil
	end
	local model = buildModel(entry.BuildingId)
	model.Name = entry.BuildingId
	model:SetAttribute("OwnerUserId", island.OwnerUserId)
	model:SetAttribute("IslandId", island.Id)
	model:SetAttribute("BuildingId", entry.BuildingId)
	model:SetAttribute("UniqueId", entry.UniqueId)
	model:PivotTo(island.Origin * Placement.LocalCFrame(position, entry.Rotation))
	model.Parent = island.Folders.Buildings

	local site: Site = {
		UniqueId = entry.UniqueId,
		BuildingId = entry.BuildingId,
		Def = def,
		Island = island,
		OwnerUserId = island.OwnerUserId,
		Model = model,
		Label = nil,
	}
	sites[entry.UniqueId] = site
	local list = sitesByIsland[island.Id]
	if not list then
		list = {}
		sitesByIsland[island.Id] = list
	end
	list[entry.UniqueId] = site

	if entry.State == "Complete" then
		BuildingModels.SetStage(model, math.huge, false)
	else
		BuildingModels.SetStage(model, entry.Progress, false)
		addSiteVisuals(site)
		updateSiteLabel(site, entry.Progress)
	end
	return site
end

local function despawnSite(site: Site)
	sites[site.UniqueId] = nil
	local list = sitesByIsland[site.Island.Id]
	if list then
		list[site.UniqueId] = nil
	end
	InteractionService.Detach(site.Model)
	site.Model:Destroy()
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

local function costText(def: any, share: number?): string
	local parts = {}
	local scale = share or 1
	if def.Cost.Coins and def.Cost.Coins > 0 then
		table.insert(parts, ("%s 🪙"):format(Format.Commas(math.floor(def.Cost.Coins * scale))))
	end
	for itemId, amount in def.Cost.Items do
		table.insert(parts, ("%d %s"):format(math.floor(amount * scale), itemId))
	end
	return table.concat(parts, ", ")
end

function BuildService.Place(player: Player, buildingId: any, localX: any, localZ: any, rotation: any): (boolean, string?)
	local def = BuildingConfig.Get(buildingId)
	if not def or not Validate.Number(localX, -2000, 2000) or not Validate.Number(localZ, -2000, 2000) then
		AntiExploitService.Flag(player, "BadBuildRequest", 2)
		return false, "Invalid build request."
	end
	local now = os.clock()
	if lastPlace[player] and now - lastPlace[player] < BuildConfig.PlaceCooldown then
		return false, nil
	end
	lastPlace[player] = now

	local island = IslandService.GetIsland(player)
	if not island then
		return false, "Your island isn't ready yet."
	end
	local islandLevel = DataService.Get(player, { "Island", "Level" }) or 1
	if islandLevel < def.UnlockLevel then
		return false, ("%s unlocks at Island Level %d."):format(def.DisplayName, def.UnlockLevel)
	end

	local ok, reason, worldCFrame, localPosition = BuildService.ValidatePlacement(player, island, def, localX, localZ, rotation)
	if not ok or not worldCFrame or not localPosition then
		return false, reason
	end

	-- Atomic payment: check everything first, then charge.
	local coins = def.Cost.Coins or 0
	if not EconomyService.CanAfford(player, coins) or not InventoryService.HasItems(player, def.Cost.Items) then
		return false, "You need " .. costText(def) .. "."
	end
	if not EconomyService.SpendCoins(player, coins, "Build:" .. buildingId) then
		return false, "You can't afford that."
	end
	if not InventoryService.RemoveItems(player, def.Cost.Items, "Build:" .. buildingId) then
		if coins > 0 then
			EconomyService.AddCoins(player, coins, "BuildRefund")
		end
		return false, "You don't have the materials."
	end

	local uniqueId = HttpService:GenerateGUID(false)
	local entry = {
		BuildingId = buildingId,
		UniqueId = uniqueId,
		Position = Serializer.Vector3(localPosition),
		Rotation = rotation,
		Variant = "Default",
		State = "Constructing",
		Progress = 0,
	}
	DataService.Set(player, { "Island", "Buildings", uniqueId }, entry)
	local site = spawnSite(island, entry)
	if not site then
		return false, "Build failed."
	end
	GameSoundService.PlayAt("ConstructionStart", worldCFrame.Position)
	VFXService.PlayAt("BuildDust", worldCFrame.Position + Vector3.new(0, 1, 0))
	Notify.Success(player, ("%s placed! Hammer it %d times to build it."):format(def.DisplayName, def.Steps), "🔨")
	ToolService.EquipBestOfType(player, "Hammer")
	BuildService.BuildingPlaced:Fire(player, site)
	return true, nil
end

local function complete(player: Player, site: Site)
	local def = site.Def
	DataService.Set(player, { "Island", "Buildings", site.UniqueId, "State" }, "Complete")
	removeSiteVisuals(site)
	BuildingModels.SetStage(site.Model, math.huge, true)
	local position = site.Model:GetPivot().Position
	VFXService.PlayAt("BuildComplete", position + Vector3.new(0, def.Height * 0.5, 0))
	VFXService.PlayAt("BuildDust", position + Vector3.new(0, 0.5, 0))
	GameSoundService.PlayAt("BuildComplete", position)
	VFXService.ShakeCamera(player, 0.35, 0.4)
	Notify.Banner(player, "BUILD COMPLETE!", def.DisplayName, "Build")
	ProgressionService.Award(player, "BuildComplete")
	DataService.Increment(player, { "Stats", "BuildingsBuilt" }, 1)
	if def.CapacityBonus then
		InventoryService.AddCapacity(player, def.CapacityBonus)
	end
	local character = player.Character
	if character then
		task.delay(0.6, function()
			AnimationService.PlayAnimation(character, "CelebrateBuild")
		end)
	end
	BuildService.BuildingCompleted:Fire(player, site.BuildingId, def, site)
end

local function advance(player: Player, site: Site)
	local entry = entryOf(site)
	if not entry or entry.State ~= "Constructing" or not sites[site.UniqueId] then
		return
	end
	local progress = math.min(entry.Progress + 1, site.Def.Steps)
	DataService.Set(player, { "Island", "Buildings", site.UniqueId, "Progress" }, progress)
	BuildingModels.SetStage(site.Model, progress, true)
	local pivot = site.Model:GetPivot()
	local def = site.Def
	local offset = Vector3.new((math.random() - 0.5) * def.Footprint.X * 0.6, math.random() * def.Height * 0.6, (math.random() - 0.5) * def.Footprint.Y * 0.6)
	VFXService.PlayAt("BuildDust", (pivot * CFrame.new(offset)).Position)
	GameSoundService.PlayAt("HammerHit", pivot.Position)
	ProgressionService.Award(player, "BuildStep")
	if progress >= def.Steps then
		complete(player, site)
	else
		updateSiteLabel(site, progress)
	end
end

-- source = "Prompt" | "Swing"
function BuildService.Hammer(player: Player, uniqueId: any, source: string)
	local site = BuildService.GetSite(uniqueId)
	if not site then
		return
	end
	if not IslandService.CanAccess(player, site.Island, "Build") then
		AntiExploitService.Flag(player, "HammerForeignSite", 1)
		return
	end
	local entry = entryOf(site)
	if not entry or entry.State ~= "Constructing" then
		return
	end
	local root = R15.GetRootPart(player.Character)
	local reach = BuildConfig.HammerRange + math.max(site.Def.Footprint.X, site.Def.Footprint.Y) / 2
	if not root or (root.Position - site.Model:GetPivot().Position).Magnitude > reach then
		return
	end
	local now = os.clock()
	if lastHammer[player] and now - lastHammer[player] < BuildConfig.HammerCooldown then
		return
	end
	lastHammer[player] = now

	if source == "Swing" then
		local tool = ToolService.GetEquipped(player)
		if tool and tool.Type == "Hammer" then
			advance(player, site)
		end
		return
	end

	local tool = ToolService.EquipBestOfType(player, "Hammer")
	local isLast = entry.Progress + 1 >= site.Def.Steps
	AnimationService.PerformAction(player, if isLast then "HammerHeavy" else "HammerSwing", "HammerHit", function()
		advance(player, site)
	end, { Speed = if tool then tool.Speed else 1 })
end

function BuildService.Delete(player: Player, uniqueId: any): (boolean, string?)
	local site = BuildService.GetSite(uniqueId)
	if not site then
		return false, nil
	end
	if site.OwnerUserId ~= player.UserId then
		AntiExploitService.Flag(player, "DeleteForeignBuilding", 3)
		return false, "That isn't your building."
	end
	if deleteGuard then
		local allowed, reason = deleteGuard(player, site)
		if not allowed then
			return false, reason
		end
	end
	local entry = entryOf(site)
	local wasComplete = entry ~= nil and entry.State == "Complete"
	local share = if entry and entry.State == "Constructing" and entry.Progress == 0 then 1 else BuildingConfig.RefundPercent
	local def = site.Def

	local refundCoins = math.floor((def.Cost.Coins or 0) * share)
	if refundCoins > 0 then
		EconomyService.AddCoins(player, refundCoins, "BuildRefund")
	end
	for itemId, amount in def.Cost.Items do
		local refund = math.floor(amount * share)
		if refund > 0 then
			InventoryService.AddItem(player, itemId, refund, "BuildRefund", { IgnoreCapacity = true })
		end
	end
	if wasComplete and def.CapacityBonus then
		InventoryService.AddCapacity(player, -def.CapacityBonus)
	end

	local position = site.Model:GetPivot().Position
	despawnSite(site)
	DataService.Set(player, { "Island", "Buildings", uniqueId }, nil)
	VFXService.PlayAt("BuildDust", position + Vector3.new(0, 1, 0))
	Notify.Toast(player, ("Removed %s (refunded %s)."):format(def.DisplayName, if costText(def, share) ~= "" then costText(def, share) else "nothing"), "🗑️")
	BuildService.BuildingRemoved:Fire(player, uniqueId, site.BuildingId)
	return true, nil
end

function BuildService.Move(player: Player, uniqueId: any, localX: any, localZ: any, rotation: any): (boolean, string?)
	local site = BuildService.GetSite(uniqueId)
	if not site or not Validate.Number(localX, -2000, 2000) or not Validate.Number(localZ, -2000, 2000) then
		return false, nil
	end
	if site.OwnerUserId ~= player.UserId then
		AntiExploitService.Flag(player, "MoveForeignBuilding", 3)
		return false, "That isn't your building."
	end
	local ok, reason, worldCFrame, localPosition = BuildService.ValidatePlacement(player, site.Island, site.Def, localX, localZ, rotation, site.Model)
	if not ok or not worldCFrame or not localPosition then
		return false, reason
	end
	site.Model:PivotTo(worldCFrame)
	DataService.Set(player, { "Island", "Buildings", uniqueId, "Position" }, Serializer.Vector3(localPosition))
	DataService.Set(player, { "Island", "Buildings", uniqueId, "Rotation" }, rotation)
	VFXService.PlayAt("BuildDust", worldCFrame.Position + Vector3.new(0, 1, 0))
	GameSoundService.PlayAt("WoodPlace", worldCFrame.Position)
	BuildService.BuildingMoved:Fire(player, site)
	return true, nil
end

---------------------------------------------------------------------------
-- Admin / lifecycle
---------------------------------------------------------------------------

function BuildService.FinishAll(player: Player)
	for _, site in BuildService.GetSites(player) do
		local entry = entryOf(site)
		if entry and entry.State == "Constructing" then
			DataService.Set(player, { "Island", "Buildings", site.UniqueId, "Progress" }, site.Def.Steps)
			complete(player, site)
		end
	end
end

local function loadIsland(player: Player, island: any)
	local buildings = DataService.Get(player, { "Island", "Buildings" }) or {}
	for _, entry in buildings do
		local ok, err = pcall(spawnSite, island, entry)
		if not ok then
			warn("[BuildService] Could not load building " .. tostring(entry.UniqueId) .. ": " .. tostring(err))
		end
	end
end

local function clearIsland(islandId: string)
	local list = sitesByIsland[islandId]
	if not list then
		return
	end
	for uniqueId in list do
		sites[uniqueId] = nil
	end
	sitesByIsland[islandId] = nil
end

function BuildService.Init()
	InteractionService.RegisterKind("ConstructionSite", {
		ActionText = "Build",
		Permission = "Build",
		MaxDistance = 14,
		Cooldown = 0.2,
		Handler = function(player: Player, model: Instance)
			BuildService.Hammer(player, model:GetAttribute("UniqueId"), "Prompt")
		end,
	})

	Net.OnServerEvent("BuildRequest", function(player: Player, payload: any)
		if type(payload) ~= "table" then
			AntiExploitService.Flag(player, "BadBuildRequest", 2)
			return
		end
		if payload.Op == "Place" then
			local ok, reason = BuildService.Place(player, payload.BuildingId, payload.X, payload.Z, payload.Rotation)
			if not ok and reason then
				Notify.Error(player, reason)
			end
		elseif payload.Op == "Hammer" then
			BuildService.Hammer(player, payload.UniqueId, "Swing")
		end
	end)

	Net.OnServerEvent("DeleteBuildRequest", function(player: Player, uniqueId: any)
		local ok, reason = BuildService.Delete(player, uniqueId)
		if not ok and reason then
			Notify.Error(player, reason)
		end
	end)

	Net.OnServerEvent("MoveBuildRequest", function(player: Player, uniqueId: any, localX: any, localZ: any, rotation: any)
		local ok, reason = BuildService.Move(player, uniqueId, localX, localZ, rotation)
		if not ok and reason then
			Notify.Error(player, reason)
		end
	end)
end

function BuildService.Start()
	IslandService.IslandAssigned:Connect(loadIsland)
	IslandService.IslandReleased:Connect(function(_player: Player, islandId: string)
		clearIsland(islandId)
	end)
end

return BuildService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">CropService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CropService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/CropService
	DEPENDENCIES: Shared.Util.CropGrowth, Shared.Config.CropConfig, Server.Island.CropModels

	Crop growth + visuals. Growth is computed from saved timestamps
	(Shared/Util/CropGrowth), so it continues offline and nothing ticks per
	frame: one light loop every 2s checks registered planted tiles and only
	rebuilds a crop model when its STAGE changes.

	FarmService owns tiles and player actions; it registers tiles here and
	listens to StageChanged to refresh prompt text.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local CropConfig = require(Shared.Config.CropConfig)
local CropGrowth = require(Shared.Util.CropGrowth)
local Signal = require(Shared.Util.Signal)
local CropModels = require(script.Parent.Parent.Island.CropModels)

local TICK = 2

local SOIL = {
	Untilled = { Color = Color3.fromRGB(150, 118, 78), Material = Enum.Material.Ground },
	Tilled = { Color = Color3.fromRGB(98, 64, 40), Material = Enum.Material.Ground },
	Watered = { Color = Color3.fromRGB(66, 44, 28), Material = Enum.Material.Ground },
}

export type Tile = {
	Id: string,
	Part: BasePart,
	Entry: any?, -- saved Island.Crops[tileId] or nil (untilled)
	Stage: number,
	CropModel: Model?,
	IslandId: string,
}

local CropService = {}

CropService.StageChanged = Signal.new() -- (tile, stage)

local tiles: { [Tile]: boolean } = {}

local function setAttributes(tile: Tile)
	local entry = tile.Entry
	local part = tile.Part
	part:SetAttribute("TileState", if entry then entry.State else "Untilled")
	part:SetAttribute("CropId", if entry and entry.State == "Planted" then entry.CropId else nil)
	part:SetAttribute("PlantedAt", if entry and entry.State == "Planted" then entry.PlantedAt else nil)
	part:SetAttribute("WateredAt", if entry and entry.State == "Planted" then entry.WateredAt else nil)
	part:SetAttribute("Stage", tile.Stage)
end

-- Rebuilds soil colour + crop model for the tile's current entry.
function CropService.Refresh(tile: Tile)
	local entry = tile.Entry
	local soil = SOIL.Untilled
	if entry then
		soil = if entry.State == "Planted" and CropGrowth.IsWatered(entry) then SOIL.Watered else SOIL.Tilled
	end
	tile.Part.Color = soil.Color
	tile.Part.Material = soil.Material

	if tile.CropModel then
		tile.CropModel:Destroy()
		tile.CropModel = nil
	end
	if entry and entry.State == "Planted" then
		tile.Stage = CropGrowth.GetStage(entry, os.time())
		local top = tile.Part.CFrame * CFrame.new(0, tile.Part.Size.Y / 2, 0)
		local model = CropModels.Build(entry.CropId, tile.Stage, top)
		model.Parent = tile.Part
		tile.CropModel = model
	else
		tile.Stage = 0
	end
	setAttributes(tile)
end

function CropService.Register(tile: Tile)
	tiles[tile] = true
	CropService.Refresh(tile)
end

function CropService.Unregister(tile: Tile)
	tiles[tile] = nil
end

function CropService.UnregisterIsland(islandId: string)
	for tile in table.clone(tiles) do
		if tile.IslandId == islandId then
			tiles[tile] = nil
		end
	end
end

function CropService.IsReady(tile: Tile): boolean
	local entry = tile.Entry
	return entry ~= nil and entry.State == "Planted" and CropGrowth.GetStage(entry, os.time()) >= #CropConfig.Stages
end

function CropService.Start()
	task.spawn(function()
		while true do
			task.wait(TICK)
			local now = os.time()
			for tile in tiles do
				local entry = tile.Entry
				if entry and entry.State == "Planted" and tile.Part.Parent then
					local stage = CropGrowth.GetStage(entry, now)
					if stage ~= tile.Stage then
						CropService.Refresh(tile)
						CropService.StageChanged:Fire(tile, stage)
					end
				end
			end
		end
	end)
end

return CropService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  DataService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/DataService
	DEPENDENCIES: Shared.Net, Shared.Config.GameConfig, Shared.Util.{Signal,TableUtil},
	              Server.Data.DataSchema, Server.Data.MockDataStore
	REQUIRED OBJECTS: Game Settings > Security > "Enable Studio Access to API Services"
	              (optional; without it Studio uses the in-memory mock)

	THE ONLY system that reads/writes the DataStore and the ONLY writer of
	profile data. Other services mutate profiles through Set / Increment /
	Update so that every change is (1) marked dirty for autosave and
	(2) replicated to the owning client in batched StateSync packets.

	Safety guarantees (spec §97, §117, §147, §148):
	  * UpdateAsync only, with retries + exponential backoff.
	  * Session locking: a profile is owned by one server at a time. A save
	    that finds another server's lock is cancelled (never overwrites).
	  * A profile that failed to load is NEVER saved (no blank-overwrite).
	  * DataSchema.IsSaveable() gate before every write.
	  * Dirty-flag autosave, save on leave, BindToClose shutdown save.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Util.Signal)
local TableUtil = require(Shared.Util.TableUtil)

local ServerRoot = script.Parent.Parent
local DataSchema = require(ServerRoot.Data.DataSchema)
local MockDataStore = require(ServerRoot.Data.MockDataStore)

local DataConfig = GameConfig.Data
local SESSION_ID = HttpService:GenerateGUID(false)
local LOCK_REFRESH_INTERVAL = DataConfig.SessionLockTimeout / 4

type Path = { string }

type Profile = {
	Player: Player,
	Key: string,
	Data: any,
	Loaded: boolean,
	Dirty: boolean,
	Saving: boolean,
	Releasing: boolean,
	LockLost: boolean,
	ClientReady: boolean,
	PendingOps: { any },
	FlushScheduled: boolean,
	LastSave: number,
	LastSaveResult: string,
}

local DataService = {}

DataService.ProfileLoaded = Signal.new() -- (player, data)
DataService.ProfileReleasing = Signal.new() -- (player, data) last chance to write before the final save
DataService.Changed = Signal.new() -- (player, path, value)

local store: any = nil
local usingMock = false
local profiles: { [Player]: Profile } = {}
local readyBeforeProfile: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function log(...)
	if GameConfig.Debug then
		print("[DataService]", ...)
	end
end

local function keyFor(player: Player): string
	return DataConfig.KeyPrefix .. tostring(player.UserId)
end

local function newLock()
	return { Id = SESSION_ID, JobId = game.JobId, PlaceId = game.PlaceId, Time = os.time() }
end

local function resolveStore()
	local mode = DataConfig.UseMockDataStore
	if mode == true then
		store, usingMock = MockDataStore.new(), true
		warn("[DataService] UseMockDataStore = true — data will NOT persist")
		return
	end

	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, DataConfig.StoreName)
	if ok then
		store = result
	end

	if mode == "Auto" and RunService:IsStudio() then
		local probeOk, probeErr = false, "GetDataStore failed"
		if store then
			probeOk, probeErr = pcall(function()
				return store:GetAsync("__probe")
			end)
		end
		if not probeOk then
			warn("[DataService] DataStore unavailable in Studio (" .. tostring(probeErr) .. ").")
			warn("[DataService] Using an in-memory mock: progress lasts for this play session only.")
			warn("[DataService] Enable Game Settings > Security > Studio Access to API Services to test real saving.")
			store, usingMock = MockDataStore.new(), true
		end
	end

	if not store then
		warn("[DataService] Could not open DataStore:", result)
	end
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	if usingMock then
		return
	end
	local waited = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and waited < 10 do
		task.wait(0.5)
		waited += 0.5
	end
end

local function backoff(attempt: number)
	task.wait(DataConfig.RetryBaseDelay * 2 ^ (attempt - 1))
end

---------------------------------------------------------------------------
-- Replication
---------------------------------------------------------------------------

local function publicCopy(data: any): any
	local copy = {}
	for key, value in data do
		if not DataSchema.PrivateKeys[key] then
			copy[key] = TableUtil.DeepCopy(value)
		end
	end
	return copy
end

local function sendFull(profile: Profile)
	table.clear(profile.PendingOps)
	Net.FireClient("StateSync", profile.Player, { Full = publicCopy(profile.Data) })
end

local function queueOp(profile: Profile, path: Path, value: any)
	if not profile.ClientReady or DataSchema.PrivateKeys[path[1]] then
		return
	end
	table.insert(profile.PendingOps, { Path = table.clone(path), Value = TableUtil.DeepCopy(value) })
	if profile.FlushScheduled then
		return
	end
	profile.FlushScheduled = true
	task.defer(function()
		profile.FlushScheduled = false
		if #profile.PendingOps == 0 then
			return
		end
		local ops = profile.PendingOps
		profile.PendingOps = {}
		Net.FireClient("StateSync", profile.Player, { Ops = ops })
	end)
end

---------------------------------------------------------------------------
-- DataStore IO
---------------------------------------------------------------------------

-- Loads the record and takes the session lock. Returns the record or nil.
local function loadRecord(key: string): any
	local steal = DataConfig.StudioStealLocks and RunService:IsStudio()
	local errors, lockWaits = 0, 0

	while errors < DataConfig.LoadAttempts do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status = "Error"
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(old)
				local record = if type(old) == "table" then old else {}
				local lock = record.SessionLock
				local lockAlive = type(lock) == "table"
					and lock.Id ~= SESSION_ID
					and type(lock.Time) == "number"
					and os.time() - lock.Time < DataConfig.SessionLockTimeout
				if lockAlive and not steal then
					status = "Locked"
					return nil -- cancel: another server owns this profile
				end
				status = "OK"
				record.SessionLock = newLock()
				return record
			end)
		end)

		if ok and status == "OK" then
			return result
		elseif ok and status == "Locked" then
			lockWaits += 1
			log(("%s is locked by another server (wait %d/%d)"):format(key, lockWaits, DataConfig.LockRetries))
			if lockWaits >= DataConfig.LockRetries then
				warn("[DataService] Taking over stale session lock for " .. key)
				steal = true
			else
				task.wait(DataConfig.LockRetryDelay)
			end
		else
			errors += 1
			warn(("[DataService] Load attempt %d failed for %s: %s"):format(errors, key, tostring(result)))
			if errors < DataConfig.LoadAttempts then
				backoff(errors)
			end
		end
	end
	return nil
end

-- Releases our lock without touching Data (used when a player leaves mid-load).
local function releaseLockOnly(key: string)
	pcall(function()
		store:UpdateAsync(key, function(old)
			if type(old) ~= "table" or type(old.SessionLock) ~= "table" or old.SessionLock.Id ~= SESSION_ID then
				return nil
			end
			old.SessionLock = nil
			return old
		end)
	end)
end

local function saveProfile(profile: Profile, release: boolean): boolean
	if not profile.Loaded or profile.LockLost then
		return false
	end
	while profile.Saving do
		task.wait()
	end
	profile.Saving = true
	profile.Dirty = false -- changes made while we yield will mark it dirty again

	local snapshot = TableUtil.DeepCopy(profile.Data)
	snapshot.Meta.LastSavedAt = os.time()

	local saveable, reason = DataSchema.IsSaveable(snapshot)
	if not saveable then
		warn(("[DataService] Refusing to save %s: %s"):format(profile.Key, tostring(reason)))
		profile.Saving = false
		profile.LastSaveResult = "Refused: " .. tostring(reason)
		return false
	end

	local encodedOk, encoded = pcall(HttpService.JSONEncode, HttpService, snapshot)
	if encodedOk and #encoded > DataConfig.SizeWarningBytes then
		warn(("[DataService] %s is %d bytes — approaching the DataStore limit"):format(profile.Key, #encoded))
	end

	for attempt = 1, DataConfig.SaveAttempts do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local lostLock = false
		local ok, err = pcall(function()
			return store:UpdateAsync(profile.Key, function(old)
				local lock = if type(old) == "table" then old.SessionLock else nil
				if type(lock) ~= "table" or lock.Id ~= SESSION_ID then
					lostLock = true
					return nil -- another session owns (or released) this profile: never overwrite
				end
				return {
					Data = snapshot,
					SessionLock = if release then nil else newLock(),
					SavedAt = os.time(),
				}
			end)
		end)

		if ok then
			profile.Saving = false
			if lostLock then
				profile.LockLost = true
				profile.LastSaveResult = "LockLost"
				warn("[DataService] Session lock lost for " .. profile.Key .. " — this server will stop saving it")
				if profile.Player.Parent then
					profile.Player:Kick("Your island was opened in another server. Please rejoin.")
				end
				return false
			end
			profile.LastSave = os.clock()
			profile.LastSaveResult = if release then "Released" else "Saved"
			log(("Saved %s%s"):format(profile.Key, if release then " (released)" else ""))
			return true
		end

		warn(("[DataService] Save attempt %d failed for %s: %s"):format(attempt, profile.Key, tostring(err)))
		if attempt < DataConfig.SaveAttempts then
			backoff(attempt)
		end
	end

	profile.Saving = false
	profile.Dirty = true
	profile.LastSaveResult = "Failed"
	return false
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function DataService.Init()
	Net.OnServerEvent("ClientReady", function(player: Player)
		local profile = profiles[player]
		if not profile then
			readyBeforeProfile[player] = true
			return
		end
		profile.ClientReady = true
		if profile.Loaded then
			sendFull(profile)
		end
	end)
end

function DataService.Start()
	resolveStore()

	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveInterval)
			for _, profile in table.clone(profiles) do
				local lockStale = os.clock() - profile.LastSave > LOCK_REFRESH_INTERVAL
				if profile.Loaded and not profile.Releasing and not profile.Saving and (profile.Dirty or lockStale) then
					task.spawn(saveProfile, profile, false)
					task.wait(0.25) -- stagger writes
				end
			end
		end
	end)

	game:BindToClose(function()
		local deadline = os.clock() + DataConfig.ShutdownSaveTimeout
		for player in table.clone(profiles) do
			task.spawn(DataService.ReleaseProfile, player)
		end
		while next(profiles) ~= nil and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Yields. Returns the loaded data table, or nil if loading failed / player left.
function DataService.LoadProfile(player: Player): any
	local existing = profiles[player]
	if existing then
		return if existing.Loaded then existing.Data else nil
	end
	if not store then
		warn("[DataService] No DataStore available; cannot load " .. player.Name)
		if DataConfig.KickOnLoadFailure then
			player:Kick("Island data is unavailable right now. Please try again in a moment.")
		end
		return nil
	end

	local profile: Profile = {
		Player = player,
		Key = keyFor(player),
		Data = nil,
		Loaded = false,
		Dirty = false,
		Saving = false,
		Releasing = false,
		LockLost = false,
		ClientReady = readyBeforeProfile[player] == true,
		PendingOps = {},
		FlushScheduled = false,
		LastSave = os.clock(),
		LastSaveResult = "NotSaved",
	}
	profiles[player] = profile

	local record = loadRecord(profile.Key)

	if player.Parent == nil then
		-- Left while loading: give the lock back without writing anything.
		if record then
			releaseLockOnly(profile.Key)
		end
		profiles[player] = nil
		return nil
	end

	if not record then
		-- NEVER continue with a blank profile: it could be saved over real progress.
		profiles[player] = nil
		warn("[DataService] Failed to load data for " .. player.Name .. " after retries")
		if DataConfig.KickOnLoadFailure then
			player:Kick("We couldn't load your island safely. Your progress is safe — please rejoin in a minute.")
		end
		return nil
	end

	local data = DataSchema.Sanitize(record.Data)
	local now = os.time()
	if data.Meta.CreatedAt == 0 then
		data.Meta.CreatedAt = now
	end
	data.Meta.LastJoinAt = now
	data.Meta.JoinCount += 1

	profile.Data = data
	profile.Loaded = true
	profile.Dirty = true
	log(("Loaded %s (mock=%s)"):format(profile.Key, tostring(usingMock)))

	DataService.ProfileLoaded:Fire(player, data)
	if profile.ClientReady then
		sendFull(profile)
	end
	return data
end

-- Yields. Final save + lock release. Safe to call more than once.
function DataService.ReleaseProfile(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	if profile.Releasing then
		while profiles[player] == profile do
			task.wait(0.1)
		end
		return
	end
	profile.Releasing = true
	if profile.Loaded then
		DataService.ProfileReleasing:Fire(player, profile.Data)
		task.wait() -- let ProfileReleasing handlers write their final values
		saveProfile(profile, true)
	end
	profiles[player] = nil
end

function DataService.IsLoaded(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.Loaded
end

-- Read-only access. DO NOT mutate the returned table — use Set/Increment/Update.
function DataService.GetData(player: Player): any
	local profile = profiles[player]
	return if profile and profile.Loaded then profile.Data else nil
end

function DataService.Get(player: Player, path: Path): any
	local node = DataService.GetData(player)
	for _, key in path do
		if type(node) ~= "table" then
			return nil
		end
		node = node[key]
	end
	return node
end

function DataService.Set(player: Player, path: Path, value: any): boolean
	local profile = profiles[player]
	if not profile or not profile.Loaded or #path == 0 then
		return false
	end
	local parent = profile.Data
	for index = 1, #path - 1 do
		local child = parent[path[index]]
		if type(child) ~= "table" then
			error(("[DataService] Invalid path %s at '%s'"):format(table.concat(path, "."), path[index]), 2)
		end
		parent = child
	end
	parent[path[#path]] = value
	profile.Dirty = true
	queueOp(profile, path, value)
	DataService.Changed:Fire(player, path, value)
	return true
end

function DataService.Increment(player: Player, path: Path, delta: number): number?
	local current = DataService.Get(player, path)
	if type(current) ~= "number" then
		current = 0
	end
	local newValue = current + delta
	if DataService.Set(player, path, newValue) then
		return newValue
	end
	return nil
end

-- transform(oldValue) -> newValue. Handy for table edits:
-- DataService.Update(player, {"Island","UnlockedAreas"}, function(t) t.Forest = true return t end)
function DataService.Update(player: Player, path: Path, transform: (any) -> any): boolean
	local current = DataService.Get(player, path)
	return DataService.Set(player, path, transform(current))
end

-- Re-sends the full profile (e.g. after an admin reset).
function DataService.Resync(player: Player)
	local profile = profiles[player]
	if profile and profile.Loaded and profile.ClientReady then
		sendFull(profile)
	end
end

-- Studio/admin only: reset a profile to the template (the save still goes through the lock).
function DataService.ResetProfile(player: Player)
	local profile = profiles[player]
	if not profile or not profile.Loaded then
		return
	end
	profile.Data = DataSchema.Sanitize(nil)
	profile.Data.Meta.CreatedAt = os.time()
	profile.Dirty = true
	DataService.Resync(player)
end

function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

function DataService.GetDebugState(player: Player): { [string]: any }
	local profile = profiles[player]
	if not profile then
		return { Loaded = false }
	end
	return {
		Loaded = profile.Loaded,
		Dirty = profile.Dirty,
		Saving = profile.Saving,
		LockLost = profile.LockLost,
		LastSaveResult = profile.LastSaveResult,
		SecondsSinceSave = math.floor(os.clock() - profile.LastSave),
		Mock = usingMock,
		Session = SESSION_ID,
	}
end

Players.PlayerRemoving:Connect(function(player)
	readyBeforeProfile[player] = nil
end)

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  EconomyService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/EconomyService
	DEPENDENCIES: DataService, AntiExploitService, Shared.Config.EconomyConfig,
	              Shared.Util.Validate

	THE ONLY system that changes Coins or Gems (spec §165). Every change
	carries a `reason` string for logs/debugging. Amounts always come from
	server config — a client can never name an amount.

	Coin gain feedback (floating "+N", counter bounce, coin sound) is driven
	on the client by watching the replicated Coins value, so every source of
	income gets consistent feedback automatically.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.Config.EconomyConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Validate = require(Shared.Util.Validate)

local Services = script.Parent
local DataService = require(Services.DataService)
local AntiExploitService = require(Services.AntiExploitService)
local Notify = require(script.Parent.Parent.Util.Notify)

local EconomyService = {}

-- itemId -> bonus (0.25 = +25%). Replicated via ReplicatedStorage attributes
-- "MarketDemand" (JSON) and "MarketDemandEndsAt" so the Sell UI shows it.
local demand: { [string]: number } = {}

local function log(player: Player, currency: string, delta: number, reason: string)
	if GameConfig.Debug then
		print(("[Economy] %s %s%d %s (%s)"):format(player.Name, if delta >= 0 then "+" else "", delta, currency, reason))
	end
end

local function add(player: Player, currency: string, amount: number, reason: string): boolean
	local currencyDef = EconomyConfig.Currencies[currency]
	assert(currencyDef, "Unknown currency " .. currency)
	if not Validate.Integer(amount, 1, currencyDef.Max) then
		warn(("[Economy] Rejected invalid %s amount %s (%s)"):format(currency, tostring(amount), reason))
		return false
	end
	local current = DataService.Get(player, { currency })
	if type(current) ~= "number" then
		return false
	end
	local newValue = math.min(current + amount, currencyDef.Max)
	local gained = newValue - current
	if gained <= 0 then
		return false
	end
	DataService.Set(player, { currency }, newValue)
	if currency == "Coins" then
		DataService.Increment(player, { "Stats", "CoinsEarned" }, gained)
	end
	AntiExploitService.RecordCurrencyChange(player, currency, gained, reason)
	log(player, currency, gained, reason)
	return true
end

local function spend(player: Player, currency: string, amount: number, reason: string): boolean
	local currencyDef = EconomyConfig.Currencies[currency]
	assert(currencyDef, "Unknown currency " .. currency)
	if not Validate.Integer(amount, 0, currencyDef.Max) then
		warn(("[Economy] Rejected invalid spend %s (%s)"):format(tostring(amount), reason))
		return false
	end
	if amount == 0 then
		return true
	end
	local current = DataService.Get(player, { currency })
	if type(current) ~= "number" or current < amount then
		return false
	end
	DataService.Set(player, { currency }, current - amount)
	log(player, currency, -amount, reason)
	return true
end

function EconomyService.GetCoins(player: Player): number
	return DataService.Get(player, { "Coins" }) or 0
end

function EconomyService.GetGems(player: Player): number
	return DataService.Get(player, { "Gems" }) or 0
end

function EconomyService.CanAfford(player: Player, coins: number): boolean
	return EconomyService.GetCoins(player) >= coins
end

function EconomyService.AddCoins(player: Player, amount: number, reason: string): boolean
	return add(player, "Coins", amount, reason)
end

-- Returns false (and changes nothing) if the player can't afford it.
function EconomyService.SpendCoins(player: Player, amount: number, reason: string): boolean
	return spend(player, "Coins", amount, reason)
end

function EconomyService.AddGems(player: Player, amount: number, reason: string): boolean
	return add(player, "Gems", amount, reason)
end

function EconomyService.SpendGems(player: Player, amount: number, reason: string): boolean
	return spend(player, "Gems", amount, reason)
end

function EconomyService.GetDemandBonus(itemId: string): number
	return demand[itemId] or 0
end

-- The ONE sell-price formula: item SellValue x global multiplier x demand.
function EconomyService.GetSellPrice(itemId: string): number
	local def = ItemConfig.Get(itemId)
	if not def or def.SellValue <= 0 then
		return 0
	end
	local price = def.SellValue * EconomyConfig.GlobalSellMultiplier * (1 + EconomyService.GetDemandBonus(itemId))
	return math.max(1, math.floor(price))
end

local function rollDemand()
	local candidates = {}
	for itemId, def in ItemConfig.Items do
		if EconomyConfig.DemandCategories[def.Category] then
			table.insert(candidates, itemId)
		end
	end
	table.sort(candidates)
	table.clear(demand)
	local random = Random.new()
	local announced = {}
	local encoded = {}
	for _ = 1, math.min(EconomyConfig.DemandItemCount, #candidates) do
		local itemId = table.remove(candidates, random:NextInteger(1, #candidates))
		local bonus = math.floor(random:NextNumber(EconomyConfig.DemandBonus.Min, EconomyConfig.DemandBonus.Max) * 20 + 0.5) / 20
		demand[itemId] = bonus
		table.insert(encoded, { Item = itemId, Bonus = bonus })
		table.insert(announced, ("%s +%d%%"):format(ItemConfig.Items[itemId].DisplayName, math.floor(bonus * 100 + 0.5)))
	end
	ReplicatedStorage:SetAttribute("MarketDemand", HttpService:JSONEncode(encoded))
	ReplicatedStorage:SetAttribute("MarketDemandEndsAt", os.time() + EconomyConfig.DemandInterval)
	for _, player in Players:GetPlayers() do
		Notify.Toast(player, "Market demand: " .. table.concat(announced, ", "), "📈")
	end
end

function EconomyService.Start()
	rollDemand()
	task.spawn(function()
		while true do
			task.wait(EconomyConfig.DemandInterval)
			rollDemand()
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">FarmService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FarmService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/FarmService
	DEPENDENCIES: DataService, IslandService, CropService, InventoryService, ProgressionService,
	              InteractionService, ToolService, AnimationService, AntiExploitService,
	              SoundService, VFXService, Server.Island.IslandProps,
	              Shared.Config.{CropConfig, IslandConfig}, Shared.Util.{IslandContent, Serializer}

	Farm plots and tiles (spec §20-§23, §142). One prompt per tile whose text
	follows the tile's state:

		Untilled  -> "Till Soil"     (equips your hoe, TillGround @ Till marker)
		Tilled    -> "Plant Seeds"   (one seed type: plants it; several: opens the
		                              seed picker, which sends PlantCropRequest)
		Growing   -> "Water"         (equips watering can, WaterPlant @ Water marker)
		Watered   -> "Check Crop"    (shows time left)
		Ready     -> "Harvest Wheat" (HarvestCrop @ Pick marker -> produce + XP)

	Every change is validated here and saved to Island.Crops[tileId].
	Tiles unlocked: the starter plot uses Island.FarmTiles (shop upgrade);
	area plots (Sunny Fields) come fully unlocked.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local CropConfig = require(Shared.Config.CropConfig)
local IslandContent = require(Shared.Util.IslandContent)
local CropGrowth = require(Shared.Util.CropGrowth)
local Serializer = require(Shared.Util.Serializer)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local CropService = require(Services.CropService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local InteractionService = require(Services.InteractionService)
local ToolService = require(Services.ToolService)
local AnimationService = require(Services.AnimationService)
local AntiExploitService = require(Services.AntiExploitService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local IslandProps = require(script.Parent.Parent.Island.IslandProps)
local Notify = require(script.Parent.Parent.Util.Notify)

local TILE_TAG = "FarmTile"
local TILE_RANGE = 14
local PLOT_SIZE = Vector2.new(20, 16)

local FarmService = {}

FarmService.CropPlanted = Signal.new() -- (player, cropId)
FarmService.CropHarvested = Signal.new() -- (player, cropId, amount)

type IslandFarm = { Island: any, Owner: Player, Tiles: { [string]: any }, Plots: { [string]: boolean } }

local farms: { [string]: IslandFarm } = {} -- islandId -> farm
local random = Random.new()

local function tileAction(tile: any): (string, string)
	local entry = tile.Entry
	if not entry then
		return "Till Soil", "Farm Tile"
	end
	if entry.State == "Tilled" then
		return "Plant Seeds", "Tilled Soil"
	end
	local crop = CropConfig.Crops[entry.CropId]
	local name = if crop then crop.DisplayName else "Crop"
	if CropService.IsReady(tile) then
		return "Harvest " .. name, name
	end
	if not CropGrowth.IsWatered(entry) then
		return "Water", name
	end
	return "Check Crop", name
end

local function refreshPrompt(tile: any)
	local actionText, objectText = tileAction(tile)
	InteractionService.SetText(tile.Part, actionText, objectText)
end

local function setEntry(farm: IslandFarm, tile: any, entry: any)
	tile.Entry = entry
	DataService.Set(farm.Owner, { "Island", "Crops", tile.Id }, entry)
	CropService.Refresh(tile)
	refreshPrompt(tile)
end

local function createTile(farm: IslandFarm, tileId: string, localXZ: Vector2)
	if farm.Tiles[tileId] then
		return
	end
	local island = farm.Island
	local ground = IslandService.GetGroundCFrame(island, localXZ)
	local size = CropConfig.Farm.TileSize
	local part = Instance.new("Part")
	part.Name = "Tile_" .. tileId
	part.Anchored = true
	part.CanCollide = true
	part.Size = Vector3.new(size, 0.5, size)
	part.CFrame = ground * CFrame.new(0, 0.15, 0)
	part.TopSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("TileId", tileId)
	part:SetAttribute("OwnerUserId", island.OwnerUserId)
	part.Parent = island.Folders.Crops
	CollectionService:AddTag(part, TILE_TAG)

	local saved = DataService.Get(farm.Owner, { "Island", "Crops", tileId })
	local tile = {
		Id = tileId,
		Part = part,
		Entry = saved,
		Stage = 0,
		CropModel = nil,
		IslandId = island.Id,
		LocalPosition = localXZ,
	}
	farm.Tiles[tileId] = tile
	InteractionService.Attach(part, "FarmTile", { OwnerUserId = island.OwnerUserId, MaxDistance = 8 })
	CropService.Register(tile)
	refreshPrompt(tile)
end

-- Creates plot outlines + all unlocked tiles for the island.
function FarmService.RefreshFarm(player: Player)
	local island = IslandService.GetIsland(player)
	local farm = island and farms[island.Id]
	if not island or not farm then
		return
	end
	local unlocked = IslandService.GetUnlockedAreas(player)
	local starterTiles = DataService.Get(player, { "Island", "FarmTiles" }) or CropConfig.Farm.StarterTiles
	for _, plot in IslandContent.FarmPlots() do
		if unlocked[plot.AreaId] then
			if not farm.Plots[plot.Id] then
				farm.Plots[plot.Id] = true
				local outline = IslandProps.Plot("FarmPlot", PLOT_SIZE)
				outline.Name = "FarmPlot_" .. plot.Id
				outline:PivotTo(IslandService.GetGroundCFrame(island, plot.Center))
				outline.Parent = island.Folders.Landmarks
			end
			local positions = IslandContent.FarmTilePositions(plot.Center)
			local count = if plot.Id == "S" then math.min(starterTiles, #positions) else #positions
			for index = 1, count do
				createTile(farm, plot.Id .. index, positions[index])
			end
		end
	end
end

local function getTile(player: Player, tileId: any): (any?, IslandFarm?)
	if type(tileId) ~= "string" then
		return nil, nil
	end
	local island = IslandService.GetIsland(player)
	local farm = island and farms[island.Id]
	if not farm then
		return nil, nil
	end
	return farm.Tiles[tileId], farm
end

local function nearTile(player: Player, tile: any): boolean
	local root = R15.GetRootPart(player.Character)
	return root ~= nil and (root.Position - tile.Part.Position).Magnitude <= TILE_RANGE
end

local function ownedSeeds(player: Player): { string }
	local seeds = {}
	for _, cropId in CropConfig.Order do
		local seedId = CropConfig.Crops[cropId].Seed
		if InventoryService.GetCount(player, seedId) > 0 then
			table.insert(seeds, seedId)
		end
	end
	return seeds
end

local function plant(player: Player, farm: IslandFarm, tile: any, seedId: string)
	local cropId = CropConfig.SeedToCrop[seedId]
	if not cropId then
		return
	end
	AnimationService.PerformAction(player, "PlantSeed", "Plant", function()
		if not tile.Entry or tile.Entry.State ~= "Tilled" then
			return
		end
		if not InventoryService.RemoveItem(player, seedId, 1, "Plant") then
			Notify.Error(player, "You're out of those seeds.")
			return
		end
		setEntry(farm, tile, {
			TileId = tile.Id,
			State = "Planted",
			CropId = cropId,
			Position = Serializer.Vector3(Vector3.new(tile.LocalPosition.X, 0, tile.LocalPosition.Y)),
			PlantedAt = os.time(),
			WateredAt = 0,
		})
		VFXService.PlayAt("DirtPuff", tile.Part.Position + Vector3.new(0, 0.5, 0))
		ProgressionService.Award(player, "PlantCrop")
		FarmService.CropPlanted:Fire(player, cropId)
	end)
end

local function onTileUsed(player: Player, farm: IslandFarm, tile: any)
	local entry = tile.Entry
	if not entry then
		-- Till
		local hoe = ToolService.EquipBestOfType(player, "Hoe")
		if not hoe then
			Notify.Error(player, "You need a Hoe to till soil.")
			return
		end
		AnimationService.PerformAction(player, hoe.Animations.Use or "HoeTill", "Till", function()
			if tile.Entry == nil then
				setEntry(farm, tile, { TileId = tile.Id, State = "Tilled", Position = Serializer.Vector3(Vector3.new(tile.LocalPosition.X, 0, tile.LocalPosition.Y)) })
				VFXService.PlayAt("DirtPuff", tile.Part.Position + Vector3.new(0, 0.5, 0))
			end
		end, { Speed = hoe.Speed })
		return
	end

	if entry.State == "Tilled" then
		local seeds = ownedSeeds(player)
		if #seeds == 0 then
			Notify.Error(player, "You have no seeds — buy some at the market stall!")
		elseif #seeds == 1 then
			plant(player, farm, tile, seeds[1])
		else
			local options = {}
			for _, seedId in seeds do
				table.insert(options, { Seed = seedId, Count = InventoryService.GetCount(player, seedId) })
			end
			Net.FireClient("OpenUI", player, { Screen = "SeedPicker", TileId = tile.Id, Seeds = options })
		end
		return
	end

	local crop = CropConfig.Crops[entry.CropId]
	if CropService.IsReady(tile) then
		AnimationService.PerformAction(player, "HarvestCrop", "Pick", function()
			if not CropService.IsReady(tile) then
				return
			end
			local amount = random:NextInteger(crop.Yield.Min, crop.Yield.Max)
			local added = InventoryService.AddItem(player, entry.CropId, amount, "Harvest")
			if added <= 0 then
				return -- backpack full: keep the crop in the ground
			end
			setEntry(farm, tile, { TileId = tile.Id, State = "Tilled", Position = entry.Position })
			GameSoundService.PlayAt("Harvest", tile.Part.Position)
			VFXService.PlayAt("LeafBurst", tile.Part.Position + Vector3.new(0, 1, 0))
			DataService.Increment(player, { "Stats", "CropsHarvested" }, added)
			ProgressionService.Award(player, "HarvestCrop")
			FarmService.CropHarvested:Fire(player, entry.CropId, added)
		end)
		return
	end

	if not CropGrowth.IsWatered(entry) then
		local can = ToolService.EquipBestOfType(player, "WateringCan")
		if not can then
			Notify.Error(player, "You need a Watering Can.")
			return
		end
		AnimationService.PerformAction(player, "WaterPlant", "Water", function()
			if tile.Entry and tile.Entry.State == "Planted" and not CropGrowth.IsWatered(tile.Entry) then
				local watered = table.clone(tile.Entry)
				watered.WateredAt = os.time()
				setEntry(farm, tile, watered)
				Notify.Toast(player, ("%s watered! It grows %d%% faster now."):format(crop.DisplayName, math.floor((CropConfig.WaterSpeedMultiplier - 1) * 100)), "💧")
			end
		end)
		return
	end

	local remaining = CropGrowth.GetRemaining(entry, os.time())
	local stageName = CropConfig.Stages[CropGrowth.GetStage(entry, os.time())]
	Notify.Toast(player, ("%s · %s · ready in %s 💧"):format(crop.DisplayName, stageName, Format.Duration(remaining)), crop.Icon)
end

-- Seed picker result.
local function onPlantRequest(player: Player, tileId: any, seedId: any)
	if not Validate.Id(tileId) or not Validate.Id(seedId) then
		AntiExploitService.Flag(player, "BadPlantRequest", 2)
		return
	end
	local tile, farm = getTile(player, tileId)
	if not tile or not farm then
		return
	end
	if not nearTile(player, tile) then
		AntiExploitService.Flag(player, "PlantTooFar", 1)
		return
	end
	if not tile.Entry or tile.Entry.State ~= "Tilled" then
		return
	end
	if not CropConfig.SeedToCrop[seedId] or InventoryService.GetCount(player, seedId) < 1 then
		Notify.Error(player, "You don't have those seeds.")
		return
	end
	plant(player, farm, tile, seedId)
end

-- Admin/testing: finish every crop on the player's island.
function FarmService.GrowAll(player: Player)
	local island = IslandService.GetIsland(player)
	local farm = island and farms[island.Id]
	if not farm then
		return
	end
	for _, tile in farm.Tiles do
		local entry = tile.Entry
		if entry and entry.State == "Planted" then
			local crop = CropConfig.Crops[entry.CropId]
			local grown = table.clone(entry)
			grown.PlantedAt = os.time() - crop.GrowTime - 1
			grown.WateredAt = 0
			setEntry(farm, tile, grown)
		end
	end
end

function FarmService.Init()
	InteractionService.RegisterKind("FarmTile", {
		ActionText = "Till Soil",
		ObjectText = "Farm Tile",
		Permission = "Farm",
		MaxDistance = 8,
		Cooldown = 0.3,
		Handler = function(player: Player, part: Instance)
			local tile, farm = getTile(player, part:GetAttribute("TileId"))
			if tile and farm and tile.Part == part then
				onTileUsed(player, farm, tile)
			end
		end,
	})
	Net.OnServerEvent("PlantCropRequest", onPlantRequest)
end

function FarmService.Start()
	CropService.StageChanged:Connect(function(tile: any)
		refreshPrompt(tile)
	end)

	IslandService.IslandAssigned:Connect(function(player: Player, island: any)
		farms[island.Id] = { Island = island, Owner = player, Tiles = {}, Plots = {} }
		FarmService.RefreshFarm(player)
	end)
	IslandService.AreaUnlocked:Connect(function(player: Player)
		FarmService.RefreshFarm(player)
	end)
	IslandService.IslandReleased:Connect(function(_player: Player, islandId: string)
		farms[islandId] = nil
		CropService.UnregisterIsland(islandId)
	end)
end

return FarmService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">FishingService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FishingService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/FishingService
	DEPENDENCIES: DataService, IslandService, ToolService, InventoryService, ProgressionService,
	              AnimationService, InteractionService, AntiExploitService, SoundService, VFXService,
	              Server.Island.IslandProps, Shared.Net, Shared.Config.{FishConfig, RarityConfig},
	              Shared.Util.IslandContent

	Skill-based, server-authoritative fishing (spec §29-§32, §61, §143):

	  Cast   FishingRequest{Op="Cast"} or the spot's "[E] Fish" prompt.
	         Server checks: rod owned (auto-equips it), near a fishing spot,
	         not already fishing, cooldown. It rolls the fish NOW (weighted by
	         zone + rarity + rod luck) and a bite time — the client never knows
	         which fish it is.
	  Bite   at the bite time the server sends FishingEvent{Op="Bite"}. The
	         player has HookWindow seconds to press USE (FishingRequest Hook).
	  Reel   the client plays the reel minigame; the server only reveals the
	         rarity. The client reports Success/Fail; a success faster than
	         FishConfig.MinReelTime(difficulty) is rejected as impossible.
	  Catch  the server grants the fish, records the collection + stats, XP.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local FishConfig = require(Shared.Config.FishConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local IslandContent = require(Shared.Util.IslandContent)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local ToolService = require(Services.ToolService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local AnimationService = require(Services.AnimationService)
local InteractionService = require(Services.InteractionService)
local AntiExploitService = require(Services.AntiExploitService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local IslandProps = require(script.Parent.Parent.Island.IslandProps)
local Notify = require(script.Parent.Parent.Util.Notify)

local HOOK_LATENCY = 0.4 -- network grace on top of the hook window
local LEASH = 26 -- walking this far from the spot cancels fishing

type Spot = { Id: string, Zone: string, Position: Vector3, Model: Model, IslandId: string }
type Session = {
	Stage: string, -- "Waiting" | "Bite" | "Reeling"
	FishId: string,
	Spot: Spot,
	Rod: any,
	BiteAt: number,
	HookDeadline: number,
	ReelStartedAt: number,
	Token: number,
}

local FishingService = {}

FishingService.FishCaught = Signal.new() -- (player, fishId, rarity, weight)

local spotsByIsland: { [string]: { Spot } } = {}
local sessions: { [Player]: Session } = {}
local lastCast: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local tokenCounter = 0
local random = Random.new()

local function send(player: Player, payload: { [string]: any })
	Net.FireClient("FishingEvent", player, payload)
end

local function nearestSpot(player: Player): Spot?
	local root = R15.GetRootPart(player.Character)
	if not root then
		return nil
	end
	local best, bestDistance = nil, FishConfig.SpotRange
	for _, spots in spotsByIsland do
		for _, spot in spots do
			local island = IslandService.GetIslandById(spot.IslandId)
			if island and IslandService.CanAccess(player, island, "Fish") then
				local distance = (root.Position - spot.Position).Magnitude
				if distance <= bestDistance then
					best, bestDistance = spot, distance
				end
			end
		end
	end
	return best
end

local function rollFish(zone: string, rod: any): string?
	local zoneDef = FishConfig.Zones[zone]
	if not zoneDef then
		return nil
	end
	local luck = 1 + (rod.TierOrder - 1) * FishConfig.RodLuckPerTier
	local total = 0
	local weights = {}
	for _, fishId in zoneDef.Fish do
		local fish = FishConfig.Fish[fishId]
		local rank = RarityConfig.Get(fish.Rarity).Rank
		local weight = (FishConfig.RarityWeights[fish.Rarity] or 1) * luck ^ (rank - 1)
		weights[fishId] = weight
		total += weight
	end
	local roll = random:NextNumber(0, total)
	for _, fishId in zoneDef.Fish do
		roll -= weights[fishId]
		if roll <= 0 then
			return fishId
		end
	end
	return zoneDef.Fish[1]
end

local function endSession(player: Player, reason: string?, animation: string?)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	local character = player.Character
	if character then
		AnimationService.StopAnimation(character, "FishingWait")
		AnimationService.StopAnimation(character, "FishingReel")
		if animation then
			AnimationService.PlayAnimation(character, animation)
		end
	end
	if reason then
		send(player, { Op = "End", Reason = reason })
	end
end

local function stillValid(player: Player, session: Session): boolean
	if sessions[player] ~= session or not player.Parent then
		return false
	end
	local root = R15.GetRootPart(player.Character)
	if not root or (root.Position - session.Spot.Position).Magnitude > LEASH then
		endSession(player, "You walked away from the water.")
		return false
	end
	local equipped = ToolService.GetEquipped(player)
	if not equipped or equipped.Type ~= "FishingRod" then
		endSession(player, "You put your rod away.")
		return false
	end
	return true
end

function FishingService.Cast(player: Player)
	if sessions[player] then
		return
	end
	local now = os.clock()
	if lastCast[player] and now - lastCast[player] < FishConfig.CastCooldown then
		return
	end
	local spot = nearestSpot(player)
	if not spot then
		Notify.Error(player, "Find a 🎣 fishing spot first (try the end of your dock).")
		return
	end
	local rod = ToolService.EquipBestOfType(player, "FishingRod")
	if not rod then
		Notify.Error(player, "You need a Fishing Rod.")
		return
	end
	local fishId = rollFish(spot.Zone, rod)
	if not fishId then
		return
	end
	lastCast[player] = now

	tokenCounter += 1
	local delayRange = FishConfig.BiteDelay
	local biteDelay = random:NextNumber(delayRange.Min, delayRange.Max) / (1 + (rod.TierOrder - 1) * 0.15)
	local session: Session = {
		Stage = "Waiting",
		FishId = fishId,
		Spot = spot,
		Rod = rod,
		BiteAt = now + biteDelay,
		HookDeadline = 0,
		ReelStartedAt = 0,
		Token = tokenCounter,
	}
	sessions[player] = session

	local character = player.Character
	AnimationService.PerformAction(player, "FishingCast", "Cast", function()
		if sessions[player] == session and character then
			AnimationService.PlayAnimation(character, "FishingWait")
		end
	end, { Speed = rod.Speed })
	send(player, { Op = "Cast", Spot = spot.Position, Zone = spot.Zone })

	task.delay(biteDelay, function()
		if not stillValid(player, session) or session.Stage ~= "Waiting" then
			return
		end
		session.Stage = "Bite"
		session.HookDeadline = os.clock() + FishConfig.HookWindow + HOOK_LATENCY
		if character then
			AnimationService.PlayAnimation(character, "FishingBite")
		end
		GameSoundService.PlayAt("FishBite", spot.Position)
		send(player, { Op = "Bite", Window = FishConfig.HookWindow })
		task.delay(FishConfig.HookWindow + HOOK_LATENCY + 0.1, function()
			if sessions[player] == session and session.Stage == "Bite" then
				GameSoundService.PlayFor(player, "FishEscape")
				endSession(player, "Too slow — the fish got away!", "FishingFail")
			end
		end)
	end)
end

local function hook(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	if session.Stage == "Waiting" then
		-- Pulled too early: the fish is scared off.
		endSession(player, "Too early! Wait for the bite (!) before reeling.", "FishingFail")
		return
	end
	if session.Stage ~= "Bite" or not stillValid(player, session) then
		return
	end
	if os.clock() > session.HookDeadline then
		endSession(player, "Too slow — the fish got away!", "FishingFail")
		return
	end
	local fish = FishConfig.Fish[session.FishId]
	session.Stage = "Reeling"
	session.ReelStartedAt = os.clock()
	local character = player.Character
	if character then
		AnimationService.PlayAnimation(character, "FishingReel")
	end
	-- Only the rarity and difficulty are revealed — never the fish itself.
	local difficulty = math.max(1, fish.Difficulty - (session.Rod.TierOrder - 1) * 0.25)
	send(player, { Op = "Reel", Rarity = fish.Rarity, Difficulty = difficulty, Token = session.Token })

	task.delay(FishConfig.MaxReelTime, function()
		if sessions[player] == session and session.Stage == "Reeling" then
			endSession(player, "The line went slack...", "FishingFail")
		end
	end)
end

local function finishReel(player: Player, success: boolean, token: any)
	local session = sessions[player]
	if not session or session.Stage ~= "Reeling" or token ~= session.Token then
		return
	end
	if not stillValid(player, session) then
		return
	end
	if not success then
		GameSoundService.PlayFor(player, "FishEscape")
		endSession(player, "It got away! Keep the fish inside the zone.", "FishingFail")
		return
	end
	local fish = FishConfig.Fish[session.FishId]
	local difficulty = math.max(1, fish.Difficulty - (session.Rod.TierOrder - 1) * 0.25)
	local elapsed = os.clock() - session.ReelStartedAt
	if elapsed < FishConfig.MinReelTime(difficulty) then
		AntiExploitService.Flag(player, "ImpossibleReel", 4)
		endSession(player, "The fish slipped off the hook.", "FishingFail")
		return
	end

	sessions[player] = nil
	local character = player.Character
	if character then
		AnimationService.StopAnimation(character, "FishingReel")
		AnimationService.StopAnimation(character, "FishingWait")
	end
	local added = InventoryService.AddItem(player, session.FishId, 1, "Fishing")
	if added <= 0 then
		send(player, { Op = "End", Reason = "Your backpack is full — sell some items first." })
		return
	end
	local weight = math.floor(random:NextNumber(fish.Weight[1], fish.Weight[2]) * 10 + 0.5) / 10
	local rarity = RarityConfig.Get(fish.Rarity)
	local collection = DataService.Get(player, { "Collection", "Fish", session.FishId })
	local isNew = collection == nil
	local best = if type(collection) == "table" then math.max(collection.BestWeight or 0, weight) else weight
	local count = if type(collection) == "table" then (collection.Count or 0) + 1 else 1
	DataService.Set(player, { "Collection", "Fish", session.FishId }, { Count = count, BestWeight = best })
	DataService.Increment(player, { "Stats", "FishCaught" }, 1)
	if rarity.Rank >= 3 then
		DataService.Increment(player, { "Stats", "RareItemsFound" }, 1)
	end

	if character then
		AnimationService.PlayAnimation(character, if rarity.Rank >= 4 then "FishingCelebrate" else "FishingCatch")
	end
	VFXService.PlayAt("WaterSplash", session.Spot.Position + Vector3.new(0, 1, 0))
	if rarity.Rank >= 3 then
		VFXService.PlayAt("Sparkle", session.Spot.Position + Vector3.new(0, 3, 0))
	end
	GameSoundService.PlayFor(player, if rarity.Rank >= 4 then "RareReward" else "FishCatch")
	ProgressionService.Award(player, "CatchFish", rarity.Rank)
	send(player, { Op = "Caught", FishId = session.FishId, Weight = weight, New = isNew })
	FishingService.FishCaught:Fire(player, session.FishId, fish.Rarity, weight)
end

local function spawnSpots(player: Player, island: any)
	local unlocked = IslandService.GetUnlockedAreas(player)
	local list = spotsByIsland[island.Id]
	if not list then
		list = {}
		spotsByIsland[island.Id] = list
	end
	for _, spotDef in IslandContent.FishingSpots() do
		local already = false
		for _, existing in list do
			if existing.Id == spotDef.Id then
				already = true
				break
			end
		end
		if unlocked[spotDef.AreaId] and not already then
			local worldCFrame = if spotDef.OnDock
				then island.Origin * CFrame.new(spotDef.Position.X, 2.4, spotDef.Position.Y)
				else IslandService.GetGroundCFrame(island, spotDef.Position)
			local zone = FishConfig.Zones[spotDef.Zone]
			local model = IslandProps.FishingSpot(if zone then zone.DisplayName else spotDef.Zone)
			model:PivotTo(worldCFrame)
			model:SetAttribute("FishingZone", spotDef.Zone)
			model:SetAttribute("OwnerUserId", island.OwnerUserId)
			model.Parent = island.Folders.FishingSpots
			local spot: Spot = { Id = spotDef.Id, Zone = spotDef.Zone, Position = worldCFrame.Position, Model = model, IslandId = island.Id }
			table.insert(list, spot)
			InteractionService.Attach(model, "FishingSpot", { ObjectText = if zone then zone.DisplayName else "Fishing Spot", OwnerUserId = island.OwnerUserId })
		end
	end
end

function FishingService.IsFishing(player: Player): boolean
	return sessions[player] ~= nil
end

function FishingService.Init()
	InteractionService.RegisterKind("FishingSpot", {
		ActionText = "Fish",
		ObjectText = "Fishing Spot",
		Permission = "Fish",
		MaxDistance = 10,
		Cooldown = 0.5,
		Handler = function(player: Player)
			FishingService.Cast(player)
		end,
	})

	Net.OnServerEvent("FishingRequest", function(player: Player, payload: any)
		if type(payload) ~= "table" then
			AntiExploitService.Flag(player, "BadFishingRequest", 2)
			return
		end
		if payload.Op == "Cast" then
			FishingService.Cast(player)
		elseif payload.Op == "Hook" then
			hook(player)
		elseif payload.Op == "Reel" then
			finishReel(player, payload.Success == true, payload.Token)
		elseif payload.Op == "Cancel" then
			endSession(player, nil)
		end
	end)
end

function FishingService.Start()
	IslandService.IslandAssigned:Connect(spawnSpots)
	IslandService.AreaUnlocked:Connect(function(player: Player)
		local island = IslandService.GetIsland(player)
		if island then
			spawnSpots(player, island)
		end
	end)
	IslandService.IslandReleased:Connect(function(_player: Player, islandId: string)
		spotsByIsland[islandId] = nil
	end)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return FishingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">GatherService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  GatherService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/GatherService
	DEPENDENCIES: ResourceService, IslandService, ToolService, InventoryService, ProgressionService,
	              AnimationService, InteractionService, AntiExploitService, SoundService, VFXService,
	              Shared.Net, Shared.Config.{ToolConfig, AnimationConfig, ResourceConfig}

	Server-authoritative gathering (spec §15-§17, §103). Two ways to hit a node:
	  1. PROMPT  "[E] Chop Oak Tree": the server equips your best axe, plays the
	     swing on your client and applies the hit at the animation's Hit marker.
	  2. SWING   click with a tool equipped: your client plays the swing and, at
	     the Hit marker, sends GatherRequest(nodeId). The server re-checks
	     everything (owner, distance, tool type/tier, swing cooldown).
	The client never says how much it gathered — damage and drops come from
	ToolConfig / ResourceConfig on the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local ToolConfig = require(Shared.Config.ToolConfig)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local R15 = require(Shared.Util.R15)
local Validate = require(Shared.Util.Validate)

local Services = script.Parent
local ResourceService = require(Services.ResourceService)
local IslandService = require(Services.IslandService)
local ToolService = require(Services.ToolService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local AnimationService = require(Services.AnimationService)
local InteractionService = require(Services.InteractionService)
local AntiExploitService = require(Services.AntiExploitService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local Notify = require(script.Parent.Parent.Util.Notify)

local SWING_RANGE = 13
local PROMPT_RANGE = 16

local GatherService = {}

local lastHit: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any
local random = Random.new()

local function firstMarker(animationName: string?): string?
	local def = animationName and AnimationConfig.Get(animationName)
	if not def then
		return nil
	end
	for markerName in def.Markers do
		return markerName
	end
	return nil
end

local function tierName(order: number): string
	for tierId, tier in ToolConfig.Tiers do
		if tier.Order == order then
			return tierId
		end
	end
	return "better"
end

local function inRange(player: Player, node: any, range: number): boolean
	local root = R15.GetRootPart(player.Character)
	if not root then
		return false
	end
	local offset = root.Position - ResourceService.GetPosition(node)
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= range
end

-- Applies one hit and hands out drops if the node breaks.
local function applyHit(player: Player, node: any, tool: any)
	if node.Depleted or not player.Parent then
		return
	end
	local def = node.Def
	local position = ResourceService.GetPosition(node)
	local damage = if tool then tool.Power * def.DamagePerPower else def.Health
	if def.HitSound then
		GameSoundService.PlayAt(def.HitSound, position)
	end
	if def.HitVFX then
		VFXService.PlayAt(def.HitVFX, position + Vector3.new(0, 2, 0))
	end
	if def.Shake then
		VFXService.ShakeCamera(player, def.Shake, 0.2)
	end

	local root = R15.GetRootPart(player.Character)
	local broke = ResourceService.Damage(node, damage, root and root.Position)
	if not broke then
		return
	end

	local amount = random:NextInteger(def.Drops.Min, def.Drops.Max)
	if tool and tool.ResourceBonus > 0 and random:NextNumber() < tool.ResourceBonus then
		amount += 1
	end
	InventoryService.AddItem(player, def.Resource, amount, "Gather:" .. node.Type)
	ProgressionService.Award(player, def.XPSource)
end

-- Validates and performs a gather attempt. source = "Prompt" | "Swing".
function GatherService.TryGather(player: Player, node: any, source: string)
	if node.Depleted then
		return
	end
	local island = IslandService.GetIslandById(node.IslandId)
	if not island or not IslandService.CanAccess(player, island, "Gather") then
		AntiExploitService.Flag(player, "GatherForeignNode", 1)
		return
	end
	if not inRange(player, node, if source == "Prompt" then PROMPT_RANGE else SWING_RANGE) then
		AntiExploitService.Flag(player, "GatherTooFar", 1)
		return
	end

	local def = node.Def
	local tool = nil
	if def.ToolType then
		tool = if source == "Prompt" then ToolService.EquipBestOfType(player, def.ToolType) else ToolService.GetEquipped(player)
		if not tool or tool.Type ~= def.ToolType then
			local owned = ToolService.GetBestTool(player, def.ToolType)
			Notify.Error(player, if owned then ("Equip your %s to do that."):format(def.ToolType) else ("You need a %s — buy one at the market."):format(def.ToolType))
			return
		end
		if tool.TierOrder < def.MinTier then
			Notify.Error(player, ("%s needs a %s %s or better."):format(def.DisplayName, tierName(def.MinTier), def.ToolType))
			return
		end
	end

	-- Swing-speed limit shared by both paths.
	local now = os.clock()
	local interval = if tool then tool.UseCooldown * 0.75 else 0.5
	if lastHit[player] and now - lastHit[player] < interval then
		return
	end
	lastHit[player] = now

	if source == "Swing" then
		applyHit(player, node, tool)
		return
	end

	local animationName = if tool then tool.Animations.Use else def.Animation
	local markerName = if tool then firstMarker(animationName) else def.Marker
	AnimationService.PerformAction(player, animationName or "PickCrop", markerName, function()
		applyHit(player, node, tool)
	end, { Speed = if tool then tool.Speed else 1 })
end

function GatherService.Init()
	InteractionService.RegisterKind("ResourceNode", {
		ActionText = "Gather",
		Permission = "Gather",
		MaxDistance = 11,
		Cooldown = 0.2,
		Handler = function(player: Player, model: Instance)
			local node = ResourceService.GetNodeFromModel(model)
			if node then
				GatherService.TryGather(player, node, "Prompt")
			end
		end,
	})

	Net.OnServerEvent("GatherRequest", function(player: Player, nodeId: any)
		if not Validate.String(nodeId, 120) then
			AntiExploitService.Flag(player, "BadGatherRequest", 2)
			return
		end
		local node = ResourceService.GetNode(nodeId)
		if not node then
			return
		end
		GatherService.TryGather(player, node, "Swing")
	end)
end

return GatherService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InteractionService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/InteractionService
	DEPENDENCIES: AntiExploitService, Shared.Util.{R15, RateLimiter}, Server.Util.Notify

	ONE reusable interaction system for trees, rocks, crops, animals, shops,
	chests, signs... (spec §49/§50). Built on ProximityPrompt, which gives:
	  * "[E] Chop Tree" on keyboard, a tap button on mobile, gamepad support,
	  * a server-side Triggered event (the client cannot fake distance).

	Each interactable has a KIND registered once by the owning service:

		InteractionService.RegisterKind("StarterChest", {
			ActionText = "Open",
			ObjectText = "Starter Chest",
			Permission = "Owner",      -- "Owner" | "Visitor" | any island permission key
			HoldDuration = 0,
			MaxDistance = 10,
			Cooldown = 0.5,
			Handler = function(player, object, prompt) ... end,
		})
		InteractionService.Attach(chestModel, "StarterChest", { OwnerUserId = 123 })

	Server checks on every trigger: rate limit, object still registered, player
	alive, distance, per-player cooldown, island permission (via the resolver
	IslandService installs), then the handler runs inside pcall.

	Prompts with Permission "Owner" are tagged "OwnerOnlyPrompt" so the client
	hides them from visitors (cosmetic only — the server still validates).
]]

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local R15 = require(Shared.Util.R15)
local RateLimiter = require(Shared.Util.RateLimiter)

local Services = script.Parent
local AntiExploitService = require(Services.AntiExploitService)
local Notify = require(script.Parent.Parent.Util.Notify)

export type KindDef = {
	ActionText: string,
	ObjectText: string?,
	Permission: string?,
	HoldDuration: number?,
	MaxDistance: number?,
	Cooldown: number?,
	Handler: (player: Player, object: Instance, prompt: ProximityPrompt) -> (),
}

type Entry = {
	Object: Instance,
	Kind: string,
	Prompt: ProximityPrompt,
	Permission: string,
	OwnerUserId: number?,
	Cooldown: number,
	LastUse: { [Player]: number },
}

local DISTANCE_TOLERANCE = 6
local OWNER_ONLY_TAG = "OwnerOnlyPrompt"

local InteractionService = {}

local kinds: { [string]: KindDef } = {}
local entriesByPrompt: { [ProximityPrompt]: Entry } = {}
local entriesByObject: { [Instance]: Entry } = {}
local limiter = RateLimiter.new(6, 10)

-- (player, object, permission, ownerUserId) -> boolean. Installed by IslandService.
local accessResolver: ((Player, Instance, string, number?) -> boolean)? = nil

function InteractionService.SetAccessResolver(resolver: (Player, Instance, string, number?) -> boolean)
	accessResolver = resolver
end

function InteractionService.RegisterKind(kind: string, def: KindDef)
	assert(kinds[kind] == nil, "Interaction kind already registered: " .. kind)
	assert(type(def.Handler) == "function", "Interaction kind needs a Handler: " .. kind)
	kinds[kind] = def
end

local function getPromptParent(object: Instance): Instance?
	if object:IsA("BasePart") or object:IsA("Attachment") then
		return object
	end
	if object:IsA("Model") then
		local anchor = object:FindFirstChild("PromptAnchor", true)
		if anchor and (anchor:IsA("Attachment") or anchor:IsA("BasePart")) then
			return anchor
		end
		return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function getWorldPosition(instance: Instance): Vector3?
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	elseif instance:IsA("BasePart") then
		return instance.Position
	end
	return nil
end

function InteractionService.Attach(object: Instance, kind: string, overrides: { [string]: any }?): ProximityPrompt?
	local def = kinds[kind]
	assert(def, "Unknown interaction kind: " .. kind)
	InteractionService.Detach(object)

	local parent = getPromptParent(object)
	if not parent then
		warn("[Interaction] No part to attach prompt to on " .. object:GetFullName())
		return nil
	end
	local options = overrides or {}

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "InteractPrompt"
	prompt.ActionText = options.ActionText or def.ActionText
	prompt.ObjectText = options.ObjectText or def.ObjectText or ""
	prompt.HoldDuration = options.HoldDuration or def.HoldDuration or 0
	prompt.MaxActivationDistance = options.MaxDistance or def.MaxDistance or 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = options.KeyboardKeyCode or Enum.KeyCode.E
	prompt.GamepadKeyCode = options.GamepadKeyCode or Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt:SetAttribute("InteractKind", kind)

	local permission = options.Permission or def.Permission or "Owner"
	local ownerUserId = options.OwnerUserId
	if ownerUserId then
		prompt:SetAttribute("OwnerUserId", ownerUserId)
	end
	if permission == "Owner" then
		CollectionService:AddTag(prompt, OWNER_ONLY_TAG)
	end
	prompt.Parent = parent

	local entry: Entry = {
		Object = object,
		Kind = kind,
		Prompt = prompt,
		Permission = permission,
		OwnerUserId = ownerUserId,
		Cooldown = options.Cooldown or def.Cooldown or 0.4,
		LastUse = setmetatable({}, { __mode = "k" }) :: any,
	}
	entriesByPrompt[prompt] = entry
	entriesByObject[object] = entry

	object.Destroying:Once(function()
		InteractionService.Detach(object)
	end)
	return prompt
end

function InteractionService.Detach(object: Instance)
	local entry = entriesByObject[object]
	if not entry then
		return
	end
	entriesByObject[object] = nil
	entriesByPrompt[entry.Prompt] = nil
	entry.Prompt:Destroy()
end

-- Dynamic prompt text, e.g. "Harvest Wheat" -> "Water Wheat".
function InteractionService.SetText(object: Instance, actionText: string?, objectText: string?)
	local entry = entriesByObject[object]
	if not entry then
		return
	end
	if actionText then
		entry.Prompt.ActionText = actionText
	end
	if objectText then
		entry.Prompt.ObjectText = objectText
	end
end

function InteractionService.SetEnabled(object: Instance, enabled: boolean)
	local entry = entriesByObject[object]
	if entry then
		entry.Prompt.Enabled = enabled
	end
end

local function onTriggered(prompt: ProximityPrompt, player: Player)
	local entry = entriesByPrompt[prompt]
	if not entry then
		return
	end
	if not limiter:Check(player) then
		AntiExploitService.Flag(player, "InteractSpam", 1)
		return
	end
	if not prompt.Enabled then
		return
	end

	local character = player.Character
	local root = R15.GetRootPart(character)
	if not root or not R15.IsAlive(character) then
		return
	end
	local promptParent = prompt.Parent
	local position = promptParent and getWorldPosition(promptParent)
	if not position or (root.Position - position).Magnitude > prompt.MaxActivationDistance + DISTANCE_TOLERANCE then
		AntiExploitService.Flag(player, "InteractTooFar:" .. entry.Kind, 2)
		return
	end

	local now = os.clock()
	local last = entry.LastUse[player]
	if last and now - last < entry.Cooldown then
		return
	end
	entry.LastUse[player] = now

	if accessResolver and not accessResolver(player, entry.Object, entry.Permission, entry.OwnerUserId) then
		Notify.Error(player, "You can't do that on someone else's island.")
		return
	end

	local def = kinds[entry.Kind]
	local ok, err = pcall(def.Handler, player, entry.Object, prompt)
	if not ok then
		warn(("[Interaction] %s handler failed for %s: %s"):format(entry.Kind, player.Name, tostring(err)))
	end
end

function InteractionService.Start()
	ProximityPromptService.PromptTriggered:Connect(onTriggered)
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InventoryService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/InventoryService
	DEPENDENCIES: DataService, Shared.Config.{ItemConfig, GameConfig}, Shared.Util.Validate,
	              Server.Util.Notify

	Authoritative backpack. Only accepts item ids registered in ItemConfig,
	enforces capacity and stack limits, and offers atomic multi-item removal
	(HasItems / RemoveItems) for building costs and recipes, so a failed
	purchase can never leave the inventory half-charged.

	Item gain feedback ("+3 Wood") is shown by the client when it sees the
	replicated count go up.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local ItemConfig = require(Shared.Config.ItemConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Validate = require(Shared.Util.Validate)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local Notify = require(script.Parent.Parent.Util.Notify)

local InventoryService = {}

InventoryService.ItemAdded = Signal.new() -- (player, itemId, amount, reason)

-- Stats keys bumped when specific items are gained.
local ITEM_STATS: { [string]: string } = {
	Wood = "WoodCollected",
	Stone = "StoneCollected",
}

local function getItems(player: Player): { [string]: number }?
	return DataService.Get(player, { "Inventory", "Items" })
end

function InventoryService.GetCount(player: Player, itemId: string): number
	local items = getItems(player)
	return items and items[itemId] or 0
end

function InventoryService.GetUsed(player: Player): number
	local items = getItems(player)
	local used = 0
	if items then
		for _, count in items do
			used += count
		end
	end
	return used
end

function InventoryService.GetCapacity(player: Player): number
	return DataService.Get(player, { "Inventory", "Capacity" }) or GameConfig.Inventory.StartingCapacity
end

function InventoryService.GetFreeSpace(player: Player): number
	return math.max(0, InventoryService.GetCapacity(player) - InventoryService.GetUsed(player))
end

-- Adds up to `amount`. Returns how many were actually added (0 if full / invalid).
function InventoryService.AddItem(player: Player, itemId: string, amount: number, reason: string, options: { IgnoreCapacity: boolean? }?): number
	if not ItemConfig.Exists(itemId) then
		warn(("[Inventory] Unknown item '%s' (%s)"):format(tostring(itemId), reason))
		return 0
	end
	if not Validate.Integer(amount, 1, GameConfig.Inventory.MaxStack) then
		warn(("[Inventory] Invalid amount %s for %s (%s)"):format(tostring(amount), itemId, reason))
		return 0
	end
	if not DataService.IsLoaded(player) then
		return 0
	end

	local current = InventoryService.GetCount(player, itemId)
	local room = GameConfig.Inventory.MaxStack - current
	if not (options and options.IgnoreCapacity) then
		room = math.min(room, InventoryService.GetFreeSpace(player))
	end
	local added = math.clamp(amount, 0, room)
	if added <= 0 then
		Notify.Error(player, "Your backpack is full!")
		return 0
	end

	DataService.Set(player, { "Inventory", "Items", itemId }, current + added)
	local statKey = ITEM_STATS[itemId]
	if statKey then
		DataService.Increment(player, { "Stats", statKey }, added)
	end
	if added < amount then
		Notify.Error(player, "Backpack full — some items didn't fit.")
	end
	InventoryService.ItemAdded:Fire(player, itemId, added, reason)
	if GameConfig.Debug then
		print(("[Inventory] %s +%d %s (%s)"):format(player.Name, added, itemId, reason))
	end
	return added
end

function InventoryService.RemoveItem(player: Player, itemId: string, amount: number, reason: string): boolean
	if not ItemConfig.Exists(itemId) or not Validate.Integer(amount, 1, GameConfig.Inventory.MaxStack) then
		return false
	end
	local current = InventoryService.GetCount(player, itemId)
	if current < amount then
		return false
	end
	local remaining = current - amount
	DataService.Set(player, { "Inventory", "Items", itemId }, if remaining > 0 then remaining else nil)
	if GameConfig.Debug then
		print(("[Inventory] %s -%d %s (%s)"):format(player.Name, amount, itemId, reason))
	end
	return true
end

-- Storage chests / backpack upgrades raise (or lower) capacity.
function InventoryService.AddCapacity(player: Player, delta: number)
	local current = InventoryService.GetCapacity(player)
	DataService.Set(player, { "Inventory", "Capacity" }, math.max(GameConfig.Inventory.StartingCapacity, current + math.floor(delta)))
end

-- cost = { Wood = 10, Stone = 5 }
function InventoryService.HasItems(player: Player, cost: { [string]: number }): boolean
	for itemId, amount in cost do
		if InventoryService.GetCount(player, itemId) < amount then
			return false
		end
	end
	return true
end

-- All-or-nothing removal.
function InventoryService.RemoveItems(player: Player, cost: { [string]: number }, reason: string): boolean
	if not InventoryService.HasItems(player, cost) then
		return false
	end
	for itemId, amount in cost do
		InventoryService.RemoveItem(player, itemId, amount, reason)
	end
	return true
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">IslandService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/IslandService
	DEPENDENCIES: DataService, EconomyService, InventoryService, ProgressionService,
	              InteractionService, ToolService, SoundService, VFXService, WorldService,
	              AntiExploitService, Server.Island.IslandBuilder, Server.Island.IslandProps,
	              Shared.Config.{IslandConfig, GameConfig, ProgressionConfig}, Shared.Util.{IslandLayout, Validate}

	Owns everything about islands (spec §4-§6, §111):
	  * one island per player, placed in a free server SLOT,
	  * ownership (OwnerUserId + IslandId attributes on the model, and the
	    server-side maps below — never inferred from position alone),
	  * building / cleaning up island terrain and props,
	  * boundaries (IsPointBuildable) for later build/farm validation,
	  * access checks (CanAccess) used by every interaction,
	  * expansion unlocks (TryUnlockArea),
	  * the island's built-in interactables (starter chest, sign, 🔒 markers).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local GameConfig = require(Shared.Config.GameConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local IslandLayout = require(Shared.Util.IslandLayout)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local InteractionService = require(Services.InteractionService)
local ToolService = require(Services.ToolService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local WorldService = require(Services.WorldService)
local AntiExploitService = require(Services.AntiExploitService)

local ServerRoot = script.Parent.Parent
local IslandBuilder = require(ServerRoot.Island.IslandBuilder)
local IslandProps = require(ServerRoot.Island.IslandProps)
local Notify = require(ServerRoot.Util.Notify)

export type Island = {
	Id: string,
	Owner: Player,
	OwnerUserId: number,
	SlotIndex: number,
	Origin: CFrame,
	Model: Model,
	Folders: { [string]: Folder },
	Sign: Model,
	Chest: Model,
	MarketStall: Model,
	SpawnCFrame: CFrame,
	AreaMarkers: { [string]: Model },
}

local IslandService = {}

IslandService.IslandAssigned = Signal.new() -- (player, island)
IslandService.IslandReleased = Signal.new() -- (player, islandId)
IslandService.AreaUnlocked = Signal.new() -- (player, areaId)

local slots: { [number]: boolean } = {}
local islandsByPlayer: { [Player]: Island } = {}
local islandsById: { [string]: Island } = {}

---------------------------------------------------------------------------
-- Queries
---------------------------------------------------------------------------

function IslandService.GetIsland(player: Player): Island?
	return islandsByPlayer[player]
end

function IslandService.GetIslandById(islandId: string): Island?
	return islandsById[islandId]
end

-- Finds the island an instance belongs to by walking up to the island model.
function IslandService.GetIslandFromInstance(instance: Instance): Island?
	local current: Instance? = instance
	while current and current ~= workspace do
		local islandId = current:GetAttribute("IslandId")
		if type(islandId) == "string" then
			return islandsById[islandId]
		end
		current = current.Parent
	end
	return nil
end

function IslandService.GetIslandAtPosition(worldPosition: Vector3): Island?
	local extent = IslandLayout.GetMaxExtent()
	for _, island in islandsById do
		local offset = worldPosition - island.Origin.Position
		if Vector2.new(offset.X, offset.Z).Magnitude <= extent then
			return island
		end
	end
	return nil
end

function IslandService.ToLocal(island: Island, worldPosition: Vector3): Vector3
	return island.Origin:PointToObjectSpace(worldPosition)
end

function IslandService.ToWorld(island: Island, localPosition: Vector3): Vector3
	return island.Origin:PointToWorldSpace(localPosition)
end

function IslandService.GetUnlockedAreas(player: Player): { [string]: boolean }
	return DataService.Get(player, { "Island", "UnlockedAreas" }) or { Starter = true }
end

function IslandService.IsAreaUnlocked(player: Player, areaId: string): boolean
	return IslandService.GetUnlockedAreas(player)[areaId] == true
end

-- True if a world position is on land the island owner has unlocked.
function IslandService.IsPointBuildable(island: Island, worldPosition: Vector3): boolean
	local localPosition = IslandService.ToLocal(island, worldPosition)
	local unlocked = IslandService.GetUnlockedAreas(island.Owner)
	return IslandLayout.IsOnUnlockedLand(unlocked, Vector2.new(localPosition.X, localPosition.Z), IslandConfig.BuildMargin)
end

-- permission: "Owner" | "Visitor" | a future per-island permission key ("Build", "Fish", ...).
function IslandService.CanAccess(player: Player, island: Island, permission: string): boolean
	if island.OwnerUserId == player.UserId then
		return true
	end
	if permission == "Visitor" then
		return true
	end
	-- Phase 12 (VisitorService) adds Friends/Public + per-permission grants here.
	return false
end

-- World CFrame on the terrain surface at an island-local XZ point.
function IslandService.GetGroundCFrame(island: Island, localXZ: Vector2, yawDegrees: number?): CFrame
	return IslandBuilder.GroundCFrame(island.Origin, localXZ, yawDegrees)
end

function IslandService.GetSpawnCFrame(player: Player): CFrame?
	local island = islandsByPlayer[player]
	return island and island.SpawnCFrame
end

---------------------------------------------------------------------------
-- Visual refresh
---------------------------------------------------------------------------

local function refreshSign(island: Island)
	local data = DataService.GetData(island.Owner)
	if not data then
		return
	end
	local level = data.Island.Level
	IslandProps.SetSignText(island.Sign, data.Island.Name, ("Lv %d · %s"):format(level, ProgressionConfig.GetIslandTitle(level)))
	island.Model:SetAttribute("IslandName", data.Island.Name)
	island.Model:SetAttribute("IslandLevel", level)
end

local function requirementText(areaId: string): string
	local unlock = IslandConfig.Areas[areaId].Unlock
	if not unlock then
		return ""
	end
	local text = ("%s 🪙 · Island Lv %d"):format(Format.Abbreviate(unlock.Coins or 0), unlock.IslandLevel or 1)
	if unlock.RequiresArea then
		text ..= " · after " .. IslandConfig.Areas[unlock.RequiresArea].DisplayName
	end
	return text
end

local function refreshChest(island: Island)
	local claimed = DataService.Get(island.Owner, { "Flags", "StarterChestClaimed" }) == true
	if claimed then
		IslandProps.OpenChest(island.Chest)
		InteractionService.SetEnabled(island.Chest, false)
	end
end

local function createAreaMarker(island: Island, areaId: string)
	local area = IslandConfig.Areas[areaId]
	local marker = IslandBuilder.CreateAreaMarker(island.Origin, island.Folders.AreaMarkers, areaId, requirementText(areaId))
	island.AreaMarkers[areaId] = marker
	InteractionService.Attach(marker, "AreaUnlock", {
		ObjectText = area.DisplayName,
		ActionText = ("Unlock (%s 🪙)"):format(Format.Abbreviate(area.Unlock and area.Unlock.Coins or 0)),
		OwnerUserId = island.OwnerUserId,
	})
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

-- Yields while terrain builds. Requires the profile to be loaded.
function IslandService.AssignIsland(player: Player): Island?
	local existing = islandsByPlayer[player]
	if existing then
		return existing
	end
	local data = DataService.GetData(player)
	if not data then
		warn("[IslandService] Cannot assign an island before data loads for " .. player.Name)
		return nil
	end

	local slotIndex = nil
	for index = 1, GameConfig.MaxIslandsPerServer do
		if not slots[index] then
			slotIndex = index
			break
		end
	end
	if not slotIndex then
		warn("[IslandService] No free island slots (raise GameConfig.MaxIslandsPerServer)")
		return nil
	end
	slots[slotIndex] = true

	if data.Island.IslandId == "" then
		DataService.Set(player, { "Island", "IslandId" }, HttpService:GenerateGUID(false))
	end
	if data.Island.Name == "" then
		DataService.Set(player, { "Island", "Name" }, IslandConfig.DefaultNameFormat:format(player.DisplayName))
	end
	local islandId = data.Island.IslandId

	local origin = IslandLayout.GetSlotOrigin(slotIndex)
	local model, folders = IslandBuilder.CreateModel("Island_" .. player.UserId, WorldService.GetFolder("Islands"))
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("IslandId", islandId)
	model:SetAttribute("SlotIndex", slotIndex)
	model.WorldPivot = origin

	local built = IslandBuilder.Build(origin, model, folders, data.Island.UnlockedAreas)

	local island: Island = {
		Id = islandId,
		Owner = player,
		OwnerUserId = player.UserId,
		SlotIndex = slotIndex,
		Origin = origin,
		Model = model,
		Folders = folders,
		Sign = built.Sign,
		Chest = built.Chest,
		MarketStall = built.MarketStall,
		SpawnCFrame = built.SpawnCFrame,
		AreaMarkers = {},
	}
	islandsByPlayer[player] = island
	islandsById[islandId] = island

	InteractionService.Attach(island.Chest, "StarterChest", { OwnerUserId = player.UserId })
	InteractionService.Attach(island.Sign, "IslandSign", { OwnerUserId = player.UserId })
	for _, areaId in IslandConfig.AreaOrder do
		if not data.Island.UnlockedAreas[areaId] and IslandConfig.Areas[areaId].Unlock then
			createAreaMarker(island, areaId)
		end
	end
	refreshSign(island)
	refreshChest(island)

	if player.Parent == nil then
		-- Left while we were building.
		IslandService.ReleaseIsland(player)
		return nil
	end

	IslandService.IslandAssigned:Fire(player, island)
	if GameConfig.Debug then
		print(("[IslandService] %s -> slot %d (%s)"):format(player.Name, slotIndex, islandId))
	end
	return island
end

-- Destroys the island and restores open ocean. Call AFTER the final save.
function IslandService.ReleaseIsland(player: Player)
	local island = islandsByPlayer[player]
	if not island then
		return
	end
	islandsByPlayer[player] = nil
	islandsById[island.Id] = nil
	InteractionService.Detach(island.Chest)
	InteractionService.Detach(island.Sign)
	for _, marker in island.AreaMarkers do
		InteractionService.Detach(marker)
	end
	island.Model:Destroy()
	IslandBuilder.ClearTerrain(island.Origin, WorldService.RestoreOcean)
	slots[island.SlotIndex] = nil
	IslandService.IslandReleased:Fire(player, island.Id)
end

---------------------------------------------------------------------------
-- Expansion
---------------------------------------------------------------------------

local function liftCharactersOutOfArea(island: Island, areaId: string)
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if character and root and root:IsA("BasePart") then
			local localPosition = IslandService.ToLocal(island, root.Position)
			if IslandLayout.IsInArea(areaId, Vector2.new(localPosition.X, localPosition.Z), -2) and localPosition.Y < IslandConfig.SurfaceHeight + 2 then
				local ground = IslandBuilder.GroundCFrame(island.Origin, Vector2.new(localPosition.X, localPosition.Z))
				AntiExploitService.AllowTeleport(other)
				character:PivotTo(CFrame.new(ground.Position + Vector3.new(0, 4, 0)) * root.CFrame.Rotation)
			end
		end
	end
end

-- Returns (success, message).
function IslandService.TryUnlockArea(player: Player, areaId: any): (boolean, string?)
	if not Validate.Id(areaId) or not IslandConfig.Areas[areaId] then
		AntiExploitService.Flag(player, "InvalidAreaId", 2)
		return false, "That area doesn't exist."
	end
	local island = islandsByPlayer[player]
	if not island then
		return false, "Your island isn't ready yet."
	end
	local area = IslandConfig.Areas[areaId]
	local unlock = area.Unlock
	if not unlock or IslandService.IsAreaUnlocked(player, areaId) then
		return false, area.DisplayName .. " is already unlocked."
	end
	local islandLevel = DataService.Get(player, { "Island", "Level" }) or 1
	if islandLevel < (unlock.IslandLevel or 1) then
		return false, ("Reach Island Level %d to unlock %s."):format(unlock.IslandLevel, area.DisplayName)
	end
	if unlock.RequiresArea and not IslandService.IsAreaUnlocked(player, unlock.RequiresArea) then
		return false, ("Unlock %s first."):format(IslandConfig.Areas[unlock.RequiresArea].DisplayName)
	end
	if unlock.Items and not InventoryService.HasItems(player, unlock.Items) then
		return false, "You don't have the required materials."
	end
	local cost = unlock.Coins or 0
	if not EconomyService.SpendCoins(player, cost, "UnlockArea:" .. areaId) then
		return false, ("You need %s coins to unlock %s."):format(Format.Commas(cost), area.DisplayName)
	end
	if unlock.Items then
		InventoryService.RemoveItems(player, unlock.Items, "UnlockArea:" .. areaId)
	end

	DataService.Set(player, { "Island", "UnlockedAreas", areaId }, true)
	DataService.Increment(player, { "Stats", "AreasUnlocked" }, 1)

	local marker = island.AreaMarkers[areaId]
	if marker then
		island.AreaMarkers[areaId] = nil
		InteractionService.Detach(marker)
		marker:Destroy()
	end

	-- Satisfying reveal: the land rises out of the sea over ~1 second.
	local centerXZ = IslandLayout.GetAreaCenter(areaId)
	local centerWorld = IslandService.ToWorld(island, Vector3.new(centerXZ.X, IslandConfig.SurfaceHeight, centerXZ.Y))
	GameSoundService.PlayFor(player, "AreaUnlock")
	VFXService.PlayAt("AreaUnlock", centerWorld)
	VFXService.ShakeCamera(player, 0.5, 0.8)
	task.spawn(function()
		local steps = 12
		for step = 1, steps do
			IslandBuilder.FillAreaLand(island.Origin, areaId, step / steps)
			task.wait(0.07)
		end
		liftCharactersOutOfArea(island, areaId)
		-- Content (resources, fishing spots, farm plots) spawns once the land exists.
		if islandsByPlayer[player] == island then
			IslandService.AreaUnlocked:Fire(player, areaId)
		end
	end)

	Notify.Banner(player, "AREA UNLOCKED!", area.DisplayName .. " — " .. area.Reward, "AreaUnlock")
	ProgressionService.Award(player, "UnlockArea")
	return true, nil
end

---------------------------------------------------------------------------
-- Built-in interactables
---------------------------------------------------------------------------

local function claimStarterChest(player: Player, chest: Instance)
	if DataService.Get(player, { "Flags", "StarterChestClaimed" }) then
		Notify.Toast(player, "You already opened your starter chest.")
		return
	end
	local kit = GameConfig.StarterKit
	DataService.Set(player, { "Flags", "StarterChestClaimed" }, true)
	EconomyService.AddCoins(player, kit.Coins, "StarterChest")
	for itemId, amount in kit.Items do
		InventoryService.AddItem(player, itemId, amount, "StarterChest", { IgnoreCapacity = true })
	end
	for _, toolId in kit.Tools do
		ToolService.GrantTool(player, toolId, "StarterChest")
	end

	local island = islandsByPlayer[player]
	if island then
		refreshChest(island)
	end
	if chest:IsA("Model") then
		local pivot = chest:GetPivot().Position
		VFXService.PlayAt("ChestOpen", pivot + Vector3.new(0, 2.5, 0))
	end
	GameSoundService.PlayFor(player, "ChestOpen")
	Notify.Banner(player, "STARTER KIT!", "Tools, seeds, coins and materials — check your hotbar!", "Reward")
	ProgressionService.Award(player, "StarterChest")
end

local function readSign(player: Player, sign: Instance)
	local island = IslandService.GetIslandFromInstance(sign)
	if not island then
		return
	end
	local data = DataService.GetData(island.Owner)
	if not data then
		return
	end
	local unlockedCount = 0
	for _ in data.Island.UnlockedAreas do
		unlockedCount += 1
	end
	Notify.Toast(
		player,
		("%s · Level %d %s · %d/%d areas"):format(
			data.Island.Name,
			data.Island.Level,
			ProgressionConfig.GetIslandTitle(data.Island.Level),
			unlockedCount,
			#IslandConfig.AreaOrder
		),
		"🏝️"
	)
end

function IslandService.Init()
	InteractionService.RegisterKind("StarterChest", {
		ActionText = "Open",
		ObjectText = "Starter Chest",
		Permission = "Owner",
		HoldDuration = 0.4,
		MaxDistance = 10,
		Handler = claimStarterChest,
	})
	InteractionService.RegisterKind("IslandSign", {
		ActionText = "Read",
		ObjectText = "Island Sign",
		Permission = "Visitor",
		MaxDistance = 12,
		Cooldown = 1.5,
		Handler = readSign,
	})
	InteractionService.RegisterKind("AreaUnlock", {
		ActionText = "Unlock",
		ObjectText = "Locked Area",
		Permission = "Owner",
		HoldDuration = 0.8,
		MaxDistance = 12,
		Cooldown = 1,
		Handler = function(player: Player, marker: Instance)
			local ok, message = IslandService.TryUnlockArea(player, marker:GetAttribute("AreaId"))
			if not ok and message then
				Notify.Error(player, message)
			end
		end,
	})

	InteractionService.SetAccessResolver(function(player, object, permission, ownerUserId)
		local island = IslandService.GetIslandFromInstance(object)
		if island then
			return IslandService.CanAccess(player, island, permission)
		end
		return permission == "Visitor" or ownerUserId == nil or ownerUserId == player.UserId
	end)

	Net.OnServerEvent("UnlockAreaRequest", function(player: Player, areaId: any)
		local ok, message = IslandService.TryUnlockArea(player, areaId)
		if not ok and message then
			Notify.Error(player, message)
		end
	end)
end

function IslandService.Start()
	DataService.Changed:Connect(function(player: Player, path: { string })
		if path[1] ~= "Island" or (path[2] ~= "Name" and path[2] ~= "Level") then
			return
		end
		local island = islandsByPlayer[player]
		if island then
			refreshSign(island)
		end
	end)
end

return IslandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">NPCService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  NPCService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/NPCService
	DEPENDENCIES: IslandService, InteractionService, Server.Util.Notify

	Lightweight island NPCs (spec §51/§52). Phase 1 of NPCs: a friendly R15
	merchant behind every market stall who gives tips when you talk to her.
	Built from a HumanoidDescription (standard R15 rig), anchored, no AI loop.
	Quests, dialogue trees and wandering NPCs arrive in Phase 10.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Services = script.Parent
local IslandService = require(Services.IslandService)
local InteractionService = require(Services.InteractionService)
local Notify = require(script.Parent.Parent.Util.Notify)
local GameConfig = require(ReplicatedStorage.Shared.Config.GameConfig)

local MERCHANT_NAME = "Mia the Merchant"

local TIPS = {
	"Welcome! Press [E] at my counter to SELL, or [F] at the crate to SHOP.",
	"Crops, fish, milk and eggs all sell here. Check the market demand bonus!",
	"Water your crops — they grow 50% faster.",
	"Build a Barn, then come back and I'll sell you a cow.",
	"Better tools gather faster. A Stone Axe chops trees in half the hits!",
	"Unlocking new areas brings new resources and fishing spots.",
}

local NPCService = {}

local tipIndex: { [Player]: number } = setmetatable({}, { __mode = "k" }) :: any

local function buildMerchant(): Model?
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(234, 184, 146)
	description.LeftArmColor = description.HeadColor
	description.RightArmColor = description.HeadColor
	description.LeftLegColor = Color3.fromRGB(80, 90, 140)
	description.RightLegColor = Color3.fromRGB(80, 90, 140)
	description.TorsoColor = Color3.fromRGB(90, 170, 110)
	local ok, model = pcall(Players.CreateHumanoidModelFromDescription, Players, description, Enum.HumanoidRigType.R15)
	if not ok or not model then
		if GameConfig.Debug then
			warn("[NPCService] Could not create merchant rig: " .. tostring(model))
		end
		return nil
	end
	model.Name = MERCHANT_NAME
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayName = MERCHANT_NAME
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	end
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy() -- server NPC: no LocalScript animation needed
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = descendant.Name == "HumanoidRootPart"
		end
	end
	return model
end

local function spawnMerchant(island: any)
	local stall = island.MarketStall
	if not stall then
		return
	end
	local merchant = buildMerchant()
	if not merchant then
		return
	end
	-- Behind the counter, facing the same way as the stall's front.
	merchant:PivotTo(stall:GetPivot() * CFrame.new(0, 3, 1.6))
	merchant.Parent = island.Folders.Landmarks
	local root = merchant:FindFirstChild("HumanoidRootPart")
	if root then
		InteractionService.Attach(root, "MerchantTalk", { ObjectText = MERCHANT_NAME, OwnerUserId = island.OwnerUserId, KeyboardKeyCode = Enum.KeyCode.T })
	end
end

function NPCService.Init()
	InteractionService.RegisterKind("MerchantTalk", {
		ActionText = "Talk",
		ObjectText = MERCHANT_NAME,
		Permission = "Visitor",
		MaxDistance = 12,
		Cooldown = 1,
		Handler = function(player: Player)
			local index = (tipIndex[player] or 0) % #TIPS + 1
			tipIndex[player] = index
			Notify.Toast(player, MERCHANT_NAME .. ": " .. TIPS[index], "💬")
		end,
	})
end

function NPCService.Start()
	IslandService.IslandAssigned:Connect(function(_player: Player, island: any)
		-- CreateHumanoidModelFromDescription can yield; don't hold up island loading.
		task.spawn(spawnMerchant, island)
	end)
end

return NPCService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  PlayerService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/PlayerService
	DEPENDENCIES: DataService, IslandService, ToolService, AnimationService, AntiExploitService,
	              Shared.Config.GameConfig, Shared.Util.R15
	REQUIRED OBJECTS: Players.CharacterAutoLoads = false (set in default.project.json and here)

	Orchestrates the player lifecycle in a fixed, safe order:

	JOIN:   load profile -> assign island -> leaderstats -> spawn R15 character on the island
	SPAWN:  enforce R15 -> move to island spawn -> movement anim overrides -> re-equip tool
	DEATH:  respawn on own island after RespawnDelay
	LEAVE:  unequip -> final save + lock release -> island cleanup (AFTER the save)

	R15 (spec §3): Game Settings > Avatar should be set to R15. If a non-R15
	character still appears and GameConfig.Character.ForceR15 is on, it is
	rebuilt as R15 from the player's HumanoidDescription.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local R15 = require(Shared.Util.R15)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local ToolService = require(Services.ToolService)
local AnimationService = require(Services.AnimationService)
local AntiExploitService = require(Services.AntiExploitService)

local CharacterConfig = GameConfig.Character

local PlayerService = {}

PlayerService.CharacterSpawned = Signal.new() -- (player, character) after placement on the island

local respawning: { [Player]: boolean } = {}
local convertingToR15: { [Player]: boolean } = {}

local function setupLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = DataService.Get(player, { "Coins" }) or 0
	coins.Parent = leaderstats
	local islandLevel = Instance.new("IntValue")
	islandLevel.Name = "Island Lv"
	islandLevel.Value = DataService.Get(player, { "Island", "Level" }) or 1
	islandLevel.Parent = leaderstats
	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, path: { string }, value: any)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats or type(value) ~= "number" then
		return
	end
	local statName = nil
	if path[1] == "Coins" and #path == 1 then
		statName = "Coins"
	elseif path[1] == "Island" and path[2] == "Level" then
		statName = "Island Lv"
	end
	local stat = statName and leaderstats:FindFirstChild(statName)
	if stat and stat:IsA("IntValue") then
		stat.Value = math.min(value, 2 ^ 31 - 1)
	end
end

-- Rebuilds a non-R15 character as R15 from the player's avatar description.
local function convertToR15(player: Player, oldCharacter: Model): boolean
	if convertingToR15[player] then
		return false
	end
	convertingToR15[player] = true

	local description: HumanoidDescription? = nil
	if player.UserId > 0 then
		local ok, result = pcall(Players.GetHumanoidDescriptionFromUserId, Players, player.UserId)
		if ok then
			description = result
		end
	end
	local ok, model = pcall(Players.CreateHumanoidModelFromDescription, Players, description or Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	if not ok or not model then
		warn("[PlayerService] Could not build an R15 character for " .. player.Name .. ": " .. tostring(model))
		convertingToR15[player] = false
		return false
	end

	model.Name = player.Name
	if not model:FindFirstChild("Animate") then
		local template = StarterPlayer:FindFirstChild("StarterCharacterScripts")
		local animate = template and template:FindFirstChild("Animate")
		if animate then
			animate:Clone().Parent = model
		else
			warn("[PlayerService] R15 character has no Animate script. Set Game Settings > Avatar to R15.")
		end
	end
	model:PivotTo(oldCharacter:GetPivot())
	player.Character = model
	model.Parent = workspace
	oldCharacter:Destroy()
	convertingToR15[player] = false
	return true
end

-- Prefer the modern LoadCharacterAsync; if it's missing or errors, use LoadCharacter.
local function loadCharacter(player: Player): (boolean, any)
	local ok, err = pcall(function()
		(player :: any):LoadCharacterAsync()
	end)
	if ok then
		return true, nil
	end
	local fallbackOk, fallbackErr = pcall(function()
		(player :: any):LoadCharacter()
	end)
	if fallbackOk then
		return true, nil
	end
	return false, tostring(err) .. " | " .. tostring(fallbackErr)
end

local function spawnCharacter(player: Player)
	if player.Parent == nil or respawning[player] then
		return
	end
	respawning[player] = true
	local spawnCFrame = IslandService.GetSpawnCFrame(player)
	if spawnCFrame then
		pcall(player.RequestStreamAroundAsync, player, spawnCFrame.Position, 5)
	end
	local ok, err = loadCharacter(player)
	respawning[player] = false
	if not ok then
		warn("[PlayerService] LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or not humanoid:IsA("Humanoid") then
		warn("[PlayerService] Character for " .. player.Name .. " is missing Humanoid/HumanoidRootPart")
		return
	end

	if CharacterConfig.RequireR15 and not R15.IsR15(character) then
		warn(("[PlayerService] %s spawned with a non-R15 rig. Set Game Settings > Avatar > Avatar Type to R15."):format(player.Name))
		if CharacterConfig.ForceR15 and convertToR15(player, character) then
			return -- CharacterAdded fires again for the new R15 model
		end
	end

	humanoid.WalkSpeed = CharacterConfig.WalkSpeed
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = CharacterConfig.JumpHeight

	local spawnCFrame = IslandService.GetSpawnCFrame(player)
	if spawnCFrame then
		AntiExploitService.AllowTeleport(player)
		character:PivotTo(spawnCFrame)
	end

	AnimationService.ApplyMovementOverrides(character)
	ToolService.OnCharacterSpawned(player, character)
	PlayerService.CharacterSpawned:Fire(player, character)

	humanoid.Died:Once(function()
		task.delay(CharacterConfig.RespawnDelay, function()
			if player.Parent and player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local data = DataService.LoadProfile(player)
	if not data or player.Parent == nil then
		return
	end

	local built, islandOrError = pcall(IslandService.AssignIsland, player)
	if not built then
		warn("[PlayerService] Island build failed for " .. player.Name .. ": " .. tostring(islandOrError))
		if player.Parent then
			player:Kick("Your island failed to build. Error: " .. tostring(islandOrError))
		end
		return
	end
	local island = islandOrError
	if not island then
		if player.Parent then
			player:Kick("This server has no free islands right now. Please join another server.")
		end
		return
	end

	setupLeaderstats(player)
	spawnCharacter(player)
end

local function onPlayerRemoving(player: Player)
	ToolService.OnPlayerRemoving(player)
	DataService.ReleaseProfile(player) -- yields until the final save completes
	IslandService.ReleaseIsland(player) -- only after the island's data is safe
	respawning[player] = nil
	convertingToR15[player] = nil
end

function PlayerService.Init()
	Players.CharacterAutoLoads = false
end

function PlayerService.Start()
	DataService.Changed:Connect(updateLeaderstats)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Play time statistic.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				if DataService.IsLoaded(player) then
					DataService.Increment(player, { "Stats", "PlayTime" }, 60)
				end
			end
		end
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ProgressionService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/ProgressionService
	DEPENDENCIES: DataService, SoundService, VFXService, Shared.Config.ProgressionConfig,
	              Server.Util.Notify

	Player XP/level and Island XP/level. XP is only ever awarded by SOURCE id
	(ProgressionConfig.Sources) — the amount is decided here, never by a
	client (spec §42). Phase 11 extends this with achievements/titles.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local Notify = require(script.Parent.Parent.Util.Notify)

local ProgressionService = {}

ProgressionService.PlayerLevelUp = Signal.new() -- (player, newLevel)
ProgressionService.IslandLevelUp = Signal.new() -- (player, newLevel)

local function characterPosition(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position - Vector3.new(0, 2.5, 0)
	end
	return nil
end

local function applyXP(player: Player, xpPath: { string }, levelPath: { string }, amount: number, maxLevel: number, xpForLevel: (number) -> number): number?
	local xp = DataService.Get(player, xpPath)
	local level = DataService.Get(player, levelPath)
	if type(xp) ~= "number" or type(level) ~= "number" then
		return nil
	end
	xp += amount
	local startLevel = level
	while level < maxLevel and xp >= xpForLevel(level) do
		xp -= xpForLevel(level)
		level += 1
	end
	if level >= maxLevel then
		xp = 0
	end
	DataService.Set(player, xpPath, xp)
	if level ~= startLevel then
		DataService.Set(player, levelPath, level)
		return level
	end
	return nil
end

function ProgressionService.AddPlayerXP(player: Player, amount: number, reason: string)
	if amount <= 0 then
		return
	end
	local newLevel = applyXP(player, { "XP" }, { "Level" }, math.floor(amount), ProgressionConfig.Player.MaxLevel, ProgressionConfig.PlayerXPForLevel)
	if newLevel then
		Notify.Banner(player, "LEVEL UP!", ("You reached level %d"):format(newLevel), "LevelUp")
		GameSoundService.PlayFor(player, "LevelUp")
		local position = characterPosition(player)
		if position then
			VFXService.PlayAt("LevelUp", position)
		end
		ProgressionService.PlayerLevelUp:Fire(player, newLevel)
	end
	if GameConfig.Debug then
		print(("[Progression] %s +%d player XP (%s)"):format(player.Name, amount, reason))
	end
end

function ProgressionService.AddIslandXP(player: Player, amount: number, reason: string)
	if amount <= 0 then
		return
	end
	local newLevel = applyXP(
		player,
		{ "Island", "XP" },
		{ "Island", "Level" },
		math.floor(amount),
		ProgressionConfig.Island.MaxLevel,
		ProgressionConfig.IslandXPForLevel
	)
	if newLevel then
		Notify.Banner(player, "ISLAND LEVEL UP!", ("Island Level %d — %s"):format(newLevel, ProgressionConfig.GetIslandTitle(newLevel)), "IslandLevelUp")
		GameSoundService.PlayFor(player, "IslandLevelUp")
		local position = characterPosition(player)
		if position then
			VFXService.PlayAt("IslandLevelUp", position)
		end
		ProgressionService.IslandLevelUp:Fire(player, newLevel)
	end
	if GameConfig.Debug then
		print(("[Progression] %s +%d island XP (%s)"):format(player.Name, amount, reason))
	end
end

-- Award XP for a configured source, e.g. Award(player, "StarterChest").
function ProgressionService.Award(player: Player, sourceId: string, multiplier: number?)
	local source = ProgressionConfig.Sources[sourceId]
	if not source then
		warn("[Progression] Unknown XP source " .. tostring(sourceId))
		return
	end
	local scale = multiplier or 1
	if source.Player then
		ProgressionService.AddPlayerXP(player, source.Player * scale, sourceId)
	end
	if source.Island then
		ProgressionService.AddIslandXP(player, source.Island * scale, sourceId)
	end
end

-- Admin/debug helper.
function ProgressionService.SetIslandLevel(player: Player, level: number)
	local clamped = math.clamp(math.floor(level), 1, ProgressionConfig.Island.MaxLevel)
	DataService.Set(player, { "Island", "XP" }, 0)
	DataService.Set(player, { "Island", "Level" }, clamped)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  QuestService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/QuestService
	DEPENDENCIES: DataService, EconomyService, InventoryService, ProgressionService, IslandService,
	              BuildService, FarmService, FishingService, AnimalService, ShopService,
	              SoundService, VFXService, Shared.Config.QuestConfig

	Progression quests = the tutorial (spec §43, §118, §119). The chain in
	QuestConfig walks a new player through the whole core loop:
	gather → build → farm → fish → sell → animals → expand.

	Progress is ONLY recorded from server-side signals (an item was really
	gathered, a building really completed...). Clients can't report progress.
	State-based tasks (own a building, island level, unlocked area) are also
	synced when a quest starts so nothing already done has to be redone.

	Saved: Quests.Current, Quests.Progress[taskId], Quests.Completed[questId].
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local QuestConfig = require(Shared.Config.QuestConfig)
local Format = require(Shared.Util.Format)
local R15 = require(Shared.Util.R15)

local Services = script.Parent
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local IslandService = require(Services.IslandService)
local BuildService = require(Services.BuildService)
local FarmService = require(Services.FarmService)
local FishingService = require(Services.FishingService)
local AnimalService = require(Services.AnimalService)
local ShopService = require(Services.ShopService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local Notify = require(script.Parent.Parent.Util.Notify)

local QuestService = {}

local function currentQuest(player: Player): any
	local questId = DataService.Get(player, { "Quests", "Current" })
	return if type(questId) == "string" then QuestConfig.Quests[questId] else nil
end

local function progressOf(player: Player, taskId: string): number
	return DataService.Get(player, { "Quests", "Progress", taskId }) or 0
end

local function isComplete(player: Player, quest: any): boolean
	for _, questTask in quest.Tasks do
		if progressOf(player, questTask.Id) < questTask.Amount then
			return false
		end
	end
	return true
end

local startQuest: (Player, string?) -> ()

local function completeQuest(player: Player, quest: any)
	DataService.Set(player, { "Quests", "Completed", quest.Id }, true)
	DataService.Increment(player, { "Stats", "QuestsCompleted" }, 1)
	local reward = quest.Reward
	if reward.Coins then
		EconomyService.AddCoins(player, reward.Coins, "Quest:" .. quest.Id)
	end
	if reward.XP then
		ProgressionService.AddPlayerXP(player, reward.XP, "Quest:" .. quest.Id)
	end
	if reward.IslandXP then
		ProgressionService.AddIslandXP(player, reward.IslandXP, "Quest:" .. quest.Id)
	end
	for itemId, amount in reward.Items or {} do
		InventoryService.AddItem(player, itemId, amount, "Quest:" .. quest.Id, { IgnoreCapacity = true })
	end
	Notify.Banner(player, "QUEST COMPLETE!", ("%s — +%s 🪙"):format(quest.DisplayName, Format.Commas(reward.Coins or 0)), "Reward")
	GameSoundService.PlayFor(player, "QuestComplete")
	local root = R15.GetRootPart(player.Character)
	if root then
		VFXService.PlayAt("Sparkle", root.Position + Vector3.new(0, 2, 0))
	end
	startQuest(player, QuestConfig.NextQuest(quest.Id))
end

local function setProgress(player: Player, quest: any, questTask: any, value: number)
	local clamped = math.clamp(math.floor(value), 0, questTask.Amount)
	if clamped == progressOf(player, questTask.Id) then
		return
	end
	DataService.Set(player, { "Quests", "Progress", questTask.Id }, clamped)
	if clamped >= questTask.Amount then
		Notify.Success(player, "✔ " .. questTask.Text, "📜")
	end
	if isComplete(player, quest) then
		completeQuest(player, quest)
	end
end

-- Records an event. targets = every id this event matches (e.g. {"Barn", "Farm"}).
function QuestService.Record(player: Player, event: string, targets: { string }?, amount: number?)
	local quest = currentQuest(player)
	if not quest then
		return
	end
	for _, questTask in quest.Tasks do
		if questTask.Event == event and (questTask.Target == nil or (targets ~= nil and table.find(targets, questTask.Target) ~= nil)) then
			if event == "IslandLevel" then
				setProgress(player, quest, questTask, math.max(progressOf(player, questTask.Id), amount or 0))
			else
				setProgress(player, quest, questTask, progressOf(player, questTask.Id) + (amount or 1))
			end
			quest = currentQuest(player)
			if not quest then
				return
			end
		end
	end
end

-- Credits things the player has already done (buildings, level, areas).
local function syncState(player: Player)
	local quest = currentQuest(player)
	if not quest then
		return
	end
	for _, questTask in quest.Tasks do
		local value: number? = nil
		if questTask.Event == "IslandLevel" then
			value = DataService.Get(player, { "Island", "Level" }) or 1
		elseif questTask.Event == "UnlockArea" and questTask.Target then
			value = if IslandService.IsAreaUnlocked(player, questTask.Target) then 1 else 0
		elseif questTask.Event == "BuildComplete" and questTask.Target then
			value = BuildService.CountComplete(player, questTask.Target, nil) + BuildService.CountComplete(player, nil, questTask.Target)
		end
		if value and value > progressOf(player, questTask.Id) then
			setProgress(player, quest, questTask, value)
			if currentQuest(player) ~= quest then
				return
			end
		end
	end
end

startQuest = function(player: Player, questId: string?)
	DataService.Set(player, { "Quests", "Progress" }, {})
	DataService.Set(player, { "Quests", "Current" }, questId or "")
	if not questId then
		Notify.Banner(player, "ALL QUESTS DONE!", "Keep growing your island — more quests coming soon.", "Reward")
		return
	end
	local quest = QuestConfig.Quests[questId]
	task.delay(3, function()
		if player.Parent and DataService.Get(player, { "Quests", "Current" }) == questId then
			Notify.Toast(player, "New quest: " .. quest.DisplayName, "📜")
		end
	end)
	syncState(player)
end

function QuestService.Start()
	InventoryService.ItemAdded:Connect(function(player: Player, itemId: string, amount: number, reason: string)
		if string.sub(reason, 1, 7) == "Gather:" then
			QuestService.Record(player, "CollectItem", { itemId }, amount)
		end
	end)
	BuildService.BuildingCompleted:Connect(function(player: Player, buildingId: string, def: any)
		QuestService.Record(player, "BuildComplete", { buildingId, def.Category }, 1)
	end)
	FarmService.CropPlanted:Connect(function(player: Player, cropId: string)
		QuestService.Record(player, "PlantCrop", { cropId }, 1)
	end)
	FarmService.CropHarvested:Connect(function(player: Player, cropId: string, amount: number)
		QuestService.Record(player, "HarvestCrop", { cropId }, amount)
	end)
	FishingService.FishCaught:Connect(function(player: Player, fishId: string)
		QuestService.Record(player, "CatchFish", { fishId }, 1)
	end)
	ShopService.ItemsSold:Connect(function(player: Player, itemId: string, quantity: number)
		QuestService.Record(player, "SellItem", { itemId }, quantity)
	end)
	ShopService.Purchased:Connect(function(player: Player, shopItemId: string, def: any)
		if def.Grant.Tool then
			QuestService.Record(player, "BuyTool", { shopItemId, def.Grant.Tool }, 1)
		end
	end)
	AnimalService.AnimalAdded:Connect(function(player: Player, animalId: string)
		QuestService.Record(player, "BuyAnimal", { animalId }, 1)
	end)
	AnimalService.AnimalFed:Connect(function(player: Player, animalId: string)
		QuestService.Record(player, "FeedAnimal", { animalId }, 1)
	end)
	AnimalService.ProduceCollected:Connect(function(player: Player, animalId: string, itemId: string, amount: number)
		QuestService.Record(player, "CollectProduce", { itemId, animalId }, amount)
	end)
	IslandService.AreaUnlocked:Connect(function(player: Player, areaId: string)
		QuestService.Record(player, "UnlockArea", { areaId }, 1)
	end)
	ProgressionService.IslandLevelUp:Connect(function(player: Player, level: number)
		QuestService.Record(player, "IslandLevel", nil, level)
	end)
	IslandService.IslandAssigned:Connect(function(player: Player)
		-- Wait for buildings to load before crediting state-based tasks.
		task.delay(1, function()
			if player.Parent then
				syncState(player)
			end
		end)
	end)
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">ResourceService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ResourceService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/ResourceService
	DEPENDENCIES: IslandService, InteractionService, VFXService, SoundService,
	              Server.Island.NodeModels, Shared.Config.ResourceConfig, Shared.Util.IslandContent

	Owns resource NODES (trees, rocks, bushes, ore...) on every island.
	  * Spawns each unlocked area's nodes at deterministic spots
	    (Shared/Util/IslandContent) when an island loads or an area unlocks.
	  * POOLED (spec §115): a broken node is hidden, not destroyed, and
	    regrows after its Respawn time in the same Model.
	  * Tracks health on the server; clients read the Health attribute for
	    health bars. GatherService decides WHO may hit a node and what they get.

	Node attributes: NodeId, NodeType, Health, MaxHealth, Depleted, OwnerUserId.
	CollectionService tag: "ResourceNode".
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local ResourceConfig = require(Shared.Config.ResourceConfig)
local IslandContent = require(Shared.Util.IslandContent)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local IslandService = require(Services.IslandService)
local InteractionService = require(Services.InteractionService)
local VFXService = require(Services.VFXService)
local GameSoundService = require(Services.SoundService)
local NodeModels = require(script.Parent.Parent.Island.NodeModels)

export type Node = {
	Id: string,
	Type: string,
	Def: any,
	IslandId: string,
	OwnerUserId: number,
	Model: Model,
	BaseCFrame: CFrame,
	Health: number,
	Depleted: boolean,
	RespawnThread: thread?,
}

local ResourceService = {}

ResourceService.NodeBroken = Signal.new() -- (node)

local TAG = "ResourceNode"

local nodesById: { [string]: Node } = {}
local nodesByIsland: { [string]: { Node } } = {}

local function seedFor(text: string): number
	local seed = 17
	for index = 1, #text do
		seed = (seed * 33 + string.byte(text, index)) % 2147483647
	end
	return seed
end

local function spawnNode(island: any, spotId: string, nodeType: string, localXZ: Vector2)
	local def = ResourceConfig.Nodes[nodeType]
	if not def then
		warn("[ResourceService] Unknown node type " .. tostring(nodeType))
		return
	end
	local nodeId = island.Id .. "/" .. spotId
	if nodesById[nodeId] then
		return
	end
	local seed = seedFor(nodeId)
	local model = NodeModels.Build(def.Model, seed)
	model.Name = nodeType
	local yaw = seed % 360
	local baseCFrame = IslandService.GetGroundCFrame(island, localXZ, yaw) * CFrame.new(0, -0.2, 0)
	model:PivotTo(baseCFrame)
	model:SetAttribute("NodeId", nodeId)
	model:SetAttribute("NodeType", nodeType)
	model:SetAttribute("Health", def.Health)
	model:SetAttribute("MaxHealth", def.Health)
	model:SetAttribute("Depleted", false)
	model:SetAttribute("OwnerUserId", island.OwnerUserId)
	if def.ToolType then
		model:SetAttribute("ToolType", def.ToolType)
	end
	model.Parent = island.Folders.Resources
	CollectionService:AddTag(model, TAG)

	local node: Node = {
		Id = nodeId,
		Type = nodeType,
		Def = def,
		IslandId = island.Id,
		OwnerUserId = island.OwnerUserId,
		Model = model,
		BaseCFrame = baseCFrame,
		Health = def.Health,
		Depleted = false,
		RespawnThread = nil,
	}
	nodesById[nodeId] = node
	local list = nodesByIsland[island.Id]
	if not list then
		list = {}
		nodesByIsland[island.Id] = list
	end
	table.insert(list, node)

	InteractionService.Attach(model, "ResourceNode", {
		ActionText = def.Action,
		ObjectText = def.DisplayName,
		OwnerUserId = island.OwnerUserId,
		MaxDistance = 11,
	})
end

function ResourceService.SpawnArea(island: any, areaId: string)
	for _, spot in IslandContent.AreaNodes(areaId) do
		spawnNode(island, spot.Id, spot.Type, spot.Position)
	end
end

function ResourceService.GetNode(nodeId: any): Node?
	if type(nodeId) ~= "string" then
		return nil
	end
	return nodesById[nodeId]
end

function ResourceService.GetNodeFromModel(model: Instance): Node?
	local nodeId = model:GetAttribute("NodeId")
	return ResourceService.GetNode(nodeId)
end

function ResourceService.GetPosition(node: Node): Vector3
	return node.BaseCFrame.Position
end

local function respawn(node: Node)
	node.RespawnThread = nil
	if not node.Model.Parent then
		return
	end
	node.Model:PivotTo(node.BaseCFrame)
	NodeModels.SetVisible(node.Model, true)
	node.Health = node.Def.Health
	node.Depleted = false
	node.Model:SetAttribute("Health", node.Health)
	node.Model:SetAttribute("Depleted", false)
	InteractionService.SetEnabled(node.Model, true)
	VFXService.PlayAt("Sparkle", node.BaseCFrame.Position + Vector3.new(0, 2, 0))
end

local function fallOver(node: Node, fromPosition: Vector3?)
	-- Tip the tree away from the player around its base, then hide it.
	local base = node.BaseCFrame
	local away = if fromPosition then (base.Position - fromPosition) * Vector3.new(1, 0, 1) else Vector3.new(1, 0, 0)
	if away.Magnitude < 0.1 then
		away = Vector3.new(1, 0, 0)
	end
	away = away.Unit
	local axis = Vector3.new(0, 1, 0):Cross(away).Unit
	local driver = Instance.new("NumberValue")
	driver.Value = 0
	driver.Changed:Connect(function(alpha)
		if node.Model.Parent then
			node.Model:PivotTo(CFrame.fromAxisAngle(axis, math.rad(82) * alpha) * (base - base.Position) + base.Position)
		end
	end)
	local tween = TweenService:Create(driver, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = 1 })
	tween.Completed:Once(function()
		driver:Destroy()
		if node.Depleted and node.Model.Parent then
			NodeModels.SetVisible(node.Model, false)
			VFXService.PlayAt(node.Def.BreakVFX or "LeafBurst", base.Position + away * 5 + Vector3.new(0, 1, 0))
		end
	end)
	tween:Play()
end

-- Applies damage. Returns true if this hit broke the node.
function ResourceService.Damage(node: Node, amount: number, fromPosition: Vector3?): boolean
	if node.Depleted then
		return false
	end
	node.Health = math.max(0, node.Health - amount)
	node.Model:SetAttribute("Health", node.Health)
	if node.Health > 0 then
		return false
	end

	node.Depleted = true
	node.Model:SetAttribute("Depleted", true)
	InteractionService.SetEnabled(node.Model, false)
	if node.Def.BreakSound then
		GameSoundService.PlayAt(node.Def.BreakSound, node.BaseCFrame.Position)
	end
	if node.Def.FallOver then
		fallOver(node, fromPosition)
	else
		NodeModels.SetVisible(node.Model, false)
		VFXService.PlayAt(node.Def.BreakVFX or "RockChips", node.BaseCFrame.Position + Vector3.new(0, 1, 0))
	end
	node.RespawnThread = task.delay(node.Def.Respawn, respawn, node)
	ResourceService.NodeBroken:Fire(node)
	return true
end

-- Nodes near a world position (used by build validation & debugging).
function ResourceService.GetIslandNodes(islandId: string): { Node }
	return nodesByIsland[islandId] or {}
end

local function clearIsland(islandId: string)
	local list = nodesByIsland[islandId]
	if not list then
		return
	end
	for _, node in list do
		if node.RespawnThread then
			pcall(task.cancel, node.RespawnThread)
		end
		nodesById[node.Id] = nil
	end
	nodesByIsland[islandId] = nil
end

function ResourceService.Start()
	IslandService.IslandAssigned:Connect(function(player: Player, island: any)
		local unlocked = IslandService.GetUnlockedAreas(player)
		for areaId in unlocked do
			ResourceService.SpawnArea(island, areaId)
		end
	end)
	IslandService.AreaUnlocked:Connect(function(player: Player, areaId: string)
		local island = IslandService.GetIsland(player)
		if island then
			ResourceService.SpawnArea(island, areaId)
		end
	end)
	IslandService.IslandReleased:Connect(function(_player: Player, islandId: string)
		clearIsland(islandId)
	end)
end

return ResourceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ShopService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/ShopService
	DEPENDENCIES: DataService, IslandService, EconomyService, InventoryService, ToolService,
	              AnimalService, FarmService, ProgressionService, InteractionService,
	              AntiExploitService, VFXService, Shared.Net, Shared.Config.{ShopConfig, ItemConfig, CropConfig}

	The island MARKET (spec §33, §64, §88, §89, §145). The market stall on each
	island has two prompts: [E] Sell and [F] Shop; both open the Market UI.

	SELL  SellItemRequest(itemId, quantity) — itemId "__ALL__" sells every
	      crop / fish / animal product. The server checks you're at your stall,
	      removes the items, computes the price (EconomyService.GetSellPrice,
	      which includes market demand) and pays you. Never trusts a price.
	BUY   PurchaseRequest(shopItemId, quantity) — seeds, animals (needs
	      housing), tool upgrades, farm/backpack upgrades. Everything is checked
	      BEFORE anything is charged.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local ShopConfig = require(Shared.Config.ShopConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local CropConfig = require(Shared.Config.CropConfig)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ToolService = require(Services.ToolService)
local AnimalService = require(Services.AnimalService)
local FarmService = require(Services.FarmService)
local ProgressionService = require(Services.ProgressionService)
local InteractionService = require(Services.InteractionService)
local AntiExploitService = require(Services.AntiExploitService)
local VFXService = require(Services.VFXService)
local Notify = require(script.Parent.Parent.Util.Notify)

local SELL_ALL = "__ALL__"
local MAX_QUANTITY = 9999

local ShopService = {}

ShopService.ItemsSold = Signal.new() -- (player, itemId, quantity, coins)
ShopService.Purchased = Signal.new() -- (player, shopItemId, def)

local function atMarket(player: Player): boolean
	local island = IslandService.GetIsland(player)
	local root = R15.GetRootPart(player.Character)
	if not island or not root or not island.MarketStall then
		return false
	end
	return (root.Position - island.MarketStall:GetPivot().Position).Magnitude <= ShopConfig.MarketRange
end

---------------------------------------------------------------------------
-- Selling
---------------------------------------------------------------------------

local function sellOne(player: Player, itemId: string, quantity: number): (number, number)
	local owned = InventoryService.GetCount(player, itemId)
	local amount = math.min(owned, quantity)
	if amount <= 0 then
		return 0, 0
	end
	local price = EconomyService.GetSellPrice(itemId)
	if price <= 0 then
		return 0, 0
	end
	if not InventoryService.RemoveItem(player, itemId, amount, "Sell") then
		return 0, 0
	end
	local coins = price * amount
	EconomyService.AddCoins(player, coins, "Sell:" .. itemId)
	DataService.Increment(player, { "Stats", "ItemsSold" }, amount)
	ShopService.ItemsSold:Fire(player, itemId, amount, coins)
	return amount, coins
end

function ShopService.Sell(player: Player, itemId: any, quantity: any)
	if not atMarket(player) then
		Notify.Error(player, "Go to your market stall to sell.")
		return
	end
	local soldItems, soldCoins = 0, 0
	if itemId == SELL_ALL then
		local items = DataService.Get(player, { "Inventory", "Items" }) or {}
		for id, count in table.clone(items) do
			local def = ItemConfig.Get(id)
			if def and ShopConfig.SellAllCategories[def.Category] then
				local amount, coins = sellOne(player, id, count)
				soldItems += amount
				soldCoins += coins
			end
		end
	else
		if not Validate.Id(itemId) or not ItemConfig.Exists(itemId) then
			AntiExploitService.Flag(player, "SellUnknownItem", 2)
			return
		end
		local count = if quantity == "All" then MAX_QUANTITY else quantity
		if not Validate.Integer(count, 1, MAX_QUANTITY) then
			AntiExploitService.Flag(player, "SellBadQuantity", 2)
			return
		end
		soldItems, soldCoins = sellOne(player, itemId, count)
	end

	if soldItems <= 0 then
		Notify.Error(player, "Nothing to sell.")
		return
	end
	ProgressionService.Award(player, "SellItems")
	local island = IslandService.GetIsland(player)
	if island and island.MarketStall then
		VFXService.PlayAt("CoinBurst", island.MarketStall:GetPivot().Position + Vector3.new(0, 4, 0))
	end
	Notify.Success(player, ("Sold %d item%s for %s 🪙"):format(soldItems, if soldItems == 1 then "" else "s", Format.Commas(soldCoins)), "💰")
end

---------------------------------------------------------------------------
-- Buying
---------------------------------------------------------------------------

local function upgradeCount(player: Player, upgradeId: string): number
	return DataService.Get(player, { "Island", "Upgrades", upgradeId }) or 0
end

-- Returns (ok, reason). Validates everything except the price.
local function canGrant(player: Player, def: any, quantity: number): (boolean, string?)
	local grant = def.Grant
	if grant.Tool then
		if ToolService.HasTool(player, grant.Tool) then
			return false, "You already own that."
		end
	elseif grant.Animal then
		return AnimalService.CanAdd(player, grant.Animal)
	elseif grant.Upgrade then
		if def.MaxOwned and upgradeCount(player, grant.Upgrade) >= def.MaxOwned then
			return false, "You already have the biggest upgrade."
		end
		if grant.Upgrade == "FarmTiles" then
			local tiles = DataService.Get(player, { "Island", "FarmTiles" }) or CropConfig.Farm.StarterTiles
			if tiles >= CropConfig.Farm.Columns * CropConfig.Farm.Rows then
				return false, "Your starter farm is already full size."
			end
		end
	elseif grant.Item then
		if InventoryService.GetFreeSpace(player) < grant.Amount * quantity then
			return false, "Your backpack is too full."
		end
	end
	return true, nil
end

local function grantItem(player: Player, def: any, quantity: number)
	local grant = def.Grant
	if grant.Item then
		InventoryService.AddItem(player, grant.Item, grant.Amount * quantity, "Purchase")
	elseif grant.Tool then
		ToolService.GrantTool(player, grant.Tool, "Purchase")
	elseif grant.Animal then
		AnimalService.AddAnimal(player, grant.Animal)
		-- The first cow comes with a bucket so milking works straight away.
		if grant.Animal == "Cow" and not ToolService.GetBestTool(player, "Bucket") then
			ToolService.GrantTool(player, "WoodenBucket", "CowBonus")
			Notify.Toast(player, "Free Wooden Bucket included for milking!", "🪣")
		end
	elseif grant.Upgrade == "FarmTiles" then
		local tiles = DataService.Get(player, { "Island", "FarmTiles" }) or CropConfig.Farm.StarterTiles
		DataService.Set(player, { "Island", "FarmTiles" }, math.min(tiles + grant.Amount, CropConfig.Farm.Columns * CropConfig.Farm.Rows))
		DataService.Increment(player, { "Island", "Upgrades", "FarmTiles" }, 1)
		FarmService.RefreshFarm(player)
	elseif grant.Upgrade == "Capacity" then
		InventoryService.AddCapacity(player, grant.Amount)
		DataService.Increment(player, { "Island", "Upgrades", "Capacity" }, 1)
	end
end

function ShopService.Purchase(player: Player, shopItemId: any, quantity: any)
	if not Validate.Id(shopItemId) then
		AntiExploitService.Flag(player, "BadPurchase", 2)
		return
	end
	local def = ShopConfig.Items[shopItemId]
	if not def then
		AntiExploitService.Flag(player, "BadPurchase", 2)
		return
	end
	local count = if def.Grant.Item then quantity else 1
	if not Validate.Integer(count, 1, 50) then
		AntiExploitService.Flag(player, "BadPurchaseQuantity", 2)
		return
	end
	if not atMarket(player) then
		Notify.Error(player, "Go to your market stall to shop.")
		return
	end
	local islandLevel = DataService.Get(player, { "Island", "Level" }) or 1
	if islandLevel < (def.UnlockLevel or 1) then
		Notify.Error(player, ("%s unlocks at Island Level %d."):format(def.DisplayName, def.UnlockLevel))
		return
	end
	local ok, reason = canGrant(player, def, count)
	if not ok then
		Notify.Error(player, reason or "You can't buy that right now.")
		return
	end

	local coins = def.Price * count
	local items = {}
	for itemId, amount in def.Items or {} do
		items[itemId] = amount * count
	end
	if not EconomyService.CanAfford(player, coins) then
		Notify.Error(player, ("You need %s 🪙."):format(Format.Commas(coins)))
		return
	end
	if not InventoryService.HasItems(player, items) then
		Notify.Error(player, "You don't have the materials for that.")
		return
	end
	if not EconomyService.SpendCoins(player, coins, "Buy:" .. shopItemId) then
		return
	end
	if not InventoryService.RemoveItems(player, items, "Buy:" .. shopItemId) then
		EconomyService.AddCoins(player, coins, "BuyRefund")
		return
	end

	grantItem(player, def, count)
	if not def.Grant.Animal then
		Notify.Success(player, ("Bought %s%s!"):format(if count > 1 then count .. "x " else "", def.DisplayName), def.Icon)
	end
	ShopService.Purchased:Fire(player, shopItemId, def)
end

---------------------------------------------------------------------------
-- Market stall prompts
---------------------------------------------------------------------------

local function attachStall(_player: Player, island: any)
	local stall = island.MarketStall
	if not stall then
		return
	end
	for _, descendant in stall:GetDescendants() do
		local role = descendant:GetAttribute("PromptRole")
		if role == "Sell" then
			InteractionService.Attach(descendant, "MarketSell", { OwnerUserId = island.OwnerUserId })
		elseif role == "Shop" then
			InteractionService.Attach(descendant, "MarketShop", {
				OwnerUserId = island.OwnerUserId,
				KeyboardKeyCode = Enum.KeyCode.F,
				GamepadKeyCode = Enum.KeyCode.ButtonY,
			})
		end
	end
end

function ShopService.Init()
	InteractionService.RegisterKind("MarketSell", {
		ActionText = "Sell",
		ObjectText = "Market",
		Permission = "Owner",
		MaxDistance = 12,
		Cooldown = 0.5,
		Handler = function(player: Player)
			Net.FireClient("OpenUI", player, { Screen = "Market", Tab = "Sell" })
		end,
	})
	InteractionService.RegisterKind("MarketShop", {
		ActionText = "Shop",
		ObjectText = "Market",
		Permission = "Owner",
		MaxDistance = 12,
		Cooldown = 0.5,
		Handler = function(player: Player)
			Net.FireClient("OpenUI", player, { Screen = "Market", Tab = "Buy" })
		end,
	})
	Net.OnServerEvent("SellItemRequest", ShopService.Sell)
	Net.OnServerEvent("PurchaseRequest", ShopService.Purchase)
end

function ShopService.Start()
	IslandService.IslandAssigned:Connect(attachStall)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">SoundService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  SoundService  (game service wrapper — not Roblox's SoundService)
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/SoundService
	DEPENDENCIES: Shared.Net, Shared.Config.SoundConfig

	Server-side entry point for gameplay sounds. The server decides WHAT
	happened; clients (AudioController) do the actual playback so sounds are
	pooled and never replicate as Instances.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local SoundConfig = require(Shared.Config.SoundConfig)

local HEARING_RANGE = 150

local GameSoundService = {}

local function isKnown(soundName: string): boolean
	if SoundConfig.Sounds[soundName] then
		return true
	end
	warn("[SoundService] Unknown sound '" .. tostring(soundName) .. "'")
	return false
end

-- 2D sound for one player (UI-style).
function GameSoundService.PlayFor(player: Player, soundName: string)
	if isKnown(soundName) then
		Net.FireClient("PlaySound", player, soundName, nil)
	end
end

-- 3D sound heard by everyone near `position`.
function GameSoundService.PlayAt(soundName: string, position: Vector3)
	if not isKnown(soundName) then
		return
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - position).Magnitude <= HEARING_RANGE then
			Net.FireClient("PlaySound", player, soundName, position)
		end
	end
end

return GameSoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/ToolService
	DEPENDENCIES: DataService, AntiExploitService, SoundService, Server.Tools.ToolModelFactory,
	              Shared.Config.ToolConfig, Shared.Util.{R15, Validate}, Shared.Net

	Tool framework (spec §18, §77, §78):
	  * ownership + hotbar live in the profile (Tools.Owned / Tools.Hotbar),
	  * equipping is SERVER-authoritative: the client asks, the server checks
	    ownership, builds the model and joins it to the R15 hand with a
	    Motor6D named "ToolGrip" (Part0 = RightHand, C0 = RightGripAttachment),
	    so the tool never floats and can be keyframed by real animations,
	  * the character gets attribute EquippedTool = toolId, which clients use
	    to play the matching hold/use animations from ToolConfig.

	Roblox's own Tool/Backpack system is intentionally NOT used: we need
	custom grips, custom hotbar UI and server-controlled tool stats.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local ToolConfig = require(Shared.Config.ToolConfig)
local R15 = require(Shared.Util.R15)
local Validate = require(Shared.Util.Validate)

local Services = script.Parent
local DataService = require(Services.DataService)
local AntiExploitService = require(Services.AntiExploitService)
local GameSoundService = require(Services.SoundService)
local ToolModelFactory = require(script.Parent.Parent.Tools.ToolModelFactory)

local ToolService = {}

local equippedModels: { [Player]: Model } = {}

function ToolService.HasTool(player: Player, toolId: string): boolean
	return DataService.Get(player, { "Tools", "Owned", toolId }) == true
end

function ToolService.GetEquippedId(player: Player): string?
	local equipped = DataService.Get(player, { "Tools", "Equipped" })
	if type(equipped) == "string" and equipped ~= "" then
		return equipped
	end
	return nil
end

function ToolService.GetEquipped(player: Player): any
	local toolId = ToolService.GetEquippedId(player)
	return toolId and ToolConfig.Get(toolId)
end

-- Best owned tool of a type (highest tier), used by gathering in Phase 2.
function ToolService.GetBestTool(player: Player, toolType: string): any
	local owned = DataService.Get(player, { "Tools", "Owned" })
	local best = nil
	if owned then
		for toolId in owned do
			local def = ToolConfig.Get(toolId)
			if def and def.Type == toolType and (best == nil or def.TierOrder > best.TierOrder) then
				best = def
			end
		end
	end
	return best
end

function ToolService.GrantTool(player: Player, toolId: string, reason: string): boolean
	if not ToolConfig.Get(toolId) then
		warn(("[ToolService] Unknown tool %s (%s)"):format(tostring(toolId), reason))
		return false
	end
	if not DataService.IsLoaded(player) or ToolService.HasTool(player, toolId) then
		return false
	end
	DataService.Set(player, { "Tools", "Owned", toolId }, true)
	local def = ToolConfig.Get(toolId)
	local hotbar = table.clone(DataService.Get(player, { "Tools", "Hotbar" }) or {})
	if not table.find(hotbar, toolId) then
		-- An upgrade replaces the weaker tool of the same type in its slot.
		local replaced = false
		for index, existingId in hotbar do
			local existing = ToolConfig.Get(existingId)
			if existing and existing.Type == def.Type and existing.TierOrder < def.TierOrder then
				hotbar[index] = toolId
				replaced = true
				if ToolService.GetEquippedId(player) == existingId then
					task.defer(ToolService.Equip, player, toolId)
				end
				break
			end
		end
		if not replaced and #hotbar < ToolConfig.HotbarSize then
			table.insert(hotbar, toolId)
		end
		DataService.Set(player, { "Tools", "Hotbar" }, hotbar)
	end
	return true
end

-- Equips the best owned tool of a type (used by prompt actions: "Chop Tree"
-- equips your axe). Returns the tool definition or nil if none is owned.
function ToolService.EquipBestOfType(player: Player, toolType: string): any
	local best = ToolService.GetBestTool(player, toolType)
	if not best then
		return nil
	end
	if ToolService.GetEquippedId(player) ~= best.Id then
		ToolService.Equip(player, best.Id)
	end
	return best
end

local function destroyModel(player: Player)
	local model = equippedModels[player]
	if model then
		equippedModels[player] = nil
		model:Destroy()
	end
end

local function attachModel(character: Model, toolDef: any): Model?
	local handName = toolDef.Grip.Hand
	local hand = R15.GetPart(character, handName)
	if not hand then
		return nil
	end
	local model = ToolModelFactory.Build(toolDef)
	local handle = model.PrimaryPart
	local grip = handle and handle:FindFirstChild("Grip")
	if not handle or not grip or not grip:IsA("Attachment") then
		model:Destroy()
		return nil
	end

	local gripAttachment = hand:FindFirstChild(R15.GripAttachments[handName] or "")
	local handGrip = if gripAttachment and gripAttachment:IsA("Attachment")
		then gripAttachment.CFrame
		else CFrame.new(0, -hand.Size.Y / 2, 0) * CFrame.Angles(-math.pi / 2, 0, 0)

	local motor = Instance.new("Motor6D")
	motor.Name = "ToolGrip"
	motor.Part0 = hand
	motor.Part1 = handle
	motor.C0 = handGrip * toolDef.Grip.Offset
	motor.C1 = grip.CFrame
	-- Move the whole model (PrimaryPart = Handle) next to the hand before joining it.
	model:PivotTo(hand.CFrame * motor.C0 * motor.C1:Inverse())
	model.Parent = character
	motor.Parent = hand
	return model
end

-- Server-side equip. toolId nil/"" unequips. Returns success.
function ToolService.Equip(player: Player, toolId: string?): boolean
	if not DataService.IsLoaded(player) then
		return false
	end
	local character = player.Character
	destroyModel(player)
	if character then
		for handName in R15.GripAttachments do
			local hand = R15.GetPart(character, handName)
			local stale = hand and hand:FindFirstChild("ToolGrip")
			if stale then
				stale:Destroy()
			end
		end
	end

	if toolId == nil or toolId == "" then
		DataService.Set(player, { "Tools", "Equipped" }, "")
		if character then
			character:SetAttribute("EquippedTool", nil)
		end
		return true
	end

	local toolDef = ToolConfig.Get(toolId)
	if not toolDef or not ToolService.HasTool(player, toolId) then
		return false
	end
	DataService.Set(player, { "Tools", "Equipped" }, toolId)
	if not DataService.Get(player, { "Flags", "FirstEquip" }) then
		DataService.Set(player, { "Flags", "FirstEquip" }, true)
	end

	if not character or not R15.IsAlive(character) then
		return true -- saved; the model is attached on next spawn
	end
	local model = attachModel(character, toolDef)
	if not model then
		warn("[ToolService] Could not attach " .. toolId .. " to " .. player.Name .. " (is the rig R15?)")
		return false
	end
	equippedModels[player] = model
	character:SetAttribute("EquippedTool", toolId)
	local root = R15.GetRootPart(character)
	if root then
		GameSoundService.PlayAt("ToolEquip", root.Position)
	end
	return true
end

-- Called by PlayerService after each (re)spawn.
function ToolService.OnCharacterSpawned(player: Player, _character: Model)
	local equipped = ToolService.GetEquippedId(player)
	if equipped then
		ToolService.Equip(player, equipped)
	end
end

function ToolService.OnPlayerRemoving(player: Player)
	destroyModel(player)
end

function ToolService.Init()
	Net.OnServerEvent("EquipToolRequest", function(player: Player, toolId: any)
		if toolId == nil or toolId == "" then
			ToolService.Equip(player, nil)
			return
		end
		if not Validate.Id(toolId) or not ToolConfig.Get(toolId) then
			AntiExploitService.Flag(player, "InvalidToolId", 2)
			return
		end
		if not ToolService.HasTool(player, toolId) then
			AntiExploitService.Flag(player, "EquipUnownedTool", 1)
			return
		end
		ToolService.Equip(player, toolId)
	end)
end

return ToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">VFXService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  VFXService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/VFXService
	DEPENDENCIES: Shared.Net, Shared.Config.{VFXConfig, GameConfig}

	Server-side entry point for effects and camera feedback. Clients render
	them (VFXController / CameraController) with pooling and distance culling.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local VFXConfig = require(Shared.Config.VFXConfig)
local GameConfig = require(Shared.Config.GameConfig)

local VFXService = {}

local function isKnown(effectName: string): boolean
	if VFXConfig.Effects[effectName] then
		return true
	end
	warn("[VFXService] Unknown effect '" .. tostring(effectName) .. "'")
	return false
end

-- Everyone nearby sees it (clients cull by VFXConfig.MaxDistance).
function VFXService.PlayAt(effectName: string, position: Vector3)
	if isKnown(effectName) then
		Net.FireAllClients("PlayVFX", effectName, position)
	end
end

-- Only one player sees it (personal feedback).
function VFXService.PlayFor(player: Player, effectName: string, position: Vector3)
	if isKnown(effectName) then
		Net.FireClient("PlayVFX", player, effectName, position)
	end
end

function VFXService.ShakeCamera(player: Player, intensity: number, duration: number?)
	local capped = math.clamp(intensity, 0, GameConfig.Camera.MaxShakeIntensity)
	Net.FireClient("CameraShake", player, capped, duration or 0.3)
end

return VFXService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  WorldService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/WorldService
	DEPENDENCIES: Shared.Config.{GameConfig, IslandConfig}, Shared.Util.IslandLayout

	Shared world setup (not owned by any single player):
	  * the Workspace folder structure,
	  * base lighting + atmosphere (WeatherService takes over in Phase 13),
	  * terrain materials + the ocean around every island slot.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandLayout = require(Shared.Util.IslandLayout)

local WorldConfig = GameConfig.World

local WORKSPACE_FOLDERS = { "Islands", "ResourceZones", "NPCs", "FishingZones", "World" }

local WorldService = {}

WorldService.Folders = {} :: { [string]: Folder }

function WorldService.GetFolder(name: string): Folder
	local folder = WorldService.Folders[name]
	assert(folder, "Unknown workspace folder " .. name)
	return folder
end

local function ensureFolders()
	for _, name in WORKSPACE_FOLDERS do
		local folder = workspace:FindFirstChild(name)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = name
			folder.Parent = workspace
		end
		WorldService.Folders[name] = folder :: Folder
	end
end

local function applyLighting()
	Lighting.ClockTime = WorldConfig.ClockTime
	Lighting.Brightness = WorldConfig.Brightness
	Lighting.Ambient = WorldConfig.Ambient
	Lighting.OutdoorAmbient = WorldConfig.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = WorldConfig.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = WorldConfig.EnvironmentSpecularScale
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = WorldConfig.Atmosphere.Density
	atmosphere.Offset = WorldConfig.Atmosphere.Offset
	atmosphere.Color = WorldConfig.Atmosphere.Color
	atmosphere.Decay = WorldConfig.Atmosphere.Decay
	atmosphere.Glare = WorldConfig.Atmosphere.Glare
	atmosphere.Haze = WorldConfig.Atmosphere.Haze
	atmosphere.Parent = Lighting

	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.4
		bloom.Size = 20
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local color = Instance.new("ColorCorrectionEffect")
		color.Saturation = 0.12
		color.Contrast = 0.05
		color.Parent = Lighting
	end
end

local function applyTerrainLook()
	local terrain = workspace.Terrain :: Terrain
	terrain.WaterColor = WorldConfig.WaterColor
	terrain.WaterTransparency = WorldConfig.WaterTransparency
	terrain.WaterReflectance = WorldConfig.WaterReflectance
	terrain.WaterWaveSize = WorldConfig.WaterWaveSize
	terrain.WaterWaveSpeed = WorldConfig.WaterWaveSpeed
	-- Note: Terrain.Decoration (animated grass) can't be set from scripts;
	-- toggle it on Workspace.Terrain in Studio's Properties window instead.
	for materialName, color in WorldConfig.MaterialColors do
		local material = (Enum.Material :: any)[materialName]
		if material then
			terrain:SetMaterialColor(material, color)
		end
	end
end

-- Fills the ocean (water + sand seabed) under every island slot, in tiles.
local function fillOcean()
	local terrain = workspace.Terrain :: Terrain
	local slotCount = GameConfig.MaxIslandsPerServer
	local rows = math.ceil(slotCount / IslandConfig.SlotsPerRow)
	local columns = math.min(slotCount, IslandConfig.SlotsPerRow)
	local margin = WorldConfig.OceanMargin
	local minX = -margin
	local minZ = -margin
	local maxX = (columns - 1) * IslandConfig.SlotSpacing + margin
	local maxZ = (rows - 1) * IslandConfig.SlotSpacing + margin
	local tile = WorldConfig.OceanTileSize
	local sea = IslandConfig.SeaLevel
	local depth = WorldConfig.OceanDepth
	local bed = WorldConfig.SeabedThickness

	for x = minX, maxX - 1, tile do
		for z = minZ, maxZ - 1, tile do
			local sizeX = math.min(tile, maxX - x)
			local sizeZ = math.min(tile, maxZ - z)
			local centerX = x + sizeX / 2
			local centerZ = z + sizeZ / 2
			terrain:FillBlock(CFrame.new(centerX, sea - depth / 2, centerZ), Vector3.new(sizeX, depth, sizeZ), Enum.Material.Water)
			terrain:FillBlock(CFrame.new(centerX, sea - depth - bed / 2, centerZ), Vector3.new(sizeX, bed, sizeZ), Enum.Material.Sand)
		end
		task.wait() -- spread the work over a few frames
	end
end

-- Restores open ocean in a cylinder (used when an island is cleaned up).
function WorldService.RestoreOcean(center: Vector3, radius: number)
	local terrain = workspace.Terrain :: Terrain
	local sea = IslandConfig.SeaLevel
	local depth = WorldConfig.OceanDepth
	local bed = WorldConfig.SeabedThickness
	local airHeight = 120
	terrain:FillCylinder(CFrame.new(center.X, sea + airHeight / 2, center.Z), airHeight, radius, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(center.X, sea - depth / 2, center.Z), depth, radius, Enum.Material.Water)
	terrain:FillCylinder(CFrame.new(center.X, sea - depth - bed / 2, center.Z), bed, radius, Enum.Material.Sand)
end

function WorldService.Init()
	ensureFolders()
end

function WorldService.Start()
	applyLighting()
	applyTerrainLook()
	fillOcean()
	-- Slot 1 origin sanity check for the log (helps when debugging layouts).
	if GameConfig.Debug then
		print("[WorldService] Ocean ready. Slot 1 origin:", IslandLayout.GetSlotOrigin(1).Position)
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="83">
        <Properties>
          <string name="Name">Tools</string>
        </Properties>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">ToolModelFactory</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolModelFactory
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Tools/ToolModelFactory
	DEPENDENCIES: none (reads ToolConfig definitions passed in)
	REQUIRED OBJECTS: optional art in ServerStorage/Tools/<ToolId>

	Builds the physical tool model that ToolService welds into the R15 hand.

	CUSTOM ART: put a Model named exactly like the tool id (e.g. "WoodenAxe")
	in ServerStorage/Tools. It must contain:
	  * a BasePart named "Handle"
	  * an Attachment named "Grip" inside Handle, positioned where the palm
	    holds it. The Grip's +Y axis points along the tool (towards the head),
	    its -Z axis points where the blade/tip faces.
	If no art exists, a clean low-poly placeholder is generated from the
	tool's Shape + tier colours so the game is fully playable today.
]]

local ServerStorage = game:GetService("ServerStorage")

local HANDLE_COLOR = Color3.fromRGB(125, 85, 50)

type PartSpec = {
	Name: string,
	Size: Vector3,
	Offset: CFrame,
	Head: boolean?, -- uses the tier colour/material
	Color: Color3?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
}

type ShapeSpec = { HandleLength: number, HandleThickness: number, Parts: { PartSpec } }

-- Handle is centred at the origin with its long axis along +Y.
local SHAPES: { [string]: ShapeSpec } = {
	Axe = {
		HandleLength = 3.2,
		HandleThickness = 0.25,
		Parts = {
			{ Name = "Blade", Size = Vector3.new(0.2, 0.85, 1.1), Offset = CFrame.new(0, 1.2, -0.55), Head = true },
			{ Name = "Poll", Size = Vector3.new(0.3, 0.45, 0.35), Offset = CFrame.new(0, 1.2, 0.2), Head = true },
		},
	},
	Pickaxe = {
		HandleLength = 3.2,
		HandleThickness = 0.25,
		Parts = {
			{ Name = "Head", Size = Vector3.new(0.3, 0.3, 2.4), Offset = CFrame.new(0, 1.45, 0), Head = true },
			{ Name = "TipA", Size = Vector3.new(0.2, 0.2, 0.4), Offset = CFrame.new(0, 1.35, -1.3), Head = true },
			{ Name = "TipB", Size = Vector3.new(0.2, 0.2, 0.4), Offset = CFrame.new(0, 1.35, 1.3), Head = true },
		},
	},
	Hammer = {
		HandleLength = 2.4,
		HandleThickness = 0.25,
		Parts = {
			{ Name = "Head", Size = Vector3.new(0.6, 0.6, 1.3), Offset = CFrame.new(0, 1.1, 0), Head = true },
		},
	},
	Shovel = {
		HandleLength = 3.8,
		HandleThickness = 0.22,
		Parts = {
			{ Name = "Blade", Size = Vector3.new(0.12, 1.1, 0.9), Offset = CFrame.new(0, 2.3, 0), Head = true },
			{ Name = "Grip", Size = Vector3.new(0.25, 0.25, 0.7), Offset = CFrame.new(0, -1.9, 0) },
		},
	},
	Hoe = {
		HandleLength = 3.8,
		HandleThickness = 0.22,
		Parts = {
			{ Name = "Blade", Size = Vector3.new(0.15, 0.35, 0.9), Offset = CFrame.new(0, 1.85, -0.4), Head = true },
		},
	},
	WateringCan = {
		HandleLength = 0.9,
		HandleThickness = 0.2,
		Parts = {
			{ Name = "Body", Size = Vector3.new(0.9, 1, 1.2), Offset = CFrame.new(0, 0.6, -0.2), Head = true },
			{ Name = "Spout", Size = Vector3.new(0.15, 0.15, 1.1), Offset = CFrame.new(0, 0.9, -1.2) * CFrame.Angles(math.rad(25), 0, 0), Head = true },
		},
	},
	FishingRod = {
		HandleLength = 5.5,
		HandleThickness = 0.14,
		Parts = {
			{ Name = "Reel", Size = Vector3.new(0.35, 0.35, 0.35), Offset = CFrame.new(0, -1.9, 0.2), Head = true, Shape = Enum.PartType.Ball },
			{ Name = "Tip", Size = Vector3.new(0.1, 0.3, 0.1), Offset = CFrame.new(0, 2.85, 0), Color = Color3.fromRGB(230, 60, 60), Material = Enum.Material.SmoothPlastic },
		},
	},
	Bucket = {
		HandleLength = 0.8,
		HandleThickness = 0.12,
		Parts = {
			{ Name = "Pail", Size = Vector3.new(1.1, 1, 1.1), Offset = CFrame.new(0, -0.7, 0), Head = true },
		},
	},
	Shears = {
		HandleLength = 1,
		HandleThickness = 0.2,
		Parts = {
			{ Name = "BladeA", Size = Vector3.new(0.08, 1, 0.18), Offset = CFrame.new(0.06, 0.9, 0) * CFrame.Angles(0, 0, math.rad(6)), Head = true },
			{ Name = "BladeB", Size = Vector3.new(0.08, 1, 0.18), Offset = CFrame.new(-0.06, 0.9, 0) * CFrame.Angles(0, 0, math.rad(-6)), Head = true },
		},
	},
}

local ToolModelFactory = {}

local function preparePart(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = true
end

local function fromCustomArt(toolId: string): Model?
	local folder = ServerStorage:FindFirstChild("Tools")
	local template = folder and folder:FindFirstChild(toolId)
	if not template or not template:IsA("Model") then
		return nil
	end
	local model = template:Clone()
	local handle = model:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") or not handle:FindFirstChild("Grip") then
		warn(("[Tools] ServerStorage.Tools.%s needs a Handle part with a Grip attachment; using placeholder"):format(toolId))
		model:Destroy()
		return nil
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			preparePart(descendant)
		end
	end
	model.PrimaryPart = handle
	return model
end

local function fromShape(toolDef: any): Model
	local shape = SHAPES[toolDef.Shape] or SHAPES.Hammer
	local model = Instance.new("Model")

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(shape.HandleThickness, shape.HandleLength, shape.HandleThickness)
	handle.Color = HANDLE_COLOR
	handle.Material = Enum.Material.Wood
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	preparePart(handle)
	handle.CFrame = CFrame.new()
	handle.Parent = model

	local grip = Instance.new("Attachment")
	grip.Name = "Grip"
	grip.Position = Vector3.new(0, -shape.HandleLength / 2 + 0.45, 0)
	grip.Parent = handle

	for _, spec in shape.Parts do
		local part = Instance.new("Part")
		part.Name = spec.Name
		part.Shape = spec.Shape or Enum.PartType.Block
		part.Size = spec.Size
		part.Color = if spec.Head then toolDef.HeadColor else (spec.Color or HANDLE_COLOR)
		part.Material = if spec.Head then toolDef.HeadMaterial else (spec.Material or Enum.Material.Wood)
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		preparePart(part)
		part.CFrame = handle.CFrame * spec.Offset
		-- Explicit C0 (not WeldConstraint) so the offset is exact no matter
		-- where the parts are when the model enters the workspace.
		local weld = Instance.new("Weld")
		weld.Part0 = handle
		weld.Part1 = part
		weld.C0 = spec.Offset
		weld.Parent = part
		part.Parent = model
	end

	model.PrimaryPart = handle
	return model
end

-- Returns a Model with PrimaryPart "Handle" containing a "Grip" Attachment.
function ToolModelFactory.Build(toolDef: any): Model
	local model = fromCustomArt(toolDef.Id) or fromShape(toolDef)
	model.Name = "EquippedTool"
	model:SetAttribute("ToolId", toolDef.Id)
	return model
end

return ToolModelFactory
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="85">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Notify
	SCRIPT TYPE:  ModuleScript (server helper)
	WHERE:        ServerScriptService/Server/Util/Notify
	DEPENDENCIES: Shared.Net

	Consistent "Did that work?" feedback (spec §151). Every server action that
	succeeds or fails tells the player through one of these.

	Kinds understood by the client UI:
		Toast   small message under the top bar
		Success green toast
		Error   red toast + error sound
		Banner  big centred title (level up, area unlocked, build complete)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local Notify = {}

function Notify.Toast(player: Player, text: string, icon: string?)
	Net.FireClient("Notify", player, { Kind = "Toast", Text = text, Icon = icon })
end

function Notify.Success(player: Player, text: string, icon: string?)
	Net.FireClient("Notify", player, { Kind = "Success", Text = text, Icon = icon })
end

function Notify.Error(player: Player, text: string)
	Net.FireClient("Notify", player, { Kind = "Error", Text = text, Icon = "⚠️" })
end

function Notify.Banner(player: Player, title: string, subtitle: string?, style: string?)
	Net.FireClient("Notify", player, { Kind = "Banner", Text = title, Subtitle = subtitle, Style = style })
end

return Notify
]]></string>
          </Properties>
        </Item>
