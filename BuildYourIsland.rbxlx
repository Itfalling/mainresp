      <Item class="Script" referent="41">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Main
	SCRIPT TYPE:  Script (server entry point)
	WHERE:        ServerScriptService/Server/Main
	DEPENDENCIES: every module in ServerScriptService/Server/Services, Shared.Net

	Boots the server in a deterministic order:
	  1. Net.Init()        create ReplicatedStorage/Remotes from RemoteConfig
	  2. Service.Init()    register handlers/kinds; no cross-service calls that yield
	  3. Service.Start()   connect events, start loops, accept players
	  4. Net.FinalizeHandlers()  drain remotes no phase handles yet

	Every service boots in isolation: if one fails, the error is logged with a
	traceback, published to ReplicatedStorage's "ServerBootErrors" attribute
	(the client shows it on screen), and the remaining services still start.

	SERVICE LAYERS (a service may only require services ABOVE it in this list,
	which keeps require() free of cycles):
		DataService, AntiExploitService, WorldService, SoundService, VFXService, AnimationService
		EconomyService, InventoryService, ProgressionService
		InteractionService, ToolService
		IslandService
		PlayerService, AdminService
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Services = script.Parent.Services

local SERVICE_ORDER = {
	"DataService",
	"AntiExploitService",
	"WorldService",
	"SoundService",
	"VFXService",
	"AnimationService",
	"EconomyService",
	"InventoryService",
	"ProgressionService",
	"InteractionService",
	"ToolService",
	"IslandService",
	"PlayerService",
	"AdminService",
}

local bootErrors: { string } = {}

local function report(label: string, err: any)
	local message = ("%s failed: %s"):format(label, tostring(err))
	warn("[Build Your Island] " .. message)
	table.insert(bootErrors, message)
	ReplicatedStorage:SetAttribute("ServerBootErrors", table.concat(bootErrors, "\n"))
end

Net.Init()

local loaded = {}
for _, name in SERVICE_ORDER do
	local module = Services:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok then
			loaded[name] = result :: any
		else
			report(name .. " (require)", result)
		end
	else
		report(name, "module is missing from ServerScriptService/Server/Services")
	end
end

for _, phase in { "Init", "Start" } do
	for _, name in SERVICE_ORDER do
		local service = loaded[name]
		if service and type(service[phase]) == "function" then
			local ok, err = xpcall(service[phase], debug.traceback)
			if not ok then
				report(name .. "." .. phase, err)
			end
		end
	end
end

Net.FinalizeHandlers()

if #bootErrors == 0 then
	print("[Build Your Island] Server ready —", #SERVICE_ORDER, "services started")
else
	warn(("[Build Your Island] Server started with %d error(s) — see messages above"):format(#bootErrors))
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AdminService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AdminService
	DEPENDENCIES: DataService, EconomyService, InventoryService, ProgressionService,
	              IslandService, ToolService, Shared.Config.GameConfig, Server.Util.Notify

	Secure chat commands (spec §139). Authorised = UserId in
	GameConfig.AdminUserIds, or anyone in Studio when AdminsInStudio = true.
	Commands are parsed on the SERVER — from server-created TextChatCommands
	(TextChatService) or Player.Chatted (legacy chat) — so nothing a client
	sends can run them. Every command goes through the normal services, so
	admin changes are validated, saved and replicated like any other change.

	  /givecoins <player|me> <amount>
	  /givegems <player|me> <amount>
	  /giveitem <player|me> <itemId> <amount>
	  /givetool <player|me> <toolId>
	  /givexp <player|me> <amount>
	  /giveislandxp <player|me> <amount>
	  /setislandlevel <player|me> <level>
	  /unlockarea <player|me> <areaId>     (charges nothing; bypasses requirements)
	  /save <player|me>
	  /resetdata <player|me>               (Studio only)
	  /debug [player|me]
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local IslandConfig = require(Shared.Config.IslandConfig)

local Services = script.Parent
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local IslandService = require(Services.IslandService)
local ToolService = require(Services.ToolService)
local Notify = require(script.Parent.Parent.Util.Notify)

local AdminService = {}

type Command = (admin: Player, args: { string }) -> string

local function isAdmin(player: Player): boolean
	if GameConfig.AdminsInStudio and RunService:IsStudio() then
		return true
	end
	return table.find(GameConfig.AdminUserIds, player.UserId) ~= nil
end

local function findPlayer(admin: Player, query: string?): Player?
	if not query or query == "" or string.lower(query) == "me" then
		return admin
	end
	local lowered = string.lower(query)
	for _, player in Players:GetPlayers() do
		if string.lower(player.Name) == lowered or string.lower(player.DisplayName) == lowered then
			return player
		end
	end
	for _, player in Players:GetPlayers() do
		if string.sub(string.lower(player.Name), 1, #lowered) == lowered then
			return player
		end
	end
	return nil
end

local function toInteger(text: string?): number?
	local value = tonumber(text)
	if value and value == value and math.abs(value) < 1e12 then
		return math.floor(value)
	end
	return nil
end

local COMMANDS: { [string]: Command } = {
	givecoins = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /givecoins <player|me> <amount>"
		end
		return if EconomyService.AddCoins(target, amount, "Admin:" .. admin.Name) then "Gave coins" else "Failed"
	end,
	givegems = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /givegems <player|me> <amount>"
		end
		return if EconomyService.AddGems(target, amount, "Admin:" .. admin.Name) then "Gave gems" else "Failed"
	end,
	giveitem = function(admin, args)
		local target, itemId, amount = findPlayer(admin, args[1]), args[2], toInteger(args[3] or "1")
		if not target or not itemId or not amount then
			return "Usage: /giveitem <player|me> <itemId> <amount>"
		end
		local added = InventoryService.AddItem(target, itemId, amount, "Admin:" .. admin.Name, { IgnoreCapacity = true })
		return ("Added %d %s"):format(added, itemId)
	end,
	givetool = function(admin, args)
		local target, toolId = findPlayer(admin, args[1]), args[2]
		if not target or not toolId then
			return "Usage: /givetool <player|me> <toolId>"
		end
		return if ToolService.GrantTool(target, toolId, "Admin:" .. admin.Name) then "Granted " .. toolId else "Unknown or already owned"
	end,
	givexp = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /givexp <player|me> <amount>"
		end
		ProgressionService.AddPlayerXP(target, amount, "Admin")
		return "Gave XP"
	end,
	giveislandxp = function(admin, args)
		local target, amount = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not amount then
			return "Usage: /giveislandxp <player|me> <amount>"
		end
		ProgressionService.AddIslandXP(target, amount, "Admin")
		return "Gave island XP"
	end,
	setislandlevel = function(admin, args)
		local target, level = findPlayer(admin, args[1]), toInteger(args[2])
		if not target or not level then
			return "Usage: /setislandlevel <player|me> <level>"
		end
		ProgressionService.SetIslandLevel(target, level)
		return "Island level set"
	end,
	unlockarea = function(admin, args)
		local target, areaId = findPlayer(admin, args[1]), args[2]
		if not target or not areaId or not IslandConfig.Areas[areaId] then
			return "Usage: /unlockarea <player|me> <areaId>"
		end
		local unlock = IslandConfig.Areas[areaId].Unlock
		-- Grant exactly what the unlock needs, then go through the real unlock path.
		if unlock then
			ProgressionService.SetIslandLevel(target, math.max(DataService.Get(target, { "Island", "Level" }) or 1, unlock.IslandLevel or 1))
			if unlock.RequiresArea then
				DataService.Set(target, { "Island", "UnlockedAreas", unlock.RequiresArea }, true)
			end
			if (unlock.Coins or 0) > 0 then
				EconomyService.AddCoins(target, unlock.Coins, "Admin:unlockarea")
			end
		end
		local ok, message = IslandService.TryUnlockArea(target, areaId)
		return if ok then "Unlocked " .. areaId else tostring(message)
	end,
	save = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /save <player|me>"
		end
		return if DataService.SaveNow(target) then "Saved" else "Save failed (see output)"
	end,
	resetdata = function(admin, args)
		if not RunService:IsStudio() then
			return "resetdata is Studio-only"
		end
		local target = findPlayer(admin, args[1])
		if not target then
			return "Usage: /resetdata <player|me>"
		end
		DataService.ResetProfile(target)
		return "Profile reset — rejoin to rebuild the island"
	end,
	debug = function(admin, args)
		local target = findPlayer(admin, args[1])
		if not target then
			return "Player not found"
		end
		local island = IslandService.GetIsland(target)
		local data = DataService.GetData(target)
		local report = {
			Player = target.Name,
			IslandId = island and island.Id,
			Slot = island and island.SlotIndex,
			IslandLevel = data and data.Island.Level,
			Coins = data and data.Coins,
			Equipped = ToolService.GetEquippedId(target),
			Save = DataService.GetDebugState(target),
		}
		print("[Admin /debug]", HttpService:JSONEncode(report))
		return "Debug info printed to the server output"
	end,
}

local function onChatted(player: Player, message: string)
	if string.sub(message, 1, 1) ~= "/" then
		return
	end
	local parts = string.split(string.sub(message, 2), " ")
	local name = string.lower(table.remove(parts, 1) or "")
	local command = COMMANDS[name]
	if not command then
		return
	end
	if not isAdmin(player) then
		return
	end
	local ok, result = pcall(command, player, parts)
	if ok then
		Notify.Toast(player, "[Admin] " .. tostring(result), "🛠️")
	else
		warn("[AdminService] /" .. name .. " failed: " .. tostring(result))
		Notify.Error(player, "[Admin] Command failed")
	end
end

-- TextChatService: server-owned TextChatCommands fire Triggered on the server.
local function registerTextChatCommands()
	local folder = Instance.new("Folder")
	folder.Name = "IslandAdminCommands"
	for name in COMMANDS do
		local command = Instance.new("TextChatCommand")
		command.Name = name
		command.PrimaryAlias = "/" .. name
		command.AutocompleteVisible = false
		command.Triggered:Connect(function(source: TextSource, text: string)
			local player = Players:GetPlayerByUserId(source.UserId)
			if player then
				onChatted(player, text)
			end
		end)
		command.Parent = folder
	end
	folder.Parent = TextChatService
end

function AdminService.Start()
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		registerTextChatCommands()
		return
	end
	local function hook(player: Player)
		player.Chatted:Connect(function(message)
			onChatted(player, message)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">AnimationService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AnimationService
	DEPENDENCIES: Shared.Net, Shared.Animation.AnimationPlayer, Shared.Config.AnimationConfig,
	              Shared.Util.AssetId

	Server half of the centralized animation system (spec §71).
	  * Player characters: the OWNING CLIENT plays animations (responsive, and
	    Animator replication shows them to everyone). The server sends an
	    AnimationCommand to that client.
	  * NPCs / animals (server-owned rigs): played directly here through the
	    same shared AnimationPlayer.
	  * Movement animation overrides: real ids placed in
	    AnimationConfig.Movement are written into each character's default
	    Animate script on spawn.

	API (spec §71):
		PlayAnimation(rig, name, options?) -> handle | nil (nil for player rigs)
		StopAnimation(rig, name, fade?)
		StopAllAnimations(rig, fade?)
		GetAnimation(rig, name) -> handle
		SetAnimationSpeed(rig, name, speed)
		IsPlaying(rig, name) -> boolean   (server rigs only)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local AnimationPlayer = require(Shared.Animation.AnimationPlayer)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local AssetId = require(Shared.Util.AssetId)

local AnimationService = {}

local players: { [Model]: any } = {}

local function getPlayerForRig(rig: Model): Player?
	return Players:GetPlayerFromCharacter(rig)
end

local function getPlayer(rig: Model)
	local animationPlayer = players[rig]
	if not animationPlayer then
		animationPlayer = AnimationPlayer.new(rig)
		players[rig] = animationPlayer
		rig.Destroying:Once(function()
			local existing = players[rig]
			if existing then
				existing:Destroy()
				players[rig] = nil
			end
		end)
	end
	return animationPlayer
end

function AnimationService.PlayAnimation(rig: Model, name: string, options: { Speed: number? }?): any
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "Play", Name = name, Speed = options and options.Speed })
		return nil
	end
	return getPlayer(rig):Play(name, options)
end

function AnimationService.StopAnimation(rig: Model, name: string, fadeTime: number?)
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "Stop", Name = name, Fade = fadeTime })
		return
	end
	local animationPlayer = players[rig]
	if animationPlayer then
		animationPlayer:Stop(name, fadeTime)
	end
end

function AnimationService.StopAllAnimations(rig: Model, fadeTime: number?)
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "StopAll", Fade = fadeTime })
		return
	end
	local animationPlayer = players[rig]
	if animationPlayer then
		animationPlayer:StopAll(fadeTime)
	end
end

function AnimationService.GetAnimation(rig: Model, name: string): any
	local animationPlayer = players[rig]
	return animationPlayer and animationPlayer:GetHandle(name)
end

function AnimationService.SetAnimationSpeed(rig: Model, name: string, speed: number)
	local owner = getPlayerForRig(rig)
	if owner then
		Net.FireClient("AnimationCommand", owner, { Op = "Speed", Name = name, Speed = speed })
		return
	end
	local animationPlayer = players[rig]
	if animationPlayer then
		animationPlayer:SetSpeed(name, speed)
	end
end

function AnimationService.IsPlaying(rig: Model, name: string): boolean
	local animationPlayer = players[rig]
	return animationPlayer ~= nil and animationPlayer:IsPlaying(name)
end

-- Writes real Movement ids into the default Animate script (idle/walk/run...).
-- Placeholder ids are skipped, so Roblox's default R15 animations stay active.
function AnimationService.ApplyMovementOverrides(character: Model)
	local animate = character:FindFirstChild("Animate")
	if not animate then
		return
	end
	for _, def in AnimationConfig.Categories.Movement do
		local slot = def.AnimateSlot
		if slot and not AssetId.IsPlaceholder(def.Id) then
			local folder = animate:FindFirstChild(slot[1])
			local animation = folder and folder:FindFirstChild(slot[2])
			if animation and animation:IsA("Animation") then
				animation.AnimationId = def.Id
			end
		end
	end
end

return AnimationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">AntiExploitService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AntiExploitService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/AntiExploitService
	DEPENDENCIES: Shared.Net, Shared.Config.GameConfig, Shared.Util.R15

	Collects "strikes" for suspicious behaviour and acts on THRESHOLDS, never
	on a single odd event (spec §104). Sources:
	  * Net: remote rate-limit violations and calls to unhandled remotes
	  * Services: invalid ids / out-of-range requests (AntiExploitService.Flag)
	  * Movement sampling: impossible horizontal speed
	  * EconomyService: unusually large single currency gains (logged)

	Server teleports must call AllowTeleport(player) so they are not flagged.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local GameConfig = require(Shared.Config.GameConfig)
local R15 = require(Shared.Util.R15)

local Config = GameConfig.AntiExploit

type StrikeRecord = { Time: number, Weight: number, Reason: string }
type PlayerState = {
	Strikes: { StrikeRecord },
	Warned: boolean,
	LastPosition: Vector3?,
	LastSample: number,
	TeleportUntil: number,
}

local AntiExploitService = {}

local states: { [Player]: PlayerState } = {}

local function getState(player: Player): PlayerState
	local state = states[player]
	if not state then
		state = { Strikes = {}, Warned = false, LastPosition = nil, LastSample = os.clock(), TeleportUntil = 0 }
		states[player] = state
	end
	return state
end

local function totalStrikes(state: PlayerState): number
	local cutoff = os.clock() - Config.StrikeWindow
	local total = 0
	for i = #state.Strikes, 1, -1 do
		local strike = state.Strikes[i]
		if strike.Time < cutoff then
			table.remove(state.Strikes, i)
		else
			total += strike.Weight
		end
	end
	return total
end

-- Record suspicious behaviour. weight: 1 = mildly odd, 5 = clearly impossible.
function AntiExploitService.Flag(player: Player, reason: string, weight: number?)
	if not player.Parent then
		return
	end
	local state = getState(player)
	table.insert(state.Strikes, { Time = os.clock(), Weight = weight or 1, Reason = reason })
	local total = totalStrikes(state)

	if GameConfig.Debug then
		print(("[AntiExploit] %s flagged: %s (total %d)"):format(player.Name, reason, total))
	end
	if total >= Config.WarnStrikes and not state.Warned then
		state.Warned = true
		warn(("[AntiExploit] %s reached warning threshold (%d). Last reason: %s"):format(player.Name, total, reason))
	end
	if total >= Config.KickStrikes and Config.KickEnabled and not RunService:IsStudio() then
		warn(("[AntiExploit] Kicking %s (%d strikes). Last reason: %s"):format(player.Name, total, reason))
		player:Kick("Unusual activity was detected. Please rejoin.")
	end
end

-- Call right before/after any server-side teleport of a character.
function AntiExploitService.AllowTeleport(player: Player)
	local state = getState(player)
	state.TeleportUntil = os.clock() + Config.TeleportGrace
	state.LastPosition = nil
end

function AntiExploitService.RecordCurrencyChange(player: Player, currency: string, amount: number, reason: string)
	if amount >= Config.LargeCurrencyGain then
		warn(("[AntiExploit] Large %s gain for %s: %d (%s)"):format(currency, player.Name, amount, reason))
	end
end

local function sampleMovement()
	local now = os.clock()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = R15.GetRootPart(character)
		local humanoid = R15.GetHumanoid(character)
		local state = getState(player)
		if not root or not humanoid or humanoid.Health <= 0 then
			state.LastPosition = nil
			continue
		end
		local position = root.Position
		local last = state.LastPosition
		local elapsed = now - state.LastSample
		state.LastPosition = position
		state.LastSample = now
		if not last or now < state.TeleportUntil or elapsed <= 0 or humanoid.Sit then
			continue
		end
		local horizontal = Vector3.new(position.X - last.X, 0, position.Z - last.Z).Magnitude
		local speed = horizontal / elapsed
		local allowed = humanoid.WalkSpeed * Config.MaxSpeedMultiplier + Config.MovementSlack
		if speed > allowed then
			AntiExploitService.Flag(player, ("Speed %.0f > %.0f"):format(speed, allowed), 2)
		end
	end
end

function AntiExploitService.Init()
	Net.SetViolationHandler(function(player, reason, weight)
		AntiExploitService.Flag(player, reason, weight)
	end)
end

function AntiExploitService.Start()
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(Config.MovementCheckInterval)
			sampleMovement()
		end
	end)
end

return AntiExploitService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  DataService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/DataService
	DEPENDENCIES: Shared.Net, Shared.Config.GameConfig, Shared.Util.{Signal,TableUtil},
	              Server.Data.DataSchema, Server.Data.MockDataStore
	REQUIRED OBJECTS: Game Settings > Security > "Enable Studio Access to API Services"
	              (optional; without it Studio uses the in-memory mock)

	THE ONLY system that reads/writes the DataStore and the ONLY writer of
	profile data. Other services mutate profiles through Set / Increment /
	Update so that every change is (1) marked dirty for autosave and
	(2) replicated to the owning client in batched StateSync packets.

	Safety guarantees (spec §97, §117, §147, §148):
	  * UpdateAsync only, with retries + exponential backoff.
	  * Session locking: a profile is owned by one server at a time. A save
	    that finds another server's lock is cancelled (never overwrites).
	  * A profile that failed to load is NEVER saved (no blank-overwrite).
	  * DataSchema.IsSaveable() gate before every write.
	  * Dirty-flag autosave, save on leave, BindToClose shutdown save.
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Util.Signal)
local TableUtil = require(Shared.Util.TableUtil)

local ServerRoot = script.Parent.Parent
local DataSchema = require(ServerRoot.Data.DataSchema)
local MockDataStore = require(ServerRoot.Data.MockDataStore)

local DataConfig = GameConfig.Data
local SESSION_ID = HttpService:GenerateGUID(false)
local LOCK_REFRESH_INTERVAL = DataConfig.SessionLockTimeout / 4

type Path = { string }

type Profile = {
	Player: Player,
	Key: string,
	Data: any,
	Loaded: boolean,
	Dirty: boolean,
	Saving: boolean,
	Releasing: boolean,
	LockLost: boolean,
	ClientReady: boolean,
	PendingOps: { any },
	FlushScheduled: boolean,
	LastSave: number,
	LastSaveResult: string,
}

local DataService = {}

DataService.ProfileLoaded = Signal.new() -- (player, data)
DataService.ProfileReleasing = Signal.new() -- (player, data) last chance to write before the final save
DataService.Changed = Signal.new() -- (player, path, value)

local store: any = nil
local usingMock = false
local profiles: { [Player]: Profile } = {}
local readyBeforeProfile: { [Player]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function log(...)
	if GameConfig.Debug then
		print("[DataService]", ...)
	end
end

local function keyFor(player: Player): string
	return DataConfig.KeyPrefix .. tostring(player.UserId)
end

local function newLock()
	return { Id = SESSION_ID, JobId = game.JobId, PlaceId = game.PlaceId, Time = os.time() }
end

local function resolveStore()
	local mode = DataConfig.UseMockDataStore
	if mode == true then
		store, usingMock = MockDataStore.new(), true
		warn("[DataService] UseMockDataStore = true — data will NOT persist")
		return
	end

	local ok, result = pcall(DataStoreService.GetDataStore, DataStoreService, DataConfig.StoreName)
	if ok then
		store = result
	end

	if mode == "Auto" and RunService:IsStudio() then
		local probeOk, probeErr = false, "GetDataStore failed"
		if store then
			probeOk, probeErr = pcall(function()
				return store:GetAsync("__probe")
			end)
		end
		if not probeOk then
			warn("[DataService] DataStore unavailable in Studio (" .. tostring(probeErr) .. ").")
			warn("[DataService] Using an in-memory mock: progress lasts for this play session only.")
			warn("[DataService] Enable Game Settings > Security > Studio Access to API Services to test real saving.")
			store, usingMock = MockDataStore.new(), true
		end
	end

	if not store then
		warn("[DataService] Could not open DataStore:", result)
	end
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	if usingMock then
		return
	end
	local waited = 0
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and waited < 10 do
		task.wait(0.5)
		waited += 0.5
	end
end

local function backoff(attempt: number)
	task.wait(DataConfig.RetryBaseDelay * 2 ^ (attempt - 1))
end

---------------------------------------------------------------------------
-- Replication
---------------------------------------------------------------------------

local function publicCopy(data: any): any
	local copy = {}
	for key, value in data do
		if not DataSchema.PrivateKeys[key] then
			copy[key] = TableUtil.DeepCopy(value)
		end
	end
	return copy
end

local function sendFull(profile: Profile)
	table.clear(profile.PendingOps)
	Net.FireClient("StateSync", profile.Player, { Full = publicCopy(profile.Data) })
end

local function queueOp(profile: Profile, path: Path, value: any)
	if not profile.ClientReady or DataSchema.PrivateKeys[path[1]] then
		return
	end
	table.insert(profile.PendingOps, { Path = table.clone(path), Value = TableUtil.DeepCopy(value) })
	if profile.FlushScheduled then
		return
	end
	profile.FlushScheduled = true
	task.defer(function()
		profile.FlushScheduled = false
		if #profile.PendingOps == 0 then
			return
		end
		local ops = profile.PendingOps
		profile.PendingOps = {}
		Net.FireClient("StateSync", profile.Player, { Ops = ops })
	end)
end

---------------------------------------------------------------------------
-- DataStore IO
---------------------------------------------------------------------------

-- Loads the record and takes the session lock. Returns the record or nil.
local function loadRecord(key: string): any
	local steal = DataConfig.StudioStealLocks and RunService:IsStudio()
	local errors, lockWaits = 0, 0

	while errors < DataConfig.LoadAttempts do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local status = "Error"
		local ok, result = pcall(function()
			return store:UpdateAsync(key, function(old)
				local record = if type(old) == "table" then old else {}
				local lock = record.SessionLock
				local lockAlive = type(lock) == "table"
					and lock.Id ~= SESSION_ID
					and type(lock.Time) == "number"
					and os.time() - lock.Time < DataConfig.SessionLockTimeout
				if lockAlive and not steal then
					status = "Locked"
					return nil -- cancel: another server owns this profile
				end
				status = "OK"
				record.SessionLock = newLock()
				return record
			end)
		end)

		if ok and status == "OK" then
			return result
		elseif ok and status == "Locked" then
			lockWaits += 1
			log(("%s is locked by another server (wait %d/%d)"):format(key, lockWaits, DataConfig.LockRetries))
			if lockWaits >= DataConfig.LockRetries then
				warn("[DataService] Taking over stale session lock for " .. key)
				steal = true
			else
				task.wait(DataConfig.LockRetryDelay)
			end
		else
			errors += 1
			warn(("[DataService] Load attempt %d failed for %s: %s"):format(errors, key, tostring(result)))
			if errors < DataConfig.LoadAttempts then
				backoff(errors)
			end
		end
	end
	return nil
end

-- Releases our lock without touching Data (used when a player leaves mid-load).
local function releaseLockOnly(key: string)
	pcall(function()
		store:UpdateAsync(key, function(old)
			if type(old) ~= "table" or type(old.SessionLock) ~= "table" or old.SessionLock.Id ~= SESSION_ID then
				return nil
			end
			old.SessionLock = nil
			return old
		end)
	end)
end

local function saveProfile(profile: Profile, release: boolean): boolean
	if not profile.Loaded or profile.LockLost then
		return false
	end
	while profile.Saving do
		task.wait()
	end
	profile.Saving = true
	profile.Dirty = false -- changes made while we yield will mark it dirty again

	local snapshot = TableUtil.DeepCopy(profile.Data)
	snapshot.Meta.LastSavedAt = os.time()

	local saveable, reason = DataSchema.IsSaveable(snapshot)
	if not saveable then
		warn(("[DataService] Refusing to save %s: %s"):format(profile.Key, tostring(reason)))
		profile.Saving = false
		profile.LastSaveResult = "Refused: " .. tostring(reason)
		return false
	end

	local encodedOk, encoded = pcall(HttpService.JSONEncode, HttpService, snapshot)
	if encodedOk and #encoded > DataConfig.SizeWarningBytes then
		warn(("[DataService] %s is %d bytes — approaching the DataStore limit"):format(profile.Key, #encoded))
	end

	for attempt = 1, DataConfig.SaveAttempts do
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local lostLock = false
		local ok, err = pcall(function()
			return store:UpdateAsync(profile.Key, function(old)
				local lock = if type(old) == "table" then old.SessionLock else nil
				if type(lock) ~= "table" or lock.Id ~= SESSION_ID then
					lostLock = true
					return nil -- another session owns (or released) this profile: never overwrite
				end
				return {
					Data = snapshot,
					SessionLock = if release then nil else newLock(),
					SavedAt = os.time(),
				}
			end)
		end)

		if ok then
			profile.Saving = false
			if lostLock then
				profile.LockLost = true
				profile.LastSaveResult = "LockLost"
				warn("[DataService] Session lock lost for " .. profile.Key .. " — this server will stop saving it")
				if profile.Player.Parent then
					profile.Player:Kick("Your island was opened in another server. Please rejoin.")
				end
				return false
			end
			profile.LastSave = os.clock()
			profile.LastSaveResult = if release then "Released" else "Saved"
			log(("Saved %s%s"):format(profile.Key, if release then " (released)" else ""))
			return true
		end

		warn(("[DataService] Save attempt %d failed for %s: %s"):format(attempt, profile.Key, tostring(err)))
		if attempt < DataConfig.SaveAttempts then
			backoff(attempt)
		end
	end

	profile.Saving = false
	profile.Dirty = true
	profile.LastSaveResult = "Failed"
	return false
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function DataService.Init()
	Net.OnServerEvent("ClientReady", function(player: Player)
		local profile = profiles[player]
		if not profile then
			readyBeforeProfile[player] = true
			return
		end
		profile.ClientReady = true
		if profile.Loaded then
			sendFull(profile)
		end
	end)
end

function DataService.Start()
	resolveStore()

	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveInterval)
			for _, profile in table.clone(profiles) do
				local lockStale = os.clock() - profile.LastSave > LOCK_REFRESH_INTERVAL
				if profile.Loaded and not profile.Releasing and not profile.Saving and (profile.Dirty or lockStale) then
					task.spawn(saveProfile, profile, false)
					task.wait(0.25) -- stagger writes
				end
			end
		end
	end)

	game:BindToClose(function()
		local deadline = os.clock() + DataConfig.ShutdownSaveTimeout
		for player in table.clone(profiles) do
			task.spawn(DataService.ReleaseProfile, player)
		end
		while next(profiles) ~= nil and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Yields. Returns the loaded data table, or nil if loading failed / player left.
function DataService.LoadProfile(player: Player): any
	local existing = profiles[player]
	if existing then
		return if existing.Loaded then existing.Data else nil
	end
	if not store then
		warn("[DataService] No DataStore available; cannot load " .. player.Name)
		if DataConfig.KickOnLoadFailure then
			player:Kick("Island data is unavailable right now. Please try again in a moment.")
		end
		return nil
	end

	local profile: Profile = {
		Player = player,
		Key = keyFor(player),
		Data = nil,
		Loaded = false,
		Dirty = false,
		Saving = false,
		Releasing = false,
		LockLost = false,
		ClientReady = readyBeforeProfile[player] == true,
		PendingOps = {},
		FlushScheduled = false,
		LastSave = os.clock(),
		LastSaveResult = "NotSaved",
	}
	profiles[player] = profile

	local record = loadRecord(profile.Key)

	if player.Parent == nil then
		-- Left while loading: give the lock back without writing anything.
		if record then
			releaseLockOnly(profile.Key)
		end
		profiles[player] = nil
		return nil
	end

	if not record then
		-- NEVER continue with a blank profile: it could be saved over real progress.
		profiles[player] = nil
		warn("[DataService] Failed to load data for " .. player.Name .. " after retries")
		if DataConfig.KickOnLoadFailure then
			player:Kick("We couldn't load your island safely. Your progress is safe — please rejoin in a minute.")
		end
		return nil
	end

	local data = DataSchema.Sanitize(record.Data)
	local now = os.time()
	if data.Meta.CreatedAt == 0 then
		data.Meta.CreatedAt = now
	end
	data.Meta.LastJoinAt = now
	data.Meta.JoinCount += 1

	profile.Data = data
	profile.Loaded = true
	profile.Dirty = true
	log(("Loaded %s (mock=%s)"):format(profile.Key, tostring(usingMock)))

	DataService.ProfileLoaded:Fire(player, data)
	if profile.ClientReady then
		sendFull(profile)
	end
	return data
end

-- Yields. Final save + lock release. Safe to call more than once.
function DataService.ReleaseProfile(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	if profile.Releasing then
		while profiles[player] == profile do
			task.wait(0.1)
		end
		return
	end
	profile.Releasing = true
	if profile.Loaded then
		DataService.ProfileReleasing:Fire(player, profile.Data)
		task.wait() -- let ProfileReleasing handlers write their final values
		saveProfile(profile, true)
	end
	profiles[player] = nil
end

function DataService.IsLoaded(player: Player): boolean
	local profile = profiles[player]
	return profile ~= nil and profile.Loaded
end

-- Read-only access. DO NOT mutate the returned table — use Set/Increment/Update.
function DataService.GetData(player: Player): any
	local profile = profiles[player]
	return if profile and profile.Loaded then profile.Data else nil
end

function DataService.Get(player: Player, path: Path): any
	local node = DataService.GetData(player)
	for _, key in path do
		if type(node) ~= "table" then
			return nil
		end
		node = node[key]
	end
	return node
end

function DataService.Set(player: Player, path: Path, value: any): boolean
	local profile = profiles[player]
	if not profile or not profile.Loaded or #path == 0 then
		return false
	end
	local parent = profile.Data
	for index = 1, #path - 1 do
		local child = parent[path[index]]
		if type(child) ~= "table" then
			error(("[DataService] Invalid path %s at '%s'"):format(table.concat(path, "."), path[index]), 2)
		end
		parent = child
	end
	parent[path[#path]] = value
	profile.Dirty = true
	queueOp(profile, path, value)
	DataService.Changed:Fire(player, path, value)
	return true
end

function DataService.Increment(player: Player, path: Path, delta: number): number?
	local current = DataService.Get(player, path)
	if type(current) ~= "number" then
		current = 0
	end
	local newValue = current + delta
	if DataService.Set(player, path, newValue) then
		return newValue
	end
	return nil
end

-- transform(oldValue) -> newValue. Handy for table edits:
-- DataService.Update(player, {"Island","UnlockedAreas"}, function(t) t.Forest = true return t end)
function DataService.Update(player: Player, path: Path, transform: (any) -> any): boolean
	local current = DataService.Get(player, path)
	return DataService.Set(player, path, transform(current))
end

-- Re-sends the full profile (e.g. after an admin reset).
function DataService.Resync(player: Player)
	local profile = profiles[player]
	if profile and profile.Loaded and profile.ClientReady then
		sendFull(profile)
	end
end

-- Studio/admin only: reset a profile to the template (the save still goes through the lock).
function DataService.ResetProfile(player: Player)
	local profile = profiles[player]
	if not profile or not profile.Loaded then
		return
	end
	profile.Data = DataSchema.Sanitize(nil)
	profile.Data.Meta.CreatedAt = os.time()
	profile.Dirty = true
	DataService.Resync(player)
end

function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

function DataService.GetDebugState(player: Player): { [string]: any }
	local profile = profiles[player]
	if not profile then
		return { Loaded = false }
	end
	return {
		Loaded = profile.Loaded,
		Dirty = profile.Dirty,
		Saving = profile.Saving,
		LockLost = profile.LockLost,
		LastSaveResult = profile.LastSaveResult,
		SecondsSinceSave = math.floor(os.clock() - profile.LastSave),
		Mock = usingMock,
		Session = SESSION_ID,
	}
end

Players.PlayerRemoving:Connect(function(player)
	readyBeforeProfile[player] = nil
end)

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  EconomyService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/EconomyService
	DEPENDENCIES: DataService, AntiExploitService, Shared.Config.EconomyConfig,
	              Shared.Util.Validate

	THE ONLY system that changes Coins or Gems (spec §165). Every change
	carries a `reason` string for logs/debugging. Amounts always come from
	server config — a client can never name an amount.

	Coin gain feedback (floating "+N", counter bounce, coin sound) is driven
	on the client by watching the replicated Coins value, so every source of
	income gets consistent feedback automatically.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local EconomyConfig = require(Shared.Config.EconomyConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Validate = require(Shared.Util.Validate)

local Services = script.Parent
local DataService = require(Services.DataService)
local AntiExploitService = require(Services.AntiExploitService)

local EconomyService = {}

local function log(player: Player, currency: string, delta: number, reason: string)
	if GameConfig.Debug then
		print(("[Economy] %s %s%d %s (%s)"):format(player.Name, if delta >= 0 then "+" else "", delta, currency, reason))
	end
end

local function add(player: Player, currency: string, amount: number, reason: string): boolean
	local currencyDef = EconomyConfig.Currencies[currency]
	assert(currencyDef, "Unknown currency " .. currency)
	if not Validate.Integer(amount, 1, currencyDef.Max) then
		warn(("[Economy] Rejected invalid %s amount %s (%s)"):format(currency, tostring(amount), reason))
		return false
	end
	local current = DataService.Get(player, { currency })
	if type(current) ~= "number" then
		return false
	end
	local newValue = math.min(current + amount, currencyDef.Max)
	local gained = newValue - current
	if gained <= 0 then
		return false
	end
	DataService.Set(player, { currency }, newValue)
	if currency == "Coins" then
		DataService.Increment(player, { "Stats", "CoinsEarned" }, gained)
	end
	AntiExploitService.RecordCurrencyChange(player, currency, gained, reason)
	log(player, currency, gained, reason)
	return true
end

local function spend(player: Player, currency: string, amount: number, reason: string): boolean
	local currencyDef = EconomyConfig.Currencies[currency]
	assert(currencyDef, "Unknown currency " .. currency)
	if not Validate.Integer(amount, 0, currencyDef.Max) then
		warn(("[Economy] Rejected invalid spend %s (%s)"):format(tostring(amount), reason))
		return false
	end
	if amount == 0 then
		return true
	end
	local current = DataService.Get(player, { currency })
	if type(current) ~= "number" or current < amount then
		return false
	end
	DataService.Set(player, { currency }, current - amount)
	log(player, currency, -amount, reason)
	return true
end

function EconomyService.GetCoins(player: Player): number
	return DataService.Get(player, { "Coins" }) or 0
end

function EconomyService.GetGems(player: Player): number
	return DataService.Get(player, { "Gems" }) or 0
end

function EconomyService.CanAfford(player: Player, coins: number): boolean
	return EconomyService.GetCoins(player) >= coins
end

function EconomyService.AddCoins(player: Player, amount: number, reason: string): boolean
	return add(player, "Coins", amount, reason)
end

-- Returns false (and changes nothing) if the player can't afford it.
function EconomyService.SpendCoins(player: Player, amount: number, reason: string): boolean
	return spend(player, "Coins", amount, reason)
end

function EconomyService.AddGems(player: Player, amount: number, reason: string): boolean
	return add(player, "Gems", amount, reason)
end

function EconomyService.SpendGems(player: Player, amount: number, reason: string): boolean
	return spend(player, "Gems", amount, reason)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InteractionService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/InteractionService
	DEPENDENCIES: AntiExploitService, Shared.Util.{R15, RateLimiter}, Server.Util.Notify

	ONE reusable interaction system for trees, rocks, crops, animals, shops,
	chests, signs... (spec §49/§50). Built on ProximityPrompt, which gives:
	  * "[E] Chop Tree" on keyboard, a tap button on mobile, gamepad support,
	  * a server-side Triggered event (the client cannot fake distance).

	Each interactable has a KIND registered once by the owning service:

		InteractionService.RegisterKind("StarterChest", {
			ActionText = "Open",
			ObjectText = "Starter Chest",
			Permission = "Owner",      -- "Owner" | "Visitor" | any island permission key
			HoldDuration = 0,
			MaxDistance = 10,
			Cooldown = 0.5,
			Handler = function(player, object, prompt) ... end,
		})
		InteractionService.Attach(chestModel, "StarterChest", { OwnerUserId = 123 })

	Server checks on every trigger: rate limit, object still registered, player
	alive, distance, per-player cooldown, island permission (via the resolver
	IslandService installs), then the handler runs inside pcall.

	Prompts with Permission "Owner" are tagged "OwnerOnlyPrompt" so the client
	hides them from visitors (cosmetic only — the server still validates).
]]

local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local R15 = require(Shared.Util.R15)
local RateLimiter = require(Shared.Util.RateLimiter)

local Services = script.Parent
local AntiExploitService = require(Services.AntiExploitService)
local Notify = require(script.Parent.Parent.Util.Notify)

export type KindDef = {
	ActionText: string,
	ObjectText: string?,
	Permission: string?,
	HoldDuration: number?,
	MaxDistance: number?,
	Cooldown: number?,
	Handler: (player: Player, object: Instance, prompt: ProximityPrompt) -> (),
}

type Entry = {
	Object: Instance,
	Kind: string,
	Prompt: ProximityPrompt,
	Permission: string,
	OwnerUserId: number?,
	Cooldown: number,
	LastUse: { [Player]: number },
}

local DISTANCE_TOLERANCE = 6
local OWNER_ONLY_TAG = "OwnerOnlyPrompt"

local InteractionService = {}

local kinds: { [string]: KindDef } = {}
local entriesByPrompt: { [ProximityPrompt]: Entry } = {}
local entriesByObject: { [Instance]: Entry } = {}
local limiter = RateLimiter.new(6, 10)

-- (player, object, permission, ownerUserId) -> boolean. Installed by IslandService.
local accessResolver: ((Player, Instance, string, number?) -> boolean)? = nil

function InteractionService.SetAccessResolver(resolver: (Player, Instance, string, number?) -> boolean)
	accessResolver = resolver
end

function InteractionService.RegisterKind(kind: string, def: KindDef)
	assert(kinds[kind] == nil, "Interaction kind already registered: " .. kind)
	assert(type(def.Handler) == "function", "Interaction kind needs a Handler: " .. kind)
	kinds[kind] = def
end

local function getPromptParent(object: Instance): Instance?
	if object:IsA("BasePart") or object:IsA("Attachment") then
		return object
	end
	if object:IsA("Model") then
		local anchor = object:FindFirstChild("PromptAnchor", true)
		if anchor and (anchor:IsA("Attachment") or anchor:IsA("BasePart")) then
			return anchor
		end
		return object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function getWorldPosition(instance: Instance): Vector3?
	if instance:IsA("Attachment") then
		return instance.WorldPosition
	elseif instance:IsA("BasePart") then
		return instance.Position
	end
	return nil
end

function InteractionService.Attach(object: Instance, kind: string, overrides: { [string]: any }?): ProximityPrompt?
	local def = kinds[kind]
	assert(def, "Unknown interaction kind: " .. kind)
	InteractionService.Detach(object)

	local parent = getPromptParent(object)
	if not parent then
		warn("[Interaction] No part to attach prompt to on " .. object:GetFullName())
		return nil
	end
	local options = overrides or {}

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "InteractPrompt"
	prompt.ActionText = options.ActionText or def.ActionText
	prompt.ObjectText = options.ObjectText or def.ObjectText or ""
	prompt.HoldDuration = options.HoldDuration or def.HoldDuration or 0
	prompt.MaxActivationDistance = options.MaxDistance or def.MaxDistance or 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt:SetAttribute("InteractKind", kind)

	local permission = options.Permission or def.Permission or "Owner"
	local ownerUserId = options.OwnerUserId
	if ownerUserId then
		prompt:SetAttribute("OwnerUserId", ownerUserId)
	end
	if permission == "Owner" then
		CollectionService:AddTag(prompt, OWNER_ONLY_TAG)
	end
	prompt.Parent = parent

	local entry: Entry = {
		Object = object,
		Kind = kind,
		Prompt = prompt,
		Permission = permission,
		OwnerUserId = ownerUserId,
		Cooldown = options.Cooldown or def.Cooldown or 0.4,
		LastUse = setmetatable({}, { __mode = "k" }) :: any,
	}
	entriesByPrompt[prompt] = entry
	entriesByObject[object] = entry

	object.Destroying:Once(function()
		InteractionService.Detach(object)
	end)
	return prompt
end

function InteractionService.Detach(object: Instance)
	local entry = entriesByObject[object]
	if not entry then
		return
	end
	entriesByObject[object] = nil
	entriesByPrompt[entry.Prompt] = nil
	entry.Prompt:Destroy()
end

-- Dynamic prompt text, e.g. "Harvest Wheat" -> "Water Wheat".
function InteractionService.SetText(object: Instance, actionText: string?, objectText: string?)
	local entry = entriesByObject[object]
	if not entry then
		return
	end
	if actionText then
		entry.Prompt.ActionText = actionText
	end
	if objectText then
		entry.Prompt.ObjectText = objectText
	end
end

function InteractionService.SetEnabled(object: Instance, enabled: boolean)
	local entry = entriesByObject[object]
	if entry then
		entry.Prompt.Enabled = enabled
	end
end

local function onTriggered(prompt: ProximityPrompt, player: Player)
	local entry = entriesByPrompt[prompt]
	if not entry then
		return
	end
	if not limiter:Check(player) then
		AntiExploitService.Flag(player, "InteractSpam", 1)
		return
	end
	if not prompt.Enabled then
		return
	end

	local character = player.Character
	local root = R15.GetRootPart(character)
	if not root or not R15.IsAlive(character) then
		return
	end
	local promptParent = prompt.Parent
	local position = promptParent and getWorldPosition(promptParent)
	if not position or (root.Position - position).Magnitude > prompt.MaxActivationDistance + DISTANCE_TOLERANCE then
		AntiExploitService.Flag(player, "InteractTooFar:" .. entry.Kind, 2)
		return
	end

	local now = os.clock()
	local last = entry.LastUse[player]
	if last and now - last < entry.Cooldown then
		return
	end
	entry.LastUse[player] = now

	if accessResolver and not accessResolver(player, entry.Object, entry.Permission, entry.OwnerUserId) then
		Notify.Error(player, "You can't do that on someone else's island.")
		return
	end

	local def = kinds[entry.Kind]
	local ok, err = pcall(def.Handler, player, entry.Object, prompt)
	if not ok then
		warn(("[Interaction] %s handler failed for %s: %s"):format(entry.Kind, player.Name, tostring(err)))
	end
end

function InteractionService.Start()
	ProximityPromptService.PromptTriggered:Connect(onTriggered)
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InventoryService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/InventoryService
	DEPENDENCIES: DataService, Shared.Config.{ItemConfig, GameConfig}, Shared.Util.Validate,
	              Server.Util.Notify

	Authoritative backpack. Only accepts item ids registered in ItemConfig,
	enforces capacity and stack limits, and offers atomic multi-item removal
	(HasItems / RemoveItems) for building costs and recipes, so a failed
	purchase can never leave the inventory half-charged.

	Item gain feedback ("+3 Wood") is shown by the client when it sees the
	replicated count go up.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local ItemConfig = require(Shared.Config.ItemConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Validate = require(Shared.Util.Validate)

local Services = script.Parent
local DataService = require(Services.DataService)
local Notify = require(script.Parent.Parent.Util.Notify)

local InventoryService = {}

-- Stats keys bumped when specific items are gained.
local ITEM_STATS: { [string]: string } = {
	Wood = "WoodCollected",
	Stone = "StoneCollected",
}

local function getItems(player: Player): { [string]: number }?
	return DataService.Get(player, { "Inventory", "Items" })
end

function InventoryService.GetCount(player: Player, itemId: string): number
	local items = getItems(player)
	return items and items[itemId] or 0
end

function InventoryService.GetUsed(player: Player): number
	local items = getItems(player)
	local used = 0
	if items then
		for _, count in items do
			used += count
		end
	end
	return used
end

function InventoryService.GetCapacity(player: Player): number
	return DataService.Get(player, { "Inventory", "Capacity" }) or GameConfig.Inventory.StartingCapacity
end

function InventoryService.GetFreeSpace(player: Player): number
	return math.max(0, InventoryService.GetCapacity(player) - InventoryService.GetUsed(player))
end

-- Adds up to `amount`. Returns how many were actually added (0 if full / invalid).
function InventoryService.AddItem(player: Player, itemId: string, amount: number, reason: string, options: { IgnoreCapacity: boolean? }?): number
	if not ItemConfig.Exists(itemId) then
		warn(("[Inventory] Unknown item '%s' (%s)"):format(tostring(itemId), reason))
		return 0
	end
	if not Validate.Integer(amount, 1, GameConfig.Inventory.MaxStack) then
		warn(("[Inventory] Invalid amount %s for %s (%s)"):format(tostring(amount), itemId, reason))
		return 0
	end
	if not DataService.IsLoaded(player) then
		return 0
	end

	local current = InventoryService.GetCount(player, itemId)
	local room = GameConfig.Inventory.MaxStack - current
	if not (options and options.IgnoreCapacity) then
		room = math.min(room, InventoryService.GetFreeSpace(player))
	end
	local added = math.clamp(amount, 0, room)
	if added <= 0 then
		Notify.Error(player, "Your backpack is full!")
		return 0
	end

	DataService.Set(player, { "Inventory", "Items", itemId }, current + added)
	local statKey = ITEM_STATS[itemId]
	if statKey then
		DataService.Increment(player, { "Stats", statKey }, added)
	end
	if added < amount then
		Notify.Error(player, "Backpack full — some items didn't fit.")
	end
	if GameConfig.Debug then
		print(("[Inventory] %s +%d %s (%s)"):format(player.Name, added, itemId, reason))
	end
	return added
end

function InventoryService.RemoveItem(player: Player, itemId: string, amount: number, reason: string): boolean
	if not ItemConfig.Exists(itemId) or not Validate.Integer(amount, 1, GameConfig.Inventory.MaxStack) then
		return false
	end
	local current = InventoryService.GetCount(player, itemId)
	if current < amount then
		return false
	end
	local remaining = current - amount
	DataService.Set(player, { "Inventory", "Items", itemId }, if remaining > 0 then remaining else nil)
	if GameConfig.Debug then
		print(("[Inventory] %s -%d %s (%s)"):format(player.Name, amount, itemId, reason))
	end
	return true
end

-- cost = { Wood = 10, Stone = 5 }
function InventoryService.HasItems(player: Player, cost: { [string]: number }): boolean
	for itemId, amount in cost do
		if InventoryService.GetCount(player, itemId) < amount then
			return false
		end
	end
	return true
end

-- All-or-nothing removal.
function InventoryService.RemoveItems(player: Player, cost: { [string]: number }, reason: string): boolean
	if not InventoryService.HasItems(player, cost) then
		return false
	end
	for itemId, amount in cost do
		InventoryService.RemoveItem(player, itemId, amount, reason)
	end
	return true
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">IslandService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/IslandService
	DEPENDENCIES: DataService, EconomyService, InventoryService, ProgressionService,
	              InteractionService, ToolService, SoundService, VFXService, WorldService,
	              AntiExploitService, Server.Island.IslandBuilder, Server.Island.IslandProps,
	              Shared.Config.{IslandConfig, GameConfig, ProgressionConfig}, Shared.Util.{IslandLayout, Validate}

	Owns everything about islands (spec §4-§6, §111):
	  * one island per player, placed in a free server SLOT,
	  * ownership (OwnerUserId + IslandId attributes on the model, and the
	    server-side maps below — never inferred from position alone),
	  * building / cleaning up island terrain and props,
	  * boundaries (IsPointBuildable) for later build/farm validation,
	  * access checks (CanAccess) used by every interaction,
	  * expansion unlocks (TryUnlockArea),
	  * the island's built-in interactables (starter chest, sign, 🔒 markers).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local GameConfig = require(Shared.Config.GameConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local IslandLayout = require(Shared.Util.IslandLayout)
local Validate = require(Shared.Util.Validate)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local EconomyService = require(Services.EconomyService)
local InventoryService = require(Services.InventoryService)
local ProgressionService = require(Services.ProgressionService)
local InteractionService = require(Services.InteractionService)
local ToolService = require(Services.ToolService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local WorldService = require(Services.WorldService)
local AntiExploitService = require(Services.AntiExploitService)

local ServerRoot = script.Parent.Parent
local IslandBuilder = require(ServerRoot.Island.IslandBuilder)
local IslandProps = require(ServerRoot.Island.IslandProps)
local Notify = require(ServerRoot.Util.Notify)

export type Island = {
	Id: string,
	Owner: Player,
	OwnerUserId: number,
	SlotIndex: number,
	Origin: CFrame,
	Model: Model,
	Folders: { [string]: Folder },
	Sign: Model,
	Chest: Model,
	SpawnCFrame: CFrame,
	AreaMarkers: { [string]: Model },
}

local IslandService = {}

IslandService.IslandAssigned = Signal.new() -- (player, island)
IslandService.IslandReleased = Signal.new() -- (player, islandId)
IslandService.AreaUnlocked = Signal.new() -- (player, areaId)

local slots: { [number]: boolean } = {}
local islandsByPlayer: { [Player]: Island } = {}
local islandsById: { [string]: Island } = {}

---------------------------------------------------------------------------
-- Queries
---------------------------------------------------------------------------

function IslandService.GetIsland(player: Player): Island?
	return islandsByPlayer[player]
end

function IslandService.GetIslandById(islandId: string): Island?
	return islandsById[islandId]
end

-- Finds the island an instance belongs to by walking up to the island model.
function IslandService.GetIslandFromInstance(instance: Instance): Island?
	local current: Instance? = instance
	while current and current ~= workspace do
		local islandId = current:GetAttribute("IslandId")
		if type(islandId) == "string" then
			return islandsById[islandId]
		end
		current = current.Parent
	end
	return nil
end

function IslandService.GetIslandAtPosition(worldPosition: Vector3): Island?
	local extent = IslandLayout.GetMaxExtent()
	for _, island in islandsById do
		local offset = worldPosition - island.Origin.Position
		if Vector2.new(offset.X, offset.Z).Magnitude <= extent then
			return island
		end
	end
	return nil
end

function IslandService.ToLocal(island: Island, worldPosition: Vector3): Vector3
	return island.Origin:PointToObjectSpace(worldPosition)
end

function IslandService.ToWorld(island: Island, localPosition: Vector3): Vector3
	return island.Origin:PointToWorldSpace(localPosition)
end

function IslandService.GetUnlockedAreas(player: Player): { [string]: boolean }
	return DataService.Get(player, { "Island", "UnlockedAreas" }) or { Starter = true }
end

function IslandService.IsAreaUnlocked(player: Player, areaId: string): boolean
	return IslandService.GetUnlockedAreas(player)[areaId] == true
end

-- True if a world position is on land the island owner has unlocked.
function IslandService.IsPointBuildable(island: Island, worldPosition: Vector3): boolean
	local localPosition = IslandService.ToLocal(island, worldPosition)
	local unlocked = IslandService.GetUnlockedAreas(island.Owner)
	return IslandLayout.IsOnUnlockedLand(unlocked, Vector2.new(localPosition.X, localPosition.Z), IslandConfig.BuildMargin)
end

-- permission: "Owner" | "Visitor" | a future per-island permission key ("Build", "Fish", ...).
function IslandService.CanAccess(player: Player, island: Island, permission: string): boolean
	if island.OwnerUserId == player.UserId then
		return true
	end
	if permission == "Visitor" then
		return true
	end
	-- Phase 12 (VisitorService) adds Friends/Public + per-permission grants here.
	return false
end

function IslandService.GetSpawnCFrame(player: Player): CFrame?
	local island = islandsByPlayer[player]
	return island and island.SpawnCFrame
end

---------------------------------------------------------------------------
-- Visual refresh
---------------------------------------------------------------------------

local function refreshSign(island: Island)
	local data = DataService.GetData(island.Owner)
	if not data then
		return
	end
	local level = data.Island.Level
	IslandProps.SetSignText(island.Sign, data.Island.Name, ("Lv %d · %s"):format(level, ProgressionConfig.GetIslandTitle(level)))
	island.Model:SetAttribute("IslandName", data.Island.Name)
	island.Model:SetAttribute("IslandLevel", level)
end

local function requirementText(areaId: string): string
	local unlock = IslandConfig.Areas[areaId].Unlock
	if not unlock then
		return ""
	end
	local text = ("%s 🪙 · Island Lv %d"):format(Format.Abbreviate(unlock.Coins or 0), unlock.IslandLevel or 1)
	if unlock.RequiresArea then
		text ..= " · after " .. IslandConfig.Areas[unlock.RequiresArea].DisplayName
	end
	return text
end

local function refreshChest(island: Island)
	local claimed = DataService.Get(island.Owner, { "Flags", "StarterChestClaimed" }) == true
	if claimed then
		IslandProps.OpenChest(island.Chest)
		InteractionService.SetEnabled(island.Chest, false)
	end
end

local function createAreaMarker(island: Island, areaId: string)
	local area = IslandConfig.Areas[areaId]
	local marker = IslandBuilder.CreateAreaMarker(island.Origin, island.Folders.AreaMarkers, areaId, requirementText(areaId))
	island.AreaMarkers[areaId] = marker
	InteractionService.Attach(marker, "AreaUnlock", {
		ObjectText = area.DisplayName,
		ActionText = ("Unlock (%s 🪙)"):format(Format.Abbreviate(area.Unlock and area.Unlock.Coins or 0)),
		OwnerUserId = island.OwnerUserId,
	})
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

-- Yields while terrain builds. Requires the profile to be loaded.
function IslandService.AssignIsland(player: Player): Island?
	local existing = islandsByPlayer[player]
	if existing then
		return existing
	end
	local data = DataService.GetData(player)
	if not data then
		warn("[IslandService] Cannot assign an island before data loads for " .. player.Name)
		return nil
	end

	local slotIndex = nil
	for index = 1, GameConfig.MaxIslandsPerServer do
		if not slots[index] then
			slotIndex = index
			break
		end
	end
	if not slotIndex then
		warn("[IslandService] No free island slots (raise GameConfig.MaxIslandsPerServer)")
		return nil
	end
	slots[slotIndex] = true

	if data.Island.IslandId == "" then
		DataService.Set(player, { "Island", "IslandId" }, HttpService:GenerateGUID(false))
	end
	if data.Island.Name == "" then
		DataService.Set(player, { "Island", "Name" }, IslandConfig.DefaultNameFormat:format(player.DisplayName))
	end
	local islandId = data.Island.IslandId

	local origin = IslandLayout.GetSlotOrigin(slotIndex)
	local model, folders = IslandBuilder.CreateModel("Island_" .. player.UserId, WorldService.GetFolder("Islands"))
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("IslandId", islandId)
	model:SetAttribute("SlotIndex", slotIndex)
	model.WorldPivot = origin

	local built = IslandBuilder.Build(origin, model, folders, data.Island.UnlockedAreas)

	local island: Island = {
		Id = islandId,
		Owner = player,
		OwnerUserId = player.UserId,
		SlotIndex = slotIndex,
		Origin = origin,
		Model = model,
		Folders = folders,
		Sign = built.Sign,
		Chest = built.Chest,
		SpawnCFrame = built.SpawnCFrame,
		AreaMarkers = {},
	}
	islandsByPlayer[player] = island
	islandsById[islandId] = island

	InteractionService.Attach(island.Chest, "StarterChest", { OwnerUserId = player.UserId })
	InteractionService.Attach(island.Sign, "IslandSign", { OwnerUserId = player.UserId })
	for _, areaId in IslandConfig.AreaOrder do
		if not data.Island.UnlockedAreas[areaId] and IslandConfig.Areas[areaId].Unlock then
			createAreaMarker(island, areaId)
		end
	end
	refreshSign(island)
	refreshChest(island)

	if player.Parent == nil then
		-- Left while we were building.
		IslandService.ReleaseIsland(player)
		return nil
	end

	IslandService.IslandAssigned:Fire(player, island)
	if GameConfig.Debug then
		print(("[IslandService] %s -> slot %d (%s)"):format(player.Name, slotIndex, islandId))
	end
	return island
end

-- Destroys the island and restores open ocean. Call AFTER the final save.
function IslandService.ReleaseIsland(player: Player)
	local island = islandsByPlayer[player]
	if not island then
		return
	end
	islandsByPlayer[player] = nil
	islandsById[island.Id] = nil
	InteractionService.Detach(island.Chest)
	InteractionService.Detach(island.Sign)
	for _, marker in island.AreaMarkers do
		InteractionService.Detach(marker)
	end
	island.Model:Destroy()
	IslandBuilder.ClearTerrain(island.Origin, WorldService.RestoreOcean)
	slots[island.SlotIndex] = nil
	IslandService.IslandReleased:Fire(player, island.Id)
end

---------------------------------------------------------------------------
-- Expansion
---------------------------------------------------------------------------

local function liftCharactersOutOfArea(island: Island, areaId: string)
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if character and root and root:IsA("BasePart") then
			local localPosition = IslandService.ToLocal(island, root.Position)
			if IslandLayout.IsInArea(areaId, Vector2.new(localPosition.X, localPosition.Z), -2) and localPosition.Y < IslandConfig.SurfaceHeight + 2 then
				local ground = IslandBuilder.GroundCFrame(island.Origin, Vector2.new(localPosition.X, localPosition.Z))
				AntiExploitService.AllowTeleport(other)
				character:PivotTo(CFrame.new(ground.Position + Vector3.new(0, 4, 0)) * root.CFrame.Rotation)
			end
		end
	end
end

-- Returns (success, message).
function IslandService.TryUnlockArea(player: Player, areaId: any): (boolean, string?)
	if not Validate.Id(areaId) or not IslandConfig.Areas[areaId] then
		AntiExploitService.Flag(player, "InvalidAreaId", 2)
		return false, "That area doesn't exist."
	end
	local island = islandsByPlayer[player]
	if not island then
		return false, "Your island isn't ready yet."
	end
	local area = IslandConfig.Areas[areaId]
	local unlock = area.Unlock
	if not unlock or IslandService.IsAreaUnlocked(player, areaId) then
		return false, area.DisplayName .. " is already unlocked."
	end
	local islandLevel = DataService.Get(player, { "Island", "Level" }) or 1
	if islandLevel < (unlock.IslandLevel or 1) then
		return false, ("Reach Island Level %d to unlock %s."):format(unlock.IslandLevel, area.DisplayName)
	end
	if unlock.RequiresArea and not IslandService.IsAreaUnlocked(player, unlock.RequiresArea) then
		return false, ("Unlock %s first."):format(IslandConfig.Areas[unlock.RequiresArea].DisplayName)
	end
	if unlock.Items and not InventoryService.HasItems(player, unlock.Items) then
		return false, "You don't have the required materials."
	end
	local cost = unlock.Coins or 0
	if not EconomyService.SpendCoins(player, cost, "UnlockArea:" .. areaId) then
		return false, ("You need %s coins to unlock %s."):format(Format.Commas(cost), area.DisplayName)
	end
	if unlock.Items then
		InventoryService.RemoveItems(player, unlock.Items, "UnlockArea:" .. areaId)
	end

	DataService.Set(player, { "Island", "UnlockedAreas", areaId }, true)
	DataService.Increment(player, { "Stats", "AreasUnlocked" }, 1)

	local marker = island.AreaMarkers[areaId]
	if marker then
		island.AreaMarkers[areaId] = nil
		InteractionService.Detach(marker)
		marker:Destroy()
	end

	-- Satisfying reveal: the land rises out of the sea over ~1 second.
	local centerXZ = IslandLayout.GetAreaCenter(areaId)
	local centerWorld = IslandService.ToWorld(island, Vector3.new(centerXZ.X, IslandConfig.SurfaceHeight, centerXZ.Y))
	GameSoundService.PlayFor(player, "AreaUnlock")
	VFXService.PlayAt("AreaUnlock", centerWorld)
	VFXService.ShakeCamera(player, 0.5, 0.8)
	task.spawn(function()
		local steps = 12
		for step = 1, steps do
			IslandBuilder.FillAreaLand(island.Origin, areaId, step / steps)
			task.wait(0.07)
		end
		liftCharactersOutOfArea(island, areaId)
	end)

	Notify.Banner(player, "AREA UNLOCKED!", area.DisplayName .. " — " .. area.Reward, "AreaUnlock")
	ProgressionService.Award(player, "UnlockArea")
	IslandService.AreaUnlocked:Fire(player, areaId)
	return true, nil
end

---------------------------------------------------------------------------
-- Built-in interactables
---------------------------------------------------------------------------

local function claimStarterChest(player: Player, chest: Instance)
	if DataService.Get(player, { "Flags", "StarterChestClaimed" }) then
		Notify.Toast(player, "You already opened your starter chest.")
		return
	end
	local kit = GameConfig.StarterKit
	DataService.Set(player, { "Flags", "StarterChestClaimed" }, true)
	EconomyService.AddCoins(player, kit.Coins, "StarterChest")
	for itemId, amount in kit.Items do
		InventoryService.AddItem(player, itemId, amount, "StarterChest", { IgnoreCapacity = true })
	end
	for _, toolId in kit.Tools do
		ToolService.GrantTool(player, toolId, "StarterChest")
	end

	local island = islandsByPlayer[player]
	if island then
		refreshChest(island)
	end
	if chest:IsA("Model") then
		local pivot = chest:GetPivot().Position
		VFXService.PlayAt("ChestOpen", pivot + Vector3.new(0, 2.5, 0))
	end
	GameSoundService.PlayFor(player, "ChestOpen")
	Notify.Banner(player, "STARTER KIT!", "Axe, Pickaxe, Hammer, coins and materials", "Reward")
	ProgressionService.Award(player, "StarterChest")
end

local function readSign(player: Player, sign: Instance)
	local island = IslandService.GetIslandFromInstance(sign)
	if not island then
		return
	end
	local data = DataService.GetData(island.Owner)
	if not data then
		return
	end
	local unlockedCount = 0
	for _ in data.Island.UnlockedAreas do
		unlockedCount += 1
	end
	Notify.Toast(
		player,
		("%s · Level %d %s · %d/%d areas"):format(
			data.Island.Name,
			data.Island.Level,
			ProgressionConfig.GetIslandTitle(data.Island.Level),
			unlockedCount,
			#IslandConfig.AreaOrder
		),
		"🏝️"
	)
end

function IslandService.Init()
	InteractionService.RegisterKind("StarterChest", {
		ActionText = "Open",
		ObjectText = "Starter Chest",
		Permission = "Owner",
		HoldDuration = 0.4,
		MaxDistance = 10,
		Handler = claimStarterChest,
	})
	InteractionService.RegisterKind("IslandSign", {
		ActionText = "Read",
		ObjectText = "Island Sign",
		Permission = "Visitor",
		MaxDistance = 12,
		Cooldown = 1.5,
		Handler = readSign,
	})
	InteractionService.RegisterKind("AreaUnlock", {
		ActionText = "Unlock",
		ObjectText = "Locked Area",
		Permission = "Owner",
		HoldDuration = 0.8,
		MaxDistance = 12,
		Cooldown = 1,
		Handler = function(player: Player, marker: Instance)
			local ok, message = IslandService.TryUnlockArea(player, marker:GetAttribute("AreaId"))
			if not ok and message then
				Notify.Error(player, message)
			end
		end,
	})

	InteractionService.SetAccessResolver(function(player, object, permission, ownerUserId)
		local island = IslandService.GetIslandFromInstance(object)
		if island then
			return IslandService.CanAccess(player, island, permission)
		end
		return permission == "Visitor" or ownerUserId == nil or ownerUserId == player.UserId
	end)

	Net.OnServerEvent("UnlockAreaRequest", function(player: Player, areaId: any)
		local ok, message = IslandService.TryUnlockArea(player, areaId)
		if not ok and message then
			Notify.Error(player, message)
		end
	end)
end

function IslandService.Start()
	DataService.Changed:Connect(function(player: Player, path: { string })
		if path[1] ~= "Island" or (path[2] ~= "Name" and path[2] ~= "Level") then
			return
		end
		local island = islandsByPlayer[player]
		if island then
			refreshSign(island)
		end
	end)
end

return IslandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  PlayerService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/PlayerService
	DEPENDENCIES: DataService, IslandService, ToolService, AnimationService, AntiExploitService,
	              Shared.Config.GameConfig, Shared.Util.R15
	REQUIRED OBJECTS: Players.CharacterAutoLoads = false (set in default.project.json and here)

	Orchestrates the player lifecycle in a fixed, safe order:

	JOIN:   load profile -> assign island -> leaderstats -> spawn R15 character on the island
	SPAWN:  enforce R15 -> move to island spawn -> movement anim overrides -> re-equip tool
	DEATH:  respawn on own island after RespawnDelay
	LEAVE:  unequip -> final save + lock release -> island cleanup (AFTER the save)

	R15 (spec §3): Game Settings > Avatar should be set to R15. If a non-R15
	character still appears and GameConfig.Character.ForceR15 is on, it is
	rebuilt as R15 from the player's HumanoidDescription.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local R15 = require(Shared.Util.R15)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local IslandService = require(Services.IslandService)
local ToolService = require(Services.ToolService)
local AnimationService = require(Services.AnimationService)
local AntiExploitService = require(Services.AntiExploitService)

local CharacterConfig = GameConfig.Character

local PlayerService = {}

PlayerService.CharacterSpawned = Signal.new() -- (player, character) after placement on the island

local respawning: { [Player]: boolean } = {}
local convertingToR15: { [Player]: boolean } = {}

local function setupLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = DataService.Get(player, { "Coins" }) or 0
	coins.Parent = leaderstats
	local islandLevel = Instance.new("IntValue")
	islandLevel.Name = "Island Lv"
	islandLevel.Value = DataService.Get(player, { "Island", "Level" }) or 1
	islandLevel.Parent = leaderstats
	leaderstats.Parent = player
end

local function updateLeaderstats(player: Player, path: { string }, value: any)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats or type(value) ~= "number" then
		return
	end
	local statName = nil
	if path[1] == "Coins" and #path == 1 then
		statName = "Coins"
	elseif path[1] == "Island" and path[2] == "Level" then
		statName = "Island Lv"
	end
	local stat = statName and leaderstats:FindFirstChild(statName)
	if stat and stat:IsA("IntValue") then
		stat.Value = math.min(value, 2 ^ 31 - 1)
	end
end

-- Rebuilds a non-R15 character as R15 from the player's avatar description.
local function convertToR15(player: Player, oldCharacter: Model): boolean
	if convertingToR15[player] then
		return false
	end
	convertingToR15[player] = true

	local description: HumanoidDescription? = nil
	if player.UserId > 0 then
		local ok, result = pcall(Players.GetHumanoidDescriptionFromUserId, Players, player.UserId)
		if ok then
			description = result
		end
	end
	local ok, model = pcall(Players.CreateHumanoidModelFromDescription, Players, description or Instance.new("HumanoidDescription"), Enum.HumanoidRigType.R15)
	if not ok or not model then
		warn("[PlayerService] Could not build an R15 character for " .. player.Name .. ": " .. tostring(model))
		convertingToR15[player] = false
		return false
	end

	model.Name = player.Name
	if not model:FindFirstChild("Animate") then
		local template = StarterPlayer:FindFirstChild("StarterCharacterScripts")
		local animate = template and template:FindFirstChild("Animate")
		if animate then
			animate:Clone().Parent = model
		else
			warn("[PlayerService] R15 character has no Animate script. Set Game Settings > Avatar to R15.")
		end
	end
	model:PivotTo(oldCharacter:GetPivot())
	player.Character = model
	model.Parent = workspace
	oldCharacter:Destroy()
	convertingToR15[player] = false
	return true
end

-- Prefer the modern LoadCharacterAsync; if it's missing or errors, use LoadCharacter.
local function loadCharacter(player: Player): (boolean, any)
	local ok, err = pcall(function()
		(player :: any):LoadCharacterAsync()
	end)
	if ok then
		return true, nil
	end
	local fallbackOk, fallbackErr = pcall(function()
		(player :: any):LoadCharacter()
	end)
	if fallbackOk then
		return true, nil
	end
	return false, tostring(err) .. " | " .. tostring(fallbackErr)
end

local function spawnCharacter(player: Player)
	if player.Parent == nil or respawning[player] then
		return
	end
	respawning[player] = true
	local spawnCFrame = IslandService.GetSpawnCFrame(player)
	if spawnCFrame then
		pcall(player.RequestStreamAroundAsync, player, spawnCFrame.Position, 5)
	end
	local ok, err = loadCharacter(player)
	respawning[player] = false
	if not ok then
		warn("[PlayerService] LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root or not humanoid:IsA("Humanoid") then
		warn("[PlayerService] Character for " .. player.Name .. " is missing Humanoid/HumanoidRootPart")
		return
	end

	if CharacterConfig.RequireR15 and not R15.IsR15(character) then
		warn(("[PlayerService] %s spawned with a non-R15 rig. Set Game Settings > Avatar > Avatar Type to R15."):format(player.Name))
		if CharacterConfig.ForceR15 and convertToR15(player, character) then
			return -- CharacterAdded fires again for the new R15 model
		end
	end

	humanoid.WalkSpeed = CharacterConfig.WalkSpeed
	humanoid.UseJumpPower = false
	humanoid.JumpHeight = CharacterConfig.JumpHeight

	local spawnCFrame = IslandService.GetSpawnCFrame(player)
	if spawnCFrame then
		AntiExploitService.AllowTeleport(player)
		character:PivotTo(spawnCFrame)
	end

	AnimationService.ApplyMovementOverrides(character)
	ToolService.OnCharacterSpawned(player, character)
	PlayerService.CharacterSpawned:Fire(player, character)

	humanoid.Died:Once(function()
		task.delay(CharacterConfig.RespawnDelay, function()
			if player.Parent and player.Character == character then
				spawnCharacter(player)
			end
		end)
	end)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	local data = DataService.LoadProfile(player)
	if not data or player.Parent == nil then
		return
	end

	local built, islandOrError = pcall(IslandService.AssignIsland, player)
	if not built then
		warn("[PlayerService] Island build failed for " .. player.Name .. ": " .. tostring(islandOrError))
		if player.Parent then
			player:Kick("Your island failed to build. Error: " .. tostring(islandOrError))
		end
		return
	end
	local island = islandOrError
	if not island then
		if player.Parent then
			player:Kick("This server has no free islands right now. Please join another server.")
		end
		return
	end

	setupLeaderstats(player)
	spawnCharacter(player)
end

local function onPlayerRemoving(player: Player)
	ToolService.OnPlayerRemoving(player)
	DataService.ReleaseProfile(player) -- yields until the final save completes
	IslandService.ReleaseIsland(player) -- only after the island's data is safe
	respawning[player] = nil
	convertingToR15[player] = nil
end

function PlayerService.Init()
	Players.CharacterAutoLoads = false
end

function PlayerService.Start()
	DataService.Changed:Connect(updateLeaderstats)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- Play time statistic.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				if DataService.IsLoaded(player) then
					DataService.Increment(player, { "Stats", "PlayTime" }, 60)
				end
			end
		end
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ProgressionService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/ProgressionService
	DEPENDENCIES: DataService, SoundService, VFXService, Shared.Config.ProgressionConfig,
	              Server.Util.Notify

	Player XP/level and Island XP/level. XP is only ever awarded by SOURCE id
	(ProgressionConfig.Sources) — the amount is decided here, never by a
	client (spec §42). Phase 11 extends this with achievements/titles.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local GameConfig = require(Shared.Config.GameConfig)
local Signal = require(Shared.Util.Signal)

local Services = script.Parent
local DataService = require(Services.DataService)
local GameSoundService = require(Services.SoundService)
local VFXService = require(Services.VFXService)
local Notify = require(script.Parent.Parent.Util.Notify)

local ProgressionService = {}

ProgressionService.PlayerLevelUp = Signal.new() -- (player, newLevel)
ProgressionService.IslandLevelUp = Signal.new() -- (player, newLevel)

local function characterPosition(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position - Vector3.new(0, 2.5, 0)
	end
	return nil
end

local function applyXP(player: Player, xpPath: { string }, levelPath: { string }, amount: number, maxLevel: number, xpForLevel: (number) -> number): number?
	local xp = DataService.Get(player, xpPath)
	local level = DataService.Get(player, levelPath)
	if type(xp) ~= "number" or type(level) ~= "number" then
		return nil
	end
	xp += amount
	local startLevel = level
	while level < maxLevel and xp >= xpForLevel(level) do
		xp -= xpForLevel(level)
		level += 1
	end
	if level >= maxLevel then
		xp = 0
	end
	DataService.Set(player, xpPath, xp)
	if level ~= startLevel then
		DataService.Set(player, levelPath, level)
		return level
	end
	return nil
end

function ProgressionService.AddPlayerXP(player: Player, amount: number, reason: string)
	if amount <= 0 then
		return
	end
	local newLevel = applyXP(player, { "XP" }, { "Level" }, math.floor(amount), ProgressionConfig.Player.MaxLevel, ProgressionConfig.PlayerXPForLevel)
	if newLevel then
		Notify.Banner(player, "LEVEL UP!", ("You reached level %d"):format(newLevel), "LevelUp")
		GameSoundService.PlayFor(player, "LevelUp")
		local position = characterPosition(player)
		if position then
			VFXService.PlayAt("LevelUp", position)
		end
		ProgressionService.PlayerLevelUp:Fire(player, newLevel)
	end
	if GameConfig.Debug then
		print(("[Progression] %s +%d player XP (%s)"):format(player.Name, amount, reason))
	end
end

function ProgressionService.AddIslandXP(player: Player, amount: number, reason: string)
	if amount <= 0 then
		return
	end
	local newLevel = applyXP(
		player,
		{ "Island", "XP" },
		{ "Island", "Level" },
		math.floor(amount),
		ProgressionConfig.Island.MaxLevel,
		ProgressionConfig.IslandXPForLevel
	)
	if newLevel then
		Notify.Banner(player, "ISLAND LEVEL UP!", ("Island Level %d — %s"):format(newLevel, ProgressionConfig.GetIslandTitle(newLevel)), "IslandLevelUp")
		GameSoundService.PlayFor(player, "IslandLevelUp")
		local position = characterPosition(player)
		if position then
			VFXService.PlayAt("IslandLevelUp", position)
		end
		ProgressionService.IslandLevelUp:Fire(player, newLevel)
	end
	if GameConfig.Debug then
		print(("[Progression] %s +%d island XP (%s)"):format(player.Name, amount, reason))
	end
end

-- Award XP for a configured source, e.g. Award(player, "StarterChest").
function ProgressionService.Award(player: Player, sourceId: string, multiplier: number?)
	local source = ProgressionConfig.Sources[sourceId]
	if not source then
		warn("[Progression] Unknown XP source " .. tostring(sourceId))
		return
	end
	local scale = multiplier or 1
	if source.Player then
		ProgressionService.AddPlayerXP(player, source.Player * scale, sourceId)
	end
	if source.Island then
		ProgressionService.AddIslandXP(player, source.Island * scale, sourceId)
	end
end

-- Admin/debug helper.
function ProgressionService.SetIslandLevel(player: Player, level: number)
	local clamped = math.clamp(math.floor(level), 1, ProgressionConfig.Island.MaxLevel)
	DataService.Set(player, { "Island", "XP" }, 0)
	DataService.Set(player, { "Island", "Level" }, clamped)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">SoundService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  SoundService  (game service wrapper — not Roblox's SoundService)
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/SoundService
	DEPENDENCIES: Shared.Net, Shared.Config.SoundConfig

	Server-side entry point for gameplay sounds. The server decides WHAT
	happened; clients (AudioController) do the actual playback so sounds are
	pooled and never replicate as Instances.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local SoundConfig = require(Shared.Config.SoundConfig)

local HEARING_RANGE = 150

local GameSoundService = {}

local function isKnown(soundName: string): boolean
	if SoundConfig.Sounds[soundName] then
		return true
	end
	warn("[SoundService] Unknown sound '" .. tostring(soundName) .. "'")
	return false
end

-- 2D sound for one player (UI-style).
function GameSoundService.PlayFor(player: Player, soundName: string)
	if isKnown(soundName) then
		Net.FireClient("PlaySound", player, soundName, nil)
	end
end

-- 3D sound heard by everyone near `position`.
function GameSoundService.PlayAt(soundName: string, position: Vector3)
	if not isKnown(soundName) then
		return
	end
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - position).Magnitude <= HEARING_RANGE then
			Net.FireClient("PlaySound", player, soundName, position)
		end
	end
end

return GameSoundService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/ToolService
	DEPENDENCIES: DataService, AntiExploitService, SoundService, Server.Tools.ToolModelFactory,
	              Shared.Config.ToolConfig, Shared.Util.{R15, Validate}, Shared.Net

	Tool framework (spec §18, §77, §78):
	  * ownership + hotbar live in the profile (Tools.Owned / Tools.Hotbar),
	  * equipping is SERVER-authoritative: the client asks, the server checks
	    ownership, builds the model and joins it to the R15 hand with a
	    Motor6D named "ToolGrip" (Part0 = RightHand, C0 = RightGripAttachment),
	    so the tool never floats and can be keyframed by real animations,
	  * the character gets attribute EquippedTool = toolId, which clients use
	    to play the matching hold/use animations from ToolConfig.

	Roblox's own Tool/Backpack system is intentionally NOT used: we need
	custom grips, custom hotbar UI and server-controlled tool stats.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local ToolConfig = require(Shared.Config.ToolConfig)
local R15 = require(Shared.Util.R15)
local Validate = require(Shared.Util.Validate)

local Services = script.Parent
local DataService = require(Services.DataService)
local AntiExploitService = require(Services.AntiExploitService)
local GameSoundService = require(Services.SoundService)
local ToolModelFactory = require(script.Parent.Parent.Tools.ToolModelFactory)

local ToolService = {}

local equippedModels: { [Player]: Model } = {}

function ToolService.HasTool(player: Player, toolId: string): boolean
	return DataService.Get(player, { "Tools", "Owned", toolId }) == true
end

function ToolService.GetEquippedId(player: Player): string?
	local equipped = DataService.Get(player, { "Tools", "Equipped" })
	if type(equipped) == "string" and equipped ~= "" then
		return equipped
	end
	return nil
end

function ToolService.GetEquipped(player: Player): any
	local toolId = ToolService.GetEquippedId(player)
	return toolId and ToolConfig.Get(toolId)
end

-- Best owned tool of a type (highest tier), used by gathering in Phase 2.
function ToolService.GetBestTool(player: Player, toolType: string): any
	local owned = DataService.Get(player, { "Tools", "Owned" })
	local best = nil
	if owned then
		for toolId in owned do
			local def = ToolConfig.Get(toolId)
			if def and def.Type == toolType and (best == nil or def.TierOrder > best.TierOrder) then
				best = def
			end
		end
	end
	return best
end

function ToolService.GrantTool(player: Player, toolId: string, reason: string): boolean
	if not ToolConfig.Get(toolId) then
		warn(("[ToolService] Unknown tool %s (%s)"):format(tostring(toolId), reason))
		return false
	end
	if not DataService.IsLoaded(player) or ToolService.HasTool(player, toolId) then
		return false
	end
	DataService.Set(player, { "Tools", "Owned", toolId }, true)
	local hotbar = table.clone(DataService.Get(player, { "Tools", "Hotbar" }) or {})
	if #hotbar < ToolConfig.HotbarSize and not table.find(hotbar, toolId) then
		table.insert(hotbar, toolId)
		DataService.Set(player, { "Tools", "Hotbar" }, hotbar)
	end
	return true
end

local function destroyModel(player: Player)
	local model = equippedModels[player]
	if model then
		equippedModels[player] = nil
		model:Destroy()
	end
end

local function attachModel(character: Model, toolDef: any): Model?
	local handName = toolDef.Grip.Hand
	local hand = R15.GetPart(character, handName)
	if not hand then
		return nil
	end
	local model = ToolModelFactory.Build(toolDef)
	local handle = model.PrimaryPart
	local grip = handle and handle:FindFirstChild("Grip")
	if not handle or not grip or not grip:IsA("Attachment") then
		model:Destroy()
		return nil
	end

	local gripAttachment = hand:FindFirstChild(R15.GripAttachments[handName] or "")
	local handGrip = if gripAttachment and gripAttachment:IsA("Attachment")
		then gripAttachment.CFrame
		else CFrame.new(0, -hand.Size.Y / 2, 0) * CFrame.Angles(-math.pi / 2, 0, 0)

	local motor = Instance.new("Motor6D")
	motor.Name = "ToolGrip"
	motor.Part0 = hand
	motor.Part1 = handle
	motor.C0 = handGrip * toolDef.Grip.Offset
	motor.C1 = grip.CFrame
	-- Move the whole model (PrimaryPart = Handle) next to the hand before joining it.
	model:PivotTo(hand.CFrame * motor.C0 * motor.C1:Inverse())
	model.Parent = character
	motor.Parent = hand
	return model
end

-- Server-side equip. toolId nil/"" unequips. Returns success.
function ToolService.Equip(player: Player, toolId: string?): boolean
	if not DataService.IsLoaded(player) then
		return false
	end
	local character = player.Character
	destroyModel(player)
	if character then
		for handName in R15.GripAttachments do
			local hand = R15.GetPart(character, handName)
			local stale = hand and hand:FindFirstChild("ToolGrip")
			if stale then
				stale:Destroy()
			end
		end
	end

	if toolId == nil or toolId == "" then
		DataService.Set(player, { "Tools", "Equipped" }, "")
		if character then
			character:SetAttribute("EquippedTool", nil)
		end
		return true
	end

	local toolDef = ToolConfig.Get(toolId)
	if not toolDef or not ToolService.HasTool(player, toolId) then
		return false
	end
	DataService.Set(player, { "Tools", "Equipped" }, toolId)
	if not DataService.Get(player, { "Flags", "FirstEquip" }) then
		DataService.Set(player, { "Flags", "FirstEquip" }, true)
	end

	if not character or not R15.IsAlive(character) then
		return true -- saved; the model is attached on next spawn
	end
	local model = attachModel(character, toolDef)
	if not model then
		warn("[ToolService] Could not attach " .. toolId .. " to " .. player.Name .. " (is the rig R15?)")
		return false
	end
	equippedModels[player] = model
	character:SetAttribute("EquippedTool", toolId)
	local root = R15.GetRootPart(character)
	if root then
		GameSoundService.PlayAt("ToolEquip", root.Position)
	end
	return true
end

-- Called by PlayerService after each (re)spawn.
function ToolService.OnCharacterSpawned(player: Player, _character: Model)
	local equipped = ToolService.GetEquippedId(player)
	if equipped then
		ToolService.Equip(player, equipped)
	end
end

function ToolService.OnPlayerRemoving(player: Player)
	destroyModel(player)
end

function ToolService.Init()
	Net.OnServerEvent("EquipToolRequest", function(player: Player, toolId: any)
		if toolId == nil or toolId == "" then
			ToolService.Equip(player, nil)
			return
		end
		if not Validate.Id(toolId) or not ToolConfig.Get(toolId) then
			AntiExploitService.Flag(player, "InvalidToolId", 2)
			return
		end
		if not ToolService.HasTool(player, toolId) then
			AntiExploitService.Flag(player, "EquipUnownedTool", 1)
			return
		end
		ToolService.Equip(player, toolId)
	end)
end

return ToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">VFXService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  VFXService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/VFXService
	DEPENDENCIES: Shared.Net, Shared.Config.{VFXConfig, GameConfig}

	Server-side entry point for effects and camera feedback. Clients render
	them (VFXController / CameraController) with pooling and distance culling.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Net = require(Shared.Net)
local VFXConfig = require(Shared.Config.VFXConfig)
local GameConfig = require(Shared.Config.GameConfig)

local VFXService = {}

local function isKnown(effectName: string): boolean
	if VFXConfig.Effects[effectName] then
		return true
	end
	warn("[VFXService] Unknown effect '" .. tostring(effectName) .. "'")
	return false
end

-- Everyone nearby sees it (clients cull by VFXConfig.MaxDistance).
function VFXService.PlayAt(effectName: string, position: Vector3)
	if isKnown(effectName) then
		Net.FireAllClients("PlayVFX", effectName, position)
	end
end

-- Only one player sees it (personal feedback).
function VFXService.PlayFor(player: Player, effectName: string, position: Vector3)
	if isKnown(effectName) then
		Net.FireClient("PlayVFX", player, effectName, position)
	end
end

function VFXService.ShakeCamera(player: Player, intensity: number, duration: number?)
	local capped = math.clamp(intensity, 0, GameConfig.Camera.MaxShakeIntensity)
	Net.FireClient("CameraShake", player, capped, duration or 0.3)
end

return VFXService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  WorldService
	SCRIPT TYPE:  ModuleScript (server service)
	WHERE:        ServerScriptService/Server/Services/WorldService
	DEPENDENCIES: Shared.Config.{GameConfig, IslandConfig}, Shared.Util.IslandLayout

	Shared world setup (not owned by any single player):
	  * the Workspace folder structure,
	  * base lighting + atmosphere (WeatherService takes over in Phase 13),
	  * terrain materials + the ocean around every island slot.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandLayout = require(Shared.Util.IslandLayout)

local WorldConfig = GameConfig.World

local WORKSPACE_FOLDERS = { "Islands", "ResourceZones", "NPCs", "FishingZones", "World" }

local WorldService = {}

WorldService.Folders = {} :: { [string]: Folder }

function WorldService.GetFolder(name: string): Folder
	local folder = WorldService.Folders[name]
	assert(folder, "Unknown workspace folder " .. name)
	return folder
end

local function ensureFolders()
	for _, name in WORKSPACE_FOLDERS do
		local folder = workspace:FindFirstChild(name)
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = name
			folder.Parent = workspace
		end
		WorldService.Folders[name] = folder :: Folder
	end
end

local function applyLighting()
	Lighting.ClockTime = WorldConfig.ClockTime
	Lighting.Brightness = WorldConfig.Brightness
	Lighting.Ambient = WorldConfig.Ambient
	Lighting.OutdoorAmbient = WorldConfig.OutdoorAmbient
	Lighting.EnvironmentDiffuseScale = WorldConfig.EnvironmentDiffuseScale
	Lighting.EnvironmentSpecularScale = WorldConfig.EnvironmentSpecularScale
	Lighting.GlobalShadows = true

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = WorldConfig.Atmosphere.Density
	atmosphere.Offset = WorldConfig.Atmosphere.Offset
	atmosphere.Color = WorldConfig.Atmosphere.Color
	atmosphere.Decay = WorldConfig.Atmosphere.Decay
	atmosphere.Glare = WorldConfig.Atmosphere.Glare
	atmosphere.Haze = WorldConfig.Atmosphere.Haze
	atmosphere.Parent = Lighting

	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.4
		bloom.Size = 20
		bloom.Threshold = 1.6
		bloom.Parent = Lighting
	end
	if not Lighting:FindFirstChildOfClass("ColorCorrectionEffect") then
		local color = Instance.new("ColorCorrectionEffect")
		color.Saturation = 0.12
		color.Contrast = 0.05
		color.Parent = Lighting
	end
end

local function applyTerrainLook()
	local terrain = workspace.Terrain :: Terrain
	terrain.WaterColor = WorldConfig.WaterColor
	terrain.WaterTransparency = WorldConfig.WaterTransparency
	terrain.WaterReflectance = WorldConfig.WaterReflectance
	terrain.WaterWaveSize = WorldConfig.WaterWaveSize
	terrain.WaterWaveSpeed = WorldConfig.WaterWaveSpeed
	-- Note: Terrain.Decoration (animated grass) can't be set from scripts;
	-- toggle it on Workspace.Terrain in Studio's Properties window instead.
	for materialName, color in WorldConfig.MaterialColors do
		local material = (Enum.Material :: any)[materialName]
		if material then
			terrain:SetMaterialColor(material, color)
		end
	end
end

-- Fills the ocean (water + sand seabed) under every island slot, in tiles.
local function fillOcean()
	local terrain = workspace.Terrain :: Terrain
	local slotCount = GameConfig.MaxIslandsPerServer
	local rows = math.ceil(slotCount / IslandConfig.SlotsPerRow)
	local columns = math.min(slotCount, IslandConfig.SlotsPerRow)
	local margin = WorldConfig.OceanMargin
	local minX = -margin
	local minZ = -margin
	local maxX = (columns - 1) * IslandConfig.SlotSpacing + margin
	local maxZ = (rows - 1) * IslandConfig.SlotSpacing + margin
	local tile = WorldConfig.OceanTileSize
	local sea = IslandConfig.SeaLevel
	local depth = WorldConfig.OceanDepth
	local bed = WorldConfig.SeabedThickness

	for x = minX, maxX - 1, tile do
		for z = minZ, maxZ - 1, tile do
			local sizeX = math.min(tile, maxX - x)
			local sizeZ = math.min(tile, maxZ - z)
			local centerX = x + sizeX / 2
			local centerZ = z + sizeZ / 2
			terrain:FillBlock(CFrame.new(centerX, sea - depth / 2, centerZ), Vector3.new(sizeX, depth, sizeZ), Enum.Material.Water)
			terrain:FillBlock(CFrame.new(centerX, sea - depth - bed / 2, centerZ), Vector3.new(sizeX, bed, sizeZ), Enum.Material.Sand)
		end
		task.wait() -- spread the work over a few frames
	end
end

-- Restores open ocean in a cylinder (used when an island is cleaned up).
function WorldService.RestoreOcean(center: Vector3, radius: number)
	local terrain = workspace.Terrain :: Terrain
	local sea = IslandConfig.SeaLevel
	local depth = WorldConfig.OceanDepth
	local bed = WorldConfig.SeabedThickness
	local airHeight = 120
	terrain:FillCylinder(CFrame.new(center.X, sea + airHeight / 2, center.Z), airHeight, radius, Enum.Material.Air)
	terrain:FillCylinder(CFrame.new(center.X, sea - depth / 2, center.Z), depth, radius, Enum.Material.Water)
	terrain:FillCylinder(CFrame.new(center.X, sea - depth - bed / 2, center.Z), bed, radius, Enum.Material.Sand)
end

function WorldService.Init()
	ensureFolders()
end

function WorldService.Start()
	applyLighting()
	applyTerrainLook()
	fillOcean()
	-- Slot 1 origin sanity check for the log (helps when debugging layouts).
	if GameConfig.Debug then
		print("[WorldService] Ocean ready. Slot 1 origin:", IslandLayout.GetSlotOrigin(1).Position)
	end
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="57">
        <Properties>
          <string name="Name">Tools</string>
        </Properties>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">ToolModelFactory</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolModelFactory
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Tools/ToolModelFactory
	DEPENDENCIES: none (reads ToolConfig definitions passed in)
	REQUIRED OBJECTS: optional art in ServerStorage/Tools/<ToolId>

	Builds the physical tool model that ToolService welds into the R15 hand.

	CUSTOM ART: put a Model named exactly like the tool id (e.g. "WoodenAxe")
	in ServerStorage/Tools. It must contain:
	  * a BasePart named "Handle"
	  * an Attachment named "Grip" inside Handle, positioned where the palm
	    holds it. The Grip's +Y axis points along the tool (towards the head),
	    its -Z axis points where the blade/tip faces.
	If no art exists, a clean low-poly placeholder is generated from the
	tool's Shape + tier colours so the game is fully playable today.
]]

local ServerStorage = game:GetService("ServerStorage")

local HANDLE_COLOR = Color3.fromRGB(125, 85, 50)

type PartSpec = {
	Name: string,
	Size: Vector3,
	Offset: CFrame,
	Head: boolean?, -- uses the tier colour/material
	Color: Color3?,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
}

type ShapeSpec = { HandleLength: number, HandleThickness: number, Parts: { PartSpec } }

-- Handle is centred at the origin with its long axis along +Y.
local SHAPES: { [string]: ShapeSpec } = {
	Axe = {
		HandleLength = 3.2,
		HandleThickness = 0.25,
		Parts = {
			{ Name = "Blade", Size = Vector3.new(0.2, 0.85, 1.1), Offset = CFrame.new(0, 1.2, -0.55), Head = true },
			{ Name = "Poll", Size = Vector3.new(0.3, 0.45, 0.35), Offset = CFrame.new(0, 1.2, 0.2), Head = true },
		},
	},
	Pickaxe = {
		HandleLength = 3.2,
		HandleThickness = 0.25,
		Parts = {
			{ Name = "Head", Size = Vector3.new(0.3, 0.3, 2.4), Offset = CFrame.new(0, 1.45, 0), Head = true },
			{ Name = "TipA", Size = Vector3.new(0.2, 0.2, 0.4), Offset = CFrame.new(0, 1.35, -1.3), Head = true },
			{ Name = "TipB", Size = Vector3.new(0.2, 0.2, 0.4), Offset = CFrame.new(0, 1.35, 1.3), Head = true },
		},
	},
	Hammer = {
		HandleLength = 2.4,
		HandleThickness = 0.25,
		Parts = {
			{ Name = "Head", Size = Vector3.new(0.6, 0.6, 1.3), Offset = CFrame.new(0, 1.1, 0), Head = true },
		},
	},
	Shovel = {
		HandleLength = 3.8,
		HandleThickness = 0.22,
		Parts = {
			{ Name = "Blade", Size = Vector3.new(0.12, 1.1, 0.9), Offset = CFrame.new(0, 2.3, 0), Head = true },
			{ Name = "Grip", Size = Vector3.new(0.25, 0.25, 0.7), Offset = CFrame.new(0, -1.9, 0) },
		},
	},
	Hoe = {
		HandleLength = 3.8,
		HandleThickness = 0.22,
		Parts = {
			{ Name = "Blade", Size = Vector3.new(0.15, 0.35, 0.9), Offset = CFrame.new(0, 1.85, -0.4), Head = true },
		},
	},
	WateringCan = {
		HandleLength = 0.9,
		HandleThickness = 0.2,
		Parts = {
			{ Name = "Body", Size = Vector3.new(0.9, 1, 1.2), Offset = CFrame.new(0, 0.6, -0.2), Head = true },
			{ Name = "Spout", Size = Vector3.new(0.15, 0.15, 1.1), Offset = CFrame.new(0, 0.9, -1.2) * CFrame.Angles(math.rad(25), 0, 0), Head = true },
		},
	},
	FishingRod = {
		HandleLength = 5.5,
		HandleThickness = 0.14,
		Parts = {
			{ Name = "Reel", Size = Vector3.new(0.35, 0.35, 0.35), Offset = CFrame.new(0, -1.9, 0.2), Head = true, Shape = Enum.PartType.Ball },
			{ Name = "Tip", Size = Vector3.new(0.1, 0.3, 0.1), Offset = CFrame.new(0, 2.85, 0), Color = Color3.fromRGB(230, 60, 60), Material = Enum.Material.SmoothPlastic },
		},
	},
	Bucket = {
		HandleLength = 0.8,
		HandleThickness = 0.12,
		Parts = {
			{ Name = "Pail", Size = Vector3.new(1.1, 1, 1.1), Offset = CFrame.new(0, -0.7, 0), Head = true },
		},
	},
	Shears = {
		HandleLength = 1,
		HandleThickness = 0.2,
		Parts = {
			{ Name = "BladeA", Size = Vector3.new(0.08, 1, 0.18), Offset = CFrame.new(0.06, 0.9, 0) * CFrame.Angles(0, 0, math.rad(6)), Head = true },
			{ Name = "BladeB", Size = Vector3.new(0.08, 1, 0.18), Offset = CFrame.new(-0.06, 0.9, 0) * CFrame.Angles(0, 0, math.rad(-6)), Head = true },
		},
	},
}

local ToolModelFactory = {}

local function preparePart(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = true
end

local function fromCustomArt(toolId: string): Model?
	local folder = ServerStorage:FindFirstChild("Tools")
	local template = folder and folder:FindFirstChild(toolId)
	if not template or not template:IsA("Model") then
		return nil
	end
	local model = template:Clone()
	local handle = model:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") or not handle:FindFirstChild("Grip") then
		warn(("[Tools] ServerStorage.Tools.%s needs a Handle part with a Grip attachment; using placeholder"):format(toolId))
		model:Destroy()
		return nil
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			preparePart(descendant)
		end
	end
	model.PrimaryPart = handle
	return model
end

local function fromShape(toolDef: any): Model
	local shape = SHAPES[toolDef.Shape] or SHAPES.Hammer
	local model = Instance.new("Model")

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(shape.HandleThickness, shape.HandleLength, shape.HandleThickness)
	handle.Color = HANDLE_COLOR
	handle.Material = Enum.Material.Wood
	handle.TopSurface = Enum.SurfaceType.Smooth
	handle.BottomSurface = Enum.SurfaceType.Smooth
	preparePart(handle)
	handle.CFrame = CFrame.new()
	handle.Parent = model

	local grip = Instance.new("Attachment")
	grip.Name = "Grip"
	grip.Position = Vector3.new(0, -shape.HandleLength / 2 + 0.45, 0)
	grip.Parent = handle

	for _, spec in shape.Parts do
		local part = Instance.new("Part")
		part.Name = spec.Name
		part.Shape = spec.Shape or Enum.PartType.Block
		part.Size = spec.Size
		part.Color = if spec.Head then toolDef.HeadColor else (spec.Color or HANDLE_COLOR)
		part.Material = if spec.Head then toolDef.HeadMaterial else (spec.Material or Enum.Material.Wood)
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		preparePart(part)
		part.CFrame = handle.CFrame * spec.Offset
		-- Explicit C0 (not WeldConstraint) so the offset is exact no matter
		-- where the parts are when the model enters the workspace.
		local weld = Instance.new("Weld")
		weld.Part0 = handle
		weld.Part1 = part
		weld.C0 = spec.Offset
		weld.Parent = part
		part.Parent = model
	end

	model.PrimaryPart = handle
	return model
end

-- Returns a Model with PrimaryPart "Handle" containing a "Grip" Attachment.
function ToolModelFactory.Build(toolDef: any): Model
	local model = fromCustomArt(toolDef.Id) or fromShape(toolDef)
	model.Name = "EquippedTool"
	model:SetAttribute("ToolId", toolDef.Id)
	return model
end

return ToolModelFactory
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="59">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Notify
	SCRIPT TYPE:  ModuleScript (server helper)
	WHERE:        ServerScriptService/Server/Util/Notify
	DEPENDENCIES: Shared.Net

	Consistent "Did that work?" feedback (spec §151). Every server action that
	succeeds or fails tells the player through one of these.

	Kinds understood by the client UI:
		Toast   small message under the top bar
		Success green toast
		Error   red toast + error sound
		Banner  big centred title (level up, area unlocked, build complete)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)

local Notify = {}

function Notify.Toast(player: Player, text: string, icon: string?)
	Net.FireClient("Notify", player, { Kind = "Toast", Text = text, Icon = icon })
end

function Notify.Success(player: Player, text: string, icon: string?)
	Net.FireClient("Notify", player, { Kind = "Success", Text = text, Icon = icon })
end

function Notify.Error(player: Player, text: string)
	Net.FireClient("Notify", player, { Kind = "Error", Text = text, Icon = "⚠️" })
end

function Notify.Banner(player: Player, title: string, subtitle: string?, style: string?)
	Net.FireClient("Notify", player, { Kind = "Banner", Text = title, Subtitle = subtitle, Style = style })
end

return Notify
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
