BUILDERS.Campfire = function(model, _def)
	for index = 1, 8 do
		local angle = index / 8 * math.pi * 2
		part(model, 1, { Name = "Stone", Size = Vector3.new(0.9, 0.7, 0.9), CFrame = CFrame.new(math.cos(angle) * 1.5, 0.35, math.sin(angle) * 1.5) * CFrame.Angles(0, angle, 0), Color = C.StoneDark, Material = Enum.Material.Slate })
	end
	for index = 1, 3 do
		local angle = index / 3 * math.pi
		part(model, 2, { Name = "Log", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 0.5, 0.5), CFrame = CFrame.new(0, 0.45, 0) * CFrame.Angles(0, angle, math.rad(10)), Color = C.WoodDark, Material = Enum.Material.Wood })
	end
	local core = part(model, 2, { Name = "FireCore", Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(0, 0.8, 0), Color = Color3.fromRGB(255, 150, 50), Material = Enum.Material.Neon, CanCollide = false, Transparency = 0.4 })
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 5
	fire.Parent = core
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 1.6
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Parent = core
end

-- Builds the model at the origin (base centre on the ground, front = -Z).
function BuildingModels.Build(buildingId: string): Model
	local def = BuildingConfig.Get(buildingId)
	assert(def, "Unknown building " .. tostring(buildingId))
	local model = Instance.new("Model")
	model.Name = buildingId
	local base = part(model, 0, {
		Name = "Base",
		Size = Vector3.new(def.Footprint.X, 0.2, def.Footprint.Y),
		CFrame = CFrame.new(0, 0.1, 0),
		Color = Color3.new(1, 1, 1),
		CanCollide = false,
		Transparency = 1,
	})
	local builder = BUILDERS[buildingId]
	if builder then
		builder(model, def)
	end
	-- Pivot = base centre ON the ground (explicit, so it never depends on
	-- how Roblox maps WorldPivot onto a PrimaryPart).
	base.PivotOffset = base.CFrame:ToObjectSpace(CFrame.new())
	model.PrimaryPart = base
	return model
end

-- Shows parts whose Stage <= stage. animate = fade newly revealed parts in.
function BuildingModels.SetStage(model: Model, stage: number, animate: boolean?)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local partStage = descendant:GetAttribute("Stage")
			if type(partStage) == "number" and partStage > 0 then
				local visible = partStage <= stage
				local baseTransparency = descendant:GetAttribute("BaseTransparency")
				local target = if visible then (if type(baseTransparency) == "number" then baseTransparency else 0) else 1
				local baseCollide = descendant:GetAttribute("BaseCanCollide")
				descendant.CanCollide = visible and baseCollide ~= false
				if animate and visible and descendant.Transparency >= 0.99 and target < 0.99 then
					TweenService:Create(descendant, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Transparency = target }):Play()
				else
					descendant.Transparency = target
				end
				for _, child in descendant:GetChildren() do
					if child:IsA("Light") or child:IsA("Fire") or child:IsA("ParticleEmitter") then
						child.Enabled = visible
					end
				end
			end
		end
	end
end

-- Turns a model into a see-through, non-colliding placement preview.
function BuildingModels.MakeGhost(model: Model)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local baseTransparency = descendant:GetAttribute("BaseTransparency")
			descendant.Transparency = if type(baseTransparency) == "number" and baseTransparency >= 0.99 then 1 else 0.45
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.CastShadow = false
			descendant.Anchored = true
		elseif descendant:IsA("Light") or descendant:IsA("Fire") or descendant:IsA("ParticleEmitter") then
			descendant.Enabled = false
		end
	end
end

-- Number of hammer hits to finish this building.
function BuildingModels.GetSteps(buildingId: string): number
	local def = BuildingConfig.Get(buildingId)
	return if def then def.Steps else 1
end

return BuildingModels
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">AnimalConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/AnimalConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Animals, their products and the (gentle) care model.

	CARE LOOP:  Feed (costs Food) -> happiness up, production starts
	            -> after ProduceTime the product is READY -> Milk / Collect
	Happiness only drops while an animal is hungry, never below
	HappinessFloor, and high happiness gives a bonus product. Everything is
	computed from timestamps (Shared/Util/AnimalMath) — no per-frame work.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local AnimalConfig = {
	FullnessDurationMinutes = 12, -- a full animal gets hungry after this long
	HungryBelow = 25, -- fullness % at which it counts as hungry
	HappinessDecayPerMinute = 2, -- only while hungry
	HappinessFloor = 30,
	StartHappiness = 70,
	FeedHappiness = 15,
	PetHappiness = 8,
	PetCooldown = 30,
	BonusProduceAtHappiness = 80,
	WanderInterval = 2.5,
	ActiveRange = 160, -- animals only wander while a player is this close

	Animals = {
		Cow = {
			DisplayName = "Cow", Icon = "🐄", Price = 120, UnlockLevel = 1,
			Housing = "Barn", Food = "Wheat", FoodAmount = 1,
			Produce = "Milk", ProduceTime = 90, ProduceAmount = 1,
			ProduceVerb = "Milk Cow", ProduceTool = "Bucket", ProduceAnimation = "MilkCow", ProduceMarker = "Milk",
			ProduceVFX = "MilkSplash", ProduceSound = "Milk", WalkSpeed = 3, Voice = "CowMoo",
			Variants = {
				{ Id = "Brown", Weight = 50, Body = Color3.fromRGB(125, 85, 55), Spots = Color3.fromRGB(245, 240, 230) },
				{ Id = "Spotted", Weight = 42, Body = Color3.fromRGB(245, 245, 240), Spots = Color3.fromRGB(45, 40, 40) },
				{ Id = "Golden", Weight = 3, Body = Color3.fromRGB(245, 200, 70), Spots = Color3.fromRGB(255, 240, 180), ProduceBonus = 1 },
			},
		},
		Chicken = {
			DisplayName = "Chicken", Icon = "🐔", Price = 50, UnlockLevel = 1,
			Housing = "ChickenCoop", Food = "Wheat", FoodAmount = 1,
			Produce = "Egg", ProduceTime = 60, ProduceAmount = 1,
			ProduceVerb = "Collect Eggs", ProduceTool = nil, ProduceAnimation = "PickCrop", ProduceMarker = "Pick",
			ProduceVFX = "Sparkle", ProduceSound = "Harvest", WalkSpeed = 4, Voice = "ChickenCluck",
			Variants = {
				{ Id = "White", Weight = 55, Body = Color3.fromRGB(250, 250, 245), Spots = Color3.fromRGB(230, 60, 50) },
				{ Id = "Brown", Weight = 40, Body = Color3.fromRGB(170, 110, 60), Spots = Color3.fromRGB(230, 60, 50) },
				{ Id = "Golden", Weight = 3, Body = Color3.fromRGB(250, 205, 70), Spots = Color3.fromRGB(230, 60, 50), ProduceBonus = 1 },
			},
		},
	},

	Order = { "Cow", "Chicken" },

	Items = {
		Milk = { DisplayName = "Milk", Category = "AnimalProducts", Rarity = "Common", SellValue = 30, Icon = "🥛", Description = "Fresh milk from a happy cow." },
		Egg = { DisplayName = "Egg", Category = "AnimalProducts", Rarity = "Common", SellValue = 15, Icon = "🥚", Description = "A freshly laid egg." },
	},
}

for animalId, animal in AnimalConfig.Animals do
	animal.Id = animalId
end

return TableUtil.DeepFreeze(AnimalConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">AnimationConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/AnimationConfig
	DEPENDENCIES: Shared.Util.TableUtil

	HOW ANIMATION WORKS IN THIS GAME
	Every action below is FULLY ANIMATED out of the box: real R15 keyframes
	live in Shared/Animation/Keyframes and every client plays them on every
	character (so all players see each other chop, fish, milk, dance...).
	The Id fields are "rbxassetid://PLACEHOLDER" because no uploaded
	animation ships with this project (we never invent asset ids). If you
	upload your own R15 animation, paste its id here and clients play it
	instead of the built-in keyframes — nothing else changes.

	Length and Markers here drive BOTH the keyframes (impact frames sit on the
	markers) and the server's gameplay timing (AnimationService.PerformAction).

	Field reference (spec §74):
		Id            rbxassetid:// of the uploaded animation
		Purpose       what gameplay it supports
		Priority      Core | Idle | Movement | Action | Action2 | Action3 | Action4
		Length        seconds (at Speed 1). Used for placeholder timing.
		Looped        loops until stopped
		Markers       { MarkerName = timeInSeconds } — gameplay reacts to these
		MarkerEffects { MarkerName = { Sound = "<SoundConfig id>", VFX = "<VFXConfig id>", Shake = number } }
		BodyParts     which R15 parts the animation should key (documentation for animators)
		Start / End   start + end conditions (documentation)
		Interruptible can a new action cut it off
		Repeat        play the keyframe cycle this many times (emotes)
		Trail         { from, to } fraction of Length when the held tool's
		              swing trail is visible (cartoon smear)
		MarkerEffects[...].Punch   camera punch strength for YOUR swings

	SWING VARIANTS: every tool has three swings (AnimationConfig.Variants).
	Each swing plays a random one; the client picks it (so its prediction
	matches) and tells the server, which plays the same one for everyone.
		Fallback      (legacy, unused)
		AnimateSlot   (Movement only) { childName, animationName } inside the default Animate script

	Priority rules (spec §73):
		Movement -> Movement | Tool actions -> Action | Building -> Action
		Fishing -> Action2 | Major interactions -> Action2
		Celebration -> Action3 | Death -> Action4
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER = "rbxassetid://PLACEHOLDER"

local ARMS = "RightUpperArm, RightLowerArm, RightHand, LeftUpperArm, LeftLowerArm, LeftHand, UpperTorso"
local FULL_BODY = "All R15 parts"

local function anim(def: { [string]: any })
	def.Id = def.Id or PLACEHOLDER
	def.Priority = def.Priority or "Action"
	def.Length = def.Length or 1
	def.Looped = def.Looped or false
	def.Markers = def.Markers or {}
	def.MarkerEffects = def.MarkerEffects or {}
	if def.Interruptible == nil then
		def.Interruptible = true
	end
	def.FadeIn = def.FadeIn or 0.1
	def.FadeOut = def.FadeOut or 0.15
	def.BodyParts = def.BodyParts or ARMS
	return def
end

local AnimationConfig = {
	-- If a REAL animation is missing a configured marker, fire it anyway this
	-- many seconds after its configured time (and warn once).
	MarkerWatchdogGrace = 0.15,

	Categories = {
		Movement = {
			Idle = anim({ Purpose = "Standing idle", Priority = "Idle", Looped = true, Length = 2, BodyParts = FULL_BODY, AnimateSlot = { "idle", "Animation1" } }),
			Walk = anim({ Purpose = "Walking", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "walk", "WalkAnim" }, Markers = { Footstep = 0.25 } }),
			Run = anim({ Purpose = "Running", Priority = "Movement", Looped = true, Length = 0.8, BodyParts = FULL_BODY, AnimateSlot = { "run", "RunAnim" }, Markers = { Footstep = 0.2 } }),
			Jump = anim({ Purpose = "Jump start", Priority = "Movement", Length = 0.4, BodyParts = FULL_BODY, AnimateSlot = { "jump", "JumpAnim" } }),
			Fall = anim({ Purpose = "Falling", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "fall", "FallAnim" } }),
			Climb = anim({ Purpose = "Climbing", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "climb", "ClimbAnim" } }),
			Swim = anim({ Purpose = "Swimming", Priority = "Movement", Looped = true, Length = 1.2, BodyParts = FULL_BODY, AnimateSlot = { "swim", "Swim" } }),
			SwimIdle = anim({ Purpose = "Treading water", Priority = "Movement", Looped = true, Length = 2, BodyParts = FULL_BODY, AnimateSlot = { "swimidle", "SwimIdle" } }),
		},

		Tools = {
			ToolHoldIdle = anim({ Purpose = "Generic one-handed tool hold", Looped = true, Length = 2, Fallback = "Hold", Start = "Tool equipped", End = "Tool unequipped" }),
			AxeIdle = anim({ Purpose = "Holding an axe", Looped = true, Length = 2, Fallback = "Hold", Start = "Axe equipped", End = "Axe unequipped" }),
			AxeSwing = anim({
				Purpose = "Chop a tree",
				Length = 0.6,
				Markers = { Hit = 0.3 },
				MarkerEffects = { Hit = { Sound = "AxeSwing", Punch = 1 } },
				Trail = { 0.3, 0.62 },
				Fallback = "Swing",
				Start = "UseTool with axe equipped",
				End = "Animation finishes (cooldown = ToolConfig UseCooldown)",
			}),
			AxeHeavySwing = anim({ Purpose = "Final chop / heavy hit", Length = 0.9, Markers = { Hit = 0.5 }, MarkerEffects = { Hit = { Sound = "AxeSwing", Punch = 1.6 } }, Trail = { 0.36, 0.66 }, Fallback = "HeavySwing" }),
			PickaxeIdle = anim({ Purpose = "Holding a pickaxe", Looped = true, Length = 2, Fallback = "Hold" }),
			PickaxeSwing = anim({ Purpose = "Mine a rock", Length = 0.65, Markers = { Hit = 0.32 }, MarkerEffects = { Hit = { Sound = "PickaxeSwing", Punch = 1 } }, Trail = { 0.28, 0.6 }, Fallback = "Swing" }),
			PickaxeHeavySwing = anim({ Purpose = "Break a rock", Length = 0.95, Markers = { Hit = 0.52 }, MarkerEffects = { Hit = { Sound = "PickaxeSwing", Punch = 1.6 } }, Trail = { 0.3, 0.62 }, Fallback = "HeavySwing" }),
			ShovelDig = anim({ Purpose = "Dig clay/sand", Length = 0.8, Markers = { Dig = 0.45 }, MarkerEffects = { Dig = { Sound = "ShovelDig", VFX = "DirtPuff", Punch = 0.6 } }, Trail = { 0.28, 0.62 }, Fallback = "Dig", BodyParts = FULL_BODY }),
			ShovelDigHeavy = anim({ Purpose = "Dig treasure", Length = 1.1, Markers = { Dig = 0.6 }, MarkerEffects = { Dig = { Sound = "ShovelDig", VFX = "DirtPuff", Punch = 1 } }, Trail = { 0.3, 0.62 }, Fallback = "Dig", BodyParts = FULL_BODY }),
			HoeTill = anim({ Purpose = "Till soil", Length = 0.7, Markers = { Till = 0.38 }, MarkerEffects = { Till = { Sound = "HoeTill", VFX = "DirtPuff", Punch = 0.6 } }, Trail = { 0.32, 0.62 }, Fallback = "Till" }),
			HoeSwing = anim({ Purpose = "Alias swing for hoe", Length = 0.7, Markers = { Till = 0.38 }, Fallback = "Till" }),
			WaterStart = anim({ Purpose = "Raise watering can", Length = 0.3, Fallback = "Pour" }),
			WaterLoop = anim({ Purpose = "Pouring water", Looped = true, Length = 0.8, Markers = { Water = 0.4 }, MarkerEffects = { Water = { VFX = "WaterSplash" } }, Fallback = "Pour" }),
			WaterEnd = anim({ Purpose = "Lower watering can", Length = 0.3, Fallback = "Pour" }),
			BucketSwing = anim({ Purpose = "Swing the bucket", Length = 0.7, Markers = { Hit = 0.35 }, MarkerEffects = { Hit = { Sound = "ToolSwing" } }, Trail = { 0.3, 0.62 } }),
			ShearsSnip = anim({ Purpose = "Snip with the shears", Length = 0.6, Markers = { Snip = 0.3 }, MarkerEffects = { Snip = { Sound = "Shears", VFX = "Sparkle" } }, Trail = { 0.3, 0.6 } }),
		},

		Building = {
			BuildIdle = anim({ Purpose = "Holding hammer / build stance", Looped = true, Length = 2, Fallback = "Hold" }),
			-- Spec §74 reference timeline: 0.00 prepare, 0.16 raise, 0.31 HammerHit, 0.35 progress, 0.40 VFX, 0.65 end.
			HammerSwing = anim({
				Purpose = "Advance construction by one step",
				Length = 0.65,
				Markers = { HammerHit = 0.31 },
				MarkerEffects = { HammerHit = { Sound = "HammerHit", VFX = "BuildDust", Punch = 1 } },
				Trail = { 0.28, 0.6 },
				Fallback = "Swing",
				Start = "Player hammers a construction site",
				End = "Animation finishes; loop again if still building",
			}),
			HammerHeavy = anim({ Purpose = "Final hammer hit", Length = 0.9, Markers = { HammerHit = 0.5 }, MarkerEffects = { HammerHit = { Sound = "HammerHit", VFX = "BuildDust", Punch = 1.8 } }, Trail = { 0.34, 0.64 }, Fallback = "HeavySwing" }),
			CarryMaterials = anim({ Purpose = "Carrying planks/stone", Looped = true, Length = 1, Fallback = "Carry" }),
			PlaceWood = anim({ Purpose = "Place a wood piece", Length = 0.7, Markers = { WoodPlace = 0.4 }, MarkerEffects = { WoodPlace = { Sound = "WoodPlace", VFX = "BuildDust" } }, Fallback = "Reach" }),
			PlaceStone = anim({ Purpose = "Place a stone piece", Length = 0.8, Markers = { StonePlace = 0.45 }, MarkerEffects = { StonePlace = { Sound = "StonePlace", VFX = "BuildDust" } }, Fallback = "Reach" }),
			SawWood = anim({ Purpose = "Sawing", Looped = true, Length = 0.6, Markers = { Saw = 0.3 }, MarkerEffects = { Saw = { Sound = "Saw" } }, Fallback = "Dig" }),
			PlantConstruction = anim({ Purpose = "Plant the construction stake", Length = 0.8, Markers = { Effect = 0.45 }, MarkerEffects = { Effect = { Sound = "ConstructionStart", VFX = "BuildDust" } }, Fallback = "Dig" }),
			Paint = anim({ Purpose = "Paint a structure", Looped = true, Length = 0.8, Markers = { Paint = 0.4 }, MarkerEffects = { Paint = { Sound = "Paint" } }, Fallback = "Wave" }),
			BuildFinish = anim({ Purpose = "Last touch on a building", Priority = "Action2", Length = 1, Markers = { BuildFinish = 0.55 }, MarkerEffects = { BuildFinish = { Sound = "BuildComplete", VFX = "BuildComplete", Shake = 0.35 } }, Fallback = "HeavySwing" }),
			CelebrateBuild = anim({ Purpose = "Celebrate a finished build", Priority = "Action3", Length = 1.4, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		Farming = {
			TillGround = anim({ Purpose = "Till a soil tile", Length = 0.7, Markers = { Till = 0.38 }, MarkerEffects = { Till = { Sound = "HoeTill", VFX = "DirtPuff" } }, Fallback = "Till" }),
			PlantSeed = anim({ Purpose = "Plant a seed", Length = 0.9, Markers = { Plant = 0.5 }, MarkerEffects = { Plant = { Sound = "PlantSeed", VFX = "DirtPuff" } }, Fallback = "Reach", BodyParts = FULL_BODY }),
			WaterPlant = anim({ Purpose = "Water a crop", Length = 1.2, Markers = { Water = 0.5 }, MarkerEffects = { Water = { Sound = "Watering", VFX = "WaterSplash" } }, Trail = { 0.2, 0.8 }, Fallback = "Pour" }),
			HarvestCrop = anim({ Purpose = "Harvest a mature crop", Length = 0.8, Markers = { Pick = 0.42 }, MarkerEffects = { Pick = { Sound = "Harvest", VFX = "LeafBurst" } }, Fallback = "Reach", BodyParts = FULL_BODY }),
			PickCrop = anim({ Purpose = "Pick fruit from a plant", Length = 0.6, Markers = { Pick = 0.3 }, MarkerEffects = { Pick = { Sound = "Harvest", VFX = "LeafBurst" } }, Fallback = "Reach" }),
			CarryBasket = anim({ Purpose = "Carry a harvest basket", Looped = true, Length = 1, Fallback = "Carry" }),
			CelebrateHarvest = anim({ Purpose = "Big harvest celebration", Priority = "Action3", Length = 1.3, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		AnimalCare = {
			FeedAnimal = anim({ Purpose = "Feed an animal", Priority = "Action2", Length = 1, Markers = { Feed = 0.5 }, MarkerEffects = { Feed = { Sound = "Feed", VFX = "Hearts" } }, Fallback = "Reach" }),
			MilkCow = anim({ Purpose = "Milk a cow", Priority = "Action2", Length = 1.6, Markers = { Milk = 0.6 }, MarkerEffects = { Milk = { Sound = "Milk", VFX = "MilkSplash" } }, Fallback = "Dig", BodyParts = FULL_BODY, Interruptible = false }),
			PetAnimal = anim({ Purpose = "Pet an animal", Priority = "Action2", Length = 1.2, Markers = { Pet = 0.5 }, MarkerEffects = { Pet = { Sound = "Pet", VFX = "Hearts" } }, Fallback = "Wave" }),
			CarryBucket = anim({ Purpose = "Carry a bucket", Looped = true, Length = 1, Fallback = "Hold" }),
			FillTrough = anim({ Purpose = "Fill a feeding trough", Priority = "Action2", Length = 1.2, Markers = { Pour = 0.6 }, MarkerEffects = { Pour = { Sound = "Watering" } }, Fallback = "Pour" }),
		},

		Fishing = {
			FishingIdle = anim({ Purpose = "Holding the rod", Priority = "Action", Looped = true, Length = 2, Fallback = "Hold" }),
			FishingCast = anim({ Purpose = "Cast the line", Priority = "Action2", Length = 0.9, Markers = { Cast = 0.45 }, MarkerEffects = { Cast = { Sound = "FishingCast", Punch = 0.5 } }, Trail = { 0.28, 0.6 }, Fallback = "Cast" }),
			FishingWait = anim({ Purpose = "Waiting for a bite", Priority = "Action2", Looped = true, Length = 3, Fallback = "Hold" }),
			FishingBite = anim({ Purpose = "Rod jerks on a bite", Priority = "Action2", Length = 0.4, Markers = { Splash = 0.1 }, MarkerEffects = { Splash = { Sound = "FishBite", VFX = "WaterSplash" } }, Fallback = "Reel" }),
			FishingReel = anim({ Purpose = "Reeling in", Priority = "Action2", Looped = true, Length = 0.6, Markers = { Reel = 0.3 }, MarkerEffects = { Reel = { Sound = "Reel" } }, Fallback = "Reel" }),
			FishingStruggle = anim({ Purpose = "Fighting a strong fish", Priority = "Action2", Looped = true, Length = 0.8, Fallback = "Reel" }),
			FishingCatch = anim({ Purpose = "Pull the fish out", Priority = "Action2", Length = 1, Markers = { Catch = 0.5 }, MarkerEffects = { Catch = { Sound = "FishCatch", VFX = "WaterSplash" } }, Fallback = "HeavySwing" }),
			FishingFail = anim({ Purpose = "Fish escapes", Priority = "Action2", Length = 0.8, Fallback = "Reach" }),
			FishingCelebrate = anim({ Purpose = "Rare catch celebration", Priority = "Action3", Length = 1.5, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		Crafting = {
			CraftStart = anim({ Purpose = "Begin crafting", Length = 0.5, Fallback = "Reach" }),
			CraftWork = anim({ Purpose = "Crafting loop", Looped = true, Length = 0.7, Markers = { CraftHit = 0.35 }, MarkerEffects = { CraftHit = { Sound = "CraftHit" } }, Fallback = "Swing" }),
			CraftFinish = anim({ Purpose = "Crafting done", Priority = "Action2", Length = 0.8, Markers = { Effect = 0.4 }, MarkerEffects = { Effect = { Sound = "CraftComplete", VFX = "Sparkle" } }, Fallback = "Cheer" }),
		},

		Social = {
			Wave = anim({ Purpose = "Wave", Priority = "Action3", Length = 1.5, Fallback = "Wave" }),
			Cheer = anim({ Purpose = "Cheer", Priority = "Action3", Length = 1.3, BodyParts = FULL_BODY, Fallback = "Cheer" }),
			Celebrate = anim({ Purpose = "Level up / unlock celebration", Priority = "Action3", Length = 1.6, BodyParts = FULL_BODY, Fallback = "Cheer" }),
			Sit = anim({ Purpose = "Sit on benches", Priority = "Action3", Looped = true, Length = 2, BodyParts = FULL_BODY }),
			Point = anim({ Purpose = "Point at something", Priority = "Action3", Length = 1.2, Fallback = "Point" }),
			Dance = anim({ Purpose = "Happy island dance (emote)", Priority = "Action3", Length = 0.9, Repeat = 4, BodyParts = FULL_BODY }),
			OpenChest = anim({ Purpose = "Lift a chest lid", Priority = "Action2", Length = 1.1, Markers = { Open = 0.75 }, MarkerEffects = { Open = { Sound = "ChestOpen" } }, BodyParts = FULL_BODY }),
		},

		-- Mia the Merchant (NPC rig, keyframed like players).
		Merchant = {
			MiaIdle = anim({ Purpose = "Mia waiting behind her counter", Priority = "Idle", Looped = true, Length = 5, BodyParts = FULL_BODY }),
			MiaWave = anim({ Purpose = "Mia greets a player who walks up", Priority = "Action3", Length = 1.6, BodyParts = FULL_BODY }),
			MiaPresent = anim({ Purpose = "Mia shows off her goods (market opened)", Priority = "Action2", Length = 1.4, Markers = { Present = 0.7 }, MarkerEffects = { Present = { VFX = "Sparkle" } } }),
			MiaSold = anim({ Purpose = "Mia claps and hops after a sale", Priority = "Action3", Length = 1.5, BodyParts = FULL_BODY, Markers = { Clap = 0.27, Hop = 1.17 }, MarkerEffects = { Clap = { Sound = "CoinGain" }, Hop = { VFX = "CoinBurst" } } }),
			MiaTalk = anim({ Purpose = "Mia chats while giving a tip", Priority = "Action2", Length = 2 }),
		},

		-- Non-humanoid rigs (AnimationController). Used from Phase 6.
		Cow = {
			CowIdle = anim({ Purpose = "Cow idle", Priority = "Idle", Looped = true, Length = 3, BodyParts = "Cow rig" }),
			CowWalk = anim({ Purpose = "Cow walk", Priority = "Movement", Looped = true, Length = 1.2, BodyParts = "Cow rig" }),
			CowEat = anim({ Purpose = "Cow eating", Looped = true, Length = 2, BodyParts = "Cow rig", Markers = { Chew = 1 } }),
			CowDrink = anim({ Purpose = "Cow drinking", Looped = true, Length = 2, BodyParts = "Cow rig" }),
			CowHappy = anim({ Purpose = "Cow happy hop", Priority = "Action2", Length = 1.2, BodyParts = "Cow rig" }),
			CowSleep = anim({ Purpose = "Cow sleeping", Priority = "Idle", Looped = true, Length = 4, BodyParts = "Cow rig" }),
			CowMilk = anim({ Purpose = "Cow being milked", Priority = "Action2", Length = 1.6, BodyParts = "Cow rig" }),
			CowHitReaction = anim({ Purpose = "Cow startled", Priority = "Action2", Length = 0.6, BodyParts = "Cow rig" }),
			CowInteract = anim({ Purpose = "Cow looks at player", Priority = "Action", Length = 1.2, BodyParts = "Cow rig" }),
		},
	},

	-- Every tool has THREE swings; a swing plays one of them at random.
	-- The first name is the "base" that configs and services refer to.
	Variants = {
		AxeSwing = { "AxeSwing", "AxeChopHigh", "AxeSlash" },
		PickaxeSwing = { "PickaxeSwing", "PickaxeSide", "PickaxeSlam" },
		HammerSwing = { "HammerSwing", "HammerBash", "HammerSlam" },
		HoeTill = { "HoeTill", "HoeChop", "HoeScrape" },
		ShovelDig = { "ShovelDig", "ShovelScoop", "ShovelStomp" },
		WaterPlant = { "WaterPlant", "WaterSweep", "WaterHigh" },
		FishingCast = { "FishingCast", "FishingCastSide", "FishingCastFlick" },
		BucketSwing = { "BucketSwing", "BucketScoop", "BucketToss" },
		ShearsSnip = { "ShearsSnip", "ShearsSnipLow", "ShearsSnipHigh" },
	} :: { [string]: { string } },

	-- Built below: flat lookup { [AnimationName] = def } (names must be unique).
	Index = {} :: { [string]: any },
}

-- Variants share the base's timing (Length, markers, effects, trail) so
-- gameplay is identical whichever one plays; only the keyframes differ.
for baseName, names in AnimationConfig.Variants do
	for _, entries in AnimationConfig.Categories do
		local base = entries[baseName]
		if base then
			for index = 2, #names do
				local copy = TableUtil.DeepCopy(base)
				copy.Purpose = base.Purpose .. " (variant " .. index .. ")"
				copy.VariantOf = baseName
				entries[names[index]] = copy
			end
		end
	end
end

for categoryName, entries in AnimationConfig.Categories do
	for name, def in entries do
		assert(AnimationConfig.Index[name] == nil, "Duplicate animation name: " .. name)
		def.Name = name
		def.Category = categoryName
		AnimationConfig.Index[name] = def
	end
end

function AnimationConfig.Get(name: string)
	return AnimationConfig.Index[name]
end

-- How many swings `name` has (1 if it has no variants).
function AnimationConfig.VariantCount(name: string): number
	local names = AnimationConfig.Variants[name]
	return if names then #names else 1
end

-- The index-th variant of `name` (index is clamped; unknown -> name).
function AnimationConfig.Variant(name: string, index: number): string
	local names = AnimationConfig.Variants[name]
	if not names then
		return name
	end
	return names[math.clamp(math.floor(index), 1, #names)]
end

return TableUtil.DeepFreeze(AnimationConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">BuildConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/BuildConfig
	DEPENDENCIES: GameConfig, Shared.Util.TableUtil

	Placement rules shared by the client preview (BuildController) and the
	server validator (BuildService), so both always agree.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local GameConfig = require(script.Parent.GameConfig)

local BuildConfig = {
	GridSize = GameConfig.BuildGridSize,
	Rotations = { 0, 90, 180, 270 },
	MaxSlope = 4, -- max terrain height difference (studs) across a footprint
	PlacementRange = 80, -- how far from the player a building can be placed
	PlaceCooldown = 0.5,
	HammerRange = 16,
	HammerCooldown = 0.45,
	OverlapShrink = 0.4, -- shrink overlap boxes so neighbours can touch

	-- Island model folders whose contents block placement.
	-- (Decorations are cosmetic: builds hide the scatter under them instead.)
	BlockingFolders = { "Buildings", "Landmarks", "Interactables", "Resources", "Crops", "Animals" },
	RemoveNodeRefund = true, -- clearing a natural tree/rock gives its resources once
}

return TableUtil.DeepFreeze(BuildConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">BuildingConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildingConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/BuildingConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every placeable structure. Models are procedural (Shared/Building/
	BuildingModels) so the game runs with no uploaded meshes; each model part
	carries a Stage number so construction reveals the building piece by
	piece — one stage per hammer hit (Steps).

		Cost        { Coins, Items = { Wood = n, ... } } charged atomically by BuildService
		Footprint   Vector2 studs (X, Z) at rotation 0
		Height      used for overlap checks
		Steps       hammer hits to finish construction
		UnlockLevel island level required
		Capacity    housing: animals it holds, e.g. { Cow = 2 }
		CapacityBonus  backpack capacity added when complete
		Pen         housing: island-local offset of the animal pen centre + radius
		Steps = 0   instant (soil tiles, saplings, rocks): appears finished right away
		Node        places a harvestable resource node of this type instead of a model
		Hidden      not listed in the build menu (e.g. the market stall)
		Unique / NoDelete   one per island / can be moved but never removed
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local BuildingConfig = {
	RefundPercent = 0.5, -- deleting a building refunds this share of its cost

	Categories = {
		{ Id = "Homes", DisplayName = "Homes", Icon = "🏠" },
		{ Id = "Farm", DisplayName = "Farm", Icon = "🐄" },
		{ Id = "Utility", DisplayName = "Utility", Icon = "🧰" },
		{ Id = "Nature", DisplayName = "Nature", Icon = "🌳" },
		{ Id = "Decoration", DisplayName = "Decor", Icon = "🌸" },
	},

	Buildings = {
		-- HOMES
		SmallCottage = {
			Category = "Homes", DisplayName = "Small Cottage", Icon = "🏡", Order = 1,
			Description = "A cosy first home for your island.",
			Cost = { Coins = 100, Items = { Wood = 30, Stone = 10 } },
			Footprint = Vector2.new(10, 10), Height = 12, Steps = 6, UnlockLevel = 1,
		},
		WoodenCabin = {
			Category = "Homes", DisplayName = "Wooden Cabin", Icon = "🛖", Order = 2,
			Description = "A roomy log cabin with a front porch.",
			Cost = { Coins = 250, Items = { Wood = 60, Stone = 25, Fiber = 10 } },
			Footprint = Vector2.new(14, 12), Height = 13, Steps = 8, UnlockLevel = 3,
		},
		StoneHouse = {
			Category = "Homes", DisplayName = "Stone House", Icon = "🏘️", Order = 3,
			Description = "Solid stone walls built to last.",
			Cost = { Coins = 600, Items = { Stone = 80, Wood = 40, Iron = 5 } },
			Footprint = Vector2.new(14, 14), Height = 15, Steps = 10, UnlockLevel = 6,
		},

		-- FARM
		Barn = {
			Category = "Farm", DisplayName = "Barn", Icon = "🐄", Order = 1,
			Description = "Houses 2 cows. Required before you can buy a cow.",
			Cost = { Coins = 150, Items = { Wood = 40, Stone = 15 } },
			Footprint = Vector2.new(14, 22), Height = 13, Steps = 7, UnlockLevel = 1,
			Capacity = { Cow = 2 }, Pen = { Offset = Vector2.new(0, 5.5), Radius = 4.5 },
		},
		SoilTile = {
			Category = "Farm", DisplayName = "Soil Tile", Icon = "🟫", Order = 0,
			Description = "A 4x4 farm tile. Till it with a hoe, then plant seeds. Place as many as you like!",
			Cost = { Coins = 15, Items = {} },
			Footprint = Vector2.new(4, 4), Height = 1, Steps = 0, UnlockLevel = 1,
		},
		ChickenCoop = {
			Category = "Farm", DisplayName = "Chicken Coop", Icon = "🐔", Order = 2,
			Description = "Houses 4 chickens. Required before you can buy chickens.",
			Cost = { Coins = 80, Items = { Wood = 25, Fiber = 5 } },
			Footprint = Vector2.new(10, 14), Height = 8, Steps = 5, UnlockLevel = 1,
			Capacity = { Chicken = 4 }, Pen = { Offset = Vector2.new(0, 3.5), Radius = 3 },
		},

		-- UTILITY
		StorageChest = {
			Category = "Utility", DisplayName = "Storage Chest", Icon = "📦", Order = 1,
			Description = "+100 backpack capacity while it stands on your island.",
			Cost = { Coins = 60, Items = { Wood = 20 } },
			Footprint = Vector2.new(4, 4), Height = 4, Steps = 2, UnlockLevel = 1, CapacityBonus = 100,
		},
		Well = {
			Category = "Utility", DisplayName = "Stone Well", Icon = "🪣", Order = 2,
			Description = "A charming stone well for your village square.",
			Cost = { Coins = 40, Items = { Stone = 20, Wood = 5 } },
			Footprint = Vector2.new(6, 6), Height = 8, Steps = 3, UnlockLevel = 1,
		},

		MarketStall = {
			Category = "Utility", DisplayName = "Market Stall", Icon = "🛒", Order = 99,
			Description = "Sell your goods and shop here. Move it anywhere you like.",
			Cost = { Coins = 0, Items = {} },
			Footprint = Vector2.new(10, 7), Height = 10, Steps = 0, UnlockLevel = 1,
			Hidden = true, Unique = true, NoDelete = true,
		},

		-- NATURE (harvestable: they grow back after you chop / mine them)
		OakSapling = {
			Category = "Nature", DisplayName = "Oak Tree", Icon = "🌳", Order = 1,
			Description = "Plant your own oak tree. Chop it for wood — it grows back!",
			Cost = { Coins = 20, Items = { Wood = 2 } },
			Footprint = Vector2.new(6, 6), Height = 14, Steps = 0, UnlockLevel = 1, Node = "Tree",
		},
		PalmSapling = {
			Category = "Nature", DisplayName = "Palm Tree", Icon = "🌴", Order = 2,
			Description = "A breezy palm for your beach.",
			Cost = { Coins = 20, Items = { Wood = 2 } },
			Footprint = Vector2.new(6, 6), Height = 14, Steps = 0, UnlockLevel = 1, Node = "PalmTree",
		},
		PineSapling = {
			Category = "Nature", DisplayName = "Pine Tree", Icon = "🌲", Order = 3,
			Description = "A tall pine that drops extra wood.",
			Cost = { Coins = 30, Items = { Wood = 3 } },
			Footprint = Vector2.new(6, 6), Height = 16, Steps = 0, UnlockLevel = 2, Node = "PineTree",
		},
		MapleSapling = {
			Category = "Nature", DisplayName = "Maple Tree", Icon = "🍁", Order = 4,
			Description = "Blazing orange leaves all year round.",
			Cost = { Coins = 30, Items = { Wood = 3 } },
			Footprint = Vector2.new(6, 6), Height = 14, Steps = 0, UnlockLevel = 2, Node = "AutumnTree",
		},
		Boulder = {
			Category = "Nature", DisplayName = "Boulder", Icon = "🪨", Order = 5,
			Description = "A rock you can mine again and again.",
			Cost = { Coins = 25, Items = { Stone = 4 } },
			Footprint = Vector2.new(5, 5), Height = 5, Steps = 0, UnlockLevel = 1, Node = "Rock",
		},
		FiberPlant = {
			Category = "Nature", DisplayName = "Fiber Bush", Icon = "🌿", Order = 6,
			Description = "Pick fiber by hand. Regrows quickly.",
			Cost = { Coins = 10, Items = {} },
			Footprint = Vector2.new(4, 4), Height = 4, Steps = 0, UnlockLevel = 1, Node = "FiberBush",
		},

		-- DECORATION
		WoodenFence = {
			Category = "Decoration", DisplayName = "Wooden Fence", Icon = "🚧", Order = 1,
			Description = "Line your fields and paths.",
			Cost = { Coins = 0, Items = { Wood = 4 } },
			Footprint = Vector2.new(4, 1), Height = 4, Steps = 1, UnlockLevel = 1,
		},
		StonePath = {
			Category = "Decoration", DisplayName = "Stone Path", Icon = "🪨", Order = 2,
			Description = "A tidy stone path tile.",
			Cost = { Coins = 0, Items = { Stone = 3 } },
			Footprint = Vector2.new(4, 4), Height = 1, Steps = 1, UnlockLevel = 1,
		},
		Bench = {
			Category = "Decoration", DisplayName = "Bench", Icon = "🪑", Order = 3,
			Description = "Take a break and admire your island.",
			Cost = { Coins = 5, Items = { Wood = 8 } },
			Footprint = Vector2.new(6, 2), Height = 4, Steps = 1, UnlockLevel = 1,
		},
		FlowerBed = {
			Category = "Decoration", DisplayName = "Flower Bed", Icon = "🌷", Order = 4,
			Description = "A splash of colour.",
			Cost = { Coins = 10, Items = { Fiber = 4 } },
			Footprint = Vector2.new(4, 4), Height = 3, Steps = 1, UnlockLevel = 1,
		},
		Lantern = {
			Category = "Decoration", DisplayName = "Lantern", Icon = "🏮", Order = 5,
			Description = "A warm light for evening strolls.",
			Cost = { Coins = 10, Items = { Wood = 3, Stone = 2 } },
			Footprint = Vector2.new(2, 2), Height = 7, Steps = 1, UnlockLevel = 1,
		},
		Campfire = {
			Category = "Decoration", DisplayName = "Campfire", Icon = "🔥", Order = 6,
			Description = "Crackling and cosy.",
			Cost = { Coins = 0, Items = { Wood = 6, Stone = 6 } },
			Footprint = Vector2.new(4, 4), Height = 3, Steps = 2, UnlockLevel = 1,
		},
	},
}

for buildingId, def in BuildingConfig.Buildings do
	def.Id = buildingId
	def.Cost.Items = def.Cost.Items or {}
end

function BuildingConfig.Get(buildingId: any)
	if type(buildingId) ~= "string" then
		return nil
	end
	return BuildingConfig.Buildings[buildingId]
end

return TableUtil.DeepFreeze(BuildingConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CropConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CropConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/CropConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every crop and the farm plot layout. Growth is DATA-DRIVEN and computed
	from server timestamps (Shared/Util/CropGrowth), so crops keep growing
	while the player is offline and nothing ticks per frame.

	Per crop:
		SeedCost      shop price per seed
		GrowTime      seconds from planting to harvestable (unwatered)
		Yield         {Min, Max} produce per harvest
		SellValue     base market price of one produce item
		UnlockLevel   island level required to buy the seed
		Shape         visual style: Grain | Root | Tall | Bush

	Generated items: "<Crop>" (Category Crops) and "<Crop>Seeds" (Category Seeds).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local CropConfig = {
	-- Watering multiplies growth speed from the moment it is watered.
	WaterSpeedMultiplier = 1.5,

	Stages = { "Seed", "Sprout", "Small Plant", "Growing", "Mature", "Harvestable" },

	Farm = {
		TileSize = 4,
		TileGap = 0.8,
		Columns = 4,
		Rows = 3,
		StarterTiles = 6, -- tiles usable on a new island (the shop sells more, up to Columns x Rows)
	},

	Crops = {
		Wheat = {
			DisplayName = "Wheat", Icon = "🌾", SeedCost = 5, GrowTime = 60, Yield = { Min = 2, Max = 3 }, SellValue = 8,
			UnlockLevel = 1, Shape = "Grain", Rarity = "Common",
			StalkColor = Color3.fromRGB(150, 190, 70), ProduceColor = Color3.fromRGB(235, 200, 90),
			Description = "Golden grain. Sell it, or feed it to your animals.",
		},
		Carrot = {
			DisplayName = "Carrot", Icon = "🥕", SeedCost = 10, GrowTime = 120, Yield = { Min = 2, Max = 3 }, SellValue = 16,
			UnlockLevel = 1, Shape = "Root", Rarity = "Common",
			StalkColor = Color3.fromRGB(80, 170, 60), ProduceColor = Color3.fromRGB(255, 140, 40),
			Description = "Crunchy and orange. Grows underground.",
		},
		Potato = {
			DisplayName = "Potato", Icon = "🥔", SeedCost = 15, GrowTime = 150, Yield = { Min = 3, Max = 4 }, SellValue = 14,
			UnlockLevel = 2, Shape = "Root", Rarity = "Common",
			StalkColor = Color3.fromRGB(90, 160, 70), ProduceColor = Color3.fromRGB(190, 150, 95),
			Description = "A hearty island staple.",
		},
		Corn = {
			DisplayName = "Corn", Icon = "🌽", SeedCost = 20, GrowTime = 180, Yield = { Min = 2, Max = 3 }, SellValue = 30,
			UnlockLevel = 3, Shape = "Tall", Rarity = "Uncommon",
			StalkColor = Color3.fromRGB(110, 180, 60), ProduceColor = Color3.fromRGB(250, 215, 60),
			Description = "Tall stalks with sweet golden cobs.",
		},
		SugarCane = {
			DisplayName = "Sugar Cane", Icon = "🎋", SeedCost = 25, GrowTime = 200, Yield = { Min = 3, Max = 4 }, SellValue = 26,
			UnlockLevel = 4, Shape = "Tall", Rarity = "Uncommon",
			StalkColor = Color3.fromRGB(130, 190, 90), ProduceColor = Color3.fromRGB(200, 230, 150),
			Description = "Sweet stalks bakers love.",
		},
		Tomato = {
			DisplayName = "Tomato", Icon = "🍅", SeedCost = 30, GrowTime = 240, Yield = { Min = 3, Max = 5 }, SellValue = 32,
			UnlockLevel = 5, Shape = "Bush", Rarity = "Uncommon",
			StalkColor = Color3.fromRGB(70, 150, 60), ProduceColor = Color3.fromRGB(230, 50, 45),
			Description = "Juicy red tomatoes on a leafy vine.",
		},
		Strawberry = {
			DisplayName = "Strawberry", Icon = "🍓", SeedCost = 45, GrowTime = 300, Yield = { Min = 4, Max = 6 }, SellValue = 36,
			UnlockLevel = 6, Shape = "Bush", Rarity = "Rare",
			StalkColor = Color3.fromRGB(60, 150, 70), ProduceColor = Color3.fromRGB(240, 40, 80),
			Description = "Sweet berries worth waiting for.",
		},
	},

	-- Display order in shops / seed picker.
	Order = { "Wheat", "Carrot", "Potato", "Corn", "SugarCane", "Tomato", "Strawberry" },

	Items = {} :: { [string]: any },
	SeedToCrop = {} :: { [string]: string },
}

for cropId, crop in CropConfig.Crops do
	local seedId = cropId .. "Seeds"
	crop.Id = cropId
	crop.Seed = seedId
	CropConfig.SeedToCrop[seedId] = cropId
	CropConfig.Items[cropId] = {
		DisplayName = crop.DisplayName,
		Category = "Crops",
		Rarity = crop.Rarity,
		SellValue = crop.SellValue,
		Icon = crop.Icon,
		Description = crop.Description,
	}
	CropConfig.Items[seedId] = {
		DisplayName = crop.DisplayName .. " Seeds",
		Category = "Seeds",
		Rarity = "Common",
		SellValue = math.max(1, math.floor(crop.SeedCost / 2)),
		Icon = "🌱",
		Description = ("Plant on a tilled farm tile. Grows %s in %ds."):format(crop.DisplayName, crop.GrowTime),
	}
end

return TableUtil.DeepFreeze(CropConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  EconomyConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/EconomyConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Currencies and global economy knobs. Item base prices live on the item
	definitions (ResourceConfig / CropConfig / FishConfig ...), never here and
	never inside scripts.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local EconomyConfig = {
	Currencies = {
		Coins = { DisplayName = "Island Coins", Icon = "🪙", Max = 1e12, Color = Color3.fromRGB(255, 200, 40) },
		Gems = { DisplayName = "Gems", Icon = "💎", Max = 1e9, Color = Color3.fromRGB(90, 200, 255) },
	},

	-- Multiplier applied to every sale.
	GlobalSellMultiplier = 1,

	-- MARKET DEMAND (spec §65): every DemandInterval seconds a few goods get a
	-- clearly announced price bonus, giving players a reason to switch strategy.
	DemandInterval = 600,
	DemandItemCount = 2,
	DemandBonus = { Min = 0.2, Max = 0.4 },
	DemandCategories = { Crops = true, Fish = true, AnimalProducts = true },
}

return TableUtil.DeepFreeze(EconomyConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">FishConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FishConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/FishConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Fish, fishing zones and the reel minigame tuning. The SERVER rolls which
	fish bites (the client never names a fish); the client only plays the
	minigame, and the server checks the reel took a plausible amount of time.

	Zones come from where the fishing spot is: the starter dock is "Shore";
	unlocking areas adds River / Ocean / Cave spots (IslandConfig area Content).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local FishConfig = {
	CastCooldown = 1,
	BiteDelay = { Min = 2.5, Max = 6 }, -- seconds; better rods shorten it
	HookWindow = 1.6, -- seconds the player has to react to a bite
	MaxReelTime = 30,
	SpotRange = 14, -- how close the player must stand to a fishing spot

	-- Relative chance per rarity (rods multiply the rarer ones by RodLuck^(rank-1)).
	RarityWeights = { Common = 60, Uncommon = 26, Rare = 10, Epic = 3.2, Legendary = 0.7, Mythic = 0.1 },
	RodLuckPerTier = 0.12,

	-- Reel minigame (client simulates; server uses MinReelTime to reject impossible catches).
	Minigame = {
		StartProgress = 0.25,
		GainRate = 0.38, -- progress / second while the fish is inside the zone
		LossRate = 0.22,
		DifficultyScale = 0.15, -- gain is divided by (1 + Difficulty * scale)
		ZoneSize = 0.3, -- minus 0.03 per difficulty
		IndicatorSize = 0.06,
		Gravity = 2.4,
		Lift = 2.6,
		MaxSpeed = 1.3,
	},

	Zones = {
		Shore = { DisplayName = "Shoreline", Fish = { "Bluegill", "Sardine", "Clownfish", "Pufferfish", "GoldenKoi" } },
		River = { DisplayName = "Willow River", Fish = { "Trout", "Catfish", "Salmon", "RainbowTrout", "RiverKing" } },
		Ocean = { DisplayName = "Coral Ocean", Fish = { "Mackerel", "Tuna", "Swordfish", "Sunfish", "Marlin" } },
		Cave = { DisplayName = "Starfall Pool", Fish = { "Glowfish", "CrystalFish", "Moonfish", "Starfin" } },
	},

	Fish = {
		Bluegill = { DisplayName = "Bluegill", Rarity = "Common", SellValue = 12, Weight = { 0.2, 0.8 }, Difficulty = 1, Color = Color3.fromRGB(90, 150, 220), Description = "A friendly little fish that loves the shallows." },
		Sardine = { DisplayName = "Sardine", Rarity = "Common", SellValue = 10, Weight = { 0.1, 0.4 }, Difficulty = 1, Color = Color3.fromRGB(170, 190, 210), Description = "Small, silver and always in a hurry." },
		Clownfish = { DisplayName = "Clownfish", Rarity = "Uncommon", SellValue = 30, Weight = { 0.2, 0.5 }, Difficulty = 2, Color = Color3.fromRGB(255, 140, 40), Description = "Bright orange with white stripes." },
		Pufferfish = { DisplayName = "Pufferfish", Rarity = "Rare", SellValue = 85, Weight = { 0.5, 2 }, Difficulty = 3, Color = Color3.fromRGB(230, 210, 120), Description = "Puffs up when surprised. Handle gently!" },
		GoldenKoi = { DisplayName = "Golden Koi", Rarity = "Epic", SellValue = 260, Weight = { 1.5, 4 }, Difficulty = 4, Color = Color3.fromRGB(255, 200, 40), Description = "A lucky golden fish said to bless islands." },

		Trout = { DisplayName = "Trout", Rarity = "Uncommon", SellValue = 35, Weight = { 0.8, 2.5 }, Difficulty = 2, Color = Color3.fromRGB(150, 170, 120), Description = "A speckled river swimmer." },
		Catfish = { DisplayName = "Catfish", Rarity = "Common", SellValue = 22, Weight = { 1, 4 }, Difficulty = 1, Color = Color3.fromRGB(120, 110, 90), Description = "Whiskered bottom-dweller." },
		Salmon = { DisplayName = "Salmon", Rarity = "Rare", SellValue = 95, Weight = { 2, 6 }, Difficulty = 3, Color = Color3.fromRGB(240, 130, 110), Description = "Strong swimmer that fights the current." },
		RainbowTrout = { DisplayName = "Rainbow Trout", Rarity = "Epic", SellValue = 280, Weight = { 2, 5 }, Difficulty = 4, Color = Color3.fromRGB(200, 120, 220), Description = "Shimmers in every colour." },
		RiverKing = { DisplayName = "River King", Rarity = "Legendary", SellValue = 650, Weight = { 8, 20 }, Difficulty = 5, Color = Color3.fromRGB(80, 200, 160), Description = "The ruler of Willow River." },

		Mackerel = { DisplayName = "Mackerel", Rarity = "Common", SellValue = 20, Weight = { 0.5, 1.5 }, Difficulty = 1, Color = Color3.fromRGB(80, 120, 150), Description = "Striped and speedy." },
		Tuna = { DisplayName = "Tuna", Rarity = "Uncommon", SellValue = 60, Weight = { 5, 20 }, Difficulty = 2, Color = Color3.fromRGB(60, 80, 140), Description = "A powerful ocean fish." },
		Swordfish = { DisplayName = "Swordfish", Rarity = "Rare", SellValue = 160, Weight = { 20, 60 }, Difficulty = 3, Color = Color3.fromRGB(90, 110, 170), Description = "Fast, proud and pointy." },
		Sunfish = { DisplayName = "Sunfish", Rarity = "Epic", SellValue = 380, Weight = { 40, 120 }, Difficulty = 4, Color = Color3.fromRGB(220, 220, 200), Description = "A gentle giant that sunbathes at the surface." },
		Marlin = { DisplayName = "Blue Marlin", Rarity = "Legendary", SellValue = 850, Weight = { 60, 200 }, Difficulty = 5, Color = Color3.fromRGB(40, 90, 200), Description = "The ultimate ocean trophy." },

		Glowfish = { DisplayName = "Glowfish", Rarity = "Rare", SellValue = 170, Weight = { 0.5, 2 }, Difficulty = 3, Color = Color3.fromRGB(120, 255, 200), Description = "Lights up the dark cave pool." },
		CrystalFish = { DisplayName = "Crystal Fish", Rarity = "Epic", SellValue = 460, Weight = { 1, 3 }, Difficulty = 4, Color = Color3.fromRGB(150, 230, 255), Description = "Scales as clear as glass." },
		Moonfish = { DisplayName = "Moonfish", Rarity = "Legendary", SellValue = 1000, Weight = { 2, 6 }, Difficulty = 5, Color = Color3.fromRGB(220, 220, 255), Description = "Only bites when the cave is perfectly still." },
		Starfin = { DisplayName = "Starfin", Rarity = "Mythic", SellValue = 3000, Weight = { 3, 8 }, Difficulty = 5, Color = Color3.fromRGB(255, 120, 220), Description = "A fish made of starlight. Almost a legend." },
	},

	Items = {} :: { [string]: any },
}

for fishId, fish in FishConfig.Fish do
	fish.Id = fishId
	FishConfig.Items[fishId] = {
		DisplayName = fish.DisplayName,
		Category = "Fish",
		Rarity = fish.Rarity,
		SellValue = fish.SellValue,
		Icon = "🐟",
		Description = fish.Description,
	}
end

-- Seconds a perfect player needs to fill the reel bar (server rejects faster catches).
function FishConfig.MinReelTime(difficulty: number): number
	local minigame = FishConfig.Minigame
	local gain = minigame.GainRate / (1 + difficulty * minigame.DifficultyScale)
	return (1 - minigame.StartProgress) / gain * 0.8
end

return TableUtil.DeepFreeze(FishConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  GameConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/GameConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Global game settings. Anything a designer might want to tune lives in a
	Config module — never hard-code these values inside services/controllers.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local GameConfig = {
	GameName = "Build Your Island",
	Version = "0.2.0 (First Playable Loop)",

	-- Turn OFF before publishing. Enables verbose logs + /debug output.
	Debug = true,

	StartingCoins = 100,
	StartingGems = 0,
	StartingIslandLevel = 1,
	AutosaveInterval = 60, -- seconds between autosave sweeps (only dirty profiles are written)
	BuildGridSize = 2, -- used by BuildService (Phase 3)
	MaxIslandsPerServer = 8, -- keep >= Players.MaxPlayers in Game Settings

	Character = {
		RequireR15 = true,
		-- If a non-R15 character spawns (Game Settings not set to R15), rebuild it
		-- as R15 from the player's HumanoidDescription. Game Settings > Avatar >
		-- R15 is still the recommended primary setup.
		ForceR15 = true,
		RespawnDelay = 3,
		WalkSpeed = 16,
		SprintSpeed = 25, -- hold Shift / L3 (within AntiExploit's speed allowance)
		JumpHeight = 7.2,
	},

	Camera = {
		MinZoom = 6,
		MaxZoom = 70,
		DefaultFieldOfView = 70,
		MaxShakeIntensity = 1.2, -- hard cap so shakes never become unpleasant
	},

	Inventory = {
		StartingCapacity = 200, -- total resource units the backpack holds
		MaxStack = 9999,
	},

	Data = {
		StoreName = "BuildYourIsland_PlayerData_v1",
		KeyPrefix = "Player_",
		-- "Auto": use the real DataStore, but fall back to an in-memory mock in
		-- Studio when API access is disabled. true = always mock. false = never.
		UseMockDataStore = "Auto",
		LoadAttempts = 5,
		SaveAttempts = 4,
		RetryBaseDelay = 1, -- exponential backoff base (seconds)
		SessionLockTimeout = 1800, -- a lock older than this is considered dead
		LockRetryDelay = 6,
		LockRetries = 5, -- after this many waits the lock is taken over
		StudioStealLocks = true, -- Studio sessions are single-player; don't wait on stale locks
		KickOnLoadFailure = true,
		ShutdownSaveTimeout = 25,
		SizeWarningBytes = 3_500_000,
	},

	AntiExploit = {
		StrikeWindow = 60, -- seconds strikes are remembered for
		WarnStrikes = 10,
		KickStrikes = 40,
		KickEnabled = true,
		MovementCheckInterval = 1,
		MaxSpeedMultiplier = 1.75, -- x WalkSpeed before a movement strike
		MovementSlack = 12, -- studs/sec extra allowance (knockback, slopes, lag)
		TeleportGrace = 3, -- seconds after a server teleport that movement is not checked
		LargeCurrencyGain = 1_000_000, -- single gains above this are logged for review
	},

	-- UserIds allowed to run admin chat commands (see AdminService).
	AdminUserIds = {} :: { number },
	AdminsInStudio = true,

	-- What the Starter Chest on every new island contains.
	StarterKit = {
		Coins = 50,
		Items = { Wood = 10, Stone = 5, Fiber = 5, WheatSeeds = 6 },
		Tools = { "WoodenAxe", "WoodenPickaxe", "WoodenHammer", "WoodenHoe", "WoodenWateringCan", "WoodenFishingRod" },
	},

	-- Lighting / world presentation (WorldService applies these).
	World = {
		ClockTime = 9.5, -- start of the day cycle
		-- A full day takes DayMinutes of real time; nights pass NightSpeed x faster.
		DayCycle = true,
		DayMinutes = 18,
		NightSpeed = 4,
		Brightness = 2.6,
		Ambient = Color3.fromRGB(96, 104, 124),
		OutdoorAmbient = Color3.fromRGB(150, 156, 176),
		NightOutdoorAmbient = Color3.fromRGB(96, 110, 150), -- nights stay readable
		EnvironmentDiffuseScale = 1,
		EnvironmentSpecularScale = 1,
		ShadowSoftness = 0.25,
		Atmosphere = {
			Density = 0.3,
			Offset = 0.12,
			Color = Color3.fromRGB(205, 228, 255),
			Decay = Color3.fromRGB(110, 150, 205),
			Glare = 0.35,
			Haze = 1.1,
		},
		Clouds = { Cover = 0.55, Density = 0.62, Color = Color3.fromRGB(255, 255, 255) },
		SunRays = { Intensity = 0.06, Spread = 0.8 },
		Bloom = { Intensity = 0.45, Size = 22, Threshold = 1.5 },
		ColorCorrection = { Saturation = 0.18, Contrast = 0.08, Brightness = 0.02, TintColor = Color3.fromRGB(255, 250, 244) },
		WaterColor = Color3.fromRGB(26, 176, 196),
		WaterTransparency = 0.78, -- clear enough to see the sandy shallows
		WaterReflectance = 0.3,
		WaterWaveSize = 0.14,
		WaterWaveSpeed = 9,
		-- Terrain material colours (every island theme + every paint material).
		MaterialColors = {
			Grass = Color3.fromRGB(104, 190, 70),
			LeafyGrass = Color3.fromRGB(214, 138, 56), -- autumn ground
			Sand = Color3.fromRGB(242, 224, 166),
			Sandstone = Color3.fromRGB(222, 160, 98),
			Rock = Color3.fromRGB(132, 128, 122),
			Slate = Color3.fromRGB(104, 106, 114),
			Ground = Color3.fromRGB(150, 110, 70),
			Mud = Color3.fromRGB(104, 76, 52),
			Snow = Color3.fromRGB(244, 250, 255),
			Salt = Color3.fromRGB(228, 234, 240),
			Cobblestone = Color3.fromRGB(156, 152, 146),
			Brick = Color3.fromRGB(184, 94, 72),
			WoodPlanks = Color3.fromRGB(176, 124, 76),
			Pavement = Color3.fromRGB(150, 150, 156),
			Limestone = Color3.fromRGB(232, 226, 204),
		},
		OceanDepth = 18,
		SeabedThickness = 8,
		OceanMargin = 600,
		OceanTileSize = 512,
	},
}

return TableUtil.DeepFreeze(GameConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">InputConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InputConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/InputConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Maps abstract ACTIONS to physical inputs for keyboard/mouse and gamepad.
	Touch devices trigger the same actions through on-screen buttons that call
	InputController.Trigger(actionName). Gameplay code only ever listens to
	actions, never to raw keys — that is what keeps mobile/console support free.

	There are no ProximityPrompts: you CLICK things (InteractionController).
	E / F / ButtonX use whatever you're looking at. Build mode blocks
	Interact while it is open so Q / E can rotate the preview.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local InputConfig = {
	Actions = {
		UseTool = {
			Inputs = { Enum.UserInputType.MouseButton1 },
			Gamepad = { Enum.KeyCode.ButtonR2 },
		},
		-- Interact with whatever you hover (same as clicking it).
		Interact = { Inputs = { Enum.KeyCode.E, Enum.KeyCode.F }, Gamepad = { Enum.KeyCode.ButtonX } },
		ToggleInventory = {
			Inputs = { Enum.KeyCode.I, Enum.KeyCode.G },
			Gamepad = { Enum.KeyCode.ButtonY },
		},
		ToggleBuild = {
			Inputs = { Enum.KeyCode.B },
			Gamepad = { Enum.KeyCode.DPadUp },
		},
		Cancel = {
			Inputs = { Enum.KeyCode.X },
			Gamepad = { Enum.KeyCode.ButtonB },
		},
		HotbarNext = { Inputs = {}, Gamepad = { Enum.KeyCode.ButtonR1 } },
		HotbarPrevious = { Inputs = {}, Gamepad = { Enum.KeyCode.ButtonL1 } },
		Hotbar1 = { Inputs = { Enum.KeyCode.One }, Gamepad = {} },
		Hotbar2 = { Inputs = { Enum.KeyCode.Two }, Gamepad = {} },
		Hotbar3 = { Inputs = { Enum.KeyCode.Three }, Gamepad = {} },
		Hotbar4 = { Inputs = { Enum.KeyCode.Four }, Gamepad = {} },
		Hotbar5 = { Inputs = { Enum.KeyCode.Five }, Gamepad = {} },
		Hotbar6 = { Inputs = { Enum.KeyCode.Six }, Gamepad = {} },
		Hotbar7 = { Inputs = { Enum.KeyCode.Seven }, Gamepad = {} },
		Hotbar8 = { Inputs = { Enum.KeyCode.Eight }, Gamepad = {} },
		Hotbar9 = { Inputs = { Enum.KeyCode.Nine }, Gamepad = {} },
		Unequip = { Inputs = { Enum.KeyCode.Zero, Enum.KeyCode.Backquote }, Gamepad = {} },
		Emotes = { Inputs = { Enum.KeyCode.T }, Gamepad = { Enum.KeyCode.DPadDown } },
		PlayersMenu = { Inputs = { Enum.KeyCode.P }, Gamepad = {} },
		-- Hold to sprint (run animation + wider view).
		Sprint = { Inputs = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift }, Gamepad = { Enum.KeyCode.ButtonL3 } },
		-- Build mode
		BuildPlace = { Inputs = { Enum.UserInputType.MouseButton1 }, Gamepad = { Enum.KeyCode.ButtonR2 } },
		RotateBuild = { Inputs = { Enum.KeyCode.R }, Gamepad = { Enum.KeyCode.ButtonX } },
		RotateBuildLeft = { Inputs = { Enum.KeyCode.Q }, Gamepad = { Enum.KeyCode.DPadLeft } },
		RotateBuildRight = { Inputs = { Enum.KeyCode.E }, Gamepad = { Enum.KeyCode.DPadRight } },
	},

	-- Minimum on-screen button size for touch (Roblox recommends >= 44px).
	MinTouchButtonSize = 64,
}

return TableUtil.DeepFreeze(InputConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">IslandConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/IslandConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every island is UNIQUE. An island is a set of land CHUNKS (ChunkSize x
	ChunkSize studs) on a grid around the island centre, plus a Seed, a
	THEME (biome look, trees, fish) and a SHAPE (how the starter land is laid
	out). Shared/Util/IslandGen turns that into an organic coastline, beaches,
	hills and resource spots — deterministically, so the same saved island
	always rebuilds identically on any server.

	Players EXPAND by buying any water chunk that touches their land, in any
	direction, so no two islands grow the same way. They customise further by
	painting terrain, planting trees, placing rocks/flowers, moving the market
	stall and naming the island.

	COORDINATES: island-local. (0, 0) is the island centre at sea level.
	Chunk (cx, cz) covers X in [cx*C - C/2, cx*C + C/2] (C = ChunkSize).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local IslandConfig = {
	SeaLevel = 0,

	-- Server slot grid. Islands are SlotSpacing studs apart so they never touch.
	SlotSpacing = 1000,
	SlotsPerRow = 4,

	ChunkSize = 16,
	GridRadius = 13, -- chunks may go from -GridRadius..GridRadius on each axis
	StarterChunks = 52,
	-- Always-land plaza around the centre (chunk offsets), so spawn + landmarks fit.
	PlazaRadius = 2.3, -- in chunks (euclidean)
	FlattenRadius = 30, -- studs around the centre kept flat for building

	LandHeight = 3, -- inland ground height above sea level
	BeachWidth = 8, -- studs of sloping beach
	CoastNoise = 5, -- studs the coastline wobbles
	BuildCoastDistance = 4, -- buildings must be this far inland (studs, after noise)

	Expansion = {
		-- Price of the next chunk: BaseCost + Linear*n + Quadratic*n^2 (n = chunks bought so far)
		BaseCost = 100,
		Linear = 10,
		Quadratic = 0.2,
		-- Max land = StarterChunks + BaseAllowance + (level-1) * ChunksPerIslandLevel.
		-- (A starter island is 52-64 chunks, so level 1 can always grow a bit.)
		BaseAllowance = 24,
		ChunksPerIslandLevel = 12,
		MaxChunks = 600,
	},

	DefaultNameFormat = "%s's Island",
	NameMaxLength = 24,
	DefaultTheme = "Tropical",
	DefaultShape = "Round",

	ThemeOrder = { "Tropical", "Meadow", "Autumn", "Snowy", "Desert" },
	Themes = {
		Tropical = {
			DisplayName = "Tropical",
			Icon = "🌴",
			Description = "Palm trees, white beaches and bright fish.",
			Ground = "Grass",
			Alt = "Grass",
			Beach = "Sand",
			Cliff = "Rock",
			Seabed = "Sand",
			HillAmp = 5,
			Color = Color3.fromRGB(80, 200, 120),
			Nodes = { PalmTree = 5, Tree = 2, Rock = 3, FiberBush = 3, SandPile = 2 },
			Deco = { "Flowers", "Shells", "Tuft" },
			NearFish = "Shore",
		},
		Meadow = {
			DisplayName = "Meadow",
			Icon = "🌳",
			Description = "Rolling green hills and big oak trees.",
			Ground = "Grass",
			Alt = "Grass",
			Beach = "Sand",
			Cliff = "Slate",
			Seabed = "Sand",
			HillAmp = 9,
			Color = Color3.fromRGB(120, 200, 70),
			Nodes = { Tree = 6, Rock = 3, FiberBush = 3, ClayPatch = 1 },
			Deco = { "Flowers", "Flowers", "Tuft" },
			NearFish = "River",
		},
		Autumn = {
			DisplayName = "Autumn",
			Icon = "🍂",
			Description = "Golden leaves, orange trees and cosy vibes.",
			Ground = "LeafyGrass",
			Alt = "Ground",
			Beach = "Sand",
			Cliff = "Slate",
			Seabed = "Sand",
			HillAmp = 10,
			Color = Color3.fromRGB(235, 140, 50),
			Nodes = { AutumnTree = 6, Rock = 3, FiberBush = 2, ClayPatch = 1 },
			Deco = { "Leaves", "Mushrooms", "Tuft" },
			NearFish = "River",
		},
		Snowy = {
			DisplayName = "Snowy",
			Icon = "❄️",
			Description = "Snow-covered pines and icy water full of rare fish.",
			Ground = "Snow",
			Alt = "Snow",
			Beach = "Salt",
			Cliff = "Rock",
			Seabed = "Sand",
			HillAmp = 12,
			Color = Color3.fromRGB(170, 220, 255),
			Nodes = { SnowPine = 6, Rock = 4, IronRock = 1 },
			Deco = { "Snowball", "Pebbles" },
			NearFish = "Cave",
		},
		Desert = {
			DisplayName = "Desert",
			Icon = "🌵",
			Description = "Warm dunes, cacti and hidden clay.",
			Ground = "Sandstone",
			Alt = "Sand",
			Beach = "Sand",
			Cliff = "Sandstone",
			Seabed = "Sand",
			HillAmp = 6,
			Color = Color3.fromRGB(240, 190, 100),
			Nodes = { Cactus = 4, PalmTree = 2, Rock = 3, SandPile = 3, ClayPatch = 2 },
			Deco = { "Pebbles", "DryTuft" },
			NearFish = "Shore",
		},
	},

	ShapeOrder = { "Round", "Crescent", "Twin", "Long", "Wild" },
	Shapes = {
		Round = { DisplayName = "Round", Icon = "⚪", Description = "A classic round island." },
		Crescent = { DisplayName = "Crescent", Icon = "🌙", Description = "Curves around a sheltered bay." },
		Twin = { DisplayName = "Twin Isles", Icon = "♾️", Description = "Two lobes joined in the middle." },
		Long = { DisplayName = "Longshore", Icon = "➖", Description = "A long island with endless beaches." },
		Wild = { DisplayName = "Wild", Icon = "🌀", Description = "Jagged, unpredictable coastline." },
	},

	-- Island-local positions of the starter landmarks (inside the plaza).
	StarterLayout = {
		Spawn = Vector2.new(0, 12),
		SpawnFacing = Vector2.new(0, -1),
		StarterChest = Vector2.new(-9, 4),
		IslandSign = Vector2.new(9, 4),
		MarketStall = { Position = Vector2.new(0, -14), Rotation = 180 },
		SoilTiles = {
			Vector2.new(18, -6), Vector2.new(23, -6), Vector2.new(28, -6),
			Vector2.new(18, -1), Vector2.new(23, -1), Vector2.new(28, -1),
		},
		KeepClearRadius = 26, -- no generated resources this close to the centre
	},

	-- Terrain paint palette (build mode → Paint). Name = Enum.Material name.
	PaintOrder = { "Grass", "LeafyGrass", "Snow", "Sand", "Sandstone", "Ground", "Mud", "Cobblestone", "Brick", "WoodPlanks", "Pavement", "Slate", "Limestone" },
	Paint = {
		Grass = { DisplayName = "Grass", Icon = "🟩" },
		LeafyGrass = { DisplayName = "Autumn Grass", Icon = "🟧" },
		Snow = { DisplayName = "Snow", Icon = "⬜" },
		Sand = { DisplayName = "Sand", Icon = "🟨" },
		Sandstone = { DisplayName = "Sandstone", Icon = "🟫" },
		Ground = { DisplayName = "Dirt", Icon = "🟤" },
		Mud = { DisplayName = "Mud", Icon = "🟤" },
		Cobblestone = { DisplayName = "Cobble Path", Icon = "🪨" },
		Brick = { DisplayName = "Brick Path", Icon = "🧱" },
		WoodPlanks = { DisplayName = "Wood Deck", Icon = "🪵" },
		Pavement = { DisplayName = "Stone Tiles", Icon = "⬛" },
		Slate = { DisplayName = "Slate", Icon = "🌑" },
		Limestone = { DisplayName = "Limestone", Icon = "🤍" },
	},
	PaintCellSize = 8,
	MaxPaintCells = 3000,

	-- Visiting (VisitService).
	VisitorModes = { "Everyone", "Friends", "Nobody" },
}

return TableUtil.DeepFreeze(IslandConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ItemConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ItemConfig
	SCRIPT TYPE:  ModuleScript (shared config / registry)
	WHERE:        ReplicatedStorage/Shared/Config/ItemConfig
	DEPENDENCIES: ResourceConfig, RarityConfig, Shared.Util.TableUtil

	The ONE registry of inventory item IDs. InventoryService refuses any ID not
	found here, and DataSchema quarantines unknown IDs in saved data.

	Adding a new item source in a later phase:
		1. Create e.g. CropConfig with an `Items` table in the same shape.
		2. Add it to SOURCES below.
	Nothing else needs to change.
]]

local Config = script.Parent
local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local RarityConfig = require(Config.RarityConfig)

local SOURCES = {
	require(Config.ResourceConfig),
	require(Config.CropConfig),
	require(Config.FishConfig),
	require(Config.AnimalConfig),
	-- Phase 8: require(Config.RecipeConfig),
}

export type ItemDef = {
	Id: string,
	DisplayName: string,
	Category: string,
	Rarity: string,
	SellValue: number,
	Icon: string,
	Image: string?,
	Description: string,
	MaxStack: number?,
}

local ItemConfig = {
	-- Inventory tabs, in display order.
	Categories = {
		{ Id = "All", DisplayName = "All", Icon = "🎒" },
		{ Id = "Resources", DisplayName = "Resources", Icon = "🪵" },
		{ Id = "Crops", DisplayName = "Crops", Icon = "🌽" },
		{ Id = "Seeds", DisplayName = "Seeds", Icon = "🌱" },
		{ Id = "Fish", DisplayName = "Fish", Icon = "🐟" },
		{ Id = "AnimalProducts", DisplayName = "Animal", Icon = "🥛" },
		{ Id = "Materials", DisplayName = "Materials", Icon = "⛏️" },
		{ Id = "Crafted", DisplayName = "Crafted", Icon = "🍞" },
		{ Id = "Tools", DisplayName = "Tools", Icon = "🪓" },
		{ Id = "Decorations", DisplayName = "Decor", Icon = "🌸" },
	},
	Items = {} :: { [string]: ItemDef },
}

for _, source in SOURCES do
	for id, def in source.Items do
		assert(ItemConfig.Items[id] == nil, "Duplicate item id: " .. id)
		assert(RarityConfig.Rarities[def.Rarity], "Unknown rarity on item " .. id)
		local item = table.clone(def)
		item.Id = id
		ItemConfig.Items[id] = item
	end
end

function ItemConfig.Get(itemId: string): ItemDef?
	return ItemConfig.Items[itemId]
end

function ItemConfig.Exists(itemId: any): boolean
	return type(itemId) == "string" and ItemConfig.Items[itemId] ~= nil
end

-- Items you can hold in your hand from the hotbar: seeds (plant by clicking
-- soil) and crops (feed animals by clicking them).
ItemConfig.HoldableCategories = { Seeds = true, Crops = true }

function ItemConfig.IsHoldable(itemId: any): boolean
	local def = type(itemId) == "string" and ItemConfig.Items[itemId]
	return def ~= nil and def ~= false and ItemConfig.HoldableCategories[def.Category] == true
end

return TableUtil.DeepFreeze(ItemConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ProgressionConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ProgressionConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ProgressionConfig
	DEPENDENCIES: Shared.Util.TableUtil

	XP curves, level titles and XP SOURCES. The server awards XP by source id
	(ProgressionService.Award(player, "StarterChest")); the amount always comes
	from this table, never from a client.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local ProgressionConfig = {
	Player = {
		MaxLevel = 100,
	},
	Island = {
		MaxLevel = 100,
		-- Rename freely; the highest title whose Level <= island level is shown.
		Titles = {
			{ Level = 1, Title = "Starter Island" },
			{ Level = 5, Title = "Small Farmer" },
			{ Level = 10, Title = "Established Island" },
			{ Level = 20, Title = "Prosperous Island" },
			{ Level = 35, Title = "Island Builder" },
			{ Level = 50, Title = "Master Islander" },
		},
	},

	-- XP granted per action. Player = player XP, Island = island XP.
	Sources = {
		StarterChest = { Player = 25, Island = 40 },
		ExpandIsland = { Player = 30, Island = 60 },
		ChopTree = { Player = 3, Island = 2 },
		MineRock = { Player = 3, Island = 2 },
		GatherFiber = { Player = 2, Island = 1 },
		BuildStep = { Player = 2, Island = 1 },
		BuildComplete = { Player = 20, Island = 25 },
		PlantCrop = { Player = 1, Island = 1 },
		HarvestCrop = { Player = 4, Island = 3 },
		CatchFish = { Player = 8, Island = 4 }, -- multiplied by rarity rank
		FeedAnimal = { Player = 2, Island = 1 },
		CollectProduce = { Player = 6, Island = 4 },
		BuyAnimal = { Player = 10, Island = 15 },
		SellItems = { Player = 2, Island = 2 },
	},
}

-- XP needed to go from `level` to `level + 1`.
function ProgressionConfig.PlayerXPForLevel(level: number): number
	return math.floor(60 * level ^ 1.45)
end

function ProgressionConfig.IslandXPForLevel(level: number): number
	return math.floor(50 * level ^ 1.5)
end

function ProgressionConfig.GetIslandTitle(level: number): string
	local title = ProgressionConfig.Island.Titles[1].Title
	for _, entry in ProgressionConfig.Island.Titles do
		if level >= entry.Level then
			title = entry.Title
		end
	end
	return title
end

return TableUtil.DeepFreeze(ProgressionConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">QuestConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  QuestConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/QuestConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Progression quests that double as the tutorial (spec §118/§119): each quest
	teaches one part of the core loop, and finishing it starts the next.

	Task events (recorded by QuestService from server-side signals only):
		CollectItem     Target = item id        (gathered, not bought)
		BuildComplete   Target = building id or category
		PlantCrop / HarvestCrop   Target = crop id (optional)
		CatchFish       Target = fish id (optional)
		SellItem        Target = item id (optional)
		BuyAnimal / BuyTool       Target = id
		FeedAnimal      Target = animal id
		CollectProduce  Target = item id (Milk, Egg)
		ExpandIsland    buy one chunk of land (additive)
		PaintTerrain    paint terrain cells (additive)
		RenameIsland    give the island a name
		IslandLevel     progress = current island level (not additive)
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local QuestConfig = {
	Chain = { "StartYourIsland", "FirstAnimal", "GrowYourIsland", "IslandDesigner", "Adventurer" },

	Quests = {
		StartYourIsland = {
			DisplayName = "START YOUR ISLAND",
			Tasks = {
				{ Id = "Wood", Text = "Collect 20 Wood", Hint = "Hold your 🪓 Axe (press 1) and click a tree", Event = "CollectItem", Target = "Wood", Amount = 20 },
				{ Id = "Stone", Text = "Collect 10 Stone", Hint = "Hold your ⛏️ Pickaxe (press 2) and click a rock", Event = "CollectItem", Target = "Stone", Amount = 10 },
				{ Id = "House", Text = "Build your first house", Hint = "Press B → Homes → Small Cottage, then hold your 🔨 and click it", Event = "BuildComplete", Target = "Homes", Amount = 1 },
				{ Id = "Plant", Text = "Plant 5 crops", Hint = "Hoe: click soil to till · hold a seed sack: click to plant", Event = "PlantCrop", Amount = 5 },
				{ Id = "Fish", Text = "Catch 1 fish", Hint = "Hold your 🎣 rod and click the water", Event = "CatchFish", Amount = 1 },
				{ Id = "Sell", Text = "Sell 1 item", Hint = "Click the market stall near your spawn", Event = "SellItem", Amount = 1 },
			},
			Reward = { Coins = 250, XP = 100, IslandXP = 150 },
		},
		FirstAnimal = {
			DisplayName = "RAISE YOUR FIRST ANIMAL",
			Tasks = {
				{ Id = "Barn", Text = "Build a Barn", Hint = "Build mode → Farm → Barn", Event = "BuildComplete", Target = "Barn", Amount = 1 },
				{ Id = "Cow", Text = "Buy a Cow", Hint = "Market stall → Buy → Animals", Event = "BuyAnimal", Target = "Cow", Amount = 1 },
				{ Id = "Feed", Text = "Feed your Cow", Hint = "Hold 🌾 Wheat (hotbar) and click your cow", Event = "FeedAnimal", Target = "Cow", Amount = 1 },
				{ Id = "Milk", Text = "Milk your Cow", Hint = "When it says READY, hold your 🪣 bucket and click", Event = "CollectProduce", Target = "Milk", Amount = 1 },
			},
			Reward = { Coins = 300, XP = 150, IslandXP = 200 },
		},
		GrowYourIsland = {
			DisplayName = "GROW YOUR ISLAND",
			Tasks = {
				{ Id = "Harvest", Text = "Harvest 20 crops", Hint = "Water crops to grow them faster", Event = "HarvestCrop", Amount = 20 },
				{ Id = "Fish", Text = "Catch 5 fish", Hint = "Better rods find rarer fish", Event = "CatchFish", Amount = 5 },
				{ Id = "Sell", Text = "Sell 30 items", Hint = "Check the market demand bonus!", Event = "SellItem", Amount = 30 },
				{ Id = "Expand", Text = "Expand your island 3 times", Hint = "Build mode (B) → 🏝️ Expand → click glowing water squares", Event = "ExpandIsland", Amount = 3 },
			},
			Reward = { Coins = 500, XP = 250, IslandXP = 300 },
		},
		IslandDesigner = {
			DisplayName = "ISLAND DESIGNER",
			Tasks = {
				{ Id = "Rename", Text = "Rename your island", Hint = "Click your island sign by the spawn", Event = "RenameIsland", Amount = 1 },
				{ Id = "Paint", Text = "Paint 12 patches of terrain", Hint = "Build mode (B) → 🎨 Paint → pick a path or grass", Event = "PaintTerrain", Amount = 12 },
				{ Id = "Trees", Text = "Plant 3 trees", Hint = "Build mode → 🌳 Nature → Oak / Palm / Pine", Event = "BuildComplete", Target = "Nature", Amount = 3 },
				{ Id = "Tiles", Text = "Own 10 soil tiles", Hint = "Build mode → 🐄 Farm → Soil Tile (you start with 6)", Event = "BuildComplete", Target = "SoilTile", Amount = 10 },
			},
			Reward = { Coins = 400, XP = 200, IslandXP = 250 },
		},
		Adventurer = {
			DisplayName = "ISLAND ADVENTURER",
			Tasks = {
				{ Id = "Pickaxe", Text = "Buy a Stone Pickaxe", Hint = "Market stall → Buy → Tools", Event = "BuyTool", Target = "StonePickaxe", Amount = 1 },
				{ Id = "Cabin", Text = "Build a Wooden Cabin", Hint = "Needs Island Level 3", Event = "BuildComplete", Target = "WoodenCabin", Amount = 1 },
				{ Id = "Chicken", Text = "Collect 3 Eggs", Hint = "Build a Chicken Coop and buy chickens", Event = "CollectProduce", Target = "Egg", Amount = 3 },
				{ Id = "Level", Text = "Reach Island Level 5", Hint = "Everything you do grows your island", Event = "IslandLevel", Amount = 5 },
			},
			Reward = { Coins = 1000, XP = 400, IslandXP = 500 },
		},
	},
}

for questId, quest in QuestConfig.Quests do
	quest.Id = questId
end

function QuestConfig.NextQuest(questId: string): string?
	local index = table.find(QuestConfig.Chain, questId)
	if not index then
		return nil
	end
	return QuestConfig.Chain[index + 1]
end

return TableUtil.DeepFreeze(QuestConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">RarityConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  RarityConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/RarityConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Central rarity table used by items, fish, animals, drops and UI colors.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local RarityConfig = {
	Order = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" },

	Rarities = {
		Common = { Rank = 1, DisplayName = "Common", Color = Color3.fromRGB(170, 170, 170), ValueMultiplier = 1, Glow = false },
		Uncommon = { Rank = 2, DisplayName = "Uncommon", Color = Color3.fromRGB(96, 200, 90), ValueMultiplier = 1.5, Glow = false },
		Rare = { Rank = 3, DisplayName = "Rare", Color = Color3.fromRGB(70, 150, 255), ValueMultiplier = 3, Glow = false },
		Epic = { Rank = 4, DisplayName = "Epic", Color = Color3.fromRGB(170, 90, 255), ValueMultiplier = 6, Glow = true },
		Legendary = { Rank = 5, DisplayName = "Legendary", Color = Color3.fromRGB(255, 180, 40), ValueMultiplier = 15, Glow = true },
		Mythic = { Rank = 6, DisplayName = "Mythic", Color = Color3.fromRGB(255, 80, 150), ValueMultiplier = 40, Glow = true },
	},
}

function RarityConfig.Get(rarity: string?)
	return RarityConfig.Rarities[rarity or "Common"] or RarityConfig.Rarities.Common
end

return TableUtil.DeepFreeze(RarityConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">RemoteConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  RemoteConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/RemoteConfig
	DEPENDENCIES: Shared.Util.TableUtil

	The complete, centralized list of network remotes. Net creates exactly
	these (and nothing else) inside ReplicatedStorage/Remotes when the server
	boots. All names are declared up-front — including ones later phases will
	use — so remote names never change between phases.

	RateLimits: token bucket per player per remote. Rate = tokens/second,
	Burst = bucket size. Requests over the limit are dropped and reported to
	AntiExploitService.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local RemoteConfig = {
	-- Client -> Server requests (RemoteEvent). The server validates EVERYTHING.
	ClientToServer = {
		"ClientReady", -- client finished loading; server replies with a full StateSync
		"EquipToolRequest", -- (id: string?) a tool OR a holdable item from the hotbar; nil/"" = empty hands
		"HotbarRequest", -- { Op = "Set", Slot, Id } rearrange / put an item on the hotbar
		"InteractRequest", -- (target: Instance) clicked a tree, tile, animal, stall... with what you're holding
		"SwingRequest", -- cosmetic swing at nothing (others see the animation)
		"EmoteRequest", -- ("Wave" | "Cheer" | "Point" | "Dance")
		"CreateIslandRequest", -- { Theme, Shape, Seed, Name } from the Island Creator
		"ExpandIslandRequest", -- (cx, cz) buy a chunk of land
		"PaintTerrainRequest", -- (cells, material)
		"RenameIslandRequest", -- (name)
		"IslandSettingsRequest", -- { Visitors? } | { Helper = userId, Allowed }
		"RemoveNodeRequest", -- (nodeId) clear a natural tree/rock from your island for good
		"BuildRequest", -- { Op = "Place", BuildingId, X, Z, Rotation }
		"DeleteBuildRequest",
		"MoveBuildRequest",
		"FishingRequest", -- { Op = "Cast", Target } | Hook | Reel | Cancel
		"SellItemRequest",
		"PurchaseRequest",
		"VisitRequest", -- (userId) or 0 = go home
		"LikeRequest", -- (ownerUserId)
		"TradeRequest", -- { Op = Invite | Respond | Offer | Coins | Ready | Confirm | Cancel, ... }
		"SettingsRequest", -- { Music, Sfx, CameraShake }
		"CraftRequest", -- reserved (production phase)
	},

	-- Server -> Client pushes (RemoteEvent).
	ServerToClient = {
		"StateSync", -- replicated profile data (full snapshot, then batched path ops)
		"Notify", -- toast / banner / reward popup
		"PlaySound", -- positional or 2D sound from SoundConfig
		"PlayVFX", -- effect from VFXConfig
		"CameraShake", -- small, capped camera shake
		"OpenUI", -- server asks the client to open a screen (Market, IslandSettings, IslandInfo...)
		"FishingEvent", -- cast / bite / reel / result updates for the fishing minigame
		"TradeEvent", -- trade invites and live trade state
	},

	DefaultRateLimit = { Rate = 5, Burst = 10 },

	RateLimits = {
		ClientReady = { Rate = 0.2, Burst = 3 },
		EquipToolRequest = { Rate = 6, Burst = 10 },
		HotbarRequest = { Rate = 4, Burst = 8 },
		InteractRequest = { Rate = 6, Burst = 10 },
		SwingRequest = { Rate = 4, Burst = 6 },
		EmoteRequest = { Rate = 1, Burst = 3 },
		CreateIslandRequest = { Rate = 0.5, Burst = 2 },
		ExpandIslandRequest = { Rate = 1, Burst = 3 },
		PaintTerrainRequest = { Rate = 8, Burst = 16 },
		RenameIslandRequest = { Rate = 0.2, Burst = 2 },
		IslandSettingsRequest = { Rate = 1, Burst = 4 },
		RemoveNodeRequest = { Rate = 2, Burst = 4 },
		BuildRequest = { Rate = 4, Burst = 6 },
		DeleteBuildRequest = { Rate = 2, Burst = 4 },
		MoveBuildRequest = { Rate = 2, Burst = 4 },
		FishingRequest = { Rate = 4, Burst = 8 },
		SellItemRequest = { Rate = 3, Burst = 6 },
		PurchaseRequest = { Rate = 2, Burst = 4 },
		VisitRequest = { Rate = 0.5, Burst = 2 },
		LikeRequest = { Rate = 0.5, Burst = 2 },
		TradeRequest = { Rate = 5, Burst = 12 },
		SettingsRequest = { Rate = 2, Burst = 5 },
		CraftRequest = { Rate = 3, Burst = 6 },
	},

	-- Built below: set of every valid remote name -> direction.
	Known = {} :: { [string]: string },
}

for _, name in RemoteConfig.ClientToServer do
	RemoteConfig.Known[name] = "ClientToServer"
end
for _, name in RemoteConfig.ServerToClient do
	assert(RemoteConfig.Known[name] == nil, "Duplicate remote name " .. name)
	RemoteConfig.Known[name] = "ServerToClient"
end

return TableUtil.DeepFreeze(RemoteConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ResourceConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ResourceConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ResourceConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Raw gatherable resources + the resource NODES (trees, rocks, bushes...)
	that drop them. SellValue is the ONLY place the base price of a resource
	is defined (the market reads it through ItemConfig).

	NODES
		Resource        item id dropped
		Health          hit points (a tool hit deals Power x DamagePerPower)
		ToolType        tool type required (nil = gathered by hand)
		MinTier         minimum ToolConfig tier order (1 Wooden, 2 Stone, 3 Iron...)
		Drops           {Min, Max} per break (+1 chance from the tool's ResourceBonus)
		Respawn         seconds hidden before the node regrows (pooled, never destroyed)
		Action          verb shown in the hover tooltip ("🪓 Chop · Oak Tree")
		Animation/Marker  hand-gathered nodes only; tool nodes use the tool's Use animation
		XPSource        ProgressionConfig source id

	Icon: emoji used by the UI until real icon images exist. Image: optional
	Roblox image id (placeholder until you upload art).

	Future phases add their own item tables (CropConfig, FishConfig,
	AnimalConfig products, RecipeConfig outputs); ItemConfig merges them.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER_IMAGE = "rbxassetid://PLACEHOLDER"

local ResourceConfig = {
	Items = {
		-- COMMON
		Wood = { DisplayName = "Wood", Category = "Resources", Rarity = "Common", SellValue = 2, Icon = "🪵", Image = PLACEHOLDER_IMAGE, Description = "Sturdy logs chopped from island trees. The backbone of every build." },
		Stone = { DisplayName = "Stone", Category = "Resources", Rarity = "Common", SellValue = 3, Icon = "🪨", Image = PLACEHOLDER_IMAGE, Description = "Solid rock mined with a pickaxe. Used for foundations and tools." },
		Fiber = { DisplayName = "Fiber", Category = "Resources", Rarity = "Common", SellValue = 2, Icon = "🌾", Image = PLACEHOLDER_IMAGE, Description = "Tough plant fibers used for rope, nets and baskets." },
		Clay = { DisplayName = "Clay", Category = "Resources", Rarity = "Common", SellValue = 4, Icon = "🟫", Image = PLACEHOLDER_IMAGE, Description = "Soft riverbank clay. Fire it into bricks and pots." },
		Sand = { DisplayName = "Sand", Category = "Resources", Rarity = "Common", SellValue = 2, Icon = "⏳", Image = PLACEHOLDER_IMAGE, Description = "Fine beach sand. Glassmakers love it." },
		Water = { DisplayName = "Water", Category = "Resources", Rarity = "Common", SellValue = 1, Icon = "💧", Image = PLACEHOLDER_IMAGE, Description = "Fresh water from a well or pump. Crops and animals need it." },

		-- ADVANCED
		Iron = { DisplayName = "Iron Ore", Category = "Materials", Rarity = "Uncommon", SellValue = 12, Icon = "⛓️", Image = PLACEHOLDER_IMAGE, Description = "Ore from the mountain. Smelt it into iron tools." },
		Copper = { DisplayName = "Copper Ore", Category = "Materials", Rarity = "Uncommon", SellValue = 10, Icon = "🟠", Image = PLACEHOLDER_IMAGE, Description = "Shiny orange ore used for pipes and machinery." },
		Gold = { DisplayName = "Gold Ore", Category = "Materials", Rarity = "Rare", SellValue = 45, Icon = "🟡", Image = PLACEHOLDER_IMAGE, Description = "Precious ore buried deep in the mountain." },
		Crystal = { DisplayName = "Crystal", Category = "Materials", Rarity = "Epic", SellValue = 120, Icon = "💎", Image = PLACEHOLDER_IMAGE, Description = "A glowing crystal found only in island caves." },
		StarShard = { DisplayName = "Star Shard", Category = "Materials", Rarity = "Legendary", SellValue = 400, Icon = "🌟", Image = PLACEHOLDER_IMAGE, Description = "A fragment of a fallen star. Appears during meteor showers." },
		AncientWood = { DisplayName = "Ancient Wood", Category = "Materials", Rarity = "Epic", SellValue = 150, Icon = "🌳", Image = PLACEHOLDER_IMAGE, Description = "Timber from trees older than the island itself." },
	},

	Nodes = {
		Tree = {
			DisplayName = "Oak Tree", Resource = "Wood", Health = 100, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 3, Max = 5 }, Respawn = 40, Action = "Chop", XPSource = "ChopTree", Model = "Oak",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "LeafBurst", FallOver = true,
		},
		PalmTree = {
			DisplayName = "Palm Tree", Resource = "Wood", Health = 100, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 3, Max = 5 }, Respawn = 40, Action = "Chop", XPSource = "ChopTree", Model = "Palm",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "LeafBurst", FallOver = true,
		},
		AutumnTree = {
			DisplayName = "Maple Tree", Resource = "Wood", Health = 100, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 3, Max = 5 }, Respawn = 40, Action = "Chop", XPSource = "ChopTree", Model = "Maple",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "LeafBurst", FallOver = true,
		},
		SnowPine = {
			DisplayName = "Snowy Pine", Resource = "Wood", Health = 125, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 4, Max = 6 }, Respawn = 50, Action = "Chop", XPSource = "ChopTree", Model = "SnowPine",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "Sparkle", FallOver = true,
		},
		Cactus = {
			DisplayName = "Cactus", Resource = "Fiber", Health = 50, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 3, Max = 5 }, Respawn = 35, Action = "Chop", XPSource = "GatherFiber", Model = "Cactus",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "LeafBurst", BreakVFX = "LeafBurst", FallOver = true,
		},
		PineTree = {
			DisplayName = "Pine Tree", Resource = "Wood", Health = 125, ToolType = "Axe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 4, Max = 6 }, Respawn = 50, Action = "Chop", XPSource = "ChopTree", Model = "Pine",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "LeafBurst", FallOver = true,
		},
		AncientTree = {
			DisplayName = "Ancient Tree", Resource = "AncientWood", Health = 300, ToolType = "Axe", MinTier = 3, DamagePerPower = 25,
			Drops = { Min = 1, Max = 2 }, Respawn = 300, Action = "Chop", XPSource = "ChopTree", Model = "Ancient",
			HitSound = "WoodHit", BreakSound = "TreeFall", HitVFX = "WoodChips", BreakVFX = "Sparkle", FallOver = true,
		},
		Rock = {
			DisplayName = "Rock", Resource = "Stone", Health = 100, ToolType = "Pickaxe", MinTier = 1, DamagePerPower = 25,
			Drops = { Min = 2, Max = 4 }, Respawn = 50, Action = "Mine", XPSource = "MineRock", Model = "Rock",
			HitSound = "RockHit", BreakSound = "RockBreak", HitVFX = "RockChips", BreakVFX = "RockChips", Shake = 0.12,
		},
		IronRock = {
			DisplayName = "Iron Deposit", Resource = "Iron", Health = 150, ToolType = "Pickaxe", MinTier = 2, DamagePerPower = 25,
			Drops = { Min = 1, Max = 3 }, Respawn = 90, Action = "Mine", XPSource = "MineRock", Model = "Iron",
			HitSound = "RockHit", BreakSound = "RockBreak", HitVFX = "RockChips", BreakVFX = "RockChips", Shake = 0.15,
		},
		CrystalRock = {
			DisplayName = "Crystal Cluster", Resource = "Crystal", Health = 200, ToolType = "Pickaxe", MinTier = 3, DamagePerPower = 25,
			Drops = { Min = 1, Max = 2 }, Respawn = 180, Action = "Mine", XPSource = "MineRock", Model = "Crystal",
			HitSound = "RockHit", BreakSound = "RockBreak", HitVFX = "Sparkle", BreakVFX = "Sparkle", Shake = 0.15,
		},
		FiberBush = {
			DisplayName = "Fiber Bush", Resource = "Fiber", Health = 1, ToolType = nil, MinTier = 0, DamagePerPower = 1,
			Drops = { Min = 2, Max = 3 }, Respawn = 30, Action = "Pick", XPSource = "GatherFiber", Model = "Bush",
			Animation = "PickCrop", Marker = "Pick", HitSound = "Harvest", HitVFX = "LeafBurst", BreakVFX = "LeafBurst",
		},
		SandPile = {
			DisplayName = "Sand Pile", Resource = "Sand", Health = 1, ToolType = nil, MinTier = 0, DamagePerPower = 1,
			Drops = { Min = 2, Max = 4 }, Respawn = 40, Action = "Scoop", XPSource = "GatherFiber", Model = "Sand",
			Animation = "PickCrop", Marker = "Pick", HitSound = "ShovelDig", HitVFX = "DirtPuff", BreakVFX = "DirtPuff",
		},
		ClayPatch = {
			DisplayName = "Clay Patch", Resource = "Clay", Health = 1, ToolType = "Shovel", MinTier = 1, DamagePerPower = 1,
			Drops = { Min = 2, Max = 3 }, Respawn = 45, Action = "Dig", XPSource = "GatherFiber", Model = "Clay",
			HitSound = "ShovelDig", HitVFX = "DirtPuff", BreakVFX = "DirtPuff",
		},
	},
}

return TableUtil.DeepFreeze(ResourceConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ShopConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ShopConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ShopConfig
	DEPENDENCIES: CropConfig, AnimalConfig, Shared.Util.TableUtil

	Everything the island market sells. Seeds and animals are generated from
	CropConfig / AnimalConfig so prices live in exactly one place.

		Price       coins per purchase
		Items       extra item cost (tool upgrades)
		Grant       { Item = id, Amount } | { Tool = id } | { Animal = id } | { Upgrade = id, Amount }
		UnlockLevel island level required
		MaxOwned    for upgrades: how many times it can be bought
		Bulk        seeds can be bought in bundles of this size too

	Selling uses item SellValue (ItemConfig) x EconomyConfig multipliers x market demand.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local CropConfig = require(script.Parent.CropConfig)
local AnimalConfig = require(script.Parent.AnimalConfig)

local ShopConfig = {
	MarketRange = 30, -- player must be this close to their market stall to trade

	Categories = {
		{ Id = "Seeds", DisplayName = "Seeds", Icon = "🌱" },
		{ Id = "Animals", DisplayName = "Animals", Icon = "🐄" },
		{ Id = "Tools", DisplayName = "Tools", Icon = "🪓" },
		{ Id = "Upgrades", DisplayName = "Upgrades", Icon = "⬆️" },
	},

	-- Item categories the "Sell Everything" button sells (never seeds or tools).
	SellAllCategories = { Crops = true, Fish = true, AnimalProducts = true },

	Items = {
		-- TOOLS
		WoodenBucket = { Category = "Tools", DisplayName = "Wooden Bucket", Icon = "🪣", Price = 20, Grant = { Tool = "WoodenBucket" }, UnlockLevel = 1, Order = 1, Description = "Needed to milk cows." },
		WoodenShovel = { Category = "Tools", DisplayName = "Wooden Shovel", Icon = "🪏", Price = 40, Grant = { Tool = "WoodenShovel" }, UnlockLevel = 1, Order = 2, Description = "Dig clay by the river." },
		StoneAxe = { Category = "Tools", DisplayName = "Stone Axe", Icon = "🪓", Price = 150, Items = { Stone = 15 }, Grant = { Tool = "StoneAxe" }, UnlockLevel = 2, Order = 3, Description = "Chops trees in 2 hits instead of 4." },
		StonePickaxe = { Category = "Tools", DisplayName = "Stone Pickaxe", Icon = "⛏️", Price = 150, Items = { Stone = 15 }, Grant = { Tool = "StonePickaxe" }, UnlockLevel = 2, Order = 4, Description = "Mines faster and can break Iron deposits." },
		IronFishingRod = { Category = "Tools", DisplayName = "Iron Fishing Rod", Icon = "🎣", Price = 500, Items = { Wood = 20 }, Grant = { Tool = "IronFishingRod" }, UnlockLevel = 4, Order = 5, Description = "Faster bites and better luck with rare fish." },
		IronAxe = { Category = "Tools", DisplayName = "Iron Axe", Icon = "🪓", Price = 800, Items = { Iron = 10 }, Grant = { Tool = "IronAxe" }, UnlockLevel = 5, Order = 6, Description = "Cuts through Ancient Trees." },
		IronPickaxe = { Category = "Tools", DisplayName = "Iron Pickaxe", Icon = "⛏️", Price = 800, Items = { Iron = 10 }, Grant = { Tool = "IronPickaxe" }, UnlockLevel = 5, Order = 7, Description = "Mines Crystal clusters." },

		-- UPGRADES
		BiggerBackpack = { Category = "Upgrades", DisplayName = "Bigger Backpack", Icon = "🎒", Price = 150, Grant = { Upgrade = "Capacity", Amount = 100 }, MaxOwned = 5, UnlockLevel = 1, Order = 2, Description = "+100 backpack capacity." },
	},
}

for index, cropId in CropConfig.Order do
	local crop = CropConfig.Crops[cropId]
	ShopConfig.Items[crop.Seed] = {
		Category = "Seeds",
		DisplayName = crop.DisplayName .. " Seeds",
		Icon = crop.Icon,
		Price = crop.SeedCost,
		Grant = { Item = crop.Seed, Amount = 1 },
		Bulk = 5,
		UnlockLevel = crop.UnlockLevel,
		Order = index,
		Description = ("Grows in %ds · %d-%d %s per harvest · sells for %d 🪙 each"):format(
			crop.GrowTime,
			crop.Yield.Min,
			crop.Yield.Max,
			crop.DisplayName,
			crop.SellValue
		),
	}
end

for index, animalId in AnimalConfig.Order do
	local animal = AnimalConfig.Animals[animalId]
	ShopConfig.Items[animalId] = {
		Category = "Animals",
		DisplayName = animal.DisplayName,
		Icon = animal.Icon,
		Price = animal.Price,
		Grant = { Animal = animalId },
		UnlockLevel = animal.UnlockLevel,
		Order = index,
		Description = ("Needs a %s. Eats %s, gives %s."):format(animal.Housing, animal.Food, animal.Produce),
	}
end

for itemId, def in ShopConfig.Items do
	def.Id = itemId
end

return TableUtil.DeepFreeze(ShopConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">SoundConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  SoundConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/SoundConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every sound in the game. ONLY two kinds of source are used, and each
	entry says which one it is:

	  BUILTIN   "rbxasset://sounds/..."  files that ship inside the Roblox
	            client itself (always available, no upload, no permissions).
	  DOCS      "rbxassetid://<n>"       audio assets used by Roblox's own
	            official Creator Hub tutorials (create.roblox.com/docs),
	            e.g. "Add 2D audio", "In-game sounds", "Create player tools".
	            The tutorial the id comes from is named next to it.

	Nothing here is made up. Sounds with no verified source yet
	(CowMoo, ChickenCluck...) stay "rbxassetid://PLACEHOLDER" and are
	skipped silently — paste your own ids from the Creator Store to fill
	them in (docs/ASSETS.md). PlaybackSpeed / PitchVariation turn the small
	set of real sounds into distinct effects for each action.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER = "rbxassetid://PLACEHOLDER"

-- BUILTIN: files inside the Roblox client's content/sounds folder.
local BUILTIN = {
	Tick = "rbxasset://sounds/volume_slider.ogg", -- short UI tick
	Splash = "rbxasset://sounds/impact_water.mp3", -- water impact
	Hop = "rbxasset://sounds/action_jump.mp3", -- classic jump "boing"
	Thud = "rbxasset://sounds/action_jump_land.mp3", -- landing thud
	Step = "rbxasset://sounds/action_footsteps_plastic.mp3", -- footstep tap
	Boom = "rbxasset://sounds/impact_explosion_03.mp3", -- explosion (used quiet + slowed)
	Swim = "rbxasset://sounds/action_swim.mp3", -- water stroke
}

-- DOCS: asset ids from Roblox's official Creator Hub tutorials.
local DOCS = {
	Chime = "rbxassetid://4110925712", -- "In-game sounds": the simple feedback chime
	Jingle = "rbxassetid://3422389728", -- "Add 2D audio": retro jingle
	Chomp = "rbxassetid://9113723699", -- "Add 2D audio": gentle chomping
	Equip = "rbxassetid://282906960", -- "Create player tools": tool Equip sound
	Activate = "rbxassetid://130113322", -- "Create player tools": tool Activate sound
	Gate = "rbxassetid://5930776613", -- "Add 3D audio": sliding metal gate
	Music = "rbxassetid://1841461968", -- "Add 2D audio": upbeat music track
	Celebrate = "rbxassetid://1846248593", -- "Add 3D audio": cheerful celebratory track
	WaterAmbience = "rbxassetid://6564308795", -- "In-game sounds": waterfall ambience loop
	Rain = "rbxassetid://1516791621", -- "Add 3D audio": rain loop
}

local function sound(id: string, category: string, volume: number?, extra: { [string]: any }?)
	local def = {
		Id = id,
		Category = category,
		Volume = volume or 0.6,
		PlaybackSpeed = 1,
		PitchVariation = 0.05, -- random +/- speed so repeated hits don't sound robotic
		RollOffMaxDistance = 80,
	}
	if extra then
		for key, value in extra do
			def[key] = value
		end
	end
	return def
end

local SoundConfig = {
	Sources = { Builtin = BUILTIN, Docs = DOCS },

	-- Category volume mixers (multiplied with the player's SFX / music settings).
	Categories = {
		UI = 0.8,
		Coins = 0.8,
		Tools = 0.9,
		Building = 0.9,
		Farming = 0.9,
		Fishing = 0.9,
		Animals = 0.8,
		Environment = 0.5,
		Progress = 1,
		Rewards = 1,
		Music = 0.6,
	},

	Sounds = {
		-- UI
		UIClick = sound(BUILTIN.Tick, "UI", 0.5, { PitchVariation = 0.03, PlaybackSpeed = 1.2 }),
		UIHover = sound(BUILTIN.Tick, "UI", 0.15, { PitchVariation = 0, PlaybackSpeed = 1.6 }),
		UIOpen = sound(BUILTIN.Tick, "UI", 0.45, { PlaybackSpeed = 0.9 }),
		UIClose = sound(BUILTIN.Tick, "UI", 0.45, { PlaybackSpeed = 0.75 }),
		UINotify = sound(DOCS.Chime, "UI", 0.35, { PlaybackSpeed = 1.3 }),
		UIError = sound(BUILTIN.Tick, "UI", 0.6, { PitchVariation = 0, PlaybackSpeed = 0.5 }),

		-- Coins / rewards
		CoinGain = sound(DOCS.Chime, "Coins", 0.45, { PlaybackSpeed = 1.5 }),
		CoinSpend = sound(BUILTIN.Tick, "Coins", 0.4, { PlaybackSpeed = 0.9 }),
		ItemGain = sound(BUILTIN.Hop, "Rewards", 0.25, { PlaybackSpeed = 1.5 }),
		RareReward = sound(DOCS.Jingle, "Rewards", 0.7, { PitchVariation = 0 }),

		-- Progression
		LevelUp = sound(DOCS.Jingle, "Progress", 0.8, { PitchVariation = 0 }),
		IslandLevelUp = sound(DOCS.Jingle, "Progress", 0.9, { PitchVariation = 0, PlaybackSpeed = 0.9 }),
		AreaUnlock = sound(DOCS.Jingle, "Progress", 0.8, { PitchVariation = 0, PlaybackSpeed = 1.1 }),
		LandRise = sound(BUILTIN.Boom, "Progress", 0.35, { PitchVariation = 0, PlaybackSpeed = 0.45, RollOffMaxDistance = 200 }),
		ChestOpen = sound(DOCS.Chime, "Rewards", 0.8, { PlaybackSpeed = 0.8 }),
		QuestComplete = sound(DOCS.Chime, "Progress", 0.8, { PitchVariation = 0 }),

		-- Tools
		ToolEquip = sound(DOCS.Equip, "Tools", 0.35),
		ToolSwing = sound(DOCS.Activate, "Tools", 0.35, { PlaybackSpeed = 1.2 }),
		AxeSwing = sound(BUILTIN.Thud, "Tools", 0.8, { PlaybackSpeed = 1.25, PitchVariation = 0.1 }),
		PickaxeSwing = sound(BUILTIN.Thud, "Tools", 0.8, { PlaybackSpeed = 1.6, PitchVariation = 0.1 }),
		HammerSwing = sound(BUILTIN.Thud, "Tools", 0.7, { PlaybackSpeed = 1.4 }),
		ShovelDig = sound(BUILTIN.Step, "Tools", 0.8, { PlaybackSpeed = 0.7 }),
		HoeTill = sound(BUILTIN.Step, "Tools", 0.8, { PlaybackSpeed = 0.8 }),
		Shears = sound(BUILTIN.Tick, "Tools", 0.5, { PlaybackSpeed = 1.8 }),
		WoodHit = sound(BUILTIN.Thud, "Tools", 0.8, { PlaybackSpeed = 1.1 }),
		TreeFall = sound(BUILTIN.Boom, "Tools", 0.3, { PlaybackSpeed = 0.55, RollOffMaxDistance = 120 }),
		RockHit = sound(BUILTIN.Thud, "Tools", 0.8, { PlaybackSpeed = 1.7 }),
		RockBreak = sound(BUILTIN.Boom, "Tools", 0.25, { PlaybackSpeed = 0.9 }),

		-- Building
		HammerHit = sound(BUILTIN.Thud, "Building", 0.8, { PlaybackSpeed = 1.5, PitchVariation = 0.08 }),
		WoodPlace = sound(BUILTIN.Thud, "Building", 0.7, { PlaybackSpeed = 0.9 }),
		StonePlace = sound(BUILTIN.Thud, "Building", 0.7, { PlaybackSpeed = 0.7 }),
		Saw = sound(BUILTIN.Step, "Building", 0.6, { PlaybackSpeed = 1.6 }),
		Paint = sound(BUILTIN.Step, "Building", 0.4, { PlaybackSpeed = 1.3 }),
		ConstructionStart = sound(DOCS.Gate, "Building", 0.35, { PlaybackSpeed = 1.4 }),
		BuildComplete = sound(DOCS.Jingle, "Building", 0.7, { PitchVariation = 0, PlaybackSpeed = 1.05 }),
		PlaceInvalid = sound(BUILTIN.Tick, "Building", 0.6, { PitchVariation = 0, PlaybackSpeed = 0.5 }),

		-- Farming
		PlantSeed = sound(BUILTIN.Step, "Farming", 0.7, { PlaybackSpeed = 1.1 }),
		Watering = sound(BUILTIN.Swim, "Farming", 0.6, { PlaybackSpeed = 1.2 }),
		Harvest = sound(BUILTIN.Hop, "Farming", 0.5, { PlaybackSpeed = 1.3 }),

		-- Fishing
		FishingCast = sound(BUILTIN.Swim, "Fishing", 0.6, { PlaybackSpeed = 1.4 }),
		FishBite = sound(BUILTIN.Splash, "Fishing", 0.6, { PlaybackSpeed = 1.3 }),
		Reel = sound(BUILTIN.Tick, "Fishing", 0.3, { PlaybackSpeed = 2 }),
		FishCatch = sound(BUILTIN.Splash, "Fishing", 0.8),
		FishEscape = sound(BUILTIN.Splash, "Fishing", 0.5, { PlaybackSpeed = 0.7 }),

		-- Animals
		Feed = sound(DOCS.Chomp, "Animals", 0.7),
		Milk = sound(BUILTIN.Swim, "Animals", 0.5, { PlaybackSpeed = 0.8 }),
		Pet = sound(DOCS.Chime, "Animals", 0.4, { PlaybackSpeed = 1.8 }),
		CowMoo = sound(PLACEHOLDER, "Animals", 0.7), -- no verified source yet
		ChickenCluck = sound(PLACEHOLDER, "Animals", 0.6), -- no verified source yet

		-- Crafting
		CraftHit = sound(BUILTIN.Thud, "Building", 0.7, { PlaybackSpeed = 1.3 }),
		CraftComplete = sound(DOCS.Chime, "Rewards", 0.7),

		-- Social
		TradeInvite = sound(DOCS.Chime, "UI", 0.6, { PlaybackSpeed = 1.1 }),
		TradeComplete = sound(DOCS.Jingle, "Rewards", 0.7, { PlaybackSpeed = 1.15 }),
		Like = sound(DOCS.Chime, "UI", 0.6, { PlaybackSpeed = 1.6 }),

		-- Music + ambience (looped, 2D; AudioController keeps one of each playing)
		MusicMain = sound(DOCS.Music, "Music", 0.35, { Looped = true, PitchVariation = 0 }),
		AmbienceOcean = sound(DOCS.WaterAmbience, "Environment", 0.25, { Looped = true, PitchVariation = 0, PlaybackSpeed = 0.8 }),
		AmbienceRain = sound(DOCS.Rain, "Environment", 0.3, { Looped = true, PitchVariation = 0 }),
		AmbienceBirds = sound(PLACEHOLDER, "Environment", 0.3, { Looped = true, PitchVariation = 0 }),
	},
}

return TableUtil.DeepFreeze(SoundConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">ToolConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/ToolConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Every tool in the game. Tools are generated from TYPES x TIERS so adding a
	new tier (or a new tool type) is one table entry.

	Tool ID format: <Tier><Type>, e.g. "WoodenAxe", "IronPickaxe".

	Stats:
		Power         how much "damage" one hit does to a tree/rock (Phase 2)
		Speed         use-speed multiplier (animation + cooldown)
		ResourceBonus chance (0..1) for +1 extra resource per drop
		UnlockLevel   player level required to buy/craft (Phase 7/8)
		Price         coin price in the shop (Phase 7)

	Visuals:
		Grip.Hand     R15 hand the tool attaches to ("RightHand" or "LeftHand")
		Grip.Offset   extra CFrame applied on top of the hand's grip attachment
		Shape         procedural placeholder model (see Server/Tools/ToolModelFactory)
		If ServerStorage/Tools/<ToolId> exists (a Model with a "Handle" part and
		a "Grip" Attachment), that art is used instead of the placeholder shape.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local ToolConfig = {
	HotbarSize = 9,

	Tiers = {
		Wooden = { Order = 1, DisplayName = "Wooden", Power = 1, Speed = 1.0, ResourceBonus = 0, UnlockLevel = 1, Price = 0, HeadColor = Color3.fromRGB(165, 115, 65), HeadMaterial = Enum.Material.Wood },
		Stone = { Order = 2, DisplayName = "Stone", Power = 2, Speed = 1.1, ResourceBonus = 0.05, UnlockLevel = 3, Price = 250, HeadColor = Color3.fromRGB(140, 140, 145), HeadMaterial = Enum.Material.Slate },
		Iron = { Order = 3, DisplayName = "Iron", Power = 3, Speed = 1.2, ResourceBonus = 0.1, UnlockLevel = 8, Price = 1500, HeadColor = Color3.fromRGB(205, 205, 215), HeadMaterial = Enum.Material.Metal },
		Gold = { Order = 4, DisplayName = "Gold", Power = 4, Speed = 1.35, ResourceBonus = 0.15, UnlockLevel = 15, Price = 8000, HeadColor = Color3.fromRGB(255, 200, 50), HeadMaterial = Enum.Material.Metal },
		Crystal = { Order = 5, DisplayName = "Crystal", Power = 6, Speed = 1.5, ResourceBonus = 0.22, UnlockLevel = 25, Price = 40000, HeadColor = Color3.fromRGB(120, 220, 255), HeadMaterial = Enum.Material.Glass },
		Mythic = { Order = 6, DisplayName = "Mythic", Power = 9, Speed = 1.7, ResourceBonus = 0.3, UnlockLevel = 40, Price = 250000, HeadColor = Color3.fromRGB(190, 90, 255), HeadMaterial = Enum.Material.Neon },
	},

	Types = {
		Axe = {
			DisplayName = "Axe",
			Icon = "🪓",
			Shape = "Axe",
			Tiers = { "Wooden", "Stone", "Iron", "Gold", "Crystal", "Mythic" },
			UseCooldown = 0.7,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "AxeIdle", Use = "AxeSwing", Heavy = "AxeHeavySwing" },
			Sounds = { Use = "AxeSwing" },
			Description = "Chops trees for wood.",
		},
		Pickaxe = {
			DisplayName = "Pickaxe",
			Icon = "⛏️",
			Shape = "Pickaxe",
			Tiers = { "Wooden", "Stone", "Iron", "Gold", "Crystal", "Mythic" },
			UseCooldown = 0.75,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "PickaxeIdle", Use = "PickaxeSwing", Heavy = "PickaxeHeavySwing" },
			Sounds = { Use = "PickaxeSwing" },
			Description = "Mines rocks and ore.",
		},
		Hammer = {
			DisplayName = "Hammer",
			Icon = "🔨",
			Shape = "Hammer",
			Tiers = { "Wooden", "Stone", "Iron", "Gold" },
			UseCooldown = 0.65,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "BuildIdle", Use = "HammerSwing", Heavy = "HammerHeavy" },
			Sounds = { Use = "HammerSwing" },
			Description = "Builds and upgrades structures faster.",
		},
		Shovel = {
			DisplayName = "Shovel",
			Icon = "🪏",
			Shape = "Shovel",
			Tiers = { "Wooden", "Stone", "Iron", "Gold" },
			UseCooldown = 0.8,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "ToolHoldIdle", Use = "ShovelDig", Heavy = "ShovelDigHeavy" },
			Sounds = { Use = "ShovelDig" },
			Description = "Digs clay, sand and buried treasure.",
		},
		Hoe = {
			DisplayName = "Hoe",
			Icon = "🌱",
			Shape = "Hoe",
			Tiers = { "Wooden", "Stone", "Iron", "Gold" },
			UseCooldown = 0.7,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "ToolHoldIdle", Use = "HoeTill" },
			Sounds = { Use = "HoeTill" },
			Description = "Tills soil so seeds can be planted.",
		},
		WateringCan = {
			DisplayName = "Watering Can",
			Icon = "🚿",
			Shape = "WateringCan",
			Tiers = { "Wooden", "Iron", "Gold" },
			UseCooldown = 1.0,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "ToolHoldIdle", Use = "WaterPlant", Loop = "WaterLoop", End = "WaterEnd" },
			Sounds = { Use = "Watering" },
			Description = "Waters crops so they grow faster.",
		},
		FishingRod = {
			DisplayName = "Fishing Rod",
			Icon = "🎣",
			Shape = "FishingRod",
			Tiers = { "Wooden", "Iron", "Gold", "Crystal", "Mythic" },
			UseCooldown = 1.2,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "FishingIdle", Use = "FishingCast", Reel = "FishingReel" },
			Sounds = { Use = "FishingCast" },
			Description = "Cast into water to catch fish.",
		},
		Bucket = {
			DisplayName = "Bucket",
			Icon = "🪣",
			Shape = "Bucket",
			Tiers = { "Wooden", "Iron" },
			UseCooldown = 1.0,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "CarryBucket", Use = "BucketSwing" },
			Sounds = { Use = "Milk" },
			Description = "Carries water and collects milk.",
		},
		Shears = {
			DisplayName = "Shears",
			Icon = "✂️",
			Shape = "Shears",
			Tiers = { "Iron", "Gold" },
			UseCooldown = 1.0,
			Grip = { Hand = "RightHand", Offset = CFrame.new() },
			Animations = { Idle = "ToolHoldIdle", Use = "ShearsSnip" },
			Sounds = { Use = "Shears" },
			Description = "Shears wool from happy sheep.",
		},
	},

	Tools = {} :: { [string]: any },
}

-- Generate the flat Tools table.
for typeId, typeDef in ToolConfig.Types do
	for _, tierId in typeDef.Tiers do
		local tier = ToolConfig.Tiers[tierId]
		assert(tier, ("Tool type %s references unknown tier %s"):format(typeId, tierId))
		local toolId = tierId .. typeId
		ToolConfig.Tools[toolId] = {
			Id = toolId,
			Type = typeId,
			Tier = tierId,
			TierOrder = tier.Order,
			DisplayName = tier.DisplayName .. " " .. typeDef.DisplayName,
			Icon = typeDef.Icon,
			Description = typeDef.Description,
			Shape = typeDef.Shape,
			Power = tier.Power,
			Speed = tier.Speed,
			ResourceBonus = tier.ResourceBonus,
			UnlockLevel = tier.UnlockLevel,
			Price = tier.Price,
			UseCooldown = typeDef.UseCooldown / tier.Speed,
			Grip = typeDef.Grip,
			Animations = typeDef.Animations,
			Sounds = typeDef.Sounds,
			HeadColor = tier.HeadColor,
			HeadMaterial = tier.HeadMaterial,
		}
	end
end

function ToolConfig.Get(toolId: any)
	if type(toolId) ~= "string" then
		return nil
	end
	return ToolConfig.Tools[toolId]
end

return TableUtil.DeepFreeze(ToolConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">VFXConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  VFXConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/VFXConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Procedural effects played by the client VFXController. These use Roblox's
	built-in default particle texture and plain parts, so they work with NO
	uploaded assets. To use custom art, set Texture to a real image id.

	Types:
		Burst   one-shot particle emission (pooled emitters)
		Ring    an expanding, fading neon ring (pooled parts)
		Puff    cartoon dust clouds: soft balls that swell and fade
		Debris  chunks that fly out, bounce on the ground, shrink away
		        (rock shatter; `Confetti = true` = colourful paper bits)
		Pop     a quick neon flash sphere (impact "pow")
		Jiggle  squash / tilt / pop the TARGET model (options.Target)
	Effects can take options from the server: { Color, Count, Scale,
	Target, Style, From }.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local VFXConfig = {
	MaxDistance = 250, -- clients skip effects farther than this from the camera

	Effects = {
		Sparkle = { Type = "Burst", Count = 14, Color = Color3.fromRGB(255, 240, 150), Size = 0.5, Lifetime = 0.8, Speed = 8, Spread = 180, LightEmission = 1 },
		CoinBurst = { Type = "Burst", Count = 12, Color = Color3.fromRGB(255, 205, 50), Size = 0.6, Lifetime = 0.7, Speed = 14, Spread = 60, LightEmission = 0.6, Acceleration = Vector3.new(0, -30, 0) },
		ChestOpen = { Type = "Burst", Count = 24, Color = Color3.fromRGB(255, 225, 120), Size = 0.6, Lifetime = 1, Speed = 16, Spread = 45, LightEmission = 1 },
		LevelUp = { Type = "Ring", Color = Color3.fromRGB(120, 255, 170), StartSize = 2, EndSize = 18, Duration = 0.8, Height = 0.4 },
		IslandLevelUp = { Type = "Ring", Color = Color3.fromRGB(255, 220, 90), StartSize = 4, EndSize = 40, Duration = 1.2, Height = 0.6 },
		AreaUnlock = { Type = "Ring", Color = Color3.fromRGB(120, 230, 255), StartSize = 10, EndSize = 140, Duration = 2, Height = 1 },
		DirtPuff = { Type = "Burst", Count = 8, Color = Color3.fromRGB(140, 100, 60), Size = 0.7, Lifetime = 0.6, Speed = 6, Spread = 70, LightEmission = 0 },
		BuildDust = { Type = "Burst", Count = 10, Color = Color3.fromRGB(220, 200, 170), Size = 0.9, Lifetime = 0.8, Speed = 5, Spread = 90, LightEmission = 0 },
		BuildComplete = { Type = "Burst", Count = 28, Color = Color3.fromRGB(255, 250, 200), Size = 0.7, Lifetime = 1.2, Speed = 14, Spread = 180, LightEmission = 1 },
		WoodChips = { Type = "Burst", Count = 7, Color = Color3.fromRGB(190, 140, 80), Size = 0.4, Lifetime = 0.6, Speed = 12, Spread = 50, LightEmission = 0, Acceleration = Vector3.new(0, -40, 0) },
		RockChips = { Type = "Burst", Count = 7, Color = Color3.fromRGB(150, 150, 155), Size = 0.4, Lifetime = 0.6, Speed = 12, Spread = 50, LightEmission = 0, Acceleration = Vector3.new(0, -40, 0) },
		LeafBurst = { Type = "Burst", Count = 10, Color = Color3.fromRGB(110, 200, 80), Size = 0.5, Lifetime = 0.9, Speed = 7, Spread = 120, LightEmission = 0 },
		WaterSplash = { Type = "Burst", Count = 12, Color = Color3.fromRGB(170, 225, 255), Size = 0.5, Lifetime = 0.6, Speed = 12, Spread = 35, LightEmission = 0.3, Acceleration = Vector3.new(0, -50, 0) },
		MilkSplash = { Type = "Burst", Count = 8, Color = Color3.fromRGB(255, 255, 250), Size = 0.4, Lifetime = 0.5, Speed = 6, Spread = 30, LightEmission = 0.2, Acceleration = Vector3.new(0, -40, 0) },
		Hearts = { Type = "Burst", Count = 5, Color = Color3.fromRGB(255, 110, 150), Size = 0.6, Lifetime = 1.1, Speed = 4, Spread = 30, LightEmission = 0.5, Acceleration = Vector3.new(0, 3, 0) },

		-- Cartoon juice
		HitRing = { Type = "Ring", Color = Color3.fromRGB(255, 255, 255), StartSize = 1, EndSize = 7, Duration = 0.22, Height = 0.15 },
		Stars = { Type = "Burst", Count = 6, Color = Color3.fromRGB(255, 232, 90), Size = 0.8, Lifetime = 0.55, Speed = 18, Spread = 180, LightEmission = 1 },
		HitPop = { Type = "Pop", Color = Color3.fromRGB(255, 250, 220), StartSize = 0.6, EndSize = 3.2, Duration = 0.16 },
		Puff = { Type = "Puff", Count = 6, Color = Color3.fromRGB(236, 226, 206), Size = 2.4, Radius = 3.5, Duration = 0.9 },
		BigPuff = { Type = "Puff", Count = 11, Color = Color3.fromRGB(232, 222, 200), Size = 4, Radius = 7, Duration = 1.2 },
		RockShatter = { Type = "Debris", Count = 11, Color = Color3.fromRGB(150, 150, 155), Size = 1.2, Speed = 24, Duration = 1.6 },
		WoodSplinters = { Type = "Debris", Count = 6, Color = Color3.fromRGB(176, 124, 72), Size = 0.6, Speed = 16, Duration = 1.1 },
		Confetti = { Type = "Debris", Count = 26, Color = Color3.fromRGB(255, 255, 255), Size = 0.5, Speed = 30, Duration = 2.2, Confetti = true },
		Jiggle = { Type = "Jiggle" },
	},
}

return TableUtil.DeepFreeze(VFXConfig)
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Net
	SCRIPT TYPE:  ModuleScript (shared networking layer)
	WHERE:        ReplicatedStorage/Shared/Net
	DEPENDENCIES: Shared.Config.RemoteConfig, Shared.Util.RateLimiter
	REQUIRED OBJECTS: none (the server creates ReplicatedStorage/Remotes)

	The only module allowed to touch RemoteEvents.
	  * Server: Net.Init() creates every remote listed in RemoteConfig.
	  * Unknown remote names error immediately (no random remote creation).
	  * Every client->server handler is automatically rate limited and wrapped
	    in pcall; violations are reported to AntiExploitService.
	  * After all services start, Net.FinalizeHandlers() drains remotes that no
	    phase handles yet, flagging clients that fire them.

	Server API:  Net.Init(), Net.OnServerEvent(name, fn(player, ...)),
	             Net.FireClient(name, player, ...), Net.FireAllClients(name, ...),
	             Net.FireClients(name, players, ...), Net.SetViolationHandler(fn),
	             Net.FinalizeHandlers()
	Client API:  Net.FireServer(name, ...), Net.OnClientEvent(name, fn(...))
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RemoteConfig = require(script.Parent.Config.RemoteConfig)
local RateLimiter = require(script.Parent.Util.RateLimiter)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"
local CLIENT_WAIT_TIMEOUT = 60

type ViolationHandler = (player: Player, reason: string, weight: number) -> ()

local Net = {}

local folder: Folder? = nil
local remotes: { [string]: RemoteEvent } = {}
local handledOnServer: { [string]: boolean } = {}
local violationHandler: ViolationHandler? = nil

local function reportViolation(player: Player, reason: string, weight: number)
	if violationHandler then
		violationHandler(player, reason, weight)
	end
end

local function getRemote(name: string): RemoteEvent
	local cached = remotes[name]
	if cached then
		return cached
	end
	assert(RemoteConfig.Known[name], ("[Net] Unknown remote '%s' — add it to RemoteConfig"):format(tostring(name)))

	if IS_SERVER then
		assert(folder, "[Net] Net.Init() must run on the server before remotes are used")
		local remote = folder:FindFirstChild(name)
		assert(remote and remote:IsA("RemoteEvent"), "[Net] Remote missing: " .. name)
		remotes[name] = remote
		return remote
	end

	if not folder then
		local found = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_WAIT_TIMEOUT)
		assert(found and found:IsA("Folder"), "[Net] ReplicatedStorage.Remotes never appeared (is the server running?)")
		folder = found
	end
	assert(folder)
	local remote = folder:WaitForChild(name, CLIENT_WAIT_TIMEOUT)
	assert(remote and remote:IsA("RemoteEvent"), "[Net] Remote missing on client: " .. name)
	remotes[name] = remote
	return remote
end

-- SERVER -------------------------------------------------------------------

function Net.Init()
	assert(IS_SERVER, "Net.Init is server-only")
	if folder then
		return
	end
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		warn("[Net] Replacing an existing ReplicatedStorage.Remotes folder")
		existing:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = FOLDER_NAME
	for name in RemoteConfig.Known do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = newFolder
	end
	newFolder.Parent = ReplicatedStorage
	folder = newFolder
end

function Net.SetViolationHandler(handler: ViolationHandler)
	violationHandler = handler
end

function Net.OnServerEvent(name: string, handler: (player: Player, ...any) -> ())
	assert(IS_SERVER, "OnServerEvent is server-only")
	assert(RemoteConfig.Known[name] == "ClientToServer", ("[Net] %s is not a client->server remote"):format(name))
	assert(not handledOnServer[name], ("[Net] %s already has a server handler (one owner per remote)"):format(name))
	handledOnServer[name] = true

	local limits = RemoteConfig.RateLimits[name] or RemoteConfig.DefaultRateLimit
	local limiter = RateLimiter.new(limits.Rate, limits.Burst)

	getRemote(name).OnServerEvent:Connect(function(player: Player, ...)
		if not limiter:Check(player) then
			reportViolation(player, "RateLimit:" .. name, 1)
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

-- Any client->server remote nobody handles yet (future phases) is drained so
-- the engine queue never fills, and firing it is treated as suspicious.
function Net.FinalizeHandlers()
	assert(IS_SERVER, "FinalizeHandlers is server-only")
	for _, name in RemoteConfig.ClientToServer do
		if not handledOnServer[name] then
			handledOnServer[name] = true
			getRemote(name).OnServerEvent:Connect(function(player: Player)
				reportViolation(player, "UnhandledRemote:" .. name, 2)
			end)
		end
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER, "FireClient is server-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	if player.Parent then
		getRemote(name):FireClient(player, ...)
	end
end

function Net.FireClients(name: string, players: { Player }, ...: any)
	for _, player in players do
		Net.FireClient(name, player, ...)
	end
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER, "FireAllClients is server-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	getRemote(name):FireAllClients(...)
end

-- CLIENT -------------------------------------------------------------------

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER, "FireServer is client-only")
	assert(RemoteConfig.Known[name] == "ClientToServer", ("[Net] %s is not a client->server remote"):format(name))
	getRemote(name):FireServer(...)
end

function Net.OnClientEvent(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "OnClientEvent is client-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">AnimalMath</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  AnimalMath
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/AnimalMath
	DEPENDENCIES: Shared.Config.AnimalConfig

	Animal care computed lazily from timestamps (spec §101, §114): no
	per-animal loops, offline time handled naturally, and the client shows
	exactly what the server will decide.

	Saved animal entry:
		{ AnimalId, UniqueId, Variant, HousingId, Happiness, HappinessAt,
		  FedAt, ProduceReadyAt, PettedAt }
]]

local AnimalConfig = require(script.Parent.Parent.Config.AnimalConfig)

local AnimalMath = {}

export type Entry = {
	AnimalId: string,
	Happiness: number,
	HappinessAt: number?,
	FedAt: number?,
	ProduceReadyAt: number?,
	PettedAt: number?,
}

local FULL_SECONDS = AnimalConfig.FullnessDurationMinutes * 60

function AnimalMath.GetFullness(entry: Entry, now: number): number
	local fedAt = entry.FedAt or 0
	if fedAt <= 0 then
		return 0
	end
	return math.clamp(100 - (now - fedAt) / FULL_SECONDS * 100, 0, 100)
end

function AnimalMath.GetHappiness(entry: Entry, now: number): number
	local base = math.clamp(entry.Happiness or AnimalConfig.StartHappiness, 0, 100)
	local since = entry.HappinessAt or now
	local fedAt = entry.FedAt or 0
	-- Happiness only drains once the animal is hungry.
	local hungrySince = if fedAt > 0 then fedAt + FULL_SECONDS * (1 - AnimalConfig.HungryBelow / 100) else since
	local decayFrom = math.max(since, hungrySince)
	if now <= decayFrom or base <= AnimalConfig.HappinessFloor then
		return base
	end
	local decayed = base - (now - decayFrom) / 60 * AnimalConfig.HappinessDecayPerMinute
	return math.max(AnimalConfig.HappinessFloor, decayed)
end

-- "Ready" (product waiting), "Producing", or "Hungry" (feed to start the next batch).
function AnimalMath.GetStatus(entry: Entry, now: number): string
	local readyAt = entry.ProduceReadyAt or 0
	if readyAt > 0 then
		return if now >= readyAt then "Ready" else "Producing"
	end
	return "Hungry"
end

-- Happier animals produce faster (1.0x at 100%, 1.4x slower at 0%).
function AnimalMath.ProduceDuration(animalId: string, happiness: number): number
	local def = AnimalConfig.Animals[animalId]
	if not def then
		return 60
	end
	return def.ProduceTime * (1.4 - 0.4 * math.clamp(happiness, 0, 100) / 100)
end

return AnimalMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">AssetId</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  AssetId
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/AssetId
	DEPENDENCIES: none

	Some asset slots have no verified asset yet and use the literal
	"rbxassetid://PLACEHOLDER". Systems call AssetId.IsPlaceholder() and
	skip / fall back instead of erroring. Built-in "rbxasset://" paths and
	real "rbxassetid://<number>" ids are never placeholders.
]]

local AssetId = {}

AssetId.PLACEHOLDER = "rbxassetid://PLACEHOLDER"

function AssetId.IsPlaceholder(id: string?): boolean
	if id == nil or id == "" then
		return true
	end
	if string.find(id, "PLACEHOLDER", 1, true) then
		return true
	end
	return id == "rbxassetid://0"
end

return AssetId
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CropGrowth</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  CropGrowth
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/CropGrowth
	DEPENDENCIES: Shared.Config.CropConfig

	Pure crop growth math from timestamps. Used by the server (authoritative
	stages, offline growth) and the client (countdown labels) so both agree.

	A planted tile entry looks like:
		{ CropId = "Wheat", PlantedAt = <unix>, WateredAt = <unix or 0> }
]]

local CropConfig = require(script.Parent.Parent.Config.CropConfig)

local CropGrowth = {}

export type Entry = { CropId: string?, PlantedAt: number?, WateredAt: number? }

-- 0..1 growth progress.
function CropGrowth.GetProgress(entry: Entry, now: number): number
	local crop = entry.CropId and CropConfig.Crops[entry.CropId]
	local planted = entry.PlantedAt
	if not crop or type(planted) ~= "number" then
		return 0
	end
	local watered = entry.WateredAt or 0
	local multiplier = CropConfig.WaterSpeedMultiplier
	local effective: number
	if watered > 0 and watered >= planted then
		effective = math.min(watered, now) - planted + math.max(0, now - watered) * multiplier
	else
		effective = now - planted
	end
	return math.clamp(effective / crop.GrowTime, 0, 1)
end

-- 1..6 (6 = Harvestable). Stage names are CropConfig.Stages.
function CropGrowth.GetStage(entry: Entry, now: number): number
	local progress = CropGrowth.GetProgress(entry, now)
	if progress >= 1 then
		return #CropConfig.Stages
	end
	return math.clamp(math.floor(progress * (#CropConfig.Stages - 1)) + 1, 1, #CropConfig.Stages - 1)
end

-- Seconds until harvestable at the current growth speed.
function CropGrowth.GetRemaining(entry: Entry, now: number): number
	local crop = entry.CropId and CropConfig.Crops[entry.CropId]
	if not crop then
		return 0
	end
	local progress = CropGrowth.GetProgress(entry, now)
	local rate = if (entry.WateredAt or 0) > 0 then CropConfig.WaterSpeedMultiplier else 1
	return math.max(0, crop.GrowTime * (1 - progress) / rate)
end

function CropGrowth.IsWatered(entry: Entry): boolean
	return (entry.WateredAt or 0) > 0
end

return CropGrowth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Format
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Format
	DEPENDENCIES: none

	Number / time formatting for UI.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa" }

function Format.Commas(value: number): string
	local text = tostring(math.floor(value))
	local negative = string.sub(text, 1, 1) == "-"
	if negative then
		text = string.sub(text, 2)
	end
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then
		formatted = string.sub(formatted, 2)
	end
	return (negative and "-" or "") .. formatted
end

-- 999 -> "999", 12_345 -> "12.3K", 4_500_000 -> "4.5M"
function Format.Abbreviate(value: number): string
	local absolute = math.abs(value)
	if absolute < 10_000 then
		return Format.Commas(value)
	end
	local tier = math.min(math.floor(math.log10(absolute) / 3), #SUFFIXES - 1)
	local scaled = value / 10 ^ (tier * 3)
	local text = string.format("%.1f", scaled)
	text = string.gsub(text, "%.0$", "")
	return text .. SUFFIXES[tier + 1]
end

function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">IslandGen</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  IslandGen
	SCRIPT TYPE:  ModuleScript (shared utility, pure math)
	WHERE:        ReplicatedStorage/Shared/Util/IslandGen
	DEPENDENCIES: Shared.Config.{IslandConfig, ResourceConfig}

	Deterministic island generation from saved data:
		{ Seed, Theme, Shape, Chunks = { ["cx_cz"] = true }, Paint = { ["px_pz"] = "Material" } }

	  * GenerateStarter  grows an organic, connected starter shape from the
	                     centre by priority (shape field + seeded noise).
	  * Sampler          height, surface material and distance-to-coast at
	                     any island-local point: smooth beaches, wobbly
	                     coastline (rounded by an outward offset + noise),
	                     theme hills, a flat build plaza, painted cells.
	  * NodeSpots        where trees / rocks / bushes grow for every chunk.
	  * Expansion        which chunks can be bought next and their price.

	Used by the server (terrain writer, validation, spawning) and the client
	(build preview, expansion outlines, creator preview) so both agree.
]]

local Config = script.Parent.Parent.Config
local IslandConfig = require(Config.IslandConfig)

local IslandGen = {}

local C = IslandConfig.ChunkSize
local R = IslandConfig.GridRadius
local HALF = C / 2
local SEARCH = 3 -- chunks searched around a point for the coast
local OUTWARD = 6 -- land extends this far past owned chunk edges (rounds convex corners)

export type IslandData = {
	Seed: number,
	Theme: string,
	Shape: string?,
	Chunks: { [string]: boolean },
	Paint: { [string]: string }?,
}

export type Sample = {
	Height: number, -- studs above sea level
	Material: string, -- Enum.Material name
	Shore: number, -- > 0 on land (noisy distance inland from the waterline)
	Coast: number, -- raw distance to the edge of owned chunks (negative in water)
	Owned: boolean, -- inside an owned chunk
}

---------------------------------------------------------------------------
-- Keys
---------------------------------------------------------------------------

function IslandGen.Key(cx: number, cz: number): string
	return cx .. "_" .. cz
end

function IslandGen.ParseKey(key: string): (number?, number?)
	local a, b = string.match(key, "^(%-?%d+)_(%-?%d+)$")
	if not a or not b then
		return nil, nil
	end
	return tonumber(a), tonumber(b)
end

-- Chunk containing an island-local XZ point.
function IslandGen.ChunkOf(x: number, z: number): (number, number)
	return math.floor(x / C + 0.5), math.floor(z / C + 0.5)
end

function IslandGen.ChunkCenter(cx: number, cz: number): Vector2
	return Vector2.new(cx * C, cz * C)
end

function IslandGen.InGrid(cx: number, cz: number): boolean
	return math.abs(cx) <= R and math.abs(cz) <= R
end

local function intKey(cx: number, cz: number): number
	return (cx + 64) * 256 + (cz + 64)
end

function IslandGen.CountChunks(chunks: { [string]: boolean }): number
	local count = 0
	for _, owned in chunks do
		if owned then
			count += 1
		end
	end
	return count
end

---------------------------------------------------------------------------
-- Noise helpers (math.noise is Perlin, ~[-0.5, 0.5]; offsets keep it off integer lattice points)
---------------------------------------------------------------------------

local function seedOffset(seed: number, salt: number): number
	return ((seed * 0.6180339887 + salt * 13.37) % 997) + 0.31
end

local function noise(x: number, z: number, scale: number, seed: number, salt: number): number
	return math.noise(x / scale + 0.123, z / scale + 0.457, seedOffset(seed, salt))
end

local function smoothstep(edge0: number, edge1: number, value: number): number
	local t = math.clamp((value - edge0) / (edge1 - edge0), 0, 1)
	return t * t * (3 - 2 * t)
end

---------------------------------------------------------------------------
-- Starter shape
---------------------------------------------------------------------------

local SHAPE_FIELDS: { [string]: (x: number, z: number) -> number } = {
	Round = function(x, z)
		return -math.sqrt(x * x + z * z)
	end,
	Crescent = function(x, z)
		local r = math.sqrt(x * x + z * z)
		local bite = math.sqrt(x * x + (z + 4.2) ^ 2)
		return -math.abs(r - 3.8) * 1.4 - math.max(0, 3.8 - bite) * 3
	end,
	Twin = function(x, z)
		local a = math.sqrt((x - 4.6) ^ 2 + z * z)
		local b = math.sqrt((x + 4.6) ^ 2 + z * z)
		return -math.min(a, b) * 1.6 - math.abs(z) * 0.8
	end,
	Long = function(x, z)
		return -(math.abs(x) * 0.45 + math.abs(z) * 2.2)
	end,
	Wild = function(x, z)
		return -math.sqrt(x * x + z * z) * 0.55
	end,
}

-- Grows a connected chunk set from the centre. Deterministic for (seed, shape, count).
function IslandGen.GenerateStarter(seed: number, shape: string, count: number?): { [string]: boolean }
	local target = count or IslandConfig.StarterChunks
	local field = SHAPE_FIELDS[shape] or SHAPE_FIELDS.Round
	local wild = if shape == "Wild" then 3.2 else 1.3
	local chunks: { [string]: boolean } = {}
	local frontier: { [string]: { X: number, Z: number, Score: number } } = {}
	local owned = 0

	local function score(cx: number, cz: number): number
		return field(cx, cz) + noise(cx * 7.1, cz * 7.1, 9, seed, 1) * wild * 2
	end
	local function add(cx: number, cz: number)
		local key = IslandGen.Key(cx, cz)
		if chunks[key] or not IslandGen.InGrid(cx, cz) then
			return
		end
		chunks[key] = true
		frontier[key] = nil
		owned += 1
		for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local nx, nz = cx + offset[1], cz + offset[2]
			local nkey = IslandGen.Key(nx, nz)
			if not chunks[nkey] and not frontier[nkey] and IslandGen.InGrid(nx, nz) then
				frontier[nkey] = { X = nx, Z = nz, Score = score(nx, nz) }
			end
		end
	end

	-- The plaza is always land so spawn + landmarks fit on every shape.
	local plaza = math.ceil(IslandConfig.PlazaRadius)
	for cx = -plaza, plaza do
		for cz = -plaza, plaza do
			if math.sqrt(cx * cx + cz * cz) <= IslandConfig.PlazaRadius then
				add(cx, cz)
			end
		end
	end

	while owned < target do
		local bestKey, best = nil, nil
		for key, cell in frontier do
			if best == nil or cell.Score > best.Score or (cell.Score == best.Score and key < (bestKey :: string)) then
				bestKey, best = key, cell
			end
		end
		if not best then
			break
		end
		add(best.X, best.Z)
	end

	-- Fill pockets: water cells mostly surrounded by land become land.
	local changed = true
	while changed do
		changed = false
		for key, cell in table.clone(frontier) do
			local neighbours = 0
			for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
				if chunks[IslandGen.Key(cell.X + offset[1], cell.Z + offset[2])] then
					neighbours += 1
				end
			end
			if neighbours >= 3 and frontier[key] then
				add(cell.X, cell.Z)
				changed = true
			end
		end
	end
	return chunks
end

---------------------------------------------------------------------------
-- Sampler
---------------------------------------------------------------------------

export type Sampler = {
	Data: IslandData,
	Theme: any,
	Owned: { [number]: boolean },
	Sample: (self: Sampler, x: number, z: number) -> Sample,
	IsOwnedChunk: (self: Sampler, cx: number, cz: number) -> boolean,
}

local SamplerClass = {}
SamplerClass.__index = SamplerClass

function IslandGen.NewSampler(data: IslandData): Sampler
	local owned: { [number]: boolean } = {}
	for key, value in data.Chunks do
		if value then
			local cx, cz = IslandGen.ParseKey(key)
			if cx and cz and IslandGen.InGrid(cx, cz) then
				owned[intKey(cx, cz)] = true
			end
		end
	end
	local theme = IslandConfig.Themes[data.Theme] or IslandConfig.Themes[IslandConfig.DefaultTheme]
	return setmetatable({ Data = data, Theme = theme, Owned = owned }, SamplerClass) :: any
end

function SamplerClass.IsOwnedChunk(self: Sampler, cx: number, cz: number): boolean
	return self.Owned[intKey(cx, cz)] == true
end

-- Signed distance (studs) from (x, z) to the edge of the owned-chunk union.
local function coastDistance(sampler: Sampler, x: number, z: number): (number, boolean)
	local cx, cz = IslandGen.ChunkOf(x, z)
	local inside = sampler.Owned[intKey(cx, cz)] == true
	local best = SEARCH * C
	for i = cx - SEARCH, cx + SEARCH do
		for j = cz - SEARCH, cz + SEARCH do
			local isOwned = sampler.Owned[intKey(i, j)] == true
			if isOwned ~= inside then
				local dx = math.max(math.abs(x - i * C) - HALF, 0)
				local dz = math.max(math.abs(z - j * C) - HALF, 0)
				local distance = math.sqrt(dx * dx + dz * dz)
				if distance < best then
					best = distance
				end
			end
		end
	end
	return if inside then best else -best, inside
end

function SamplerClass.Sample(self: Sampler, x: number, z: number): Sample
	local data = self.Data
	local theme = self.Theme
	local seed = data.Seed
	local coast, owned = coastDistance(self, x, z)
	local shore = coast + OUTWARD + noise(x, z, 22, seed, 2) * IslandConfig.CoastNoise * 2

	local height: number
	local beach = IslandConfig.BeachWidth
	if shore <= 0 then
		height = -1 - math.min(13, -shore * 0.55)
	elseif shore < beach then
		height = -1 + (IslandConfig.LandHeight + 1) * smoothstep(0, beach, shore)
	else
		local centerDistance = math.sqrt(x * x + z * z)
		local flatten = smoothstep(IslandConfig.FlattenRadius, IslandConfig.FlattenRadius + 24, centerDistance)
		local inland = smoothstep(beach, beach + 26, shore)
		local hillNoise = math.clamp(noise(x, z, 64, seed, 3) * 1.7 + 0.2, 0, 1)
		local bumps = noise(x, z, 17, seed, 4) * 0.8
		height = IslandConfig.LandHeight + (theme.HillAmp * hillNoise + bumps) * inland * flatten
	end

	local material: string
	if height < 0.3 then
		material = if shore > 0 then theme.Beach else theme.Seabed
	elseif shore < beach - 1 then
		material = theme.Beach
	else
		local lift = height - IslandConfig.LandHeight
		if lift > theme.HillAmp * 0.62 and noise(x, z, 11, seed, 5) > -0.05 then
			material = theme.Cliff
		elseif noise(x, z, 26, seed, 6) > 0.22 then
			material = theme.Alt
		else
			material = theme.Ground
		end
		local paint = data.Paint
		if paint then
			local cell = IslandConfig.PaintCellSize
			local painted = paint[math.floor(x / cell) .. "_" .. math.floor(z / cell)]
			if painted and IslandConfig.Paint[painted] then
				material = painted
			end
		end
	end

	return { Height = height, Material = material, Shore = shore, Coast = coast, Owned = owned }
end

-- Can a building footprint point go here? (owned land, far enough from the water)
function IslandGen.IsBuildable(sampler: Sampler, x: number, z: number): boolean
	local cx, cz = IslandGen.ChunkOf(x, z)
	if not sampler:IsOwnedChunk(cx, cz) then
		return false
	end
	local sample = sampler:Sample(x, z)
	return sample.Coast >= IslandConfig.BuildCoastDistance and sample.Height > 0.8
end

-- Is this point (roughly) water next to this island? Used by fishing.
function IslandGen.IsWater(sampler: Sampler, x: number, z: number): boolean
	return sampler:Sample(x, z).Height < -0.4
end

---------------------------------------------------------------------------
-- Resources
---------------------------------------------------------------------------

export type Spot = { Id: string, Type: string, Position: Vector2, Yaw: number }

local function seedFor(seed: number, text: string): number
	local value = seed % 2147483647
	for index = 1, #text do
		value = (value * 31 + string.byte(text, index)) % 2147483647
	end
	return value
end

local function weightedPick(random: Random, weights: { [string]: number }): string?
	local names = {}
	local total = 0
	for name, weight in weights do
		if weight > 0 then
			table.insert(names, name)
			total += weight
		end
	end
	table.sort(names)
	if total <= 0 then
		return nil
	end
	local roll = random:NextNumber(0, total)
	for _, name in names do
		roll -= weights[name]
		if roll <= 0 then
			return name
		end
	end
	return names[#names]
end

-- Resource weights for a chunk: the theme's mix, plus rarer ores/trees far from home.
function IslandGen.ChunkWeights(themeId: string, cx: number, cz: number): { [string]: number }
	local theme = IslandConfig.Themes[themeId] or IslandConfig.Themes[IslandConfig.DefaultTheme]
	local weights = table.clone(theme.Nodes)
	local distance = math.sqrt(cx * cx + cz * cz)
	if distance >= 6 then
		weights.IronRock = (weights.IronRock or 0) + 1.2
	end
	if distance >= 9 then
		weights.CrystalRock = (weights.CrystalRock or 0) + 0.7
		weights.AncientTree = (weights.AncientTree or 0) + 0.6
	end
	return weights
end

-- Resource spots of one chunk (only those that are valid land for this island right now).
function IslandGen.ChunkSpots(sampler: Sampler, cx: number, cz: number): { Spot }
	local data = sampler.Data
	local key = IslandGen.Key(cx, cz)
	local random = Random.new(seedFor(data.Seed, key))
	local roll = random:NextNumber()
	local count = if roll < 0.3 then 0 elseif roll < 0.78 then 1 else 2
	local weights = IslandGen.ChunkWeights(data.Theme, cx, cz)
	local spots: { Spot } = {}
	local keepClear = IslandConfig.StarterLayout.KeepClearRadius
	for index = 1, count do
		local nodeType = weightedPick(random, weights)
		-- Two candidate sub-cells so the pair never overlaps.
		local offsetX = random:NextNumber(-HALF + 3, HALF - 3)
		local offsetZ = if index == 1 then random:NextNumber(-HALF + 3, -1) else random:NextNumber(1, HALF - 3)
		local position = Vector2.new(cx * C + offsetX, cz * C + offsetZ)
		local yaw = random:NextNumber(0, 360)
		if nodeType and position.Magnitude > keepClear then
			local sample = sampler:Sample(position.X, position.Y)
			if sample.Owned and sample.Height > 1.2 and sample.Coast > 2 then
				table.insert(spots, { Id = key .. "#" .. index, Type = nodeType, Position = position, Yaw = yaw })
			end
		end
	end
	return spots
end

-- Every resource spot on the island (skipping ones the owner removed).
function IslandGen.AllSpots(sampler: Sampler, removed: { [string]: boolean }?): { Spot }
	local spots = {}
	for key, value in sampler.Data.Chunks do
		if value then
			local cx, cz = IslandGen.ParseKey(key)
			if cx and cz then
				for _, spot in IslandGen.ChunkSpots(sampler, cx, cz) do
					if not (removed and removed[spot.Id]) then
						table.insert(spots, spot)
					end
				end
			end
		end
	end
	return spots
end

export type Deco = { Kind: string, Position: Vector2, Yaw: number, Scale: number }

-- Purely decorative scatter (flowers, tufts, shells...) for one chunk.
function IslandGen.ChunkDeco(sampler: Sampler, cx: number, cz: number): { Deco }
	local data = sampler.Data
	local theme = sampler.Theme
	local random = Random.new(seedFor(data.Seed, "deco" .. IslandGen.Key(cx, cz)))
	local list: { Deco } = {}
	for _ = 1, random:NextInteger(1, 3) do
		local kind = theme.Deco[random:NextInteger(1, #theme.Deco)]
		local position = Vector2.new(cx * C + random:NextNumber(-HALF, HALF), cz * C + random:NextNumber(-HALF, HALF))
		local sample = sampler:Sample(position.X, position.Y)
		local shellsOnBeach = kind == "Shells"
		local ok = if shellsOnBeach then sample.Height > 0.2 and sample.Material == theme.Beach else sample.Height > 1.5 and sample.Material ~= theme.Beach
		if ok then
			table.insert(list, { Kind = kind, Position = position, Yaw = random:NextNumber(0, 360), Scale = random:NextNumber(0.8, 1.25) })
		end
	end
	return list
end

---------------------------------------------------------------------------
-- Expansion
---------------------------------------------------------------------------

-- Water chunks touching owned land (4-neighbourhood), inside the grid.
function IslandGen.ExpansionCandidates(chunks: { [string]: boolean }): { { X: number, Z: number } }
	local result = {}
	local seen: { [string]: boolean } = {}
	for key, value in chunks do
		if value then
			local cx, cz = IslandGen.ParseKey(key)
			if cx and cz then
				for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
					local nx, nz = cx + offset[1], cz + offset[2]
					local nkey = IslandGen.Key(nx, nz)
					if not chunks[nkey] and not seen[nkey] and IslandGen.InGrid(nx, nz) then
						seen[nkey] = true
						table.insert(result, { X = nx, Z = nz })
					end
				end
			end
		end
	end
	return result
end

function IslandGen.IsAdjacent(chunks: { [string]: boolean }, cx: number, cz: number): boolean
	for _, offset in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
		if chunks[IslandGen.Key(cx + offset[1], cz + offset[2])] then
			return true
		end
	end
	return false
end

function IslandGen.ExpansionCost(ownedCount: number): number
	local expansion = IslandConfig.Expansion
	local extra = math.max(0, ownedCount - IslandConfig.StarterChunks)
	local cost = expansion.BaseCost + expansion.Linear * extra + expansion.Quadratic * extra * extra
	return math.floor(cost / 10 + 0.5) * 10
end

function IslandGen.MaxChunks(islandLevel: number): number
	local expansion = IslandConfig.Expansion
	return math.min(expansion.MaxChunks, IslandConfig.StarterChunks + expansion.BaseAllowance + math.max(0, islandLevel - 1) * expansion.ChunksPerIslandLevel)
end

return IslandGen
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">IslandLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  IslandLayout
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/IslandLayout
	DEPENDENCIES: Shared.Config.IslandConfig

	Where each server island SLOT sits in the world. Island shape, land and
	coastlines live in Shared/Util/IslandGen.
]]

local IslandConfig = require(script.Parent.Parent.Config.IslandConfig)

local IslandLayout = {}

-- World-space origin (CFrame at sea level) of server island slot `index` (1-based).
-- Slot spacing is a multiple of 4, so origins sit on the terrain voxel grid.
function IslandLayout.GetSlotOrigin(index: number): CFrame
	local zeroBased = index - 1
	local column = zeroBased % IslandConfig.SlotsPerRow
	local row = zeroBased // IslandConfig.SlotsPerRow
	local x = column * IslandConfig.SlotSpacing
	local z = row * IslandConfig.SlotSpacing
	return CFrame.new(x, IslandConfig.SeaLevel, z)
end

-- Largest distance from an island centre its land can reach.
function IslandLayout.GetMaxExtent(): number
	return (IslandConfig.GridRadius + 1.5) * IslandConfig.ChunkSize
end

return IslandLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Maid
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Maid
	DEPENDENCIES: none

	Collects connections / instances / cleanup functions and releases them
	together. Used anywhere a system owns resources tied to a lifetime
	(a character, an island, an open UI panel...).
]]

export type Maid = {
	Give: <T>(self: Maid, task: T) -> T,
	Cleanup: (self: Maid) -> (),
	Destroy: (self: Maid) -> (),
}

local Maid = {}
Maid.__index = Maid

function Maid.new(): Maid
	return (setmetatable({ _tasks = {} }, Maid) :: any) :: Maid
end

function Maid.Give(self: any, item: any): any
	table.insert(self._tasks, item)
	return item
end

local function cleanupTask(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		if coroutine.status(item) == "suspended" then
			task.cancel(item)
		end
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Maid.Cleanup(self: any)
	local tasks = self._tasks
	self._tasks = {}
	-- Clean up in reverse order of registration (LIFO), like a stack.
	for i = #tasks, 1, -1 do
		local ok, err = pcall(cleanupTask :: any, tasks[i])
		if not ok then
			warn("[Maid] cleanup error:", err)
		end
	end
end

Maid.Destroy = Maid.Cleanup

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Placement</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Placement
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Placement
	DEPENDENCIES: Shared.Config.BuildConfig, Shared.Util.IslandGen

	Build-grid math shared by the client preview and the server validator.
	All positions are ISLAND-LOCAL.
]]

local Config = script.Parent.Parent.Config
local BuildConfig = require(Config.BuildConfig)
local IslandGen = require(script.Parent.IslandGen)

local Placement = {}

function Placement.IsValidRotation(rotation: any): boolean
	return type(rotation) == "number" and table.find(BuildConfig.Rotations, rotation) ~= nil
end

-- Footprint (X, Z) after rotation.
function Placement.FootprintSize(footprint: Vector2, rotation: number): Vector2
	if rotation == 90 or rotation == 270 then
		return Vector2.new(footprint.Y, footprint.X)
	end
	return footprint
end

local function snapAxis(value: number, span: number): number
	local grid = BuildConfig.GridSize
	local cells = math.floor(span / grid + 0.5)
	if cells % 2 == 1 then
		-- Odd number of cells: centre sits in the middle of a cell.
		return math.floor(value / grid) * grid + grid / 2
	end
	return math.floor(value / grid + 0.5) * grid
end

-- Snaps an island-local XZ centre so the footprint's edges land on grid lines.
function Placement.Snap(localXZ: Vector2, size: Vector2): Vector2
	return Vector2.new(snapAxis(localXZ.X, size.X), snapAxis(localXZ.Y, size.Y))
end

function Placement.Corners(center: Vector2, size: Vector2): { Vector2 }
	local hx, hz = size.X / 2, size.Y / 2
	return {
		center + Vector2.new(-hx, -hz),
		center + Vector2.new(hx, -hz),
		center + Vector2.new(-hx, hz),
		center + Vector2.new(hx, hz),
	}
end

-- Every corner (and the centre) must be buildable land the owner owns.
-- sampler = IslandGen.NewSampler(islandData)
function Placement.IsOnLand(sampler: any, center: Vector2, size: Vector2): boolean
	if not IslandGen.IsBuildable(sampler, center.X, center.Y) then
		return false
	end
	for _, corner in Placement.Corners(center, size) do
		if not IslandGen.IsBuildable(sampler, corner.X, corner.Y) then
			return false
		end
	end
	return true
end

-- Island-local CFrame of a building's base centre.
function Placement.LocalCFrame(localPosition: Vector3, rotation: number): CFrame
	return CFrame.new(localPosition) * CFrame.Angles(0, math.rad(rotation), 0)
end

return Placement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">R15</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  R15
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/R15
	DEPENDENCIES: none

	Single source of truth for R15 body-part and Motor6D names. Nothing in the
	project hard-codes R6 parts ("Torso", "Right Arm", ...). If you ever need
	R6 compatibility, add it HERE and nowhere else.
]]

local R15 = {}

R15.PartNames = table.freeze({
	"Head",
	"UpperTorso",
	"LowerTorso",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
	"HumanoidRootPart",
})

-- Motor6D name -> the body part that parents it in a standard R15 rig.
R15.MotorParents = table.freeze({
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
	LeftAnkle = "LeftFoot",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	RightAnkle = "RightFoot",
})

-- Attachments the tool system grips with.
R15.GripAttachments = table.freeze({
	RightHand = "RightGripAttachment",
	LeftHand = "LeftGripAttachment",
})

function R15.GetHumanoid(character: Model?): Humanoid?
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

function R15.GetRootPart(character: Model?): BasePart?
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function R15.GetPart(character: Model?, partName: string): BasePart?
	if not character then
		return nil
	end
	local part = character:FindFirstChild(partName)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

function R15.GetMotor(character: Model?, motorName: string): Motor6D?
	local parentName = R15.MotorParents[motorName]
	if not parentName then
		return nil
	end
	local parent = R15.GetPart(character, parentName)
	local motor = parent and parent:FindFirstChild(motorName)
	if motor and motor:IsA("Motor6D") then
		return motor
	end
	return nil
end

function R15.IsR15(character: Model?): boolean
	local humanoid = R15.GetHumanoid(character)
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return false
	end
	return R15.GetPart(character, "UpperTorso") ~= nil and R15.GetPart(character, "RightHand") ~= nil
end

function R15.IsAlive(character: Model?): boolean
	local humanoid = R15.GetHumanoid(character)
	return humanoid ~= nil and humanoid.Health > 0 and R15.GetRootPart(character) ~= nil
end

return R15
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  RateLimiter
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/RateLimiter
	DEPENDENCIES: none

	Token-bucket rate limiter. Each key (usually a Player) owns a bucket that
	refills at `rate` tokens per second up to `burst` tokens. Keys are held
	weakly so Player objects are released automatically when they leave.
]]

export type RateLimiter = {
	Rate: number,
	Burst: number,
	Check: (self: RateLimiter, key: any, cost: number?) -> boolean,
	Reset: (self: RateLimiter, key: any) -> (),
}

type Bucket = { Tokens: number, Last: number }

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(rate: number, burst: number): RateLimiter
	assert(rate > 0 and burst > 0, "RateLimiter needs positive rate and burst")
	local self = setmetatable({
		Rate = rate,
		Burst = burst,
		_buckets = setmetatable({} :: { [any]: Bucket }, { __mode = "k" }),
	}, RateLimiter)
	return (self :: any) :: RateLimiter
end

function RateLimiter.Check(self: any, key: any, cost: number?): boolean
	local price = cost or 1
	local now = os.clock()
	local bucket: Bucket? = self._buckets[key]
	if not bucket then
		bucket = { Tokens = self.Burst, Last = now }
		self._buckets[key] = bucket
	end
	assert(bucket)
	bucket.Tokens = math.min(self.Burst, bucket.Tokens + (now - bucket.Last) * self.Rate)
	bucket.Last = now
	if bucket.Tokens >= price then
		bucket.Tokens -= price
		return true
	end
	return false
end

function RateLimiter.Reset(self: any, key: any)
	self._buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Serializer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Serializer
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Serializer
	DEPENDENCIES: none

	Converts Roblox datatypes into DataStore-safe tables and back.
	Instances are NEVER saved; only plain data like:
		{ BuildingId = "WoodenCabin", Position = { X = 10, Y = 5, Z = -30 }, Rotation = 90 }
	All island positions are saved in ISLAND-LOCAL space so an island can be
	loaded into any server slot.
]]

export type SerializedVector3 = { X: number, Y: number, Z: number }

local Serializer = {}

local function round(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

function Serializer.Vector3(value: Vector3): SerializedVector3
	return { X = round(value.X, 0.01), Y = round(value.Y, 0.01), Z = round(value.Z, 0.01) }
end

function Serializer.ToVector3(data: any): Vector3?
	if type(data) ~= "table" then
		return nil
	end
	local x, y, z = data.X, data.Y, data.Z
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		return nil
	end
	if x ~= x or y ~= y or z ~= z then
		return nil
	end
	return Vector3.new(x, y, z)
end

-- Rotation is stored as a yaw angle in whole degrees (0..359).
function Serializer.Yaw(cframe: CFrame): number
	local _, yaw, _ = cframe:ToEulerAnglesYXZ()
	return round(math.deg(yaw), 1) % 360
end

function Serializer.ToCFrame(position: Vector3, yawDegrees: number): CFrame
	return CFrame.new(position) * CFrame.Angles(0, math.rad(yawDegrees), 0)
end

return Serializer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Signal
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Signal
	DEPENDENCIES: none

	Lightweight script signal used by services and controllers for in-process
	events (never for networking — that is Net's job).

	Usage:
		local changed = Signal.new()
		local conn = changed:Connect(function(a, b) end)
		changed:Fire(1, 2)
		conn:Disconnect()
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
	Destroy: (self: Signal) -> (),
}

type ConnectionImpl = {
	Connected: boolean,
	_signal: any,
	_fn: (...any) -> (),
	Disconnect: (self: ConnectionImpl) -> (),
}

local Connection = {}
Connection.__index = Connection

function Connection.Disconnect(self: ConnectionImpl)
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	local self = setmetatable({
		_handlers = {} :: { ConnectionImpl },
	}, Signal)
	return (self :: any) :: Signal
end

function Signal.Connect(self: any, fn: (...any) -> ()): Connection
	local connection = setmetatable({
		Connected = true,
		_signal = self,
		_fn = fn,
	}, Connection)
	table.insert(self._handlers, connection)
	return (connection :: any) :: Connection
end

function Signal.Once(self: any, fn: (...any) -> ()): Connection
	local connection: Connection
	connection = Signal.Connect(self, function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal.Fire(self: any, ...: any)
	-- Copy so handlers can disconnect while we iterate.
	local snapshot: { ConnectionImpl } = table.clone(self._handlers)
	for _, connection in snapshot do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal.Wait(self: any): ...any
	local thread = coroutine.running()
	Signal.Once(self, function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: any)
	for _, connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

function Signal.Destroy(self: any)
	Signal.DisconnectAll(self)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  TableUtil
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/TableUtil
	DEPENDENCIES: none
]]

local TableUtil = {}

function TableUtil.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value :: any do
		copy[TableUtil.DeepCopy(key)] = TableUtil.DeepCopy(child)
	end
	return (copy :: any) :: T
end

-- Fills in any keys missing from `target` using a deep copy of `template`.
-- Existing values are left untouched (type repair is DataSchema's job).
function TableUtil.Reconcile(target: { [any]: any }, template: { [any]: any })
	for key, templateValue in template do
		if target[key] == nil then
			target[key] = TableUtil.DeepCopy(templateValue)
		elseif type(templateValue) == "table" and type(target[key]) == "table" then
			TableUtil.Reconcile(target[key], templateValue)
		end
	end
end

function TableUtil.Count(dict: { [any]: any }): number
	local count = 0
	for _ in dict do
		count += 1
	end
	return count
end

function TableUtil.Keys<K>(dict: { [K]: any }): { K }
	local keys = {}
	for key in dict do
		table.insert(keys, key)
	end
	return keys
end

-- Recursively freezes a config table so accidental writes error loudly.
function TableUtil.DeepFreeze<T>(value: T): T
	if type(value) == "table" and not table.isfrozen(value :: any) then
		for _, child in value :: any do
			TableUtil.DeepFreeze(child)
		end
		table.freeze(value :: any)
	end
	return value
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Validate
	SCRIPT TYPE:  ModuleScript (shared utility, used mostly by the server)
	WHERE:        ReplicatedStorage/Shared/Util/Validate
	DEPENDENCIES: none

	Type guards for anything that crosses the network. Every RemoteEvent
	handler validates its arguments with these before touching game state.
	Never trust types coming from a client.
]]

local Validate = {}

function Validate.IsFinite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Validate.Number(value: any, min: number?, max: number?): boolean
	if not Validate.IsFinite(value) then
		return false
	end
	if min and value < min then
		return false
	end
	if max and value > max then
		return false
	end
	return true
end

function Validate.Integer(value: any, min: number?, max: number?): boolean
	return Validate.Number(value, min, max) and math.floor(value) == value
end

function Validate.String(value: any, maxLength: number?): boolean
	if type(value) ~= "string" then
		return false
	end
	if maxLength and #value > maxLength then
		return false
	end
	return utf8.len(value) ~= nil
end

-- Config identifiers: letters, digits and underscores only.
function Validate.Id(value: any): boolean
	return Validate.String(value, 64) and string.match(value, "^[%w_]+$") ~= nil
end

function Validate.Boolean(value: any): boolean
	return type(value) == "boolean"
end

function Validate.Vector3(value: any, maxMagnitude: number?): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	if not (Validate.IsFinite(value.X) and Validate.IsFinite(value.Y) and Validate.IsFinite(value.Z)) then
		return false
	end
	return maxMagnitude == nil or value.Magnitude <= maxMagnitude
end

function Validate.OneOf(value: any, allowed: { [any]: any }): boolean
	return value ~= nil and allowed[value] ~= nil
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="45">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="46">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="47">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">DataSchema</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  DataSchema
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Data/DataSchema
	DEPENDENCIES: Shared.Config.{GameConfig, ItemConfig, ToolConfig, IslandConfig, EconomyConfig,
	              ProgressionConfig, BuildingConfig, CropConfig, AnimalConfig, QuestConfig},
	              Shared.Util.{TableUtil, IslandGen}

	Defines the saved player profile, migrates old versions and REPAIRS bad
	data instead of wiping it (spec §146):
	  * missing keys are filled from the template,
	  * wrong types are reset (old value moved to Quarantine),
	  * unknown item/tool/building/crop/animal ids are moved to Quarantine —
	    NOT deleted — and are restored automatically if a later update re-adds them,
	  * numbers are clamped to sane, finite, integer ranges.

	Version history:
		1  Phase 1 island core
		2  first playable loop (buildings, crops, animals, quests)
		3  unique chunk islands (Seed/Theme/Shape/Chunks/Paint), soil tiles as
		   buildings, holdable items on the hotbar, visiting + trading
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local ToolConfig = require(Shared.Config.ToolConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local BuildingConfig = require(Shared.Config.BuildingConfig)
local CropConfig = require(Shared.Config.CropConfig)
local AnimalConfig = require(Shared.Config.AnimalConfig)
local QuestConfig = require(Shared.Config.QuestConfig)
local TableUtil = require(Shared.Util.TableUtil)
local IslandGen = require(Shared.Util.IslandGen)

local DataSchema = {}

DataSchema.CurrentVersion = 3

-- Top-level keys never sent to the client.
DataSchema.PrivateKeys = table.freeze({ Quarantine = true })

local TEMPLATE = {
	Version = DataSchema.CurrentVersion,

	Coins = GameConfig.StartingCoins,
	Gems = GameConfig.StartingGems,
	XP = 0,
	Level = 1,

	Inventory = {
		Items = {}, -- [itemId] = count
		Capacity = GameConfig.Inventory.StartingCapacity,
		Favorites = {}, -- [itemId] = true
	},

	Tools = {
		Owned = {}, -- [toolId] = true
		Hotbar = {}, -- array of toolIds and holdable itemIds (<= ToolConfig.HotbarSize)
		Equipped = "", -- toolId or itemId in your hands; "" = empty hands
		Durability = {},
	},

	Island = {
		IslandId = "",
		Name = "",
		Level = GameConfig.StartingIslandLevel,
		XP = 0,
		Created = false, -- set by the Island Creator
		Seed = 0,
		Theme = IslandConfig.DefaultTheme,
		Shape = IslandConfig.DefaultShape,
		Chunks = {}, -- ["cx_cz"] = true (owned land)
		Paint = {}, -- ["px_pz"] = material name (8-stud cells)
		RemovedNodes = {}, -- [spotId] = true (natural trees/rocks cleared for good)
		Access = { Visitors = "Everyone", Helpers = {} }, -- Helpers: [tostring(userId)] = true
		StallPlaced = false,
		StarterTilesPlaced = false,
		-- [uniqueId] = { BuildingId, UniqueId, Position = {X,Y,Z} (island-local), Rotation, Variant, State, Progress }
		Buildings = {},
		-- [soilTileUniqueId] = { TileId, State = "Tilled"|"Planted", CropId, PlantedAt, WateredAt }
		Crops = {},
		-- [uniqueId] = { AnimalId, UniqueId, Variant, HousingId, Happiness, HappinessAt, FedAt, ProduceReadyAt, PettedAt }
		Animals = {},
		Upgrades = { Capacity = 0 },
		Storage = {},
		Production = {},
		Likes = 0,
		Visits = 0,
	},

	Quests = { Current = QuestConfig.Chain[1], Progress = {}, Completed = {}, DailyResetAt = 0 },
	Achievements = {},
	Collection = { Fish = {}, Crops = {}, Animals = {}, Items = {} },
	Recipes = {},
	Cosmetics = { Owned = {}, Equipped = {} },
	Social = { LikesGiven = {}, TradesCompleted = 0, IslandsVisited = 0 }, -- LikesGiven: [ownerUserId] = day number

	Stats = {
		PlayTime = 0,
		WoodCollected = 0,
		StoneCollected = 0,
		CropsHarvested = 0,
		FishCaught = 0,
		AnimalsOwned = 0,
		MilkCollected = 0,
		EggsCollected = 0,
		ItemsSold = 0,
		CoinsEarned = 0,
		BuildingsBuilt = 0,
		AreasUnlocked = 0,
		QuestsCompleted = 0,
		RareItemsFound = 0,
	},

	Settings = { CameraShake = true, MusicVolume = 0.5, SfxVolume = 0.8 },

	Flags = {
		StarterChestClaimed = false,
		FirstEquip = false,
		TutorialStep = 0,
	},

	Meta = { CreatedAt = 0, LastSavedAt = 0, LastJoinAt = 0, JoinCount = 0 },

	-- Data we could not validate, kept instead of deleted.
	Quarantine = { Items = {}, Tools = {}, Areas = {}, Values = {}, Buildings = {}, Crops = {}, Animals = {} },
}

function DataSchema.Template()
	return TableUtil.DeepCopy(TEMPLATE)
end

local function hashString(text: string): number
	local value = 5381
	for index = 1, #text do
		value = (value * 33 + string.byte(text, index)) % 2_000_000_000
	end
	return math.max(1, value)
end

-- Old (v2) starter farm plot: 4 x 3 tiles centred at (26, -2), 4.8-stud pitch.
local function oldStarterTilePosition(index: number): Vector2
	local column = (index - 1) % 4 + 1
	local row = (index - 1) // 4 + 1
	return Vector2.new(26 + (column - 2.5) * 4.8, -2 + (row - 2) * 4.8)
end

local function claimChunksAround(chunks: { [string]: boolean }, x: number, z: number)
	local cx, cz = IslandGen.ChunkOf(x, z)
	for dx = -1, 1 do
		for dz = -1, 1 do
			if IslandGen.InGrid(cx + dx, cz + dz) then
				chunks[IslandGen.Key(cx + dx, cz + dz)] = true
			end
		end
	end
end

-- version -> function(data) upgrading FROM that version to version + 1
local MIGRATIONS: { [number]: (any) -> () } = {
	-- v1 -> v2: first playable loop. Players who already opened the starter
	-- chest get the new starter tools + seeds; old quest layout is dropped.
	[1] = function(data)
		local flags = data.Flags
		if type(flags) == "table" and flags.StarterChestClaimed == true then
			if type(data.Tools) ~= "table" then
				data.Tools = {}
			end
			if type(data.Tools.Owned) ~= "table" then
				data.Tools.Owned = {}
			end
			if type(data.Tools.Hotbar) ~= "table" then
				data.Tools.Hotbar = {}
			end
			for _, toolId in GameConfig.StarterKit.Tools do
				if ToolConfig.Get(toolId) and data.Tools.Owned[toolId] ~= true then
					data.Tools.Owned[toolId] = true
					table.insert(data.Tools.Hotbar, toolId)
				end
			end
			if type(data.Inventory) == "table" and type(data.Inventory.Items) == "table" then
				local seeds = tonumber(data.Inventory.Items.WheatSeeds) or 0
				data.Inventory.Items.WheatSeeds = seeds + (GameConfig.StarterKit.Items.WheatSeeds or 0)
			end
		end
		if type(data.Quests) == "table" then
			data.Quests.Active = nil
		end
		if type(data.Island) == "table" then
			for _, key in { "Buildings", "Crops", "Animals" } do
				if type(data.Island[key]) ~= "table" then
					data.Island[key] = {}
				end
			end
		end
	end,

	-- v2 -> v3: fixed "areas" become a unique chunk island. Everything the
	-- player built stays on land, and the old farm tiles become soil tiles.
	[2] = function(data)
		if type(data.Island) ~= "table" then
			return
		end
		local island = data.Island
		local unlockedCount = 0
		if type(island.UnlockedAreas) == "table" then
			for _, value in island.UnlockedAreas do
				if value == true then
					unlockedCount += 1
				end
			end
		end
		local seed = hashString(if type(island.IslandId) == "string" and island.IslandId ~= "" then island.IslandId else tostring(os.clock()))
		local chunks = IslandGen.GenerateStarter(seed, "Round", IslandConfig.StarterChunks + math.max(0, unlockedCount - 1) * 10)

		local buildings = if type(island.Buildings) == "table" then island.Buildings else {}
		for _, entry in buildings do
			if type(entry) == "table" and type(entry.Position) == "table" and tonumber(entry.Position.X) and tonumber(entry.Position.Z) then
				claimChunksAround(chunks, entry.Position.X, entry.Position.Z)
			end
		end

		-- Old starter farm tiles -> SoilTile buildings (crop data moves with them).
		local oldCrops = if type(island.Crops) == "table" then island.Crops else {}
		local newCrops = {}
		local tileCount = math.clamp(tonumber(island.FarmTiles) or 6, 0, 12)
		for index = 1, tileCount do
			local position = oldStarterTilePosition(index)
			local uniqueId = "SoilS" .. index
			buildings[uniqueId] = {
				BuildingId = "SoilTile",
				UniqueId = uniqueId,
				Position = { X = position.X, Y = IslandConfig.LandHeight, Z = position.Y },
				Rotation = 0,
				Variant = "Default",
				State = "Complete",
				Progress = 0,
			}
			claimChunksAround(chunks, position.X, position.Y)
			local crop = oldCrops["S" .. index]
			if type(crop) == "table" then
				crop.TileId = uniqueId
				newCrops[uniqueId] = crop
			end
		end

		island.Buildings = buildings
		island.Crops = newCrops
		island.Created = true
		island.Seed = seed
		island.Theme = if IslandConfig.Themes[island.Theme] then island.Theme else IslandConfig.DefaultTheme
		island.Shape = "Round"
		island.Chunks = chunks
		island.Paint = {}
		island.RemovedNodes = {}
		island.StarterTilesPlaced = true
		island.StallPlaced = false
		island.UnlockedAreas = nil
		island.FarmTiles = nil
		island.Permission = nil
		island.Decorations = nil
		if type(island.Upgrades) == "table" then
			island.Upgrades.FarmTiles = nil
		end
	end,
}

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function cleanInteger(value: any, min: number, max: number, fallback: number): number
	if not isFiniteNumber(value) then
		return fallback
	end
	return math.clamp(math.floor(value), min, max)
end

-- Recursively resets values whose type does not match the template.
local function repairTypes(data: { [any]: any }, template: { [any]: any }, quarantine: { [any]: any }, path: string)
	for key, templateValue in template do
		local value = data[key]
		if value ~= nil and type(value) ~= type(templateValue) then
			quarantine[path .. tostring(key)] = value
			data[key] = TableUtil.DeepCopy(templateValue)
		elseif type(templateValue) == "table" and type(value) == "table" and next(templateValue) ~= nil then
			-- Only recurse into "shaped" tables (non-empty template tables).
			repairTypes(value, templateValue, quarantine, path .. tostring(key) .. ".")
		end
	end
end

function DataSchema.Migrate(data: any): any
	local version = if isFiniteNumber(data.Version) then data.Version else 1
	while version < DataSchema.CurrentVersion do
		local migrate = MIGRATIONS[version]
		if migrate then
			migrate(data)
		end
		version += 1
	end
	data.Version = DataSchema.CurrentVersion
	return data
end

-- Is this id something that can sit on the hotbar?
function DataSchema.IsHoldable(id: any): boolean
	if type(id) ~= "string" then
		return false
	end
	if ToolConfig.Get(id) then
		return true
	end
	local item = ItemConfig.Get(id)
	return item ~= nil and ItemConfig.IsHoldable(id)
end

local function sanitizeTools(data: any)
	local quarantine = data.Quarantine
	for toolId, owned in data.Tools.Owned do
		if owned ~= true then
			data.Tools.Owned[toolId] = nil
		elseif not ToolConfig.Get(toolId) then
			quarantine.Tools[tostring(toolId)] = true
			data.Tools.Owned[toolId] = nil
		end
	end
	local items = data.Inventory.Items
	local hotbar = {}
	local seen = {}
	for _, id in data.Tools.Hotbar do
		if #hotbar >= ToolConfig.HotbarSize then
			break
		end
		if type(id) == "string" and not seen[id] then
			local keep = if ToolConfig.Get(id) then data.Tools.Owned[id] == true else DataSchema.IsHoldable(id) and (items[id] or 0) > 0
			if keep then
				seen[id] = true
				table.insert(hotbar, id)
			end
		end
	end
	data.Tools.Hotbar = hotbar
	local equipped = data.Tools.Equipped
	if equipped ~= "" then
		local valid = if ToolConfig.Get(equipped) then data.Tools.Owned[equipped] == true else DataSchema.IsHoldable(equipped) and (items[equipped] or 0) > 0
		if not valid then
			data.Tools.Equipped = ""
		end
	end
end

local function sanitizeIslandShape(data: any)
	local island = data.Island
	if type(island.Name) ~= "string" or #island.Name > IslandConfig.NameMaxLength * 4 then
		island.Name = ""
	end
	if not IslandConfig.Themes[island.Theme] then
		island.Theme = IslandConfig.DefaultTheme
	end
	if not IslandConfig.Shapes[island.Shape] then
		island.Shape = IslandConfig.DefaultShape
	end
	island.Seed = cleanInteger(island.Seed, 0, 2_000_000_000, 0)
	if island.Created == true and island.Seed == 0 then
		island.Seed = hashString(island.IslandId ~= "" and island.IslandId or "island")
	end

	local chunks = {}
	local count = 0
	for key, value in island.Chunks do
		if value == true and type(key) == "string" then
			local cx, cz = IslandGen.ParseKey(key)
			if cx and cz and IslandGen.InGrid(cx, cz) and count < IslandConfig.Expansion.MaxChunks then
				chunks[IslandGen.Key(cx, cz)] = true
				count += 1
			end
		end
	end
	if island.Created == true and count < 4 then
		chunks = IslandGen.GenerateStarter(island.Seed, island.Shape)
	end
	island.Chunks = chunks

	local paint = {}
	local painted = 0
	for key, material in island.Paint do
		if type(key) == "string" and string.match(key, "^%-?%d+_%-?%d+$") and IslandConfig.Paint[material] and painted < IslandConfig.MaxPaintCells then
			paint[key] = material
			painted += 1
		end
	end
	island.Paint = paint

	for key, value in island.RemovedNodes do
		if type(key) ~= "string" or value ~= true then
			island.RemovedNodes[key] = nil
		end
	end

	if not table.find(IslandConfig.VisitorModes, island.Access.Visitors) then
		island.Access.Visitors = "Everyone"
	end
	if type(island.Access.Helpers) ~= "table" then
		island.Access.Helpers = {}
	end
	for key, value in island.Access.Helpers do
		if type(key) ~= "string" or not tonumber(key) or value ~= true then
			island.Access.Helpers[key] = nil
		end
	end
	island.Likes = cleanInteger(island.Likes, 0, 1e12, 0)
	island.Visits = cleanInteger(island.Visits, 0, 1e12, 0)
end

-- Returns a repaired profile table. Never returns nil for a table input.
function DataSchema.Sanitize(raw: any): any
	local data = if type(raw) == "table" then raw else DataSchema.Template()
	DataSchema.Migrate(data)
	if type(data.Quarantine) ~= "table" then
		data.Quarantine = TableUtil.DeepCopy(TEMPLATE.Quarantine)
	end
	if type(data.Quarantine.Values) ~= "table" then
		data.Quarantine.Values = {}
	end
	TableUtil.Reconcile(data, TEMPLATE)
	repairTypes(data, TEMPLATE, data.Quarantine.Values, "")

	-- Currencies / levels
	data.Coins = cleanInteger(data.Coins, 0, EconomyConfig.Currencies.Coins.Max, TEMPLATE.Coins)
	data.Gems = cleanInteger(data.Gems, 0, EconomyConfig.Currencies.Gems.Max, TEMPLATE.Gems)
	data.Level = cleanInteger(data.Level, 1, ProgressionConfig.Player.MaxLevel, 1)
	data.XP = cleanInteger(data.XP, 0, math.huge, 0)
	data.Island.Level = cleanInteger(data.Island.Level, 1, ProgressionConfig.Island.MaxLevel, 1)
	data.Island.XP = cleanInteger(data.Island.XP, 0, math.huge, 0)
	data.Inventory.Capacity = cleanInteger(data.Inventory.Capacity, GameConfig.Inventory.StartingCapacity, 1_000_000, GameConfig.Inventory.StartingCapacity)
	data.Island.Upgrades.Capacity = cleanInteger(data.Island.Upgrades.Capacity, 0, 100, 0)
	data.Social.TradesCompleted = cleanInteger(data.Social.TradesCompleted, 0, 1e9, 0)
	data.Settings.MusicVolume = math.clamp(if isFiniteNumber(data.Settings.MusicVolume) then data.Settings.MusicVolume else 0.5, 0, 1)
	data.Settings.SfxVolume = math.clamp(if isFiniteNumber(data.Settings.SfxVolume) then data.Settings.SfxVolume else 0.8, 0, 1)

	-- Restore quarantined ids that are valid again (e.g. an item re-added in an update).
	local quarantine = data.Quarantine
	for itemId, count in quarantine.Items do
		if ItemConfig.Exists(itemId) then
			data.Inventory.Items[itemId] = (data.Inventory.Items[itemId] or 0) + count
			quarantine.Items[itemId] = nil
		end
	end
	for toolId in quarantine.Tools do
		if ToolConfig.Get(toolId) then
			data.Tools.Owned[toolId] = true
			quarantine.Tools[toolId] = nil
		end
	end

	-- Inventory items
	for itemId, count in data.Inventory.Items do
		if not isFiniteNumber(count) or count <= 0 then
			data.Inventory.Items[itemId] = nil
		elseif not ItemConfig.Exists(itemId) then
			quarantine.Items[tostring(itemId)] = math.floor(count)
			data.Inventory.Items[itemId] = nil
		else
			data.Inventory.Items[itemId] = math.min(math.floor(count), GameConfig.Inventory.MaxStack)
		end
	end
	for itemId in data.Inventory.Favorites do
		if not ItemConfig.Exists(itemId) then
			data.Inventory.Favorites[itemId] = nil
		end
	end

	sanitizeTools(data)
	sanitizeIslandShape(data)
	DataSchema.SanitizeIsland(data)
	DataSchema.SanitizeQuests(data)
	return data
end

local function validPosition(position: any): boolean
	return type(position) == "table"
		and isFiniteNumber(position.X)
		and isFiniteNumber(position.Y)
		and isFiniteNumber(position.Z)
		and math.abs(position.X) < 2000
		and math.abs(position.Z) < 2000
		and math.abs(position.Y) < 500
end

local function validBuilding(entry: any): boolean
	if type(entry) ~= "table" then
		return false
	end
	local def = BuildingConfig.Get(entry.BuildingId)
	if not def or not validPosition(entry.Position) then
		return false
	end
	if entry.Rotation ~= 0 and entry.Rotation ~= 90 and entry.Rotation ~= 180 and entry.Rotation ~= 270 then
		return false
	end
	return true
end

local function validCrop(key: any, entry: any, buildings: any, now: number): boolean
	if type(key) ~= "string" or type(entry) ~= "table" then
		return false
	end
	local tile = buildings[key]
	if type(tile) ~= "table" or tile.BuildingId ~= "SoilTile" then
		return false
	end
	if entry.State == "Tilled" then
		return true
	end
	if entry.State ~= "Planted" or not CropConfig.Crops[entry.CropId] then
		return false
	end
	return isFiniteNumber(entry.PlantedAt) and entry.PlantedAt <= now + 120
end

local function validAnimal(entry: any): boolean
	return type(entry) == "table" and AnimalConfig.Animals[entry.AnimalId] ~= nil
end

-- Buildings / crops / animals: repair what we can, quarantine the rest.
function DataSchema.SanitizeIsland(data: any)
	local island = data.Island
	local quarantine = data.Quarantine
	local now = os.time()

	-- Give back quarantined entries that became valid again.
	for key, entry in quarantine.Buildings do
		if validBuilding(entry) and island.Buildings[key] == nil then
			island.Buildings[key] = entry
			quarantine.Buildings[key] = nil
		end
	end

	for key, entry in island.Buildings do
		if type(key) == "string" and validBuilding(entry) then
			local steps = BuildingConfig.Get(entry.BuildingId).Steps
			entry.UniqueId = key
			entry.Variant = if type(entry.Variant) == "string" then entry.Variant else "Default"
			entry.Progress = cleanInteger(entry.Progress, 0, math.max(steps, 0), 0)
			entry.State = if entry.State == "Complete" or entry.Progress >= steps then "Complete" else "Constructing"
		else
			quarantine.Buildings[tostring(key)] = entry
			island.Buildings[key] = nil
		end
	end

	for key, entry in quarantine.Crops do
		if validCrop(key, entry, island.Buildings, now) and island.Crops[key] == nil then
			island.Crops[key] = entry
			quarantine.Crops[key] = nil
		end
	end
	for key, entry in island.Crops do
		if validCrop(key, entry, island.Buildings, now) then
			entry.TileId = key
			entry.Position = nil
			if entry.State == "Planted" then
				entry.WateredAt = if isFiniteNumber(entry.WateredAt) then entry.WateredAt else 0
			else
				entry.CropId = nil
				entry.PlantedAt = nil
				entry.WateredAt = nil
			end
		else
			quarantine.Crops[tostring(key)] = entry
			island.Crops[key] = nil
		end
	end

	for key, entry in island.Animals do
		if type(key) == "string" and validAnimal(entry) then
			entry.UniqueId = key
			entry.Happiness = math.clamp(if isFiniteNumber(entry.Happiness) then entry.Happiness else AnimalConfig.StartHappiness, 0, 100)
			entry.HappinessAt = if isFiniteNumber(entry.HappinessAt) then entry.HappinessAt else now
			entry.FedAt = if isFiniteNumber(entry.FedAt) then entry.FedAt else 0
			entry.ProduceReadyAt = if isFiniteNumber(entry.ProduceReadyAt) then entry.ProduceReadyAt else 0
			entry.PettedAt = if isFiniteNumber(entry.PettedAt) then entry.PettedAt else 0
			entry.Variant = if type(entry.Variant) == "string" then entry.Variant else "Default"
			entry.HousingId = if type(entry.HousingId) == "string" then entry.HousingId else ""
		else
			quarantine.Animals[tostring(key)] = entry
			island.Animals[key] = nil
		end
	end
end

function DataSchema.SanitizeQuests(data: any)
	local quests = data.Quests
	if quests.Current ~= "" and not QuestConfig.Quests[quests.Current] then
		quests.Current = ""
	end
	-- A player who finished (or never started) the chain resumes at the first unfinished quest.
	if quests.Current == "" then
		for _, questId in QuestConfig.Chain do
			if quests.Completed[questId] ~= true then
				quests.Current = questId
				break
			end
		end
	end
	for key, value in quests.Progress do
		if type(key) ~= "string" or not isFiniteNumber(value) then
			quests.Progress[key] = nil
		end
	end
	for key, value in quests.Completed do
		if value ~= true then
			quests.Completed[key] = nil
		end
	end
end

-- Final guard before anything is written to the DataStore.
function DataSchema.IsSaveable(data: any): (boolean, string?)
	if type(data) ~= "table" then
		return false, "profile is not a table"
	end
	if data.Version ~= DataSchema.CurrentVersion then
		return false, "unexpected version"
	end
	if not isFiniteNumber(data.Coins) or data.Coins < 0 then
		return false, "invalid Coins"
	end
	if type(data.Inventory) ~= "table" or type(data.Inventory.Items) ~= "table" then
		return false, "invalid Inventory"
	end
	if type(data.Island) ~= "table" or type(data.Island.Chunks) ~= "table" then
		return false, "invalid Island"
	end
	if data.Island.Created == true and next(data.Island.Chunks) == nil then
		return false, "created island has no land"
	end
	return true, nil
end

return DataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">MockDataStore</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  MockDataStore
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Data/MockDataStore
	DEPENDENCIES: Shared.Util.TableUtil

	In-memory stand-in for a GlobalDataStore, used in Studio when "Enable
	Studio Access to API Services" is off. Same UpdateAsync/GetAsync contract,
	so DataService runs the exact same code path. Data lives only for the
	current play session.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TableUtil = require(ReplicatedStorage.Shared.Util.TableUtil)

local MockDataStore = {}
MockDataStore.__index = MockDataStore

function MockDataStore.new()
	return setmetatable({ _data = {} :: { [string]: any } }, MockDataStore)
end

function MockDataStore:GetAsync(key: string): any
	task.wait() -- simulate yielding like the real API
	return TableUtil.DeepCopy(self._data[key])
end

function MockDataStore:UpdateAsync(key: string, transform: (any, any) -> any): any
	task.wait()
	local result = transform(TableUtil.DeepCopy(self._data[key]), nil)
	if result == nil then
		return nil -- cancelled, mirrors the real API
	end
	self._data[key] = TableUtil.DeepCopy(result)
	return TableUtil.DeepCopy(result)
end

function MockDataStore:RemoveAsync(key: string): any
	local old = self._data[key]
	self._data[key] = nil
	return old
end

return MockDataStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="50">
        <Properties>
          <string name="Name">Island</string>
        </Properties>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">AnimalModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalModels
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/AnimalModels
	DEPENDENCIES: none

	Cartoon-realistic procedural animals with a real JOINT RIG: rounded
	bodies built from ellipsoids, big shiny eyes, soft colours (a cow with
	patches, a pink muzzle, horns, floppy ears and a bell collar; a plump
	chicken with a comb, wattles, fanned tail and toes). Golden variants
	sparkle. The anchored, invisible "Body" is the PrimaryPart (the server
	tweens it around the pen); limbs hang off it on
	Motor6Ds named after the limb (LegFL, LegFR, LegBL, LegBR, Head, Tail,
	WingL, WingR). Every client animates those joints (Motor6D.Transform) from
	the AnimalAnim attribute — walk cycles, head bobs, pecking, tail wags —
	with no uploaded animations needed. Pivot = the animal's feet centre.

	Real art: ServerStorage/Animals/<AnimalId> with an anchored "Body"
	PrimaryPart (joints with the same names are animated automatically).
]]

local ServerStorage = game:GetService("ServerStorage")

local AnimalModels = {}

local function newPart(model: Model, props: { [string]: any }): BasePart
	local part = Instance.new("Part")
	part.Material = Enum.Material.SmoothPlastic
	if props.Shape then
		part.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" and key ~= "Mesh" then
			(part :: any)[key] = value
		end
	end
	if props.Mesh == "Sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = part
	end
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

-- Rigidly attach `part` to `parent` (decorations on a limb or the body).
local function weld(parent: BasePart, part: BasePart)
	part.Anchored = false
	part.Massless = true
	part.CanCollide = false
	local joint = Instance.new("Weld")
	joint.Part0 = parent
	joint.Part1 = part
	joint.C0 = parent.CFrame:ToObjectSpace(part.CFrame)
	joint.Parent = part
end

-- Animated joint: rotation happens around `pivot` (world, at build time).
local function motor(name: string, body: BasePart, limb: BasePart, pivot: Vector3)
	limb.Anchored = false
	limb.Massless = true
	limb.CanCollide = false
	local joint = Instance.new("Motor6D")
	joint.Name = name
	joint.Part0 = body
	joint.Part1 = limb
	joint.C0 = body.CFrame:ToObjectSpace(CFrame.new(pivot))
	joint.C1 = limb.CFrame:ToObjectSpace(CFrame.new(pivot))
	joint.Parent = body
end

local function finish(model: Model, body: BasePart)
	body.PivotOffset = body.CFrame:ToObjectSpace(CFrame.new()) -- feet centre
	model.PrimaryPart = body
end

local EYE_WHITE = Color3.fromRGB(252, 252, 250)
local PUPIL = Color3.fromRGB(28, 22, 20)

-- A cartoon eye: white, big pupil, a sparkle highlight (all welded to `head`).
local function eye(model: Model, head: BasePart, center: Vector3, size: number, lookZ: number)
	weld(head, newPart(model, { Name = "EyeWhite", Shape = Enum.PartType.Ball, Size = Vector3.one * size, CFrame = CFrame.new(center), Color = EYE_WHITE }))
	weld(head, newPart(model, { Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.6, CFrame = CFrame.new(center + Vector3.new(0, 0.01, lookZ * size * 0.34)), Color = PUPIL }))
	weld(head, newPart(model, { Name = "Sparkle", Shape = Enum.PartType.Ball, Size = Vector3.one * size * 0.22, CFrame = CFrame.new(center + Vector3.new(size * 0.1, size * 0.14, lookZ * size * 0.52)), Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon }))
end

-- The anchored root the server moves around; invisible (the visible body is rounded parts).
local function root(model: Model, size: Vector3, y: number): BasePart
	return newPart(model, { Name = "Body", Size = size, CFrame = CFrame.new(0, y, 0), Transparency = 1, Anchored = true, CanCollide = true })
end

local function goldenShine(body: BasePart)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "GoldenSparkle"
	emitter.Rate = 3
	emitter.Lifetime = NumberRange.new(0.8, 1.3)
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
	emitter.LightEmission = 1
	emitter.Parent = body
end

local function cow(variant: any): Model
	local model = Instance.new("Model")
	local bodyColor, spotColor = variant.Body, variant.Spots
	local pink = Color3.fromRGB(246, 184, 176)
	local hoofColor = Color3.fromRGB(58, 44, 36)
	local body = root(model, Vector3.new(2.6, 2.2, 4.6), 2.7)

	-- Round barrel body: chest, belly, rump.
	for _, spec in {
		{ "Torso", Vector3.new(2.9, 2.6, 4.9), Vector3.new(0, 2.75, 0.1) },
		{ "Chest", Vector3.new(2.6, 2.5, 2.4), Vector3.new(0, 2.8, -1.7) },
		{ "Rump", Vector3.new(2.75, 2.55, 2.4), Vector3.new(0, 2.9, 1.8) },
		{ "Neck", Vector3.new(1.55, 1.7, 1.7), Vector3.new(0, 3.35, -2.75) },
	} do
		weld(body, newPart(model, { Name = spec[1], Size = spec[2], CFrame = CFrame.new(spec[3]), Color = bodyColor, Mesh = "Sphere" }))
	end
	-- Patches that wrap the body (flattened ellipsoids on the surface).
	for _, spec in {
		{ Vector3.new(0.35, 1.6, 1.9), CFrame.new(1.3, 3.0, 0.4) * CFrame.Angles(0, 0, math.rad(8)) },
		{ Vector3.new(0.35, 1.3, 1.5), CFrame.new(-1.3, 2.7, -0.9) * CFrame.Angles(0, 0, math.rad(-8)) },
		{ Vector3.new(0.35, 1.1, 1.2), CFrame.new(1.25, 2.6, 1.95) },
		{ Vector3.new(1.4, 0.3, 1.6), CFrame.new(0.6, 4.0, 1.2) },
		{ Vector3.new(1.2, 0.3, 1.2), CFrame.new(-0.7, 3.95, -0.5) },
	} do
		weld(body, newPart(model, { Name = "Patch", Size = spec[1], CFrame = spec[2], Color = spotColor, Mesh = "Sphere" }))
	end

	-- Head (animated): skull, muzzle, nostrils, eyes, ears, horns, forelock.
	local head = newPart(model, { Name = "Head", Size = Vector3.new(1.55, 1.5, 1.75), CFrame = CFrame.new(0, 3.75, -3.4), Color = bodyColor, Mesh = "Sphere" })
	weld(head, newPart(model, { Name = "Muzzle", Size = Vector3.new(1.4, 1.0, 1.1), CFrame = CFrame.new(0, 3.3, -4.15), Color = pink, Mesh = "Sphere" }))
	weld(head, newPart(model, { Name = "Blaze", Size = Vector3.new(0.55, 0.9, 0.3), CFrame = CFrame.new(0, 3.95, -4.12) * CFrame.Angles(math.rad(-20), 0, 0), Color = spotColor, Mesh = "Sphere" }))
	for _, side in { -1, 1 } do
		weld(head, newPart(model, { Name = "Nostril", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, CFrame = CFrame.new(side * 0.3, 3.42, -4.66), Color = Color3.fromRGB(150, 80, 80) }))
		eye(model, head, Vector3.new(side * 0.5, 3.98, -3.98), 0.44, -1)
		local ear = newPart(model, { Name = "Ear", Size = Vector3.new(0.95, 0.36, 0.56), CFrame = CFrame.new(side * 1.0, 3.95, -3.2) * CFrame.Angles(0, 0, math.rad(side * -22)), Color = bodyColor, Mesh = "Sphere" })
		weld(head, ear)
		weld(head, newPart(model, { Name = "EarInner", Size = Vector3.new(0.62, 0.2, 0.34), CFrame = ear.CFrame * CFrame.new(0, 0.06, -0.08), Color = pink, Mesh = "Sphere" }))
		local hornAngle = if side > 0 then math.rad(55) else math.rad(125)
		weld(head, newPart(model, { Name = "Horn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 0.24, 0.24), CFrame = CFrame.new(side * 0.52, 4.52, -3.3) * CFrame.Angles(0, 0, hornAngle), Color = Color3.fromRGB(246, 236, 212) }))
	end
	weld(head, newPart(model, { Name = "Forelock", Size = Vector3.new(0.85, 0.38, 0.65), CFrame = CFrame.new(0, 4.45, -3.45), Color = spotColor, Mesh = "Sphere" }))
	motor("Head", body, head, Vector3.new(0, 3.55, -2.9))

	-- Red collar with a golden bell.
	weld(body, newPart(model, { Name = "Collar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.32, 1.8, 1.8), CFrame = CFrame.new(0, 3.2, -2.85) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(206, 58, 58) }))
	weld(body, newPart(model, { Name = "Bell", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, CFrame = CFrame.new(0, 2.3, -3.1), Color = Color3.fromRGB(250, 200, 60), Material = Enum.Material.Metal }))

	-- Legs (animated): rounded legs with dark hooves.
	for _, spec in { { "LegFL", -0.8, -1.6 }, { "LegFR", 0.8, -1.6 }, { "LegBL", -0.8, 1.7 }, { "LegBR", 0.8, 1.7 } } do
		local x, z = spec[2], spec[3]
		local leg = newPart(model, { Name = spec[1], Size = Vector3.new(0.74, 2.0, 0.74), CFrame = CFrame.new(x, 1.05, z), Color = bodyColor, Mesh = "Sphere" })
		weld(leg, newPart(model, { Name = "Hoof", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.36, 0.7, 0.7), CFrame = CFrame.new(x, 0.18, z) * CFrame.Angles(0, 0, math.rad(90)), Color = hoofColor }))
		motor(spec[1], body, leg, Vector3.new(x, 1.95, z))
	end

	-- Udder.
	weld(body, newPart(model, { Name = "Udder", Size = Vector3.new(1.1, 0.65, 1.05), CFrame = CFrame.new(0, 1.55, 1.1), Color = pink, Mesh = "Sphere" }))
	for _, offset in { Vector2.new(-0.22, -0.2), Vector2.new(0.22, -0.2), Vector2.new(-0.22, 0.2), Vector2.new(0.22, 0.2) } do
		weld(body, newPart(model, { Name = "Teat", Size = Vector3.new(0.14, 0.3, 0.14), CFrame = CFrame.new(offset.X, 1.2, 1.1 + offset.Y), Color = pink, Mesh = "Sphere" }))
	end

	-- Tail (animated) with a tuft.
	local tail = newPart(model, { Name = "Tail", Size = Vector3.new(0.2, 1.7, 0.2), CFrame = CFrame.new(0, 2.75, 3.05) * CFrame.Angles(math.rad(14), 0, 0), Color = bodyColor, Mesh = "Sphere" })
	weld(tail, newPart(model, { Name = "Tuft", Size = Vector3.new(0.42, 0.6, 0.42), CFrame = tail.CFrame * CFrame.new(0, -0.85, 0), Color = spotColor, Mesh = "Sphere" }))
	motor("Tail", body, tail, Vector3.new(0, 3.55, 2.95))

	if variant.Id == "Golden" then
		goldenShine(body)
	end
	finish(model, body)
	return model
end

local function chicken(variant: any): Model
	local model = Instance.new("Model")
	local feathers = variant.Body
	local dark = feathers:Lerp(Color3.new(0, 0, 0), 0.12)
	local light = feathers:Lerp(Color3.new(1, 1, 1), 0.25)
	local red = variant.Spots
	local orange = Color3.fromRGB(250, 170, 40)
	local body = root(model, Vector3.new(1.2, 1.1, 1.5), 1.25)

	-- Plump body with a puffed-out breast.
	weld(body, newPart(model, { Name = "Torso", Size = Vector3.new(1.35, 1.25, 1.65), CFrame = CFrame.new(0, 1.25, 0.05), Color = feathers, Mesh = "Sphere" }))
	weld(body, newPart(model, { Name = "Breast", Size = Vector3.new(1.12, 1.15, 1.0), CFrame = CFrame.new(0, 1.35, -0.45), Color = light, Mesh = "Sphere" }))

	-- Head (animated): comb, beak, wattles, eyes.
	local head = newPart(model, { Name = "Head", Size = Vector3.new(0.8, 0.82, 0.8), CFrame = CFrame.new(0, 2.05, -0.62), Color = feathers, Mesh = "Sphere" })
	for index, z in { -0.78, -0.62, -0.46 } do
		weld(head, newPart(model, { Name = "Comb", Size = Vector3.new(0.14, if index == 2 then 0.36 else 0.28, 0.22), CFrame = CFrame.new(0, 2.5 + (if index == 2 then 0.04 else 0), z), Color = red, Mesh = "Sphere" }))
	end
	weld(head, newPart(model, { Name = "Beak", Size = Vector3.new(0.26, 0.16, 0.36), CFrame = CFrame.new(0, 2.02, -1.08) * CFrame.Angles(math.rad(10), 0, 0), Color = orange, Mesh = "Sphere" }))
	weld(head, newPart(model, { Name = "BeakLow", Size = Vector3.new(0.2, 0.1, 0.24), CFrame = CFrame.new(0, 1.93, -1.02), Color = Color3.fromRGB(230, 140, 30), Mesh = "Sphere" }))
	for _, side in { -1, 1 } do
		weld(head, newPart(model, { Name = "Wattle", Size = Vector3.new(0.12, 0.26, 0.14), CFrame = CFrame.new(side * 0.07, 1.75, -0.98), Color = red, Mesh = "Sphere" }))
		eye(model, head, Vector3.new(side * 0.27, 2.14, -0.9), 0.2, -1)
	end
	motor("Head", body, head, Vector3.new(0, 1.7, -0.45))

	-- Legs (animated) with three front toes and one back toe.
	for _, spec in { { "LegL", -0.24 }, { "LegR", 0.24 } } do
		local x = spec[2]
		local leg = newPart(model, { Name = spec[1], Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.66, 0.11, 0.11), CFrame = CFrame.new(x, 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = orange })
		for toe, angle in { -30, 0, 30, 180 } do
			local length = if toe == 4 then 0.18 else 0.3
			weld(leg, newPart(model, { Name = "Toe", Size = Vector3.new(0.07, 0.05, length), CFrame = CFrame.new(x, 0.03, 0) * CFrame.Angles(0, math.rad(angle), 0) * CFrame.new(0, 0, -length / 2), Color = orange }))
		end
		motor(spec[1], body, leg, Vector3.new(x, 0.68, 0))
	end

	-- Wings (animated): a flight-feather layer and a lighter covert.
	for _, spec in { { "WingL", -0.7 }, { "WingR", 0.7 } } do
		local x = spec[2]
		local wing = newPart(model, { Name = spec[1], Size = Vector3.new(0.22, 0.76, 1.08), CFrame = CFrame.new(x, 1.28, 0.1) * CFrame.Angles(math.rad(-10), 0, 0), Color = dark, Mesh = "Sphere" })
		weld(wing, newPart(model, { Name = "Covert", Size = Vector3.new(0.12, 0.5, 0.7), CFrame = CFrame.new(x * 1.06, 1.42, -0.05), Color = light, Mesh = "Sphere" }))
		motor(spec[1], body, wing, Vector3.new(x, 1.58, 0.05))
	end

	-- Tail (animated): three fanned feathers.
	local tail = newPart(model, { Name = "Tail", Size = Vector3.new(0.26, 0.95, 0.55), CFrame = CFrame.new(0, 1.85, 0.8) * CFrame.Angles(math.rad(-28), 0, 0), Color = dark, Mesh = "Sphere" })
	for _, side in { -1, 1 } do
		weld(tail, newPart(model, { Name = "TailFeather", Size = Vector3.new(0.22, 0.85, 0.5), CFrame = CFrame.new(side * 0.2, 1.78, 0.78) * CFrame.Angles(math.rad(-30), 0, math.rad(side * 20)), Color = feathers, Mesh = "Sphere" }))
	end
	motor("Tail", body, tail, Vector3.new(0, 1.45, 0.7))

	if variant.Id == "Golden" then
		goldenShine(body)
	end
	finish(model, body)
	return model
end

local BUILDERS = { Cow = cow, Chicken = chicken }

function AnimalModels.Build(animalId: string, variant: any): Model
	local folder = ServerStorage:FindFirstChild("Animals")
	local art = folder and folder:FindFirstChild(animalId)
	if art and art:IsA("Model") and art:FindFirstChild("Body") then
		local clone = art:Clone()
		clone.PrimaryPart = clone:FindFirstChild("Body") :: BasePart
		return clone
	end
	local builder = BUILDERS[animalId] or cow
	local model = builder(variant)
	model.Name = animalId
	return model
end

return AnimalModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">CropModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CropModels
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/CropModels
	DEPENDENCIES: Shared.Config.CropConfig

	Procedural crop visuals for each growth stage (1 Seed .. 6 Harvestable),
	by crop Shape: Grain (wheat heads with whiskers), Root (feathery tops, the
	root shoulder shows when ripe), Tall (corn with broad leaves and husked
	cobs), Bush (shaded leafy bush with shiny fruit). Soft, rounded,
	cartoon-realistic. Models are small and only rebuilt when a tile's stage
	changes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CropConfig = require(ReplicatedStorage.Shared.Config.CropConfig)

local CropModels = {}

local function part(model: Model, size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?)
	local newPart = Instance.new("Part")
	newPart.Anchored = true
	newPart.CanCollide = false
	newPart.CanQuery = false
	newPart.CanTouch = false
	newPart.CastShadow = false
	newPart.Shape = shape or Enum.PartType.Block
	newPart.Size = size
	newPart.CFrame = cframe
	newPart.Color = color
	newPart.Material = material or Enum.Material.SmoothPlastic
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	newPart.Parent = model
	return newPart
end

-- 3x3 grid of plants on a 4x4 tile.
local SPOTS = {
	Vector2.new(-1.1, -1.1), Vector2.new(0, -1.1), Vector2.new(1.1, -1.1),
	Vector2.new(-1.1, 0), Vector2.new(0, 0), Vector2.new(1.1, 0),
	Vector2.new(-1.1, 1.1), Vector2.new(0, 1.1), Vector2.new(1.1, 1.1),
}

-- `top` = CFrame of the tile's top surface centre.
function CropModels.Build(cropId: string, stage: number, top: CFrame): Model
	local crop = CropConfig.Crops[cropId]
	local model = Instance.new("Model")
	model.Name = "Crop"
	if not crop then
		return model
	end
	local stalk = crop.StalkColor
	local produce = crop.ProduceColor
	local growth = math.clamp((stage - 1) / 4, 0, 1) -- 0 at Seed, 1 at Mature
	local ready = stage >= #CropConfig.Stages

	local function sphere(size: Vector3, cframe: CFrame, color: Color3): BasePart
		local piece = part(model, size, cframe, color)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = piece
		return piece
	end
	local leafDark = stalk:Lerp(Color3.new(0, 0, 0), 0.18)

	for index, spot in SPOTS do
		local base = top * CFrame.new(spot.X, 0, spot.Y) * CFrame.Angles(0, index * 0.7, 0)
		if stage <= 1 then
			-- A little mound of soil with a seed peeking out.
			sphere(Vector3.new(0.55, 0.22, 0.55), base * CFrame.new(0, 0.05, 0), Color3.fromRGB(112, 80, 50))
			part(model, Vector3.new(0.16, 0.12, 0.16), base * CFrame.new(0, 0.14, 0), Color3.fromRGB(226, 196, 120), Enum.PartType.Ball)
		elseif crop.Shape == "Grain" then
			-- Wheat: slender stalks, blade leaves, a plump golden head with whiskers.
			local height = 0.4 + growth * 2.4
			local stemColor = if ready then Color3.fromRGB(222, 196, 100) else stalk
			part(model, Vector3.new(0.1, height, 0.1), base * CFrame.new(0, height / 2, 0), stemColor, Enum.PartType.Block)
			for leaf = 1, 2 do
				sphere(Vector3.new(0.14, height * 0.45, 0.3), base * CFrame.Angles(0, leaf * math.pi, math.rad(28)) * CFrame.new(0, height * 0.25, 0), if ready then stemColor:Lerp(Color3.new(0, 0, 0), 0.1) else leafDark)
			end
			if stage >= 4 then
				local headColor = if ready then produce else stalk:Lerp(produce, 0.35)
				sphere(Vector3.new(0.28, 0.8, 0.28), base * CFrame.new(0, height + 0.3, 0), headColor)
				for awn = 1, 3 do
					part(model, Vector3.new(0.03, 0.5, 0.03), base * CFrame.new(0, height + 0.62, 0) * CFrame.Angles(math.rad(12), awn * 2.1, 0) * CFrame.new(0, 0.25, 0), headColor:Lerp(Color3.new(1, 1, 1), 0.2))
				end
			end
		elseif crop.Shape == "Root" then
			-- Carrot-style: a fan of feathery leaves; the root shoulder shows when ripe.
			local height = 0.3 + growth * 1.2
			for leaf = 1, 4 do
				sphere(Vector3.new(0.22, height, 0.4), base * CFrame.Angles(0, leaf * 1.57, math.rad(22)) * CFrame.new(0, height / 2, 0), if leaf % 2 == 0 then stalk else leafDark)
			end
			if ready then
				sphere(Vector3.new(0.55, 0.5, 0.55), base * CFrame.new(0, 0.1, 0), produce)
				sphere(Vector3.new(0.3, 0.14, 0.3), base * CFrame.new(-0.08, 0.3, -0.08), produce:Lerp(Color3.new(1, 1, 1), 0.3))
			end
		elseif crop.Shape == "Tall" then
			-- Corn-style: a tall stalk with broad drooping leaves and husked cobs.
			local height = 0.5 + growth * 3.6
			local stalkSize, upright = Vector3.new(height, 0.2, 0.2), CFrame.Angles(0, 0, math.rad(90))
			local stem = part(model, stalkSize, base * CFrame.new(0, height / 2, 0) * upright, stalk, Enum.PartType.Cylinder)
			stem.Size = stalkSize
			if stage >= 3 then
				for leaf = 1, 3 do
					local y = height * (0.3 + leaf * 0.18)
					sphere(Vector3.new(0.12, 0.3, 1.3), base * CFrame.new(0, y, 0) * CFrame.Angles(math.rad(-30), leaf * 2.2, 0) * CFrame.new(0, 0, -0.55), if leaf % 2 == 0 then stalk else leafDark)
				end
				sphere(Vector3.new(0.22, 0.5, 0.22), base * CFrame.new(0, height + 0.2, 0), Color3.fromRGB(226, 200, 120))
			end
			if ready then
				local cob = base * CFrame.new(0.18, height * 0.62, 0.1) * CFrame.Angles(0, 0, math.rad(-18))
				sphere(Vector3.new(0.38, 0.95, 0.38), cob, produce)
				sphere(Vector3.new(0.3, 0.8, 0.44), cob * CFrame.new(0.08, -0.12, 0), stalk:Lerp(Color3.fromRGB(255, 255, 200), 0.2))
			end
		else -- Bush
			-- Tomato-style: shaded leafy bush with shiny round fruit.
			local size = 0.3 + growth * 1.1
			sphere(Vector3.new(size * 1.1, size * 0.8, size * 1.1), base * CFrame.new(0, size * 0.35, 0), leafDark)
			sphere(Vector3.new(size * 0.8, size * 0.65, size * 0.8), base * CFrame.new(0, size * 0.62, 0), stalk)
			sphere(Vector3.new(size * 0.45, size * 0.3, size * 0.45), base * CFrame.new(-size * 0.1, size * 0.88, -size * 0.1), stalk:Lerp(Color3.fromRGB(255, 255, 200), 0.2))
			if ready then
				for berry = 1, 3 do
					local offset = CFrame.new(math.cos(berry * 2.1) * size * 0.45, size * 0.5, math.sin(berry * 2.1) * size * 0.45)
					local fruit = part(model, Vector3.one * 0.38, base * offset, produce, Enum.PartType.Ball)
					fruit.Reflectance = 0.08
					part(model, Vector3.new(0.12, 0.06, 0.12), base * offset * CFrame.new(0, 0.19, 0), leafDark)
				end
			end
		end
	end

	if ready then
		-- Gentle sparkle so ripe crops stand out (spec §150: subtle).
		local emitterPart = part(model, Vector3.new(3.6, 0.2, 3.6), top * CFrame.new(0, 1.5, 0), Color3.new(1, 1, 1))
		emitterPart.Transparency = 1
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Rate = 2
		sparkle.Lifetime = NumberRange.new(1, 1.5)
		sparkle.Speed = NumberRange.new(0.5, 1)
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
		sparkle.LightEmission = 1
		sparkle.Parent = emitterPart
	end
	return model
end

return CropModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">IslandBuilder</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandBuilder
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandBuilder
	DEPENDENCIES: Shared.Config.IslandConfig, Shared.Util.IslandGen,
	              Server.Island.{IslandProps, IslandTerrain}

	Builds the physical island for one slot from its saved data:
	  * the island Model and its standard folder layout,
	  * smooth terrain for every owned chunk (IslandTerrain),
	  * landmarks at the plaza (spawn pad, island sign, starter chest),
	  * cosmetic decoration scatter per chunk (flowers, tufts, shells...).

	Positions are island-local and converted with the slot origin, so the same
	island builds identically in any slot on any server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandGen = require(Shared.Util.IslandGen)
local IslandProps = require(script.Parent.IslandProps)
local IslandTerrain = require(script.Parent.IslandTerrain)

local IslandBuilder = {}

-- Folders every island model contains.
IslandBuilder.FolderNames = {
	"Terrain",
	"Props", -- non-blocking scenery
	"Landmarks", -- spawn pad: never built over
	"Interactables", -- sign, chest
	"Buildings",
	"Decorations", -- cosmetic scatter (never blocks anything)
	"Resources",
	"Crops",
	"Animals",
	"Production",
}

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.IgnoreWater = true

local function toWorld(origin: CFrame, localXZ: Vector2, y: number?): Vector3
	return (origin * CFrame.new(localXZ.X, y or 0, localXZ.Y)).Position
end

-- World CFrame on the terrain surface at an island-local XZ point.
function IslandBuilder.GroundCFrame(origin: CFrame, localXZ: Vector2, yawDegrees: number?): CFrame
	terrainParams.FilterDescendantsInstances = { workspace.Terrain }
	local top = toWorld(origin, localXZ, 80)
	local result = workspace:Raycast(top, Vector3.new(0, -160, 0), terrainParams)
	local y = if result then result.Position.Y else origin.Position.Y + IslandConfig.LandHeight
	return CFrame.new(top.X, y, top.Z) * CFrame.Angles(0, math.rad(yawDegrees or 0), 0)
end

-- Yaw (degrees) that makes a prop's -Z face from `from` towards `to` (island-local).
local function facing(from: Vector2, to: Vector2): number
	local direction = to - from
	return math.deg(math.atan2(-direction.X, -direction.Y))
end

local function customProp(name: string): Model?
	local islands = ServerStorage:FindFirstChild("Islands")
	local props = islands and islands:FindFirstChild("Props")
	local template = props and props:FindFirstChild(name)
	if template and template:IsA("Model") then
		return template:Clone()
	end
	return nil
end

local function place(model: Model, parent: Instance, cframe: CFrame): Model
	model:PivotTo(cframe)
	model.Parent = parent
	return model
end

export type BuiltIsland = {
	Sign: Model,
	Chest: Model,
	SpawnCFrame: CFrame,
}

function IslandBuilder.CreateModel(name: string, parent: Instance, origin: CFrame): (Model, { [string]: Folder })
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Default
	-- No PrimaryPart: pin the pivot to the island origin so clients can use
	-- island:GetPivot() as the origin of island-local coordinates.
	model.WorldPivot = origin
	local folders = {}
	for _, folderName in IslandBuilder.FolderNames do
		local folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = model
		folders[folderName] = folder
	end
	model.Parent = parent
	return model, folders
end

-- Decoration scatter for one chunk. Existing scatter for that chunk is replaced.
function IslandBuilder.DecorateChunk(origin: CFrame, folders: { [string]: Folder }, sampler: any, cx: number, cz: number)
	local key = IslandGen.Key(cx, cz)
	IslandBuilder.ClearChunkDeco(folders, key)
	for index, deco in IslandGen.ChunkDeco(sampler, cx, cz) do
		local model = IslandProps.Deco(deco.Kind, sampler.Data.Seed + cx * 131 + cz * 17 + index, deco.Scale)
		if model then
			model:SetAttribute("Chunk", key)
			place(model, folders.Decorations, IslandBuilder.GroundCFrame(origin, deco.Position, deco.Yaw))
		end
	end
end

function IslandBuilder.ClearChunkDeco(folders: { [string]: Folder }, key: string)
	for _, child in folders.Decorations:GetChildren() do
		if child:GetAttribute("Chunk") == key then
			child:Destroy()
		end
	end
end

-- Terrain + landmarks + decoration. Yields between decoration batches.
function IslandBuilder.Build(origin: CFrame, folders: { [string]: Folder }, sampler: any): BuiltIsland
	IslandTerrain.WriteAll(origin, sampler)

	local layout = IslandConfig.StarterLayout
	local spawnYaw = facing(layout.Spawn, layout.Spawn + layout.SpawnFacing)
	local spawnGround = IslandBuilder.GroundCFrame(origin, layout.Spawn, spawnYaw)
	place(customProp("SpawnPad") or IslandProps.SpawnPad(), folders.Landmarks, spawnGround)
	local spawnCFrame = spawnGround + Vector3.new(0, 4, 0)

	local sign = customProp("IslandSign") or IslandProps.Sign("My Island", "Island Level 1")
	place(sign, folders.Interactables, IslandBuilder.GroundCFrame(origin, layout.IslandSign, facing(layout.IslandSign, layout.Spawn)))

	local chest = customProp("StarterChest") or IslandProps.StarterChest()
	place(chest, folders.Interactables, IslandBuilder.GroundCFrame(origin, layout.StarterChest, facing(layout.StarterChest, layout.Spawn)))

	local count = 0
	for key, owned in sampler.Data.Chunks do
		local cx, cz = IslandGen.ParseKey(key)
		if owned and cx and cz then
			IslandBuilder.DecorateChunk(origin, folders, sampler, cx, cz)
			count += 1
			if count % 40 == 0 then
				task.wait()
			end
		end
	end

	return { Sign = sign, Chest = chest, SpawnCFrame = spawnCFrame }
end

return IslandBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">IslandProps</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandProps
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandProps
	DEPENDENCIES: none

	Procedural props for every island: the island sign, the starter chest,
	the spawn pad, and the small DECORATION scatter (flowers, tufts, shells,
	leaves, mushrooms, snowballs, pebbles) that makes each theme feel alive.

	Every builder returns an unparented Model with its pivot at the base
	(Y = 0), ready for :PivotTo(). Decorations are CanCollide/CanQuery false
	so they never block walking, building or clicking.

	To replace a prop with real art, put a Model with the same name in
	ServerStorage/Islands/Props (e.g. "StarterChest"); IslandBuilder uses it.
	The chest art needs a "Body" PrimaryPart and a "Lid" part.
]]

local IslandProps = {}

local COLORS = {
	Wood = Color3.fromRGB(176, 124, 76),
	WoodDark = Color3.fromRGB(118, 80, 48),
	SignBoard = Color3.fromRGB(226, 184, 124),
	ChestBody = Color3.fromRGB(160, 100, 55),
	Gold = Color3.fromRGB(255, 205, 70),
	Stone = Color3.fromRGB(214, 208, 196),
	StoneDark = Color3.fromRGB(150, 146, 140),
	Stem = Color3.fromRGB(70, 150, 60),
	Text = Color3.fromRGB(78, 50, 28),
}

local FLOWER_COLORS = {
	Color3.fromRGB(255, 110, 140),
	Color3.fromRGB(255, 214, 80),
	Color3.fromRGB(190, 130, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 70),
	Color3.fromRGB(110, 180, 255),
}

type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	CanCollide: boolean?,
	Transparency: number?,
	Mesh: string?, -- "Sphere" for a squashable ellipsoid
	Deco: boolean?, -- no collision, no queries, no shadow
}

local function part(parent: Instance, props: PartProps): Part
	local newPart = Instance.new("Part")
	newPart.Name = props.Name or "Part"
	newPart.Anchored = true
	newPart.Shape = props.Shape or Enum.PartType.Block
	newPart.Size = props.Size
	newPart.CFrame = props.CFrame
	newPart.Color = props.Color
	newPart.Material = props.Material or Enum.Material.SmoothPlastic
	newPart.CanCollide = if props.CanCollide == nil then not props.Deco else props.CanCollide
	newPart.Transparency = props.Transparency or 0
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	if props.Deco then
		newPart.CanQuery = false
		newPart.CanTouch = false
		newPart.CastShadow = false
	end
	if props.Mesh == "Sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = newPart
	end
	newPart.Parent = parent
	return newPart
end

local function newModel(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	return model
end

local function finish(model: Model): Model
	model.WorldPivot = CFrame.new()
	return model
end

local function textLabel(parent: Instance, name: string, text: string, size: UDim2, position: UDim2, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.Parent = parent
	return label
end

---------------------------------------------------------------------------
-- Landmarks
---------------------------------------------------------------------------

-- A sign whose readable face (Front / -Z) looks down -Z.
function IslandProps.Sign(title: string, subtitle: string): Model
	local model = newModel("IslandSign")
	for _, x in { -2.9, 2.9 } do
		part(model, { Name = "Post", Size = Vector3.new(0.55, 5.4, 0.55), CFrame = CFrame.new(x, 2.7, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
		part(model, { Name = "Cap", Size = Vector3.new(0.8, 0.3, 0.8), CFrame = CFrame.new(x, 5.5, 0), Color = COLORS.Wood, Material = Enum.Material.Wood })
	end
	local board = part(model, { Name = "Board", Size = Vector3.new(6.6, 3.2, 0.4), CFrame = CFrame.new(0, 3.9, -0.1), Color = COLORS.SignBoard, Material = Enum.Material.WoodPlanks })
	part(model, { Name = "Trim", Size = Vector3.new(6.9, 0.3, 0.5), CFrame = CFrame.new(0, 5.55, -0.1), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	part(model, { Name = "Trim", Size = Vector3.new(6.9, 0.3, 0.5), CFrame = CFrame.new(0, 2.25, -0.1), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	-- Flower boxes at the foot of the sign.
	for index, x in { -1.8, 0, 1.8 } do
		part(model, { Name = "Bloom", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.7, CFrame = CFrame.new(x, 0.55, -0.9), Color = FLOWER_COLORS[index], Deco = true })
	end
	part(model, { Name = "Planter", Size = Vector3.new(5.2, 0.5, 0.8), CFrame = CFrame.new(0, 0.25, -0.9), Color = COLORS.WoodDark, Material = Enum.Material.Wood })

	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.5
	gui.Parent = board
	textLabel(gui, "Title", title, UDim2.fromScale(0.92, 0.5), UDim2.fromScale(0.04, 0.06), COLORS.Text)
	textLabel(gui, "Subtitle", subtitle, UDim2.fromScale(0.92, 0.34), UDim2.fromScale(0.04, 0.6), COLORS.WoodDark)
	model.PrimaryPart = board
	return finish(model)
end

function IslandProps.SetSignText(sign: Model, title: string, subtitle: string)
	local board = sign:FindFirstChild("Board")
	local gui = board and board:FindFirstChild("SignGui")
	if not gui then
		return
	end
	local titleLabel = gui:FindFirstChild("Title")
	local subtitleLabel = gui:FindFirstChild("Subtitle")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
	end
	if subtitleLabel and subtitleLabel:IsA("TextLabel") then
		subtitleLabel.Text = subtitle
	end
end

function IslandProps.StarterChest(): Model
	local model = newModel("StarterChest")
	local body = part(model, { Name = "Body", Size = Vector3.new(3.4, 1.9, 2.3), CFrame = CFrame.new(0, 0.95, 0), Color = COLORS.ChestBody, Material = Enum.Material.WoodPlanks })
	for _, x in { -1.2, 1.2 } do
		part(model, { Name = "Band", Size = Vector3.new(0.32, 1.95, 2.35), CFrame = CFrame.new(x, 0.95, 0), Color = COLORS.Gold, Material = Enum.Material.Metal })
	end
	local lid = part(model, { Name = "Lid", Size = Vector3.new(3.5, 0.8, 2.4), CFrame = CFrame.new(0, 2.3, 0), Color = COLORS.ChestBody:Lerp(Color3.new(1, 1, 1), 0.08), Material = Enum.Material.WoodPlanks })
	part(model, { Name = "Lock", Size = Vector3.new(0.55, 0.65, 0.2), CFrame = CFrame.new(0, 1.8, -1.2), Color = COLORS.Gold, Material = Enum.Material.Metal, CanCollide = false })
	local sparkle = Instance.new("PointLight")
	sparkle.Name = "Glow"
	sparkle.Color = COLORS.Gold
	sparkle.Brightness = 1.5
	sparkle.Range = 8
	sparkle.Parent = body
	model.PrimaryPart = body
	lid:SetAttribute("ClosedOffset", body.CFrame:ToObjectSpace(lid.CFrame))
	return finish(model)
end

-- Rotates the lid open around its back edge and turns the glow off.
function IslandProps.OpenChest(chest: Model)
	local body = chest:FindFirstChild("Body")
	local lid = chest:FindFirstChild("Lid")
	if not body or not lid or not body:IsA("BasePart") or not lid:IsA("BasePart") then
		return
	end
	local closed = lid:GetAttribute("ClosedOffset")
	if typeof(closed) ~= "CFrame" then
		return
	end
	local hinge = body.CFrame * closed * CFrame.new(0, -lid.Size.Y / 2, lid.Size.Z / 2)
	lid.CFrame = hinge * CFrame.Angles(math.rad(100), 0, 0) * CFrame.new(0, lid.Size.Y / 2, -lid.Size.Z / 2)
	local lock = chest:FindFirstChild("Lock")
	if lock and lock:IsA("BasePart") then
		lock.Transparency = 1
	end
	local glow = body:FindFirstChild("Glow")
	if glow and glow:IsA("Light") then
		glow.Enabled = false
	end
end

function IslandProps.SpawnPad(): Model
	local model = newModel("SpawnPad")
	part(model, {
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.5, 10, 10),
		CFrame = CFrame.new(0, 0.25, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COLORS.Stone,
		Material = Enum.Material.Cobblestone,
	})
	part(model, {
		Name = "Inlay",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.52, 6.5, 6.5),
		CFrame = CFrame.new(0, 0.26, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COLORS.StoneDark,
		Material = Enum.Material.Slate,
		CanCollide = false,
	})
	local ring = part(model, {
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.54, 4, 4),
		CFrame = CFrame.new(0, 0.27, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 220, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.3,
	})
	local light = Instance.new("PointLight")
	light.Color = ring.Color
	light.Range = 10
	light.Brightness = 1.2
	light.Parent = ring
	-- Little lantern posts around the pad.
	for index = 0, 3 do
		local angle = index * math.pi / 2 + math.pi / 4
		local x, z = math.cos(angle) * 5.8, math.sin(angle) * 5.8
		part(model, { Name = "LanternPost", Size = Vector3.new(0.3, 2.4, 0.3), CFrame = CFrame.new(x, 1.2, z), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
		local lamp = part(model, { Name = "Lamp", Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(x, 2.6, z), Color = Color3.fromRGB(255, 220, 140), Material = Enum.Material.Neon, CanCollide = false })
		local lampLight = Instance.new("PointLight")
		lampLight.Color = lamp.Color
		lampLight.Range = 9
		lampLight.Brightness = 0.8
		lampLight.Parent = lamp
	end
	return finish(model)
end

---------------------------------------------------------------------------
-- Decorations (cosmetic scatter per chunk)
---------------------------------------------------------------------------

local DECO: { [string]: (model: Model, random: Random) -> () } = {}

DECO.Flowers = function(model, random)
	for _ = 1, random:NextInteger(5, 9) do
		local x, z = random:NextNumber(-2.2, 2.2), random:NextNumber(-2.2, 2.2)
		local stem = random:NextNumber(0.5, 1.1)
		part(model, { Name = "Stem", Size = Vector3.new(0.1, stem, 0.1), CFrame = CFrame.new(x, stem / 2, z), Color = COLORS.Stem, Deco = true })
		local color = FLOWER_COLORS[random:NextInteger(1, #FLOWER_COLORS)]
		part(model, { Name = "Bloom", Size = Vector3.new(0.55, 0.3, 0.55), CFrame = CFrame.new(x, stem + 0.05, z), Color = color, Mesh = "Sphere", Deco = true })
		part(model, { Name = "Heart", Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(x, stem + 0.2, z), Color = Color3.fromRGB(255, 225, 90), Mesh = "Sphere", Deco = true })
	end
end

local function tuft(model: Model, random: Random, color: Color3)
	for _ = 1, random:NextInteger(4, 7) do
		local height = random:NextNumber(0.8, 1.6)
		local lean = CFrame.Angles(math.rad(random:NextNumber(-25, 25)), math.rad(random:NextNumber(0, 360)), math.rad(random:NextNumber(-25, 25)))
		part(model, {
			Name = "Blade",
			Size = Vector3.new(0.12, height, 0.35),
			CFrame = CFrame.new(random:NextNumber(-0.6, 0.6), 0, random:NextNumber(-0.6, 0.6)) * lean * CFrame.new(0, height / 2, 0),
			Color = color:Lerp(Color3.new(1, 1, 0.6), random:NextNumber(0, 0.25)),
			Material = Enum.Material.Grass,
			Deco = true,
		})
	end
end

DECO.Tuft = function(model, random)
	tuft(model, random, Color3.fromRGB(80, 170, 60))
end

DECO.DryTuft = function(model, random)
	tuft(model, random, Color3.fromRGB(190, 165, 90))
end

DECO.Shells = function(model, random)
	local colors = { Color3.fromRGB(255, 220, 210), Color3.fromRGB(255, 190, 170), Color3.fromRGB(245, 240, 225) }
	for _ = 1, random:NextInteger(2, 4) do
		part(model, {
			Name = "Shell",
			Size = Vector3.new(0.6, 0.25, 0.5),
			CFrame = CFrame.new(random:NextNumber(-2, 2), 0.1, random:NextNumber(-2, 2)) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0),
			Color = colors[random:NextInteger(1, #colors)],
			Mesh = "Sphere",
			Deco = true,
		})
	end
	if random:NextNumber() < 0.4 then
		part(model, { Name = "Starfish", Size = Vector3.new(0.9, 0.12, 0.9), CFrame = CFrame.new(random:NextNumber(-1.5, 1.5), 0.06, random:NextNumber(-1.5, 1.5)) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0), Color = Color3.fromRGB(255, 120, 80), Mesh = "Sphere", Deco = true })
	end
end

DECO.Leaves = function(model, random)
	local colors = { Color3.fromRGB(235, 120, 40), Color3.fromRGB(215, 70, 40), Color3.fromRGB(245, 190, 60) }
	for _ = 1, random:NextInteger(6, 10) do
		part(model, {
			Name = "Leaf",
			Size = Vector3.new(0.6, 0.06, 0.45),
			CFrame = CFrame.new(random:NextNumber(-2.4, 2.4), 0.05, random:NextNumber(-2.4, 2.4)) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0),
			Color = colors[random:NextInteger(1, #colors)],
			Material = Enum.Material.Fabric,
			Deco = true,
		})
	end
end

DECO.Mushrooms = function(model, random)
	for _ = 1, random:NextInteger(2, 4) do
		local x, z = random:NextNumber(-1.2, 1.2), random:NextNumber(-1.2, 1.2)
		local height = random:NextNumber(0.4, 0.8)
		part(model, { Name = "Stalk", Size = Vector3.new(0.22, height, 0.22), CFrame = CFrame.new(x, height / 2, z), Color = Color3.fromRGB(245, 235, 215), Deco = true })
		part(model, { Name = "Cap", Size = Vector3.new(0.75, 0.4, 0.75), CFrame = CFrame.new(x, height, z), Color = Color3.fromRGB(215, 60, 50), Mesh = "Sphere", Deco = true })
	end
end

DECO.Snowball = function(model, random)
	for _ = 1, random:NextInteger(1, 3) do
		local size = random:NextNumber(0.6, 1.3)
		part(model, { Name = "Snow", Size = Vector3.new(size * 1.3, size * 0.7, size), CFrame = CFrame.new(random:NextNumber(-1.5, 1.5), size * 0.25, random:NextNumber(-1.5, 1.5)), Color = Color3.fromRGB(245, 250, 255), Material = Enum.Material.Snow, Mesh = "Sphere", Deco = true })
	end
end

DECO.Pebbles = function(model, random)
	for _ = 1, random:NextInteger(3, 6) do
		local size = random:NextNumber(0.3, 0.8)
		part(model, {
			Name = "Pebble",
			Size = Vector3.new(size * 1.3, size * 0.6, size),
			CFrame = CFrame.new(random:NextNumber(-1.6, 1.6), size * 0.2, random:NextNumber(-1.6, 1.6)) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0),
			Color = COLORS.StoneDark:Lerp(Color3.new(1, 1, 1), random:NextNumber(0, 0.3)),
			Material = Enum.Material.Slate,
			Mesh = "Sphere",
			Deco = true,
		})
	end
end

-- Cosmetic scatter model for a decoration kind (see IslandConfig theme Deco).
function IslandProps.Deco(kind: string, seed: number, scale: number): Model?
	local builder = DECO[kind]
	if not builder then
		return nil
	end
	local model = newModel("Deco_" .. kind)
	builder(model, Random.new(seed))
	finish(model)
	if scale ~= 1 then
		model:ScaleTo(scale)
	end
	return model
end

return IslandProps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">IslandTerrain</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandTerrain
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandTerrain
	DEPENDENCIES: Shared.Config.{IslandConfig, GameConfig}, Shared.Util.IslandGen

	Writes an island's smooth terrain from Shared/Util/IslandGen samples with
	ONE Terrain:WriteVoxels call per region (fast, no per-voxel API calls):

	  * above sea level: land voxels with fractional occupancy, so slopes and
	    beaches are smooth, and a surface material from the theme / paint,
	  * below sea level: seabed or water,
	  * Write(..., previousSampler, alpha) blends from the old island to the
	    new one — used for the "land rises out of the sea" expansion effect.

	Island origins sit on the 4-stud voxel grid at sea level (IslandLayout),
	so voxel layers line up exactly with the water surface.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local IslandConfig = require(Shared.Config.IslandConfig)
local GameConfig = require(Shared.Config.GameConfig)

local IslandTerrain = {}

local RES = 4
local Y_MIN = -16
local Y_MAX = 36
local SUBSURFACE: { [string]: string } = {
	Sand = "Sand",
	Salt = "Sand",
	Sandstone = "Sandstone",
	Snow = "Rock",
	Rock = "Rock",
	Slate = "Slate",
}

local materialCache: { [string]: Enum.Material } = {}
local function materialOf(name: string): Enum.Material
	local material = materialCache[name]
	if not material then
		local ok, value = pcall(function()
			return (Enum.Material :: any)[name]
		end)
		material = if ok and value then value else Enum.Material.Grass
		materialCache[name] = material
	end
	return material
end

local function alignDown(value: number): number
	return math.floor(value / RES) * RES
end

local function alignUp(value: number): number
	return math.ceil(value / RES) * RES
end

-- Island-local bounds of the whole island grid (plus a margin for beaches).
function IslandTerrain.FullBounds(): (number, number, number, number)
	local extent = (IslandConfig.GridRadius + 1.5) * IslandConfig.ChunkSize
	return -extent, extent, -extent, extent
end

-- Island-local bounds around one chunk (neighbours' coasts change too).
function IslandTerrain.ChunkBounds(cx: number, cz: number, margin: number?): (number, number, number, number)
	local size = IslandConfig.ChunkSize
	local reach = size * (0.5 + (margin or 3))
	return cx * size - reach, cx * size + reach, cz * size - reach, cz * size + reach
end

-- Writes terrain for island-local rectangle [minX, maxX] x [minZ, maxZ].
-- previous/alpha: optional blend from an older island shape (0 = old, 1 = new).
function IslandTerrain.Write(origin: CFrame, sampler: any, minX: number, maxX: number, minZ: number, maxZ: number, previous: any?, alpha: number?)
	local terrain = workspace.Terrain :: Terrain
	local base = origin.Position
	local x0 = alignDown(base.X + minX)
	local x1 = alignUp(base.X + maxX)
	local z0 = alignDown(base.Z + minZ)
	local z1 = alignUp(base.Z + maxZ)
	local y0 = alignDown(base.Y + Y_MIN)
	local y1 = alignUp(base.Y + Y_MAX)
	local nx = (x1 - x0) // RES
	local ny = (y1 - y0) // RES
	local nz = (z1 - z0) // RES
	local theme = sampler.Theme
	local seabed = materialOf(theme.Seabed)
	local water = Enum.Material.Water
	local air = Enum.Material.Air
	local blend = alpha or 1

	local materials = table.create(nx)
	local occupancies = table.create(nx)
	for i = 1, nx do
		local materialPlane = table.create(ny)
		local occupancyPlane = table.create(ny)
		for j = 1, ny do
			materialPlane[j] = table.create(nz, air)
			occupancyPlane[j] = table.create(nz, 0)
		end
		materials[i] = materialPlane
		occupancies[i] = occupancyPlane
	end

	for i = 1, nx do
		local localX = x0 + (i - 0.5) * RES - base.X
		for k = 1, nz do
			local localZ = z0 + (k - 0.5) * RES - base.Z
			local sample = sampler:Sample(localX, localZ)
			local height = sample.Height
			if previous and blend < 1 then
				local old = previous:Sample(localX, localZ).Height
				height = old + (height - old) * blend
			end
			local surface = materialOf(sample.Material)
			local subsurface = materialOf(SUBSURFACE[sample.Material] or "Ground")
			for j = 1, ny do
				local bottom = y0 + (j - 1) * RES - base.Y
				local fill = math.clamp((height - bottom) / RES, 0, 1)
				if bottom < 0 then
					-- Underwater layer: solid seabed or water (no air pockets in the sea).
					if fill >= 0.5 then
						materials[i][j][k] = if height - bottom <= RES * 1.5 then (if height > -1 then surface else seabed) else subsurface
						occupancies[i][j][k] = 1
					else
						materials[i][j][k] = water
						occupancies[i][j][k] = 1
					end
				elseif fill > 0 then
					materials[i][j][k] = if height - bottom <= RES then surface else subsurface
					occupancies[i][j][k] = fill
				end
			end
		end
	end

	local region = Region3.new(Vector3.new(x0, y0, z0), Vector3.new(x1, y1, z1))
	terrain:WriteVoxels(region, RES, materials, occupancies)
end

-- Writes the whole island in one go.
function IslandTerrain.WriteAll(origin: CFrame, sampler: any)
	local minX, maxX, minZ, maxZ = IslandTerrain.FullBounds()
	IslandTerrain.Write(origin, sampler, minX, maxX, minZ, maxZ)
end

-- Restores open ocean over the whole island area (player left).
function IslandTerrain.Clear(origin: CFrame)
	local terrain = workspace.Terrain :: Terrain
	local minX, maxX, minZ, maxZ = IslandTerrain.FullBounds()
	local base = origin.Position
	local center = Vector3.new(base.X + (minX + maxX) / 2, 0, base.Z + (minZ + maxZ) / 2)
	local size = Vector3.new(maxX - minX + 8, 0, maxZ - minZ + 8)
	local sea = base.Y
	local world = GameConfig.World
	local above = Y_MAX + 8
	terrain:FillBlock(CFrame.new(center.X, sea + above / 2, center.Z), Vector3.new(size.X, above, size.Z), Enum.Material.Air)
	terrain:FillBlock(CFrame.new(center.X, sea - world.OceanDepth / 2, center.Z), Vector3.new(size.X, world.OceanDepth, size.Z), Enum.Material.Water)
	terrain:FillBlock(CFrame.new(center.X, sea - world.OceanDepth - world.SeabedThickness / 2, center.Z), Vector3.new(size.X, world.SeabedThickness, size.Z), Enum.Material.Sand)
end

return IslandTerrain
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">NodeModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  NodeModels
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/NodeModels
	DEPENDENCIES: none

	Procedural resource-node models: oak, pine, snowy pine, palm, maple,
	ancient tree, cactus, rocks, iron, crystal, fiber bush, sand, clay.
	Cartoon-realistic: soft smooth colours, ellipsoid canopies with light
	tops and darker undersides (painted-on shading), branches reaching into
	the leaves, tapered wood-textured trunks, rocks with highlights and
	pebbles, flowers and berries for a little life.

	Each model:
	  * is built around the origin with its base at Y = 0,
	  * has an invisible "Hitbox" PrimaryPart (click target + build blocking),
	  * stores BaseTransparency / BaseCanCollide so pooling can hide/show it.
	Put a Model named after the node's Model key in ServerStorage/Resources
	to use real art instead (keep a Hitbox part).
]]

local ServerStorage = game:GetService("ServerStorage")

local NodeModels = {}

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local function part(model: Model, props: { [string]: any }): BasePart
	local newPart = Instance.new("Part")
	newPart.Anchored = true
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	newPart.Material = Enum.Material.SmoothPlastic
	-- Shape first: changing Shape afterwards can resize the part.
	if props.Shape then
		newPart.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" and key ~= "Mesh" then
			(newPart :: any)[key] = value
		end
	end
	if props.Mesh == "Sphere" then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = newPart
	end
	newPart:SetAttribute("BaseTransparency", newPart.Transparency)
	newPart:SetAttribute("BaseCanCollide", newPart.CanCollide)
	newPart.Parent = model
	return newPart
end

local function hitbox(model: Model, size: Vector3)
	local box = part(model, {
		Name = "Hitbox",
		Size = size,
		CFrame = CFrame.new(0, size.Y / 2, 0),
		Transparency = 1,
		CanCollide = false,
	})
	-- Model pivot = the node's base on the ground (not the hitbox centre).
	box.PivotOffset = CFrame.new(0, -size.Y / 2, 0)
	model.PrimaryPart = box
end

-- Tapered trunk: two stacked cylinders + a root flare.
local function trunk(model: Model, height: number, diameter: number, color: Color3)
	local lower = height * 0.55
	part(model, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(lower, diameter, diameter), CFrame = CFrame.new(0, lower / 2, 0) * UPRIGHT, Color = color, Material = Enum.Material.Wood })
	part(model, {
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height - lower + 0.4, diameter * 0.78, diameter * 0.78),
		CFrame = CFrame.new(0, lower + (height - lower) / 2 - 0.2, 0) * UPRIGHT,
		Color = color:Lerp(Color3.new(1, 1, 1), 0.05),
		Material = Enum.Material.Wood,
	})
	part(model, { Name = "Roots", Size = Vector3.new(diameter * 1.8, 0.9, diameter * 1.8), CFrame = CFrame.new(0, 0.2, 0), Color = color:Lerp(Color3.new(0, 0, 0), 0.1), Material = Enum.Material.Wood, Mesh = "Sphere", CanCollide = false })
end

local function canopy(model: Model, random: Random, center: Vector3, radius: number, colors: { Color3 }, count: number, material: Enum.Material?)
	local base = colors[1]
	local leafMaterial = material or Enum.Material.SmoothPlastic
	for index = 1, count do
		local angle = random:NextNumber(0, math.pi * 2)
		local spread = if index == 1 then 0 else random:NextNumber(0.35, 0.75) * radius
		local size = radius * (if index == 1 then 2 else random:NextNumber(1.1, 1.5))
		part(model, {
			Name = "Leaves",
			Size = Vector3.new(size, size * random:NextNumber(0.72, 0.9), size),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * spread, random:NextNumber(-0.6, 0.8), math.sin(angle) * spread)),
			Color = colors[(index - 1) % #colors + 1],
			Material = leafMaterial,
			Mesh = "Sphere",
			CanCollide = false,
		})
	end
	-- Painted-on shading: darker clumps underneath, sunlit clumps on top.
	for index = 1, 3 do
		local angle = index * 2.1 + random:NextNumber(-0.4, 0.4)
		local size = radius * random:NextNumber(1.0, 1.3)
		part(model, {
			Name = "LeavesShade",
			Size = Vector3.new(size, size * 0.6, size),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * radius * 0.55, -radius * 0.55, math.sin(angle) * radius * 0.55)),
			Color = base:Lerp(Color3.new(0, 0, 0), 0.22),
			Material = leafMaterial,
			Mesh = "Sphere",
			CanCollide = false,
		})
	end
	for index = 1, 4 do
		local angle = index * 1.6 + random:NextNumber(-0.3, 0.3)
		local size = radius * random:NextNumber(0.7, 0.95)
		part(model, {
			Name = "LeavesLight",
			Size = Vector3.new(size, size * 0.75, size),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * radius * 0.4, radius * random:NextNumber(0.45, 0.7), math.sin(angle) * radius * 0.4)),
			Color = base:Lerp(Color3.fromRGB(255, 255, 200), 0.22),
			Material = leafMaterial,
			Mesh = "Sphere",
			CanCollide = false,
		})
	end
end

-- A few branches reaching from the trunk top into the canopy.
local function branches(model: Model, random: Random, from: Vector3, radius: number, color: Color3)
	for index = 1, 3 do
		local angle = index * 2.1 + random:NextNumber(-0.3, 0.3)
		local target = from + Vector3.new(math.cos(angle) * radius * 0.7, radius * 0.6, math.sin(angle) * radius * 0.7)
		local length = (target - from).Magnitude
		local middle = (from + target) / 2
		part(model, {
			Name = "Branch",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(length, 0.5, 0.5),
			CFrame = CFrame.lookAt(middle, target) * CFrame.Angles(0, math.rad(90), 0),
			Color = color,
			Material = Enum.Material.Wood,
			CanCollide = false,
		})
	end
end

local BUILDERS: { [string]: (Model, Random) -> () } = {}

BUILDERS.Oak = function(model, random)
	local height = random:NextNumber(6, 7.5)
	trunk(model, height, 1.5, Color3.fromRGB(122, 86, 56))
	branches(model, random, Vector3.new(0, height - 0.5, 0), 3.3, Color3.fromRGB(112, 78, 50))
	canopy(model, random, Vector3.new(0, height + 1.8, 0), 3.3, { Color3.fromRGB(86, 176, 72), Color3.fromRGB(104, 192, 84), Color3.fromRGB(72, 156, 62) }, 5)
	-- A couple of red apples peeking out.
	for index = 1, 3 do
		local angle = index * 2.2 + random:NextNumber(-0.3, 0.3)
		part(model, { Name = "Apple", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.55, CFrame = CFrame.new(math.cos(angle) * 3.1, height + 0.9 + random:NextNumber(0, 1.2), math.sin(angle) * 3.1), Color = Color3.fromRGB(226, 52, 48), CanCollide = false })
	end
	hitbox(model, Vector3.new(3, height + 2, 3))
end

BUILDERS.Maple = function(model, random)
	local height = random:NextNumber(6, 7.5)
	trunk(model, height, 1.4, Color3.fromRGB(96, 66, 50))
	branches(model, random, Vector3.new(0, height - 0.5, 0), 3.2, Color3.fromRGB(86, 58, 44))
	canopy(model, random, Vector3.new(0, height + 1.8, 0), 3.2, { Color3.fromRGB(236, 120, 40), Color3.fromRGB(214, 70, 42), Color3.fromRGB(246, 180, 60) }, 5)
	-- Fallen leaves around the base.
	for index = 1, 5 do
		local angle = index * 1.3 + random:NextNumber(-0.3, 0.3)
		part(model, { Name = "FallenLeaf", Size = Vector3.new(0.7, 0.08, 0.5), CFrame = CFrame.new(math.cos(angle) * random:NextNumber(1.4, 2.6), 0.05, math.sin(angle) * random:NextNumber(1.4, 2.6)) * CFrame.Angles(0, angle, 0), Color = if index % 2 == 0 then Color3.fromRGB(236, 120, 40) else Color3.fromRGB(246, 180, 60), Mesh = "Sphere", CanCollide = false })
	end
	hitbox(model, Vector3.new(3, height + 2, 3))
end

BUILDERS.Ancient = function(model, random)
	trunk(model, 10, 2.8, Color3.fromRGB(96, 72, 62))
	branches(model, random, Vector3.new(0, 9, 0), 4.6, Color3.fromRGB(88, 66, 56))
	canopy(model, random, Vector3.new(0, 12.5, 0), 4.6, { Color3.fromRGB(90, 200, 170), Color3.fromRGB(70, 170, 150), Color3.fromRGB(120, 220, 190) }, 6)
	local glow = part(model, { Name = "Glow", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(0, 12, 0), Transparency = 1, CanCollide = false })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(140, 255, 210)
	light.Range = 14
	light.Brightness = 1
	light.Parent = glow
	hitbox(model, Vector3.new(4, 11, 4))
end

-- Stacked, drooping tiers of needles (dark underside, light top) + a tip.
local function pineLayers(model: Model, random: Random, height: number, colors: { Color3 }, snow: boolean)
	local tiers = 6
	local topY = height * 0.35
	for index = 1, tiers do
		local width = 6.6 - index * 0.95
		local y = height * 0.35 + index * 1.35
		topY = y
		local color = colors[(index - 1) % #colors + 1]
		part(model, {
			Name = "NeedlesUnder",
			Size = Vector3.new(width * 1.02, 1.1, width * 1.02),
			CFrame = CFrame.new(0, y - 0.55, 0),
			Color = color:Lerp(Color3.new(0, 0, 0), 0.25),
			Mesh = "Sphere",
			CanCollide = false,
		})
		part(model, {
			Name = "Needles",
			Size = Vector3.new(width, 1.9, width),
			CFrame = CFrame.new(0, y, 0) * CFrame.Angles(0, random:NextNumber(0, 6.28), 0),
			Color = color,
			Mesh = "Sphere",
			CanCollide = false,
		})
		if snow then
			part(model, {
				Name = "Snow",
				Size = Vector3.new(width * 0.78, 0.6, width * 0.78),
				CFrame = CFrame.new(0, y + 0.72, 0),
				Color = Color3.fromRGB(250, 253, 255),
				Mesh = "Sphere",
				CanCollide = false,
			})
		end
	end
	part(model, { Name = "Tip", Size = Vector3.new(1.1, 1.8, 1.1), CFrame = CFrame.new(0, topY + 1.3, 0), Color = if snow then Color3.fromRGB(250, 253, 255) else colors[1]:Lerp(Color3.new(1, 1, 1), 0.15), Mesh = "Sphere", CanCollide = false })
end

BUILDERS.Pine = function(model, random)
	local height = random:NextNumber(7, 8.5)
	trunk(model, height, 1.2, Color3.fromRGB(104, 70, 45))
	pineLayers(model, random, height, { Color3.fromRGB(42, 124, 72), Color3.fromRGB(52, 138, 80), Color3.fromRGB(38, 112, 66) }, false)
	hitbox(model, Vector3.new(2.6, height, 2.6))
end

BUILDERS.SnowPine = function(model, random)
	local height = random:NextNumber(7, 8.5)
	trunk(model, height, 1.2, Color3.fromRGB(96, 70, 52))
	pineLayers(model, random, height, { Color3.fromRGB(46, 110, 84), Color3.fromRGB(56, 124, 92) }, true)
	hitbox(model, Vector3.new(2.6, height, 2.6))
end

BUILDERS.Palm = function(model, random)
	local segments = 6
	local height = random:NextNumber(10, 13)
	local segmentHeight = height / segments
	local lean = random:NextNumber(0.12, 0.25)
	local direction = random:NextNumber(0, math.pi * 2)
	local position = Vector3.zero
	for index = 1, segments do
		local bend = lean * index * 0.5
		local offset = Vector3.new(math.cos(direction) * bend, segmentHeight, math.sin(direction) * bend)
		local center = position + offset / 2
		local thickness = 1.25 - index * 0.09
		part(model, {
			Name = "Trunk",
			Size = Vector3.new(thickness, segmentHeight + 0.25, thickness),
			CFrame = CFrame.lookAt(center, center + offset) * CFrame.Angles(-math.pi / 2, 0, 0),
			Color = if index % 2 == 0 then Color3.fromRGB(168, 126, 80) else Color3.fromRGB(146, 106, 66),
			Material = Enum.Material.Wood,
		})
		position += offset
	end
	for index = 1, 8 do
		-- Each frond rises from the crown, then droops at the tip.
		local angle = (index / 8) * math.pi * 2 + random:NextNumber(-0.2, 0.2)
		local color = if index % 2 == 0 then Color3.fromRGB(76, 178, 82) else Color3.fromRGB(56, 152, 68)
		local crown = CFrame.new(position) * CFrame.Angles(0, angle, 0)
		part(model, { Name = "Frond", Size = Vector3.new(1.6, 0.22, 3.4), CFrame = crown * CFrame.Angles(math.rad(18), 0, 0) * CFrame.new(0, 0, -1.6), Color = color, Mesh = "Sphere", CanCollide = false })
		part(model, { Name = "FrondTip", Size = Vector3.new(1.35, 0.2, 3.4), CFrame = crown * CFrame.Angles(math.rad(18), 0, 0) * CFrame.new(0, 0, -3.1) * CFrame.Angles(math.rad(-42), 0, 0) * CFrame.new(0, 0, -1.4), Color = color:Lerp(Color3.fromRGB(255, 255, 200), 0.1), Mesh = "Sphere", CanCollide = false })
	end
	for index = 1, 3 do
		local angle = index * 2.1
		part(model, {
			Name = "Coconut",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.85,
			CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 0.6, -0.6, math.sin(angle) * 0.6)),
			Color = Color3.fromRGB(112, 80, 46),
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(2.4, height, 2.4))
end

BUILDERS.Cactus = function(model, random)
	local height = random:NextNumber(4.5, 6.5)
	local green = Color3.fromRGB(80, 160, 90)
	part(model, { Name = "Body", Size = Vector3.new(1.6, height + 0.4, 1.6), CFrame = CFrame.new(0, height / 2, 0), Color = green, Mesh = "Sphere" })
	part(model, { Name = "Body", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height * 0.85, 1.45, 1.45), CFrame = CFrame.new(0, height * 0.42, 0) * UPRIGHT, Color = green })
	-- Light ribs down the body.
	for index = 1, 4 do
		local angle = index * math.pi / 2
		part(model, { Name = "Rib", Size = Vector3.new(0.18, height * 0.9, 0.18), CFrame = CFrame.new(math.cos(angle) * 0.72, height * 0.48, math.sin(angle) * 0.72), Color = green:Lerp(Color3.new(1, 1, 1), 0.18), Mesh = "Sphere", CanCollide = false })
	end
	for _, side in { -1, 1 } do
		local armHeight = random:NextNumber(1.6, 2.4)
		local armY = random:NextNumber(height * 0.35, height * 0.6)
		part(model, { Name = "ArmOut", Size = Vector3.new(1.3, 0.8, 0.8), CFrame = CFrame.new(side * 1.1, armY, 0), Color = green, Mesh = "Sphere" })
		part(model, { Name = "ArmUp", Size = Vector3.new(0.85, armHeight, 0.85), CFrame = CFrame.new(side * 1.5, armY + armHeight / 2, 0), Color = green, Mesh = "Sphere" })
	end
	-- Tiny spines.
	for index = 1, 10 do
		local angle = index * 2.4
		part(model, { Name = "Spine", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.14, CFrame = CFrame.new(math.cos(angle) * 0.8, 0.8 + (index / 10) * height * 0.85, math.sin(angle) * 0.8), Color = Color3.fromRGB(250, 246, 220), CanCollide = false })
	end
	part(model, { Name = "Flower", Size = Vector3.new(0.8, 0.4, 0.8), CFrame = CFrame.new(0, height + 0.1, 0), Color = Color3.fromRGB(255, 120, 160), Mesh = "Sphere", CanCollide = false })
	hitbox(model, Vector3.new(2.4, height, 2.4))
end

-- A chunky boulder pile: shaded body, sunlit highlights, moss and pebbles.
local function rockPile(model: Model, random: Random, color: Color3, scale: number)
	for index = 1, 4 do
		local size = Vector3.new(random:NextNumber(2.2, 3.4), random:NextNumber(1.6, 2.6), random:NextNumber(2.2, 3.4)) * scale * (if index == 1 then 1.2 else 0.8)
		local position = Vector3.new(random:NextNumber(-1, 1), size.Y * 0.35, random:NextNumber(-1, 1))
		local shade = color:Lerp(Color3.new(1, 1, 1), (index - 1) * 0.05)
		part(model, {
			Name = "Rock",
			Size = size,
			CFrame = CFrame.new(position) * CFrame.Angles(random:NextNumber(-0.3, 0.3), random:NextNumber(0, math.pi), random:NextNumber(-0.3, 0.3)),
			Color = shade,
			Mesh = "Sphere",
		})
		-- Sunlit top facet.
		part(model, {
			Name = "RockLight",
			Size = Vector3.new(size.X * 0.62, size.Y * 0.35, size.Z * 0.6),
			CFrame = CFrame.new(position + Vector3.new(-size.X * 0.08, size.Y * 0.3, -size.Z * 0.05)),
			Color = shade:Lerp(Color3.new(1, 1, 1), 0.22),
			Mesh = "Sphere",
			CanCollide = false,
		})
	end
	-- Moss on top and pebbles around the base.
	part(model, { Name = "Moss", Size = Vector3.new(1.6, 0.4, 1.4) * scale, CFrame = CFrame.new(0.2, 2.1 * scale, 0), Color = Color3.fromRGB(104, 168, 76), Mesh = "Sphere", CanCollide = false })
	for index = 1, 5 do
		local angle = index * 1.25 + random:NextNumber(-0.3, 0.3)
		local pebble = random:NextNumber(0.35, 0.6) * scale
		part(model, { Name = "Pebble", Size = Vector3.new(pebble, pebble * 0.6, pebble * 0.9), CFrame = CFrame.new(math.cos(angle) * 2.4 * scale, pebble * 0.2, math.sin(angle) * 2.4 * scale), Color = color:Lerp(Color3.new(1, 1, 1), 0.12), Mesh = "Sphere", CanCollide = false })
	end
end

BUILDERS.Rock = function(model, random)
	rockPile(model, random, Color3.fromRGB(138, 134, 128), 1)
	hitbox(model, Vector3.new(4.4, 3, 4.4))
end

BUILDERS.Iron = function(model, random)
	rockPile(model, random, Color3.fromRGB(108, 104, 100), 1.1)
	for _ = 1, 6 do
		part(model, {
			Name = "Ore",
			Size = Vector3.one * random:NextNumber(0.6, 0.95),
			CFrame = CFrame.new(random:NextNumber(-1.4, 1.4), random:NextNumber(1, 2.4), random:NextNumber(-1.4, 1.4)),
			Color = Color3.fromRGB(214, 128, 78),
			Material = Enum.Material.SmoothPlastic,
			Mesh = "Sphere",
			Reflectance = 0.15,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(4.6, 3.2, 4.6))
end

BUILDERS.Crystal = function(model, random)
	rockPile(model, random, Color3.fromRGB(90, 85, 110), 0.9)
	for index = 1, 5 do
		local height = random:NextNumber(2.2, 3.8)
		local crystalCFrame = CFrame.new(random:NextNumber(-1, 1), 1.4 + height / 2, random:NextNumber(-1, 1)) * CFrame.Angles(random:NextNumber(-0.4, 0.4), index, random:NextNumber(-0.4, 0.4))
		part(model, {
			Name = "Crystal",
			Size = Vector3.new(0.7, height, 0.7),
			CFrame = crystalCFrame,
			Color = Color3.fromRGB(130, 230, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.2,
			Reflectance = 0.2,
			CanCollide = false,
		})
		-- Glowing core inside each crystal.
		part(model, {
			Name = "CrystalCore",
			Size = Vector3.new(0.32, height * 0.8, 0.32),
			CFrame = crystalCFrame,
			Color = Color3.fromRGB(180, 245, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.3,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(4, 4, 4))
end

BUILDERS.Bush = function(model, random)
	for index = 1, 4 do
		local size = random:NextNumber(2, 2.8)
		part(model, {
			Name = "Bush",
			Size = Vector3.new(size, size * 0.8, size),
			CFrame = CFrame.new(math.cos(index * 1.7) * 0.8, 0.9, math.sin(index * 1.7) * 0.8),
			Color = Color3.fromRGB(90, 156 + index * 8, 70),
			Mesh = "Sphere",
			CanCollide = false,
		})
	end
	-- Little white flowers dotted on the bush.
	for index = 1, 5 do
		local angle = index * 1.3
		part(model, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.35, CFrame = CFrame.new(math.cos(angle) * 1.2, 1.5 + (index % 2) * 0.35, math.sin(angle) * 1.2), Color = Color3.fromRGB(255, 250, 236), CanCollide = false })
	end
	for index = 1, 6 do
		part(model, {
			Name = "Fiber",
			Size = Vector3.new(0.12, 1.5, 0.12),
			CFrame = CFrame.new(math.cos(index) * 0.7, 2.1, math.sin(index) * 0.7) * CFrame.Angles(0.2, index, 0.2),
			Color = Color3.fromRGB(232, 214, 140),
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(3, 2.6, 3))
end

BUILDERS.Sand = function(model, random)
	part(model, { Name = "Pile", Size = Vector3.new(4.2, 1.6, 4.2), CFrame = CFrame.new(0, 0.4, 0), Color = Color3.fromRGB(240, 220, 160), Material = Enum.Material.Sand, Mesh = "Sphere" })
	part(model, { Name = "Top", Size = Vector3.new(2.6, 1.2, 2.6), CFrame = CFrame.new(0.2, 1, 0.1), Color = Color3.fromRGB(246, 230, 178), Material = Enum.Material.Sand, Mesh = "Sphere" })
	part(model, { Name = "Shell", Size = Vector3.new(0.6, 0.3, 0.5), CFrame = CFrame.new(0.8, 1.3, -0.4) * CFrame.Angles(0, random:NextNumber(0, 6), 0), Color = Color3.fromRGB(255, 200, 190), Mesh = "Sphere", CanCollide = false })
	hitbox(model, Vector3.new(4, 1.6, 4))
end

BUILDERS.Clay = function(model, _random)
	part(model, { Name = "Clay", Size = Vector3.new(4.2, 0.7, 4.2), CFrame = CFrame.new(0, 0.15, 0), Color = Color3.fromRGB(186, 112, 76), Material = Enum.Material.Mud, Mesh = "Sphere" })
	part(model, { Name = "Lump", Size = Vector3.new(1.2, 0.9, 1.1), CFrame = CFrame.new(-0.6, 0.45, 0.4), Color = Color3.fromRGB(170, 100, 70), Material = Enum.Material.Mud, Mesh = "Sphere" })
	part(model, { Name = "Lump", Size = Vector3.new(0.9, 0.7, 0.9), CFrame = CFrame.new(0.8, 0.35, -0.5), Color = Color3.fromRGB(176, 106, 72), Material = Enum.Material.Mud, Mesh = "Sphere" })
	hitbox(model, Vector3.new(4, 1.2, 4))
end

-- seed keeps each node's random shape stable across servers.
function NodeModels.Build(modelKey: string, seed: number): Model
	local folder = ServerStorage:FindFirstChild("Resources")
	local art = folder and folder:FindFirstChild(modelKey)
	if art and art:IsA("Model") and art:FindFirstChild("Hitbox") then
		local clone = art:Clone()
		clone.PrimaryPart = clone:FindFirstChild("Hitbox") :: BasePart
		for _, descendant in clone:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant:SetAttribute("BaseTransparency", descendant.Transparency)
				descendant:SetAttribute("BaseCanCollide", descendant.CanCollide)
			end
		end
		clone.WorldPivot = CFrame.new()
		return clone
	end

	local model = Instance.new("Model")
	model.Name = modelKey
	local builder = BUILDERS[modelKey] or BUILDERS.Rock
	builder(model, Random.new(seed))
	model.WorldPivot = CFrame.new()
	return model
end

-- Hide / show a pooled node without destroying it (hidden nodes can't be clicked).
function NodeModels.SetVisible(model: Model, visible: boolean)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local baseTransparency = descendant:GetAttribute("BaseTransparency")
			local baseCollide = descendant:GetAttribute("BaseCanCollide")
			descendant.Transparency = if visible then (if type(baseTransparency) == "number" then baseTransparency else 0) else 1
			descendant.CanCollide = visible and baseCollide == true
			descendant.CanQuery = visible
		elseif descendant:IsA("Light") then
			descendant.Enabled = visible
		end
	end
end

return NodeModels
]]></string>
