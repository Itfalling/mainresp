      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Net
	SCRIPT TYPE:  ModuleScript (shared networking layer)
	WHERE:        ReplicatedStorage/Shared/Net
	DEPENDENCIES: Shared.Config.RemoteConfig, Shared.Util.RateLimiter
	REQUIRED OBJECTS: none (the server creates ReplicatedStorage/Remotes)

	The only module allowed to touch RemoteEvents.
	  * Server: Net.Init() creates every remote listed in RemoteConfig.
	  * Unknown remote names error immediately (no random remote creation).
	  * Every client->server handler is automatically rate limited and wrapped
	    in pcall; violations are reported to AntiExploitService.
	  * After all services start, Net.FinalizeHandlers() drains remotes that no
	    phase handles yet, flagging clients that fire them.

	Server API:  Net.Init(), Net.OnServerEvent(name, fn(player, ...)),
	             Net.FireClient(name, player, ...), Net.FireAllClients(name, ...),
	             Net.FireClients(name, players, ...), Net.SetViolationHandler(fn),
	             Net.FinalizeHandlers()
	Client API:  Net.FireServer(name, ...), Net.OnClientEvent(name, fn(...))
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local RemoteConfig = require(script.Parent.Config.RemoteConfig)
local RateLimiter = require(script.Parent.Util.RateLimiter)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"
local CLIENT_WAIT_TIMEOUT = 60

type ViolationHandler = (player: Player, reason: string, weight: number) -> ()

local Net = {}

local folder: Folder? = nil
local remotes: { [string]: RemoteEvent } = {}
local handledOnServer: { [string]: boolean } = {}
local violationHandler: ViolationHandler? = nil

local function reportViolation(player: Player, reason: string, weight: number)
	if violationHandler then
		violationHandler(player, reason, weight)
	end
end

local function getRemote(name: string): RemoteEvent
	local cached = remotes[name]
	if cached then
		return cached
	end
	assert(RemoteConfig.Known[name], ("[Net] Unknown remote '%s' — add it to RemoteConfig"):format(tostring(name)))

	if IS_SERVER then
		assert(folder, "[Net] Net.Init() must run on the server before remotes are used")
		local remote = folder:FindFirstChild(name)
		assert(remote and remote:IsA("RemoteEvent"), "[Net] Remote missing: " .. name)
		remotes[name] = remote
		return remote
	end

	if not folder then
		local found = ReplicatedStorage:WaitForChild(FOLDER_NAME, CLIENT_WAIT_TIMEOUT)
		assert(found and found:IsA("Folder"), "[Net] ReplicatedStorage.Remotes never appeared (is the server running?)")
		folder = found
	end
	assert(folder)
	local remote = folder:WaitForChild(name, CLIENT_WAIT_TIMEOUT)
	assert(remote and remote:IsA("RemoteEvent"), "[Net] Remote missing on client: " .. name)
	remotes[name] = remote
	return remote
end

-- SERVER -------------------------------------------------------------------

function Net.Init()
	assert(IS_SERVER, "Net.Init is server-only")
	if folder then
		return
	end
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		warn("[Net] Replacing an existing ReplicatedStorage.Remotes folder")
		existing:Destroy()
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = FOLDER_NAME
	for name in RemoteConfig.Known do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = newFolder
	end
	newFolder.Parent = ReplicatedStorage
	folder = newFolder
end

function Net.SetViolationHandler(handler: ViolationHandler)
	violationHandler = handler
end

function Net.OnServerEvent(name: string, handler: (player: Player, ...any) -> ())
	assert(IS_SERVER, "OnServerEvent is server-only")
	assert(RemoteConfig.Known[name] == "ClientToServer", ("[Net] %s is not a client->server remote"):format(name))
	assert(not handledOnServer[name], ("[Net] %s already has a server handler (one owner per remote)"):format(name))
	handledOnServer[name] = true

	local limits = RemoteConfig.RateLimits[name] or RemoteConfig.DefaultRateLimit
	local limiter = RateLimiter.new(limits.Rate, limits.Burst)

	getRemote(name).OnServerEvent:Connect(function(player: Player, ...)
		if not limiter:Check(player) then
			reportViolation(player, "RateLimit:" .. name, 1)
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

-- Any client->server remote nobody handles yet (future phases) is drained so
-- the engine queue never fills, and firing it is treated as suspicious.
function Net.FinalizeHandlers()
	assert(IS_SERVER, "FinalizeHandlers is server-only")
	for _, name in RemoteConfig.ClientToServer do
		if not handledOnServer[name] then
			handledOnServer[name] = true
			getRemote(name).OnServerEvent:Connect(function(player: Player)
				reportViolation(player, "UnhandledRemote:" .. name, 2)
			end)
		end
	end
end

function Net.FireClient(name: string, player: Player, ...: any)
	assert(IS_SERVER, "FireClient is server-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	if player.Parent then
		getRemote(name):FireClient(player, ...)
	end
end

function Net.FireClients(name: string, players: { Player }, ...: any)
	for _, player in players do
		Net.FireClient(name, player, ...)
	end
end

function Net.FireAllClients(name: string, ...: any)
	assert(IS_SERVER, "FireAllClients is server-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	getRemote(name):FireAllClients(...)
end

-- CLIENT -------------------------------------------------------------------

function Net.FireServer(name: string, ...: any)
	assert(not IS_SERVER, "FireServer is client-only")
	assert(RemoteConfig.Known[name] == "ClientToServer", ("[Net] %s is not a client->server remote"):format(name))
	getRemote(name):FireServer(...)
end

function Net.OnClientEvent(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "OnClientEvent is client-only")
	assert(RemoteConfig.Known[name] == "ServerToClient", ("[Net] %s is not a server->client remote"):format(name))
	return getRemote(name).OnClientEvent:Connect(handler)
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">AnimalMath</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  AnimalMath
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/AnimalMath
	DEPENDENCIES: Shared.Config.AnimalConfig

	Animal care computed lazily from timestamps (spec §101, §114): no
	per-animal loops, offline time handled naturally, and the client shows
	exactly what the server will decide.

	Saved animal entry:
		{ AnimalId, UniqueId, Variant, HousingId, Happiness, HappinessAt,
		  FedAt, ProduceReadyAt, PettedAt }
]]

local AnimalConfig = require(script.Parent.Parent.Config.AnimalConfig)

local AnimalMath = {}

export type Entry = {
	AnimalId: string,
	Happiness: number,
	HappinessAt: number?,
	FedAt: number?,
	ProduceReadyAt: number?,
	PettedAt: number?,
}

local FULL_SECONDS = AnimalConfig.FullnessDurationMinutes * 60

function AnimalMath.GetFullness(entry: Entry, now: number): number
	local fedAt = entry.FedAt or 0
	if fedAt <= 0 then
		return 0
	end
	return math.clamp(100 - (now - fedAt) / FULL_SECONDS * 100, 0, 100)
end

function AnimalMath.GetHappiness(entry: Entry, now: number): number
	local base = math.clamp(entry.Happiness or AnimalConfig.StartHappiness, 0, 100)
	local since = entry.HappinessAt or now
	local fedAt = entry.FedAt or 0
	-- Happiness only drains once the animal is hungry.
	local hungrySince = if fedAt > 0 then fedAt + FULL_SECONDS * (1 - AnimalConfig.HungryBelow / 100) else since
	local decayFrom = math.max(since, hungrySince)
	if now <= decayFrom or base <= AnimalConfig.HappinessFloor then
		return base
	end
	local decayed = base - (now - decayFrom) / 60 * AnimalConfig.HappinessDecayPerMinute
	return math.max(AnimalConfig.HappinessFloor, decayed)
end

-- "Ready" (product waiting), "Producing", or "Hungry" (feed to start the next batch).
function AnimalMath.GetStatus(entry: Entry, now: number): string
	local readyAt = entry.ProduceReadyAt or 0
	if readyAt > 0 then
		return if now >= readyAt then "Ready" else "Producing"
	end
	return "Hungry"
end

-- Happier animals produce faster (1.0x at 100%, 1.4x slower at 0%).
function AnimalMath.ProduceDuration(animalId: string, happiness: number): number
	local def = AnimalConfig.Animals[animalId]
	if not def then
		return 60
	end
	return def.ProduceTime * (1.4 - 0.4 * math.clamp(happiness, 0, 100) / 100)
end

return AnimalMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">AssetId</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  AssetId
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/AssetId
	DEPENDENCIES: none

	This project ships WITHOUT real animation / sound asset IDs. Every asset
	slot uses the literal "rbxassetid://PLACEHOLDER". Systems call
	AssetId.IsPlaceholder() and gracefully fall back instead of erroring,
	so the game keeps working until real IDs are pasted into the configs.
]]

local AssetId = {}

AssetId.PLACEHOLDER = "rbxassetid://PLACEHOLDER"

function AssetId.IsPlaceholder(id: string?): boolean
	if id == nil or id == "" then
		return true
	end
	if string.find(id, "PLACEHOLDER", 1, true) then
		return true
	end
	return id == "rbxassetid://0"
end

return AssetId
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CropGrowth</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  CropGrowth
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/CropGrowth
	DEPENDENCIES: Shared.Config.CropConfig

	Pure crop growth math from timestamps. Used by the server (authoritative
	stages, offline growth) and the client (countdown labels) so both agree.

	A planted tile entry looks like:
		{ CropId = "Wheat", PlantedAt = <unix>, WateredAt = <unix or 0> }
]]

local CropConfig = require(script.Parent.Parent.Config.CropConfig)

local CropGrowth = {}

export type Entry = { CropId: string?, PlantedAt: number?, WateredAt: number? }

-- 0..1 growth progress.
function CropGrowth.GetProgress(entry: Entry, now: number): number
	local crop = entry.CropId and CropConfig.Crops[entry.CropId]
	local planted = entry.PlantedAt
	if not crop or type(planted) ~= "number" then
		return 0
	end
	local watered = entry.WateredAt or 0
	local multiplier = CropConfig.WaterSpeedMultiplier
	local effective: number
	if watered > 0 and watered >= planted then
		effective = math.min(watered, now) - planted + math.max(0, now - watered) * multiplier
	else
		effective = now - planted
	end
	return math.clamp(effective / crop.GrowTime, 0, 1)
end

-- 1..6 (6 = Harvestable). Stage names are CropConfig.Stages.
function CropGrowth.GetStage(entry: Entry, now: number): number
	local progress = CropGrowth.GetProgress(entry, now)
	if progress >= 1 then
		return #CropConfig.Stages
	end
	return math.clamp(math.floor(progress * (#CropConfig.Stages - 1)) + 1, 1, #CropConfig.Stages - 1)
end

-- Seconds until harvestable at the current growth speed.
function CropGrowth.GetRemaining(entry: Entry, now: number): number
	local crop = entry.CropId and CropConfig.Crops[entry.CropId]
	if not crop then
		return 0
	end
	local progress = CropGrowth.GetProgress(entry, now)
	local rate = if (entry.WateredAt or 0) > 0 then CropConfig.WaterSpeedMultiplier else 1
	return math.max(0, crop.GrowTime * (1 - progress) / rate)
end

function CropGrowth.IsWatered(entry: Entry): boolean
	return (entry.WateredAt or 0) > 0
end

return CropGrowth
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Format
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Format
	DEPENDENCIES: none

	Number / time formatting for UI.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa" }

function Format.Commas(value: number): string
	local text = tostring(math.floor(value))
	local negative = string.sub(text, 1, 1) == "-"
	if negative then
		text = string.sub(text, 2)
	end
	local formatted = string.reverse((string.gsub(string.reverse(text), "(%d%d%d)", "%1,")))
	if string.sub(formatted, 1, 1) == "," then
		formatted = string.sub(formatted, 2)
	end
	return (negative and "-" or "") .. formatted
end

-- 999 -> "999", 12_345 -> "12.3K", 4_500_000 -> "4.5M"
function Format.Abbreviate(value: number): string
	local absolute = math.abs(value)
	if absolute < 10_000 then
		return Format.Commas(value)
	end
	local tier = math.min(math.floor(math.log10(absolute) / 3), #SUFFIXES - 1)
	local scaled = value / 10 ^ (tier * 3)
	local text = string.format("%.1f", scaled)
	text = string.gsub(text, "%.0$", "")
	return text .. SUFFIXES[tier + 1]
end

function Format.Duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">IslandContent</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  IslandContent
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/IslandContent
	DEPENDENCIES: Shared.Config.{IslandConfig, CropConfig}, Shared.Util.IslandLayout

	Deterministic island-local layout of everything areas contain: resource
	node spots, fishing spots and farm plots / tiles. Deterministic means the
	same island always gets the same layout on every server, so saved data
	(e.g. farm tile ids, node ids) always lines up.
]]

local Config = script.Parent.Parent.Config
local IslandConfig = require(Config.IslandConfig)
local CropConfig = require(Config.CropConfig)
local IslandLayout = require(script.Parent.IslandLayout)

local IslandContent = {}

export type NodeSpot = { Id: string, Type: string, AreaId: string, Position: Vector2 }
export type FishingSpot = { Id: string, Zone: string, AreaId: string, Position: Vector2, OnDock: boolean }
export type FarmPlot = { Id: string, AreaId: string, Center: Vector2 }

local NODE_SPACING = 9
local KEEP_CLEAR = 16 -- distance nodes keep from farm plots and fishing spots

local function seedFor(text: string): number
	local seed = 7
	for index = 1, #text do
		seed = (seed * 31 + string.byte(text, index)) % 2147483647
	end
	return seed
end

-- Farm plots: the starter plot plus one per area with Content.FarmPlot.
function IslandContent.FarmPlots(): { FarmPlot }
	local plots: { FarmPlot } = {
		{ Id = "S", AreaId = "Starter", Center = IslandConfig.StarterLayout.FarmPlot.Center } :: FarmPlot,
	}
	for _, areaId in IslandConfig.AreaOrder do
		local area = IslandConfig.Areas[areaId]
		if area.Content and area.Content.FarmPlot then
			table.insert(plots, { Id = string.sub(areaId, 1, 1), AreaId = areaId, Center = IslandLayout.GetAreaCenter(areaId) } :: FarmPlot)
		end
	end
	return plots
end

-- Tile centres of a plot in index order (row-major). Tile ids are PlotId .. index.
function IslandContent.FarmTilePositions(center: Vector2): { Vector2 }
	local farm = CropConfig.Farm
	local pitch = farm.TileSize + farm.TileGap
	local positions = {}
	for row = 1, farm.Rows do
		for column = 1, farm.Columns do
			local x = (column - (farm.Columns + 1) / 2) * pitch
			local z = (row - (farm.Rows + 1) / 2) * pitch
			table.insert(positions, center + Vector2.new(x, z))
		end
	end
	return positions
end

function IslandContent.FishingSpots(): { FishingSpot }
	local spots: { FishingSpot } = {}
	for _, areaId in IslandConfig.AreaOrder do
		local area = IslandConfig.Areas[areaId]
		local zone = area.Content and area.Content.FishingZone
		if zone then
			if areaId == "Starter" then
				table.insert(spots, { Id = areaId, Zone = zone, AreaId = areaId, Position = IslandConfig.StarterLayout.FishingSpot, OnDock = true } :: FishingSpot)
			else
				local center = IslandLayout.GetAreaCenter(areaId)
				local outward = if center.Magnitude > 0 then center.Unit else Vector2.new(0, 1)
				table.insert(spots, {
					Id = areaId,
					Zone = zone,
					AreaId = areaId,
					Position = center + outward * (area.Radius - 5),
					OnDock = false,
				} :: FishingSpot)
			end
		end
	end
	return spots
end

local function keepClearPoints(): { Vector2 }
	local points = {}
	for _, plot in IslandContent.FarmPlots() do
		table.insert(points, plot.Center)
	end
	for _, spot in IslandContent.FishingSpots() do
		table.insert(points, spot.Position)
	end
	for _, areaId in IslandConfig.AreaOrder do
		if areaId ~= "Starter" then
			table.insert(points, IslandLayout.GetAreaMarkerPosition(areaId))
		end
	end
	return points
end

-- Node spots for one area (hand-placed for the starter island, seeded-random elsewhere).
function IslandContent.AreaNodes(areaId: string): { NodeSpot }
	local spots: { NodeSpot } = {}
	if areaId == "Starter" then
		for index, node in IslandConfig.StarterLayout.Nodes do
			table.insert(spots, { Id = "Starter_" .. index, Type = node.Type, AreaId = areaId, Position = node.Position } :: NodeSpot)
		end
		return spots
	end

	local area = IslandConfig.Areas[areaId]
	local nodes = area and area.Content and area.Content.Nodes
	if not nodes then
		return spots
	end

	local random = Random.new(seedFor(areaId))
	local center = IslandLayout.GetAreaCenter(areaId)
	local clear = keepClearPoints()
	local starterRadius = IslandConfig.Areas.Starter.Radius
	local placed: { Vector2 } = {}

	-- Stable order so the same area always produces the same ids.
	local types = {}
	for nodeType in nodes do
		table.insert(types, nodeType)
	end
	table.sort(types)

	for _, nodeType in types do
		for _ = 1, nodes[nodeType] do
			for _ = 1, 200 do
				local angle = random:NextNumber(0, math.pi * 2)
				local distance = math.sqrt(random:NextNumber()) * (area.Radius - 8)
				local point = center + Vector2.new(math.cos(angle), math.sin(angle)) * distance
				local ok = point.Magnitude > starterRadius + 4
				if ok then
					for _, other in placed do
						if (other - point).Magnitude < NODE_SPACING then
							ok = false
							break
						end
					end
				end
				if ok then
					for _, other in clear do
						if (other - point).Magnitude < KEEP_CLEAR then
							ok = false
							break
						end
					end
				end
				if ok then
					table.insert(placed, point)
					table.insert(spots, { Id = areaId .. "_" .. #placed, Type = nodeType, AreaId = areaId, Position = point } :: NodeSpot)
					break
				end
			end
		end
	end
	return spots
end

return IslandContent
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">IslandLayout</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  IslandLayout
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/IslandLayout
	DEPENDENCIES: Shared.Config.IslandConfig

	Pure math for island slots and areas. Shared so the server (validation) and
	client (build preview, UI) always agree on where land is.
]]

local IslandConfig = require(script.Parent.Parent.Config.IslandConfig)

local IslandLayout = {}

-- World-space origin (CFrame at sea level) of server island slot `index` (1-based).
function IslandLayout.GetSlotOrigin(index: number): CFrame
	local zeroBased = index - 1
	local column = zeroBased % IslandConfig.SlotsPerRow
	local row = zeroBased // IslandConfig.SlotsPerRow
	local x = column * IslandConfig.SlotSpacing
	local z = row * IslandConfig.SlotSpacing
	return CFrame.new(x, IslandConfig.SeaLevel, z)
end

-- Island-local XZ centre of an area.
function IslandLayout.GetAreaCenter(areaId: string): Vector2
	local area = IslandConfig.Areas[areaId]
	assert(area, "Unknown area " .. tostring(areaId))
	local angle = math.rad(area.Angle)
	return Vector2.new(math.sin(angle), math.cos(angle)) * area.Distance
end

-- Where the 🔒 unlock sign for an area stands: on the starter shore, facing it.
function IslandLayout.GetAreaMarkerPosition(areaId: string): Vector2
	local area = IslandConfig.Areas[areaId]
	local angle = math.rad(area.Angle)
	local direction = Vector2.new(math.sin(angle), math.cos(angle))
	return direction * (IslandConfig.Areas.Starter.Radius - 8)
end

-- Is an island-local XZ point inside the given area's circle (minus margin)?
function IslandLayout.IsInArea(areaId: string, localPoint: Vector2, margin: number?): boolean
	local area = IslandConfig.Areas[areaId]
	if not area then
		return false
	end
	local center = IslandLayout.GetAreaCenter(areaId)
	return (localPoint - center).Magnitude <= area.Radius - (margin or 0)
end

-- Is the point on land the owner has unlocked?
function IslandLayout.IsOnUnlockedLand(unlockedAreas: { [string]: boolean }, localPoint: Vector2, margin: number?): boolean
	for areaId, unlocked in unlockedAreas do
		if unlocked and IslandLayout.IsInArea(areaId, localPoint, margin) then
			return true
		end
	end
	return false
end

-- Largest distance from island centre any area can reach (used for cleanup bounds).
function IslandLayout.GetMaxExtent(): number
	local extent = 0
	for _, area: any in IslandConfig.Areas do
		extent = math.max(extent, area.Distance + area.Radius + IslandConfig.ShallowsWidth)
	end
	return extent
end

return IslandLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Maid</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Maid
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Maid
	DEPENDENCIES: none

	Collects connections / instances / cleanup functions and releases them
	together. Used anywhere a system owns resources tied to a lifetime
	(a character, an island, an open UI panel...).
]]

export type Maid = {
	Give: <T>(self: Maid, task: T) -> T,
	Cleanup: (self: Maid) -> (),
	Destroy: (self: Maid) -> (),
}

local Maid = {}
Maid.__index = Maid

function Maid.new(): Maid
	return (setmetatable({ _tasks = {} }, Maid) :: any) :: Maid
end

function Maid.Give(self: any, item: any): any
	table.insert(self._tasks, item)
	return item
end

local function cleanupTask(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		if coroutine.status(item) == "suspended" then
			task.cancel(item)
		end
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Maid.Cleanup(self: any)
	local tasks = self._tasks
	self._tasks = {}
	-- Clean up in reverse order of registration (LIFO), like a stack.
	for i = #tasks, 1, -1 do
		local ok, err = pcall(cleanupTask :: any, tasks[i])
		if not ok then
			warn("[Maid] cleanup error:", err)
		end
	end
end

Maid.Destroy = Maid.Cleanup

return Maid
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Placement</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Placement
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Placement
	DEPENDENCIES: Shared.Config.{BuildConfig, BuildingConfig}, Shared.Util.IslandLayout

	Build-grid math shared by the client preview and the server validator.
	All positions are ISLAND-LOCAL.
]]

local Config = script.Parent.Parent.Config
local BuildConfig = require(Config.BuildConfig)
local IslandLayout = require(script.Parent.IslandLayout)

local Placement = {}

function Placement.IsValidRotation(rotation: any): boolean
	return type(rotation) == "number" and table.find(BuildConfig.Rotations, rotation) ~= nil
end

-- Footprint (X, Z) after rotation.
function Placement.FootprintSize(footprint: Vector2, rotation: number): Vector2
	if rotation == 90 or rotation == 270 then
		return Vector2.new(footprint.Y, footprint.X)
	end
	return footprint
end

local function snapAxis(value: number, span: number): number
	local grid = BuildConfig.GridSize
	local cells = math.floor(span / grid + 0.5)
	if cells % 2 == 1 then
		-- Odd number of cells: centre sits in the middle of a cell.
		return math.floor(value / grid) * grid + grid / 2
	end
	return math.floor(value / grid + 0.5) * grid
end

-- Snaps an island-local XZ centre so the footprint's edges land on grid lines.
function Placement.Snap(localXZ: Vector2, size: Vector2): Vector2
	return Vector2.new(snapAxis(localXZ.X, size.X), snapAxis(localXZ.Y, size.Y))
end

function Placement.Corners(center: Vector2, size: Vector2): { Vector2 }
	local hx, hz = size.X / 2, size.Y / 2
	return {
		center + Vector2.new(-hx, -hz),
		center + Vector2.new(hx, -hz),
		center + Vector2.new(-hx, hz),
		center + Vector2.new(hx, hz),
	}
end

-- Every corner (and the centre) must be on land the owner has unlocked.
function Placement.IsOnUnlockedLand(unlocked: { [string]: boolean }, center: Vector2, size: Vector2): boolean
	if not IslandLayout.IsOnUnlockedLand(unlocked, center, BuildConfig.EdgeMargin) then
		return false
	end
	for _, corner in Placement.Corners(center, size) do
		if not IslandLayout.IsOnUnlockedLand(unlocked, corner, BuildConfig.EdgeMargin) then
			return false
		end
	end
	return true
end

-- Island-local CFrame of a building's base centre.
function Placement.LocalCFrame(localPosition: Vector3, rotation: number): CFrame
	return CFrame.new(localPosition) * CFrame.Angles(0, math.rad(rotation), 0)
end

return Placement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">R15</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  R15
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/R15
	DEPENDENCIES: none

	Single source of truth for R15 body-part and Motor6D names. Nothing in the
	project hard-codes R6 parts ("Torso", "Right Arm", ...). If you ever need
	R6 compatibility, add it HERE and nowhere else.
]]

local R15 = {}

R15.PartNames = table.freeze({
	"Head",
	"UpperTorso",
	"LowerTorso",
	"LeftUpperArm",
	"LeftLowerArm",
	"LeftHand",
	"RightUpperArm",
	"RightLowerArm",
	"RightHand",
	"LeftUpperLeg",
	"LeftLowerLeg",
	"LeftFoot",
	"RightUpperLeg",
	"RightLowerLeg",
	"RightFoot",
	"HumanoidRootPart",
})

-- Motor6D name -> the body part that parents it in a standard R15 rig.
R15.MotorParents = table.freeze({
	Root = "LowerTorso",
	Waist = "UpperTorso",
	Neck = "Head",
	LeftShoulder = "LeftUpperArm",
	LeftElbow = "LeftLowerArm",
	LeftWrist = "LeftHand",
	RightShoulder = "RightUpperArm",
	RightElbow = "RightLowerArm",
	RightWrist = "RightHand",
	LeftHip = "LeftUpperLeg",
	LeftKnee = "LeftLowerLeg",
	LeftAnkle = "LeftFoot",
	RightHip = "RightUpperLeg",
	RightKnee = "RightLowerLeg",
	RightAnkle = "RightFoot",
})

-- Attachments the tool system grips with.
R15.GripAttachments = table.freeze({
	RightHand = "RightGripAttachment",
	LeftHand = "LeftGripAttachment",
})

function R15.GetHumanoid(character: Model?): Humanoid?
	if not character then
		return nil
	end
	return character:FindFirstChildOfClass("Humanoid")
end

function R15.GetRootPart(character: Model?): BasePart?
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function R15.GetPart(character: Model?, partName: string): BasePart?
	if not character then
		return nil
	end
	local part = character:FindFirstChild(partName)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

function R15.GetMotor(character: Model?, motorName: string): Motor6D?
	local parentName = R15.MotorParents[motorName]
	if not parentName then
		return nil
	end
	local parent = R15.GetPart(character, parentName)
	local motor = parent and parent:FindFirstChild(motorName)
	if motor and motor:IsA("Motor6D") then
		return motor
	end
	return nil
end

function R15.IsR15(character: Model?): boolean
	local humanoid = R15.GetHumanoid(character)
	if not humanoid or humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		return false
	end
	return R15.GetPart(character, "UpperTorso") ~= nil and R15.GetPart(character, "RightHand") ~= nil
end

function R15.IsAlive(character: Model?): boolean
	local humanoid = R15.GetHumanoid(character)
	return humanoid ~= nil and humanoid.Health > 0 and R15.GetRootPart(character) ~= nil
end

return R15
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  RateLimiter
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/RateLimiter
	DEPENDENCIES: none

	Token-bucket rate limiter. Each key (usually a Player) owns a bucket that
	refills at `rate` tokens per second up to `burst` tokens. Keys are held
	weakly so Player objects are released automatically when they leave.
]]

export type RateLimiter = {
	Rate: number,
	Burst: number,
	Check: (self: RateLimiter, key: any, cost: number?) -> boolean,
	Reset: (self: RateLimiter, key: any) -> (),
}

type Bucket = { Tokens: number, Last: number }

local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(rate: number, burst: number): RateLimiter
	assert(rate > 0 and burst > 0, "RateLimiter needs positive rate and burst")
	local self = setmetatable({
		Rate = rate,
		Burst = burst,
		_buckets = setmetatable({} :: { [any]: Bucket }, { __mode = "k" }),
	}, RateLimiter)
	return (self :: any) :: RateLimiter
end

function RateLimiter.Check(self: any, key: any, cost: number?): boolean
	local price = cost or 1
	local now = os.clock()
	local bucket: Bucket? = self._buckets[key]
	if not bucket then
		bucket = { Tokens = self.Burst, Last = now }
		self._buckets[key] = bucket
	end
	assert(bucket)
	bucket.Tokens = math.min(self.Burst, bucket.Tokens + (now - bucket.Last) * self.Rate)
	bucket.Last = now
	if bucket.Tokens >= price then
		bucket.Tokens -= price
		return true
	end
	return false
end

function RateLimiter.Reset(self: any, key: any)
	self._buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Serializer</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Serializer
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Serializer
	DEPENDENCIES: none

	Converts Roblox datatypes into DataStore-safe tables and back.
	Instances are NEVER saved; only plain data like:
		{ BuildingId = "WoodenCabin", Position = { X = 10, Y = 5, Z = -30 }, Rotation = 90 }
	All island positions are saved in ISLAND-LOCAL space so an island can be
	loaded into any server slot.
]]

export type SerializedVector3 = { X: number, Y: number, Z: number }

local Serializer = {}

local function round(value: number, step: number): number
	return math.floor(value / step + 0.5) * step
end

function Serializer.Vector3(value: Vector3): SerializedVector3
	return { X = round(value.X, 0.01), Y = round(value.Y, 0.01), Z = round(value.Z, 0.01) }
end

function Serializer.ToVector3(data: any): Vector3?
	if type(data) ~= "table" then
		return nil
	end
	local x, y, z = data.X, data.Y, data.Z
	if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then
		return nil
	end
	if x ~= x or y ~= y or z ~= z then
		return nil
	end
	return Vector3.new(x, y, z)
end

-- Rotation is stored as a yaw angle in whole degrees (0..359).
function Serializer.Yaw(cframe: CFrame): number
	local _, yaw, _ = cframe:ToEulerAnglesYXZ()
	return round(math.deg(yaw), 1) % 360
end

function Serializer.ToCFrame(position: Vector3, yawDegrees: number): CFrame
	return CFrame.new(position) * CFrame.Angles(0, math.rad(yawDegrees), 0)
end

return Serializer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Signal
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/Signal
	DEPENDENCIES: none

	Lightweight script signal used by services and controllers for in-process
	events (never for networking — that is Net's job).

	Usage:
		local changed = Signal.new()
		local conn = changed:Connect(function(a, b) end)
		changed:Fire(1, 2)
		conn:Disconnect()
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal = {
	Connect: (self: Signal, fn: (...any) -> ()) -> Connection,
	Once: (self: Signal, fn: (...any) -> ()) -> Connection,
	Fire: (self: Signal, ...any) -> (),
	Wait: (self: Signal) -> ...any,
	DisconnectAll: (self: Signal) -> (),
	Destroy: (self: Signal) -> (),
}

type ConnectionImpl = {
	Connected: boolean,
	_signal: any,
	_fn: (...any) -> (),
	Disconnect: (self: ConnectionImpl) -> (),
}

local Connection = {}
Connection.__index = Connection

function Connection.Disconnect(self: ConnectionImpl)
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new(): Signal
	local self = setmetatable({
		_handlers = {} :: { ConnectionImpl },
	}, Signal)
	return (self :: any) :: Signal
end

function Signal.Connect(self: any, fn: (...any) -> ()): Connection
	local connection = setmetatable({
		Connected = true,
		_signal = self,
		_fn = fn,
	}, Connection)
	table.insert(self._handlers, connection)
	return (connection :: any) :: Connection
end

function Signal.Once(self: any, fn: (...any) -> ()): Connection
	local connection: Connection
	connection = Signal.Connect(self, function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal.Fire(self: any, ...: any)
	-- Copy so handlers can disconnect while we iterate.
	local snapshot: { ConnectionImpl } = table.clone(self._handlers)
	for _, connection in snapshot do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal.Wait(self: any): ...any
	local thread = coroutine.running()
	Signal.Once(self, function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal.DisconnectAll(self: any)
	for _, connection in self._handlers do
		connection.Connected = false
	end
	table.clear(self._handlers)
end

function Signal.Destroy(self: any)
	Signal.DisconnectAll(self)
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  TableUtil
	SCRIPT TYPE:  ModuleScript (shared utility)
	WHERE:        ReplicatedStorage/Shared/Util/TableUtil
	DEPENDENCIES: none
]]

local TableUtil = {}

function TableUtil.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value :: any do
		copy[TableUtil.DeepCopy(key)] = TableUtil.DeepCopy(child)
	end
	return (copy :: any) :: T
end

-- Fills in any keys missing from `target` using a deep copy of `template`.
-- Existing values are left untouched (type repair is DataSchema's job).
function TableUtil.Reconcile(target: { [any]: any }, template: { [any]: any })
	for key, templateValue in template do
		if target[key] == nil then
			target[key] = TableUtil.DeepCopy(templateValue)
		elseif type(templateValue) == "table" and type(target[key]) == "table" then
			TableUtil.Reconcile(target[key], templateValue)
		end
	end
end

function TableUtil.Count(dict: { [any]: any }): number
	local count = 0
	for _ in dict do
		count += 1
	end
	return count
end

function TableUtil.Keys<K>(dict: { [K]: any }): { K }
	local keys = {}
	for key in dict do
		table.insert(keys, key)
	end
	return keys
end

-- Recursively freezes a config table so accidental writes error loudly.
function TableUtil.DeepFreeze<T>(value: T): T
	if type(value) == "table" and not table.isfrozen(value :: any) then
		for _, child in value :: any do
			TableUtil.DeepFreeze(child)
		end
		table.freeze(value :: any)
	end
	return value
end

return TableUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--!strict
--[[
	SCRIPT NAME:  Validate
	SCRIPT TYPE:  ModuleScript (shared utility, used mostly by the server)
	WHERE:        ReplicatedStorage/Shared/Util/Validate
	DEPENDENCIES: none

	Type guards for anything that crosses the network. Every RemoteEvent
	handler validates its arguments with these before touching game state.
	Never trust types coming from a client.
]]

local Validate = {}

function Validate.IsFinite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

function Validate.Number(value: any, min: number?, max: number?): boolean
	if not Validate.IsFinite(value) then
		return false
	end
	if min and value < min then
		return false
	end
	if max and value > max then
		return false
	end
	return true
end

function Validate.Integer(value: any, min: number?, max: number?): boolean
	return Validate.Number(value, min, max) and math.floor(value) == value
end

function Validate.String(value: any, maxLength: number?): boolean
	if type(value) ~= "string" then
		return false
	end
	if maxLength and #value > maxLength then
		return false
	end
	return utf8.len(value) ~= nil
end

-- Config identifiers: letters, digits and underscores only.
function Validate.Id(value: any): boolean
	return Validate.String(value, 64) and string.match(value, "^[%w_]+$") ~= nil
end

function Validate.Boolean(value: any): boolean
	return type(value) == "boolean"
end

function Validate.Vector3(value: any, maxMagnitude: number?): boolean
	if typeof(value) ~= "Vector3" then
		return false
	end
	if not (Validate.IsFinite(value.X) and Validate.IsFinite(value.Y) and Validate.IsFinite(value.Z)) then
		return false
	end
	return maxMagnitude == nil or value.Magnitude <= maxMagnitude
end

function Validate.OneOf(value: any, allowed: { [any]: any }): boolean
	return value ~= nil and allowed[value] ~= nil
end

return Validate
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="46">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="47">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="48">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">DataSchema</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  DataSchema
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Data/DataSchema
	DEPENDENCIES: Shared.Config.GameConfig, ItemConfig, ToolConfig, IslandConfig,
	              ProgressionConfig, Shared.Util.TableUtil

	Defines the saved player profile, migrates old versions and REPAIRS bad
	data instead of wiping it (spec §146):
	  * missing keys are filled from the template,
	  * wrong types are reset (old value moved to Quarantine),
	  * unknown item/tool/area ids are moved to Quarantine — NOT deleted — and
	    are restored automatically if a later update re-adds that id,
	  * numbers are clamped to sane, finite, integer ranges.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local GameConfig = require(Shared.Config.GameConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local ToolConfig = require(Shared.Config.ToolConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local BuildingConfig = require(Shared.Config.BuildingConfig)
local CropConfig = require(Shared.Config.CropConfig)
local AnimalConfig = require(Shared.Config.AnimalConfig)
local QuestConfig = require(Shared.Config.QuestConfig)
local TableUtil = require(Shared.Util.TableUtil)

local DataSchema = {}

DataSchema.CurrentVersion = 2

-- Top-level keys never sent to the client.
DataSchema.PrivateKeys = table.freeze({ Quarantine = true })

local TEMPLATE = {
	Version = DataSchema.CurrentVersion,

	Coins = GameConfig.StartingCoins,
	Gems = GameConfig.StartingGems,
	XP = 0,
	Level = 1,

	Inventory = {
		Items = {}, -- [itemId] = count
		Capacity = GameConfig.Inventory.StartingCapacity,
		Favorites = {}, -- [itemId] = true
	},

	Tools = {
		Owned = {}, -- [toolId] = true
		Hotbar = {}, -- array of toolIds (<= ToolConfig.HotbarSize)
		Equipped = "", -- "" = nothing
		Durability = {}, -- [toolId] = number (optional system)
	},

	Island = {
		IslandId = "",
		Name = "",
		Level = GameConfig.StartingIslandLevel,
		XP = 0,
		Theme = IslandConfig.DefaultTheme,
		Permission = "Private", -- Private | Friends | Public (Phase 12)
		UnlockedAreas = { Starter = true },
		-- [uniqueId] = { BuildingId, UniqueId, Position = {X,Y,Z} (island-local), Rotation, Variant, State, Progress }
		Buildings = {},
		Decorations = {},
		-- [tileId] = { TileId, State = "Tilled"|"Planted", CropId, Position, PlantedAt, WateredAt }
		Crops = {},
		-- [uniqueId] = { AnimalId, UniqueId, Variant, HousingId, Happiness, HappinessAt, FedAt, ProduceReadyAt, PettedAt }
		Animals = {},
		FarmTiles = CropConfig.Farm.StarterTiles,
		Upgrades = { FarmTiles = 0, Capacity = 0 },
		Storage = {},
		Production = {}, -- Phase 8: production queues
		Likes = 0,
		Visits = 0,
	},

	Quests = { Current = QuestConfig.Chain[1], Progress = {}, Completed = {}, DailyResetAt = 0 },
	Achievements = {},
	Collection = { Fish = {}, Crops = {}, Animals = {}, Items = {} },
	Recipes = {},
	Cosmetics = { Owned = {}, Equipped = {} },

	Stats = {
		PlayTime = 0,
		WoodCollected = 0,
		StoneCollected = 0,
		CropsHarvested = 0,
		FishCaught = 0,
		AnimalsOwned = 0,
		MilkCollected = 0,
		EggsCollected = 0,
		ItemsSold = 0,
		CoinsEarned = 0,
		BuildingsBuilt = 0,
		AreasUnlocked = 0,
		QuestsCompleted = 0,
		RareItemsFound = 0,
	},

	Settings = { CameraShake = true, MusicVolume = 0.5, SfxVolume = 0.8 },

	Flags = {
		StarterChestClaimed = false,
		FirstEquip = false,
		TutorialStep = 0,
	},

	Meta = { CreatedAt = 0, LastSavedAt = 0, LastJoinAt = 0, JoinCount = 0 },

	-- Data we could not validate, kept instead of deleted.
	Quarantine = { Items = {}, Tools = {}, Areas = {}, Values = {}, Buildings = {}, Crops = {}, Animals = {} },
}

function DataSchema.Template()
	return TableUtil.DeepCopy(TEMPLATE)
end

-- version -> function(data) upgrading FROM that version to version + 1
local MIGRATIONS: { [number]: (any) -> () } = {
	-- v1 -> v2: first playable loop. Players who already opened the starter
	-- chest get the new starter tools + seeds; old quest layout is dropped.
	[1] = function(data)
		local flags = data.Flags
		if type(flags) == "table" and flags.StarterChestClaimed == true then
			if type(data.Tools) ~= "table" then
				data.Tools = {}
			end
			if type(data.Tools.Owned) ~= "table" then
				data.Tools.Owned = {}
			end
			if type(data.Tools.Hotbar) ~= "table" then
				data.Tools.Hotbar = {}
			end
			for _, toolId in GameConfig.StarterKit.Tools do
				if data.Tools.Owned[toolId] ~= true then
					data.Tools.Owned[toolId] = true
					table.insert(data.Tools.Hotbar, toolId)
				end
			end
			if type(data.Inventory) == "table" and type(data.Inventory.Items) == "table" then
				local seeds = tonumber(data.Inventory.Items.WheatSeeds) or 0
				data.Inventory.Items.WheatSeeds = seeds + (GameConfig.StarterKit.Items.WheatSeeds or 0)
			end
		end
		if type(data.Quests) == "table" then
			data.Quests.Active = nil
		end
		if type(data.Island) == "table" then
			for _, key in { "Buildings", "Crops", "Animals" } do
				if type(data.Island[key]) ~= "table" then
					data.Island[key] = {}
				end
			end
		end
	end,
}

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function cleanInteger(value: any, min: number, max: number, fallback: number): number
	if not isFiniteNumber(value) then
		return fallback
	end
	return math.clamp(math.floor(value), min, max)
end

-- Recursively resets values whose type does not match the template.
local function repairTypes(data: { [any]: any }, template: { [any]: any }, quarantine: { [any]: any }, path: string)
	for key, templateValue in template do
		local value = data[key]
		if value ~= nil and type(value) ~= type(templateValue) then
			quarantine[path .. tostring(key)] = value
			data[key] = TableUtil.DeepCopy(templateValue)
		elseif type(templateValue) == "table" and type(value) == "table" and next(templateValue) ~= nil then
			-- Only recurse into "shaped" tables (non-empty template tables).
			repairTypes(value, templateValue, quarantine, path .. tostring(key) .. ".")
		end
	end
end

function DataSchema.Migrate(data: any): any
	local version = if isFiniteNumber(data.Version) then data.Version else 1
	while version < DataSchema.CurrentVersion do
		local migrate = MIGRATIONS[version]
		if migrate then
			migrate(data)
		end
		version += 1
	end
	data.Version = DataSchema.CurrentVersion
	return data
end

-- Returns a repaired profile table. Never returns nil for a table input.
function DataSchema.Sanitize(raw: any): any
	local data = if type(raw) == "table" then raw else DataSchema.Template()
	DataSchema.Migrate(data)
	if type(data.Quarantine) ~= "table" then
		data.Quarantine = TableUtil.DeepCopy(TEMPLATE.Quarantine)
	end
	if type(data.Quarantine.Values) ~= "table" then
		data.Quarantine.Values = {}
	end
	TableUtil.Reconcile(data, TEMPLATE)
	repairTypes(data, TEMPLATE, data.Quarantine.Values, "")

	-- Currencies / levels
	data.Coins = cleanInteger(data.Coins, 0, EconomyConfig.Currencies.Coins.Max, TEMPLATE.Coins)
	data.Gems = cleanInteger(data.Gems, 0, EconomyConfig.Currencies.Gems.Max, TEMPLATE.Gems)
	data.Level = cleanInteger(data.Level, 1, ProgressionConfig.Player.MaxLevel, 1)
	data.XP = cleanInteger(data.XP, 0, math.huge, 0)
	data.Island.Level = cleanInteger(data.Island.Level, 1, ProgressionConfig.Island.MaxLevel, 1)
	data.Island.XP = cleanInteger(data.Island.XP, 0, math.huge, 0)
	data.Inventory.Capacity = cleanInteger(data.Inventory.Capacity, GameConfig.Inventory.StartingCapacity, 1_000_000, GameConfig.Inventory.StartingCapacity)

	-- Restore quarantined ids that are valid again (e.g. an item re-added in an update).
	local quarantine = data.Quarantine
	for itemId, count in quarantine.Items do
		if ItemConfig.Exists(itemId) then
			data.Inventory.Items[itemId] = (data.Inventory.Items[itemId] or 0) + count
			quarantine.Items[itemId] = nil
		end
	end
	for toolId in quarantine.Tools do
		if ToolConfig.Get(toolId) then
			data.Tools.Owned[toolId] = true
			quarantine.Tools[toolId] = nil
		end
	end
	for areaId in quarantine.Areas do
		if IslandConfig.Areas[areaId] then
			data.Island.UnlockedAreas[areaId] = true
			quarantine.Areas[areaId] = nil
		end
	end

	-- Inventory items
	for itemId, count in data.Inventory.Items do
		if not isFiniteNumber(count) or count <= 0 then
			data.Inventory.Items[itemId] = nil
		elseif not ItemConfig.Exists(itemId) then
			quarantine.Items[tostring(itemId)] = math.floor(count)
			data.Inventory.Items[itemId] = nil
		else
			data.Inventory.Items[itemId] = math.min(math.floor(count), GameConfig.Inventory.MaxStack)
		end
	end
	for itemId in data.Inventory.Favorites do
		if not ItemConfig.Exists(itemId) then
			data.Inventory.Favorites[itemId] = nil
		end
	end

	-- Tools
	for toolId, owned in data.Tools.Owned do
		if owned ~= true then
			data.Tools.Owned[toolId] = nil
		elseif not ToolConfig.Get(toolId) then
			quarantine.Tools[tostring(toolId)] = true
			data.Tools.Owned[toolId] = nil
		end
	end
	local hotbar = {}
	local seen = {}
	for _, toolId in data.Tools.Hotbar do
		if #hotbar >= ToolConfig.HotbarSize then
			break
		end
		if type(toolId) == "string" and data.Tools.Owned[toolId] and not seen[toolId] then
			seen[toolId] = true
			table.insert(hotbar, toolId)
		end
	end
	data.Tools.Hotbar = hotbar
	if data.Tools.Equipped ~= "" and not data.Tools.Owned[data.Tools.Equipped] then
		data.Tools.Equipped = ""
	end

	-- Island areas
	for areaId, unlocked in data.Island.UnlockedAreas do
		if unlocked ~= true then
			data.Island.UnlockedAreas[areaId] = nil
		elseif not IslandConfig.Areas[areaId] then
			quarantine.Areas[tostring(areaId)] = true
			data.Island.UnlockedAreas[areaId] = nil
		end
	end
	data.Island.UnlockedAreas.Starter = true
	if type(data.Island.Name) ~= "string" or #data.Island.Name > IslandConfig.NameMaxLength * 4 then
		data.Island.Name = ""
	end

	local maxTiles = CropConfig.Farm.Columns * CropConfig.Farm.Rows
	data.Island.FarmTiles = cleanInteger(data.Island.FarmTiles, CropConfig.Farm.StarterTiles, maxTiles, CropConfig.Farm.StarterTiles)
	data.Island.Upgrades.FarmTiles = cleanInteger(data.Island.Upgrades.FarmTiles, 0, 100, 0)
	data.Island.Upgrades.Capacity = cleanInteger(data.Island.Upgrades.Capacity, 0, 100, 0)

	DataSchema.SanitizeIsland(data)
	DataSchema.SanitizeQuests(data)
	return data
end

local function validPosition(position: any): boolean
	return type(position) == "table"
		and isFiniteNumber(position.X)
		and isFiniteNumber(position.Y)
		and isFiniteNumber(position.Z)
		and math.abs(position.X) < 2000
		and math.abs(position.Z) < 2000
		and math.abs(position.Y) < 500
end

local function validBuilding(entry: any): boolean
	if type(entry) ~= "table" then
		return false
	end
	local def = BuildingConfig.Get(entry.BuildingId)
	if not def or not validPosition(entry.Position) then
		return false
	end
	if entry.Rotation ~= 0 and entry.Rotation ~= 90 and entry.Rotation ~= 180 and entry.Rotation ~= 270 then
		return false
	end
	return true
end

local function validCrop(key: any, entry: any, now: number): boolean
	if type(key) ~= "string" or not string.match(key, "^%u%d+$") or type(entry) ~= "table" then
		return false
	end
	if entry.State == "Tilled" then
		return true
	end
	if entry.State ~= "Planted" or not CropConfig.Crops[entry.CropId] then
		return false
	end
	return isFiniteNumber(entry.PlantedAt) and entry.PlantedAt <= now + 120
end

local function validAnimal(entry: any): boolean
	return type(entry) == "table" and AnimalConfig.Animals[entry.AnimalId] ~= nil
end

-- Buildings / crops / animals: repair what we can, quarantine the rest.
function DataSchema.SanitizeIsland(data: any)
	local island = data.Island
	local quarantine = data.Quarantine
	local now = os.time()

	-- Give back quarantined entries that became valid again.
	for key, entry in quarantine.Buildings do
		if validBuilding(entry) and island.Buildings[key] == nil then
			island.Buildings[key] = entry
			quarantine.Buildings[key] = nil
		end
	end

	for key, entry in island.Buildings do
		if type(key) == "string" and validBuilding(entry) then
			local steps = BuildingConfig.Get(entry.BuildingId).Steps
			entry.UniqueId = key
			entry.Variant = if type(entry.Variant) == "string" then entry.Variant else "Default"
			entry.Progress = cleanInteger(entry.Progress, 0, steps, 0)
			entry.State = if entry.State == "Complete" or entry.Progress >= steps then "Complete" else "Constructing"
		else
			quarantine.Buildings[tostring(key)] = entry
			island.Buildings[key] = nil
		end
	end

	for key, entry in island.Crops do
		if validCrop(key, entry, now) then
			entry.TileId = key
			if entry.State == "Planted" then
				entry.WateredAt = if isFiniteNumber(entry.WateredAt) then entry.WateredAt else 0
			else
				entry.CropId = nil
				entry.PlantedAt = nil
				entry.WateredAt = nil
			end
		else
			quarantine.Crops[tostring(key)] = entry
			island.Crops[key] = nil
		end
	end

	for key, entry in island.Animals do
		if type(key) == "string" and validAnimal(entry) then
			entry.UniqueId = key
			entry.Happiness = math.clamp(if isFiniteNumber(entry.Happiness) then entry.Happiness else AnimalConfig.StartHappiness, 0, 100)
			entry.HappinessAt = if isFiniteNumber(entry.HappinessAt) then entry.HappinessAt else now
			entry.FedAt = if isFiniteNumber(entry.FedAt) then entry.FedAt else 0
			entry.ProduceReadyAt = if isFiniteNumber(entry.ProduceReadyAt) then entry.ProduceReadyAt else 0
			entry.PettedAt = if isFiniteNumber(entry.PettedAt) then entry.PettedAt else 0
			entry.Variant = if type(entry.Variant) == "string" then entry.Variant else "Default"
			entry.HousingId = if type(entry.HousingId) == "string" then entry.HousingId else ""
		else
			quarantine.Animals[tostring(key)] = entry
			island.Animals[key] = nil
		end
	end
end

function DataSchema.SanitizeQuests(data: any)
	local quests = data.Quests
	if quests.Current ~= "" and not QuestConfig.Quests[quests.Current] then
		quests.Current = ""
	end
	-- A player who finished (or never started) the chain resumes at the first unfinished quest.
	if quests.Current == "" then
		for _, questId in QuestConfig.Chain do
			if quests.Completed[questId] ~= true then
				quests.Current = questId
				break
			end
		end
	end
	for key, value in quests.Progress do
		if type(key) ~= "string" or not isFiniteNumber(value) then
			quests.Progress[key] = nil
		end
	end
	for key, value in quests.Completed do
		if value ~= true then
			quests.Completed[key] = nil
		end
	end
end

-- Final guard before anything is written to the DataStore.
function DataSchema.IsSaveable(data: any): (boolean, string?)
	if type(data) ~= "table" then
		return false, "profile is not a table"
	end
	if data.Version ~= DataSchema.CurrentVersion then
		return false, "unexpected version"
	end
	if not isFiniteNumber(data.Coins) or data.Coins < 0 then
		return false, "invalid Coins"
	end
	if type(data.Inventory) ~= "table" or type(data.Inventory.Items) ~= "table" then
		return false, "invalid Inventory"
	end
	if type(data.Island) ~= "table" or type(data.Island.UnlockedAreas) ~= "table" then
		return false, "invalid Island"
	end
	return true, nil
end

return DataSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">MockDataStore</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  MockDataStore
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Data/MockDataStore
	DEPENDENCIES: Shared.Util.TableUtil

	In-memory stand-in for a GlobalDataStore, used in Studio when "Enable
	Studio Access to API Services" is off. Same UpdateAsync/GetAsync contract,
	so DataService runs the exact same code path. Data lives only for the
	current play session.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TableUtil = require(ReplicatedStorage.Shared.Util.TableUtil)

local MockDataStore = {}
MockDataStore.__index = MockDataStore

function MockDataStore.new()
	return setmetatable({ _data = {} :: { [string]: any } }, MockDataStore)
end

function MockDataStore:GetAsync(key: string): any
	task.wait() -- simulate yielding like the real API
	return TableUtil.DeepCopy(self._data[key])
end

function MockDataStore:UpdateAsync(key: string, transform: (any, any) -> any): any
	task.wait()
	local result = transform(TableUtil.DeepCopy(self._data[key]), nil)
	if result == nil then
		return nil -- cancelled, mirrors the real API
	end
	self._data[key] = TableUtil.DeepCopy(result)
	return TableUtil.DeepCopy(result)
end

function MockDataStore:RemoveAsync(key: string): any
	local old = self._data[key]
	self._data[key] = nil
	return old
end

return MockDataStore
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Island</string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">AnimalModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalModels
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/AnimalModels
	DEPENDENCIES: none

	Cute procedural animals. The anchored "Body" is the PrimaryPart; every
	other part is welded to it (explicit Weld C0), so moving/tweening the Body
	moves the whole animal. Each model also gets an AnimationController +
	Animator so real Cow*/Chicken* animations play once you upload them.
	Pivot = the animal's feet centre on the ground.

	Real art: ServerStorage/Animals/<AnimalId> with an anchored "Body"
	PrimaryPart and a "Head" part (for the Pet prompt).
]]

local ServerStorage = game:GetService("ServerStorage")

local AnimalModels = {}

local function add(model: Model, body: BasePart?, props: { [string]: any }): BasePart
	local newPart = Instance.new("Part")
	if props.Shape then
		newPart.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" then
			(newPart :: any)[key] = value
		end
	end
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	if body then
		newPart.Anchored = false
		newPart.Massless = true
		local weld = Instance.new("Weld")
		weld.Part0 = body
		weld.Part1 = newPart
		weld.C0 = body.CFrame:ToObjectSpace(newPart.CFrame)
		weld.Parent = newPart
	else
		newPart.Anchored = true
	end
	newPart.Parent = model
	return newPart
end

local function finish(model: Model, body: BasePart)
	model.PrimaryPart = body
	model.WorldPivot = CFrame.new() -- feet centre
	local controller = Instance.new("AnimationController")
	local animator = Instance.new("Animator")
	animator.Parent = controller
	controller.Parent = model
end

local function cow(variant: any): Model
	local model = Instance.new("Model")
	local bodyColor, spotColor = variant.Body, variant.Spots
	local body = add(model, nil, { Name = "Body", Size = Vector3.new(2.6, 2.1, 4.2), CFrame = CFrame.new(0, 2.55, 0), Color = bodyColor, CanCollide = true })
	for _, spec in { { 1.31, 2.8, 0.6, 1.4 }, { -1.31, 2.4, -0.8, 1.2 }, { 1.31, 2.2, -1.2, 0.9 }, { -1.31, 2.9, 1, 1 } } do
		add(model, body, { Name = "Spot", Size = Vector3.new(0.05, spec[4], spec[4] * 1.2), CFrame = CFrame.new(spec[1], spec[2], spec[3]), Color = spotColor, CanCollide = false })
	end
	add(model, body, { Name = "Head", Size = Vector3.new(1.7, 1.6, 1.6), CFrame = CFrame.new(0, 3.3, -2.6), Color = bodyColor, CanCollide = false })
	add(model, body, { Name = "Snout", Size = Vector3.new(1.3, 0.8, 0.6), CFrame = CFrame.new(0, 2.9, -3.55), Color = Color3.fromRGB(245, 170, 170), CanCollide = false })
	for _, x in { -0.55, 0.55 } do
		add(model, body, { Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, CFrame = CFrame.new(x, 3.6, -3.4), Color = Color3.fromRGB(30, 30, 30), CanCollide = false })
		add(model, body, { Name = "Horn", Size = Vector3.new(0.25, 0.6, 0.25), CFrame = CFrame.new(x * 1.2, 4.3, -2.6), Color = Color3.fromRGB(245, 235, 210), CanCollide = false })
		add(model, body, { Name = "Ear", Size = Vector3.new(0.6, 0.3, 0.3), CFrame = CFrame.new(x * 2.1, 3.9, -2.5), Color = bodyColor, CanCollide = false })
	end
	for _, x in { -0.85, 0.85 } do
		for _, z in { -1.5, 1.5 } do
			add(model, body, { Name = "Leg", Size = Vector3.new(0.6, 1.5, 0.6), CFrame = CFrame.new(x, 0.75, z), Color = bodyColor, CanCollide = false })
			add(model, body, { Name = "Hoof", Size = Vector3.new(0.62, 0.25, 0.62), CFrame = CFrame.new(x, 0.12, z), Color = Color3.fromRGB(60, 45, 35), CanCollide = false })
		end
	end
	add(model, body, { Name = "Udder", Size = Vector3.new(0.9, 0.5, 0.9), CFrame = CFrame.new(0, 1.35, 0.9), Color = Color3.fromRGB(245, 175, 175), CanCollide = false })
	add(model, body, { Name = "Tail", Size = Vector3.new(0.2, 1.4, 0.2), CFrame = CFrame.new(0, 2.6, 2.2) * CFrame.Angles(math.rad(20), 0, 0), Color = bodyColor, CanCollide = false })
	finish(model, body)
	return model
end

local function chicken(variant: any): Model
	local model = Instance.new("Model")
	local body = add(model, nil, { Name = "Body", Size = Vector3.new(1.2, 1.1, 1.5), CFrame = CFrame.new(0, 1.15, 0), Color = variant.Body, CanCollide = true })
	add(model, body, { Name = "Head", Size = Vector3.new(0.75, 0.75, 0.75), CFrame = CFrame.new(0, 1.9, -0.6), Color = variant.Body, CanCollide = false })
	add(model, body, { Name = "Beak", Size = Vector3.new(0.3, 0.2, 0.35), CFrame = CFrame.new(0, 1.85, -1.1), Color = Color3.fromRGB(250, 170, 40), CanCollide = false })
	add(model, body, { Name = "Comb", Size = Vector3.new(0.15, 0.35, 0.45), CFrame = CFrame.new(0, 2.4, -0.6), Color = variant.Spots, CanCollide = false })
	for _, x in { -0.22, 0.22 } do
		add(model, body, { Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.15, CFrame = CFrame.new(x, 2, -0.95), Color = Color3.fromRGB(20, 20, 20), CanCollide = false })
		add(model, body, { Name = "Leg", Size = Vector3.new(0.12, 0.6, 0.12), CFrame = CFrame.new(x, 0.3, 0), Color = Color3.fromRGB(250, 170, 40), CanCollide = false })
		add(model, body, { Name = "Wing", Size = Vector3.new(0.15, 0.7, 1), CFrame = CFrame.new(x * 3, 1.2, 0.05), Color = variant.Body:Lerp(Color3.new(0, 0, 0), 0.08), CanCollide = false })
	end
	add(model, body, { Name = "Tail", Size = Vector3.new(0.7, 0.6, 0.3), CFrame = CFrame.new(0, 1.6, 0.8) * CFrame.Angles(math.rad(-30), 0, 0), Color = variant.Body, CanCollide = false })
	finish(model, body)
	return model
end

local BUILDERS = { Cow = cow, Chicken = chicken }

function AnimalModels.Build(animalId: string, variant: any): Model
	local folder = ServerStorage:FindFirstChild("Animals")
	local art = folder and folder:FindFirstChild(animalId)
	if art and art:IsA("Model") and art:FindFirstChild("Body") then
		local clone = art:Clone()
		clone.PrimaryPart = clone:FindFirstChild("Body") :: BasePart
		return clone
	end
	local builder = BUILDERS[animalId] or cow
	local model = builder(variant)
	model.Name = animalId
	return model
end

return AnimalModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">CropModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CropModels
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/CropModels
	DEPENDENCIES: Shared.Config.CropConfig

	Procedural crop visuals for each growth stage (1 Seed .. 6 Harvestable),
	by crop Shape (Grain, Root, Tall, Bush). Models are small and only rebuilt
	when a tile's stage changes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CropConfig = require(ReplicatedStorage.Shared.Config.CropConfig)

local CropModels = {}

local function part(model: Model, size: Vector3, cframe: CFrame, color: Color3, shape: Enum.PartType?, material: Enum.Material?)
	local newPart = Instance.new("Part")
	newPart.Anchored = true
	newPart.CanCollide = false
	newPart.CanQuery = false
	newPart.CanTouch = false
	newPart.CastShadow = false
	newPart.Shape = shape or Enum.PartType.Block
	newPart.Size = size
	newPart.CFrame = cframe
	newPart.Color = color
	newPart.Material = material or Enum.Material.SmoothPlastic
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	newPart.Parent = model
	return newPart
end

-- 3x3 grid of plants on a 4x4 tile.
local SPOTS = {
	Vector2.new(-1.1, -1.1), Vector2.new(0, -1.1), Vector2.new(1.1, -1.1),
	Vector2.new(-1.1, 0), Vector2.new(0, 0), Vector2.new(1.1, 0),
	Vector2.new(-1.1, 1.1), Vector2.new(0, 1.1), Vector2.new(1.1, 1.1),
}

-- `top` = CFrame of the tile's top surface centre.
function CropModels.Build(cropId: string, stage: number, top: CFrame): Model
	local crop = CropConfig.Crops[cropId]
	local model = Instance.new("Model")
	model.Name = "Crop"
	if not crop then
		return model
	end
	local stalk = crop.StalkColor
	local produce = crop.ProduceColor
	local growth = math.clamp((stage - 1) / 4, 0, 1) -- 0 at Seed, 1 at Mature
	local ready = stage >= #CropConfig.Stages

	for index, spot in SPOTS do
		local base = top * CFrame.new(spot.X, 0, spot.Y) * CFrame.Angles(0, index * 0.7, 0)
		if stage <= 1 then
			part(model, Vector3.new(0.35, 0.2, 0.35), base * CFrame.new(0, 0.1, 0), Color3.fromRGB(120, 85, 50), Enum.PartType.Ball)
		elseif crop.Shape == "Grain" then
			local height = 0.4 + growth * 2.4
			part(model, Vector3.new(0.12, height, 0.12), base * CFrame.new(0, height / 2, 0), if ready then Color3.fromRGB(215, 190, 90) else stalk)
			if stage >= 4 then
				part(model, Vector3.new(0.25, 0.7, 0.25), base * CFrame.new(0, height + 0.2, 0), if ready then produce else stalk:Lerp(produce, 0.3))
			end
		elseif crop.Shape == "Root" then
			local height = 0.3 + growth * 1.1
			for leaf = 1, 3 do
				part(model, Vector3.new(0.1, height, 0.35), base * CFrame.Angles(0, leaf * 2.1, math.rad(18)) * CFrame.new(0, height / 2, 0), stalk)
			end
			if ready then
				part(model, Vector3.new(0.45, 0.45, 0.45), base * CFrame.new(0, 0.1, 0), produce, Enum.PartType.Ball)
			end
		elseif crop.Shape == "Tall" then
			local height = 0.5 + growth * 3.6
			part(model, Vector3.new(0.18, height, 0.18), base * CFrame.new(0, height / 2, 0), stalk)
			if stage >= 3 then
				part(model, Vector3.new(0.9, 0.08, 0.3), base * CFrame.new(0.3, height * 0.6, 0) * CFrame.Angles(0, 0, math.rad(-25)), stalk)
			end
			if ready then
				part(model, Vector3.new(0.35, 0.9, 0.35), base * CFrame.new(0.15, height * 0.7, 0.1), produce)
			end
		else -- Bush
			local size = 0.3 + growth * 1.1
			part(model, Vector3.one * size, base * CFrame.new(0, size / 2, 0), stalk, Enum.PartType.Ball, Enum.Material.Grass)
			if ready then
				for berry = 1, 2 do
					part(model, Vector3.one * 0.35, base * CFrame.new(math.cos(berry * 2) * size * 0.4, size * 0.6, math.sin(berry * 2) * size * 0.4), produce, Enum.PartType.Ball)
				end
			end
		end
	end

	if ready then
		-- Gentle sparkle so ripe crops stand out (spec §150: subtle).
		local emitterPart = part(model, Vector3.new(3.6, 0.2, 3.6), top * CFrame.new(0, 1.5, 0), Color3.new(1, 1, 1))
		emitterPart.Transparency = 1
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Rate = 2
		sparkle.Lifetime = NumberRange.new(1, 1.5)
		sparkle.Speed = NumberRange.new(0.5, 1)
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
		sparkle.LightEmission = 1
		sparkle.Parent = emitterPart
	end
	return model
end

return CropModels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">IslandBuilder</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandBuilder
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandBuilder
	DEPENDENCIES: Shared.Config.IslandConfig, Shared.Util.IslandLayout, Server.Island.IslandProps

	Builds and tears down the physical island for one slot:
	  * smooth-terrain land lobes (starter + each UNLOCKED area),
	  * underwater sandbars previewing LOCKED areas,
	  * the island Model and its standard folder layout,
	  * starter props (spawn pad, sign, chest, dock, plots, palms, flowers).

	All positions come from IslandConfig in island-local space and are
	converted with the slot origin, so the same island builds identically in
	any slot on any server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandLayout = require(Shared.Util.IslandLayout)
local IslandProps = require(script.Parent.IslandProps)

local IslandBuilder = {}

-- Folders every island model contains (later phases fill them).
IslandBuilder.FolderNames = {
	"Terrain",
	"Props", -- non-blocking scenery (the house plot is meant to be built on)
	"Landmarks", -- spawn pad, dock, market stall, farm plots: never built over
	"Interactables",
	"AreaMarkers",
	"Buildings",
	"Decorations",
	"Resources",
	"Crops",
	"Animals",
	"Production",
	"FishingSpots",
}

local BIOME_SURFACE: { [string]: Enum.Material } = {
	Meadow = Enum.Material.Grass,
	Forest = Enum.Material.LeafyGrass,
	River = Enum.Material.Grass,
	Beach = Enum.Material.Sand,
	Mountain = Enum.Material.Rock,
	Cave = Enum.Material.Ground,
}

local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include
terrainParams.IgnoreWater = true

local function toWorld(origin: CFrame, localXZ: Vector2, y: number?): Vector3
	return (origin * CFrame.new(localXZ.X, y or 0, localXZ.Y)).Position
end

local function fillColumn(terrain: Terrain, center: Vector3, radius: number, bottom: number, top: number, material: Enum.Material)
	local height = top - bottom
	if height <= 0 or radius <= 0 then
		return
	end
	terrain:FillCylinder(CFrame.new(center.X, (top + bottom) / 2, center.Z), height, radius, material)
end

-- Raises one land lobe. `scale` (0..1] lets unlock animations grow the land.
function IslandBuilder.FillAreaLand(origin: CFrame, areaId: string, scale: number?)
	local area = IslandConfig.Areas[areaId]
	local terrain = workspace.Terrain :: Terrain
	local center = toWorld(origin, IslandLayout.GetAreaCenter(areaId))
	local sea = origin.Position.Y
	local bottom = sea - IslandConfig.LandDepth
	local s = scale or 1
	local radius = area.Radius * s
	local surface = BIOME_SURFACE[area.Biome] or Enum.Material.Grass

	fillColumn(terrain, center, radius + IslandConfig.ShallowsWidth * s, bottom, sea + IslandConfig.ShallowsHeight, Enum.Material.Sand)
	fillColumn(terrain, center, radius + IslandConfig.BeachWidth * s, bottom, sea + IslandConfig.BeachHeight, Enum.Material.Sand)
	fillColumn(terrain, center, radius, bottom, sea + IslandConfig.SurfaceHeight, surface)
end

function IslandBuilder.FillAreaSandbar(origin: CFrame, areaId: string)
	local area = IslandConfig.Areas[areaId]
	local center = toWorld(origin, IslandLayout.GetAreaCenter(areaId))
	local sea = origin.Position.Y
	fillColumn(workspace.Terrain :: Terrain, center, area.Radius, sea - IslandConfig.LandDepth, sea - IslandConfig.SandbarDepth, Enum.Material.Sand)
end

local function fillHills(origin: CFrame)
	for _, hill in IslandConfig.StarterLayout.Hills do
		-- Sink the ball so only a gentle `Height`-stud dome shows above the surface.
		local center = toWorld(origin, hill.Center, IslandConfig.SurfaceHeight + hill.Height - hill.Radius)
		local terrain = workspace.Terrain :: Terrain
		terrain:FillBall(center, hill.Radius, Enum.Material.Grass)
	end
end

-- Terrain height at an island-local XZ point (falls back to surface height).
function IslandBuilder.GroundCFrame(origin: CFrame, localXZ: Vector2, yawDegrees: number?): CFrame
	terrainParams.FilterDescendantsInstances = { workspace.Terrain }
	local top = toWorld(origin, localXZ, 80)
	local result = workspace:Raycast(top, Vector3.new(0, -160, 0), terrainParams)
	local y = if result then result.Position.Y else origin.Position.Y + IslandConfig.SurfaceHeight
	return CFrame.new(top.X, y, top.Z) * CFrame.Angles(0, math.rad(yawDegrees or 0), 0)
end

-- Yaw (degrees) that makes a prop's -Z face from `from` towards `to` (island-local).
local function facing(from: Vector2, to: Vector2): number
	local direction = to - from
	return math.deg(math.atan2(-direction.X, -direction.Y))
end

local function customProp(name: string): Model?
	local islands = ServerStorage:FindFirstChild("Islands")
	local props = islands and islands:FindFirstChild("Props")
	local template = props and props:FindFirstChild(name)
	if template and template:IsA("Model") then
		return template:Clone()
	end
	return nil
end

local function place(model: Model, parent: Instance, cframe: CFrame): Model
	model:PivotTo(cframe)
	model.Parent = parent
	return model
end

export type BuiltIsland = {
	Model: Model,
	Folders: { [string]: Folder },
	Sign: Model,
	Chest: Model,
	MarketStall: Model,
	SpawnCFrame: CFrame,
}

function IslandBuilder.CreateModel(name: string, parent: Instance): (Model, { [string]: Folder })
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Default
	local folders = {}
	for _, folderName in IslandBuilder.FolderNames do
		local folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = model
		folders[folderName] = folder
	end
	model.Parent = parent
	return model, folders
end

-- Builds terrain + starter props. `unlocked` = profile Island.UnlockedAreas.
function IslandBuilder.Build(origin: CFrame, model: Model, folders: { [string]: Folder }, unlocked: { [string]: boolean }): BuiltIsland
	-- The island model has no PrimaryPart, so pin its pivot to the island
	-- origin: clients use island:GetPivot() as the origin of island-local
	-- coordinates (build preview), exactly like the server's island.Origin.
	model.WorldPivot = origin
	-- Terrain: locked sandbars first, then land (starter first so lobes merge onto it).
	for _, areaId in IslandConfig.AreaOrder do
		if not unlocked[areaId] then
			IslandBuilder.FillAreaSandbar(origin, areaId)
		end
	end
	for _, areaId in IslandConfig.AreaOrder do
		if unlocked[areaId] then
			IslandBuilder.FillAreaLand(origin, areaId)
		end
	end
	fillHills(origin)

	local layout = IslandConfig.StarterLayout
	local props = folders.Props
	local landmarks = folders.Landmarks
	local interactables = folders.Interactables

	-- Spawn
	local spawnYaw = facing(layout.Spawn, layout.Spawn + layout.SpawnFacing)
	local spawnGround = IslandBuilder.GroundCFrame(origin, layout.Spawn, spawnYaw)
	place(customProp("SpawnPad") or IslandProps.SpawnPad(), landmarks, spawnGround)
	local spawnCFrame = spawnGround + Vector3.new(0, 4, 0)

	-- Island sign faces the spawn point.
	local sign = customProp("IslandSign") or IslandProps.Sign("My Island", "Island Level 1")
	place(sign, interactables, IslandBuilder.GroundCFrame(origin, layout.IslandSign, facing(layout.IslandSign, layout.Spawn)))

	-- Starter chest faces the spawn point.
	local chest = customProp("StarterChest") or IslandProps.StarterChest()
	place(chest, interactables, IslandBuilder.GroundCFrame(origin, layout.StarterChest, facing(layout.StarterChest, layout.Spawn)))

	-- Dock runs out to sea along +Z (local).
	local dockStart = layout.Dock.Start
	local dockCFrame = toWorld(origin, dockStart, 2.2)
	place(customProp("Dock") or IslandProps.Dock(layout.Dock.Length, layout.Dock.Width), landmarks, CFrame.new(dockCFrame) * CFrame.Angles(0, math.pi, 0))

	-- Market stall (sell + shop) faces the spawn point.
	local marketStall = customProp("MarketStall") or IslandProps.MarketStall()
	place(marketStall, landmarks, IslandBuilder.GroundCFrame(origin, layout.MarketStall, facing(layout.MarketStall, layout.Spawn)))

	-- House plot: a suggested building spot (non-blocking). Farm plots are
	-- built by FarmService (tiles) and are landmarks.
	local housePlot = place(customProp("HousePlot") or IslandProps.Plot("HousePlot", layout.HousePlot.Size), props, IslandBuilder.GroundCFrame(origin, layout.HousePlot.Center))
	housePlot:SetAttribute("Zone", "House")

	-- Decoration (non-harvestable palms and flowers).
	for index, position in layout.Palms do
		place(IslandProps.Palm(14 + (index % 3) * 2, index), folders.Decorations, IslandBuilder.GroundCFrame(origin, position, index * 47))
	end
	for index, position in layout.FlowerPatches do
		place(IslandProps.Flowers(index * 13), folders.Decorations, IslandBuilder.GroundCFrame(origin, position))
	end

	return {
		Model = model,
		Folders = folders,
		Sign = sign,
		Chest = chest,
		MarketStall = marketStall,
		SpawnCFrame = spawnCFrame,
	}
end

-- Places the 🔒 marker for a locked area. Returns the marker model.
function IslandBuilder.CreateAreaMarker(origin: CFrame, parent: Instance, areaId: string, requirementText: string): Model
	local area = IslandConfig.Areas[areaId]
	local position = IslandLayout.GetAreaMarkerPosition(areaId)
	-- The rope + stake side faces out towards the locked land; the post faces home.
	local marker = IslandProps.LockMarker(area.DisplayName, requirementText)
	marker:SetAttribute("AreaId", areaId)
	return place(marker, parent, IslandBuilder.GroundCFrame(origin, position, facing(position, Vector2.zero)))
end

-- Clears all island terrain back to open ocean. Used when a player leaves.
function IslandBuilder.ClearTerrain(origin: CFrame, restoreOcean: (center: Vector3, radius: number) -> ())
	for _, areaId in IslandConfig.AreaOrder do
		local area = IslandConfig.Areas[areaId]
		local center = toWorld(origin, IslandLayout.GetAreaCenter(areaId))
		restoreOcean(center, area.Radius + IslandConfig.ShallowsWidth + 4)
	end
end

return IslandBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">IslandProps</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandProps
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/IslandProps
	DEPENDENCIES: none

	Procedural low-poly props for the starter island (sign, chest, dock,
	palms, flowers, plots, locked-area markers). Every function builds the
	prop around the origin (base at Y = 0) and returns an unparented Model
	with WorldPivot at its base, ready for :PivotTo().

	To replace a prop with real art later, put a Model with the same name in
	ServerStorage/Islands/Props (e.g. "StarterChest"); IslandBuilder prefers
	art when it exists. Art must keep any "PromptAnchor" attachment and, for
	the chest, a "Lid" part.
]]

local IslandProps = {}

local COLORS = {
	Wood = Color3.fromRGB(165, 115, 70),
	WoodDark = Color3.fromRGB(120, 82, 50),
	SignBoard = Color3.fromRGB(215, 172, 115),
	ChestBody = Color3.fromRGB(150, 95, 52),
	Gold = Color3.fromRGB(255, 200, 60),
	Trunk = Color3.fromRGB(155, 115, 72),
	Leaves = Color3.fromRGB(70, 175, 75),
	LeavesDark = Color3.fromRGB(50, 145, 60),
	Stone = Color3.fromRGB(205, 200, 188),
	Soil = Color3.fromRGB(112, 76, 46),
	SoilDark = Color3.fromRGB(88, 58, 34),
	Text = Color3.fromRGB(70, 45, 25),
}

local FLOWER_COLORS = {
	Color3.fromRGB(255, 105, 130),
	Color3.fromRGB(255, 212, 80),
	Color3.fromRGB(185, 125, 255),
	Color3.fromRGB(255, 255, 255),
	Color3.fromRGB(255, 150, 70),
}

type PartProps = {
	Name: string?,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	Material: Enum.Material?,
	Shape: Enum.PartType?,
	CanCollide: boolean?,
	Transparency: number?,
}

local function part(parent: Instance, props: PartProps): Part
	local newPart = Instance.new("Part")
	newPart.Name = props.Name or "Part"
	newPart.Anchored = true
	newPart.Shape = props.Shape or Enum.PartType.Block
	newPart.Size = props.Size
	newPart.CFrame = props.CFrame
	newPart.Color = props.Color
	newPart.Material = props.Material or Enum.Material.SmoothPlastic
	newPart.CanCollide = if props.CanCollide == nil then true else props.CanCollide
	newPart.Transparency = props.Transparency or 0
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	newPart.Parent = parent
	return newPart
end

local function newModel(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	return model
end

local function finish(model: Model): Model
	model.WorldPivot = CFrame.new()
	return model
end

local function anchor(parent: BasePart, offset: Vector3)
	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptAnchor"
	attachment.Position = offset
	attachment.Parent = parent
end

-- A sign whose readable face (Front / -Z) looks down -Z.
function IslandProps.Sign(title: string, subtitle: string): Model
	local model = newModel("IslandSign")
	part(model, { Name = "PostL", Size = Vector3.new(0.5, 5, 0.5), CFrame = CFrame.new(-2.6, 2.5, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	part(model, { Name = "PostR", Size = Vector3.new(0.5, 5, 0.5), CFrame = CFrame.new(2.6, 2.5, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	local board = part(model, { Name = "Board", Size = Vector3.new(6.4, 2.8, 0.35), CFrame = CFrame.new(0, 3.9, -0.1), Color = COLORS.SignBoard, Material = Enum.Material.Wood })
	part(model, { Name = "Roof", Size = Vector3.new(7, 0.3, 0.9), CFrame = CFrame.new(0, 5.45, -0.1), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	anchor(board, Vector3.new(0, -1, -0.5))

	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0.6
	gui.Parent = board

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.fromScale(0.92, 0.55)
	titleLabel.Position = UDim2.fromScale(0.04, 0.05)
	titleLabel.Font = Enum.Font.FredokaOne
	titleLabel.TextScaled = true
	titleLabel.TextColor3 = COLORS.Text
	titleLabel.Text = title
	titleLabel.Parent = gui

	local subtitleLabel = Instance.new("TextLabel")
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.BackgroundTransparency = 1
	subtitleLabel.Size = UDim2.fromScale(0.92, 0.32)
	subtitleLabel.Position = UDim2.fromScale(0.04, 0.62)
	subtitleLabel.Font = Enum.Font.FredokaOne
	subtitleLabel.TextScaled = true
	subtitleLabel.TextColor3 = COLORS.WoodDark
	subtitleLabel.Text = subtitle
	subtitleLabel.Parent = gui

	return finish(model)
end

function IslandProps.SetSignText(sign: Model, title: string, subtitle: string)
	local board = sign:FindFirstChild("Board")
	local gui = board and board:FindFirstChild("SignGui")
	if not gui then
		return
	end
	local titleLabel = gui:FindFirstChild("Title")
	local subtitleLabel = gui:FindFirstChild("Subtitle")
	if titleLabel and titleLabel:IsA("TextLabel") then
		titleLabel.Text = title
	end
	if subtitleLabel and subtitleLabel:IsA("TextLabel") then
		subtitleLabel.Text = subtitle
	end
end

function IslandProps.StarterChest(): Model
	local model = newModel("StarterChest")
	local body = part(model, { Name = "Body", Size = Vector3.new(3.2, 1.8, 2.2), CFrame = CFrame.new(0, 0.9, 0), Color = COLORS.ChestBody, Material = Enum.Material.Wood })
	part(model, { Name = "BandL", Size = Vector3.new(0.3, 1.85, 2.25), CFrame = CFrame.new(-1.1, 0.9, 0), Color = COLORS.Gold, Material = Enum.Material.Metal })
	part(model, { Name = "BandR", Size = Vector3.new(0.3, 1.85, 2.25), CFrame = CFrame.new(1.1, 0.9, 0), Color = COLORS.Gold, Material = Enum.Material.Metal })
	local lid = part(model, { Name = "Lid", Size = Vector3.new(3.3, 0.7, 2.3), CFrame = CFrame.new(0, 2.15, 0), Color = COLORS.ChestBody, Material = Enum.Material.Wood })
	part(model, { Name = "Lock", Size = Vector3.new(0.5, 0.6, 0.2), CFrame = CFrame.new(0, 1.7, -1.15), Color = COLORS.Gold, Material = Enum.Material.Metal, CanCollide = false })
	anchor(body, Vector3.new(0, 0.8, 0))
	model.PrimaryPart = body
	-- Remember the closed lid pose relative to the body for OpenChest().
	lid:SetAttribute("ClosedOffset", body.CFrame:ToObjectSpace(lid.CFrame))
	return finish(model)
end

-- Rotates the lid open around its back edge.
function IslandProps.OpenChest(chest: Model)
	local body = chest:FindFirstChild("Body")
	local lid = chest:FindFirstChild("Lid")
	if not body or not lid or not body:IsA("BasePart") or not lid:IsA("BasePart") then
		return
	end
	local closed = lid:GetAttribute("ClosedOffset")
	if typeof(closed) ~= "CFrame" then
		return
	end
	local hinge = body.CFrame * closed * CFrame.new(0, -lid.Size.Y / 2, lid.Size.Z / 2)
	lid.CFrame = hinge * CFrame.Angles(math.rad(100), 0, 0) * CFrame.new(0, lid.Size.Y / 2, -lid.Size.Z / 2)
	local lock = chest:FindFirstChild("Lock")
	if lock and lock:IsA("BasePart") then
		lock.Transparency = 1
	end
end

-- Dock extends along -Z from its origin (rotate with PivotTo).
function IslandProps.Dock(length: number, width: number): Model
	local model = newModel("Dock")
	local plankDepth = 1.2
	local count = math.floor(length / (plankDepth + 0.15))
	for i = 0, count - 1 do
		local z = -(i * (plankDepth + 0.15) + plankDepth / 2)
		local shade = if i % 2 == 0 then COLORS.Wood else COLORS.Wood:Lerp(COLORS.WoodDark, 0.25)
		part(model, { Name = "Plank", Size = Vector3.new(width, 0.35, plankDepth), CFrame = CFrame.new(0, 0, z), Color = shade, Material = Enum.Material.WoodPlanks })
	end
	for z = 2, length, 6 do
		for _, x in { -width / 2 + 0.3, width / 2 - 0.3 } do
			part(model, { Name = "Post", Size = Vector3.new(0.6, 9, 0.6), CFrame = CFrame.new(x, -4, -z), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
		end
	end
	return finish(model)
end

function IslandProps.Palm(height: number, seed: number): Model
	local random = Random.new(seed)
	local model = newModel("PalmTree")
	local segments = 5
	local segmentHeight = height / segments
	local lean = random:NextNumber(-0.18, 0.18)
	local position = Vector3.zero
	for i = 1, segments do
		local offset = Vector3.new(lean * i * 0.6, segmentHeight, lean * i * 0.3)
		local center = position + offset / 2
		local thickness = 1.3 - i * 0.12
		part(model, {
			Name = "Trunk",
			Size = Vector3.new(thickness, segmentHeight + 0.2, thickness),
			CFrame = CFrame.lookAt(center, center + offset) * CFrame.Angles(-math.pi / 2, 0, 0),
			Color = if i % 2 == 0 then COLORS.Trunk else COLORS.Trunk:Lerp(COLORS.WoodDark, 0.3),
			Material = Enum.Material.Wood,
		})
		position += offset
	end
	local top = position
	for i = 1, 7 do
		local angle = (i / 7) * math.pi * 2 + random:NextNumber(-0.2, 0.2)
		local leaf = CFrame.new(top) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -2.6) * CFrame.Angles(math.rad(-22), 0, 0)
		part(model, {
			Name = "Leaf",
			Size = Vector3.new(1.4, 0.2, 5.4),
			CFrame = leaf,
			Color = if i % 2 == 0 then COLORS.Leaves else COLORS.LeavesDark,
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	for i = 1, 3 do
		local angle = i * 2.1
		part(model, {
			Name = "Coconut",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.8, 0.8, 0.8),
			CFrame = CFrame.new(top + Vector3.new(math.cos(angle) * 0.6, -0.5, math.sin(angle) * 0.6)),
			Color = Color3.fromRGB(110, 80, 45),
			CanCollide = false,
		})
	end
	return finish(model)
end

function IslandProps.Flowers(seed: number): Model
	local random = Random.new(seed)
	local model = newModel("Flowers")
	for _ = 1, 9 do
		local x, z = random:NextNumber(-3, 3), random:NextNumber(-3, 3)
		local stemHeight = random:NextNumber(0.6, 1.2)
		part(model, { Name = "Stem", Size = Vector3.new(0.12, stemHeight, 0.12), CFrame = CFrame.new(x, stemHeight / 2, z), Color = COLORS.LeavesDark, CanCollide = false })
		part(model, {
			Name = "Bloom",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(0.55, 0.55, 0.55),
			CFrame = CFrame.new(x, stemHeight, z),
			Color = FLOWER_COLORS[random:NextInteger(1, #FLOWER_COLORS)],
			CanCollide = false,
		})
	end
	return finish(model)
end

-- kind: "HousePlot" | "FarmPlot". Size in studs (X, Z).
function IslandProps.Plot(kind: string, size: Vector2): Model
	local model = newModel(kind)
	local border = 0.6
	local height = 0.35
	local color = if kind == "FarmPlot" then COLORS.WoodDark else COLORS.Stone
	local material = if kind == "FarmPlot" then Enum.Material.Wood else Enum.Material.Cobblestone
	part(model, { Name = "EdgeN", Size = Vector3.new(size.X, height, border), CFrame = CFrame.new(0, height / 2, -size.Y / 2), Color = color, Material = material })
	part(model, { Name = "EdgeS", Size = Vector3.new(size.X, height, border), CFrame = CFrame.new(0, height / 2, size.Y / 2), Color = color, Material = material })
	part(model, { Name = "EdgeW", Size = Vector3.new(border, height, size.Y), CFrame = CFrame.new(-size.X / 2, height / 2, 0), Color = color, Material = material })
	part(model, { Name = "EdgeE", Size = Vector3.new(border, height, size.Y), CFrame = CFrame.new(size.X / 2, height / 2, 0), Color = color, Material = material })

	if kind == "FarmPlot" then
		local rows = math.floor((size.Y - 2) / 2.5)
		for i = 0, rows - 1 do
			local z = -size.Y / 2 + 1.8 + i * 2.5
			part(model, { Name = "SoilRow", Size = Vector3.new(size.X - 2, 0.3, 1.6), CFrame = CFrame.new(0, 0.12, z), Color = if i % 2 == 0 then COLORS.Soil else COLORS.SoilDark, Material = Enum.Material.Ground, CanCollide = false })
		end
	else
		part(model, { Name = "Pad", Size = Vector3.new(size.X - border, 0.12, size.Y - border), CFrame = CFrame.new(0, 0.06, 0), Color = Color3.fromRGB(226, 214, 180), Material = Enum.Material.Sand, CanCollide = false, Transparency = 0.35 })
	end
	if kind == "FarmPlot" then
		-- Invisible blocker so nothing can be built over the farm.
		part(model, { Name = "Zone", Size = Vector3.new(size.X, 3, size.Y), CFrame = CFrame.new(0, 1.5, 0), Color = Color3.new(1, 1, 1), CanCollide = false, Transparency = 1 })
	end
	return finish(model)
end

-- Market stall: counter ("Sell" prompt) + sign board ("Shop" prompt). Faces -Z.
function IslandProps.MarketStall(): Model
	local model = newModel("MarketStall")
	local counter = part(model, { Name = "Counter", Size = Vector3.new(9, 3, 2.4), CFrame = CFrame.new(0, 1.5, -1), Color = COLORS.Wood, Material = Enum.Material.WoodPlanks })
	part(model, { Name = "CounterTop", Size = Vector3.new(9.4, 0.3, 2.8), CFrame = CFrame.new(0, 3.15, -1), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	for _, x in { -4.3, 4.3 } do
		for _, z in { -2, 2.6 } do
			part(model, { Name = "Post", Size = Vector3.new(0.5, 7.5, 0.5), CFrame = CFrame.new(x, 3.75, z), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
		end
	end
	-- Striped awning.
	for index = 0, 5 do
		local color = if index % 2 == 0 then Color3.fromRGB(235, 80, 70) else Color3.fromRGB(250, 245, 235)
		part(model, {
			Name = "Awning",
			Size = Vector3.new(1.6, 0.25, 6),
			CFrame = CFrame.new(-4 + index * 1.6, 7.8, 0.3) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = color,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
	-- Produce crates on the counter.
	local produce = { Color3.fromRGB(235, 200, 90), Color3.fromRGB(255, 140, 40), Color3.fromRGB(230, 50, 45), Color3.fromRGB(120, 200, 90) }
	for index, color in produce do
		local x = -3.4 + (index - 1) * 2.2
		part(model, { Name = "Crate", Size = Vector3.new(1.8, 0.8, 1.4), CFrame = CFrame.new(x, 3.7, -1), Color = COLORS.Wood, Material = Enum.Material.WoodPlanks, CanCollide = false })
		for ball = 1, 3 do
			part(model, { Name = "Produce", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), CFrame = CFrame.new(x - 0.5 + (ball - 1) * 0.5, 4.2, -1 + (ball % 2) * 0.3), Color = color, CanCollide = false })
		end
	end
	local board = part(model, { Name = "SignBoard", Size = Vector3.new(6, 1.6, 0.3), CFrame = CFrame.new(0, 9.1, -1.8), Color = COLORS.SignBoard, Material = Enum.Material.Wood })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0.5
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = COLORS.Text
	label.Text = "🛒 MARKET"
	label.Parent = gui
	-- Prompt anchors are the parts themselves (ShopService attaches to them).
	counter:SetAttribute("PromptRole", "Sell")
	local shopPost = part(model, { Name = "ShopCrate", Size = Vector3.new(1.6, 1.6, 1.6), CFrame = CFrame.new(5.6, 0.8, -2.2), Color = COLORS.Wood, Material = Enum.Material.WoodPlanks })
	shopPost:SetAttribute("PromptRole", "Shop")
	model.PrimaryPart = counter
	return finish(model)
end

-- Post + hanging sign marking where you can fish.
function IslandProps.FishingSpot(zoneName: string): Model
	local model = newModel("FishingSpot")
	local post = part(model, { Name = "Post", Size = Vector3.new(0.5, 4, 0.5), CFrame = CFrame.new(0, 2, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	part(model, { Name = "Board", Size = Vector3.new(2.6, 1.2, 0.2), CFrame = CFrame.new(0, 3.4, -0.3), Color = COLORS.SignBoard, Material = Enum.Material.Wood, CanCollide = false })
	part(model, { Name = "Fish", Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.5, 0.5), CFrame = CFrame.new(0, 3.4, -0.45), Color = Color3.fromRGB(90, 160, 230), CanCollide = false })
	anchor(post, Vector3.new(0, -1, 0))
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(7, 1.4)
	billboard.StudsOffset = Vector3.new(0, 3.6, 0)
	billboard.MaxDistance = 90
	billboard.LightInfluence = 0
	billboard.Parent = post
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.3
	label.Text = "🎣 " .. zoneName
	label.Parent = billboard
	model.PrimaryPart = post
	return finish(model)
end

-- Marker on the starter shore for a locked expansion area. Faces -Z.
function IslandProps.LockMarker(areaName: string, requirementText: string): Model
	local model = newModel("AreaLock")
	local post = part(model, { Name = "Post", Size = Vector3.new(0.6, 6, 0.6), CFrame = CFrame.new(0, 3, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	part(model, { Name = "Banner", Size = Vector3.new(3.2, 2, 0.15), CFrame = CFrame.new(1.8, 4.8, 0), Color = Color3.fromRGB(90, 190, 255), Material = Enum.Material.Fabric, CanCollide = false })
	part(model, { Name = "RopeL", Size = Vector3.new(0.2, 0.2, 6), CFrame = CFrame.new(-2.5, 1.2, 0) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(220, 190, 130), CanCollide = false })
	part(model, { Name = "Stake", Size = Vector3.new(0.4, 2, 0.4), CFrame = CFrame.new(-5.5, 1, 0), Color = COLORS.WoodDark, Material = Enum.Material.Wood })
	anchor(post, Vector3.new(0, -1.5, 0))
	model.PrimaryPart = post

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "LockBillboard"
	billboard.Size = UDim2.fromScale(9, 3.2)
	billboard.StudsOffset = Vector3.new(0, 4.5, 0)
	billboard.MaxDistance = 160
	billboard.LightInfluence = 0
	billboard.Parent = post

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 250, 238)
	frame.BackgroundTransparency = 0.05
	frame.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.2, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(70, 50, 30)
	stroke.Parent = frame

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "AreaName"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(0.94, 0.55)
	nameLabel.Position = UDim2.fromScale(0.03, 0.04)
	nameLabel.Font = Enum.Font.FredokaOne
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.fromRGB(60, 40, 25)
	nameLabel.Text = "🔒 " .. areaName
	nameLabel.Parent = frame

	local requirementLabel = Instance.new("TextLabel")
	requirementLabel.Name = "Requirement"
	requirementLabel.BackgroundTransparency = 1
	requirementLabel.Size = UDim2.fromScale(0.94, 0.36)
	requirementLabel.Position = UDim2.fromScale(0.03, 0.58)
	requirementLabel.Font = Enum.Font.FredokaOne
	requirementLabel.TextScaled = true
	requirementLabel.TextColor3 = Color3.fromRGB(150, 100, 40)
	requirementLabel.Text = requirementText
	requirementLabel.Parent = frame

	return finish(model)
end

function IslandProps.SpawnPad(): Model
	local model = newModel("SpawnPad")
	part(model, {
		Name = "Pad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 9, 9),
		CFrame = CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = COLORS.Stone,
		Material = Enum.Material.Slate,
	})
	part(model, {
		Name = "Ring",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.42, 6, 6),
		CFrame = CFrame.new(0, 0.22, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 210, 255),
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
	return finish(model)
end

return IslandProps
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">NodeModels</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  NodeModels
	SCRIPT TYPE:  ModuleScript (server)
	WHERE:        ServerScriptService/Server/Island/NodeModels
	DEPENDENCIES: none

	Procedural resource-node models (trees, rocks, ore, crystals, bushes,
	sand, clay). Each model:
	  * is built around the origin with its base at Y = 0,
	  * has an invisible "Hitbox" PrimaryPart (targeting + build blocking),
	  * has a "PromptAnchor" attachment at a comfortable height,
	  * stores BaseTransparency on every part so pooling can hide/show it.
	Put a Model named after the node's Model key in ServerStorage/Resources
	to use real art instead (keep a Hitbox part and a PromptAnchor).
]]

local ServerStorage = game:GetService("ServerStorage")

local NodeModels = {}

local function part(model: Model, props: { [string]: any }): BasePart
	local newPart = Instance.new("Part")
	newPart.Anchored = true
	newPart.TopSurface = Enum.SurfaceType.Smooth
	newPart.BottomSurface = Enum.SurfaceType.Smooth
	newPart.Material = Enum.Material.SmoothPlastic
	-- Shape first: changing Shape afterwards can resize the part.
	if props.Shape then
		newPart.Shape = props.Shape
	end
	for key, value in props do
		if key ~= "Shape" then
			(newPart :: any)[key] = value
		end
	end
	newPart:SetAttribute("BaseTransparency", newPart.Transparency)
	newPart:SetAttribute("BaseCanCollide", newPart.CanCollide)
	newPart.Parent = model
	return newPart
end

local function hitbox(model: Model, size: Vector3, promptHeight: number)
	local box = part(model, {
		Name = "Hitbox",
		Size = size,
		CFrame = CFrame.new(0, size.Y / 2, 0),
		Transparency = 1,
		CanCollide = false,
	})
	local anchor = Instance.new("Attachment")
	anchor.Name = "PromptAnchor"
	anchor.Position = Vector3.new(0, promptHeight - size.Y / 2, 0)
	anchor.Parent = box
	model.PrimaryPart = box
end

local function vertical(height: number, diameter: number): Vector3
	return Vector3.new(height, diameter, diameter)
end
local UPRIGHT = CFrame.Angles(0, 0, math.rad(90))

local BUILDERS: { [string]: (Model, Random) -> () } = {}

BUILDERS.Oak = function(model, random)
	local trunkHeight = random:NextNumber(5.5, 7)
	part(model, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = vertical(trunkHeight, 1.6), CFrame = CFrame.new(0, trunkHeight / 2, 0) * UPRIGHT, Color = Color3.fromRGB(120, 85, 55), Material = Enum.Material.Wood })
	local greens = { Color3.fromRGB(80, 170, 70), Color3.fromRGB(95, 185, 80), Color3.fromRGB(70, 150, 60) }
	for index, spec in { { 0, 0, 0, 6.2 }, { 1.6, -0.6, 0.8, 4.6 }, { -1.4, -0.4, -1, 4.4 } } do
		part(model, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * spec[4],
			CFrame = CFrame.new(spec[1], trunkHeight + 1.8 + spec[2], spec[3]),
			Color = greens[index],
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(3, trunkHeight + 1, 3), 3)
end

BUILDERS.Pine = function(model, random)
	local trunkHeight = random:NextNumber(4, 5)
	part(model, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = vertical(trunkHeight + 3, 1.2), CFrame = CFrame.new(0, (trunkHeight + 3) / 2, 0) * UPRIGHT, Color = Color3.fromRGB(105, 70, 45), Material = Enum.Material.Wood })
	for index = 1, 4 do
		local width = 6.4 - index * 1.25
		part(model, {
			Name = "Needles",
			Size = Vector3.new(width, 1.8, width),
			CFrame = CFrame.new(0, trunkHeight + index * 1.5, 0) * CFrame.Angles(0, math.rad(index * 22), 0),
			Color = Color3.fromRGB(40, 120 + index * 8, 70),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(2.6, trunkHeight + 1, 2.6), 3)
end

BUILDERS.Ancient = function(model, _random)
	part(model, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = vertical(10, 2.8), CFrame = CFrame.new(0, 5, 0) * UPRIGHT, Color = Color3.fromRGB(95, 70, 60), Material = Enum.Material.Wood })
	for index, spec in { { 0, 0, 0, 8 }, { 2.4, -1, 1, 6 }, { -2.2, -0.6, -1.4, 6 } } do
		part(model, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * spec[4],
			CFrame = CFrame.new(spec[1], 12 + spec[2], spec[3]),
			Color = if index == 1 then Color3.fromRGB(90, 200, 170) else Color3.fromRGB(70, 170, 150),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(4, 10, 4), 3.5)
end

local function rockPile(model: Model, random: Random, color: Color3, scale: number)
	for index = 1, 3 do
		local size = Vector3.new(random:NextNumber(2.2, 3.2), random:NextNumber(1.6, 2.6), random:NextNumber(2.2, 3.2)) * scale
		part(model, {
			Name = "Rock",
			Size = size,
			CFrame = CFrame.new(random:NextNumber(-0.8, 0.8), size.Y / 2 - 0.3, random:NextNumber(-0.8, 0.8))
				* CFrame.Angles(random:NextNumber(-0.3, 0.3), random:NextNumber(0, math.pi), random:NextNumber(-0.3, 0.3)),
			Color = color:Lerp(Color3.new(1, 1, 1), (index - 1) * 0.06),
			Material = Enum.Material.Slate,
		})
	end
end

BUILDERS.Rock = function(model, random)
	rockPile(model, random, Color3.fromRGB(135, 132, 128), 1)
	hitbox(model, Vector3.new(4.4, 3, 4.4), 2)
end

BUILDERS.Iron = function(model, random)
	rockPile(model, random, Color3.fromRGB(110, 105, 100), 1.1)
	for _ = 1, 5 do
		part(model, {
			Name = "Ore",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * random:NextNumber(0.6, 0.9),
			CFrame = CFrame.new(random:NextNumber(-1.4, 1.4), random:NextNumber(1, 2.4), random:NextNumber(-1.4, 1.4)),
			Color = Color3.fromRGB(190, 110, 70),
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(4.6, 3.2, 4.6), 2)
end

BUILDERS.Crystal = function(model, random)
	rockPile(model, random, Color3.fromRGB(90, 85, 110), 0.9)
	for index = 1, 4 do
		local height = random:NextNumber(2.2, 3.6)
		part(model, {
			Name = "Crystal",
			Size = Vector3.new(0.7, height, 0.7),
			CFrame = CFrame.new(random:NextNumber(-1, 1), 1.4 + height / 2, random:NextNumber(-1, 1))
				* CFrame.Angles(random:NextNumber(-0.4, 0.4), index, random:NextNumber(-0.4, 0.4)),
			Color = Color3.fromRGB(130, 230, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.15,
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(4, 4, 4), 2)
end

BUILDERS.Bush = function(model, random)
	for index = 1, 3 do
		part(model, {
			Name = "Bush",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * random:NextNumber(2, 2.8),
			CFrame = CFrame.new(math.cos(index * 2.1) * 0.8, 1, math.sin(index * 2.1) * 0.8),
			Color = Color3.fromRGB(95, 160 + index * 10, 70),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	for index = 1, 5 do
		part(model, {
			Name = "Fiber",
			Size = Vector3.new(0.12, 1.4, 0.12),
			CFrame = CFrame.new(math.cos(index) * 0.7, 2.2, math.sin(index) * 0.7) * CFrame.Angles(0.2, index, 0.2),
			Color = Color3.fromRGB(225, 210, 140),
			CanCollide = false,
		})
	end
	hitbox(model, Vector3.new(3, 2.6, 3), 1.5)
end

BUILDERS.Sand = function(model, _random)
	part(model, { Name = "Pile", Shape = Enum.PartType.Cylinder, Size = vertical(1.2, 4), CFrame = CFrame.new(0, 0.5, 0) * UPRIGHT, Color = Color3.fromRGB(240, 220, 160), Material = Enum.Material.Sand })
	part(model, { Name = "Top", Shape = Enum.PartType.Cylinder, Size = vertical(0.6, 2.6), CFrame = CFrame.new(0, 1.3, 0) * UPRIGHT, Color = Color3.fromRGB(245, 228, 175), Material = Enum.Material.Sand })
	part(model, { Name = "Shell", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.5, CFrame = CFrame.new(0.8, 1.2, -0.4), Color = Color3.fromRGB(255, 200, 190), CanCollide = false })
	hitbox(model, Vector3.new(4, 1.6, 4), 1.2)
end

BUILDERS.Clay = function(model, _random)
	part(model, { Name = "Clay", Shape = Enum.PartType.Cylinder, Size = vertical(0.5, 4), CFrame = CFrame.new(0, 0.2, 0) * UPRIGHT, Color = Color3.fromRGB(185, 110, 75), Material = Enum.Material.Mud })
	part(model, { Name = "Lump", Shape = Enum.PartType.Ball, Size = Vector3.one * 1, CFrame = CFrame.new(-0.6, 0.5, 0.4), Color = Color3.fromRGB(170, 100, 70), Material = Enum.Material.Mud })
	hitbox(model, Vector3.new(4, 1.2, 4), 1)
end

-- seed keeps each node's random shape stable across servers.
function NodeModels.Build(modelKey: string, seed: number): Model
	local folder = ServerStorage:FindFirstChild("Resources")
	local art = folder and folder:FindFirstChild(modelKey)
	if art and art:IsA("Model") and art:FindFirstChild("Hitbox") then
		local clone = art:Clone()
		clone.PrimaryPart = clone:FindFirstChild("Hitbox") :: BasePart
		for _, descendant in clone:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant:SetAttribute("BaseTransparency", descendant.Transparency)
				descendant:SetAttribute("BaseCanCollide", descendant.CanCollide)
			end
		end
		clone.WorldPivot = CFrame.new()
		return clone
	end

	local model = Instance.new("Model")
	model.Name = modelKey
	local builder = BUILDERS[modelKey] or BUILDERS.Rock
	builder(model, Random.new(seed))
	model.WorldPivot = CFrame.new()
	return model
end

-- Hide / show a pooled node without destroying it.
function NodeModels.SetVisible(model: Model, visible: boolean)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			local baseTransparency = descendant:GetAttribute("BaseTransparency")
			local baseCollide = descendant:GetAttribute("BaseCanCollide")
			descendant.Transparency = if visible then (if type(baseTransparency) == "number" then baseTransparency else 0) else 1
			descendant.CanCollide = visible and baseCollide == true
		end
	end
end

return NodeModels
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="57">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Main
	SCRIPT TYPE:  Script (server entry point)
	WHERE:        ServerScriptService/Server/Main
	DEPENDENCIES: every module in ServerScriptService/Server/Services, Shared.Net

	Boots the server in a deterministic order:
	  1. Net.Init()        create ReplicatedStorage/Remotes from RemoteConfig
	  2. Service.Init()    register handlers/kinds; no cross-service calls that yield
	  3. Service.Start()   connect events, start loops, accept players
	  4. Net.FinalizeHandlers()  drain remotes no phase handles yet

	Every service boots in isolation: if one fails, the error is logged with a
	traceback, published to ReplicatedStorage's "ServerBootErrors" attribute
	(the client shows it on screen), and the remaining services still start.

	SERVICE LAYERS (a service may only require services ABOVE it in this list,
	which keeps require() free of cycles):
		DataService, AntiExploitService, WorldService, SoundService, VFXService, AnimationService
		EconomyService, InventoryService, ProgressionService
		InteractionService, ToolService
		IslandService
		ResourceService, GatherService, BuildService, CropService, FarmService,
		FishingService, AnimalService, ShopService, NPCService, QuestService
		PlayerService, AdminService
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage.Shared.Net)
local Services = script.Parent.Services

local SERVICE_ORDER = {
	"DataService",
	"AntiExploitService",
	"WorldService",
	"SoundService",
	"VFXService",
	"AnimationService",
	"EconomyService",
	"InventoryService",
	"ProgressionService",
	"InteractionService",
	"ToolService",
	"IslandService",
	"ResourceService",
	"GatherService",
	"BuildService",
	"CropService",
	"FarmService",
	"FishingService",
	"AnimalService",
	"ShopService",
	"NPCService",
	"QuestService",
	"PlayerService",
	"AdminService",
}

local bootErrors: { string } = {}

local function report(label: string, err: any)
	local message = ("%s failed: %s"):format(label, tostring(err))
	warn("[Build Your Island] " .. message)
	table.insert(bootErrors, message)
	ReplicatedStorage:SetAttribute("ServerBootErrors", table.concat(bootErrors, "\n"))
end

Net.Init()

local loaded = {}
for _, name in SERVICE_ORDER do
	local module = Services:FindFirstChild(name)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok then
			loaded[name] = result :: any
		else
			report(name .. " (require)", result)
		end
	else
		report(name, "module is missing from ServerScriptService/Server/Services")
	end
end

for _, phase in { "Init", "Start" } do
	for _, name in SERVICE_ORDER do
		local service = loaded[name]
		if service and type(service[phase]) == "function" then
			local ok, err = xpcall(service[phase], debug.traceback)
			if not ok then
				report(name .. "." .. phase, err)
			end
		end
	end
end

Net.FinalizeHandlers()

if #bootErrors == 0 then
	print("[Build Your Island] Server ready —", #SERVICE_ORDER, "services started")
else
	warn(("[Build Your Island] Server started with %d error(s) — see messages above"):format(#bootErrors))
end
]]></string>
        </Properties>
      </Item>
