            <string name="Name">Build</string>
          </Properties>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">LandEditor</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  LandEditor
	SCRIPT TYPE:  ModuleScript (client, used by BuildController)
	WHERE:        StarterPlayerScripts/Client/Build/LandEditor
	DEPENDENCIES: Shared.Net, Shared.Config.IslandConfig, Shared.Util.{IslandGen, Format}, Client.ClientState,
	              Controllers.InputController, Controllers.AudioController

	The two island-shaping tools in build mode:

	  EXPAND  every water chunk touching your land glows on the sea. Hover
	          one to see its price, click to buy it (ExpandIslandRequest);
	          the server raises the new land out of the sea. Grow in ANY
	          direction — no two islands end up the same shape.
	  PAINT   pick a material (grass, sand, snow, cobble path, brick, wood
	          deck...) and click / drag over your land to paint 8x8-stud
	          cells (PaintTerrainRequest, batched). The eraser restores the
	          natural look.

	Everything here is a preview: the server validates every request.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandGen = require(Shared.Util.IslandGen)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local InputController = require(Client.Controllers.InputController)
local AudioController = require(Client.Controllers.AudioController)

local player = Players.LocalPlayer
local CHUNK = IslandConfig.ChunkSize
local CELL = IslandConfig.PaintCellSize
local PAINT_FLUSH = 0.1

-- Approximate swatch colours for the brush preview.
local MATERIAL_COLORS: { [string]: Color3 } = {
	Grass = Color3.fromRGB(106, 190, 72),
	LeafyGrass = Color3.fromRGB(226, 150, 60),
	Snow = Color3.fromRGB(245, 250, 255),
	Sand = Color3.fromRGB(240, 220, 160),
	Sandstone = Color3.fromRGB(220, 160, 100),
	Ground = Color3.fromRGB(140, 105, 70),
	Mud = Color3.fromRGB(100, 72, 50),
	Cobblestone = Color3.fromRGB(150, 150, 150),
	Brick = Color3.fromRGB(180, 90, 70),
	WoodPlanks = Color3.fromRGB(170, 120, 72),
	Pavement = Color3.fromRGB(120, 120, 124),
	Slate = Color3.fromRGB(90, 90, 96),
	Limestone = Color3.fromRGB(230, 225, 205),
}

local LandEditor = {}

LandEditor.Mode = nil :: string?
LandEditor.Material = "Cobblestone"

local sampler: any = nil
local expandFolder: Folder? = nil
local expandTiles: { [string]: Part } = {}
local hoverKey: string? = nil
local brush: Part? = nil
local pendingCells: { { X: number, Z: number } } = {}
local pendingSet: { [string]: boolean } = {}
local lastFlush = 0
local terrainParams = RaycastParams.new()
terrainParams.FilterType = Enum.RaycastFilterType.Include

local function myIsland(): Model?
	local folder = workspace:FindFirstChild("Islands")
	local island = folder and folder:FindFirstChild("Island_" .. player.UserId)
	return if island and island:IsA("Model") then island else nil
end

local function islandData(): any
	return ClientState.Get("Island") or {}
end

local function rebuildSampler()
	local data = islandData()
	if type(data.Chunks) ~= "table" then
		sampler = nil
		return
	end
	sampler = IslandGen.NewSampler({ Seed = data.Seed or 1, Theme = data.Theme or IslandConfig.DefaultTheme, Chunks = data.Chunks, Paint = data.Paint or {} })
end

function LandEditor.GetSampler(): any
	if not sampler then
		rebuildSampler()
	end
	return sampler
end

-- (count, max, cost)
function LandEditor.ExpansionInfo(): (number, number, number)
	local data = islandData()
	local count = IslandGen.CountChunks(data.Chunks or {})
	return count, IslandGen.MaxChunks(data.Level or 1), IslandGen.ExpansionCost(count)
end

local function pointerRay(screenPoint: Vector2?): Ray?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local point = screenPoint or UserInputService:GetMouseLocation()
	if InputController.IsTouch() and not screenPoint then
		point = camera.ViewportSize / 2
	end
	return camera:ViewportPointToRay(point.X, point.Y)
end

---------------------------------------------------------------------------
-- EXPAND
---------------------------------------------------------------------------

local function clearExpand()
	if expandFolder then
		expandFolder:Destroy()
		expandFolder = nil
	end
	table.clear(expandTiles)
	hoverKey = nil
end

local function tileColor(affordable: boolean, hovered: boolean): Color3
	if not affordable then
		return if hovered then Color3.fromRGB(255, 120, 110) else Color3.fromRGB(230, 90, 80)
	end
	return if hovered then Color3.fromRGB(150, 255, 170) else Color3.fromRGB(90, 230, 255)
end

function LandEditor.RefreshExpand()
	clearExpand()
	if LandEditor.Mode ~= "Expand" then
		return
	end
	local island = myIsland()
	if not island then
		return
	end
	local origin = island:GetPivot()
	local folder = Instance.new("Folder")
	folder.Name = "ExpandTiles"
	folder.Parent = workspace.CurrentCamera
	expandFolder = folder
	local count, maxChunks, cost = LandEditor.ExpansionInfo()
	local coins = ClientState.Get("Coins") or 0
	local affordable = coins >= cost and count < maxChunks
	for _, candidate in IslandGen.ExpansionCandidates(islandData().Chunks or {}) do
		local tile = Instance.new("Part")
		tile.Name = IslandGen.Key(candidate.X, candidate.Z)
		tile.Anchored = true
		tile.CanCollide = false
		tile.CanTouch = false
		tile.CastShadow = false
		tile.Material = Enum.Material.Neon
		tile.Transparency = 0.62
		tile.Size = Vector3.new(CHUNK - 0.8, 0.4, CHUNK - 0.8)
		tile.CFrame = origin * CFrame.new(candidate.X * CHUNK, 0.35, candidate.Z * CHUNK)
		tile.Color = tileColor(affordable, false)
		tile:SetAttribute("CX", candidate.X)
		tile:SetAttribute("CZ", candidate.Z)
		tile.Parent = folder
		expandTiles[tile.Name] = tile
	end
end

local function expandTileUnder(screenPoint: Vector2?): Part?
	local ray = pointerRay(screenPoint)
	if not ray or not expandFolder then
		return nil
	end
	terrainParams.FilterDescendantsInstances = { expandFolder }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, terrainParams)
	return if hit and hit.Instance:IsA("Part") then hit.Instance else nil
end

---------------------------------------------------------------------------
-- PAINT
---------------------------------------------------------------------------

local function clearBrush()
	if brush then
		brush:Destroy()
		brush = nil
	end
end

local function ensureBrush(): Part
	if brush and brush.Parent then
		return brush
	end
	local part = Instance.new("Part")
	part.Name = "PaintBrush"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	part.Transparency = 0.45
	part.Size = Vector3.new(CELL, 0.25, CELL)
	part.Parent = workspace.CurrentCamera
	brush = part
	return part
end

-- The paint cell under the pointer, if it's on your own land.
local function paintCellUnder(screenPoint: Vector2?): ({ X: number, Z: number }?, Vector3?)
	local island = myIsland()
	local ray = pointerRay(screenPoint)
	local currentSampler = LandEditor.GetSampler()
	if not island or not ray or not currentSampler then
		return nil, nil
	end
	terrainParams.FilterDescendantsInstances = { workspace.Terrain }
	terrainParams.IgnoreWater = true
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 500, terrainParams)
	if not hit then
		return nil, nil
	end
	local origin = island:GetPivot()
	local localHit = origin:PointToObjectSpace(hit.Position)
	local cellX, cellZ = math.floor(localHit.X / CELL), math.floor(localHit.Z / CELL)
	local centerX, centerZ = (cellX + 0.5) * CELL, (cellZ + 0.5) * CELL
	local cx, cz = IslandGen.ChunkOf(centerX, centerZ)
	if not currentSampler:IsOwnedChunk(cx, cz) then
		return nil, nil
	end
	local world = origin * CFrame.new(centerX, localHit.Y + 0.15, centerZ)
	return { X = cellX, Z = cellZ }, world.Position
end

local function flushPaint(force: boolean?)
	if #pendingCells == 0 then
		return
	end
	local now = os.clock()
	if not force and now - lastFlush < PAINT_FLUSH then
		return
	end
	lastFlush = now
	local batch = {}
	for index = 1, math.min(24, #pendingCells) do
		table.insert(batch, pendingCells[index])
	end
	for _ = 1, #batch do
		table.remove(pendingCells, 1)
	end
	Net.FireServer("PaintTerrainRequest", batch, LandEditor.Material)
	AudioController.Play("UIClick")
	if #pendingCells == 0 then
		table.clear(pendingSet)
	end
end

local function queueCell(cell: { X: number, Z: number })
	local key = cell.X .. "_" .. cell.Z
	local painted = (islandData().Paint or {})[key] or ""
	if pendingSet[key] or painted == LandEditor.Material then
		return
	end
	pendingSet[key] = true
	table.insert(pendingCells, cell)
end

---------------------------------------------------------------------------
-- Public
---------------------------------------------------------------------------

function LandEditor.Enter(mode: string)
	LandEditor.Mode = mode
	rebuildSampler()
	clearExpand()
	clearBrush()
	if mode == "Expand" then
		LandEditor.RefreshExpand()
	end
end

function LandEditor.Exit()
	flushPaint(true)
	LandEditor.Mode = nil
	clearExpand()
	clearBrush()
end

function LandEditor.SetMaterial(material: string)
	LandEditor.Material = material
end

-- Per frame while a land mode is active. Returns a status line for the info panel.
function LandEditor.Step(): (string, boolean)
	if LandEditor.Mode == "Expand" then
		local tile = expandTileUnder(nil)
		local key = tile and tile.Name
		if key ~= hoverKey then
			local count, maxChunks, cost = LandEditor.ExpansionInfo()
			local affordable = (ClientState.Get("Coins") or 0) >= cost and count < maxChunks
			if hoverKey and expandTiles[hoverKey] then
				expandTiles[hoverKey].Color = tileColor(affordable, false)
				expandTiles[hoverKey].Transparency = 0.62
			end
			hoverKey = key
			if tile then
				tile.Color = tileColor(affordable, true)
				tile.Transparency = 0.35
			end
		end
		local count, maxChunks, cost = LandEditor.ExpansionInfo()
		if count >= maxChunks then
			return ("Land %d/%d — level up your island to expand further"):format(count, maxChunks), false
		end
		local coins = ClientState.Get("Coins") or 0
		return ("Land %d/%d · next chunk %s 🪙"):format(count, maxChunks, Format.Commas(cost)), coins >= cost
	elseif LandEditor.Mode == "Paint" then
		local cell, position = paintCellUnder(nil)
		if cell and position then
			local part = ensureBrush()
			part.Position = position
			part.Color = if LandEditor.Material == "" then Color3.fromRGB(255, 255, 255) else (MATERIAL_COLORS[LandEditor.Material] or Color3.new(1, 1, 1))
			part.Transparency = if LandEditor.Material == "" then 0.7 else 0.45
			if InputController.IsHeld("BuildPlace") then
				queueCell(cell)
			end
		elseif brush then
			brush.Transparency = 1
		end
		flushPaint(false)
		local name = if LandEditor.Material == "" then "Eraser" else IslandConfig.Paint[LandEditor.Material].DisplayName
		return ("Painting: %s · click or drag on your land"):format(name), true
	end
	return "", false
end

-- A click / tap in a land mode.
function LandEditor.Click(screenPoint: Vector2?)
	if LandEditor.Mode == "Expand" then
		local tile = expandTileUnder(screenPoint)
		if tile then
			local count, maxChunks, cost = LandEditor.ExpansionInfo()
			if count >= maxChunks then
				AudioController.Play("UIError")
				return
			end
			if (ClientState.Get("Coins") or 0) < cost then
				AudioController.Play("UIError")
				return
			end
			Net.FireServer("ExpandIslandRequest", tile:GetAttribute("CX"), tile:GetAttribute("CZ"))
			tile.Transparency = 0.2
			AudioController.Play("UIClick")
		end
	elseif LandEditor.Mode == "Paint" then
		local cell = paintCellUnder(screenPoint)
		if cell then
			queueCell(cell)
			flushPaint(true)
		end
	end
end

function LandEditor.Start()
	ClientState.Observe("Island", function()
		rebuildSampler()
		if LandEditor.Mode == "Expand" then
			LandEditor.RefreshExpand()
		end
	end)
	ClientState.Observe("Coins", function()
		if LandEditor.Mode == "Expand" then
			LandEditor.RefreshExpand()
		end
	end)
end

LandEditor.MaterialColors = MATERIAL_COLORS

return LandEditor
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">ClientState</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ClientState
	SCRIPT TYPE:  ModuleScript (client)
	WHERE:        StarterPlayerScripts/Client/ClientState
	DEPENDENCIES: Shared.Net, Shared.Util.Signal

	READ-ONLY mirror of the local player's profile, fed by the server's
	StateSync remote (one full snapshot, then batched path updates). The
	client never writes here except by applying server packets — to change
	anything the client sends a request and waits for the server's update.

	Usage:
		ClientState.Observe("Coins", function(coins) ... end) -- fires now (if ready) + on every change
		ClientState.Get("Island", "Level")
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))

local ClientState = {}

ClientState.Ready = Signal.new() -- fires once, when the first full snapshot arrives
ClientState.Changed = Signal.new() -- (topLevelKey, path)

local data: { [string]: any }? = nil
local observers: { [string]: any } = {}

local function getSignal(key: string)
	local signal = observers[key]
	if not signal then
		signal = Signal.new()
		observers[key] = signal
	end
	return signal
end

local function notify(key: string, path: { string }?)
	local signal = observers[key]
	if signal and data then
		signal:Fire(data[key], path)
	end
	ClientState.Changed:Fire(key, path)
end

local function applyOp(op: { Path: { string }, Value: any })
	if not data or type(op.Path) ~= "table" or #op.Path == 0 then
		return
	end
	local node = data
	for index = 1, #op.Path - 1 do
		local key = op.Path[index]
		if type(node[key]) ~= "table" then
			node[key] = {}
		end
		node = node[key]
	end
	node[op.Path[#op.Path]] = op.Value
end

function ClientState.IsReady(): boolean
	return data ~= nil
end

function ClientState.WaitForReady()
	if not data then
		ClientState.Ready:Wait()
	end
end

-- ClientState.Get("Inventory", "Items", "Wood")
function ClientState.Get(...: string): any
	local node: any = data
	for _, key in { ... } do
		if type(node) ~= "table" then
			return nil
		end
		node = node[key]
	end
	return node
end

-- Calls callback(value) immediately if ready, then after every change to data[key].
function ClientState.Observe(key: string, callback: (value: any, path: { string }?) -> ())
	local connection = getSignal(key):Connect(callback)
	if data then
		task.spawn(callback, data[key], nil)
	end
	return connection
end

function ClientState.Init()
	Net.OnClientEvent("StateSync", function(packet: any)
		if type(packet) ~= "table" then
			return
		end
		if type(packet.Full) == "table" then
			local firstSnapshot = data == nil
			data = packet.Full
			for key in packet.Full do
				notify(key, nil)
			end
			if firstSnapshot then
				ClientState.Ready:Fire()
			end
		elseif type(packet.Ops) == "table" and data then
			-- Apply every op first, then notify each touched key once.
			local touched: { [string]: { string } } = {}
			for _, op in packet.Ops do
				applyOp(op)
				if type(op.Path) == "table" and op.Path[1] then
					touched[op.Path[1]] = op.Path
				end
			end
			for key, path in touched do
				notify(key, path)
			end
		end
	end)
end

function ClientState.Start()
	Net.FireServer("ClientReady")
end

return ClientState
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="104">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">AnimalController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimalController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/AnimalController
	DEPENDENCIES: Shared.Config.{AnimalConfig, ItemConfig}, Shared.Util.Format, Client.UI.{Components, Theme}

	Floating status over every animal (spec §34-§37, §101): name, a heart
	meter for happiness and what it needs RIGHT NOW —
	  🌾 Hungry  → feed it (1 Wheat)
	  ⏳ 0:42    → producing
	  🥛 READY!  → milk / collect
	Everything comes from attributes the server sets on the animal model
	(Status, Happiness, ReadyAt), so this never guesses. The countdown uses
	the synced server clock. Only animals near the camera are updated.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AnimalConfig = require(Shared.Config.AnimalConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local TAG = "Animal"
local LABEL_DISTANCE = 60
local UPDATE_INTERVAL = 0.5

local AnimalController = {}

type Label = { Gui: BillboardGui, Name: TextLabel, Hearts: TextLabel, Status: TextLabel }

local labels: { [Model]: Label } = {}

local function makeLabel(model: Model): Label?
	local body = model.PrimaryPart
	if not body then
		return nil
	end
	local gui = Create("BillboardGui", {
		Name = "AnimalLabel",
		Size = UDim2.fromOffset(160, 62),
		StudsOffset = Vector3.new(0, body.Size.Y / 2 + 2.6, 0),
		MaxDistance = LABEL_DISTANCE,
		LightInfluence = 0,
		Parent = body,
	})
	local name = Components.Label({ Size = UDim2.new(1, 0, 0, 22), TextSize = Theme.TextSize.Medium, TextColor3 = Theme.Colors.TextLight, Text = "", Parent = gui })
	Components.TextStroke(name)
	local hearts = Components.Label({ Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 22), TextSize = 13, Text = "", Parent = gui })
	local status = Components.Label({
		Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 39),
		BackgroundTransparency = 0.15,
		BackgroundColor3 = Theme.Colors.Outline,
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextLight,
		Text = "",
		Parent = gui,
	})
	Components.Corner(status, UDim.new(1, 0))
	local label = { Gui = gui, Name = name, Hearts = hearts, Status = status }
	labels[model] = label
	model.Destroying:Once(function()
		labels[model] = nil
	end)
	return label
end

local function heartsText(happiness: number): string
	local full = math.clamp(math.floor(happiness / 20 + 0.5), 0, 5)
	return string.rep("❤️", full) .. string.rep("🤍", 5 - full)
end

local function updateLabel(model: Model, label: Label, now: number)
	local def = AnimalConfig.Animals[model:GetAttribute("AnimalId") or ""]
	if not def then
		label.Gui.Enabled = false
		return
	end
	label.Gui.Enabled = true
	local variant = model:GetAttribute("Variant")
	label.Name.Text = (if variant == "Golden" then "✨ Golden " else "") .. def.DisplayName
	label.Name.TextColor3 = if variant == "Golden" then Theme.Colors.Coins else Theme.Colors.TextLight
	label.Hearts.Text = heartsText(tonumber(model:GetAttribute("Happiness")) or 0)

	local status = model:GetAttribute("Status")
	local produce = ItemConfig.Get(def.Produce)
	local produceIcon = if produce then produce.Icon else "✨"
	if status == "Ready" then
		label.Status.Text = ("%s READY! %s"):format(produceIcon, def.ProduceVerb)
		label.Status.BackgroundColor3 = Theme.Colors.Green
	elseif status == "Producing" then
		local readyAt = tonumber(model:GetAttribute("ReadyAt")) or now
		label.Status.Text = ("⏳ %s in %s"):format(def.Produce, Format.Duration(math.max(0, math.ceil(readyAt - now))))
		label.Status.BackgroundColor3 = Theme.Colors.Outline
	else
		local food = ItemConfig.Get(def.Food)
		label.Status.Text = ("%s Hungry — feed %d %s"):format(if food then food.Icon else "🍽️", def.FoodAmount, def.Food)
		label.Status.BackgroundColor3 = Theme.Colors.Orange
	end
end

local function updateAll()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = workspace:GetServerTimeNow()
	local eye = camera.CFrame.Position
	for _, instance in CollectionService:GetTagged(TAG) do
		if instance:IsA("Model") then
			local label = labels[instance]
			local near = (instance:GetPivot().Position - eye).Magnitude <= LABEL_DISTANCE + 10
			if near then
				label = label or makeLabel(instance)
				if label then
					updateLabel(instance, label, now)
				end
			elseif label then
				label.Gui.Enabled = false
			end
		end
	end
end

function AnimalController.Start()
	task.spawn(function()
		while true do
			updateAll()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return AnimalController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/AnimationController
	DEPENDENCIES: Shared.Animation.Keyframes, Shared.Config.AnimationConfig, Shared.Util.{AssetId, R15, Signal},
	              AudioController, VFXController, CameraController

	Animates EVERY rig this client can see — your character, other players,
	NPCs and animals — so everyone sees the same thing:
	  * ACTIONS  (chop, mine, hammer, till, plant, water, harvest, cast, reel,
	             milk, feed, pet, cheer, wave, dance...) come from the rig's
	             ActionAnim attribute ("Name;ServerStartTime;Speed;Seq") set by
	             the server. Keyframes (Shared/Animation/Keyframes) are sampled
	             at the synced server time and written to the R15 Motor6D
	             .Transform values every frame, blended over Roblox's own
	             walk/idle animation (legs keep walking unless the action
	             crouches or jumps).
	  * HOLD POSES (HoldPose attribute) keep your arms around whatever you hold.
	  * NPC rigs (tag "NPCRig") breathe and look around.
	  * ANIMALS (tag "Animal") walk, graze, chew, wag and flap from their
	             AnimalAnim attribute using their own joints.
	  * MARKER EFFECTS (AnimationConfig) — whoosh sounds / dust — fire at the
	             marker time on every client, positioned at that rig; your
	             own hits also kick the camera (CameraController.Kick).
	  * SWING TRAILS: during an action's Trail window the held tool's
	             SwingTrail is switched on (with a whoosh), on every client.

	Your own actions are PREDICTED: PlayLocal() starts instantly on click; the
	server's attribute for the same action simply continues it.
	If an AnimationConfig entry has a real uploaded Id, that animation is
	played through the rig's Animator instead of the keyframes.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Keyframes = require(Shared:WaitForChild("Animation"):WaitForChild("Keyframes"))
local AnimationConfig = require(Shared.Config.AnimationConfig)
local AssetId = require(Shared.Util.AssetId)
local Signal = require(Shared.Util.Signal)
local R15 = require(Shared.Util.R15)

local Controllers = script.Parent
local AudioController = require(Controllers.AudioController)
local VFXController = require(Controllers.VFXController)
local CameraController = require(Controllers.CameraController)

local AnimationController = {}

AnimationController.CharacterReady = Signal.new() -- (character)
AnimationController.MarkerReached = Signal.new() -- (animationName, markerName, rig)

local MAX_DISTANCE = 180 -- rigs further than this from the camera are not animated
local FADE_IN = 0.08
local FADE_OUT = 0.16
local HOLD_FADE = 0.15

type ActionState = {
	Name: string,
	Def: any,
	Frames: any?,
	Joints: { string },
	Start: number, -- server time
	Speed: number,
	Seq: string,
	Duration: number,
	Fired: { [string]: boolean },
	Predicted: boolean,
	Track: AnimationTrack?,
}

type Rig = {
	Model: Model,
	Motors: { [string]: Motor6D },
	Action: ActionState?,
	Ending: { State: ActionState, EndedAt: number }?,
	HoldName: string?,
	HoldWeight: number,
	IsNPC: boolean,
	Tracks: { [string]: AnimationTrack },
	Connections: { RBXScriptConnection },
	TrailOn: boolean,
	LookYaw: number,
}

local rigs: { [Model]: Rig } = {}
local animals: { [Model]: { Motors: { [string]: Motor6D }, Phase: number } } = {}
local localCharacter: Model? = nil

local MOTOR_NAMES = {
	Root = true,
	Waist = true,
	Neck = true,
	RightShoulder = true,
	RightElbow = true,
	RightWrist = true,
	LeftShoulder = true,
	LeftElbow = true,
	LeftWrist = true,
	RightHip = true,
	RightKnee = true,
	RightAnkle = true,
	LeftHip = true,
	LeftKnee = true,
	LeftAnkle = true,
}

---------------------------------------------------------------------------
-- Sampling
---------------------------------------------------------------------------

local function ease(kind: string?, t: number): number
	if kind == "In" then
		return t * t
	elseif kind == "Out" then
		return 1 - (1 - t) * (1 - t)
	end
	return t * t * (3 - 2 * t) -- smooth in/out
end

local function toCFrame(value: { number }): CFrame
	local rotation = CFrame.Angles(math.rad(value[1] or 0), math.rad(value[2] or 0), math.rad(value[3] or 0))
	if value[4] or value[5] or value[6] then
		return CFrame.new(value[4] or 0, value[5] or 0, value[6] or 0) * rotation
	end
	return rotation
end

-- Pose of one joint at fraction t, interpolating between the keys that mention it.
local function sampleJoint(keys: { any }, joint: string, t: number): CFrame
	local before, after = nil, nil
	for _, key in keys do
		if key.Pose[joint] then
			if key.T <= t then
				before = key
			elseif not after then
				after = key
			end
		end
	end
	if not before and not after then
		return CFrame.identity
	end
	if not before then
		return toCFrame(after.Pose[joint])
	end
	if not after then
		return toCFrame(before.Pose[joint])
	end
	local span = math.max(after.T - before.T, 1e-3)
	local alpha = ease(after.Ease, math.clamp((t - before.T) / span, 0, 1))
	return toCFrame(before.Pose[joint]):Lerp(toCFrame(after.Pose[joint]), alpha)
end

---------------------------------------------------------------------------
-- Rig bookkeeping
---------------------------------------------------------------------------

local function findMotors(model: Model): { [string]: Motor6D }
	local motors = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") and MOTOR_NAMES[descendant.Name] then
			motors[descendant.Name] = descendant
		end
	end
	return motors
end

local function effectPosition(rig: Rig): Vector3?
	local root = R15.GetRootPart(rig.Model)
	if not root then
		return nil
	end
	return (root.CFrame * CFrame.new(0, -1.5, -3)).Position
end

local function fireMarkers(rig: Rig, state: ActionState, elapsed: number)
	for markerName, time in state.Def.Markers do
		if not state.Fired[markerName] and elapsed * state.Speed >= time then
			state.Fired[markerName] = true
			local effects = state.Def.MarkerEffects[markerName]
			if effects then
				local position = effectPosition(rig)
				if position then
					if effects.Sound then
						AudioController.PlayAt(effects.Sound, position)
					end
					if effects.VFX then
						VFXController.Play(effects.VFX, position)
					end
				end
				if rig.Model == localCharacter then
					if effects.Punch then
						CameraController.Kick(effects.Punch)
					end
					if effects.Shake then
						CameraController.Shake(effects.Shake, 0.25)
					end
				end
			end
			AnimationController.MarkerReached:Fire(state.Name, markerName, rig.Model)
		end
	end
end

local function stopTrack(state: ActionState?)
	if state and state.Track then
		state.Track:Stop(FADE_OUT)
	end
end

local function realTrack(rig: Rig, name: string, def: any): AnimationTrack?
	if AssetId.IsPlaceholder(def.Id) then
		return nil
	end
	local cached = rig.Tracks[name]
	if cached then
		return cached
	end
	local controller = rig.Model:FindFirstChildOfClass("Humanoid") or rig.Model:FindFirstChildOfClass("AnimationController")
	local animator = controller and controller:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	local animation = Instance.new("Animation")
	animation.AnimationId = def.Id
	local ok, track = pcall(animator.LoadAnimation, animator, animation)
	if not ok or not track then
		return nil
	end
	track.Looped = def.Looped
	local priority = (Enum.AnimationPriority :: any)[def.Priority]
	if priority then
		track.Priority = priority
	end
	rig.Tracks[name] = track
	return track
end

local function startAction(rig: Rig, name: string, start: number, speed: number, seq: string, predicted: boolean)
	local def = AnimationConfig.Get(name)
	if not def then
		return
	end
	local current = rig.Action
	if current and current.Name == name and (current.Predicted or current.Seq == seq) and math.abs(current.Start - start) < 0.6 then
		-- The server confirmed what we already predicted: keep playing smoothly.
		current.Predicted = false
		current.Seq = seq
		return
	end
	if current then
		rig.Ending = { State = current, EndedAt = os.clock() }
		stopTrack(current)
	end
	local frames = Keyframes.Actions[name]
	local repeatCount = def.Repeat or 1
	local state: ActionState = {
		Name = name,
		Def = def,
		Frames = frames,
		Joints = if frames then Keyframes.JointsOf(frames) else {},
		Start = start,
		Speed = speed,
		Seq = seq,
		Duration = if def.Looped then math.huge else def.Length * repeatCount / speed,
		Fired = {},
		Predicted = predicted,
		Track = nil,
	}
	local track = realTrack(rig, name, def)
	if track then
		track:Play(def.FadeIn, 1, speed)
		state.Track = track
	end
	rig.Action = state
end

local function endAction(rig: Rig)
	local current = rig.Action
	if current then
		rig.Ending = { State = current, EndedAt = os.clock() }
		stopTrack(current)
		rig.Action = nil
	end
end

local function readAction(rig: Rig)
	local value = rig.Model:GetAttribute("ActionAnim")
	if type(value) ~= "string" or value == "" then
		endAction(rig)
		return
	end
	local name, start, speed, seq = string.match(value, "^([^;]+);([%d%.]+);([%d%.]+);(%d+)$")
	if not name then
		return
	end
	local startTime = tonumber(start) or workspace:GetServerTimeNow()
	local def = AnimationConfig.Get(name)
	-- Ignore actions that already finished before we saw them (late join / streaming).
	if def and not def.Looped and workspace:GetServerTimeNow() - startTime > def.Length * (def.Repeat or 1) / (tonumber(speed) or 1) then
		return
	end
	startAction(rig, name, startTime, tonumber(speed) or 1, seq :: string, false)
end

local function addRig(model: Model, isNPC: boolean)
	if rigs[model] then
		return
	end
	local rig: Rig = {
		Model = model,
		Motors = findMotors(model),
		Action = nil,
		Ending = nil,
		HoldName = nil,
		HoldWeight = 0,
		IsNPC = isNPC,
		Tracks = {},
		Connections = {},
		TrailOn = false,
		LookYaw = 0,
	}
	rigs[model] = rig
	table.insert(rig.Connections, model:GetAttributeChangedSignal("ActionAnim"):Connect(function()
		readAction(rig)
	end))
	table.insert(rig.Connections, model.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("Motor6D") and MOTOR_NAMES[descendant.Name] then
			rig.Motors[descendant.Name] = descendant
		end
	end))
	table.insert(rig.Connections, model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			for _, connection in rig.Connections do
				connection:Disconnect()
			end
			rigs[model] = nil
		end
	end))
	readAction(rig)
end

---------------------------------------------------------------------------
-- Per-frame application
---------------------------------------------------------------------------

local function applyRig(rig: Rig, now: number, clock: number, dt: number)
	local model = rig.Model
	local motors = rig.Motors
	-- Hold pose (fades in/out when you equip / unequip).
	local holdName = model:GetAttribute("HoldPose")
	local hold = if type(holdName) == "string" then Keyframes.Holds[holdName] else nil
	if hold then
		rig.HoldName = holdName :: string
		rig.HoldWeight = math.min(1, rig.HoldWeight + dt / HOLD_FADE)
	else
		rig.HoldWeight = math.max(0, rig.HoldWeight - dt / HOLD_FADE)
	end
	local activeHold = if rig.HoldName then Keyframes.Holds[rig.HoldName] else nil
	if rig.HoldWeight <= 0 then
		rig.HoldName = nil
	end

	local action = rig.Action
	if action and now - action.Start >= action.Duration then
		rig.Ending = { State = action, EndedAt = clock }
		rig.Action = nil
		action = nil
	end

	local targets: { [string]: CFrame } = {}
	local weights: { [string]: number } = {}

	if activeHold and rig.HoldWeight > 0 then
		local sway = math.sin(clock * 1.6) * (activeHold.Sway or 0)
		for joint, value in activeHold.Pose do
			local cf = toCFrame(value)
			if joint == "RightShoulder" then
				cf = CFrame.Angles(math.rad(sway), 0, 0) * cf
			end
			local base = targets[joint]
			targets[joint] = if base then base:Lerp(cf, rig.HoldWeight) else cf
			weights[joint] = if base then 1 else rig.HoldWeight
		end
	end

	if rig.IsNPC and not action then
		-- NPCs can name their own looping idle (e.g. Mia's "MiaIdle").
		local idleName = model:GetAttribute("IdleAnim")
		local custom = if type(idleName) == "string" then Keyframes.Actions[idleName] else nil
		local idleDef = if custom and type(idleName) == "string" then AnimationConfig.Get(idleName) else nil
		local idle = custom or Keyframes.NPCIdle
		local t = (clock / (if idleDef then idleDef.Length else 6)) % 1
		for _, joint in Keyframes.JointsOf(idle) do
			targets[joint] = sampleJoint(idle.Keys, joint, t)
			weights[joint] = 1
		end
	end

	local function applyAction(state: ActionState, weight: number)
		if not state.Frames or state.Track then
			return
		end
		local elapsed = math.max(0, now - state.Start)
		local length = state.Def.Length / state.Speed
		local t = if state.Def.Looped or (state.Def.Repeat or 1) > 1 then (elapsed / length) % 1 else math.clamp(elapsed / length, 0, 1)
		local legs = state.Frames.Legs == true
		for _, joint in state.Joints do
			if legs or not (joint == "Root" or string.find(joint, "Hip") or string.find(joint, "Knee") or string.find(joint, "Ankle")) then
				local target = sampleJoint(state.Frames.Keys, joint, t)
				local existing = targets[joint]
				if existing and weights[joint] then
					targets[joint] = existing:Lerp(target, weight)
					weights[joint] = math.max(weights[joint], weight)
				else
					targets[joint] = target
					weights[joint] = weight
				end
			end
		end
	end

	local ending = rig.Ending
	if ending then
		local fade = 1 - (clock - ending.EndedAt) / FADE_OUT
		if fade <= 0 then
			rig.Ending = nil
		else
			applyAction(ending.State, fade)
		end
	end
	if action then
		local elapsed = now - action.Start
		fireMarkers(rig, action, elapsed)
		if action.Def.Looped and elapsed * action.Speed >= action.Def.Length then
			-- Looped actions re-fire their markers every cycle.
			action.Start += action.Def.Length / action.Speed
			table.clear(action.Fired)
		end
		applyAction(action, math.clamp(elapsed / FADE_IN, 0, 1))
	end

	-- NPCs turn their head and shoulders towards a player (LookAt = UserId).
	local lookAt = model:GetAttribute("LookAt")
	local wantedYaw = 0
	if type(lookAt) == "number" and lookAt ~= 0 then
		local target = Players:GetPlayerByUserId(lookAt)
		local targetRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		local selfRoot = model:FindFirstChild("HumanoidRootPart")
		if targetRoot and targetRoot:IsA("BasePart") and selfRoot and selfRoot:IsA("BasePart") then
			local relative = selfRoot.CFrame:PointToObjectSpace(targetRoot.Position)
			wantedYaw = math.clamp(math.deg(math.atan2(-relative.X, -relative.Z)), -80, 80)
		end
	end
	rig.LookYaw += (wantedYaw - rig.LookYaw) * math.min(1, dt * 5)
	if math.abs(rig.LookYaw) > 0.5 then
		local waist = targets.Waist
		if waist then
			targets.Waist = waist * CFrame.Angles(0, math.rad(rig.LookYaw * 0.35), 0)
		end
		local neck = targets.Neck
		if neck then
			targets.Neck = neck * CFrame.Angles(0, math.rad(rig.LookYaw * 0.55), 0)
		end
	end

	-- Swing trail on the held tool during the action's Trail window.
	local trailOn = false
	if action and action.Def.Trail then
		local fraction = (now - action.Start) * action.Speed / action.Def.Length
		trailOn = fraction >= action.Def.Trail[1] and fraction <= action.Def.Trail[2]
	end
	if trailOn ~= rig.TrailOn then
		rig.TrailOn = trailOn
		local tool = model:FindFirstChild("EquippedTool")
		local trail = tool and tool:FindFirstChild("SwingTrail", true)
		if trail and trail:IsA("Trail") then
			trail.Enabled = trailOn
			if trailOn then
				local rootPart = R15.GetRootPart(model)
				if rootPart then
					AudioController.PlayAt("ToolSwing", rootPart.Position)
				end
			end
		end
	end

	for joint, target in targets do
		local motor = motors[joint]
		if motor and motor.Parent then
			local weight = weights[joint] or 1
			motor.Transform = if weight >= 0.999 then target else motor.Transform:Lerp(target, weight)
		end
	end
end

local function applyAnimal(model: Model, data: { Motors: { [string]: Motor6D }, Phase: number }, clock: number)
	local state = model:GetAttribute("AnimalAnim") or "Idle"
	local t = clock + data.Phase
	local walking = state == "Walk"
	local stride = if walking then math.sin(t * 7) * 28 else 0
	local motors = data.Motors
	local function set(name: string, cf: CFrame)
		local motor = motors[name]
		if motor and motor.Parent then
			motor.Transform = cf
		end
	end
	set("LegFL", CFrame.Angles(math.rad(stride), 0, 0))
	set("LegBR", CFrame.Angles(math.rad(stride), 0, 0))
	set("LegFR", CFrame.Angles(math.rad(-stride), 0, 0))
	set("LegBL", CFrame.Angles(math.rad(-stride), 0, 0))
	set("LegL", CFrame.Angles(math.rad(stride * 1.2), 0, 0))
	set("LegR", CFrame.Angles(math.rad(-stride * 1.2), 0, 0))

	local head: CFrame
	if state == "Eat" then
		head = CFrame.Angles(math.rad(-38 + math.sin(t * 9) * 6), 0, 0)
	elseif state == "Happy" then
		head = CFrame.Angles(math.rad(math.sin(t * 12) * 10), math.rad(math.sin(t * 6) * 12), 0)
	elseif walking then
		head = CFrame.Angles(math.rad(math.sin(t * 14) * 5), 0, 0)
	else
		-- Idle: slow look-around, the odd peck / graze.
		local graze = math.max(0, math.sin(t * 0.7)) ^ 6
		head = CFrame.Angles(math.rad(-40 * graze), math.rad(math.sin(t * 0.45) * 18), 0)
	end
	set("Head", head)

	local wagSpeed = if state == "Happy" then 16 elseif walking then 8 else 3
	set("Tail", CFrame.Angles(0, math.rad(math.sin(t * wagSpeed) * (if state == "Happy" then 32 else 16)), 0))
	local flap = if state == "Happy" then math.abs(math.sin(t * 18)) * 55 elseif walking then math.abs(math.sin(t * 7)) * 8 else 0
	set("WingL", CFrame.Angles(0, 0, math.rad(-flap)))
	set("WingR", CFrame.Angles(0, 0, math.rad(flap)))
end

local function step(dt: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local eye = camera.CFrame.Position
	local now = workspace:GetServerTimeNow()
	local clock = os.clock()
	for model, rig in rigs do
		local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and (root.Position - eye).Magnitude <= MAX_DISTANCE then
			applyRig(rig, now, clock, dt)
		end
	end
	for model, data in animals do
		local body = model.PrimaryPart
		if body and (body.Position - eye).Magnitude <= MAX_DISTANCE then
			applyAnimal(model, data, clock)
		end
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

local lastVariant: { [string]: number } = {}

-- Picks one of an action's swing variants at random (never the same one
-- twice in a row). Returns (animationName, index); send the index to the
-- server so everyone sees the same swing.
function AnimationController.PickVariant(base: string): (string, number)
	local count = AnimationConfig.VariantCount(base)
	if count <= 1 then
		return base, 1
	end
	local index = math.random(1, count)
	if index == lastVariant[base] then
		index = index % count + 1
	end
	lastVariant[base] = index
	return AnimationConfig.Variant(base, index), index
end

-- Starts an action on YOUR character right away (the server will confirm it).
function AnimationController.PlayLocal(name: string, speed: number?)
	local character = localCharacter
	local rig = character and rigs[character]
	if rig then
		startAction(rig, name, workspace:GetServerTimeNow(), speed or 1, "local", true)
	end
end

function AnimationController.IsPlaying(name: string): boolean
	local rig = localCharacter and rigs[localCharacter]
	return rig ~= nil and rig.Action ~= nil and rig.Action.Name == name
end

local function watchCharacter(character: Model)
	task.spawn(function()
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not character.Parent then
			return
		end
		character:WaitForChild("UpperTorso", 5)
		addRig(character, false)
	end)
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)
end

local function addAnimal(model: Instance)
	if not model:IsA("Model") or animals[model] then
		return
	end
	local motors = {}
	local function scan(descendant: Instance)
		if descendant:IsA("Motor6D") then
			motors[descendant.Name] = descendant
		end
	end
	for _, descendant in model:GetDescendants() do
		scan(descendant)
	end
	animals[model] = { Motors = motors, Phase = math.random() * 10 }
	model.DescendantAdded:Connect(scan)
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			animals[model] = nil
		end
	end)
end

function AnimationController.Start()
	local player = Players.LocalPlayer
	local function onCharacter(character: Model)
		localCharacter = character
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 10)
			if humanoid then
				humanoid:WaitForChild("Animator", 10)
				AnimationController.CharacterReady:Fire(character)
			end
		end)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end

	for _, other in Players:GetPlayers() do
		watchPlayer(other)
	end
	Players.PlayerAdded:Connect(watchPlayer)

	for _, npc in CollectionService:GetTagged("NPCRig") do
		if npc:IsA("Model") then
			addRig(npc, true)
		end
	end
	CollectionService:GetInstanceAddedSignal("NPCRig"):Connect(function(npc)
		if npc:IsA("Model") then
			addRig(npc, true)
		end
	end)
	for _, model in CollectionService:GetTagged("Animal") do
		addAnimal(model)
	end
	CollectionService:GetInstanceAddedSignal("Animal"):Connect(addAnimal)

	-- After the Animator has written this frame's poses, before physics/render.
	RunService.Stepped:Connect(function(_time: number, dt: number)
		step(dt)
	end)
end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AudioController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/AudioController
	DEPENDENCIES: Shared.Net, Shared.Config.{SoundConfig, GameConfig}, Shared.Util.AssetId, Client.ClientState

	Plays every sound from SoundConfig through small pools (2D + 3D), applying
	category volume, the player's SFX volume setting and a little random pitch.
	Also keeps the background MUSIC and the sea AMBIENCE looping, following
	the player's Music volume setting (Settings window).
	Entries without a verified source are skipped silently (logged once when
	Debug is on).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RobloxSoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local SoundConfig = require(Shared.Config.SoundConfig)
local GameConfig = require(Shared.Config.GameConfig)
local AssetId = require(Shared.Util.AssetId)
local ClientState = require(script.Parent.Parent.ClientState)

local POOL_SIZE_2D = 8
local POOL_SIZE_3D = 12

local AudioController = {}

local pool2D: { Sound } = {}
local pool3D: { { Part: Part, Sound: Sound } } = {}
local next2D, next3D = 1, 1
local warned: { [string]: boolean } = {}
local random = Random.new()
local loops: { [string]: Sound } = {}

local function resolve(name: string): any
	local def = SoundConfig.Sounds[name]
	if not def then
		if not warned[name] then
			warned[name] = true
			warn("[Audio] Unknown sound '" .. tostring(name) .. "'")
		end
		return nil
	end
	if AssetId.IsPlaceholder(def.Id) then
		if GameConfig.Debug and not warned[name] then
			warned[name] = true
			print("[Audio] '" .. name .. "' still uses a placeholder id — skipped")
		end
		return nil
	end
	return def
end

local function volumeFor(def: any): number
	local category = SoundConfig.Categories[def.Category] or 1
	local key = if def.Category == "Music" then "MusicVolume" else "SfxVolume"
	local setting = ClientState.Get("Settings", key)
	return def.Volume * category * (if type(setting) == "number" then setting else (if key == "MusicVolume" then 0.5 else 0.8))
end

local function configure(sound: Sound, def: any)
	sound.SoundId = def.Id
	sound.Volume = volumeFor(def)
	sound.PlaybackSpeed = def.PlaybackSpeed * (1 + random:NextNumber(-def.PitchVariation, def.PitchVariation))
	sound.Looped = def.Looped == true
	sound.RollOffMaxDistance = def.RollOffMaxDistance
end

-- 2D sound (UI, personal rewards).
function AudioController.Play(name: string)
	local def = resolve(name)
	if not def then
		return
	end
	local sound = pool2D[next2D]
	next2D = next2D % POOL_SIZE_2D + 1
	sound:Stop()
	configure(sound, def)
	sound:Play()
end

-- 3D sound at a world position.
function AudioController.PlayAt(name: string, position: Vector3)
	local def = resolve(name)
	if not def then
		return
	end
	local emitter = pool3D[next3D]
	next3D = next3D % POOL_SIZE_3D + 1
	emitter.Sound:Stop()
	emitter.Part.CFrame = CFrame.new(position)
	configure(emitter.Sound, def)
	emitter.Sound:Play()
end

-- Starts (or re-levels) a looping 2D track such as the music or ambience.
function AudioController.SetLoop(name: string, playing: boolean)
	local def = resolve(name)
	local sound = loops[name]
	if not def then
		return
	end
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = "Loop_" .. name
		sound.SoundId = def.Id
		sound.Looped = true
		sound.PlaybackSpeed = def.PlaybackSpeed
		sound.Parent = RobloxSoundService
		loops[name] = sound
	end
	sound.Volume = volumeFor(def)
	if playing and not sound.IsPlaying then
		sound:Play()
	elseif not playing and sound.IsPlaying then
		sound:Stop()
	end
end

local function refreshLoops()
	for name, sound in loops do
		local def = resolve(name)
		if def then
			sound.Volume = volumeFor(def)
		end
	end
end

function AudioController.Init()
	for index = 1, POOL_SIZE_2D do
		local sound = Instance.new("Sound")
		sound.Name = "UISound" .. index
		sound.Parent = RobloxSoundService
		pool2D[index] = sound
	end

	local folder = Instance.new("Folder")
	folder.Name = "ClientAudio"
	folder.Parent = workspace
	for index = 1, POOL_SIZE_3D do
		local part = Instance.new("Part")
		part.Name = "AudioEmitter"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.one
		part.Parent = folder
		local sound = Instance.new("Sound")
		sound.Parent = part
		pool3D[index] = { Part = part, Sound = sound }
	end
end

function AudioController.Start()
	ClientState.Observe("Settings", refreshLoops)
	task.defer(function()
		AudioController.SetLoop("MusicMain", true)
		AudioController.SetLoop("AmbienceOcean", true)
	end)
	Net.OnClientEvent("PlaySound", function(name: string, position: Vector3?)
		if typeof(position) == "Vector3" then
			AudioController.PlayAt(name, position)
		else
			AudioController.Play(name)
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">BuildController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  BuildController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/BuildController
	DEPENDENCIES: Shared.Net, Shared.Building.BuildingModels, Shared.Config.{BuildingConfig, BuildConfig,
	              ItemConfig, IslandConfig}, Shared.Util.{Placement, Format, R15}, Client.ClientState,
	              Client.Build.LandEditor, InputController, UIController, CameraController,
	              InteractionController, AudioController, Client.UI.{Components, Theme}

	BUILD MODE (spec §7-§9, §46-§48, §84). Press B (or the 🔨 button).

	  Top     "BUILD MODE" + category
	  Left    categories + building list (cost shows ✔ / ✖ as you can afford it)
	  Centre  a transparent GHOST that follows the mouse / your tap, snapped to
	          the grid, tinted GREEN (valid) or RED (invalid, with the reason)
	  Right   selected building info + PLACE / ROTATE / CANCEL (touch friendly)
	  Bottom  control hints

	  R rotate · Q / E turn · click (or PLACE) to build · X cancel · B exit
	  EXPAND tab: glowing squares on the sea — click one to buy that land.
	  PAINT tab:  pick a material, click / drag over your land to paint it.
	  EDIT tab:   click one of your buildings → MOVE or DELETE (50% refund),
	              or a natural tree / rock → CLEAR it for good.

	The preview runs the SAME rules as the server (Shared/Util/Placement,
	BuildConfig) so what looks valid is valid — but the server re-checks all of it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local BuildingModels = require(Shared.Building.BuildingModels)
local BuildingConfig = require(Shared.Config.BuildingConfig)
local BuildConfig = require(Shared.Config.BuildConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local Placement = require(Shared.Util.Placement)
local Format = require(Shared.Util.Format)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local LandEditor = require(Client.Build.LandEditor)
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local CameraController = require(script.Parent.CameraController)
local InteractionController = require(script.Parent.InteractionController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local VALID_COLOR = Color3.fromRGB(90, 230, 120)
local INVALID_COLOR = Color3.fromRGB(240, 80, 70)
local EDIT_COLOR = Color3.fromRGB(90, 170, 255)

local BuildController = {}

type Refs = {
	Root: Frame,
	Banner: TextLabel,
	Left: Frame,
	Tabs: { [string]: TextButton },
	List: ScrollingFrame,
	Right: Frame,
	InfoIcon: TextLabel,
	InfoName: TextLabel,
	InfoDescription: TextLabel,
	InfoCost: TextLabel,
	Status: TextLabel,
	PlaceButton: TextButton,
	RotateButton: TextButton,
	CancelButton: TextButton,
	MoveButton: TextButton,
	DeleteButton: TextButton,
	ClearButton: TextButton,
	Hints: TextLabel,
	BuildButton: TextButton,
}

local refs: Refs
local active = false
local mode = "Menu" -- Menu | Placing | Editing | Moving | Expand | Paint
local category = "Homes"
local selectedId: string? = nil
local rotation = 0
local ghost: Model? = nil
local ghostHighlight: Highlight
local selectionHighlight: Highlight
local renderConnection: RBXScriptConnection? = nil
local releases: { () -> () } = {}
local pointer: Vector2? = nil -- last touch position (screen space)
local cards: { TextButton } = {}
local editTarget: Model? = nil
local deleteArmedUntil = 0
local clearArmedUntil = 0
local landConnection: RBXScriptConnection? = nil

local current = { Valid = false, Reason = "", Center = Vector2.zero, Key = "" }
local lastValidation = 0

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

-- The island model's pivot IS the island origin (IslandBuilder pins WorldPivot).
local function myIsland(): Model?
	local folder = workspace:FindFirstChild("Islands")
	local island = folder and folder:FindFirstChild("Island_" .. player.UserId)
	return if island and island:IsA("Model") then island else nil
end

local function affordable(def: any): (boolean, string)
	local coins = ClientState.Get("Coins") or 0
	local items = ClientState.Get("Inventory", "Items") or {}
	local ok = true
	local lines = {}
	local needCoins = def.Cost.Coins or 0
	if needCoins > 0 then
		local has = coins >= needCoins
		ok = ok and has
		table.insert(lines, ("%s %s 🪙"):format(if has then "✔" else "✖", Format.Commas(needCoins)))
	end
	for itemId, amount in def.Cost.Items do
		local owned = items[itemId] or 0
		local has = owned >= amount
		ok = ok and has
		local item = ItemConfig.Get(itemId)
		table.insert(lines, ("%s %d/%d %s %s"):format(if has then "✔" else "✖", math.min(owned, amount), amount, if item then item.Icon else "", if item then item.DisplayName else itemId))
	end
	return ok, table.concat(lines, "\n")
end

local function alreadyOwned(buildingId: string): boolean
	for _, entry in ClientState.Get("Island", "Buildings") or {} do
		if type(entry) == "table" and entry.BuildingId == buildingId then
			return true
		end
	end
	return false
end

local function islandLevel(): number
	return ClientState.Get("Island", "Level") or 1
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = true

local function pointerRay(): Ray?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	if InputController.IsTouch() then
		local position = pointer or (camera.ViewportSize / 2)
		return camera:ScreenPointToRay(position.X, position.Y)
	end
	local mouse = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(mouse.X, mouse.Y)
end

local function groundHeight(worldX: number, worldZ: number, fallback: number): number
	groundParams.FilterDescendantsInstances = { workspace.Terrain }
	local result = workspace:Raycast(Vector3.new(worldX, fallback + 80, worldZ), Vector3.new(0, -200, 0), groundParams)
	return if result then result.Position.Y else fallback
end

local function blockingFolders(island: Model): { Instance }
	local list = {}
	for _, name in BuildConfig.BlockingFolders do
		local folder = island:FindFirstChild(name)
		if folder then
			table.insert(list, folder)
		end
	end
	return list
end

---------------------------------------------------------------------------
-- Ghost preview
---------------------------------------------------------------------------

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	ghostHighlight.Adornee = nil
	ghostHighlight.Enabled = false
end

local function makeGhost(buildingId: string)
	clearGhost()
	local model = BuildingModels.Build(buildingId)
	BuildingModels.MakeGhost(model)
	local def = BuildingConfig.Get(buildingId)
	local plate = Instance.new("Part")
	plate.Name = "FootprintPlate"
	plate.Anchored = true
	plate.CanCollide = false
	plate.CanQuery = false
	plate.CanTouch = false
	plate.Material = Enum.Material.Neon
	plate.Transparency = 0.55
	plate.Size = Vector3.new(def.Footprint.X, 0.15, def.Footprint.Y)
	plate.CFrame = CFrame.new(0, 0.1, 0)
	plate.Parent = model
	model.Parent = workspace.CurrentCamera
	ghost = model
	ghostHighlight.Adornee = model
	ghostHighlight.Enabled = true
end

-- Runs the same checks the server will run.
local function validate(def: any, island: Model, center: Vector2, localY: number, worldCFrame: CFrame, checkCost: boolean): (boolean, string)
	local size = Placement.FootprintSize(def.Footprint, rotation)
	local sampler = LandEditor.GetSampler()
	if not sampler or not Placement.IsOnLand(sampler, center, size) then
		return false, "Must be on solid land (not the beach)"
	end
	local origin = island:GetPivot()
	local lowest, highest = localY, localY
	for _, corner in Placement.Corners(center, size) do
		local world = origin * CFrame.new(corner.X, 0, corner.Y)
		local height = groundHeight(world.X, world.Z, origin.Y) - origin.Y
		lowest = math.min(lowest, height)
		highest = math.max(highest, height)
	end
	if highest - lowest > BuildConfig.MaxSlope then
		return false, "Ground too steep"
	end
	local root = R15.GetRootPart(player.Character)
	if not root or (root.Position - worldCFrame.Position).Magnitude > BuildConfig.PlacementRange then
		return false, "Too far away — walk closer"
	end
	local shrink = BuildConfig.OverlapShrink
	local boxSize = Vector3.new(math.max(0.5, def.Footprint.X - shrink), def.Height, math.max(0.5, def.Footprint.Y - shrink))
	local boxCFrame = worldCFrame * CFrame.new(0, def.Height / 2 + 0.4, 0)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.FilterDescendantsInstances = blockingFolders(island)
	for _, hit in workspace:GetPartBoundsInBox(boxCFrame, boxSize, overlap) do
		if not (editTarget and mode == "Moving" and hit:IsDescendantOf(editTarget)) then
			return false, "Something is in the way"
		end
	end
	local relative = boxCFrame:PointToObjectSpace(root.Position)
	if math.abs(relative.X) < def.Footprint.X / 2 + 1 and math.abs(relative.Z) < def.Footprint.Y / 2 + 1 then
		return false, "Step out of the way"
	end
	if checkCost then
		if def.Unique and alreadyOwned(def.Id) then
			return false, "You already have one"
		end
		if islandLevel() < def.UnlockLevel then
			return false, ("Needs Island Level %d"):format(def.UnlockLevel)
		end
		local canAfford = affordable(def)
		if not canAfford then
			return false, "Not enough materials"
		end
	end
	return true, "Looks good! Click / PLACE to build"
end

local function currentDef(): any
	if mode == "Moving" and editTarget then
		return BuildingConfig.Get(editTarget:GetAttribute("BuildingId"))
	end
	return selectedId and BuildingConfig.Get(selectedId)
end

local function updateGhost()
	local def = currentDef()
	local island = myIsland()
	local ray = pointerRay()
	if not ghost or not def or not island or not ray then
		return
	end
	local exclude = { ghost }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	for _, name in { "ClientEffects", "ClientAudio" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
	if not hit then
		return
	end
	local origin = island:GetPivot()
	local localHit = origin:PointToObjectSpace(hit.Position)
	local size = Placement.FootprintSize(def.Footprint, rotation)
	local center = Placement.Snap(Vector2.new(localHit.X, localHit.Z), size)
	local worldCenter = origin * CFrame.new(center.X, 0, center.Y)
	local localY = groundHeight(worldCenter.X, worldCenter.Z, origin.Y) - origin.Y
	local worldCFrame = origin * Placement.LocalCFrame(Vector3.new(center.X, localY, center.Y), rotation)
	ghost:PivotTo(worldCFrame)

	local key = ("%d,%d,%d"):format(center.X * 10, center.Y * 10, rotation)
	local now = os.clock()
	if key ~= current.Key or now - lastValidation > 0.4 then
		lastValidation = now
		current.Key = key
		current.Center = center
		current.Valid, current.Reason = validate(def, island, center, localY, worldCFrame, mode == "Placing")
		local color = if current.Valid then VALID_COLOR else INVALID_COLOR
		ghostHighlight.FillColor = color
		ghostHighlight.OutlineColor = color
		local plate = ghost:FindFirstChild("FootprintPlate")
		if plate and plate:IsA("BasePart") then
			plate.Color = color
		end
		refs.Status.Text = (if current.Valid then "✔ " else "✖ ") .. current.Reason
		refs.Status.TextColor3 = if current.Valid then Theme.Colors.Green else Theme.Colors.Red
	end
end

local function startRender()
	if renderConnection then
		return
	end
	renderConnection = RunService.RenderStepped:Connect(updateGhost)
end

local function stopRender()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
end

-- Expand / Paint run the LandEditor every frame and mirror its status line.
local function startLand()
	if landConnection then
		return
	end
	landConnection = RunService.RenderStepped:Connect(function()
		local text, ok = LandEditor.Step()
		refs.Status.Text = text
		refs.Status.TextColor3 = if ok then Theme.Colors.Green else Theme.Colors.Red
	end)
end

local function stopLand()
	if landConnection then
		landConnection:Disconnect()
		landConnection = nil
	end
	LandEditor.Exit()
end

local function isLandMode(): boolean
	return mode == "Expand" or mode == "Paint"
end

---------------------------------------------------------------------------
-- UI state
---------------------------------------------------------------------------

local renderList: () -> ()

local function showInfo(def: any?)
	if mode == "Expand" then
		local count, maxChunks, cost = LandEditor.ExpansionInfo()
		refs.InfoIcon.Text = "🗺️"
		refs.InfoName.Text = "EXPAND LAND"
		refs.InfoDescription.Text = "Click a glowing square on the sea to raise new land there. Grow your island in any direction you like!"
		refs.InfoCost.Text = ("Land chunks: %d / %d\nNext chunk: %s 🪙\nLevel up your island for more room."):format(count, maxChunks, Format.Commas(cost))
		return
	elseif mode == "Paint" then
		local paint = IslandConfig.Paint[LandEditor.Material]
		refs.InfoIcon.Text = if paint then paint.Icon else "🧽"
		refs.InfoName.Text = "PAINT TERRAIN"
		refs.InfoDescription.Text = "Pick a material on the left, then click or drag across your land. Paths, plazas, gardens — it's free!"
		refs.InfoCost.Text = if paint then "Brush: " .. paint.DisplayName else "Eraser: restores the natural ground."
		return
	end
	if not def then
		refs.InfoIcon.Text = "🔨"
		refs.InfoName.Text = if mode == "Editing" then "EDIT MODE" else "Pick a building"
		refs.InfoDescription.Text = if mode == "Editing" then "Click one of your buildings to move or remove it, or a wild tree / rock to clear it." else "Choose something from the list on the left."
		refs.InfoCost.Text = ""
		return
	end
	local _, costText = affordable(def)
	refs.InfoIcon.Text = def.Icon
	refs.InfoName.Text = string.upper(def.DisplayName)
	refs.InfoDescription.Text = if def.Steps > 0
		then ("%s\nFootprint %dx%d · %d hammer hits"):format(def.Description, def.Footprint.X, def.Footprint.Y, def.Steps)
		else ("%s\nFootprint %dx%d · instant"):format(def.Description, def.Footprint.X, def.Footprint.Y)
	refs.InfoCost.Text = if mode == "Moving" then "Moving is free." else costText
end

local function editIsNatural(): boolean
	return editTarget ~= nil and editTarget:GetAttribute("UniqueId") == nil and editTarget:GetAttribute("NodeId") ~= nil
end

local function updateButtons()
	local placing = mode == "Placing" or mode == "Moving"
	local editing = mode == "Editing" and editTarget ~= nil
	local natural = editing and editIsNatural()
	local editDef = editing and not natural and editTarget and BuildingConfig.Get(editTarget:GetAttribute("BuildingId"))
	refs.PlaceButton.Visible = placing
	refs.PlaceButton.Text = if mode == "Moving" then "MOVE HERE" else "PLACE"
	refs.RotateButton.Visible = placing
	refs.CancelButton.Visible = placing or editing
	refs.MoveButton.Visible = editing and not natural
	refs.DeleteButton.Visible = editing and not natural and not (editDef and editDef.NoDelete)
	refs.ClearButton.Visible = natural
	refs.Status.Visible = placing or isLandMode()
	refs.Left.Visible = not placing
	local label = if mode == "Editing" or mode == "Moving" then "EDIT" elseif isLandMode() then string.upper(mode) else string.upper(category)
	refs.Banner.Text = "🔨 BUILD MODE · " .. label
	local touch = InputController.IsTouch()
	if mode == "Expand" then
		refs.Hints.Text = if touch then "Tap a glowing square to buy land · ✕ to leave" else "Click a glowing square to buy land · B exit"
	elseif mode == "Paint" then
		refs.Hints.Text = if touch then "Tap / drag on your land to paint" else "Click or drag on your land to paint · B exit"
	elseif touch then
		refs.Hints.Text = if placing then "Tap the ground to move · ⟳ to rotate · PLACE to build" else "Pick a building · tap ✕ to leave"
	else
		refs.Hints.Text = if placing then "Click to place · R rotate · Q/E turn · X cancel · B exit" else "Pick a building · B to exit"
	end
end

local function setMode(newMode: string)
	local wasLand = isLandMode()
	mode = newMode
	if isLandMode() then
		LandEditor.Enter(mode)
		startLand()
	elseif wasLand then
		stopLand()
	end
	if mode == "Placing" or mode == "Moving" then
		startRender()
	else
		stopRender()
		clearGhost()
	end
	if mode ~= "Editing" and mode ~= "Moving" then
		editTarget = nil
		selectionHighlight.Adornee = nil
		selectionHighlight.Enabled = false
	end
	current.Key = ""
	updateButtons()
	showInfo(currentDef())
end

local function selectBuilding(buildingId: string)
	local def = BuildingConfig.Get(buildingId)
	if not def then
		return
	end
	if islandLevel() < def.UnlockLevel then
		UIController.Notify("Error", ("%s unlocks at Island Level %d."):format(def.DisplayName, def.UnlockLevel))
		return
	end
	selectedId = buildingId
	makeGhost(buildingId)
	setMode("Placing")
end

local function confirmPlacement()
	if mode ~= "Placing" and mode ~= "Moving" then
		return
	end
	if not current.Valid then
		AudioController.Play("PlaceInvalid")
		UIController.Notify("Error", current.Reason)
		return
	end
	if mode == "Moving" and editTarget then
		Net.FireServer("MoveBuildRequest", editTarget:GetAttribute("UniqueId"), current.Center.X, current.Center.Y, rotation)
		setMode("Editing")
		return
	end
	local def = currentDef()
	if not def then
		return
	end
	Net.FireServer("BuildRequest", { Op = "Place", BuildingId = def.Id, X = current.Center.X, Z = current.Center.Y, Rotation = rotation })
	AudioController.Play("UIClick")
	-- Decorations and nature keep placing (fences, trees...); big buildings return to the menu.
	if def.Category == "Decoration" or def.Category == "Nature" or def.Id == "SoilTile" then
		current.Key = ""
	else
		BuildController.Exit()
	end
end

local function rotate(delta: number)
	if mode == "Placing" or mode == "Moving" then
		rotation = (rotation + delta) % 360
		current.Key = ""
		AudioController.Play("UIClick")
	end
end

local function cancel()
	if mode == "Placing" then
		setMode("Menu")
	elseif mode == "Moving" then
		setMode("Editing")
	elseif mode == "Editing" and editTarget then
		setMode("Editing")
	elseif isLandMode() then
		setMode("Menu")
		renderList()
	else
		BuildController.Exit()
	end
end

local function selectForEdit(model: Model)
	editTarget = model
	selectionHighlight.Adornee = model
	selectionHighlight.Enabled = true
	deleteArmedUntil = 0
	clearArmedUntil = 0
	refs.DeleteButton.Text = "DELETE"
	refs.ClearButton.Text = "🪓 CLEAR IT"
	updateButtons()
	if editIsNatural() then
		local nodeType = tostring(model:GetAttribute("NodeType"))
		refs.InfoIcon.Text = "🌲"
		refs.InfoName.Text = string.upper(nodeType)
		refs.InfoDescription.Text = "Part of your island's wild nature. Clearing it removes it for good (you keep a little of what it drops)."
		refs.InfoCost.Text = "Clearing is free."
		return
	end
	local def = BuildingConfig.Get(model:GetAttribute("BuildingId"))
	showInfo(def)
	if def then
		refs.InfoCost.Text = if def.NoDelete
			then "This one can be moved, but not removed."
			else ("Delete refunds %d%% of the cost."):format(math.floor(BuildingConfig.RefundPercent * 100))
	end
end

local function tryPickBuilding(screenPosition: Vector2?)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local ray = if screenPosition
		then camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
		else (function()
			local mouse = UserInputService:GetMouseLocation()
			return camera:ViewportPointToRay(mouse.X, mouse.Y)
		end)()
	local island = myIsland()
	local buildings = island and island:FindFirstChild("Buildings")
	local resources = island and island:FindFirstChild("Resources")
	if not buildings or not resources then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { buildings, resources }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 400, params)
	if not hit then
		return
	end
	local folder = if hit.Instance:IsDescendantOf(buildings) then buildings else resources
	local model = hit.Instance:FindFirstAncestorOfClass("Model")
	while model and model.Parent ~= folder do
		model = model:FindFirstAncestorOfClass("Model")
	end
	if model and model:GetAttribute("OwnerUserId") == player.UserId then
		AudioController.Play("UIClick")
		selectForEdit(model)
	end
end

---------------------------------------------------------------------------
-- UI construction
---------------------------------------------------------------------------

local function buildUI()
	local layer = UIController.GetModalLayer()
	local root = Create("Frame", { Name = "BuildMode", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, Parent = layer })

	local banner = Components.Label({
		Name = "Banner",
		Size = UDim2.fromOffset(420, 40),
		Position = UDim2.new(0.5, 0, 0, 76),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Colors.Orange,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Large,
		Text = "🔨 BUILD MODE",
		Parent = root,
	})
	Components.Corner(banner, UDim.new(1, 0))
	Components.Stroke(banner)
	Components.TextStroke(banner)

	-- LEFT: categories + list
	local left = Create("Frame", { Name = "Left", Size = UDim2.fromOffset(300, 500), Position = UDim2.fromOffset(110, 125), BackgroundColor3 = Theme.Colors.Panel, Parent = root })
	Components.Corner(left)
	Components.Stroke(left)
	Components.Gradient(left, Color3.new(1, 1, 1), Theme.Colors.PanelAlt)
	local tabRow = Create("Frame", { Size = UDim2.new(1, -16, 0, 130), Position = UDim2.fromOffset(8, 8), BackgroundTransparency = 1, Parent = left }, {
		Create("UIGridLayout", { CellSize = UDim2.fromOffset(90, 38), CellPadding = UDim2.fromOffset(4, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tabs = {}
	local tabDefs = table.clone(BuildingConfig.Categories)
	table.insert(tabDefs, { Id = "Expand", DisplayName = "Expand", Icon = "🗺️" })
	table.insert(tabDefs, { Id = "Paint", DisplayName = "Paint", Icon = "🖌️" })
	table.insert(tabDefs, { Id = "Edit", DisplayName = "Edit", Icon = "✏️" })
	for index, cat in tabDefs do
		local button = Components.Button({
			Name = cat.Id,
			Text = cat.Icon .. " " .. cat.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			TextSize = Theme.TextSize.Small,
			Parent = tabRow,
			Flat = true,
			OnClick = function()
				if cat.Id == "Edit" then
					setMode("Editing")
				elseif cat.Id == "Expand" or cat.Id == "Paint" then
					setMode(cat.Id)
				else
					category = cat.Id
					setMode("Menu")
				end
				renderList()
			end,
		})
		button.LayoutOrder = index
		tabs[cat.Id] = button
	end
	local list = Create("ScrollingFrame", {
		Name = "List",
		Size = UDim2.new(1, -16, 1, -152),
		Position = UDim2.fromOffset(8, 146),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = left,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	-- RIGHT: info + actions
	local right = Create("Frame", { Name = "Right", Size = UDim2.fromOffset(280, 430), Position = UDim2.new(1, -12, 0, 125), AnchorPoint = Vector2.new(1, 0), BackgroundColor3 = Theme.Colors.Panel, Parent = root })
	Components.Corner(right)
	Components.Stroke(right)
	Components.Gradient(right, Color3.new(1, 1, 1), Theme.Colors.PanelAlt)
	Components.Padding(right, 12)
	local infoIcon = Components.Label({ Size = UDim2.new(1, 0, 0, 56), TextSize = 48, Text = "🔨", Parent = right })
	local infoName = Components.Label({ Size = UDim2.new(1, 0, 0, 28), Position = UDim2.fromOffset(0, 56), TextSize = Theme.TextSize.Large, Text = "", Parent = right })
	local infoDescription = Components.Label({ Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 86), Font = Theme.Fonts.Body, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = right })
	local infoCost = Components.Label({ Size = UDim2.new(1, 0, 0, 84), Position = UDim2.fromOffset(0, 148), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = right })
	local status = Components.Label({ Size = UDim2.new(1, 0, 0, 36), Position = UDim2.fromOffset(0, 234), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Text = "", Parent = right })
	local placeButton = Components.Button({ Text = "PLACE", Color = Theme.Colors.Green, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 274), Parent = right, OnClick = confirmPlacement })
	local rotateButton = Components.Button({ Text = "⟳ ROTATE", Color = Theme.Colors.Blue, Size = UDim2.new(0.5, -4, 0, 44), Position = UDim2.fromOffset(0, 330), Parent = right, OnClick = function()
		rotate(90)
	end })
	local cancelButton = Components.Button({ Text = "CANCEL", Color = Theme.Colors.Red, Size = UDim2.new(0.5, -4, 0, 44), Position = UDim2.new(0.5, 4, 0, 330), Parent = right, OnClick = cancel })
	local moveButton = Components.Button({ Text = "MOVE", Color = Theme.Colors.Blue, Size = UDim2.new(0.5, -4, 0, 48), Position = UDim2.fromOffset(0, 274), Parent = right, OnClick = function()
		if editTarget then
			local uniqueId = editTarget:GetAttribute("UniqueId")
			local entry = ClientState.Get("Island", "Buildings", uniqueId)
			rotation = if entry and type(entry.Rotation) == "number" then entry.Rotation else 0
			makeGhost(tostring(editTarget:GetAttribute("BuildingId")))
			setMode("Moving")
		end
	end })
	local deleteButton = Components.Button({ Text = "DELETE", Color = Theme.Colors.Red, Size = UDim2.new(0.5, -4, 0, 48), Position = UDim2.new(0.5, 4, 0, 274), Parent = right, OnClick = function()
		if not editTarget then
			return
		end
		local now = os.clock()
		if now > deleteArmedUntil then
			-- Two taps to delete, so nothing is removed by accident.
			deleteArmedUntil = now + 3
			refs.DeleteButton.Text = "SURE?"
			return
		end
		Net.FireServer("DeleteBuildRequest", editTarget:GetAttribute("UniqueId"))
		setMode("Editing")
	end })
	local clearButton = Components.Button({ Text = "🪓 CLEAR IT", Color = Theme.Colors.Orange, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 274), Parent = right, OnClick = function()
		if not editTarget then
			return
		end
		local now = os.clock()
		if now > clearArmedUntil then
			clearArmedUntil = now + 3
			refs.ClearButton.Text = "SURE? (can't undo)"
			return
		end
		Net.FireServer("RemoveNodeRequest", editTarget:GetAttribute("NodeId"))
		setMode("Editing")
	end })

	local hints = Components.Label({
		Name = "Hints",
		Size = UDim2.fromOffset(640, 30),
		Position = UDim2.new(0.5, 0, 1, -118),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.2,
		BackgroundColor3 = Theme.Colors.Outline,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Small,
		Text = "",
		Parent = root,
	})
	Components.Corner(hints, UDim.new(1, 0))

	-- HUD button (left menu, under the bag).
	local buildButton = Components.IconButton({
		Icon = "🔨",
		Caption = "Build", Key = "B",
		Color = Theme.Colors.Orange,
		Parent = UIController.GetSlot("Left"),
		LayoutOrder = 2,
		OnClick = function()
			BuildController.Toggle()
		end,
	})

	refs = {
		Root = root,
		Banner = banner,
		Left = left,
		Tabs = tabs,
		List = list,
		Right = right,
		InfoIcon = infoIcon,
		InfoName = infoName,
		InfoDescription = infoDescription,
		InfoCost = infoCost,
		Status = status,
		PlaceButton = placeButton,
		RotateButton = rotateButton,
		CancelButton = cancelButton,
		MoveButton = moveButton,
		DeleteButton = deleteButton,
		ClearButton = clearButton,
		Hints = hints,
		BuildButton = buildButton,
	}
end

local paintCards: { TextButton } = {}

local function renderPalette()
	local entries = { "" }
	for _, material in IslandConfig.PaintOrder do
		table.insert(entries, material)
	end
	for index, material in entries do
		local card = paintCards[index]
		if not card then
			card = Create("TextButton", { Name = "Paint", Size = UDim2.new(1, -8, 0, 46), BackgroundColor3 = Theme.Colors.PanelAlt, AutoButtonColor = true, Text = "", Parent = refs.List })
			Components.Corner(card, Theme.SmallCorner)
			Components.Stroke(card, Theme.Colors.Outline, 2)
			local swatch = Create("Frame", { Name = "Swatch", Size = UDim2.fromOffset(34, 34), Position = UDim2.fromOffset(6, 6), Parent = card })
			Components.Corner(swatch, UDim.new(0, 8))
			Components.Stroke(swatch, Theme.Colors.Outline, 2)
			Components.Label({ Name = "Title", Size = UDim2.new(1, -56, 1, 0), Position = UDim2.fromOffset(50, 0), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Parent = card })
			card.Activated:Connect(function()
				local value = card:GetAttribute("Material")
				if type(value) == "string" then
					AudioController.Play("UIClick")
					LandEditor.SetMaterial(value)
					showInfo(nil)
					renderList()
				end
			end)
			paintCards[index] = card
		end
		card.Visible = true
		card.LayoutOrder = 100 + index
		card:SetAttribute("Material", material)
		local swatch = card:FindFirstChild("Swatch") :: Frame
		local title = card:FindFirstChild("Title") :: TextLabel
		local paint = IslandConfig.Paint[material]
		swatch.BackgroundColor3 = LandEditor.MaterialColors[material] or Theme.Colors.Panel
		title.Text = if paint then paint.DisplayName else "🧽 Eraser (natural)"
		card.BackgroundColor3 = if LandEditor.Material == material then Theme.Colors.Coins else Theme.Colors.PanelAlt
	end
end

renderList = function()
	for id, button in refs.Tabs do
		local selected
		if mode == "Editing" or mode == "Moving" then
			selected = id == "Edit"
		elseif isLandMode() then
			selected = id == mode
		else
			selected = id == category
		end
		Components.SetButtonColor(button, if selected then Theme.Colors.Coins else Theme.Colors.PanelAlt)
	end
	for _, card in paintCards do
		card.Visible = false
	end
	if mode == "Paint" then
		renderPalette()
	end
	local defs = {}
	if mode == "Menu" or mode == "Placing" then
		for _, def in BuildingConfig.Buildings do
			if def.Category == category and not def.Hidden then
				table.insert(defs, def)
			end
		end
		table.sort(defs, function(a, b)
			return a.Order < b.Order
		end)
	end
	for index, def in defs do
		local card = cards[index]
		if not card then
			card = Create("TextButton", { Name = "Card", Size = UDim2.new(1, -8, 0, 70), BackgroundColor3 = Theme.Colors.PanelAlt, AutoButtonColor = true, Text = "", Parent = refs.List })
			Components.Corner(card, Theme.SmallCorner)
			Components.Stroke(card, Theme.Colors.Outline, 2)
			Components.Label({ Name = "Icon", Size = UDim2.fromOffset(56, 56), Position = UDim2.fromOffset(6, 7), TextSize = 40, Parent = card })
			Components.Label({ Name = "Title", Size = UDim2.new(1, -72, 0, 24), Position = UDim2.fromOffset(66, 6), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Parent = card })
			Components.Label({ Name = "Cost", Size = UDim2.new(1, -72, 0, 36), Position = UDim2.fromOffset(66, 30), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = Theme.Fonts.Bold, TextSize = 12, TextColor3 = Theme.Colors.TextMuted, Parent = card })
			card.Activated:Connect(function()
				local buildingId = card:GetAttribute("BuildingId")
				if type(buildingId) == "string" then
					AudioController.Play("UIClick")
					selectBuilding(buildingId)
				end
			end)
			cards[index] = card
		end
		local canAfford = affordable(def)
		local locked = islandLevel() < def.UnlockLevel
		card.Visible = true
		card.LayoutOrder = index
		card:SetAttribute("BuildingId", def.Id)
		local icon = card:FindFirstChild("Icon") :: TextLabel
		local title = card:FindFirstChild("Title") :: TextLabel
		local cost = card:FindFirstChild("Cost") :: TextLabel
		icon.Text = def.Icon
		title.Text = def.DisplayName
		local parts = {}
		if (def.Cost.Coins or 0) > 0 then
			table.insert(parts, Format.Commas(def.Cost.Coins) .. " 🪙")
		end
		for itemId, amount in def.Cost.Items do
			local item = ItemConfig.Get(itemId)
			table.insert(parts, amount .. " " .. (if item then item.Icon else itemId))
		end
		local owned = def.Unique and alreadyOwned(def.Id)
		cost.Text = if locked then ("🔒 Island Level %d"):format(def.UnlockLevel) elseif owned then "✔ Already on your island" else table.concat(parts, "  ")
		cost.TextColor3 = if locked or owned then Theme.Colors.TextMuted elseif canAfford then Theme.Colors.Green else Theme.Colors.Red
		card.BackgroundColor3 = if locked then Theme.Colors.PanelDark else Theme.Colors.PanelAlt
	end
	for index = #defs + 1, #cards do
		cards[index].Visible = false
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function BuildController.IsActive(): boolean
	return active
end

function BuildController.Enter()
	if active or UIController.IsAnyModalOpen() then
		return
	end
	active = true
	refs.Root.Visible = true
	UIController.GetSlot("Right").Visible = false
	UIController.SetModalOpen("Build", true)
	CameraController.SetMode("Build")
	table.insert(releases, InteractionController.PausePrompts())
	table.insert(releases, InputController.Block("UseTool"))
	table.insert(releases, InputController.Block("Interact"))
	setMode("Menu")
	renderList()
end

function BuildController.Exit()
	if not active then
		return
	end
	active = false
	setMode("Menu")
	refs.Root.Visible = false
	UIController.GetSlot("Right").Visible = true
	UIController.SetModalOpen("Build", false)
	CameraController.SetMode("Default")
	for _, release in releases do
		release()
	end
	table.clear(releases)
end

-- Opens build mode straight on a tab ("Expand", "Paint", "Edit" or a category).
function BuildController.Open(tab: string?)
	if not active then
		BuildController.Enter()
	end
	if not active or not tab then
		return
	end
	if tab == "Expand" or tab == "Paint" then
		setMode(tab)
	elseif tab == "Edit" then
		setMode("Editing")
	else
		category = tab
		setMode("Menu")
	end
	renderList()
end

function BuildController.Toggle()
	if active then
		BuildController.Exit()
	else
		BuildController.Enter()
	end
end

function BuildController.Init()
	ghostHighlight = Instance.new("Highlight")
	ghostHighlight.Name = "BuildGhostHighlight"
	ghostHighlight.FillTransparency = 0.55
	ghostHighlight.OutlineTransparency = 0
	ghostHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	ghostHighlight.Enabled = false
	ghostHighlight.Parent = workspace.CurrentCamera

	selectionHighlight = Instance.new("Highlight")
	selectionHighlight.Name = "BuildSelectHighlight"
	selectionHighlight.FillColor = EDIT_COLOR
	selectionHighlight.OutlineColor = EDIT_COLOR
	selectionHighlight.FillTransparency = 0.7
	selectionHighlight.Enabled = false
	selectionHighlight.Parent = workspace.CurrentCamera

	buildUI()
end

function BuildController.Start()
	InputController.On("ToggleBuild", BuildController.Toggle)
	InputController.On("RotateBuild", function()
		rotate(90)
	end)
	InputController.On("RotateBuildRight", function()
		rotate(90)
	end)
	InputController.On("RotateBuildLeft", function()
		rotate(-90)
	end)
	InputController.On("Cancel", function()
		if active then
			cancel()
		end
	end)
	InputController.On("BuildPlace", function()
		if not active then
			return
		end
		if mode == "Editing" then
			tryPickBuilding(nil)
		elseif isLandMode() then
			LandEditor.Click(nil)
		else
			confirmPlacement()
		end
	end)
	UserInputService.TouchTapInWorld:Connect(function(position, processedByUI)
		if not active or processedByUI then
			return
		end
		pointer = position
		current.Key = ""
		if mode == "Editing" then
			tryPickBuilding(position)
		elseif isLandMode() then
			LandEditor.Click(position)
		end
	end)
	LandEditor.Start()
	-- Keep costs / locks fresh while the menu is open.
	for _, key in { "Coins", "Inventory", "Island" } do
		ClientState.Observe(key, function()
			if active and (mode == "Menu" or mode == "Paint") then
				renderList()
			elseif active and mode == "Expand" then
				showInfo(nil)
			end
		end)
	end
	InputController.DeviceChanged:Connect(function()
		if active then
			updateButtons()
		end
	end)
end

return BuildController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  CameraController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/CameraController
	DEPENDENCIES: Shared.Net, Shared.Config.GameConfig, Client.ClientState

	Keeps Roblox's default R15 third-person camera (it already handles mobile,
	gamepad and collisions well) and layers CARTOON camera feel on top:

	  Kick(strength)          a springy nod on every hit you land (pitch
	                          down + a little roll + a tiny zoom-in squash)
	  Wobble(strength, time)  a wobbly, bouncy roll/pitch for big moments:
	                          a tree crashing down, a rock shattering,
	                          new land rising
	  Shake(strength, time)   classic noisy shake (capped)
	  Punch(amount)           a springy field-of-view pop (level ups)
	  SetMode(mode)           Default / Build / Fishing field of view

	Everything runs through one damped spring. IMPORTANT: Roblox's camera
	script reads the camera's current rotation every frame, so an offset
	left on the camera would be fed back in and ADD UP (the view slowly
	tipped towards the ground). We therefore remove last frame's offset
	just BEFORE the camera script runs and add the new one just AFTER it:
	the player's own camera angle is never changed. Rotation effects respect
	the "Camera shake" setting; FOV pops always play.

	Sprinting widens the field of view a little (SetSprint).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local GameConfig = require(Shared.Config.GameConfig)
local ClientState = require(script.Parent.Parent.ClientState)

local BIND_UNDO = "IslandCameraJuiceUndo"
local BIND_APPLY = "IslandCameraJuice"

local MODES = {
	Default = { FieldOfView = GameConfig.Camera.DefaultFieldOfView },
	Build = { FieldOfView = GameConfig.Camera.DefaultFieldOfView + 6 },
	Fishing = { FieldOfView = GameConfig.Camera.DefaultFieldOfView - 6 },
}

-- Spring tuning: stiff + light damping = bouncy, cartoony.
local STIFFNESS = 170
local DAMPING = 11
local FOV_STIFFNESS = 120
local FOV_DAMPING = 9
local MAX_ANGLE = math.rad(4.5)
local SPRINT_FOV = 7

local CameraController = {}

local mode = "Default"
local baseFov = GameConfig.Camera.DefaultFieldOfView
local targetFov = baseFov
-- Spring state: X = pitch, Y = yaw, Z = roll (radians).
local angle = Vector3.zero
local angleVelocity = Vector3.zero
local fovOffset, fovVelocity = 0, 0
-- Noise shake.
local trauma, traumaDuration = 0, 0.3
local noiseSeed = math.random() * 1000
-- Wobbles: several can overlap (a tree falling while you mine).
type Wobble = { Start: number, Duration: number, Strength: number, Phase: number }
local wobbles: { Wobble } = {}
-- The rotation offset currently applied on top of the camera script's result.
local appliedOffset = CFrame.identity
local sprinting = false

local function shakeAllowed(): boolean
	return ClientState.Get("Settings", "CameraShake") ~= false
end

-- Before the camera script: take last frame's offset back off.
local function undo()
	local cam = workspace.CurrentCamera
	if cam and appliedOffset ~= CFrame.identity then
		cam.CFrame *= appliedOffset:Inverse()
	end
	appliedOffset = CFrame.identity
end

local function step(dt: number)
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	dt = math.min(dt, 1 / 20)

	-- Base field of view eases towards the mode's FOV (+ a bit while sprinting).
	local wanted = targetFov + (if sprinting then SPRINT_FOV else 0)
	baseFov += (wanted - baseFov) * math.min(1, dt * 8)

	-- Springs.
	local accel = -angle * STIFFNESS - angleVelocity * DAMPING
	angleVelocity += accel * dt
	angle += angleVelocity * dt
	local fovAccel = -fovOffset * FOV_STIFFNESS - fovVelocity * FOV_DAMPING
	fovVelocity += fovAccel * dt
	fovOffset += fovVelocity * dt

	local pitch, yaw, roll = angle.X, angle.Y, angle.Z

	-- Wobbles: decaying sine on roll + pitch (cartoon "boing").
	local now = os.clock()
	for index = #wobbles, 1, -1 do
		local wobble = wobbles[index]
		local t = now - wobble.Start
		if t >= wobble.Duration then
			table.remove(wobbles, index)
		else
			local decay = (1 - t / wobble.Duration) ^ 2
			local s = wobble.Strength * decay
			roll += math.sin(t * 17 + wobble.Phase) * 0.032 * s
			pitch += math.sin(t * 23 + wobble.Phase * 2) * 0.014 * s
			yaw += math.sin(t * 11 + wobble.Phase) * 0.008 * s
		end
	end

	-- Noise shake.
	if trauma > 0 then
		local time = now * 25
		local strength = trauma * trauma
		pitch += math.noise(noiseSeed, time) * 0.025 * strength
		yaw += math.noise(noiseSeed + 10, time) * 0.025 * strength
		roll += math.noise(noiseSeed + 20, time) * 0.015 * strength
		trauma = math.max(0, trauma - dt / math.max(traumaDuration, 0.05))
	end

	pitch = math.clamp(pitch, -MAX_ANGLE, MAX_ANGLE)
	yaw = math.clamp(yaw, -MAX_ANGLE, MAX_ANGLE)
	roll = math.clamp(roll, -MAX_ANGLE, MAX_ANGLE)
	if math.abs(pitch) + math.abs(yaw) + math.abs(roll) > 1e-5 then
		appliedOffset = CFrame.Angles(pitch, yaw, roll)
		cam.CFrame *= appliedOffset
	end
	cam.FieldOfView = math.clamp(baseFov + fovOffset, 30, 110)
end

-- A springy nod when YOUR hit lands.
function CameraController.Kick(strength: number?)
	local s = math.clamp(strength or 1, 0, 3)
	fovVelocity -= 18 * s -- quick little zoom-in squash
	if not shakeAllowed() then
		return
	end
	local side = if math.random() < 0.5 then -1 else 1
	angleVelocity += Vector3.new(-0.3 * s, 0.06 * s * side, 0.22 * s * side)
end

-- A decaying, bouncy wobble (tree falls, rocks shatter, land rises).
function CameraController.Wobble(strength: number, duration: number?)
	if not shakeAllowed() then
		return
	end
	table.insert(wobbles, {
		Start = os.clock(),
		Duration = math.clamp(duration or 0.8, 0.1, 3),
		Strength = math.clamp(strength, 0, 2),
		Phase = math.random() * math.pi * 2,
	})
	if #wobbles > 4 then
		table.remove(wobbles, 1)
	end
	angleVelocity += Vector3.new(-0.2 * strength, 0, 0)
end

function CameraController.Shake(intensity: number, duration: number?)
	if not shakeAllowed() then
		return
	end
	trauma = math.clamp(math.max(trauma, intensity), 0, GameConfig.Camera.MaxShakeIntensity)
	traumaDuration = duration or 0.3
end

function CameraController.SetMode(newMode: string)
	local def = MODES[newMode]
	if not def then
		return
	end
	mode = newMode
	targetFov = def.FieldOfView
end

function CameraController.GetMode(): string
	return mode
end

-- Slightly wider view while sprinting (speed feel).
function CameraController.SetSprint(isSprinting: boolean)
	sprinting = isSprinting
end

-- Springy FOV pop for level ups / unlocks.
function CameraController.Punch(amount: number?)
	fovVelocity += 55 * (amount or 4) / 4
end

function CameraController.Init()
	local player = Players.LocalPlayer
	player.CameraMinZoomDistance = GameConfig.Camera.MinZoom
	player.CameraMaxZoomDistance = GameConfig.Camera.MaxZoom
end

function CameraController.Start()
	-- Undo just before the default camera script, re-apply just after it.
	RunService:BindToRenderStep(BIND_UNDO, Enum.RenderPriority.Camera.Value - 1, undo)
	RunService:BindToRenderStep(BIND_APPLY, Enum.RenderPriority.Camera.Value + 1, step)
	Net.OnClientEvent("CameraShake", function(intensity: any, duration: any, style: any)
		if type(intensity) ~= "number" then
			return
		end
		local time = if type(duration) == "number" then duration else nil
		if style == "Wobble" then
			CameraController.Wobble(intensity, time)
		elseif style == "Kick" then
			CameraController.Kick(intensity)
		else
			CameraController.Shake(intensity, time)
		end
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">FarmController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FarmController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/FarmController
	DEPENDENCIES: Shared.Config.CropConfig, Shared.Util.{CropGrowth, Format}, Client.UI.{Components, Theme}

	Crop labels over every planted soil tile: the crop, its stage, a live
	countdown ("ready in 0:42"), 💧 when watered and a bouncing "READY!" when
	it can be harvested. Farming itself is click-to-interact (hold a hoe,
	seed sack or watering can and click the tile — InteractionController).
	Countdown math is the same shared CropGrowth module the server uses, fed
	by the tile's attributes and the synced server clock.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CropConfig = require(Shared.Config.CropConfig)
local CropGrowth = require(Shared.Util.CropGrowth)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local TILE_TAG = "Interactable"
local LABEL_DISTANCE = 55
local UPDATE_INTERVAL = 0.5

local FarmController = {}

type Label = { Gui: BillboardGui, Title: TextLabel, Status: TextLabel, Bar: Frame, Fill: Frame }

local labels: { [BasePart]: Label } = {}
---------------------------------------------------------------------------
-- Crop labels
---------------------------------------------------------------------------

local function makeLabel(part: BasePart): Label
	local gui = Create("BillboardGui", {
		Name = "CropLabel",
		Size = UDim2.fromOffset(150, 58),
		StudsOffset = Vector3.new(0, 4.2, 0),
		MaxDistance = LABEL_DISTANCE,
		LightInfluence = 0,
		Enabled = false,
		Parent = part,
	})
	local title = Components.Label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 24),
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextLight,
		Text = "",
		Parent = gui,
	})
	Components.TextStroke(title)
	local status = Components.Label({
		Name = "Status",
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 23),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextLight,
		Text = "",
		Parent = gui,
	})
	Components.TextStroke(status, Theme.Colors.Outline, 1.5)
	local bar = Create("Frame", {
		Name = "Bar",
		Size = UDim2.new(0.7, 0, 0, 9),
		Position = UDim2.new(0.15, 0, 0, 45),
		BackgroundColor3 = Theme.Colors.Outline,
		Parent = gui,
	})
	Components.Corner(bar, UDim.new(1, 0))
	local fill = Create("Frame", { Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.Green, Parent = bar })
	Components.Corner(fill, UDim.new(1, 0))
	local label = { Gui = gui, Title = title, Status = status, Bar = bar, Fill = fill }
	labels[part] = label
	part.Destroying:Once(function()
		labels[part] = nil
	end)
	return label
end

local function updateLabel(part: BasePart, label: Label, now: number)
	local state = part:GetAttribute("TileState")
	local cropId = part:GetAttribute("CropId")
	local crop = type(cropId) == "string" and CropConfig.Crops[cropId]
	if state ~= "Planted" or not crop then
		label.Gui.Enabled = false
		return
	end
	local entry = {
		CropId = cropId :: string,
		PlantedAt = part:GetAttribute("PlantedAt") :: number?,
		WateredAt = part:GetAttribute("WateredAt") :: number?,
	}
	local progress = CropGrowth.GetProgress(entry, now)
	local stage = CropGrowth.GetStage(entry, now)
	local watered = CropGrowth.IsWatered(entry)
	label.Gui.Enabled = true
	label.Title.Text = crop.Icon .. " " .. crop.DisplayName
	if progress >= 1 then
		label.Status.Text = "✨ READY! Harvest me"
		label.Status.TextColor3 = Theme.Colors.Coins
		label.Fill.BackgroundColor3 = Theme.Colors.Coins
		-- Gentle bounce so ready crops catch the eye.
		label.Gui.StudsOffset = Vector3.new(0, 4.2 + math.abs(math.sin(now * 3)) * 0.5, 0)
	else
		local remaining = CropGrowth.GetRemaining(entry, now)
		label.Status.Text = ("%s · %s%s"):format(CropConfig.Stages[stage], Format.Duration(math.ceil(remaining)), if watered then " 💧" else "")
		label.Status.TextColor3 = if watered then Color3.fromRGB(150, 215, 255) else Theme.Colors.TextLight
		label.Fill.BackgroundColor3 = if watered then Theme.Colors.Blue else Theme.Colors.Green
		label.Gui.StudsOffset = Vector3.new(0, 4.2, 0)
	end
	label.Fill.Size = UDim2.fromScale(progress, 1)
end

local function updateLabels()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local now = workspace:GetServerTimeNow()
	local eye = camera.CFrame.Position
	for _, instance in CollectionService:GetTagged(TILE_TAG) do
		if instance:IsA("BasePart") and instance:GetAttribute("Interact") == "FarmTile" then
			local label = labels[instance]
			if (instance.Position - eye).Magnitude <= LABEL_DISTANCE + 10 then
				updateLabel(instance, label or makeLabel(instance), now)
			elseif label then
				label.Gui.Enabled = false
			end
		end
	end
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------

function FarmController.Start()
	task.spawn(function()
		while true do
			updateLabels()
			task.wait(UPDATE_INTERVAL)
		end
	end)
end

return FarmController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">FishingController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  FishingController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/FishingController
	DEPENDENCIES: Shared.Net, Shared.Config.{FishConfig, RarityConfig, IslandConfig}, Shared.Util.R15,
	              InputController, UIController, ToolController, InteractionController,
	              AudioController, VFXController, CameraController, Client.UI.{Components, Theme}

	Client side of fishing (spec §29-§32). Hold your rod and CLICK THE WATER
	(or R2 / the touch USE button) — that drives the whole thing:

	  Idle     click water → FishingRequest{Op="Cast", Target}
	  Waiting  bobber floats on the water, line drawn with a Beam
	  Bite     "!" + splash + sound → USE within the hook window
	  Reeling  MINIGAME: HOLD USE to lift the green zone, keep the fish inside
	           it until the bar fills. Let it escape and the bar drains.
	  Result   catch card (rarity colour, weight, NEW!) or the escape reason

	The client never knows WHICH fish bit — only its rarity and difficulty.
	It reports Success/Fail with the server's one-time token; the server
	rejects catches faster than FishConfig.MinReelTime and grants the fish.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local FishConfig = require(Shared.Config.FishConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local IslandConfig = require(Shared.Config.IslandConfig)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local ToolController = require(script.Parent.ToolController)
local InteractionController = require(script.Parent.InteractionController)
local AudioController = require(script.Parent.AudioController)
local VFXController = require(script.Parent.VFXController)
local CameraController = require(script.Parent.CameraController)
local AnimationController = require(script.Parent.AnimationController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local CAST_DISTANCE = 9
local CAST_TIMEOUT = 2.5 -- no Cast reply in this long → the server said no
local CAST_FLIGHT = 0.45
local START_GRACE = 0.9 -- seconds at the start of a reel where progress can't drain

local FishingController = {}

type Minigame = {
	Token: any,
	Difficulty: number,
	Rarity: string,
	ZoneSize: number,
	ZonePos: number,
	ZoneVel: number,
	FishPos: number,
	FishTarget: number,
	FishTimer: number,
	Progress: number,
	Elapsed: number,
	Finished: boolean,
}

local state: string = "Idle" -- Idle | Casting | Waiting | Bite | Hooking | Reeling
local castRequestedAt = 0
local random = Random.new()

local bobber: Model? = nil
local bobberBase: Vector3 = Vector3.zero
local castFrom: Vector3 = Vector3.zero
local castStartedAt = 0
local lineBeam: Beam? = nil
local rodAttachment: Attachment? = nil
local biteMark: BillboardGui? = nil
local renderConnection: RBXScriptConnection? = nil
local minigame: Minigame? = nil

type Refs = {
	Status: TextLabel,
	Reel: Frame,
	ReelTitle: TextLabel,
	Track: Frame,
	Zone: Frame,
	Fish: TextLabel,
	ProgressFill: Frame,
	ReelHint: TextLabel,
	Card: Frame,
	CardIcon: TextLabel,
	CardTitle: TextLabel,
	CardRarity: TextLabel,
	CardInfo: TextLabel,
	CardNew: TextLabel,
}
local refs: Refs
local cardToken = 0

---------------------------------------------------------------------------
-- World visuals (all local, under the camera)
---------------------------------------------------------------------------

local function useHint(): string
	local device = InputController.GetDevice()
	if device == "Touch" then
		return "USE"
	elseif device == "Gamepad" then
		return "R2"
	end
	return "CLICK"
end

local function waterHeightAt(position: Vector3): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { workspace.Terrain }
	params.IgnoreWater = false
	local hit = workspace:Raycast(position + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), params)
	return if hit then hit.Position.Y else IslandConfig.SeaLevel
end

local function rodTip(): Attachment?
	local character = player.Character
	if not character then
		return nil
	end
	if rodAttachment and rodAttachment.Parent and rodAttachment:IsDescendantOf(character) then
		return rodAttachment
	end
	local tip = character:FindFirstChild("Tip", true)
	local anchor: BasePart? = if tip and tip:IsA("BasePart") then tip else R15.GetPart(character, "RightHand")
	if not anchor then
		return nil
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "FishingLine"
	attachment.Position = if anchor.Name == "Tip" then Vector3.new(0, anchor.Size.Y / 2, 0) else Vector3.zero
	attachment.Parent = anchor
	rodAttachment = attachment
	return attachment
end

local function makeBobber(): Model
	local model = Instance.new("Model")
	model.Name = "Bobber"
	local ball = Instance.new("Part")
	ball.Name = "Float"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(0.7, 0.7, 0.7)
	ball.Color = Color3.fromRGB(235, 60, 55)
	ball.Material = Enum.Material.SmoothPlastic
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanQuery = false
	ball.CanTouch = false
	ball.Parent = model
	local cap = Instance.new("Part")
	cap.Name = "Cap"
	cap.Shape = Enum.PartType.Cylinder
	cap.Size = Vector3.new(0.12, 0.72, 0.72)
	cap.Color = Color3.fromRGB(250, 250, 250)
	cap.Material = Enum.Material.SmoothPlastic
	cap.Anchored = true
	cap.CanCollide = false
	cap.CanQuery = false
	cap.CanTouch = false
	cap.CFrame = CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.rad(90))
	cap.Parent = model
	model.PrimaryPart = ball
	local attachment = Instance.new("Attachment")
	attachment.Name = "LineEnd"
	attachment.Parent = ball
	model.Parent = workspace.CurrentCamera
	return model
end

local function clearWorld()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
	if lineBeam then
		lineBeam:Destroy()
		lineBeam = nil
	end
	if bobber then
		bobber:Destroy()
		bobber = nil
	end
	biteMark = nil
end

local function showBiteMark(show: boolean)
	if not bobber then
		return
	end
	if show and not biteMark then
		local gui = Create("BillboardGui", {
			Name = "BiteMark",
			Size = UDim2.fromOffset(60, 60),
			StudsOffset = Vector3.new(0, 2.2, 0),
			AlwaysOnTop = true,
			LightInfluence = 0,
			Parent = bobber.PrimaryPart,
		})
		local label = Components.Label({ Text = "!", Size = UDim2.fromScale(1, 1), TextSize = 54, TextColor3 = Theme.Colors.Red, Parent = gui })
		Components.TextStroke(label, Theme.Colors.TextLight, 3)
		Components.Bounce(label, 0.5)
		biteMark = gui
	elseif not show and biteMark then
		biteMark:Destroy()
		biteMark = nil
	end
end

local function renderWorld()
	if not bobber then
		return
	end
	local now = os.clock()
	local flight = math.clamp((now - castStartedAt) / CAST_FLIGHT, 0, 1)
	local position: Vector3
	if flight < 1 then
		-- Arc from the rod tip to the water.
		local flat = castFrom:Lerp(bobberBase, flight)
		position = flat + Vector3.new(0, math.sin(flight * math.pi) * 5, 0)
	elseif state == "Bite" then
		position = bobberBase + Vector3.new(math.sin(now * 40) * 0.08, -0.45 + math.sin(now * 25) * 0.12, 0)
	elseif state == "Hooking" or state == "Reeling" then
		position = bobberBase + Vector3.new(math.sin(now * 13) * 0.25, -0.3 + math.sin(now * 17) * 0.1, math.cos(now * 11) * 0.25)
	else
		position = bobberBase + Vector3.new(0, math.sin(now * 2.2) * 0.1, 0)
	end
	bobber:PivotTo(CFrame.new(position))

	local tip = rodTip()
	if tip and not lineBeam then
		local beam = Instance.new("Beam")
		beam.Name = "FishingLine"
		beam.Attachment0 = tip
		beam.Attachment1 = (bobber.PrimaryPart :: BasePart):FindFirstChild("LineEnd") :: Attachment
		beam.Width0 = 0.05
		beam.Width1 = 0.05
		beam.FaceCamera = true
		beam.Segments = 12
		beam.CurveSize0 = 0
		beam.CurveSize1 = -1.5
		beam.Color = ColorSequence.new(Color3.fromRGB(245, 245, 245))
		beam.LightInfluence = 0
		beam.Transparency = NumberSequence.new(0.15)
		beam.Parent = bobber
		lineBeam = beam
	elseif lineBeam and tip then
		lineBeam.Attachment0 = tip
	end
end

local function startBobber(spot: Vector3?)
	clearWorld()
	local root = R15.GetRootPart(player.Character)
	if not root then
		return
	end
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.1 then
		look = Vector3.new(0, 0, -1)
	end
	local target = spot or (root.Position + look.Unit * CAST_DISTANCE)
	bobberBase = Vector3.new(target.X, waterHeightAt(target) + 0.15, target.Z)
	local tip = rodTip()
	castFrom = if tip then tip.WorldPosition else root.Position + Vector3.new(0, 2, 0)
	castStartedAt = os.clock()
	bobber = makeBobber()
	renderConnection = RunService.RenderStepped:Connect(renderWorld)
	task.delay(CAST_FLIGHT, function()
		if bobber and state ~= "Idle" then
			VFXController.Play("WaterSplash", bobberBase)
		end
	end)
end

---------------------------------------------------------------------------
-- UI
---------------------------------------------------------------------------

local function setStatus(text: string?, color: Color3?)
	refs.Status.Visible = text ~= nil
	if text then
		refs.Status.Text = text
		refs.Status.BackgroundColor3 = color or Theme.Colors.Outline
		Components.Bounce(refs.Status, 0.08)
	end
end

local function resetAll()
	state = "Idle"
	minigame = nil
	refs.Reel.Visible = false
	setStatus(nil)
	clearWorld()
end

local function cancelFishing()
	if state == "Idle" then
		return
	end
	Net.FireServer("FishingRequest", { Op = "Cancel" })
	resetAll()
end

local function showCatch(fishId: string, weight: number, isNew: boolean)
	local fish = FishConfig.Fish[fishId]
	if not fish then
		return
	end
	local rarity = RarityConfig.Get(fish.Rarity)
	cardToken += 1
	local token = cardToken
	refs.CardIcon.Text = "🐟"
	refs.CardIcon.TextColor3 = fish.Color
	refs.CardTitle.Text = fish.DisplayName
	refs.CardRarity.Text = string.upper(rarity.DisplayName)
	refs.CardRarity.TextColor3 = rarity.Color
	refs.CardInfo.Text = ("%.1f kg · sells for %d 🪙"):format(weight, fish.SellValue)
	refs.CardNew.Visible = isNew
	local stroke = refs.Card:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = rarity.Color
	end
	refs.Card.Visible = true
	Components.Bounce(refs.Card, 0.2)
	if rarity.Rank >= 4 then
		UIController.Banner(string.upper(rarity.DisplayName) .. " CATCH!", fish.DisplayName, "Reward")
	end
	task.delay(3.5, function()
		if cardToken == token then
			refs.Card.Visible = false
		end
	end)
end

local function buildUI()
	local layer = UIController.GetModalLayer()

	local status = Components.Label({
		Name = "FishingStatus",
		Size = UDim2.fromOffset(360, 40),
		Position = UDim2.new(0.5, 0, 1, -128),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.1,
		BackgroundColor3 = Theme.Colors.Outline,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Medium,
		Text = "",
		Visible = false,
		Parent = layer,
	})
	Components.Corner(status, UDim.new(1, 0))

	-- REEL MINIGAME -------------------------------------------------------
	local reel = Create("Frame", {
		Name = "ReelMinigame",
		Size = UDim2.fromOffset(190, 420),
		Position = UDim2.new(0.5, 150, 0.5, -10),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = layer,
	})
	Components.Corner(reel)
	Components.Stroke(reel, Theme.Colors.Outline, 4)
	local reelTitle = Components.Label({ Size = UDim2.new(1, -12, 0, 30), Position = UDim2.fromOffset(6, 6), TextSize = Theme.TextSize.Large, Text = "", Parent = reel })
	Components.TextStroke(reelTitle, Theme.Colors.Outline, 2)
	local track = Create("Frame", {
		Name = "Track",
		Size = UDim2.fromOffset(70, 320),
		Position = UDim2.fromOffset(30, 42),
		BackgroundColor3 = Color3.fromRGB(60, 140, 210),
		ClipsDescendants = true,
		Parent = reel,
	}, {
		Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(120, 200, 255), Color3.fromRGB(30, 80, 160)),
		}),
	})
	Components.Corner(track, Theme.SmallCorner)
	Components.Stroke(track, Theme.Colors.Outline, 3)
	local zone = Create("Frame", {
		Name = "Zone",
		Size = UDim2.fromScale(1, 0.3),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Green,
		BackgroundTransparency = 0.25,
		Parent = track,
	})
	Components.Corner(zone, Theme.SmallCorner)
	Components.Stroke(zone, Theme.Colors.TextLight, 2)
	local fishIcon = Components.Label({
		Name = "Fish",
		Text = "🐟",
		Size = UDim2.fromOffset(44, 36),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		TextSize = 32,
		ZIndex = 3,
		Parent = track,
	})
	local progressBack = Create("Frame", {
		Name = "Progress",
		Size = UDim2.fromOffset(26, 320),
		Position = UDim2.fromOffset(122, 42),
		BackgroundColor3 = Theme.Colors.PanelDark,
		ClipsDescendants = true,
		Parent = reel,
	})
	Components.Corner(progressBack, UDim.new(1, 0))
	Components.Stroke(progressBack, Theme.Colors.Outline, 3)
	local progressFill = Create("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 0.25),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Colors.Coins,
		Parent = progressBack,
	})
	Components.Corner(progressFill, UDim.new(1, 0))
	local reelHint = Components.Label({
		Size = UDim2.new(1, -12, 0, 44),
		Position = UDim2.fromOffset(6, 368),
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		Text = "",
		Parent = reel,
	})

	-- CATCH CARD -----------------------------------------------------------
	local card = Create("Frame", {
		Name = "CatchCard",
		Size = UDim2.fromOffset(320, 150),
		Position = UDim2.new(0.5, 0, 0, 140),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = layer,
	})
	Components.Corner(card)
	Components.Stroke(card, Theme.Colors.Outline, 5)
	local cardIcon = Components.Label({ Size = UDim2.fromOffset(100, 100), Position = UDim2.fromOffset(12, 25), TextSize = 76, Text = "🐟", Parent = card })
	local cardRarity = Components.Label({ Size = UDim2.new(1, -130, 0, 22), Position = UDim2.fromOffset(118, 18), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Text = "", Parent = card })
	Components.TextStroke(cardRarity, Theme.Colors.Outline, 1.5)
	local cardTitle = Components.Label({ Size = UDim2.new(1, -130, 0, 34), Position = UDim2.fromOffset(118, 42), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Title, TextScaled = true, Text = "", Parent = card })
	local cardInfo = Components.Label({ Size = UDim2.new(1, -130, 0, 40), Position = UDim2.fromOffset(118, 80), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = card })
