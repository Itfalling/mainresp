        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">AnimationPlayer</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationPlayer
	SCRIPT TYPE:  ModuleScript (shared animation core)
	WHERE:        ReplicatedStorage/Shared/Animation/AnimationPlayer
	DEPENDENCIES: Shared.Config.AnimationConfig, Shared.Util.Signal, Shared.Util.AssetId,
	              Shared.Animation.ProceduralFallback

	One AnimationPlayer per rig (R15 character, NPC or animal). Used by the
	client AnimationController (local character) and the server
	AnimationService (NPCs / animals) so there is exactly ONE implementation of
	loading, caching, priorities, markers and cleanup.

	  local player = AnimationPlayer.new(character, { EnableFallback = true })
	  local handle = player:Play("HammerSwing", {
	      Markers = { HammerHit = function() applyBuildProgress() end },
	  })
	  handle.Ended:Connect(function() end)

	Handles behave the same for real and placeholder animations:
	  * real Id        -> AnimationTrack + GetMarkerReachedSignal
	                      (+ watchdog if the uploaded animation forgot a marker)
	  * placeholder Id -> "virtual" track: markers fire at AnimationConfig times,
	                      Ended fires after Length / Speed.
	So gameplay code NEVER uses arbitrary task.wait() for animation timing.
]]

local RunService = game:GetService("RunService")

local Shared = script.Parent.Parent
local AnimationConfig = require(Shared.Config.AnimationConfig)
local AssetId = require(Shared.Util.AssetId)
local Signal = require(Shared.Util.Signal)
local ProceduralFallback = require(script.Parent.ProceduralFallback)

export type PlayOptions = {
	Speed: number?,
	FadeTime: number?,
	Weight: number?,
	Force: boolean?, -- play even if a non-interruptible animation is running
	Markers: { [string]: (handle: any) -> () }?,
}

local animationCache: { [string]: Animation } = {}
local warnedOnce: { [string]: boolean } = {}

local function warnOnce(key: string, message: string)
	if not warnedOnce[key] then
		warnedOnce[key] = true
		warn(message)
	end
end

local function getAnimationObject(id: string): Animation
	local animation = animationCache[id]
	if not animation then
		animation = Instance.new("Animation")
		animation.AnimationId = id
		animationCache[id] = animation
	end
	return animation
end

---------------------------------------------------------------------------
-- Handle
---------------------------------------------------------------------------

local Handle = {}
Handle.__index = Handle

function Handle.new(owner: any, name: string, def: any, speed: number)
	local self = setmetatable({
		Name = name,
		Def = def,
		Owner = owner,
		Speed = speed,
		Playing = true,
		Track = nil :: AnimationTrack?,
		Ended = Signal.new(),
		_callbacks = {} :: { [string]: { (any) -> () } },
		_connections = {} :: { RBXScriptConnection },
		_connectedMarkers = {} :: { [string]: boolean },
		_reached = {} :: { [string]: boolean },
		_threads = {} :: { thread },
		_stopFallback = nil :: (() -> ())?,
		_cycle = 0,
	}, Handle)
	return self
end

function Handle:IsPlaying(): boolean
	return self.Playing
end

function Handle:_reach(markerName: string, cycle: number?)
	if not self.Playing then
		return
	end
	if cycle and cycle ~= self._cycle then
		return
	end
	self._reached[markerName] = true
	local callbacks = self._callbacks[markerName]
	if callbacks then
		for _, callback in callbacks do
			task.spawn(callback, self)
		end
	end
	self.Owner.MarkerReached:Fire(self.Name, markerName, self)
end

function Handle:_connectRealMarker(markerName: string)
	local track = self.Track
	if not track or self._connectedMarkers[markerName] then
		return
	end
	self._connectedMarkers[markerName] = true
	table.insert(self._connections, track:GetMarkerReachedSignal(markerName):Connect(function()
		self:_reach(markerName)
	end))
end

function Handle:OnMarker(markerName: string, callback: (any) -> ())
	local list = self._callbacks[markerName]
	if not list then
		list = {}
		self._callbacks[markerName] = list
	end
	table.insert(list, callback)
	self:_connectRealMarker(markerName)
end

-- Schedules one virtual cycle: configured markers + end/loop.
function Handle:_scheduleVirtualCycle()
	self._cycle += 1
	local cycle = self._cycle
	local speed = math.max(self.Speed, 0.01)
	for markerName, time in self.Def.Markers do
		table.insert(self._threads, task.delay(time / speed, function()
			self:_reach(markerName, cycle)
		end))
	end
	table.insert(self._threads, task.delay(self.Def.Length / speed, function()
		if not self.Playing or cycle ~= self._cycle then
			return
		end
		if self.Def.Looped then
			self:_scheduleVirtualCycle()
		else
			self:_finish()
		end
	end))
end

-- Real tracks: fire any configured marker the uploaded animation never sent.
function Handle:_scheduleWatchdogs()
	if self.Def.Looped then
		return
	end
	local speed = math.max(self.Speed, 0.01)
	for markerName, time in self.Def.Markers do
		self:_connectRealMarker(markerName)
		table.insert(self._threads, task.delay(time / speed + AnimationConfig.MarkerWatchdogGrace, function()
			if self.Playing and not self._reached[markerName] then
				warnOnce(
					self.Name .. ":" .. markerName,
					("[Animation] '%s' never fired marker '%s' — add it in the Animation Editor. Firing from config timing."):format(self.Name, markerName)
				)
				self:_reach(markerName)
			end
		end))
	end
end

function Handle:_finish()
	if not self.Playing then
		return
	end
	self.Playing = false
	for _, connection in self._connections do
		connection:Disconnect()
	end
	table.clear(self._connections)
	for _, thread in self._threads do
		if coroutine.status(thread) == "suspended" then
			pcall(task.cancel, thread)
		end
	end
	table.clear(self._threads)
	if self._stopFallback then
		self._stopFallback()
		self._stopFallback = nil
	end
	if self.Owner._handles[self.Name] == self then
		self.Owner._handles[self.Name] = nil
	end
	self.Ended:Fire(self)
	self.Ended:DisconnectAll()
end

function Handle:Stop(fadeTime: number?)
	if not self.Playing then
		return
	end
	local track = self.Track
	if track then
		track:Stop(fadeTime or self.Def.FadeOut)
	end
	self:_finish()
end

function Handle:SetSpeed(speed: number)
	self.Speed = math.max(speed, 0.01)
	local track = self.Track
	if track then
		track:AdjustSpeed(self.Speed)
	end
end

---------------------------------------------------------------------------
-- AnimationPlayer
---------------------------------------------------------------------------

local AnimationPlayer = {}
AnimationPlayer.__index = AnimationPlayer

function AnimationPlayer.new(rig: Model, options: { EnableFallback: boolean? }?)
	local self = setmetatable({
		Rig = rig,
		MarkerReached = Signal.new(), -- (animationName, markerName, handle)
		_tracks = {} :: { [string]: AnimationTrack },
		_handles = {} :: { [string]: any },
		_enableFallback = options ~= nil and options.EnableFallback == true and AnimationConfig.UseProceduralFallback,
		_destroyed = false,
	}, AnimationPlayer)
	return self
end

function AnimationPlayer:_getAnimator(): Animator?
	local controller: Instance? = self.Rig:FindFirstChildOfClass("Humanoid") or self.Rig:FindFirstChildOfClass("AnimationController")
	if not controller then
		return nil
	end
	local animator = controller:FindFirstChildOfClass("Animator")
	if not animator and RunService:IsServer() then
		animator = Instance.new("Animator")
		animator.Parent = controller
	end
	return animator
end

-- Returns (and caches) the AnimationTrack, or nil for placeholder ids.
function AnimationPlayer:LoadTrack(name: string): AnimationTrack?
	local cached = self._tracks[name]
	if cached then
		return cached
	end
	local def = AnimationConfig.Get(name)
	if not def or AssetId.IsPlaceholder(def.Id) then
		return nil
	end
	local animator = self:_getAnimator()
	if not animator then
		warnOnce("NoAnimator:" .. self.Rig:GetFullName(), "[Animation] No Animator found on " .. self.Rig:GetFullName())
		return nil
	end
	local ok, track = pcall(animator.LoadAnimation, animator, getAnimationObject(def.Id))
	if not ok or not track then
		warnOnce("LoadFail:" .. name, ("[Animation] Failed to load '%s' (%s): %s"):format(name, def.Id, tostring(track)))
		return nil
	end
	local priority = (Enum.AnimationPriority :: any)[def.Priority]
	if priority then
		track.Priority = priority
	end
	track.Looped = def.Looped
	self._tracks[name] = track
	return track
end

-- Preload tracks so the first swing has no hitch.
function AnimationPlayer:Preload(names: { string })
	for _, name in names do
		self:LoadTrack(name)
	end
end

function AnimationPlayer:_blockedByNonInterruptible(): boolean
	for _, handle in self._handles do
		if handle.Playing and handle.Def.Interruptible == false and not handle.Def.Looped then
			return true
		end
	end
	return false
end

function AnimationPlayer:Play(name: string, options: PlayOptions?): any
	if self._destroyed then
		return nil
	end
	local opts: PlayOptions = options or {}
	local def = AnimationConfig.Get(name)
	if not def then
		warnOnce("Unknown:" .. name, "[Animation] Unknown animation '" .. name .. "' (add it to AnimationConfig)")
		return nil
	end
	if not opts.Force and self:_blockedByNonInterruptible() then
		return nil
	end

	local existing = self._handles[name]
	if existing then
		existing:Stop(0.05)
	end

	local speed = opts.Speed or 1
	local handle = Handle.new(self, name, def, speed)
	self._handles[name] = handle

	if opts.Markers then
		for markerName, callback in opts.Markers do
			handle:OnMarker(markerName, callback)
		end
	end

	local track = self:LoadTrack(name)
	if track then
		handle.Track = track
		-- Mark the handle before connecting so OnMarker callbacks registered above hook the track.
		for markerName in handle._callbacks do
			handle:_connectRealMarker(markerName)
		end
		table.insert(handle._connections, track.Stopped:Connect(function()
			-- With deferred signals a Stop()+Play() on the same cached track can
			-- deliver the old Stopped after the new Play; ignore it in that case.
			if track.IsPlaying then
				return
			end
			handle:_finish()
		end))
		track:Play(opts.FadeTime or def.FadeIn, opts.Weight or 1, speed)
		handle:_scheduleWatchdogs()
	else
		handle:_scheduleVirtualCycle()
		if self._enableFallback and ProceduralFallback.HasStyle(def.Fallback) then
			handle._stopFallback = ProceduralFallback.Play(self.Rig, def.Fallback, def.Length / math.max(speed, 0.01), def.Looped)
		end
	end

	return handle
end

function AnimationPlayer:Stop(name: string, fadeTime: number?)
	local handle = self._handles[name]
	if handle then
		handle:Stop(fadeTime)
	end
end

function AnimationPlayer:StopAll(fadeTime: number?)
	for _, handle in table.clone(self._handles) do
		handle:Stop(fadeTime)
	end
end

function AnimationPlayer:IsPlaying(name: string): boolean
	local handle = self._handles[name]
	return handle ~= nil and handle.Playing
end

function AnimationPlayer:GetHandle(name: string): any
	return self._handles[name]
end

function AnimationPlayer:SetSpeed(name: string, speed: number)
	local handle = self._handles[name]
	if handle then
		handle:SetSpeed(speed)
	end
end

function AnimationPlayer:Destroy()
	if self._destroyed then
		return
	end
	self._destroyed = true
	self:StopAll(0)
	for _, track in self._tracks do
		track:Destroy()
	end
	table.clear(self._tracks)
	self.MarkerReached:DisconnectAll()
end

return AnimationPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">ProceduralFallback</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ProceduralFallback
	SCRIPT TYPE:  ModuleScript (shared, prototyping aid)
	WHERE:        ReplicatedStorage/Shared/Animation/ProceduralFallback
	DEPENDENCIES: Shared.Util.R15

	PROTOTYPE-ONLY arm poses used while AnimationConfig still has placeholder
	ids. It gently rotates the R15 shoulder Motor6D.C0 values so you can see
	swing timing line up with markers during development.

	  * Only the R15 RightShoulder / LeftShoulder motors are touched.
	  * The Animator never writes C0, so this never fights real animations.
	  * Changes made on a client are local to that client (not replicated).
	  * Disabled entirely by AnimationConfig.UseProceduralFallback = false, and
	    never used for animations that have a real Id.
]]

local RunService = game:GetService("RunService")

local R15 = require(script.Parent.Parent.Util.R15)

type Key = { T: number, R: Vector3, L: Vector3? }
type Style = { Keys: { Key } }

-- Angles are degrees applied to shoulder C0 (X+ raises the arm forward/up).
local STYLES: { [string]: Style } = {
	Hold = { Keys = { { T = 0, R = Vector3.new(25, 0, 0) }, { T = 1, R = Vector3.new(25, 0, 0) } } },
	Carry = { Keys = { { T = 0, R = Vector3.new(60, 0, 8), L = Vector3.new(60, 0, -8) }, { T = 1, R = Vector3.new(60, 0, 8), L = Vector3.new(60, 0, -8) } } },
	Swing = { Keys = {
		{ T = 0, R = Vector3.new(25, 0, 0) },
		{ T = 0.4, R = Vector3.new(160, 0, 0) },
		{ T = 0.5, R = Vector3.new(40, 0, 0) },
		{ T = 1, R = Vector3.new(25, 0, 0) },
	} },
	HeavySwing = { Keys = {
		{ T = 0, R = Vector3.new(25, 0, 0) },
		{ T = 0.45, R = Vector3.new(175, 0, 0), L = Vector3.new(120, 0, 0) },
		{ T = 0.56, R = Vector3.new(30, 0, 0), L = Vector3.new(30, 0, 0) },
		{ T = 1, R = Vector3.new(25, 0, 0) },
	} },
	Dig = { Keys = {
		{ T = 0, R = Vector3.new(20, 0, 0), L = Vector3.new(20, 0, 0) },
		{ T = 0.35, R = Vector3.new(75, 0, 0), L = Vector3.new(75, 0, 0) },
		{ T = 0.55, R = Vector3.new(5, 0, 0), L = Vector3.new(5, 0, 0) },
		{ T = 1, R = Vector3.new(20, 0, 0), L = Vector3.new(20, 0, 0) },
	} },
	Till = { Keys = {
		{ T = 0, R = Vector3.new(20, 0, 0) },
		{ T = 0.4, R = Vector3.new(115, 0, 0) },
		{ T = 0.55, R = Vector3.new(15, 0, 0) },
		{ T = 1, R = Vector3.new(20, 0, 0) },
	} },
	Reach = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.5, R = Vector3.new(65, 0, 0) },
		{ T = 1, R = Vector3.new(0, 0, 0) },
	} },
	Pour = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.3, R = Vector3.new(70, 0, -20) },
		{ T = 1, R = Vector3.new(70, 0, -20) },
	} },
	Wave = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.2, R = Vector3.new(170, 0, -20) },
		{ T = 0.35, R = Vector3.new(170, 0, 20) },
		{ T = 0.5, R = Vector3.new(170, 0, -20) },
		{ T = 0.65, R = Vector3.new(170, 0, 20) },
		{ T = 0.8, R = Vector3.new(170, 0, 0) },
		{ T = 1, R = Vector3.new(0, 0, 0) },
	} },
	Cheer = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0), L = Vector3.new(0, 0, 0) },
		{ T = 0.25, R = Vector3.new(170, 0, 20), L = Vector3.new(170, 0, -20) },
		{ T = 0.5, R = Vector3.new(150, 0, 10), L = Vector3.new(150, 0, -10) },
		{ T = 0.75, R = Vector3.new(170, 0, 20), L = Vector3.new(170, 0, -20) },
		{ T = 1, R = Vector3.new(0, 0, 0), L = Vector3.new(0, 0, 0) },
	} },
	Point = { Keys = {
		{ T = 0, R = Vector3.new(0, 0, 0) },
		{ T = 0.2, R = Vector3.new(90, 0, 0) },
		{ T = 0.8, R = Vector3.new(90, 0, 0) },
		{ T = 1, R = Vector3.new(0, 0, 0) },
	} },
	Cast = { Keys = {
		{ T = 0, R = Vector3.new(25, 0, 0) },
		{ T = 0.35, R = Vector3.new(165, 0, 0) },
		{ T = 0.5, R = Vector3.new(60, 0, 0) },
		{ T = 1, R = Vector3.new(40, 0, 0) },
	} },
	Reel = { Keys = {
		{ T = 0, R = Vector3.new(40, 0, 0), L = Vector3.new(35, 0, 0) },
		{ T = 0.5, R = Vector3.new(55, 0, 10), L = Vector3.new(45, 0, 0) },
		{ T = 1, R = Vector3.new(40, 0, 0), L = Vector3.new(35, 0, 0) },
	} },
}

type Entry = { Style: Style, Start: number, Duration: number, Looped: boolean }
type RigState = {
	Rig: Model,
	Right: Motor6D?,
	Left: Motor6D?,
	RightOriginal: CFrame?,
	LeftOriginal: CFrame?,
	Base: Entry?,
	Action: Entry?,
}

local ProceduralFallback = {}

local states: { [Model]: RigState } = {}
local stepConnection: RBXScriptConnection? = nil

local function sample(keys: { Key }, alpha: number, useLeft: boolean): Vector3
	local function valueOf(key: Key): Vector3
		if useLeft then
			return key.L or Vector3.zero
		end
		return key.R
	end
	if alpha <= keys[1].T then
		return valueOf(keys[1])
	end
	for i = 1, #keys - 1 do
		local a, b = keys[i], keys[i + 1]
		if alpha <= b.T then
			local span = math.max(b.T - a.T, 1e-3)
			local t = (alpha - a.T) / span
			t = t * t * (3 - 2 * t) -- smoothstep for less robotic motion
			return valueOf(a):Lerp(valueOf(b), t)
		end
	end
	return valueOf(keys[#keys])
end

local function toAngles(degrees: Vector3): CFrame
	return CFrame.Angles(math.rad(degrees.X), math.rad(degrees.Y), math.rad(degrees.Z))
end

local function restore(state: RigState)
	if state.Right and state.RightOriginal then
		state.Right.C0 = state.RightOriginal
	end
	if state.Left and state.LeftOriginal then
		state.Left.C0 = state.LeftOriginal
	end
end

local function step()
	local now = os.clock()
	for rig, state in states do
		if not rig.Parent then
			states[rig] = nil
			continue
		end
		local action = state.Action
		if action and not action.Looped and now - action.Start >= action.Duration then
			state.Action = nil
			action = nil
		end
		local entry = action or state.Base
		if not entry then
			restore(state)
			states[rig] = nil
			continue
		end
		local elapsed = now - entry.Start
		local alpha = if entry.Looped then (elapsed % entry.Duration) / entry.Duration else math.clamp(elapsed / entry.Duration, 0, 1)
		if state.Right and state.RightOriginal then
			state.Right.C0 = state.RightOriginal * toAngles(sample(entry.Style.Keys, alpha, false))
		end
		if state.Left and state.LeftOriginal then
			state.Left.C0 = state.LeftOriginal * toAngles(sample(entry.Style.Keys, alpha, true))
		end
	end
	if next(states) == nil and stepConnection then
		stepConnection:Disconnect()
		stepConnection = nil
	end
end

function ProceduralFallback.HasStyle(styleName: string?): boolean
	return styleName ~= nil and STYLES[styleName] ~= nil
end

-- Returns a stop function. Safe to call on any rig; no-ops for non-R15 rigs.
function ProceduralFallback.Play(rig: Model, styleName: string, duration: number, looped: boolean): () -> ()
	local style = STYLES[styleName]
	if not style or not R15.IsR15(rig) then
		return function() end
	end

	local state = states[rig]
	if not state then
		local right = R15.GetMotor(rig, "RightShoulder")
		local left = R15.GetMotor(rig, "LeftShoulder")
		local newState: RigState = {
			Rig = rig,
			Right = right,
			Left = left,
			RightOriginal = right and right.C0,
			LeftOriginal = left and left.C0,
		}
		states[rig] = newState
		state = newState
	end
	assert(state)

	local entry: Entry = { Style = style, Start = os.clock(), Duration = math.max(duration, 0.05), Looped = looped }
	if looped then
		state.Base = entry
	else
		state.Action = entry
	end

	if not stepConnection then
		stepConnection = RunService.Heartbeat:Connect(step)
	end

	return function()
		local current = states[rig]
		if not current then
			return
		end
		if current.Base == entry then
			current.Base = nil
		end
		if current.Action == entry then
			current.Action = nil
		end
	end
end

return ProceduralFallback
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="7">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">AnimationConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  AnimationConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/AnimationConfig
	DEPENDENCIES: Shared.Util.TableUtil

	!!! EVERY Id BELOW IS A PLACEHOLDER — NO REAL ANIMATIONS SHIP WITH THIS PROJECT !!!
	Replace "rbxassetid://PLACEHOLDER" with your uploaded R15 animation ids.
	See docs/ASSETS.md for how to author/upload them and which markers to add.

	Until an Id is real, AnimationPlayer:
	  * still fires every marker at the `Markers` times below (so gameplay works),
	  * still fires Ended after `Length` seconds,
	  * optionally plays a tiny procedural arm pose (`Fallback`) on the local
	    character so you can SEE the timing while prototyping.
	When you paste in a real Id nothing else changes: markers come from the
	animation itself (a watchdog still fires any marker the animation forgot).

	Field reference (spec §74):
		Id            rbxassetid:// of the uploaded animation
		Purpose       what gameplay it supports
		Priority      Core | Idle | Movement | Action | Action2 | Action3 | Action4
		Length        seconds (at Speed 1). Used for placeholder timing.
		Looped        loops until stopped
		Markers       { MarkerName = timeInSeconds } — gameplay reacts to these
		MarkerEffects { MarkerName = { Sound = "<SoundConfig id>", VFX = "<VFXConfig id>", Shake = number } }
		BodyParts     which R15 parts the animation should key (documentation for animators)
		Start / End   start + end conditions (documentation)
		Interruptible can a new action cut it off
		Fallback      procedural placeholder pose style (see ProceduralFallback)
		AnimateSlot   (Movement only) { childName, animationName } inside the default Animate script

	Priority rules (spec §73):
		Movement -> Movement | Tool actions -> Action | Building -> Action
		Fishing -> Action2 | Major interactions -> Action2
		Celebration -> Action3 | Death -> Action4
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local PLACEHOLDER = "rbxassetid://PLACEHOLDER"

local ARMS = "RightUpperArm, RightLowerArm, RightHand, LeftUpperArm, LeftLowerArm, LeftHand, UpperTorso"
local FULL_BODY = "All R15 parts"

local function anim(def: { [string]: any })
	def.Id = def.Id or PLACEHOLDER
	def.Priority = def.Priority or "Action"
	def.Length = def.Length or 1
	def.Looped = def.Looped or false
	def.Markers = def.Markers or {}
	def.MarkerEffects = def.MarkerEffects or {}
	if def.Interruptible == nil then
		def.Interruptible = true
	end
	def.FadeIn = def.FadeIn or 0.1
	def.FadeOut = def.FadeOut or 0.15
	def.BodyParts = def.BodyParts or ARMS
	return def
end

local AnimationConfig = {
	-- Show procedural arm poses for placeholder animations (local player only).
	-- Purely a prototyping aid — set false once real animations are in.
	UseProceduralFallback = true,

	-- If a REAL animation is missing a configured marker, fire it anyway this
	-- many seconds after its configured time (and warn once).
	MarkerWatchdogGrace = 0.15,

	Categories = {
		Movement = {
			Idle = anim({ Purpose = "Standing idle", Priority = "Idle", Looped = true, Length = 2, BodyParts = FULL_BODY, AnimateSlot = { "idle", "Animation1" } }),
			Walk = anim({ Purpose = "Walking", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "walk", "WalkAnim" }, Markers = { Footstep = 0.25 } }),
			Run = anim({ Purpose = "Running", Priority = "Movement", Looped = true, Length = 0.8, BodyParts = FULL_BODY, AnimateSlot = { "run", "RunAnim" }, Markers = { Footstep = 0.2 } }),
			Jump = anim({ Purpose = "Jump start", Priority = "Movement", Length = 0.4, BodyParts = FULL_BODY, AnimateSlot = { "jump", "JumpAnim" } }),
			Fall = anim({ Purpose = "Falling", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "fall", "FallAnim" } }),
			Climb = anim({ Purpose = "Climbing", Priority = "Movement", Looped = true, Length = 1, BodyParts = FULL_BODY, AnimateSlot = { "climb", "ClimbAnim" } }),
			Swim = anim({ Purpose = "Swimming", Priority = "Movement", Looped = true, Length = 1.2, BodyParts = FULL_BODY, AnimateSlot = { "swim", "Swim" } }),
			SwimIdle = anim({ Purpose = "Treading water", Priority = "Movement", Looped = true, Length = 2, BodyParts = FULL_BODY, AnimateSlot = { "swimidle", "SwimIdle" } }),
		},

		Tools = {
			ToolHoldIdle = anim({ Purpose = "Generic one-handed tool hold", Looped = true, Length = 2, Fallback = "Hold", Start = "Tool equipped", End = "Tool unequipped" }),
			AxeIdle = anim({ Purpose = "Holding an axe", Looped = true, Length = 2, Fallback = "Hold", Start = "Axe equipped", End = "Axe unequipped" }),
			AxeSwing = anim({
				Purpose = "Chop a tree",
				Length = 0.6,
				Markers = { Hit = 0.3 },
				MarkerEffects = { Hit = { Sound = "AxeSwing" } },
				Fallback = "Swing",
				Start = "UseTool with axe equipped",
				End = "Animation finishes (cooldown = ToolConfig UseCooldown)",
			}),
			AxeHeavySwing = anim({ Purpose = "Final chop / heavy hit", Length = 0.9, Markers = { Hit = 0.5 }, MarkerEffects = { Hit = { Sound = "AxeSwing", Shake = 0.25 } }, Fallback = "HeavySwing" }),
			PickaxeIdle = anim({ Purpose = "Holding a pickaxe", Looped = true, Length = 2, Fallback = "Hold" }),
			PickaxeSwing = anim({ Purpose = "Mine a rock", Length = 0.65, Markers = { Hit = 0.32 }, MarkerEffects = { Hit = { Sound = "PickaxeSwing" } }, Fallback = "Swing" }),
			PickaxeHeavySwing = anim({ Purpose = "Break a rock", Length = 0.95, Markers = { Hit = 0.52 }, MarkerEffects = { Hit = { Sound = "PickaxeSwing", Shake = 0.3 } }, Fallback = "HeavySwing" }),
			ShovelDig = anim({ Purpose = "Dig clay/sand", Length = 0.8, Markers = { Dig = 0.45 }, MarkerEffects = { Dig = { Sound = "ShovelDig", VFX = "DirtPuff" } }, Fallback = "Dig", BodyParts = FULL_BODY }),
			ShovelDigHeavy = anim({ Purpose = "Dig treasure", Length = 1.1, Markers = { Dig = 0.6 }, MarkerEffects = { Dig = { Sound = "ShovelDig", VFX = "DirtPuff" } }, Fallback = "Dig", BodyParts = FULL_BODY }),
			HoeTill = anim({ Purpose = "Till soil", Length = 0.7, Markers = { Till = 0.38 }, MarkerEffects = { Till = { Sound = "HoeTill", VFX = "DirtPuff" } }, Fallback = "Till" }),
			HoeSwing = anim({ Purpose = "Alias swing for hoe", Length = 0.7, Markers = { Till = 0.38 }, Fallback = "Till" }),
			WaterStart = anim({ Purpose = "Raise watering can", Length = 0.3, Fallback = "Pour" }),
			WaterLoop = anim({ Purpose = "Pouring water", Looped = true, Length = 0.8, Markers = { Water = 0.4 }, MarkerEffects = { Water = { VFX = "WaterSplash" } }, Fallback = "Pour" }),
			WaterEnd = anim({ Purpose = "Lower watering can", Length = 0.3, Fallback = "Pour" }),
		},

		Building = {
			BuildIdle = anim({ Purpose = "Holding hammer / build stance", Looped = true, Length = 2, Fallback = "Hold" }),
			-- Spec §74 reference timeline: 0.00 prepare, 0.16 raise, 0.31 HammerHit, 0.35 progress, 0.40 VFX, 0.65 end.
			HammerSwing = anim({
				Purpose = "Advance construction by one step",
				Length = 0.65,
				Markers = { HammerHit = 0.31 },
				MarkerEffects = { HammerHit = { Sound = "HammerHit", VFX = "BuildDust", Shake = 0.1 } },
				Fallback = "Swing",
				Start = "Player hammers a construction site",
				End = "Animation finishes; loop again if still building",
			}),
			HammerHeavy = anim({ Purpose = "Final hammer hit", Length = 0.9, Markers = { HammerHit = 0.5 }, MarkerEffects = { HammerHit = { Sound = "HammerHit", VFX = "BuildDust", Shake = 0.3 } }, Fallback = "HeavySwing" }),
			CarryMaterials = anim({ Purpose = "Carrying planks/stone", Looped = true, Length = 1, Fallback = "Carry" }),
			PlaceWood = anim({ Purpose = "Place a wood piece", Length = 0.7, Markers = { WoodPlace = 0.4 }, MarkerEffects = { WoodPlace = { Sound = "WoodPlace", VFX = "BuildDust" } }, Fallback = "Reach" }),
			PlaceStone = anim({ Purpose = "Place a stone piece", Length = 0.8, Markers = { StonePlace = 0.45 }, MarkerEffects = { StonePlace = { Sound = "StonePlace", VFX = "BuildDust" } }, Fallback = "Reach" }),
			SawWood = anim({ Purpose = "Sawing", Looped = true, Length = 0.6, Markers = { Saw = 0.3 }, MarkerEffects = { Saw = { Sound = "Saw" } }, Fallback = "Dig" }),
			PlantConstruction = anim({ Purpose = "Plant the construction stake", Length = 0.8, Markers = { Effect = 0.45 }, MarkerEffects = { Effect = { Sound = "ConstructionStart", VFX = "BuildDust" } }, Fallback = "Dig" }),
			Paint = anim({ Purpose = "Paint a structure", Looped = true, Length = 0.8, Markers = { Paint = 0.4 }, MarkerEffects = { Paint = { Sound = "Paint" } }, Fallback = "Wave" }),
			BuildFinish = anim({ Purpose = "Last touch on a building", Priority = "Action2", Length = 1, Markers = { BuildFinish = 0.55 }, MarkerEffects = { BuildFinish = { Sound = "BuildComplete", VFX = "BuildComplete", Shake = 0.35 } }, Fallback = "HeavySwing" }),
			CelebrateBuild = anim({ Purpose = "Celebrate a finished build", Priority = "Action3", Length = 1.4, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		Farming = {
			TillGround = anim({ Purpose = "Till a soil tile", Length = 0.7, Markers = { Till = 0.38 }, MarkerEffects = { Till = { Sound = "HoeTill", VFX = "DirtPuff" } }, Fallback = "Till" }),
			PlantSeed = anim({ Purpose = "Plant a seed", Length = 0.9, Markers = { Plant = 0.5 }, MarkerEffects = { Plant = { Sound = "PlantSeed", VFX = "DirtPuff" } }, Fallback = "Reach", BodyParts = FULL_BODY }),
			WaterPlant = anim({ Purpose = "Water a crop", Length = 1.2, Markers = { Water = 0.5 }, MarkerEffects = { Water = { Sound = "Watering", VFX = "WaterSplash" } }, Fallback = "Pour" }),
			HarvestCrop = anim({ Purpose = "Harvest a mature crop", Length = 0.8, Markers = { Pick = 0.42 }, MarkerEffects = { Pick = { Sound = "Harvest", VFX = "LeafBurst" } }, Fallback = "Reach", BodyParts = FULL_BODY }),
			PickCrop = anim({ Purpose = "Pick fruit from a plant", Length = 0.6, Markers = { Pick = 0.3 }, MarkerEffects = { Pick = { Sound = "Harvest", VFX = "LeafBurst" } }, Fallback = "Reach" }),
			CarryBasket = anim({ Purpose = "Carry a harvest basket", Looped = true, Length = 1, Fallback = "Carry" }),
			CelebrateHarvest = anim({ Purpose = "Big harvest celebration", Priority = "Action3", Length = 1.3, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		AnimalCare = {
			FeedAnimal = anim({ Purpose = "Feed an animal", Priority = "Action2", Length = 1, Markers = { Feed = 0.5 }, MarkerEffects = { Feed = { Sound = "Feed", VFX = "Hearts" } }, Fallback = "Reach" }),
			MilkCow = anim({ Purpose = "Milk a cow", Priority = "Action2", Length = 1.6, Markers = { Milk = 0.6 }, MarkerEffects = { Milk = { Sound = "Milk", VFX = "MilkSplash" } }, Fallback = "Dig", BodyParts = FULL_BODY, Interruptible = false }),
			PetAnimal = anim({ Purpose = "Pet an animal", Priority = "Action2", Length = 1.2, Markers = { Pet = 0.5 }, MarkerEffects = { Pet = { Sound = "Pet", VFX = "Hearts" } }, Fallback = "Wave" }),
			CarryBucket = anim({ Purpose = "Carry a bucket", Looped = true, Length = 1, Fallback = "Hold" }),
			FillTrough = anim({ Purpose = "Fill a feeding trough", Priority = "Action2", Length = 1.2, Markers = { Pour = 0.6 }, MarkerEffects = { Pour = { Sound = "Watering" } }, Fallback = "Pour" }),
		},

		Fishing = {
			FishingIdle = anim({ Purpose = "Holding the rod", Priority = "Action", Looped = true, Length = 2, Fallback = "Hold" }),
			FishingCast = anim({ Purpose = "Cast the line", Priority = "Action2", Length = 0.9, Markers = { Cast = 0.45 }, MarkerEffects = { Cast = { Sound = "FishingCast" } }, Fallback = "Cast" }),
			FishingWait = anim({ Purpose = "Waiting for a bite", Priority = "Action2", Looped = true, Length = 3, Fallback = "Hold" }),
			FishingBite = anim({ Purpose = "Rod jerks on a bite", Priority = "Action2", Length = 0.4, Markers = { Splash = 0.1 }, MarkerEffects = { Splash = { Sound = "FishBite", VFX = "WaterSplash" } }, Fallback = "Reel" }),
			FishingReel = anim({ Purpose = "Reeling in", Priority = "Action2", Looped = true, Length = 0.6, Markers = { Reel = 0.3 }, MarkerEffects = { Reel = { Sound = "Reel" } }, Fallback = "Reel" }),
			FishingStruggle = anim({ Purpose = "Fighting a strong fish", Priority = "Action2", Looped = true, Length = 0.8, Fallback = "Reel" }),
			FishingCatch = anim({ Purpose = "Pull the fish out", Priority = "Action2", Length = 1, Markers = { Catch = 0.5 }, MarkerEffects = { Catch = { Sound = "FishCatch", VFX = "WaterSplash" } }, Fallback = "HeavySwing" }),
			FishingFail = anim({ Purpose = "Fish escapes", Priority = "Action2", Length = 0.8, Fallback = "Reach" }),
			FishingCelebrate = anim({ Purpose = "Rare catch celebration", Priority = "Action3", Length = 1.5, BodyParts = FULL_BODY, Fallback = "Cheer" }),
		},

		Crafting = {
			CraftStart = anim({ Purpose = "Begin crafting", Length = 0.5, Fallback = "Reach" }),
			CraftWork = anim({ Purpose = "Crafting loop", Looped = true, Length = 0.7, Markers = { CraftHit = 0.35 }, MarkerEffects = { CraftHit = { Sound = "CraftHit" } }, Fallback = "Swing" }),
			CraftFinish = anim({ Purpose = "Crafting done", Priority = "Action2", Length = 0.8, Markers = { Effect = 0.4 }, MarkerEffects = { Effect = { Sound = "CraftComplete", VFX = "Sparkle" } }, Fallback = "Cheer" }),
		},

		Social = {
			Wave = anim({ Purpose = "Wave", Priority = "Action3", Length = 1.5, Fallback = "Wave" }),
			Cheer = anim({ Purpose = "Cheer", Priority = "Action3", Length = 1.3, BodyParts = FULL_BODY, Fallback = "Cheer" }),
			Celebrate = anim({ Purpose = "Level up / unlock celebration", Priority = "Action3", Length = 1.6, BodyParts = FULL_BODY, Fallback = "Cheer" }),
			Sit = anim({ Purpose = "Sit on benches", Priority = "Action3", Looped = true, Length = 2, BodyParts = FULL_BODY }),
			Point = anim({ Purpose = "Point at something", Priority = "Action3", Length = 1.2, Fallback = "Point" }),
		},

		-- Non-humanoid rigs (AnimationController). Used from Phase 6.
		Cow = {
			CowIdle = anim({ Purpose = "Cow idle", Priority = "Idle", Looped = true, Length = 3, BodyParts = "Cow rig" }),
			CowWalk = anim({ Purpose = "Cow walk", Priority = "Movement", Looped = true, Length = 1.2, BodyParts = "Cow rig" }),
			CowEat = anim({ Purpose = "Cow eating", Looped = true, Length = 2, BodyParts = "Cow rig", Markers = { Chew = 1 } }),
			CowDrink = anim({ Purpose = "Cow drinking", Looped = true, Length = 2, BodyParts = "Cow rig" }),
			CowHappy = anim({ Purpose = "Cow happy hop", Priority = "Action2", Length = 1.2, BodyParts = "Cow rig" }),
			CowSleep = anim({ Purpose = "Cow sleeping", Priority = "Idle", Looped = true, Length = 4, BodyParts = "Cow rig" }),
			CowMilk = anim({ Purpose = "Cow being milked", Priority = "Action2", Length = 1.6, BodyParts = "Cow rig" }),
			CowHitReaction = anim({ Purpose = "Cow startled", Priority = "Action2", Length = 0.6, BodyParts = "Cow rig" }),
			CowInteract = anim({ Purpose = "Cow looks at player", Priority = "Action", Length = 1.2, BodyParts = "Cow rig" }),
		},
	},

	-- Built below: flat lookup { [AnimationName] = def } (names must be unique).
	Index = {} :: { [string]: any },
}

for categoryName, entries in AnimationConfig.Categories do
	for name, def in entries do
		assert(AnimationConfig.Index[name] == nil, "Duplicate animation name: " .. name)
		def.Name = name
		def.Category = categoryName
		AnimationConfig.Index[name] = def
	end
end

function AnimationConfig.Get(name: string)
	return AnimationConfig.Index[name]
end

return TableUtil.DeepFreeze(AnimationConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  EconomyConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/EconomyConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Currencies and global economy knobs. Item base prices live on the item
	definitions (ResourceConfig / CropConfig / FishConfig ...), never here and
	never inside scripts.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local EconomyConfig = {
	Currencies = {
		Coins = { DisplayName = "Island Coins", Icon = "🪙", Max = 1e12, Color = Color3.fromRGB(255, 200, 40) },
		Gems = { DisplayName = "Gems", Icon = "💎", Max = 1e9, Color = Color3.fromRGB(90, 200, 255) },
	},

	-- Multiplier applied to every sale (Phase 7 market events adjust per item).
	GlobalSellMultiplier = 1,
}

return TableUtil.DeepFreeze(EconomyConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  GameConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/GameConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Global game settings. Anything a designer might want to tune lives in a
	Config module — never hard-code these values inside services/controllers.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local GameConfig = {
	GameName = "Build Your Island",
	Version = "0.1.0 (Phase 1 - Island Core)",

	-- Turn OFF before publishing. Enables verbose logs + /debug output.
	Debug = true,

	StartingCoins = 100,
	StartingGems = 0,
	StartingIslandLevel = 1,
	AutosaveInterval = 60, -- seconds between autosave sweeps (only dirty profiles are written)
	BuildGridSize = 2, -- used by BuildService (Phase 3)
	MaxIslandsPerServer = 8, -- keep >= Players.MaxPlayers in Game Settings

	Character = {
		RequireR15 = true,
		-- If a non-R15 character spawns (Game Settings not set to R15), rebuild it
		-- as R15 from the player's HumanoidDescription. Game Settings > Avatar >
		-- R15 is still the recommended primary setup.
		ForceR15 = true,
		RespawnDelay = 3,
		WalkSpeed = 16,
		JumpHeight = 7.2,
	},

	Camera = {
		MinZoom = 6,
		MaxZoom = 70,
		DefaultFieldOfView = 70,
		MaxShakeIntensity = 1.2, -- hard cap so shakes never become unpleasant
	},

	Inventory = {
		StartingCapacity = 200, -- total resource units the backpack holds
		MaxStack = 9999,
	},

	Data = {
		StoreName = "BuildYourIsland_PlayerData_v1",
		KeyPrefix = "Player_",
		-- "Auto": use the real DataStore, but fall back to an in-memory mock in
		-- Studio when API access is disabled. true = always mock. false = never.
		UseMockDataStore = "Auto",
		LoadAttempts = 5,
		SaveAttempts = 4,
		RetryBaseDelay = 1, -- exponential backoff base (seconds)
		SessionLockTimeout = 1800, -- a lock older than this is considered dead
		LockRetryDelay = 6,
		LockRetries = 5, -- after this many waits the lock is taken over
		StudioStealLocks = true, -- Studio sessions are single-player; don't wait on stale locks
		KickOnLoadFailure = true,
		ShutdownSaveTimeout = 25,
		SizeWarningBytes = 3_500_000,
	},

	AntiExploit = {
		StrikeWindow = 60, -- seconds strikes are remembered for
		WarnStrikes = 10,
		KickStrikes = 40,
		KickEnabled = true,
		MovementCheckInterval = 1,
		MaxSpeedMultiplier = 1.75, -- x WalkSpeed before a movement strike
		MovementSlack = 12, -- studs/sec extra allowance (knockback, slopes, lag)
		TeleportGrace = 3, -- seconds after a server teleport that movement is not checked
		LargeCurrencyGain = 1_000_000, -- single gains above this are logged for review
	},

	-- UserIds allowed to run admin chat commands (see AdminService).
	AdminUserIds = {} :: { number },
	AdminsInStudio = true,

	-- What the Starter Chest on every new island contains.
	StarterKit = {
		Coins = 50,
		Items = { Wood = 10, Stone = 5, Fiber = 5 },
		Tools = { "WoodenAxe", "WoodenPickaxe", "WoodenHammer" },
	},

	-- Lighting / world presentation (WorldService applies these).
	World = {
		ClockTime = 14.5,
		Brightness = 2.2,
		Ambient = Color3.fromRGB(110, 110, 125),
		OutdoorAmbient = Color3.fromRGB(150, 150, 165),
		EnvironmentDiffuseScale = 1,
		EnvironmentSpecularScale = 1,
		Atmosphere = {
			Density = 0.28,
			Offset = 0.1,
			Color = Color3.fromRGB(199, 225, 255),
			Decay = Color3.fromRGB(120, 160, 200),
			Glare = 0.15,
			Haze = 1.2,
		},
		WaterColor = Color3.fromRGB(40, 170, 200),
		WaterTransparency = 0.6,
		WaterReflectance = 0.25,
		WaterWaveSize = 0.12,
		WaterWaveSpeed = 8,
		MaterialColors = {
			Grass = Color3.fromRGB(106, 190, 72),
			LeafyGrass = Color3.fromRGB(92, 170, 60),
			Sand = Color3.fromRGB(240, 220, 160),
			Rock = Color3.fromRGB(128, 124, 118),
			Ground = Color3.fromRGB(140, 105, 70),
		},
		OceanDepth = 18,
		SeabedThickness = 8,
		OceanMargin = 600,
		OceanTileSize = 512,
	},
}

return TableUtil.DeepFreeze(GameConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">InputConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InputConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/InputConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Maps abstract ACTIONS to physical inputs for keyboard/mouse and gamepad.
	Touch devices trigger the same actions through on-screen buttons that call
	InputController.Trigger(actionName). Gameplay code only ever listens to
	actions, never to raw keys — that is what keeps mobile/console support free.

	Note: the ProximityPrompt interact key is E (Roblox default). Build mode
	(Phase 3) disables prompts while active so Q/E can rotate.
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local InputConfig = {
	Actions = {
		UseTool = {
			Inputs = { Enum.UserInputType.MouseButton1 },
			Gamepad = { Enum.KeyCode.ButtonR2 },
		},
		ToggleInventory = {
			Inputs = { Enum.KeyCode.B, Enum.KeyCode.I },
			Gamepad = { Enum.KeyCode.ButtonY },
		},
		Cancel = {
			Inputs = { Enum.KeyCode.X },
			Gamepad = { Enum.KeyCode.ButtonB },
		},
		HotbarNext = { Inputs = {}, Gamepad = { Enum.KeyCode.ButtonR1 } },
		HotbarPrevious = { Inputs = {}, Gamepad = { Enum.KeyCode.ButtonL1 } },
		Hotbar1 = { Inputs = { Enum.KeyCode.One }, Gamepad = {} },
		Hotbar2 = { Inputs = { Enum.KeyCode.Two }, Gamepad = {} },
		Hotbar3 = { Inputs = { Enum.KeyCode.Three }, Gamepad = {} },
		Hotbar4 = { Inputs = { Enum.KeyCode.Four }, Gamepad = {} },
		Hotbar5 = { Inputs = { Enum.KeyCode.Five }, Gamepad = {} },
		Hotbar6 = { Inputs = { Enum.KeyCode.Six }, Gamepad = {} },
		-- Reserved for Build Mode (Phase 3); declared now so names never change.
		RotateBuild = { Inputs = { Enum.KeyCode.R }, Gamepad = { Enum.KeyCode.ButtonX } },
		RotateBuildLeft = { Inputs = { Enum.KeyCode.Q }, Gamepad = {} },
		RotateBuildRight = { Inputs = { Enum.KeyCode.E }, Gamepad = {} },
	},

	-- Minimum on-screen button size for touch (Roblox recommends >= 44px).
	MinTouchButtonSize = 64,
}

return TableUtil.DeepFreeze(InputConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">IslandConfig</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandConfig
	SCRIPT TYPE:  ModuleScript (shared config)
	WHERE:        ReplicatedStorage/Shared/Config/IslandConfig
	DEPENDENCIES: Shared.Util.TableUtil

	Island geometry, server slots, starter layout and expansion areas.

	COORDINATES: everything here is ISLAND-LOCAL. (0, 0) is the centre of the
	starter island at sea level. +Z is the "front" of the island (spawn + dock
	side, always open ocean). Saved building/crop/animal positions are also
	island-local, so an island can load into any slot on any server.

	EXPANSION AREAS are circular land lobes attached to the starter island.
	`Angle` is measured in degrees from +Z towards +X. A locked area shows an
	underwater sandbar and a 🔒 sign on the starter shore; unlocking it raises
	the land (IslandService.TryUnlockArea).
]]

local TableUtil = require(script.Parent.Parent.Util.TableUtil)

local IslandConfig = {
	SeaLevel = 0,
	SurfaceHeight = 6, -- grass height above sea level
	BeachHeight = 3,
	ShallowsHeight = 1.5,
	BeachWidth = 6,
	ShallowsWidth = 14,
	SandbarDepth = 4, -- how far below the surface a locked area's sandbar sits
	LandDepth = 24, -- how deep island terrain extends below sea level

	-- Server slot grid. Islands are SlotSpacing studs apart so they never touch.
	SlotSpacing = 1000,
	SlotsPerRow = 4,

	BuildMargin = 4, -- keep builds this far inside area edges
	DefaultNameFormat = "%s's Island",
	NameMaxLength = 24,
	DefaultTheme = "Tropical",

	-- Order matters: it is the unlock progression shown in the UI.
	AreaOrder = { "Starter", "Forest", "Farm", "River", "Beach", "Mountain", "StarfallCove", "Mainland" },

	Areas = {
		Starter = {
			DisplayName = "Starter Island",
			Angle = 0,
			Distance = 0,
			Radius = 70,
			Biome = "Meadow",
			Unlock = nil,
			Reward = "Your home. Trees, rocks, a farm plot and a dock to fish from.",
		},
		Forest = {
			DisplayName = "Whispering Forest",
			Angle = 300,
			Distance = 112,
			Radius = 55,
			Biome = "Forest",
			Unlock = { Coins = 500, IslandLevel = 2 },
			Reward = "Dense woods: hardwood trees, fiber bushes and berries.",
		},
		Farm = {
			DisplayName = "Sunny Fields",
			Angle = 60,
			Distance = 112,
			Radius = 55,
			Biome = "Meadow",
			Unlock = { Coins = 1500, IslandLevel = 4, RequiresArea = "Forest" },
			Reward = "Wide flat fields for big farms and animal pastures.",
		},
		River = {
			DisplayName = "Willow River",
			Angle = 100,
			Distance = 115,
			Radius = 55,
			Biome = "River",
			Unlock = { Coins = 4000, IslandLevel = 7, RequiresArea = "Farm" },
			Reward = "Better fishing, riverbank clay and water pumps.",
		},
		Beach = {
			DisplayName = "Coral Beach",
			Angle = 260,
			Distance = 115,
			Radius = 55,
			Biome = "Beach",
			Unlock = { Coins = 8000, IslandLevel = 10, RequiresArea = "River" },
			Reward = "Ocean fishing, sand, shells and rare fish.",
		},
		Mountain = {
			DisplayName = "Stonepeak Mountain",
			Angle = 220,
			Distance = 120,
			Radius = 62,
			Biome = "Mountain",
			Unlock = { Coins = 15000, IslandLevel = 14, RequiresArea = "Beach" },
			Reward = "Stone, iron and copper ore — the key to better tools.",
		},
		StarfallCove = {
			DisplayName = "Starfall Cove",
			Angle = 140,
			Distance = 120,
