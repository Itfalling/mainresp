              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InputController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/InputController
	DEPENDENCIES: Shared.Config.InputConfig, Shared.Util.Signal

	Turns raw input into named ACTIONS (see InputConfig). Keyboard, mouse and
	gamepad are mapped here; touch UI buttons call InputController.Trigger().
	Gameplay controllers only ever listen with InputController.On(action, fn),
	which is what makes every feature work on desktop, mobile and console.

	Also tracks the active device ("KeyboardMouse" | "Touch" | "Gamepad") so
	the UI can show touch buttons only when needed.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local InputConfig = require(Shared:WaitForChild("Config"):WaitForChild("InputConfig"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))

local InputController = {}

InputController.DeviceChanged = Signal.new() -- (deviceType)

local actionSignals: { [string]: any } = {}
local held: { [string]: number } = {} -- action -> number of inputs holding it
local bindings: { [any]: { string } } = {} -- KeyCode/UserInputType -> actions
local device = "KeyboardMouse"
local blocked: { [string]: number } = {} -- action -> block count

local function signalFor(action: string)
	local signal = actionSignals[action]
	if not signal then
		assert(InputConfig.Actions[action], "Unknown input action " .. action)
		signal = Signal.new()
		actionSignals[action] = signal
	end
	return signal
end

local function bind(input: any, action: string)
	local list = bindings[input]
	if not list then
		list = {}
		bindings[input] = list
	end
	table.insert(list, action)
end

local function classify(inputType: Enum.UserInputType): string?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.find(inputType.Name, "Gamepad") then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Keyboard or string.find(inputType.Name, "Mouse") then
		return "KeyboardMouse"
	end
	return nil
end

local function setDevice(newDevice: string)
	if newDevice ~= device then
		device = newDevice
		InputController.DeviceChanged:Fire(device)
	end
end

function InputController.On(action: string, callback: () -> ())
	return signalFor(action):Connect(callback)
end

function InputController.Trigger(action: string)
	if (blocked[action] or 0) > 0 then
		return
	end
	signalFor(action):Fire()
end

-- Temporarily block an action (e.g. UseTool while a menu is open). Returns an unblock function.
function InputController.Block(action: string): () -> ()
	blocked[action] = (blocked[action] or 0) + 1
	local released = false
	return function()
		if not released then
			released = true
			blocked[action] = math.max(0, (blocked[action] or 1) - 1)
		end
	end
end

-- True while an input bound to the action is held down (used by the fishing reel).
function InputController.IsHeld(action: string): boolean
	return (held[action] or 0) > 0
end

-- Touch buttons report press/release through this.
function InputController.SetHeld(action: string, isHeld: boolean)
	held[action] = math.max(0, (held[action] or 0) + (if isHeld then 1 else -1))
	if not isHeld and held[action] == 0 then
		held[action] = nil
	end
end

function InputController.GetDevice(): string
	return device
end

function InputController.IsTouch(): boolean
	return device == "Touch"
end

function InputController.Init()
	for action, def in InputConfig.Actions do
		signalFor(action)
		for _, input in def.Inputs do
			bind(input, action)
		end
		for _, input in def.Gamepad do
			bind(input, action)
		end
	end

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		device = "Touch"
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		device = "Gamepad"
	end
end

function InputController.Start()
	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		local newDevice = classify(inputType)
		if newDevice then
			setDevice(newDevice)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return -- typing in chat, clicking a GUI button, a text box...
		end
		-- Keys/buttons bind by KeyCode; mouse buttons bind by UserInputType.
		local actions = bindings[input.KeyCode] or bindings[input.UserInputType]
		if actions then
			for _, action in actions do
				InputController.SetHeld(action, true)
				InputController.Trigger(action)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local actions = bindings[input.KeyCode] or bindings[input.UserInputType]
		if actions then
			for _, action in actions do
				if (held[action] or 0) > 0 then
					InputController.SetHeld(action, false)
				end
			end
		end
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">InteractionController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InteractionController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/InteractionController
	DEPENDENCIES: Shared.Net, Shared.Config.{ResourceConfig, AnimalConfig, CropConfig, AnimationConfig},
	              Shared.Util.R15, InputController, UIController, ToolController, AnimationController,
	              AudioController, Client.UI.{Components, Theme}

	CLICK-TO-INTERACT. No prompts: hold a tool or item and click the thing.

	  HOVER    the object under your mouse (or the centre of the screen on a
	           gamepad) gets an OUTLINE and a small tooltip next to the cursor:
	             green  "🪓 Chop · Oak Tree"            you can do it now
	             yellow "Hold your 🪓 Axe (press 1)"     you need something
	             red    "Owner only"                    not allowed here
	  CLICK    (mouse / R2 / E / tap / USE button) on the hovered object:
	           too far? your character WALKS over and then does it.
	           Your animation starts instantly (predicted) and the request
	           goes to the server (InteractRequest), which checks everything
	           and plays it for everyone.
	  NOTHING  under the cursor with a tool in hand = a practice swing.

	Other controllers can claim clicks first with SetClickHandler (fishing:
	click the water to cast; build mode pauses everything).
	Objects are found by the "Interactable" tag the server puts on them.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ResourceConfig = require(Shared.Config.ResourceConfig)
local AnimalConfig = require(Shared.Config.AnimalConfig)
local CropConfig = require(Shared.Config.CropConfig)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local ToolController = require(script.Parent.ToolController)
local AnimationController = require(script.Parent.AnimationController)
local AudioController = require(script.Parent.AudioController)
local VFXController = require(script.Parent.VFXController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local TAG = "Interactable"
local RAY_LENGTH = 320
local WALK_TIMEOUT = 5
local VISITOR_PERMISSIONS = { Visitor = true, Fish = true, Market = true }
local SWING_TYPES = { Axe = true, Pickaxe = true, Hammer = true, Hoe = true, Shovel = true, WateringCan = true, Bucket = true, Shears = true }
local TOOL_KEYS = { Axe = "🪓 Axe", Pickaxe = "⛏️ Pickaxe", Hammer = "🔨 Hammer", Hoe = "🌱 Hoe", Shovel = "🪏 Shovel", WateringCan = "🚿 Watering Can", FishingRod = "🎣 Fishing Rod", Bucket = "🪣 Bucket" }

local COLORS = {
	Ok = Color3.fromRGB(110, 240, 130),
	Need = Color3.fromRGB(255, 214, 90),
	Blocked = Color3.fromRGB(255, 100, 90),
	Neutral = Color3.fromRGB(255, 250, 230),
}

export type Target = { Object: Instance?, Position: Vector3, Water: boolean }
export type Hint = { Text: string, State: string, Anim: string?, Speed: number? }

local InteractionController = {}

local highlight: Highlight
local tooltip: Frame
local tooltipText: TextLabel
local tooltipSub: TextLabel
local reticle: Frame
local pauseCount = 0
local hover: Target? = nil
local clickHandlers: { (Target?) -> boolean } = {}
local localBusyUntil = 0
local lastSwing = 0
local walkThread: thread? = nil

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = false

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

local function rootPart(): BasePart?
	return R15.GetRootPart(player.Character)
end

local function interactableOf(instance: Instance?): Instance?
	local current = instance
	for _ = 1, 8 do
		if not current or current == workspace then
			return nil
		end
		if CollectionService:HasTag(current, TAG) then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function boxOf(object: Instance): (CFrame?, Vector3?)
	if object:IsA("Model") then
		return object:GetBoundingBox()
	elseif object:IsA("BasePart") then
		return object.CFrame, object.Size
	end
	return nil, nil
end

local function distanceTo(object: Instance, point: Vector3): number
	local cframe, size = boxOf(object)
	if not cframe or not size then
		return math.huge
	end
	local relative = cframe:PointToObjectSpace(point)
	local half = size / 2
	local clamped = Vector3.new(math.clamp(relative.X, -half.X, half.X), math.clamp(relative.Y, -half.Y, half.Y), math.clamp(relative.Z, -half.Z, half.Z))
	return (relative - clamped).Magnitude
end

local function objectPosition(object: Instance): Vector3
	local cframe = boxOf(object)
	return if cframe then cframe.Position else Vector3.zero
end

local function islandOf(object: Instance): Instance?
	local islands = workspace:FindFirstChild("Islands")
	local current: Instance? = object
	while current and current ~= workspace do
		if current.Parent == islands then
			return current
		end
		current = current.Parent
	end
	return nil
end

-- Mirrors the server's permission rule, for the tooltip only (the server decides).
local function allowed(object: Instance): boolean
	local permission = object:GetAttribute("InteractPermission")
	if permission == nil or VISITOR_PERMISSIONS[permission] then
		return true
	end
	local owner = object:GetAttribute("OwnerUserId")
	if owner == nil or owner == player.UserId then
		return true
	end
	if permission == "Owner" then
		return false
	end
	local island = islandOf(object)
	local helpers = island and island:GetAttribute("Helpers")
	return type(helpers) == "string" and string.find("," .. helpers .. ",", "," .. player.UserId .. ",", 1, true) ~= nil
end

local function toolName(toolType: string): string
	return TOOL_KEYS[toolType] or toolType
end

---------------------------------------------------------------------------
-- What will a click do? (tooltip + predicted animation)
---------------------------------------------------------------------------

local HINTS: { [string]: (Instance, ToolController.Held?) -> Hint } = {}

HINTS.ResourceNode = function(object, held)
	local def = ResourceConfig.Nodes[object:GetAttribute("NodeType") or ""]
	local label = object:GetAttribute("InteractLabel") or "Resource"
	if not def then
		return { Text = label, State = "Neutral" }
	end
	if not def.ToolType then
		return { Text = ("✋ %s · %s"):format(def.Action, label), State = "Ok", Anim = def.Animation or "PickCrop" }
	end
	local tool = held and held.Kind == "Tool" and held.Def
	if not tool or tool.Type ~= def.ToolType then
		return { Text = ("Hold your %s to %s"):format(toolName(def.ToolType), string.lower(def.Action)), State = "Need" }
	end
	if tool.TierOrder < def.MinTier then
		return { Text = ("Needs a better %s"):format(def.ToolType), State = "Blocked" }
	end
	return { Text = ("%s %s · %s"):format(tool.Icon, def.Action, label), State = "Ok", Anim = tool.Animations.Use, Speed = tool.Speed }
end

HINTS.ConstructionSite = function(object, held)
	local tool = held and held.Kind == "Tool" and held.Def
	if tool and tool.Type == "Hammer" then
		return { Text = "🔨 Build · " .. tostring(object:GetAttribute("InteractLabel") or ""), State = "Ok", Anim = "HammerSwing", Speed = tool.Speed }
	end
	return { Text = "Hold your 🔨 Hammer to build", State = "Need" }
end

HINTS.FarmTile = function(object, held)
	local hint = object:GetAttribute("InteractHint")
	local tool = held and held.Kind == "Tool" and held.Def
	local cropId = object:GetAttribute("CropId")
	local crop = type(cropId) == "string" and CropConfig.Crops[cropId]
	if hint == "Till" then
		if tool and tool.Type == "Hoe" then
			return { Text = "🌱 Till soil", State = "Ok", Anim = tool.Animations.Use, Speed = tool.Speed }
		end
		return { Text = "Hold your 🌱 Hoe to till", State = "Need" }
	elseif hint == "Plant" then
		local seedCrop = held and held.Kind == "Item" and CropConfig.SeedToCrop[held.Id]
		if seedCrop then
			return { Text = ("%s Plant %s"):format(held and held.Def.Icon or "", CropConfig.Crops[seedCrop].DisplayName), State = "Ok", Anim = "PlantSeed" }
		end
		return { Text = "Hold a seed sack to plant", State = "Need" }
	elseif hint == "Harvest" then
		return { Text = ("✨ Harvest %s"):format(if crop then crop.DisplayName else ""), State = "Ok", Anim = "HarvestCrop" }
	elseif hint == "Water" then
		if tool and tool.Type == "WateringCan" then
			return { Text = "🚿 Water " .. (if crop then crop.DisplayName else "crop"), State = "Ok", Anim = "WaterPlant", Speed = tool.Speed }
		end
		return { Text = (if crop then crop.Icon .. " " .. crop.DisplayName else "Crop") .. " · hold 🚿 to water", State = "Neutral" }
	end
	return { Text = (if crop then crop.Icon .. " " .. crop.DisplayName else "Crop") .. " · growing", State = "Neutral" }
end

HINTS.Animal = function(object, held)
	local def = AnimalConfig.Animals[object:GetAttribute("AnimalId") or ""]
	if not def then
		return { Text = "Animal", State = "Neutral" }
	end
	local status = object:GetAttribute("Status")
	local tool = held and held.Kind == "Tool" and held.Def
	if status == "Ready" then
		if def.ProduceTool and not (tool and tool.Type == def.ProduceTool) then
			return { Text = ("Hold your %s to collect %s"):format(toolName(def.ProduceTool), def.Produce), State = "Need" }
		end
		return { Text = "✨ " .. def.ProduceVerb, State = "Ok", Anim = def.ProduceAnimation }
	end
	if status == "Hungry" then
		if held and held.Id == def.Food then
			return { Text = ("%s Feed %s"):format(held.Def.Icon, def.DisplayName), State = "Ok", Anim = "FeedAnimal" }
		end
		return { Text = ("Hungry! Hold %s to feed · click to pet"):format(def.Food), State = "Need", Anim = "PetAnimal" }
	end
	return { Text = "💕 Pet " .. def.DisplayName, State = "Ok", Anim = "PetAnimal" }
end

HINTS.Market = function()
	return { Text = "🛒 Open the market", State = "Ok" }
end

HINTS.MerchantTalk = function()
	return { Text = "💬 Talk to Mia", State = "Ok" }
end

HINTS.StarterChest = function()
	return { Text = "📦 Open your starter chest", State = "Ok", Anim = "OpenChest" }
end

HINTS.IslandSign = function(object)
	local owner = object:GetAttribute("OwnerUserId")
	return { Text = if owner == player.UserId then "✏️ Island settings" else "🏝️ Island info · ❤️ like", State = "Ok" }
end

local function hintFor(object: Instance): Hint
	if object:GetAttribute("InteractDisabled") then
		return { Text = "", State = "Hidden" }
	end
	if not allowed(object) then
		local permission = object:GetAttribute("InteractPermission")
		return { Text = if permission == "Owner" then "🔒 Owner only" else "🔒 Ask the owner to make you a helper", State = "Blocked" }
	end
	local kind = object:GetAttribute("Interact")
	local builder = type(kind) == "string" and HINTS[kind]
	if builder then
		return builder(object, ToolController.GetHeld())
	end
	return { Text = tostring(object:GetAttribute("InteractLabel") or ""), State = "Ok" }
end

---------------------------------------------------------------------------
-- Hover
---------------------------------------------------------------------------

local function screenRay(point: Vector2?): Ray?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	if point then
		return camera:ViewportPointToRay(point.X, point.Y)
	end
	if InputController.GetDevice() == "Gamepad" then
		local size = camera.ViewportSize
		return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
	end
	local mouse = UserInputService:GetMouseLocation()
	return camera:ViewportPointToRay(mouse.X, mouse.Y)
end

local function castTarget(point: Vector2?): Target?
	local ray = screenRay(point)
	if not ray then
		return nil
	end
	local exclude: { Instance } = {}
	if player.Character then
		table.insert(exclude, player.Character)
	end
	for _, name in { "ClientEffects", "ClientAudio" } do
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	local camera = workspace.CurrentCamera
	if camera then
		table.insert(exclude, camera)
	end
	rayParams.FilterDescendantsInstances = exclude
	local hit = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, rayParams)
	if not hit then
		return nil
	end
	local object = interactableOf(hit.Instance)
	return { Object = object, Position = hit.Position, Water = hit.Material == Enum.Material.Water }
end

local function setHighlight(object: Instance?, color: Color3)
	if object and (object:IsA("Model") or object:IsA("BasePart")) then
		if highlight.Adornee ~= object then
			-- A tiny cartoon "boing" + outline flash when something new is under the cursor.
			if object:IsA("Model") then
				VFXController.Jiggle(object, "Nudge")
			end
			highlight.OutlineTransparency = 0
			highlight.FillTransparency = 0.6
			Components.Bounce(tooltip, 0.18)
			TweenService:Create(highlight, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { FillTransparency = 0.86 }):Play()
		end
		highlight.Adornee = object
		highlight.OutlineColor = color
		highlight.FillColor = color
		highlight.Enabled = true
	else
		highlight.Enabled = false
		highlight.Adornee = nil
	end
end

local function showTooltip(hint: Hint?, position: Vector2?)
	if not hint or hint.Text == "" or hint.State == "Hidden" then
		tooltip.Visible = false
		return
	end
	tooltipText.Text = hint.Text
	local color = COLORS[hint.State] or COLORS.Neutral
	tooltip.BackgroundColor3 = Theme.Colors.Glass
	local stroke = tooltip:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
	tooltipText.TextColor3 = color
	local root = rootPart()
	local object = hover and hover.Object
	local range = object and tonumber(object:GetAttribute("InteractRange"))
	if object and root and range and distanceTo(object, root.Position) > range + 1 and hint.State == "Ok" then
		tooltipSub.Text = if InputController.IsTouch() then "tap to walk there" else "click to walk there"
	else
		tooltipSub.Text = ""
	end
	tooltipSub.Visible = tooltipSub.Text ~= ""
	tooltip.Size = UDim2.fromOffset(math.max(tooltipText.TextBounds.X, tooltipSub.TextBounds.X) + 26, if tooltipSub.Visible then 50 else 32)
	if position then
		tooltip.Position = UDim2.fromOffset(position.X + 20, position.Y + 16)
	end
	tooltip.Visible = true
end

local function updateHover()
	if pauseCount > 0 or UIController.IsAnyModalOpen() or InputController.IsTouch() then
		hover = nil

		setHighlight(nil, COLORS.Ok)
		showTooltip(nil, nil)
		reticle.Visible = false
		return
	end
	local gamepad = InputController.GetDevice() == "Gamepad"
	reticle.Visible = gamepad
	local target = castTarget(nil)
	hover = target
	local object = target and target.Object
	if object then
		local hint = hintFor(object)

		setHighlight(if hint.State == "Hidden" then nil else object, COLORS[hint.State] or COLORS.Neutral)
		local mouse = if gamepad
			then (workspace.CurrentCamera :: Camera).ViewportSize / 2
			else UserInputService:GetMouseLocation()
		showTooltip(hint, UIController.ViewportToDesign(mouse))
	else

		setHighlight(nil, COLORS.Ok)
		-- Holding a rod over water shows where you'd cast.
		local held = ToolController.GetHeld()
		if target and target.Water and held and held.Kind == "Tool" and held.Def.Type == "FishingRod" then
			local mouse = if gamepad then (workspace.CurrentCamera :: Camera).ViewportSize / 2 else UserInputService:GetMouseLocation()
			showTooltip({ Text = "🎣 Cast here", State = "Ok" }, UIController.ViewportToDesign(mouse))
		else
			showTooltip(nil, nil)
		end
	end
end

---------------------------------------------------------------------------
-- Clicking
---------------------------------------------------------------------------

local function faceTarget(position: Vector3)
	local root = rootPart()
	if not root then
		return
	end
	local flat = Vector3.new(position.X, root.Position.Y, position.Z)
	if (flat - root.Position).Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, flat)
	end
end

local function perform(object: Instance, hint: Hint)
	faceTarget(objectPosition(object))
	local now = os.clock()
	local variant = nil
	if hint.Anim and now >= localBusyUntil then
		local name, index = AnimationController.PickVariant(hint.Anim)
		local def = AnimationConfig.Get(name)
		if def then
			local speed = hint.Speed or 1
			localBusyUntil = now + def.Length / speed * 0.85
			AnimationController.PlayLocal(name, speed)
			variant = index
		end
	end
	Net.FireServer("InteractRequest", object, variant)
	-- Instant local feedback on the thing you clicked.
	VFXController.Play("HitRing", objectPosition(object) + Vector3.new(0, 0.5, 0), { Scale = 0.6, Color = COLORS.Ok })
end

local function cancelWalk()
	if walkThread then
		pcall(task.cancel, walkThread)
		walkThread = nil
	end
end

-- Walks up to an object, then interacts (unless you move away / it disappears).
local function walkThenPerform(object: Instance, hint: Hint)
	cancelWalk()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = rootPart()
	if not humanoid or not root then
		return
	end
	local range = tonumber(object:GetAttribute("InteractRange")) or 8
	walkThread = task.spawn(function()
		local started = os.clock()
		while os.clock() - started < WALK_TIMEOUT do
			if not object.Parent or not root.Parent then
				break
			end
			local distance = distanceTo(object, root.Position)
			if distance <= range - 0.5 then
				humanoid:Move(Vector3.zero)
				perform(object, hintFor(object))
				break
			end
			local goal = objectPosition(object)
			humanoid:MoveTo(Vector3.new(goal.X, root.Position.Y, goal.Z))
			task.wait(0.1)
		end
		walkThread = nil
	end)
end

local function practiceSwing()
	local held = ToolController.GetHeld()
	local tool = held and held.Kind == "Tool" and held.Def
	if not tool or not SWING_TYPES[tool.Type] then
		return
	end
	local now = os.clock()
	if now - lastSwing < tool.UseCooldown or now < localBusyUntil then
		return
	end
	lastSwing = now
	local name, index = AnimationController.PickVariant(tool.Animations.Use)
	local def = AnimationConfig.Get(name)
	if def then
		localBusyUntil = now + def.Length / tool.Speed * 0.7
		AnimationController.PlayLocal(name, tool.Speed)
		Net.FireServer("SwingRequest", index)
	end
end

-- Nearest interactable in front of you (touch USE button / keyboard E with no hover).
local function autoTarget(): Instance?
	local root = rootPart()
	if not root then
		return nil
	end
	local best, bestScore = nil, math.huge
	for _, object in CollectionService:GetTagged(TAG) do
		if not object:GetAttribute("InteractDisabled") then
			local position = objectPosition(object)
			local offset = Vector3.new(position.X - root.Position.X, 0, position.Z - root.Position.Z)
			local distance = distanceTo(object, root.Position)
			local range = tonumber(object:GetAttribute("InteractRange")) or 8
			local facing = if offset.Magnitude > 0.1 then root.CFrame.LookVector:Dot(offset.Unit) else 1
			if distance <= range and facing > -0.3 then
				local score = distance - facing * 4
				if score < bestScore then
					best, bestScore = object, score
				end
			end
		end
	end
	return best
end

local function click(target: Target?)
	if pauseCount > 0 or UIController.IsAnyModalOpen() then
		return
	end
	for _, handler in clickHandlers do
		if handler(target) then
			return
		end
	end
	local object = target and target.Object
	if not object then
		practiceSwing()
		return
	end
	local hint = hintFor(object)
	if hint.State == "Hidden" then
		return
	end
	if hint.State == "Blocked" or (hint.State == "Need" and not hint.Anim) then
		AudioController.Play("UIError")
		UIController.Notify("Error", hint.Text)
		return
	end
	local root = rootPart()
	local range = tonumber(object:GetAttribute("InteractRange")) or 8
	if root and distanceTo(object, root.Position) > range then
		walkThenPerform(object, hint)
		return
	end
	cancelWalk()
	perform(object, hint)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

-- Pause all interaction (menus, build mode). Returns a resume function.
function InteractionController.PausePrompts(): () -> ()
	pauseCount += 1
	local resumed = false
	return function()
		if resumed then
			return
		end
		resumed = true
		pauseCount = math.max(0, pauseCount - 1)
	end
end

function InteractionController.IsPaused(): boolean
	return pauseCount > 0
end

-- handler(target) returns true if it consumed the click. Checked in order added.
function InteractionController.SetClickHandler(handler: (Target?) -> boolean)
	table.insert(clickHandlers, handler)
end

function InteractionController.GetHover(): Target?
	return hover
end

-- A target at a screen point (touch taps).
function InteractionController.TargetAt(point: Vector2): Target?
	return castTarget(point)
end

function InteractionController.Init()
	highlight = Instance.new("Highlight")
	highlight.Name = "InteractHighlight"
	highlight.FillTransparency = 0.86
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = workspace.CurrentCamera

	local overlay = UIController.GetOverlay()
	tooltip = Create("Frame", {
		Name = "HoverTooltip",
		Size = UDim2.fromOffset(200, 32),
		BackgroundColor3 = Theme.Colors.Glass,
		BackgroundTransparency = 0.18,
		Visible = false,
		ZIndex = 50,
		Parent = overlay,
	})
	Components.Corner(tooltip, UDim.new(0, 12))
	Components.Stroke(tooltip, COLORS.Ok, 3)
	tooltipText = Components.Label({
		Size = UDim2.new(1, -18, 0, 26),
		Position = UDim2.fromOffset(9, 3),
		Font = Theme.Fonts.Heavy,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = false,
		TextColor3 = COLORS.Ok,
		Text = "",
		ZIndex = 51,
		Parent = tooltip,
	})
	tooltipSub = Components.Label({
		Size = UDim2.new(1, -18, 0, 16),
		Position = UDim2.fromOffset(9, 28),
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = false,
		TextColor3 = Color3.fromRGB(210, 210, 220),
		Text = "",
		ZIndex = 51,
		Parent = tooltip,
	})
	reticle = Create("Frame", {
		Name = "Reticle",
		Size = UDim2.fromOffset(10, 10),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.2,
		Visible = false,
		ZIndex = 50,
		Parent = overlay,
	})
	Components.Corner(reticle, UDim.new(1, 0))
	Components.Stroke(reticle, Theme.Colors.Outline, 2)
end

function InteractionController.Start()
	RunService.RenderStepped:Connect(updateHover)

	InputController.On("UseTool", function()
		if InputController.IsTouch() then
			-- Touch USE button: act on what's in front of you.
			local object = autoTarget()
			click(if object then { Object = object, Position = objectPosition(object), Water = false } else nil)
		else
			click(hover or castTarget(nil))
		end
	end)
	InputController.On("Interact", function()
		local target = hover
		if not (target and target.Object) then
			local object = autoTarget()
			target = if object then { Object = object, Position = objectPosition(object), Water = false } else nil
		end
		if target and target.Object then
			click(target)
		end
	end)
	UserInputService.TouchTapInWorld:Connect(function(position, processedByUI)
		if processedByUI or pauseCount > 0 or UIController.IsAnyModalOpen() then
			return
		end
		local target = castTarget(position)
		if target and target.Object then
			local hint = hintFor(target.Object)
			setHighlight(target.Object, COLORS[hint.State] or COLORS.Neutral)
			task.delay(0.6, function()
				if highlight.Adornee == target.Object then
					setHighlight(nil, COLORS.Ok)
				end
			end)
		end
		click(target)
	end)
	-- Moving yourself cancels an auto-walk.
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and (input.KeyCode == Enum.KeyCode.W or input.KeyCode == Enum.KeyCode.A or input.KeyCode == Enum.KeyCode.S or input.KeyCode == Enum.KeyCode.D) then
			cancelWalk()
		end
	end)
end

return InteractionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InventoryController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/InventoryController
	DEPENDENCIES: Client.ClientState, InputController, UIController, ToolController,
	              InteractionController, Client.UI.{InventoryPanel, Components, Theme}

	Opens/closes the backpack (I / G / gamepad Y / 🎒 button) and keeps it in
	sync with replicated Inventory + Tools state. While open, tool use and
	world clicks are paused so they don't leak into the world.
]]

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local ToolController = require(script.Parent.ToolController)
local InteractionController = require(script.Parent.InteractionController)
local InventoryPanel = require(Client.UI.InventoryPanel)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local InventoryController = {}

local panel: any
local releaseBlocks: { () -> () } = {}

local function buildState()
	local inventory = ClientState.Get("Inventory") or {}
	local tools = ClientState.Get("Tools") or {}
	local items = inventory.Items or {}
	local used = 0
	for _, count in items do
		used += count
	end
	return {
		Items = items,
		Capacity = inventory.Capacity or 0,
		Used = used,
		OwnedTools = tools.Owned or {},
		Equipped = tools.Equipped or "",
	}
end

function InventoryController.IsOpen(): boolean
	return panel ~= nil and panel:IsOpen()
end

function InventoryController.Open()
	if InventoryController.IsOpen() then
		return
	end
	panel:SetState(buildState())
	panel:Open()
	UIController.SetModalOpen("Inventory", true)
	table.insert(releaseBlocks, InputController.Block("UseTool"))
	table.insert(releaseBlocks, InteractionController.PausePrompts())
end

function InventoryController.Close()
	if not InventoryController.IsOpen() then
		return
	end
	panel:Close()
	UIController.SetModalOpen("Inventory", false)
	for _, release in releaseBlocks do
		release()
	end
	table.clear(releaseBlocks)
end

function InventoryController.Toggle()
	if InventoryController.IsOpen() then
		InventoryController.Close()
	else
		InventoryController.Open()
	end
end

function InventoryController.Init()
	panel = InventoryPanel.new(UIController.GetModalLayer(), {
		OnClose = InventoryController.Close,
		OnEquip = function(toolId: string?)
			ToolController.RequestEquip(toolId)
		end,
	})

	Components.IconButton({
		Icon = "🎒",
		Caption = "Bag", Key = "I",
		Color = Theme.Colors.Blue,
		Parent = UIController.GetSlot("Left"),
		LayoutOrder = 1,
		OnClick = InventoryController.Toggle,
	})
end

function InventoryController.Start()
	InputController.On("ToggleInventory", InventoryController.Toggle)
	InputController.On("Cancel", InventoryController.Close)
	local function refresh()
		panel:SetState(buildState())
	end
	ClientState.Observe("Inventory", refresh)
	ClientState.Observe("Tools", refresh)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">IslandController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/IslandController
	DEPENDENCIES: Shared.Net, Shared.Config.{IslandConfig, ProgressionConfig}, Shared.Util.{IslandGen, Format},
	              Client.ClientState, UIController, InputController, BuildController,
	              Client.UI.{Components, Theme}

	The right-hand ISLAND CARD plus the island windows.

	  At home     island name + theme, level / XP, land used (chunks / max),
	              the next chunk's price and two buttons:
	                🗺️ EXPAND   opens build mode on the Expand tab
	                ⚙️ ISLAND   opens the settings window
	  Visiting    "Visiting <owner>'s island", its level and likes, and
	                ❤️ LIKE     once a day per island
	                🏠 HOME     teleports you back

	SETTINGS window (also opened by clicking your island sign)
	  rename · who may visit (Everyone / Friends / Nobody) · helpers (players
	  in this server you trust to gather, farm and build on your island).
	INFO window (clicking someone else's sign) shows their island + LIKE.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local IslandConfig = require(Shared.Config.IslandConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local IslandGen = require(Shared.Util.IslandGen)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local BuildController = require(script.Parent.BuildController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local PANEL_HEIGHT = 238

local IslandController = {}

type Refs = {
	Card: Frame,
	Header: Frame,
	HeaderLabel: TextLabel,
	Body: Frame,
	Name: TextLabel,
	Title: TextLabel,
	XPBar: Components.ProgressBar,
	XPText: TextLabel,
	Land: TextLabel,
	LandBar: Components.ProgressBar,
	LeftButton: TextButton,
	RightButton: TextButton,
	Toggle: TextButton,
}

local refs: Refs
local collapsed = false
local welcomed = false
local visitingUserId: number? = nil

-- Settings window
local settingsWindow: Frame
local nameBox: TextBox
local visitorButtons: { [string]: TextButton } = {}
local helperList: ScrollingFrame
local helperRows: { [number]: Frame } = {}

-- Info window
local infoWindow: Frame
local infoRefs: { Title: TextLabel, Body: TextLabel, Like: TextButton, OwnerUserId: number }

local function islandModel(userId: number): Model?
	local folder = workspace:FindFirstChild("Islands")
	local model = folder and folder:FindFirstChild("Island_" .. userId)
	return if model and model:IsA("Model") then model else nil
end

local function themeOf(themeId: any): any
	return IslandConfig.Themes[themeId] or IslandConfig.Themes[IslandConfig.DefaultTheme]
end

---------------------------------------------------------------------------
-- Card
---------------------------------------------------------------------------

local function refreshHome()
	local island = ClientState.Get("Island") or {}
	local level = island.Level or 1
	local xp = island.XP or 0
	local needed = ProgressionConfig.IslandXPForLevel(level)
	local theme = themeOf(island.Theme)
	refs.HeaderLabel.Text = "MY ISLAND"
	Components.SetCardHeader(refs.Header, theme.Color, theme.Icon)
	refs.Name.Text = island.Name or "My Island"
	refs.Title.Text = ("%s · %s · Lv %d"):format(theme.DisplayName, ProgressionConfig.GetIslandTitle(level), level)
	refs.XPBar.Frame.Visible = true
	refs.XPText.Visible = true
	refs.XPBar.SetProgress(xp / needed, true)
	refs.XPText.Text = ("%s / %s XP"):format(Format.Commas(xp), Format.Commas(needed))
	local count = IslandGen.CountChunks(island.Chunks or {})
	local maxChunks = IslandGen.MaxChunks(level)
	local cost = IslandGen.ExpansionCost(count)
	refs.LandBar.Frame.Visible = true
	refs.LandBar.SetProgress(count / math.max(1, maxChunks), true)
	if count >= maxChunks then
		refs.Land.Text = ("🗺️ Land %d / %d · level up for more"):format(count, maxChunks)
	else
		refs.Land.Text = ("🗺️ Land %d / %d · next %s 🪙"):format(count, maxChunks, Format.Abbreviate(cost))
	end
	refs.LeftButton.Text = "🗺️ EXPAND"
	Components.SetButtonColor(refs.LeftButton, if (ClientState.Get("Coins") or 0) >= cost and count < maxChunks then Theme.Colors.Green else Theme.Colors.Teal)
	refs.RightButton.Text = "⚙️ ISLAND"
	Components.SetButtonColor(refs.RightButton, Theme.Colors.Blue)
end

local function refreshVisiting(userId: number)
	local model = islandModel(userId)
	local owner = Players:GetPlayerByUserId(userId)
	local ownerName = (model and model:GetAttribute("OwnerName")) or (owner and owner.DisplayName) or "Someone"
	local theme = themeOf(model and model:GetAttribute("Theme"))
	refs.HeaderLabel.Text = "VISITING"
	Components.SetCardHeader(refs.Header, theme.Color, "👋")
	refs.Name.Text = tostring((model and model:GetAttribute("IslandName")) or (ownerName .. "'s Island"))
	refs.Title.Text = ("%s's %s island · Lv %s"):format(ownerName, theme.DisplayName, tostring(model and model:GetAttribute("IslandLevel") or 1))
	refs.XPBar.Frame.Visible = false
	refs.XPText.Visible = true
	refs.XPText.Text = ("❤️ %s likes · 🗺️ %s chunks"):format(Format.Abbreviate(tonumber(model and model:GetAttribute("Likes")) or 0), tostring(model and model:GetAttribute("Chunks") or "?"))
	local helpers = string.split(tostring(model and model:GetAttribute("Helpers") or ""), ",")
	local helping = table.find(helpers, tostring(player.UserId)) ~= nil
	refs.LandBar.Frame.Visible = false
	refs.Land.Text = if helping then "🤝 You're a helper here!" else "Look around, fish and shop!"
	refs.LeftButton.Text = "❤️ LIKE"
	Components.SetButtonColor(refs.LeftButton, Theme.Colors.Pink)
	refs.RightButton.Text = "🏠 HOME"
	Components.SetButtonColor(refs.RightButton, Theme.Colors.Green)
end

local function refresh()
	if not ClientState.IsReady() or not refs then
		return
	end
	if visitingUserId then
		refreshVisiting(visitingUserId)
	else
		refreshHome()
	end
end

local function buildCard(parent: Frame): Refs
	local card, header, body, headerLabel = Components.Card({
		Title = "MY ISLAND",
		Icon = "🏝️",
		Color = Theme.Colors.Level,
		Size = UDim2.new(1, 0, 0, PANEL_HEIGHT),
		Parent = parent,
		LayoutOrder = 1,
	})
	card.Name = "IslandPanel"
	local toggle = Components.Button({
		Name = "Toggle",
		Text = "–",
		Color = Theme.Colors.Panel,
		TextColor = Theme.Colors.Text,
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(1, -5, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = Theme.TextSize.Large,
		Parent = header,
		Flat = true,
	})
	Components.Corner(toggle, UDim.new(1, 0))

	local name = Components.Label({ Size = UDim2.new(1, 0, 0, 26), TextScaled = true, Text = "", Parent = body })
	local title = Components.Label({ Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 26), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, TextScaled = true, Text = "", Parent = body })
	local xpBar = Components.ProgressBar({ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 50), Color = Theme.Colors.Level, Parent = body })
	local xpText = Components.Label({ Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 64), Font = Theme.Fonts.Bold, TextSize = 12, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = body })
	Create("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromOffset(0, 86), BackgroundColor3 = Theme.Colors.PanelDark, BorderSizePixel = 0, Parent = body })
	local land = Components.Label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 92), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextScaled = true, Text = "", Parent = body })
	local landBar = Components.ProgressBar({ Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 116), Color = Theme.Colors.Teal, Parent = body })

	local leftButton = Components.Button({ Text = "🗺️ EXPAND", Color = Theme.Colors.Teal, Size = UDim2.new(0.5, -4, 0, 42), Position = UDim2.fromOffset(0, 136), TextSize = Theme.TextSize.Small, Parent = body, OnClick = function()
		if visitingUserId then
			Net.FireServer("LikeRequest", visitingUserId)
		else
			BuildController.Open("Expand")
		end
	end })
	local rightButton = Components.Button({ Text = "⚙️ ISLAND", Color = Theme.Colors.Blue, Size = UDim2.new(0.5, -4, 0, 42), Position = UDim2.new(0.5, 4, 0, 136), TextSize = Theme.TextSize.Small, Parent = body, OnClick = function()
		if visitingUserId then
			Net.FireServer("VisitRequest", 0)
		else
			IslandController.OpenSettings()
		end
	end })

	return {
		Card = card,
		Header = header,
		HeaderLabel = headerLabel,
		Body = body,
		Name = name,
		Title = title,
		XPBar = xpBar,
		XPText = xpText,
		Land = land,
		LandBar = landBar,
		LeftButton = leftButton,
		RightButton = rightButton,
		Toggle = toggle,
	}
end

local function setCollapsed(value: boolean)
	collapsed = value
	refs.Body.Visible = not collapsed
	refs.Card.Size = if collapsed then UDim2.new(1, 0, 0, 40) else UDim2.new(1, 0, 0, PANEL_HEIGHT)
	refs.Toggle.Text = if collapsed then "+" else "–"
end

---------------------------------------------------------------------------
-- Settings window
---------------------------------------------------------------------------

local function closeWindow(window: Frame, modal: string)
	if window.Visible then
		window.Visible = false
		UIController.SetModalOpen(modal, false)
	end
end

local function refreshSettings()
	if not settingsWindow or not settingsWindow.Visible then
		return
	end
	local island = ClientState.Get("Island") or {}
	local access = island.Access or {}
	local mode = access.Visitors or "Everyone"
	for id, button in visitorButtons do
		Components.SetButtonColor(button, if id == mode then Theme.Colors.Coins else Theme.Colors.PanelAlt)
	end
	if not nameBox:IsFocused() then
		nameBox.Text = island.Name or ""
	end
	local helpers = access.Helpers or {}
	local seen = {}
	local order = 0
	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		order += 1
		seen[other.UserId] = true
		local row = helperRows[other.UserId]
		if not row then
			row = Create("Frame", { Size = UDim2.new(1, -8, 0, 44), BackgroundColor3 = Theme.Colors.PanelAlt, Parent = helperList })
			Components.Corner(row, Theme.SmallCorner)
			Components.Stroke(row, Theme.Colors.Outline, 2)
			Components.Label({ Name = "PlayerName", Size = UDim2.new(1, -140, 1, 0), Position = UDim2.fromOffset(12, 0), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Text = other.DisplayName, Parent = row })
			local userId = other.UserId
			local toggleButton = Components.Button({ Name = "HelperToggle", Text = "", Size = UDim2.fromOffset(120, 34), Position = UDim2.new(1, -6, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), TextSize = Theme.TextSize.Small, Parent = row, Flat = true, OnClick = function()
				local current = ((ClientState.Get("Island", "Access") or {}).Helpers or {})[tostring(userId)] == true
				Net.FireServer("IslandSettingsRequest", { Helper = userId, Allowed = not current })
			end })
			toggleButton:SetAttribute("UserId", userId)
			helperRows[other.UserId] = row
		end
		row.LayoutOrder = order
		local isHelper = helpers[tostring(other.UserId)] == true
		local toggleButton = row:FindFirstChild("HelperToggle") :: TextButton
		toggleButton.Text = if isHelper then "🤝 HELPER" else "+ MAKE HELPER"
		Components.SetButtonColor(toggleButton, if isHelper then Theme.Colors.Green else Theme.Colors.Blue)
	end
	for userId, row in helperRows do
		if not seen[userId] then
			row:Destroy()
			helperRows[userId] = nil
		end
	end
	local empty = helperList:FindFirstChild("Empty") :: TextLabel?
	if empty then
		empty.Visible = order == 0
	end
end

local function buildSettings()
	local window, content, closeButton = Components.Panel({ Title = "⚙️ Island Settings", Size = UDim2.fromOffset(520, 520), Parent = UIController.GetModalLayer(), Color = Theme.Colors.Teal })
	window.Visible = false
	settingsWindow = window
	closeButton.Activated:Connect(function()
		closeWindow(window, "IslandSettings")
	end)

	Components.Label({ Text = "Island name", Size = UDim2.new(1, 0, 0, 22), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Parent = content })
	nameBox = Create("TextBox", {
		Size = UDim2.new(1, -130, 0, 42),
		Position = UDim2.fromOffset(0, 26),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.Text,
		PlaceholderText = "Name your island…",
		ClearTextOnFocus = false,
		Text = "",
		Parent = content,
	})
	Components.Corner(nameBox, Theme.SmallCorner)
	Components.Stroke(nameBox, Theme.Colors.Outline, 2)
	nameBox:GetPropertyChangedSignal("Text"):Connect(function()
		if #nameBox.Text > IslandConfig.NameMaxLength then
			nameBox.Text = string.sub(nameBox.Text, 1, IslandConfig.NameMaxLength)
		end
	end)
	Components.Button({ Text = "RENAME", Color = Theme.Colors.Green, Size = UDim2.fromOffset(120, 42), Position = UDim2.new(1, 0, 0, 26), AnchorPoint = Vector2.new(1, 0), TextSize = Theme.TextSize.Small, Parent = content, OnClick = function()
		Net.FireServer("RenameIslandRequest", nameBox.Text)
	end })

	Components.Label({ Text = "Who can visit?", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 84), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Parent = content })
	local icons = { Everyone = "🌍", Friends = "💛", Nobody = "🔒" }
	for index, mode in IslandConfig.VisitorModes do
		visitorButtons[mode] = Components.Button({
			Text = (icons[mode] or "") .. " " .. mode,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.new(1 / 3, -6, 0, 40),
			Position = UDim2.new((index - 1) / 3, 3, 0, 110),
			TextSize = Theme.TextSize.Small,
			Parent = content,
			Flat = true,
			OnClick = function()
				Net.FireServer("IslandSettingsRequest", { Visitors = mode })
			end,
		})
	end

	Components.Label({ Text = "Helpers (can gather, farm, feed & hammer on your island)", Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 166), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Parent = content })
	helperList = Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -196),
		Position = UDim2.fromOffset(0, 194),
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = content,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6) }),
	})
	Components.Corner(helperList, Theme.SmallCorner)
	Components.Label({ Name = "Empty", Text = "Nobody else is in this server right now.", Size = UDim2.new(1, -8, 0, 40), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Parent = helperList })
end

function IslandController.OpenSettings()
	if UIController.IsAnyModalOpen() or visitingUserId then
		return
	end
	settingsWindow.Visible = true
	UIController.SetModalOpen("IslandSettings", true)
	Components.PopIn(settingsWindow)
	refreshSettings()
end

---------------------------------------------------------------------------
-- Info window (someone else's island)
---------------------------------------------------------------------------

local function buildInfo()
	local window, content, closeButton = Components.Panel({ Title = "🏝️ Island", Size = UDim2.fromOffset(420, 300), Parent = UIController.GetModalLayer(), Color = Theme.Colors.Pink })
	window.Visible = false
	infoWindow = window
	closeButton.Activated:Connect(function()
		closeWindow(window, "IslandInfo")
	end)
	local title = Components.Label({ Size = UDim2.new(1, 0, 0, 34), TextSize = Theme.TextSize.Title, TextScaled = true, Text = "", Parent = content })
	local body = Components.Label({ Size = UDim2.new(1, 0, 0, 100), Position = UDim2.fromOffset(0, 40), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Medium, TextColor3 = Theme.Colors.TextMuted, TextYAlignment = Enum.TextYAlignment.Top, Text = "", Parent = content })
	local like = Components.Button({ Text = "❤️ LIKE THIS ISLAND", Color = Theme.Colors.Pink, Size = UDim2.new(1, 0, 0, 50), Position = UDim2.new(0, 0, 1, -54), Parent = content, OnClick = function()
		Net.FireServer("LikeRequest", infoRefs.OwnerUserId)
		closeWindow(infoWindow, "IslandInfo")
	end })
	infoRefs = { Title = title, Body = body, Like = like, OwnerUserId = 0 }
end

local function openInfo(payload: any)
	if UIController.IsAnyModalOpen() or type(payload.OwnerUserId) ~= "number" then
		return
	end
	local theme = themeOf(payload.Theme)
	infoRefs.OwnerUserId = payload.OwnerUserId
	infoRefs.Title.Text = tostring(payload.Name or "Island")
	infoRefs.Body.Text = ("Owner: %s\n%s %s island · Level %s\n🗺️ %s land chunks · ❤️ %s likes"):format(
		tostring(payload.OwnerName),
		theme.Icon,
		theme.DisplayName,
		tostring(payload.Level),
		tostring(payload.Chunks),
		Format.Abbreviate(tonumber(payload.Likes) or 0)
	)
	infoWindow.Visible = true
	UIController.SetModalOpen("IslandInfo", true)
	Components.PopIn(infoWindow)
end

---------------------------------------------------------------------------
-- Visiting
---------------------------------------------------------------------------

local function onLocationChanged()
	local value = player:GetAttribute("OnIsland")
	local previous = visitingUserId
	visitingUserId = if type(value) == "number" and value ~= 0 and value ~= player.UserId then value else nil
	if visitingUserId and visitingUserId ~= previous then
		closeWindow(settingsWindow, "IslandSettings")
		local model = islandModel(visitingUserId)
		local name = model and model:GetAttribute("IslandName")
		UIController.Banner("Welcome to " .. tostring(name or "their island") .. "!", "Be nice — click things to look around", "Reward")
	end
	refresh()
end

function IslandController.IsVisiting(): number?
	return visitingUserId
end

function IslandController.Init()
	refs = buildCard(UIController.GetSlot("Right"))
	refs.Toggle.Activated:Connect(function()
		setCollapsed(not collapsed)
	end)
	-- Phones have little room: start collapsed on touch devices.
	if InputController.IsTouch() then
		setCollapsed(true)
	end
	buildSettings()
	buildInfo()
end

function IslandController.Start()
	for _, key in { "Island", "Coins" } do
		ClientState.Observe(key, refresh)
	end
	ClientState.Observe("Island", refreshSettings)
	Players.PlayerAdded:Connect(refreshSettings)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshSettings)
	end)
	player:GetAttributeChangedSignal("OnIsland"):Connect(onLocationChanged)
	onLocationChanged()
	-- The visited island's attributes (likes, level) change live.
	task.spawn(function()
		while true do
			task.wait(2)
			if visitingUserId then
				refresh()
			end
		end
	end)

	Net.OnClientEvent("OpenUI", function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		if payload.Screen == "IslandSettings" then
			IslandController.OpenSettings()
		elseif payload.Screen == "IslandInfo" then
			openInfo(payload)
		end
	end)
	InputController.On("Cancel", function()
		closeWindow(settingsWindow, "IslandSettings")
		closeWindow(infoWindow, "IslandInfo")
	end)

	ClientState.Observe("Island", function(island)
		if welcomed or type(island) ~= "table" or island.Created ~= true or not island.Name or island.Name == "" then
			return
		end
		welcomed = true
		task.delay(1.5, function()
			UIController.Banner("Welcome to " .. island.Name .. "!", "Your island adventure begins", "Reward")
		end)
	end)
end

return IslandController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">IslandCreatorController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandCreatorController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/IslandCreatorController
	DEPENDENCIES: Shared.Net, Shared.Config.IslandConfig, Shared.Util.IslandGen, Client.ClientState,
	              UIController, AudioController, Client.UI.{Components, Theme}

	The CREATE YOUR ISLAND screen, shown once to new players (while the
	replicated Island.Created is false; the server waits for it before
	spawning you).

	  1  THEME   Tropical / Meadow / Autumn / Snowy / Desert: ground colours,
	             trees, decorations and the fish near your shore.
	  2  SHAPE   Round / Crescent / Twin Isles / Longshore / Wild, and a
	             🎲 REROLL button: every seed grows a different coastline.
	  3  NAME    optional (filtered by the server).

	The map in the middle is a LIVE preview drawn with the exact same
	generator the server uses (Shared/Util/IslandGen), so what you see is
	the island you get. CREATE sends CreateIslandRequest{Theme, Shape, Seed, Name}.

	The screen has its own ScreenGui and scales to FILL any screen (phone,
	laptop or a small Studio window), with big chunky text.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local IslandConfig = require(Shared.Config.IslandConfig)
local IslandGen = require(Shared.Util.IslandGen)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local PREVIEW_PIXELS = 46
local PREVIEW_SIZE = 380

-- Map colours for the preview (terrain materials by name).
local MATERIAL_COLORS: { [string]: Color3 } = {
	Grass = Color3.fromRGB(104, 186, 74),
	LeafyGrass = Color3.fromRGB(222, 146, 58),
	Ground = Color3.fromRGB(150, 110, 72),
	Snow = Color3.fromRGB(240, 246, 255),
	Salt = Color3.fromRGB(226, 232, 238),
	Sand = Color3.fromRGB(240, 222, 160),
	Sandstone = Color3.fromRGB(222, 164, 104),
	Rock = Color3.fromRGB(128, 128, 132),
	Slate = Color3.fromRGB(100, 104, 112),
}
local DEEP_WATER = Color3.fromRGB(26, 92, 170)
local SHALLOW_WATER = Color3.fromRGB(70, 196, 220)

local IslandCreatorController = {}

local gui: ScreenGui
local root: Frame
local shown = false
local submitted = false
local choice = { Theme = IslandConfig.DefaultTheme, Shape = IslandConfig.DefaultShape, Seed = 1 }
local themeCards: { [string]: TextButton } = {}
local shapeButtons: { [string]: TextButton } = {}
local pixels: { Frame } = {}
local nameBox: TextBox
local summary: TextLabel
local createButton: TextButton
local drawToken = 0

local function newSeed(): number
	return Random.new():NextInteger(1, 1_999_999_999)
end

local function drawPreview()
	drawToken += 1
	local token = drawToken
	local chunks = IslandGen.GenerateStarter(choice.Seed, choice.Shape)
	local sampler = IslandGen.NewSampler({ Seed = choice.Seed, Theme = choice.Theme, Chunks = chunks, Paint = {} })
	-- Frame the island: bounding box of its chunks plus some sea around it.
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for key in chunks do
		local cx, cz = IslandGen.ParseKey(key)
		if cx and cz then
			minX, maxX = math.min(minX, cx), math.max(maxX, cx)
			minZ, maxZ = math.min(minZ, cz), math.max(maxZ, cz)
		end
	end
	local chunk = IslandConfig.ChunkSize
	local span = (math.max(maxX - minX, maxZ - minZ) + 3) * chunk
	local centerX = (minX + maxX) / 2 * chunk
	local centerZ = (minZ + maxZ) / 2 * chunk
	local step = span / PREVIEW_PIXELS
	for row = 0, PREVIEW_PIXELS - 1 do
		for column = 0, PREVIEW_PIXELS - 1 do
			local x = centerX - span / 2 + (column + 0.5) * step
			local z = centerZ - span / 2 + (row + 0.5) * step
			local sample = sampler:Sample(x, z)
			local color: Color3
			if sample.Height < -0.4 then
				color = SHALLOW_WATER:Lerp(DEEP_WATER, math.clamp(-sample.Height / 10, 0, 1))
			else
				color = MATERIAL_COLORS[sample.Material] or Color3.fromRGB(110, 180, 80)
				-- Shade hills so the height reads on the flat map.
				local lift = math.clamp((sample.Height - IslandConfig.LandHeight) / 12, -0.3, 1)
				color = if lift > 0 then color:Lerp(Color3.new(1, 1, 1), lift * 0.35) else color:Lerp(Color3.new(0, 0, 0), -lift * 0.3)
			end
			pixels[row * PREVIEW_PIXELS + column + 1].BackgroundColor3 = color
		end
		-- Spread the work over a few frames so the UI never hitches.
		if row % 12 == 11 then
			task.wait()
			if token ~= drawToken then
				return
			end
		end
	end
end

local function refresh()
	local theme = IslandConfig.Themes[choice.Theme]
	local shape = IslandConfig.Shapes[choice.Shape]
	for id, card in themeCards do
		Components.SetButtonColor(card, if id == choice.Theme then IslandConfig.Themes[id].Color else Theme.Colors.PanelAlt)
	end
	for id, button in shapeButtons do
		Components.SetButtonColor(button, if id == choice.Shape then Theme.Colors.Coins else Theme.Colors.PanelAlt)
	end
	summary.Text = ("%s %s  ·  %s %s\n%s\n%s\nSeed #%d"):format(theme.Icon, theme.DisplayName, shape.Icon, shape.DisplayName, theme.Description, shape.Description, choice.Seed)
	task.spawn(drawPreview)
end

local DESIGN = Vector2.new(1240, 720)

-- Soft floating bubbles behind the menu (cartoon sky).
local function addBubbles(parent: Frame)
	local spots = {
		{ 0.08, 0.2, 260 },
		{ 0.9, 0.15, 340 },
		{ 0.18, 0.85, 380 },
		{ 0.82, 0.8, 300 },
		{ 0.5, 0.05, 220 },
		{ 0.62, 0.95, 240 },
	}
	for index, spot in spots do
		local bubble = Create("Frame", {
			Name = "Bubble",
			Size = UDim2.fromOffset(spot[3], spot[3]),
			Position = UDim2.fromScale(spot[1], spot[2]),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.88,
			Parent = parent,
		})
		Components.Corner(bubble, UDim.new(1, 0))
		TweenService:Create(bubble, TweenInfo.new(3 + index * 0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
			Position = UDim2.fromScale(spot[1], spot[2] - 0.035),
		}):Play()
	end
end

local function header(parent: Instance, text: string)
	local label = Components.Label({ Text = text, Size = UDim2.new(1, 0, 0, 38), TextSize = 34, TextColor3 = Theme.Colors.TextLight, Parent = parent })
	Components.TextStroke(label, Theme.Colors.Outline, 2.5)
end

local function column(parent: Instance, x: number, width: number, color: Color3): Frame
	local frame = Create("Frame", { Size = UDim2.fromOffset(width, 600), Position = UDim2.fromOffset(x, 0), BackgroundColor3 = color, Parent = parent })
	Components.Corner(frame, UDim.new(0, 26))
	Components.Stroke(frame, Theme.Colors.Outline, 5)
	Components.Gloss(frame, 0.3)
	Components.Padding(frame, 14)
	return frame
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = Create("ScreenGui", {
		Name = "IslandCreatorGui",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Enabled = false,
		Parent = playerGui,
	})
	root = Create("Frame", {
		Name = "IslandCreator",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = gui,
	})
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(130, 220, 255)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(60, 160, 235)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(30, 105, 200)),
		}),
		Parent = root,
	})
	addBubbles(root)

	-- Everything below is laid out at DESIGN size and scaled to FILL the screen.
	local stage = Create("Frame", {
		Name = "Stage",
		Size = UDim2.fromOffset(DESIGN.X, DESIGN.Y),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local stageScale = Create("UIScale", { Parent = stage })
	local function fit()
		local size = root.AbsoluteSize
		if size.X > 0 and size.Y > 0 then
			stageScale.Scale = math.max(0.35, math.min(size.X * 0.97 / DESIGN.X, size.Y * 0.96 / DESIGN.Y))
		end
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	fit()

	local title = Components.Label({
		Text = "🏝️ CREATE YOUR ISLAND",
		Size = UDim2.new(1, 0, 0, 70),
		TextSize = 64,
		TextColor3 = Theme.Colors.TextLight,
		TextWrapped = false,
		Parent = stage,
	})
	Components.TextStroke(title, Theme.Colors.Outline, 4)
	TweenService:Create(title, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 1.5 }):Play()
	local subtitle = Components.Label({
		Text = "Every island is unique — pick a look, then reroll until you love the shape!",
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 72),
		Font = Theme.Fonts.Heavy,
		TextSize = 26,
		TextColor3 = Theme.Colors.TextLight,
		Parent = stage,
	})
	Components.TextStroke(subtitle, Theme.Colors.Outline, 2)

	local container = Create("Frame", {
		Size = UDim2.fromOffset(DESIGN.X, 600),
		Position = UDim2.fromOffset(0, 116),
		BackgroundTransparency = 1,
		Parent = stage,
	})

	-- 1: THEME
	local themeColumn = column(container, 0, 380, Color3.fromRGB(255, 196, 90))
	header(themeColumn, "1 · THEME")
	for index, themeId in IslandConfig.ThemeOrder do
		local theme = IslandConfig.Themes[themeId]
		local card = Components.Button({
			Name = themeId,
			Text = "",
			Color = Theme.Colors.PanelAlt,
			Size = UDim2.new(1, 0, 0, 100),
			Position = UDim2.fromOffset(0, 46 + (index - 1) * 108),
			Parent = themeColumn,
			Flat = true,
			OnClick = function()
				choice.Theme = themeId
				refresh()
			end,
		})
		Components.Label({ Text = theme.Icon, Size = UDim2.fromOffset(80, 100), TextSize = 56, Parent = card })
		local name = Components.Label({ Text = theme.DisplayName, Size = UDim2.new(1, -90, 0, 36), Position = UDim2.fromOffset(80, 10), TextXAlignment = Enum.TextXAlignment.Left, TextSize = 30, TextColor3 = Theme.Colors.TextLight, Parent = card })
		Components.TextStroke(name, Theme.Colors.Outline, 2.5)
		Components.Label({ Text = theme.Description, Size = UDim2.new(1, -92, 0, 46), Position = UDim2.fromOffset(80, 48), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = Theme.Fonts.Heavy, TextSize = 17, TextColor3 = Theme.Colors.Text, Parent = card })
		themeCards[themeId] = card
	end

	-- 2: SHAPE + PREVIEW
	local middle = column(container, 395, 450, Color3.fromRGB(120, 215, 140))
	header(middle, "2 · SHAPE")
	local map = Create("Frame", {
		Name = "Preview",
		Size = UDim2.fromOffset(PREVIEW_SIZE, PREVIEW_SIZE),
		Position = UDim2.new(0.5, 0, 0, 46),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = DEEP_WATER,
		ClipsDescendants = true,
		Parent = middle,
	})
	Components.Corner(map, UDim.new(0, 22))
	Components.Stroke(map, Theme.Colors.Outline, 5)
	local pixelSize = PREVIEW_SIZE / PREVIEW_PIXELS
	for row = 0, PREVIEW_PIXELS - 1 do
		for columnIndex = 0, PREVIEW_PIXELS - 1 do
			table.insert(pixels, Create("Frame", {
				Size = UDim2.fromOffset(math.ceil(pixelSize), math.ceil(pixelSize)),
				Position = UDim2.fromOffset(columnIndex * pixelSize, row * pixelSize),
				BackgroundColor3 = DEEP_WATER,
				BorderSizePixel = 0,
				Parent = map,
			}))
		end
	end
	local shapeRow = Create("Frame", { Size = UDim2.new(1, 0, 0, 70), Position = UDim2.fromOffset(0, 438), BackgroundTransparency = 1, Parent = middle }, {
		Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for index, shapeId in IslandConfig.ShapeOrder do
		local shape = IslandConfig.Shapes[shapeId]
		local button = Components.Button({
			Name = shapeId,
			Text = shape.Icon .. "\n" .. shape.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.fromOffset(78, 70),
			TextSize = 16,
			Parent = shapeRow,
			Flat = true,
			OnClick = function()
				choice.Shape = shapeId
				refresh()
			end,
		})
		button.LayoutOrder = index
		shapeButtons[shapeId] = button
	end
	Components.Button({
		Text = "🎲 REROLL SHAPE",
		Color = Theme.Colors.Purple,
		Size = UDim2.new(1, 0, 0, 58),
		Position = UDim2.fromOffset(0, 516),
		TextSize = 26,
		Parent = middle,
		OnClick = function()
			choice.Seed = newSeed()
			refresh()
		end,
	})

	-- 3: NAME + CREATE
	local right = column(container, 860, 380, Color3.fromRGB(255, 150, 190))
	header(right, "3 · NAME")
	nameBox = Create("TextBox", {
		Size = UDim2.new(1, 0, 0, 62),
		Position = UDim2.fromOffset(0, 48),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Font = Theme.Fonts.Heavy,
		TextSize = 28,
		TextColor3 = Theme.Colors.Text,
		PlaceholderText = "My Island",
		ClearTextOnFocus = false,
		Text = "",
		Parent = right,
	})
	Components.Corner(nameBox, UDim.new(0, 16))
	Components.Stroke(nameBox, Theme.Colors.Outline, 4)
	nameBox:GetPropertyChangedSignal("Text"):Connect(function()
		if #nameBox.Text > IslandConfig.NameMaxLength then
			nameBox.Text = string.sub(nameBox.Text, 1, IslandConfig.NameMaxLength)
		end
	end)
	local card = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 290),
		Position = UDim2.fromOffset(0, 124),
		BackgroundColor3 = Theme.Colors.Panel,
		Parent = right,
	})
	Components.Corner(card, UDim.new(0, 18))
	Components.Stroke(card, Theme.Colors.Outline, 3)
	Components.Padding(card, 12)
	summary = Components.Label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Fonts.Heavy,
		TextSize = 22,
		TextColor3 = Theme.Colors.Text,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		Parent = card,
	})
	Components.Label({
		Text = "You can grow your island in any direction later!",
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.fromOffset(0, 420),
		Font = Theme.Fonts.Heavy,
		TextSize = 18,
		TextColor3 = Theme.Colors.TextLight,
		Parent = right,
	})
	createButton = Components.Button({
		Text = "✨ CREATE ISLAND!",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, 0, 0, 96),
		Position = UDim2.new(0, 0, 1, -100),
		TextSize = 36,
		Parent = right,
		OnClick = function()
			if submitted then
				return
			end
			submitted = true
			createButton.Text = "⏳ RAISING YOUR ISLAND…"
			createButton.TextSize = 24
			Components.SetButtonColor(createButton, Theme.Colors.PanelDark)
			AudioController.Play("LevelUp")
			Net.FireServer("CreateIslandRequest", { Theme = choice.Theme, Shape = choice.Shape, Seed = choice.Seed, Name = nameBox.Text })
			-- If the server rejected it, let the player try again.
			task.delay(12, function()
				if shown then
					submitted = false
					createButton.Text = "✨ CREATE ISLAND!"
					createButton.TextSize = 36
					Components.SetButtonColor(createButton, Theme.Colors.Green)
				end
			end)
		end,
	})
	-- A glow pulses behind the CREATE button to draw the eye.
	local glow = Create("Frame", {
		Name = "CreateGlow",
		Size = UDim2.new(1, 16, 0, 112),
		Position = UDim2.new(0, -8, 1, -108),
		BackgroundColor3 = Color3.fromRGB(255, 255, 160),
		BackgroundTransparency = 0.5,
		ZIndex = 0,
		Parent = right,
	})
	Components.Corner(glow, UDim.new(0, 22))
	TweenService:Create(glow, TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { BackgroundTransparency = 0.9 }):Play()
	createButton.ZIndex = 2
end

local function show()
	if shown then
		return
	end
	shown = true
	submitted = false
	choice.Seed = newSeed()
	gui.Enabled = true
	UIController.SetModalOpen("IslandCreator", true)
	refresh()
end

local function hide()
	if not shown then
		return
	end
	shown = false
	drawToken += 1
	UIController.SetModalOpen("IslandCreator", false)
	gui.Enabled = false
end

function IslandCreatorController.IsOpen(): boolean
	return shown
end

function IslandCreatorController.Init()
	build()
end

function IslandCreatorController.Start()
	ClientState.Observe("Island", function(island)
		if type(island) ~= "table" then
			return
		end
		if island.Created == true then
			hide()
		else
			show()
		end
	end)
end

return IslandCreatorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  MovementController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/MovementController
	DEPENDENCIES: Shared.Config.GameConfig, InputController, CameraController, UIController

	SPRINT: hold Shift (or press the left stick on a gamepad) to run at
	GameConfig.Character.SprintSpeed. The run animation, dust puffs and a
	slightly wider camera kick in automatically. Your own client moves your
	character, so the speed is set here; the server's movement check
	(AntiExploitService) already allows for it. Menus and build mode stop
	sprinting.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local InputController = require(script.Parent.InputController)
local CameraController = require(script.Parent.CameraController)
local UIController = require(script.Parent.UIController)

local MovementController = {}

local sprinting = false

function MovementController.IsSprinting(): boolean
	return sprinting
end

local function update()
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local wants = InputController.IsHeld("Sprint")
		and not UIController.IsAnyModalOpen()
		and humanoid.MoveDirection.Magnitude > 0.1
	if wants ~= sprinting then
		sprinting = wants
		CameraController.SetSprint(sprinting)
	end
	local speed = if sprinting then GameConfig.Character.SprintSpeed else GameConfig.Character.WalkSpeed
	if humanoid.WalkSpeed ~= speed then
		humanoid.WalkSpeed = speed
	end
end

function MovementController.Start()
	RunService.RenderStepped:Connect(update)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">PlayersController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  PlayersController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/PlayersController
	DEPENDENCIES: Shared.Net, Shared.Config.IslandConfig, Shared.Util.Format, UIController, InputController,
	              AudioController, TradeController, Client.UI.{Components, Theme}

	The 👥 PLAYERS window (P key / left menu): everyone in this server with
	their island (name, theme, level, likes) and:
	  VISIT  teleports you to their island (the server checks their visitor
	         setting: Everyone / Friends / Nobody)
	  TRADE  sends a trade invite (TradeController shows the trade window)
	plus a 🏠 GO HOME button while you're visiting someone.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local IslandConfig = require(Shared.Config.IslandConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local AudioController = require(script.Parent.AudioController)
local TradeController = require(script.Parent.TradeController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local PlayersController = {}

local window: Frame
local list: ScrollingFrame
local homeButton: TextButton
local emptyLabel: TextLabel
local rows: { [number]: Frame } = {}
local open = false

local function islandModel(userId: number): Model?
	local folder = workspace:FindFirstChild("Islands")
	local model = folder and folder:FindFirstChild("Island_" .. userId)
	return if model and model:IsA("Model") then model else nil
end

local function makeRow(other: Player): Frame
	local row = Create("Frame", { Name = other.Name, Size = UDim2.new(1, -10, 0, 78), BackgroundColor3 = Theme.Colors.PanelAlt, Parent = list })
	Components.Corner(row, Theme.SmallCorner)
	Components.Stroke(row, Theme.Colors.Outline, 2)
	local avatar = Create("ImageLabel", {
		Name = "Avatar",
		Size = UDim2.fromOffset(62, 62),
		Position = UDim2.fromOffset(8, 8),
		BackgroundColor3 = Theme.Colors.PanelDark,
		Image = "",
		Parent = row,
	})
	Components.Corner(avatar, UDim.new(1, 0))
	Components.Stroke(avatar, Theme.Colors.Outline, 2)
	task.spawn(function()
		local ok, image = pcall(Players.GetUserThumbnailAsync, Players, other.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		if ok and avatar.Parent then
			avatar.Image = image
		end
	end)
	Components.Label({ Name = "PlayerName", Size = UDim2.new(1, -300, 0, 26), Position = UDim2.fromOffset(80, 10), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, TextScaled = true, Text = other.DisplayName, Parent = row })
	Components.Label({ Name = "Island", Size = UDim2.new(1, -300, 0, 34), Position = UDim2.fromOffset(80, 36), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = row })
	local userId = other.UserId
	Components.Button({ Name = "Visit", Text = "🏝️ VISIT", Color = Theme.Colors.Teal, Size = UDim2.fromOffset(104, 44), Position = UDim2.new(1, -228, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), TextSize = Theme.TextSize.Small, Parent = row, OnClick = function()
		Net.FireServer("VisitRequest", userId)
		PlayersController.Close()
	end })
	Components.Button({ Name = "Trade", Text = "🤝 TRADE", Color = Theme.Colors.Orange, Size = UDim2.fromOffset(104, 44), Position = UDim2.new(1, -116, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), TextSize = Theme.TextSize.Small, Parent = row, OnClick = function()
		TradeController.Invite(userId)
		PlayersController.Close()
	end })
	return row
end

local function refresh()
	if not open then
		return
	end
	local seen = {}
	local order = 0
	for _, other in Players:GetPlayers() do
		if other == player then
			continue
		end
		order += 1
		seen[other.UserId] = true
		local row = rows[other.UserId] or makeRow(other)
		rows[other.UserId] = row
		row.LayoutOrder = order
		local model = islandModel(other.UserId)
		local info = row:FindFirstChild("Island") :: TextLabel
		if model then
			local theme = IslandConfig.Themes[model:GetAttribute("Theme")] or IslandConfig.Themes[IslandConfig.DefaultTheme]
			local mode = tostring(model:GetAttribute("VisitorMode") or "Everyone")
			info.Text = ("%s %s · Lv %s · ❤️ %s%s"):format(
				theme.Icon,
				tostring(model:GetAttribute("IslandName") or "Island"),
				tostring(model:GetAttribute("IslandLevel") or 1),
				Format.Abbreviate(tonumber(model:GetAttribute("Likes")) or 0),
				if mode == "Everyone" then "" elseif mode == "Friends" then " · 💛 friends only" else " · 🔒 closed"
			)
		else
			info.Text = "Still creating their island…"
		end
	end
	for userId, row in rows do
		if not seen[userId] then
			row:Destroy()
			rows[userId] = nil
		end
	end
	emptyLabel.Visible = order == 0
	local location = player:GetAttribute("OnIsland")
	homeButton.Visible = type(location) == "number" and location ~= 0 and location ~= player.UserId
end

function PlayersController.Open()
	if open or UIController.IsAnyModalOpen() then
		return
	end
	open = true
	window.Visible = true
	UIController.SetModalOpen("Players", true)
	Components.PopIn(window)
	AudioController.Play("UIOpen")
	refresh()
end

function PlayersController.Close()
	if not open then
		return
	end
	open = false
	window.Visible = false
	UIController.SetModalOpen("Players", false)
	AudioController.Play("UIClose")
end

function PlayersController.Toggle()
	if open then
		PlayersController.Close()
	else
		PlayersController.Open()
	end
end

function PlayersController.Init()
	local content, closeButton
	window, content, closeButton = Components.Panel({ Title = "👥 Players & Islands", Size = UDim2.fromOffset(600, 500), Parent = UIController.GetModalLayer(), Color = Theme.Colors.Purple })
	window.Visible = false
	closeButton.Activated:Connect(PlayersController.Close)

	homeButton = Components.Button({ Text = "🏠 GO HOME", Color = Theme.Colors.Green, Size = UDim2.new(1, 0, 0, 44), Parent = content, OnClick = function()
		Net.FireServer("VisitRequest", 0)
		PlayersController.Close()
	end })
	homeButton.Visible = false
	list = Create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -52),
		Position = UDim2.fromOffset(0, 52),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = content,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})
	emptyLabel = Components.Label({
		Text = "You're the only one here right now.\nInvite friends to visit your island!",
		Size = UDim2.new(1, -10, 0, 80),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextMuted,
		LayoutOrder = 0,
		Parent = list,
	})

	Components.IconButton({
		Icon = "👥",
		Caption = "Players", Key = "P",
		Color = Theme.Colors.Purple,
		Parent = UIController.GetSlot("Left"),
		LayoutOrder = 3,
		OnClick = PlayersController.Toggle,
	})
end

function PlayersController.Start()
	InputController.On("PlayersMenu", PlayersController.Toggle)
	InputController.On("Cancel", PlayersController.Close)
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(function()
		task.defer(refresh)
	end)
	player:GetAttributeChangedSignal("OnIsland"):Connect(refresh)
	task.spawn(function()
		while true do
			task.wait(2)
			refresh()
		end
	end)
end

return PlayersController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">QuestController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  QuestController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/QuestController
	DEPENDENCIES: Shared.Config.QuestConfig, Shared.Util.Format, Client.ClientState,
	              UIController, InputController, AudioController, Client.UI.{Components, Theme}

	The QUEST CARD on the right of the HUD (spec §43, §118-§119): the
	current tutorial quest, every task with ✔ / progress counts, a 💡 hint
	for the next unfinished task and the reward. It is the game's answer to
	"what do I do next?" at every moment of the first session.

	Read-only: progress arrives through replicated state (Quests.*), which
	the server only changes from real gameplay events.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestConfig = require(Shared.Config.QuestConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)


local MAX_TASKS = 6
local ROW_HEIGHT = 20
local HEADER_HEIGHT = 40

local QuestController = {}

type Refs = {
	Card: Frame,
	Body: Frame,
	Toggle: TextButton,
	QuestName: TextLabel,
	Rows: { TextLabel },
	Counts: { TextLabel },
	Hint: TextLabel,
	Reward: TextLabel,
}

local refs: Refs
local collapsed = false
local bodyHeight = 0
local lastDone: { [string]: boolean } = {}
local lastQuestId: string? = nil

local function hintFor(quest: any, progress: { [string]: number }): string
	local flags = ClientState.Get("Flags") or {}
	if not flags.StarterChestClaimed then
		return "📦 Open your Starter Chest near the spawn!"
	end
	if not flags.FirstEquip then
		return if InputController.IsTouch() then "🪓 Tap a tool in your hotbar to hold it." else "🪓 Press 1-9 to hold a tool, then click a tree or rock."
	end
	for _, questTask in quest.Tasks do
		if (progress[questTask.Id] or 0) < questTask.Amount then
			return "💡 " .. questTask.Hint
		end
	end
	return "🎉 Quest complete!"
end

local function rewardText(reward: any): string
	local parts = {}
	if reward.Coins then
		table.insert(parts, Format.Commas(reward.Coins) .. " 🪙")
	end
	if reward.IslandXP then
		table.insert(parts, Format.Commas(reward.IslandXP) .. " Island XP")
	end
	if reward.XP then
		table.insert(parts, Format.Commas(reward.XP) .. " XP")
	end
	return "🎁 " .. table.concat(parts, " · ")
end

local function layout(taskCount: number)
	-- name 22 + rows + hint 36 + reward 16 + gaps
	bodyHeight = 26 + taskCount * ROW_HEIGHT + 6 + 36 + 18
	refs.Hint.Position = UDim2.fromOffset(0, 26 + taskCount * ROW_HEIGHT + 4)
	refs.Reward.Position = UDim2.fromOffset(0, 26 + taskCount * ROW_HEIGHT + 42)
	refs.Card.Size = UDim2.new(1, 0, 0, if collapsed then HEADER_HEIGHT else HEADER_HEIGHT + 8 + bodyHeight)
end

local function refresh()
	if not ClientState.IsReady() then
		return
	end
	local quests = ClientState.Get("Quests") or {}
	local questId = quests.Current
	local quest = type(questId) == "string" and QuestConfig.Quests[questId] or nil
	local progress = quests.Progress or {}

	if not quest then
		refs.QuestName.Text = "🎉 ALL QUESTS DONE!"
		for index = 1, MAX_TASKS do
			refs.Rows[index].Visible = false
			refs.Counts[index].Visible = false
		end
		refs.Hint.Text = "Keep growing your island — more adventures coming soon."
		refs.Reward.Text = ""
		layout(0)
		return
	end

	if questId ~= lastQuestId then
		lastQuestId = questId
		table.clear(lastDone)
		Components.Bounce(refs.Card, 0.06)
	end
	refs.QuestName.Text = quest.DisplayName
	for index = 1, MAX_TASKS do
		local questTask = quest.Tasks[index]
		local row, count = refs.Rows[index], refs.Counts[index]
		row.Visible = questTask ~= nil
		count.Visible = questTask ~= nil
		if questTask then
			local value = math.min(progress[questTask.Id] or 0, questTask.Amount)
			local done = value >= questTask.Amount
			row.Text = (if done then "✔ " else "• ") .. questTask.Text
			row.TextColor3 = if done then Theme.Colors.Green else Theme.Colors.Text
			count.Text = if done then "" else ("%d/%d"):format(value, questTask.Amount)
			if done and lastDone[questTask.Id] == false then
				-- Just finished this task: a little pop + sound.
				Components.Bounce(row, 0.25)
				AudioController.Play("ItemGain")
			end
			lastDone[questTask.Id] = done
		end
	end
	refs.Hint.Text = hintFor(quest, progress)
	refs.Reward.Text = rewardText(quest.Reward)
	layout(#quest.Tasks)
end

local function buildCard(parent: Frame): Refs
	local card, header, body = Components.Card({
		Title = "QUEST",
		Icon = "📜",
		Color = Theme.Colors.Purple,
		Size = UDim2.new(1, 0, 0, 250),
		Parent = parent,
		LayoutOrder = 2,
		HeaderHeight = HEADER_HEIGHT,
	})
	card.Name = "QuestCard"
	local toggle = Components.Button({
		Name = "Toggle",
		Text = "–",
		Color = Theme.Colors.Panel,
		TextColor = Theme.Colors.Text,
		Size = UDim2.fromOffset(30, 30),
		Position = UDim2.new(1, -5, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = Theme.TextSize.Large,
		Parent = header,
		Flat = true,
	})
	Components.Corner(toggle, UDim.new(1, 0))
	local questName = Components.Label({ Size = UDim2.new(1, 0, 0, 22), TextSize = Theme.TextSize.Medium, TextScaled = true, Text = "", Parent = body })
	local rows, counts = {}, {}
	for index = 1, MAX_TASKS do
		local y = 26 + (index - 1) * ROW_HEIGHT
		table.insert(rows, Components.Label({
			Size = UDim2.new(1, -50, 0, ROW_HEIGHT - 2),
			Position = UDim2.fromOffset(0, y),
			Font = Theme.Fonts.Bold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Text = "",
			Parent = body,
		}))
		table.insert(counts, Components.Label({
			Size = UDim2.new(0, 50, 0, ROW_HEIGHT - 2),
			Position = UDim2.new(1, -50, 0, y),
			Font = Theme.Fonts.Bold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Theme.Colors.TextMuted,
			Text = "",
			Parent = body,
		}))
	end
	local hint = Components.Label({
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(255, 240, 200),
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		Text = "",
		Parent = body,
	})
	Components.Corner(hint, Theme.SmallCorner)
	local reward = Components.Label({ Size = UDim2.new(1, 0, 0, 16), Font = Theme.Fonts.Bold, TextSize = 12, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = body })

	return { Card = card, Body = body, Toggle = toggle, QuestName = questName, Rows = rows, Counts = counts, Hint = hint, Reward = reward }
end

local function setCollapsed(value: boolean)
	collapsed = value
	refs.Body.Visible = not collapsed
	refs.Toggle.Text = if collapsed then "+" else "–"
	refs.Card.Size = UDim2.new(1, 0, 0, if collapsed then HEADER_HEIGHT else HEADER_HEIGHT + 8 + bodyHeight)
end

function QuestController.Init()
	refs = buildCard(UIController.GetSlot("Right"))
	refs.Toggle.Activated:Connect(function()
		setCollapsed(not collapsed)
	end)
	layout(MAX_TASKS)
end

function QuestController.Start()
	for _, key in { "Quests", "Flags" } do
		ClientState.Observe(key, refresh)
	end
	InputController.DeviceChanged:Connect(refresh)
end

return QuestController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ShopController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/ShopController
	DEPENDENCIES: Shared.Net, Shared.Config.{ShopConfig, ItemConfig, EconomyConfig},
	              Shared.Util.{Format, R15}, Client.ClientState, UIController, InputController,
	              InteractionController, Client.UI.{Components, Theme}

	The ISLAND MARKET window (spec §33, §64-§65, §88-§89). Opened by the
	market stall (click it → Sell tab) or the merchant (click him → Buy tab).

	SELL tab   today's demand bonus, one big "SELL ALL PRODUCE" button, and
	           every sellable item you own with Sell 1 / Sell All.
	BUY tab    Seeds · Animals · Tools · Upgrades from ShopConfig, showing
	           ✔ affordable / 🔒 level / OWNED / MAX states.

	Prices shown are an ESTIMATE using the same formula as the server
	(SellValue x GlobalSellMultiplier x demand). The server recomputes every
	price itself and re-checks distance, stock and funds — the client only
	sends SellItemRequest(itemId, qty) / PurchaseRequest(shopItemId, qty).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ShopConfig = require(Shared.Config.ShopConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local Format = require(Shared.Util.Format)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local InteractionController = require(script.Parent.InteractionController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local SELL_ALL = "__ALL__"
local WALK_AWAY_DISTANCE = ShopConfig.MarketRange + 8

local ShopController = {}

type Refs = {
	Panel: Frame,
	SellTab: TextButton,
	BuyTab: TextButton,
	SellPage: Frame,
	BuyPage: Frame,
	Demand: TextLabel,
	SellAll: TextButton,
	SellList: ScrollingFrame,
	SellEmpty: TextLabel,
	CategoryButtons: { [string]: TextButton },
	BuyList: ScrollingFrame,
}

local refs: Refs
local open = false
local tab = "Sell"
local buyCategory = "Seeds"
local releases: { () -> () } = {}
local sellRows: { Frame } = {}
local buyCards: { Frame } = {}

---------------------------------------------------------------------------
-- Pricing / demand (display only)
---------------------------------------------------------------------------

local function demandTable(): { [string]: number }
	local raw = ReplicatedStorage:GetAttribute("MarketDemand")
	local result = {}
	if type(raw) ~= "string" or raw == "" then
		return result
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and type(decoded) == "table" then
		for _, entry in decoded do
			if type(entry) == "table" and type(entry.Item) == "string" and type(entry.Bonus) == "number" then
				result[entry.Item] = entry.Bonus
			end
		end
	end
	return result
end

local function priceOf(itemId: string, demand: { [string]: number }): number
	local def = ItemConfig.Get(itemId)
	if not def or def.SellValue <= 0 then
		return 0
	end
	return math.max(1, math.floor(def.SellValue * EconomyConfig.GlobalSellMultiplier * (1 + (demand[itemId] or 0))))
end

local function demandText(demand: { [string]: number }): string
	local parts = {}
	for itemId, bonus in demand do
		local def = ItemConfig.Get(itemId)
		if def then
			table.insert(parts, ("%s %s +%d%%"):format(def.Icon, def.DisplayName, math.floor(bonus * 100 + 0.5)))
		end
	end
	table.sort(parts)
	if #parts == 0 then
		return "📈 No special demand right now."
	end
	local endsAt = ReplicatedStorage:GetAttribute("MarketDemandEndsAt")
	local remaining = if type(endsAt) == "number" then math.max(0, endsAt - workspace:GetServerTimeNow()) else 0
	return ("📈 In demand: %s   ·   changes in %s"):format(table.concat(parts, "  ·  "), Format.Duration(math.ceil(remaining)))
end

---------------------------------------------------------------------------
-- Small UI helpers
---------------------------------------------------------------------------

local function plainButton(props: Components.ButtonProps): TextButton
	local button = Components.Button(props)
	for _, child in button:GetChildren() do
		if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
			child:Destroy()
		end
	end
	return button
end

local function setButtonEnabled(button: TextButton, enabled: boolean, color: Color3)
	button.Active = enabled
	button.AutoButtonColor = false
	Components.SetButtonColor(button, if enabled then color else Theme.Colors.PanelDark)
	button.TextColor3 = if enabled then Theme.Colors.TextLight else Theme.Colors.TextMuted
end

---------------------------------------------------------------------------
-- SELL page
---------------------------------------------------------------------------

local function sellRow(index: number): Frame
	local row = sellRows[index]
	if row then
		return row
	end
	row = Create("Frame", { Name = "Row", Size = UDim2.new(1, -10, 0, 58), BackgroundColor3 = Theme.Colors.PanelAlt, Parent = refs.SellList })
	Components.Corner(row, UDim.new(0, 14))
	Components.Stroke(row, Theme.Colors.Outline, 2)
	Components.Gloss(row, 0.3)
	local bubble = Create("Frame", { Name = "IconBubble", Size = UDim2.fromOffset(46, 46), Position = UDim2.fromOffset(7, 6), BackgroundColor3 = Theme.Colors.Panel, Parent = row })
	Components.Corner(bubble, UDim.new(1, 0))
	Components.Stroke(bubble, Theme.Colors.PanelDark, 2)
	Components.Label({ Name = "Icon", Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(6, 5), TextSize = 32, Text = "", ZIndex = 2, Parent = row })
	Components.Label({ Name = "Title", Size = UDim2.new(0.45, -60, 0, 26), Position = UDim2.fromOffset(60, 4), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Text = "", Parent = row })
	Components.Label({ Name = "Count", Size = UDim2.new(0.45, -60, 0, 20), Position = UDim2.fromOffset(60, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = 13, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = row })
	Components.Label({ Name = "Price", Size = UDim2.new(0.25, 0, 1, 0), Position = UDim2.fromScale(0.42, 0), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Text = "", Parent = row })
	plainButton({
		Name = "SellOne",
		Text = "Sell 1",
		Color = Theme.Colors.Blue,
		Size = UDim2.new(0.15, 0, 0, 40),
		Position = UDim2.new(0.68, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextSize = Theme.TextSize.Small,
		Parent = row,
		OnClick = function()
			local itemId = row:GetAttribute("ItemId")
			if type(itemId) == "string" then
				Net.FireServer("SellItemRequest", itemId, 1)
			end
		end,
	})
	plainButton({
		Name = "SellAll",
		Text = "Sell All",
		Color = Theme.Colors.Green,
		Size = UDim2.new(0.15, 0, 0, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = Theme.TextSize.Small,
		Parent = row,
		OnClick = function()
			local itemId = row:GetAttribute("ItemId")
			if type(itemId) == "string" then
				Net.FireServer("SellItemRequest", itemId, "All")
			end
		end,
	})
	sellRows[index] = row
	return row
end

local function categoryOrder(): { [string]: number }
	local order = {}
	for index, category in ItemConfig.Categories do
		order[category.Id] = index
	end
	return order
end
local CATEGORY_ORDER = categoryOrder()

local function renderSell()
	local demand = demandTable()
	refs.Demand.Text = demandText(demand)
	local items = ClientState.Get("Inventory", "Items") or {}

	local owned = {}
	local sellAllTotal, sellAllCount = 0, 0
	for itemId, count in items do
		local def = ItemConfig.Get(itemId)
		if def and count > 0 and def.SellValue > 0 then
			table.insert(owned, def)
			if ShopConfig.SellAllCategories[def.Category] then
				sellAllTotal += priceOf(itemId, demand) * count
				sellAllCount += count
			end
		end
	end
	table.sort(owned, function(a, b)
		local orderA, orderB = CATEGORY_ORDER[a.Category] or 99, CATEGORY_ORDER[b.Category] or 99
		if orderA ~= orderB then
			return orderA < orderB
		end
		return a.DisplayName < b.DisplayName
	end)

	setButtonEnabled(refs.SellAll, sellAllCount > 0, Theme.Colors.Green)
	refs.SellAll.Text = if sellAllCount > 0
		then ("💰 SELL ALL PRODUCE  (%d items ≈ %s 🪙)"):format(sellAllCount, Format.Commas(sellAllTotal))
		else "💰 SELL ALL PRODUCE  (crops, fish, milk & eggs)"

	for index, def in owned do
		local row = sellRow(index)
		row.Visible = true
		row.LayoutOrder = index
		row:SetAttribute("ItemId", def.Id)
		local count = items[def.Id] or 0
		local price = priceOf(def.Id, demand)
		local bonus = demand[def.Id]
		;(row:FindFirstChild("Icon") :: TextLabel).Text = def.Icon
		;(row:FindFirstChild("Title") :: TextLabel).Text = def.DisplayName
		;(row:FindFirstChild("Count") :: TextLabel).Text = ("x%d owned"):format(count)
		local priceLabel = row:FindFirstChild("Price") :: TextLabel
		priceLabel.Text = if bonus
			then ("%s 🪙 each\n📈 +%d%%"):format(Format.Commas(price), math.floor(bonus * 100 + 0.5))
			else ("%s 🪙 each"):format(Format.Commas(price))
		priceLabel.TextColor3 = if bonus then Theme.Colors.Orange else Theme.Colors.Text
		row.BackgroundColor3 = if bonus then Color3.fromRGB(255, 238, 200) else Theme.Colors.PanelAlt
	end
	for index = #owned + 1, #sellRows do
		sellRows[index].Visible = false
	end
	refs.SellEmpty.Visible = #owned == 0
end

---------------------------------------------------------------------------
-- BUY page
---------------------------------------------------------------------------

local function buyCard(index: number): Frame
	local card = buyCards[index]
	if card then
		return card
	end
	card = Create("Frame", { Name = "Card", BackgroundColor3 = Theme.Colors.PanelAlt, Parent = refs.BuyList })
	Components.Corner(card, UDim.new(0, 16))
	Components.Stroke(card, Theme.Colors.Outline, 2.5)
	Components.Gloss(card, 0.3)
	local bubble = Create("Frame", { Name = "IconBubble", Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(6, 6), BackgroundColor3 = Theme.Colors.Panel, Parent = card })
	Components.Corner(bubble, UDim.new(1, 0))
	Components.Stroke(bubble, Theme.Colors.PanelDark, 2)
	Components.Label({ Name = "Icon", Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(6, 6), TextSize = 34, Text = "", ZIndex = 2, Parent = card })
	Components.Label({ Name = "Title", Size = UDim2.new(1, -66, 0, 24), Position = UDim2.fromOffset(60, 8), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, TextScaled = true, Text = "", Parent = card })
	Components.Label({ Name = "Price", Size = UDim2.new(1, -66, 0, 22), Position = UDim2.fromOffset(60, 32), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Text = "", Parent = card })
	Components.Label({
		Name = "Description",
		Size = UDim2.new(1, -14, 0, 48),
		Position = UDim2.fromOffset(7, 60),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.Fonts.Body,
		TextSize = 12,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "",
		Parent = card,
	})
	local function buy(quantity: number)
		local shopId = card:GetAttribute("ShopId")
		if type(shopId) == "string" and card:GetAttribute("CanBuy") == true then
			Net.FireServer("PurchaseRequest", shopId, quantity)
		elseif card:GetAttribute("Reason") then
			UIController.Notify("Error", tostring(card:GetAttribute("Reason")))
		end
	end
	plainButton({
		Name = "Buy",
		Text = "BUY",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, -14, 0, 36),
		Position = UDim2.new(0, 7, 1, -8),
		AnchorPoint = Vector2.new(0, 1),
		TextSize = Theme.TextSize.Small,
		Parent = card,
		OnClick = function()
			buy(1)
		end,
	})
	plainButton({
		Name = "BuyBulk",
		Text = "x5",
		Color = Theme.Colors.Blue,
		Size = UDim2.new(0.35, -8, 0, 36),
		Position = UDim2.new(1, -7, 1, -8),
		AnchorPoint = Vector2.new(1, 1),
		TextSize = Theme.TextSize.Small,
		Parent = card,
		OnClick = function()
			local bulk = card:GetAttribute("Bulk")
			if type(bulk) == "number" then
				buy(bulk)
			end
		end,
	})
	buyCards[index] = card
	return card
end

local function costText(def: any, quantity: number, coins: number, items: { [string]: number }): (string, boolean)
	local canAfford = coins >= def.Price * quantity
	local parts = { Format.Commas(def.Price * quantity) .. " 🪙" }
	for itemId, amount in def.Items or {} do
		local item = ItemConfig.Get(itemId)
		local need = amount * quantity
		canAfford = canAfford and (items[itemId] or 0) >= need
		table.insert(parts, ("%d %s"):format(need, if item then item.Icon else itemId))
	end
	return table.concat(parts, " + "), canAfford
end

local function renderBuy()
	for id, button in refs.CategoryButtons do
		Components.SetButtonColor(button, if id == buyCategory then Theme.Colors.Coins else Theme.Colors.PanelAlt)
	end
	local coins = ClientState.Get("Coins") or 0
	local items = ClientState.Get("Inventory", "Items") or {}
	local ownedTools = ClientState.Get("Tools", "Owned") or {}
	local upgrades = ClientState.Get("Island", "Upgrades") or {}
	local level = ClientState.Get("Island", "Level") or 1

	local defs = {}
	for _, def in ShopConfig.Items do
		if def.Category == buyCategory then
			table.insert(defs, def)
		end
	end
	table.sort(defs, function(a, b)
		return a.Order < b.Order
	end)

	for index, def in defs do
		local card = buyCard(index)
		card.Visible = true
		card.LayoutOrder = index
		card:SetAttribute("ShopId", def.Id)
		card:SetAttribute("Bulk", def.Bulk)
		local price, canAfford = costText(def, 1, coins, items)
		local reason: string? = nil
		local status: string? = nil
		if level < (def.UnlockLevel or 1) then
			reason = ("Unlocks at Island Level %d."):format(def.UnlockLevel)
			status = ("🔒 Level %d"):format(def.UnlockLevel)
		elseif def.Grant.Tool and ownedTools[def.Grant.Tool] then
			reason = "You already own that."
			status = "✔ OWNED"
		elseif def.Grant.Upgrade and def.MaxOwned and (upgrades[def.Grant.Upgrade] or 0) >= def.MaxOwned then
			reason = "Fully upgraded."
			status = "✔ MAX"
		elseif not canAfford then
			reason = "You can't afford that yet."
		end
		card:SetAttribute("CanBuy", reason == nil)
		card:SetAttribute("Reason", reason)

		;(card:FindFirstChild("Icon") :: TextLabel).Text = def.Icon
		;(card:FindFirstChild("Title") :: TextLabel).Text = def.DisplayName
		local priceLabel = card:FindFirstChild("Price") :: TextLabel
		priceLabel.Text = if def.Grant.Upgrade and def.MaxOwned
			then ("%s  ·  %d/%d"):format(price, upgrades[def.Grant.Upgrade] or 0, def.MaxOwned)
			else price
		priceLabel.TextColor3 = if canAfford then Theme.Colors.Green else Theme.Colors.Red
		;(card:FindFirstChild("Description") :: TextLabel).Text = def.Description or ""

		local buyButton = card:FindFirstChild("Buy") :: TextButton
		local bulkButton = card:FindFirstChild("BuyBulk") :: TextButton
		local hasBulk = type(def.Bulk) == "number"
		buyButton.Size = if hasBulk then UDim2.new(0.65, -10, 0, 36) else UDim2.new(1, -14, 0, 36)
		buyButton.Text = status or "BUY"
		setButtonEnabled(buyButton, reason == nil, Theme.Colors.Green)
		bulkButton.Visible = hasBulk and status == nil
		if hasBulk then
			local _, bulkAffordable = costText(def, def.Bulk, coins, items)
			bulkButton.Text = "x" .. def.Bulk
			setButtonEnabled(bulkButton, bulkAffordable and status == nil, Theme.Colors.Blue)
		end
		card.BackgroundColor3 = if status then Theme.Colors.PanelDark else Theme.Colors.PanelAlt
	end
	for index = #defs + 1, #buyCards do
		buyCards[index].Visible = false
	end
end

---------------------------------------------------------------------------
-- Window
---------------------------------------------------------------------------

local function render()
	if not open then
		return
	end
	refs.SellPage.Visible = tab == "Sell"
	refs.BuyPage.Visible = tab == "Buy"
	Components.SetButtonColor(refs.SellTab, if tab == "Sell" then Theme.Colors.Green else Theme.Colors.PanelDark)
	Components.SetButtonColor(refs.BuyTab, if tab == "Buy" then Theme.Colors.Blue else Theme.Colors.PanelDark)
	if tab == "Sell" then
		renderSell()
	else
		renderBuy()
	end
end

local function setTab(newTab: string)
	tab = newTab
	render()
end

function ShopController.IsOpen(): boolean
	return open
end

function ShopController.Close()
	if not open then
		return
	end
	open = false
	refs.Panel.Visible = false
	UIController.SetModalOpen("Market", false)
	for _, release in releases do
		release()
	end
	table.clear(releases)
end

function ShopController.Open(newTab: string?)
	if newTab == "Sell" or newTab == "Buy" then
		tab = newTab
	end
	if open then
		render()
		return
	end
	if UIController.IsAnyModalOpen() then
		return
	end
	open = true
	refs.Panel.Visible = true
	Components.Bounce(refs.Panel, 0.05)
	UIController.SetModalOpen("Market", true)
	table.insert(releases, InputController.Block("UseTool"))
	table.insert(releases, InteractionController.PausePrompts())
	render()
end

local function buildUI()
	local panel, content = Components.Panel({
		Title = "🛒 ISLAND MARKET",
		Size = UDim2.fromOffset(780, 520),
		Parent = UIController.GetModalLayer(),
		OnClose = ShopController.Close,
	})
	panel.Name = "Market"
	panel.Visible = false

	local sellTab = plainButton({ Name = "SellTab", Text = "💰 SELL", Color = Theme.Colors.Green, Size = UDim2.fromOffset(150, 42), Parent = content, OnClick = function()
		setTab("Sell")
	end })
	local buyTab = plainButton({ Name = "BuyTab", Text = "🛍️ BUY", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(150, 42), Position = UDim2.fromOffset(160, 0), Parent = content, OnClick = function()
		setTab("Buy")
	end })

	-- SELL page ---------------------------------------------------------------
	local sellPage = Create("Frame", { Name = "SellPage", Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1, Parent = content })
	local demand = Components.Label({
		Name = "Demand",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(255, 232, 180),
		Font = Theme.Fonts.Bold,
		TextSize = 14,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		Text = "",
		Parent = sellPage,
	})
	Components.Corner(demand, Theme.SmallCorner)
	Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = demand })
	local sellAll = plainButton({
		Name = "SellEverything",
		Text = "💰 SELL ALL PRODUCE",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromOffset(0, 38),
		TextSize = Theme.TextSize.Medium,
		Parent = sellPage,
		OnClick = function()
			Net.FireServer("SellItemRequest", SELL_ALL, 1)
		end,
	})
	local sellList = Create("ScrollingFrame", {
		Name = "Items",
		Size = UDim2.new(1, 0, 1, -98),
		Position = UDim2.fromOffset(0, 98),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = sellPage,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local sellEmpty = Components.Label({
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 120),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "Nothing to sell yet — harvest crops, catch fish or collect milk & eggs!",
		Visible = false,
		Parent = sellPage,
	})

	-- BUY page ----------------------------------------------------------------
	local buyPage = Create("Frame", { Name = "BuyPage", Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1, Visible = false, Parent = content })
	local categoryRow = Create("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = buyPage }, {
		Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local categoryButtons = {}
	for index, category in ShopConfig.Categories do
		local button = plainButton({
			Name = category.Id,
			Text = category.Icon .. " " .. category.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.fromOffset(140, 36),
			TextSize = Theme.TextSize.Small,
			Parent = categoryRow,
			OnClick = function()
				buyCategory = category.Id
				renderBuy()
			end,
		})
		button.LayoutOrder = index
		categoryButtons[category.Id] = button
	end
	local buyList = Create("ScrollingFrame", {
		Name = "Items",
		Size = UDim2.new(1, 0, 1, -46),
		Position = UDim2.fromOffset(0, 46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = buyPage,
	}, {
		Create("UIGridLayout", { CellSize = UDim2.fromOffset(236, 158), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})

	refs = {
		Panel = panel,
		SellTab = sellTab,
		BuyTab = buyTab,
		SellPage = sellPage,
		BuyPage = buyPage,
		Demand = demand,
		SellAll = sellAll,
		SellList = sellList,
		SellEmpty = sellEmpty,
		CategoryButtons = categoryButtons,
		BuyList = buyList,
	}
end

local function marketStallPosition(): Vector3?
	local islands = workspace:FindFirstChild("Islands")
	local island = islands and islands:FindFirstChild("Island_" .. player.UserId)
	local stall = island and island:FindFirstChild("MarketStall", true)
	return if stall and stall:IsA("Model") then stall:GetPivot().Position else nil
end

function ShopController.Init()
	buildUI()
end

function ShopController.Start()
	Net.OnClientEvent("OpenUI", function(payload: any)
		if type(payload) == "table" and payload.Screen == "Market" then
			ShopController.Open(payload.Tab)
		end
	end)
	InputController.On("Cancel", ShopController.Close)
	for _, key in { "Coins", "Inventory", "Tools", "Island" } do
		ClientState.Observe(key, render)
	end
	ReplicatedStorage:GetAttributeChangedSignal("MarketDemand"):Connect(render)

	-- Close when the player walks away; keep the demand timer ticking.
	task.spawn(function()
		while true do
			task.wait(1)
			if open then
				local root = R15.GetRootPart(player.Character)
				local stall = marketStallPosition()
				if root and stall and (root.Position - stall).Magnitude > WALK_AWAY_DISTANCE then
					ShopController.Close()
				elseif tab == "Sell" then
					refs.Demand.Text = demandText(demandTable())
				end
			end
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">SocialController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  SocialController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/SocialController
	DEPENDENCIES: Shared.Net, Client.ClientState, UIController, InputController, AnimationController,
	              AudioController, Client.UI.{Components, Theme}

	Two small left-menu features:

	  😀 EMOTES (T)   a pop-up row: Wave · Cheer · Point · Dance. The server
	                  plays the emote on your character, so everyone nearby
	                  sees it (EmoteRequest). Your own client starts it at
	                  once for instant feedback.
	  ⚙️ SETTINGS     music volume, sound-effects volume, camera shake.
	                  Saved in your profile (SettingsRequest).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local AnimationController = require(script.Parent.AnimationController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local EMOTES = {
	{ Id = "Wave", Icon = "👋" },
	{ Id = "Cheer", Icon = "🙌" },
	{ Id = "Point", Icon = "👉" },
	{ Id = "Dance", Icon = "💃" },
}

local SocialController = {}

local emoteBar: Frame
local settingsWindow: Frame
local settingsOpen = false
local lastEmote = 0
type Slider = { Fill: Frame, Value: TextLabel, Key: string }
local sliders: { Slider } = {}
local shakeButton: TextButton

---------------------------------------------------------------------------
-- Emotes
---------------------------------------------------------------------------

local function playEmote(id: string)
	local now = os.clock()
	if now - lastEmote < 0.6 then
		return
	end
	lastEmote = now
	emoteBar.Visible = false
	AnimationController.PlayLocal(id, 1)
	Net.FireServer("EmoteRequest", id)
end

local function toggleEmotes()
	if UIController.IsAnyModalOpen() then
		return
	end
	emoteBar.Visible = not emoteBar.Visible
	if emoteBar.Visible then
		Components.PopIn(emoteBar)
	end
end

---------------------------------------------------------------------------
-- Settings
---------------------------------------------------------------------------

local function refreshSettings()
	local settings = ClientState.Get("Settings") or {}
	for _, slider in sliders do
		local value = settings[slider.Key]
		value = if type(value) == "number" then value else 0.5
		slider.Fill.Size = UDim2.fromScale(value, 1)
		slider.Value.Text = ("%d%%"):format(math.floor(value * 100 + 0.5))
	end
	local shake = settings.CameraShake ~= false
	shakeButton.Text = if shake then "📳 Camera shake: ON" else "📴 Camera shake: OFF"
	Components.SetButtonColor(shakeButton, if shake then Theme.Colors.Green else Theme.Colors.PanelDark)
end

local function step(key: string, delta: number)
	local current = ClientState.Get("Settings", key)
	current = if type(current) == "number" then current else 0.5
	local value = math.clamp(math.floor((current + delta) * 10 + 0.5) / 10, 0, 1)
	Net.FireServer("SettingsRequest", { [key] = value })
end

local function makeSlider(parent: Instance, y: number, label: string, key: string)
	Components.Label({ Text = label, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, y), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Parent = parent })
	Components.Button({ Text = "−", Color = Theme.Colors.Red, Size = UDim2.fromOffset(44, 40), Position = UDim2.fromOffset(0, y + 28), TextSize = Theme.TextSize.Large, Parent = parent, OnClick = function()
		step(key, -0.1)
	end })
	local track = Create("Frame", { Size = UDim2.new(1, -170, 0, 22), Position = UDim2.fromOffset(54, y + 37), BackgroundColor3 = Theme.Colors.PanelDark, Parent = parent })
	Components.Corner(track, UDim.new(1, 0))
	Components.Stroke(track, Theme.Colors.Outline, 2)
	local fill = Create("Frame", { Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = Theme.Colors.Blue, Parent = track })
	Components.Corner(fill, UDim.new(1, 0))
	Components.Button({ Text = "+", Color = Theme.Colors.Green, Size = UDim2.fromOffset(44, 40), Position = UDim2.new(1, -106, 0, y + 28), TextSize = Theme.TextSize.Large, Parent = parent, OnClick = function()
		step(key, 0.1)
	end })
	local value = Components.Label({ Text = "50%", Size = UDim2.fromOffset(56, 40), Position = UDim2.new(1, -56, 0, y + 28), TextSize = Theme.TextSize.Medium, Parent = parent })
	table.insert(sliders, { Fill = fill, Value = value, Key = key })
end

local function closeSettings()
	if settingsOpen then
		settingsOpen = false
		settingsWindow.Visible = false
		UIController.SetModalOpen("Settings", false)
	end
end

local function openSettings()
	if settingsOpen or UIController.IsAnyModalOpen() then
		return
	end
	settingsOpen = true
	settingsWindow.Visible = true
	UIController.SetModalOpen("Settings", true)
	Components.PopIn(settingsWindow)
	AudioController.Play("UIOpen")
	refreshSettings()
end

---------------------------------------------------------------------------

function SocialController.Init()
	emoteBar = Create("Frame", {
		Name = "EmoteBar",
		Size = UDim2.fromOffset(4 * 86 + 16, 96),
		Position = UDim2.new(0.5, 0, 1, -126),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundColor3 = Theme.Colors.Panel,
		Visible = false,
		Parent = UIController.GetOverlay(),
	}, {
		Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Components.Corner(emoteBar)
	Components.Stroke(emoteBar, Theme.Colors.Outline, 3)
	for index, emote in EMOTES do
		local button = Components.Button({
			Name = emote.Id,
			Text = emote.Icon .. "\n" .. emote.Id,
			Color = Theme.Colors.Pink,
			Size = UDim2.fromOffset(80, 80),
			TextSize = Theme.TextSize.Small,
			Parent = emoteBar,
			OnClick = function()
				playEmote(emote.Id)
			end,
		})
		button.LayoutOrder = index
	end

	local content, closeButton
	settingsWindow, content, closeButton = Components.Panel({ Title = "⚙️ Settings", Size = UDim2.fromOffset(460, 360), Parent = UIController.GetModalLayer(), Color = Theme.Colors.Blue })
	settingsWindow.Visible = false
	closeButton.Activated:Connect(closeSettings)
	makeSlider(content, 0, "🎵 Music", "MusicVolume")
	makeSlider(content, 84, "🔊 Sound effects", "SfxVolume")
	shakeButton = Components.Button({ Text = "", Color = Theme.Colors.Green, Size = UDim2.new(1, 0, 0, 48), Position = UDim2.fromOffset(0, 184), Parent = content, OnClick = function()
		Net.FireServer("SettingsRequest", { CameraShake = ClientState.Get("Settings", "CameraShake") == false })
	end })

	Components.IconButton({ Icon = "😀", Caption = "Emotes", Key = "T", Color = Theme.Colors.Pink, Parent = UIController.GetSlot("Left"), LayoutOrder = 4, OnClick = toggleEmotes })
	Components.IconButton({ Icon = "⚙️", Caption = "Settings", Color = Theme.Colors.Glass, Parent = UIController.GetSlot("Left"), LayoutOrder = 5, OnClick = openSettings })
end

function SocialController.Start()
	InputController.On("Emotes", toggleEmotes)
	InputController.On("Cancel", function()
		emoteBar.Visible = false
		closeSettings()
	end)
	ClientState.Observe("Settings", function()
		if settingsOpen then
			refreshSettings()
		end
	end)
end

return SocialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/ToolController
	DEPENDENCIES: Shared.Net, Shared.Config.{ToolConfig, ItemConfig}, Client.ClientState, InputController,
	              AnimationController, UIController, Client.UI.{Hotbar, Components, Theme}

	What's in your hands, client side:
	  * renders the hotbar (tools + holdable items with counts) from
	    replicated Tools / Inventory state,
	  * number keys 1-9 / taps / gamepad bumpers REQUEST equips (the server
	    decides, attaches the model and sets the hold pose everyone sees),
	    0 / ` empties your hands,
	  * GetHeld() tells InteractionController what you hold (from the
	    character's Held / HeldKind attributes the server sets),
	  * shows a big USE button on touch devices while something is held.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ToolConfig = require(Shared.Config.ToolConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Signal = require(Shared.Util.Signal)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local InputController = require(script.Parent.InputController)
local AnimationController = require(script.Parent.AnimationController)
local UIController = require(script.Parent.UIController)
local Hotbar = require(Client.UI.Hotbar)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local EQUIP_DEBOUNCE = 0.12

local ToolController = {}

export type Held = { Kind: string, Id: string, Def: any }

ToolController.EquippedChanged = Signal.new() -- (held: Held?)

local hotbar: any
local useButton: TextButton
local heldId: string? = nil
local lastEquipRequest = 0
local characterConnection: RBXScriptConnection? = nil

function ToolController.GetHeld(): Held?
	if not heldId then
		return nil
	end
	local tool = ToolConfig.Get(heldId)
	if tool then
		return { Kind = "Tool", Id = heldId, Def = tool }
	end
	local item = ItemConfig.Get(heldId)
	if item then
		return { Kind = "Item", Id = heldId, Def = item }
	end
	return nil
end

-- The held TOOL definition (nil for items / empty hands).
function ToolController.GetEquipped(): any
	return heldId and ToolConfig.Get(heldId)
end

function ToolController.RequestEquip(id: string?)
	local now = os.clock()
	if now - lastEquipRequest < EQUIP_DEBOUNCE then
		return
	end
	lastEquipRequest = now
	Net.FireServer("EquipToolRequest", id or "")
end

local function selectSlot(index: number)
	local id = hotbar:GetToolAt(index)
	if not id then
		return
	end
	ToolController.RequestEquip(if id == heldId then nil else id)
end

local function cycle(direction: number)
	local ids = ClientState.Get("Tools", "Hotbar") or {}
	if #ids == 0 then
		return
	end
	local currentIndex = if heldId then table.find(ids, heldId) else nil
	local nextIndex = if currentIndex then (currentIndex - 1 + direction) % #ids + 1 else 1
	ToolController.RequestEquip(ids[nextIndex])
end

local function onHeldChanged(id: string?)
	if id == "" then
		id = nil
	end
	heldId = id
	hotbar:SetEquipped(id)
	local held = ToolController.GetHeld()
	useButton.Visible = held ~= nil and InputController.IsTouch()
	if held then
		useButton.Text = held.Def.Icon .. "\nUSE"
	end
	ToolController.EquippedChanged:Fire(held)
end

local function watchCharacter(character: Model)
	if characterConnection then
		characterConnection:Disconnect()
	end
	characterConnection = character:GetAttributeChangedSignal("Held"):Connect(function()
		onHeldChanged(character:GetAttribute("Held") :: string?)
	end)
	onHeldChanged(character:GetAttribute("Held") :: string?)
end

local function refreshHotbar()
	local tools = ClientState.Get("Tools")
	local items = ClientState.Get("Inventory", "Items") or {}
	if type(tools) == "table" then
		hotbar:SetTools(tools.Hotbar or {}, items)
		hotbar:SetEquipped(heldId)
	end
end

function ToolController.Init()
	hotbar = Hotbar.new(UIController.GetSlot("Bottom"), selectSlot)
	useButton = Components.Button({
		Name = "UseButton",
		Text = "USE",
		Color = Theme.Colors.Orange,
		Size = UDim2.fromOffset(110, 110),
		TextSize = Theme.TextSize.Large,
		Parent = UIController.GetSlot("Touch"),
		OnClick = function()
			InputController.Trigger("UseTool")
		end,
	})
	Components.Corner(useButton, UDim.new(1, 0))
	local bevel = useButton:FindFirstChild("Bevel")
	if bevel then
		bevel:Destroy()
	end
	useButton.Visible = false
	-- Hold support (the fishing reel is "hold to pull").
	useButton.MouseButton1Down:Connect(function()
		InputController.SetHeld("UseTool", true)
	end)
	useButton.MouseButton1Up:Connect(function()
		if InputController.IsHeld("UseTool") then
			InputController.SetHeld("UseTool", false)
		end
	end)
	useButton.MouseLeave:Connect(function()
		if InputController.IsHeld("UseTool") then
			InputController.SetHeld("UseTool", false)
		end
	end)
end

function ToolController.Start()
	ClientState.Observe("Tools", refreshHotbar)
	ClientState.Observe("Inventory", function(inventory)
		if type(inventory) == "table" then
			hotbar:SetCounts(inventory.Items or {})
		end
	end)

	for index = 1, ToolConfig.HotbarSize do
		InputController.On("Hotbar" .. index, function()
			selectSlot(index)
		end)
	end
	InputController.On("HotbarNext", function()
		cycle(1)
	end)
	InputController.On("HotbarPrevious", function()
		cycle(-1)
	end)
	InputController.On("Unequip", function()
		ToolController.RequestEquip(nil)
	end)
	InputController.DeviceChanged:Connect(function()
		useButton.Visible = heldId ~= nil and InputController.IsTouch()
	end)

	AnimationController.CharacterReady:Connect(watchCharacter)
	local character = Players.LocalPlayer.Character
	if character then
		watchCharacter(character)
	end
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">TradeController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  TradeController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/TradeController
	DEPENDENCIES: Shared.Net, Shared.Config.ItemConfig, Shared.Util.Format, Client.ClientState, UIController,
	              AudioController, Client.UI.{Components, Theme}

	Player-to-player TRADING, client side. It only ever SHOWS what the
	server's TradeService says (TradeEvent) and sends requests:

	  invite popup    "<name> wants to trade!"  ACCEPT / DECLINE
	  trade window    YOUR BACKPACK (click an item to offer one more)
	                  YOUR OFFER    (click an offered item to take one back,
	                                 type coins, then READY)
	                  THEIR OFFER   (live, with their ready tick)
	When both are ready a 3-second countdown runs; any change un-readies
	both players, so nobody can swap items at the last second.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ItemConfig = require(Shared.Config.ItemConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local CELL = 74

local TradeController = {}

type Grid = { Frame: ScrollingFrame, Cells: { TextButton }, OnClick: ((string) -> ())? }

local window: Frame
local titleLabel: TextLabel
local backpack: Grid
local mine: Grid
local theirs: Grid
local coinsBox: TextBox
local theirCoins: TextLabel
local readyButton: TextButton
local theirReady: TextLabel
local status: TextLabel
local invitesFrame: Frame
local state: any = nil
local isOpen = false

---------------------------------------------------------------------------
-- Item grids
---------------------------------------------------------------------------

local function newGrid(parent: Instance, size: UDim2, position: UDim2): Grid
	local frame = Create("ScrollingFrame", {
		Size = size,
		Position = position,
		BackgroundColor3 = Theme.Colors.PanelDark,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, {
		Create("UIGridLayout", { CellSize = UDim2.fromOffset(CELL, CELL), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 6) }),
	})
	Components.Corner(frame, Theme.SmallCorner)
	return { Frame = frame, Cells = {}, OnClick = nil }
end

-- Fills a grid with { itemId = count } (sorted by name). onClick(itemId) optional.
local function fillGrid(grid: Grid, items: { [string]: number }, onClick: ((string) -> ())?)
	local ids = {}
	for itemId, count in items do
		if count > 0 and ItemConfig.Get(itemId) then
			table.insert(ids, itemId)
		end
	end
	table.sort(ids, function(a, b)
		return (ItemConfig.Get(a) :: any).DisplayName < (ItemConfig.Get(b) :: any).DisplayName
	end)
	for index, itemId in ids do
		local cell = grid.Cells[index]
		if not cell then
			cell = Create("TextButton", { Size = UDim2.fromOffset(CELL, CELL), BackgroundColor3 = Theme.Colors.Panel, AutoButtonColor = true, Text = "", Parent = grid.Frame })
			Components.Corner(cell, Theme.SmallCorner)
			Components.Stroke(cell, Theme.Colors.Outline, 2)
			Components.Label({ Name = "Icon", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 4), TextSize = 32, Parent = cell })
			Components.Label({ Name = "Name", Size = UDim2.new(1, -6, 0, 14), Position = UDim2.new(0, 3, 1, -18), Font = Theme.Fonts.Bold, TextScaled = true, TextColor3 = Theme.Colors.TextMuted, Parent = cell })
			local count = Components.Label({ Name = "Count", Size = UDim2.fromOffset(50, 18), Position = UDim2.new(1, -4, 0, 2), AnchorPoint = Vector2.new(1, 0), Font = Theme.Fonts.Heavy, TextSize = 15, TextColor3 = Theme.Colors.TextLight, TextXAlignment = Enum.TextXAlignment.Right, Parent = cell })
			Components.TextStroke(count, Theme.Colors.Outline, 2)
			cell.Activated:Connect(function()
				local itemId = cell:GetAttribute("ItemId")
				local handler = grid.OnClick
				if type(itemId) == "string" and handler then
					AudioController.Play("UIClick")
					handler(itemId)
				end
			end)
			grid.Cells[index] = cell
		end
		local def = ItemConfig.Get(itemId) :: any
		cell.Visible = true
		cell.LayoutOrder = index
		cell:SetAttribute("ItemId", itemId)
		cell.AutoButtonColor = onClick ~= nil;
		(cell:FindFirstChild("Icon") :: TextLabel).Text = def.Icon;
		(cell:FindFirstChild("Name") :: TextLabel).Text = def.DisplayName;
		(cell:FindFirstChild("Count") :: TextLabel).Text = "x" .. Format.Abbreviate(items[itemId])
	end
	for index = #ids + 1, #grid.Cells do
		grid.Cells[index].Visible = false
	end
	grid.OnClick = onClick
end

---------------------------------------------------------------------------
-- Window
---------------------------------------------------------------------------

local function send(payload: { [string]: any })
	Net.FireServer("TradeRequest", payload)
end

local function myOffer(): { Items: { [string]: number }, Coins: number }
	return (state and state.You and state.You.Offer) or { Items = {}, Coins = 0 }
end

local function render()
	if not state then
		return
	end
	local offer = myOffer()
	local owned = ClientState.Get("Inventory", "Items") or {}
	local available = {}
	for itemId, count in owned do
		available[itemId] = count - (offer.Items[itemId] or 0)
	end
	fillGrid(backpack, available, function(itemId)
		send({ Op = "Offer", ItemId = itemId, Amount = (myOffer().Items[itemId] or 0) + 1 })
	end)
	fillGrid(mine, offer.Items, function(itemId)
		send({ Op = "Offer", ItemId = itemId, Amount = math.max(0, (myOffer().Items[itemId] or 0) - 1) })
	end)
	local them = state.Them or {}
	local theirOffer = them.Offer or { Items = {}, Coins = 0 }
	fillGrid(theirs, theirOffer.Items, nil)
	titleLabel.Text = "Trading with " .. tostring(them.Name or "?")
	if not coinsBox:IsFocused() then
		coinsBox.Text = tostring(offer.Coins or 0)
	end
	theirCoins.Text = "🪙 " .. Format.Commas(theirOffer.Coins or 0)
	local ready = state.You and state.You.Ready
	readyButton.Text = if ready then "✔ READY (click to unlock)" else "READY"
	Components.SetButtonColor(readyButton, if ready then Theme.Colors.Green else Theme.Colors.Blue)
	theirReady.Text = if them.Ready then "✔ " .. tostring(them.Name) .. " is ready" else "⏳ " .. tostring(them.Name) .. " is choosing…"
	theirReady.TextColor3 = if them.Ready then Theme.Colors.Green else Theme.Colors.TextMuted
end

local function tickStatus()
	if not state then
		return
	end
	if state.Phase == "Confirming" then
		local left = math.max(0, state.ConfirmAt - workspace:GetServerTimeNow())
		status.Text = ("🔒 Both ready — trading in %d…"):format(math.ceil(left))
		status.TextColor3 = Theme.Colors.Green
	else
		status.Text = "Any change un-readies both players. Check their offer before you press READY!"
		status.TextColor3 = Theme.Colors.TextMuted
	end
end

local function openWindow()
	if not isOpen then
		isOpen = true
		window.Visible = true
		UIController.SetModalOpen("Trade", true)
		Components.PopIn(window)
		AudioController.Play("UIOpen")
	end
end

local function closeWindow()
	state = nil
	if isOpen then
		isOpen = false
		window.Visible = false
		UIController.SetModalOpen("Trade", false)
	end
end

local function buildWindow()
	local content, closeButton
	window, content, closeButton = Components.Panel({ Title = "🤝 Trade", Size = UDim2.fromOffset(940, 560), Parent = UIController.GetModalLayer(), Color = Theme.Colors.Orange })
	window.Visible = false
	closeButton.Activated:Connect(function()
		send({ Op = "Cancel" })
	end)
	titleLabel = Components.Label({ Size = UDim2.new(1, 0, 0, 28), TextSize = Theme.TextSize.Large, Text = "", Parent = content })

	local function header(text: string, x: number)
		Components.Label({ Text = text, Size = UDim2.fromOffset(292, 24), Position = UDim2.fromOffset(x, 34), TextSize = Theme.TextSize.Medium, Parent = content })
	end
	header("🎒 Your backpack", 0)
	header("📦 You give", 306)
	header("🎁 You get", 612)
	backpack = newGrid(content, UDim2.fromOffset(292, 330), UDim2.fromOffset(0, 62))
	mine = newGrid(content, UDim2.fromOffset(292, 270), UDim2.fromOffset(306, 62))
	theirs = newGrid(content, UDim2.fromOffset(292, 270), UDim2.fromOffset(612, 62))

	Components.Label({ Text = "🪙", Size = UDim2.fromOffset(36, 44), Position = UDim2.fromOffset(306, 340), TextSize = 28, Parent = content })
	coinsBox = Create("TextBox", {
		Size = UDim2.fromOffset(250, 44),
		Position = UDim2.fromOffset(346, 340),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Large,
		TextColor3 = Theme.Colors.Text,
		PlaceholderText = "0",
		ClearTextOnFocus = true,
		Text = "0",
		Parent = content,
	})
	Components.Corner(coinsBox, Theme.SmallCorner)
	Components.Stroke(coinsBox, Theme.Colors.Outline, 2)
	coinsBox.FocusLost:Connect(function()
		local amount = math.floor(tonumber(coinsBox.Text) or 0)
		local coins = ClientState.Get("Coins") or 0
		amount = math.clamp(amount, 0, coins)
		coinsBox.Text = tostring(amount)
		if amount ~= myOffer().Coins then
			send({ Op = "Coins", Amount = amount })
		end
	end)
	theirCoins = Components.Label({ Text = "🪙 0", Size = UDim2.fromOffset(292, 44), Position = UDim2.fromOffset(612, 340), TextSize = Theme.TextSize.Large, Parent = content })

	readyButton = Components.Button({ Text = "READY", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(292, 56), Position = UDim2.fromOffset(306, 400), Parent = content, OnClick = function()
		local ready = state and state.You and state.You.Ready
		send({ Op = "Ready", Ready = not ready })
	end })
	theirReady = Components.Label({ Text = "", Size = UDim2.fromOffset(292, 56), Position = UDim2.fromOffset(612, 400), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Medium, Parent = content })
	status = Components.Label({ Text = "", Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -26), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Parent = content })
	Components.Label({ Text = "Click an item to add it →", Size = UDim2.fromOffset(292, 30), Position = UDim2.fromOffset(0, 400), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Colors.TextMuted, Parent = content })
end

---------------------------------------------------------------------------
-- Invites
---------------------------------------------------------------------------

local function showInvite(fromUserId: number, fromName: string, expires: number)
	local existing = invitesFrame:FindFirstChild(tostring(fromUserId))
	if existing then
		existing:Destroy()
	end
	local card = Create("Frame", { Name = tostring(fromUserId), Size = UDim2.fromOffset(420, 96), BackgroundColor3 = Theme.Colors.Panel, Parent = invitesFrame })
	Components.Corner(card)
	Components.Stroke(card, Theme.Colors.Outline, 3)
	Components.Gradient(card, Color3.new(1, 1, 1), Theme.Colors.PanelAlt)
	Components.Label({ Text = "🤝 " .. fromName .. " wants to trade!", Size = UDim2.new(1, -16, 0, 34), Position = UDim2.fromOffset(8, 4), TextSize = Theme.TextSize.Medium, TextScaled = true, Parent = card })
	local function respond(accept: boolean)
		send({ Op = "Respond", UserId = fromUserId, Accept = accept })
		card:Destroy()
	end
	Components.Button({ Text = "ACCEPT", Color = Theme.Colors.Green, Size = UDim2.new(0.5, -12, 0, 44), Position = UDim2.fromOffset(8, 44), TextSize = Theme.TextSize.Small, Parent = card, OnClick = function()
		respond(true)
	end })
	Components.Button({ Text = "DECLINE", Color = Theme.Colors.Red, Size = UDim2.new(0.5, -12, 0, 44), Position = UDim2.new(0.5, 4, 0, 44), TextSize = Theme.TextSize.Small, Parent = card, OnClick = function()
		respond(false)
	end })
	Components.PopIn(card)
	AudioController.Play("TradeInvite")
	task.delay(expires, function()
		if card.Parent then
			card:Destroy()
		end
	end)
end

---------------------------------------------------------------------------
-- Public
---------------------------------------------------------------------------

function TradeController.Invite(userId: number)
	send({ Op = "Invite", UserId = userId })
end

function TradeController.IsTrading(): boolean
	return state ~= nil
end

function TradeController.Init()
	buildWindow()
	invitesFrame = Create("Frame", {
		Name = "TradeInvites",
		Size = UDim2.fromOffset(420, 320),
		Position = UDim2.new(0.5, 0, 0, 130),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = UIController.GetOverlay(),
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
end

function TradeController.Start()
	Net.OnClientEvent("TradeEvent", function(payload: any)
		if type(payload) ~= "table" then
			return
		end
		if payload.Op == "Invite" and type(payload.FromUserId) == "number" then
			showInvite(payload.FromUserId, tostring(payload.FromName), tonumber(payload.Expires) or 30)
		elseif payload.Op == "State" then
			state = payload
			local inviteCard = invitesFrame:FindFirstChild(tostring(payload.Them and payload.Them.UserId))
			if inviteCard then
				inviteCard:Destroy()
			end
			openWindow()
			render()
			tickStatus()
		elseif payload.Op == "Closed" then
			closeWindow()
			if type(payload.Reason) == "string" then
				UIController.Notify("Error", payload.Reason, "🤝")
			end
		end
	end)
	ClientState.Observe("Inventory", function()
		if isOpen then
			render()
		end
	end)
	Players.PlayerRemoving:Connect(function(leaving)
		local card = invitesFrame:FindFirstChild(tostring(leaving.UserId))
		if card then
			card:Destroy()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(0.2)
			if isOpen then
				tickStatus()
			end
		end
	end)
end

return TradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  UIController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/UIController
	DEPENDENCIES: Client.ClientState, AudioController, CameraController, Client.UI.{HUD, Notifications, Components, Theme},
	              Shared.Net, Shared.Config.ProgressionConfig, Shared.Config.ItemConfig, Shared.Util.Format

	Owns the ScreenGui, UI scaling, the HUD layout, notifications and modal
	windows. Every UI in the game is created through here once and updated in
	place when replicated state changes (spec §82, §116).

	WINDOWS: while any window is open the world behind it is dimmed and
	softly blurred (click the dim area to close windows — it sends the
	Cancel action). Build mode and the island creator have their own look.

	Automatic reward feedback (spec §68): whenever the replicated Coins value
	rises, the counter animates, bounces and a "+N 🪙" floats up with a coin
	sound; whenever an item count rises, "+N Wood" floats above the hotbar.
	No system has to remember to send its own popup.
]]

local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local AudioController = require(script.Parent.AudioController)
local InputController = require(script.Parent.InputController)
local CameraController = require(script.Parent.CameraController)
local Theme = require(Client.UI.Theme)
local Components = require(Client.UI.Components)
local HUD = require(Client.UI.HUD)
local Notifications = require(Client.UI.Notifications)

local UIController = {}

local screen: ScreenGui
local uiScale: UIScale
local hud: HUD.HUDRefs
local notifications: any
local modalLayer: Frame
local overlayLayer: Frame
local openModals: { [string]: boolean } = {}
local lastItems: { [string]: number }? = nil
local backdrop: TextButton
local blur: BlurEffect
local dimmed = false
local lastLevel: number? = nil

-- Screens with their own full-screen look (no dim / blur behind them).
local NO_BACKDROP = { Build = true, IslandCreator = true }

local function updateScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.min(viewport.X / Theme.DesignSize.X, viewport.Y / Theme.DesignSize.Y)
	uiScale.Scale = math.clamp(scale, 0.55, 1.35)
end

local function animateCounter(label: TextLabel, from: number, to: number)
	local value = Instance.new("NumberValue")
	value.Value = from
	value.Changed:Connect(function(current)
		label.Text = Format.Abbreviate(math.floor(current + 0.5))
	end)
	local tween = TweenService:Create(value, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Value = to })
	tween.Completed:Once(function()
		label.Text = Format.Abbreviate(to)
		value:Destroy()
	end)
	tween:Play()
end

local function pillFloatPosition(pill: Frame): UDim2
	-- Floats appear just under a top-bar pill (positions are in design space).
	local absolute = pill.AbsolutePosition + pill.AbsoluteSize / 2
	local scale = uiScale.Scale
	local screenOffset = screen.AbsolutePosition
	return UDim2.fromOffset((absolute.X - screenOffset.X) / scale, (absolute.Y - screenOffset.Y) / scale + 50)
end

local function watchCurrency(key: string, label: TextLabel, pill: Frame, color: Color3, icon: string)
	local last: number? = nil
	ClientState.Observe(key, function(value)
		if type(value) ~= "number" then
			return
		end
		if last == nil then
			label.Text = Format.Abbreviate(value)
		elseif value ~= last then
			animateCounter(label, last, value)
			local delta = value - last
			Components.Bounce(pill, 0.12)
			if delta > 0 then
				notifications:Float(("+%s %s"):format(Format.Abbreviate(delta), icon), color, pillFloatPosition(pill))
				AudioController.Play("CoinGain")
			else
				notifications:Float(("-%s %s"):format(Format.Abbreviate(-delta), icon), Theme.Colors.Red, pillFloatPosition(pill))
				AudioController.Play("CoinSpend")
			end
		end
		last = value
	end)
end

local function refreshPlayerCard()
	local level = ClientState.Get("Level") or 1
	local xp = ClientState.Get("XP") or 0
	local needed = ProgressionConfig.PlayerXPForLevel(level)
	hud.PlayerLevel.Text = tostring(level)
	hud.PlayerXP.SetProgress(xp / math.max(1, needed), true)
	hud.PlayerXPText.Text = ("%s / %s XP"):format(Format.Abbreviate(xp), Format.Abbreviate(needed))
	if lastLevel and level > lastLevel then
		Components.Bounce(hud.PlayerLevelBadge, 0.5)
	end
	lastLevel = level
end

local function refreshBackdrop()
	local wanted = false
	for name in openModals do
		if not NO_BACKDROP[name] then
			wanted = true
		end
	end
	if wanted == dimmed then
		return
	end
	dimmed = wanted
	backdrop.Visible = true
	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad)
	local fade = TweenService:Create(backdrop, info, { BackgroundTransparency = if wanted then 0.55 else 1 })
	fade:Play()
	TweenService:Create(blur, info, { Size = if wanted then 12 else 0 }):Play()
	if not wanted then
		fade.Completed:Once(function()
			if not dimmed then
				backdrop.Visible = false
			end
		end)
	end
end

local function watchItems()
	ClientState.Observe("Inventory", function(inventory)
		if type(inventory) ~= "table" or type(inventory.Items) ~= "table" then
			return
		end
		local items = inventory.Items
		if lastItems then
			local offset = 0
			for itemId, count in items do
				local previous = lastItems[itemId] or 0
				if count > previous then
					local def = ItemConfig.Get(itemId)
					if def then
						notifications:Float(
							("+%d %s %s"):format(count - previous, def.Icon, def.DisplayName),
							Theme.Colors.TextLight,
							UDim2.new(0.5, 0, 1, -150 - offset),
							50
						)
						offset += 34
					end
				end
			end
			if offset > 0 then
				AudioController.Play("ItemGain")
			end
		end
		lastItems = table.clone(items)
	end)
end

-- Public API ---------------------------------------------------------------

function UIController.GetScreen(): ScreenGui
	return screen
end

function UIController.GetSlot(name: string): Frame
	local slot = hud.Slots[name]
	assert(slot, "Unknown HUD slot " .. name)
	return slot
end

function UIController.GetModalLayer(): Frame
	return modalLayer
end

-- Converts a viewport point (UserInputService:GetMouseLocation) to design-space offsets.
function UIController.ViewportToDesign(point: Vector2): Vector2
	local inset = GuiService:GetGuiInset()
	local scale = if uiScale then uiScale.Scale else 1
	return (point - inset - screen.AbsolutePosition) / scale
end

function UIController.GetOverlay(): Frame
	return overlayLayer
end

function UIController.Notify(kind: string, text: string, icon: string?)
	notifications:Toast(kind, text, icon)
	AudioController.Play(if kind == "Error" then "UIError" else "UINotify")
end

function UIController.Banner(title: string, subtitle: string?, style: string?)
	notifications:Banner(title, subtitle, style)
	CameraController.Punch(3)
end

function UIController.Float(text: string, color: Color3, position: UDim2)
	notifications:Float(text, color, position)
end

-- Modal bookkeeping so gameplay can ask "is a menu open?"
function UIController.SetModalOpen(name: string, open: boolean)
	if open then
		openModals[name] = true
	else
		openModals[name] = nil
	end
	AudioController.Play(if open then "UIOpen" else "UIClose")
	refreshBackdrop()
end

function UIController.IsAnyModalOpen(): boolean
	return next(openModals) ~= nil
end

function UIController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	screen = Components.Create("ScreenGui", {
		Name = "IslandUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	-- Everything is authored at Theme.DesignSize and scaled to the device.
	local designRoot = Components.Create("Frame", {
		Name = "DesignRoot",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	uiScale = Components.Create("UIScale", { Parent = designRoot })
	updateScale()
	-- With UIScale the root must be sized in design units.
	local function resizeRoot()
		updateScale()
		designRoot.Size = UDim2.fromOffset(screen.AbsoluteSize.X / uiScale.Scale, screen.AbsoluteSize.Y / uiScale.Scale)
	end
	screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizeRoot)
	resizeRoot()

	hud = HUD.Create(designRoot)
	modalLayer = Components.Create("Frame", {
		Name = "Modals",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = designRoot,
	})
	-- Dim layer behind windows (under every window in the modal layer).
	backdrop = Components.Create("TextButton", {
		Name = "Backdrop",
		Size = UDim2.new(1, 400, 1, 400),
		Position = UDim2.fromOffset(-200, -200),
		BackgroundColor3 = Color3.fromRGB(12, 16, 30),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 0,
		Parent = modalLayer,
	})
	backdrop.Activated:Connect(function()
		InputController.Trigger("Cancel")
	end)
	blur = Instance.new("BlurEffect")
	blur.Name = "UIBlur"
	blur.Size = 0
	blur.Parent = Lighting
	hud.PlayerName.Text = Players.LocalPlayer.DisplayName
	task.spawn(function()
		local ok, image = pcall(Players.GetUserThumbnailAsync, Players, Players.LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		if ok then
			hud.PlayerAvatar.Image = image
		end
	end)
	local overlay = Components.Create("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = designRoot,
	})
	overlayLayer = overlay
	notifications = Notifications.new(overlay)
	Components.SetClickSound(function()
		AudioController.Play("UIClick")
	end)
	Components.SetHoverSound(function()
		AudioController.Play("UIHover")
	end)
end

-- If the server failed to boot, say so on screen instead of showing an empty world.
local function watchServerHealth()
	local shown = ""
	local function showBootErrors()
		local errors = ReplicatedStorage:GetAttribute("ServerBootErrors")
		if type(errors) == "string" and errors ~= "" and errors ~= shown then
			shown = errors
			local firstLine = string.split(errors, "\n")[1]
			UIController.Notify("Error", "Server error: " .. string.sub(firstLine, 1, 120))
			UIController.Banner("SERVER ERROR", "Open View → Output in Studio and send the red text", "Error")
		end
	end
	showBootErrors()
	ReplicatedStorage:GetAttributeChangedSignal("ServerBootErrors"):Connect(showBootErrors)

	task.delay(20, function()
		if not ClientState.IsReady() then
			UIController.Notify("Error", "Still waiting for the server to load your island…")
			UIController.Banner("LOADING TROUBLE", "Open View → Output in Studio and check for red errors", "Error")
		end
	end)
end

function UIController.Start()
	watchServerHealth()
	watchCurrency("Coins", hud.CoinsLabel, hud.CoinsPill, Theme.Colors.Coins, "🪙")
	watchCurrency("Gems", hud.GemsLabel, hud.GemsPill, Theme.Colors.Gems, "💎")
	ClientState.Observe("Level", refreshPlayerCard)
	ClientState.Observe("XP", refreshPlayerCard)
	watchItems()

	Net.OnClientEvent("Notify", function(payload: any)
		if type(payload) ~= "table" or type(payload.Text) ~= "string" then
			return
		end
		if payload.Kind == "Banner" then
			UIController.Banner(payload.Text, payload.Subtitle, payload.Style)
		else
			UIController.Notify(payload.Kind or "Toast", payload.Text, payload.Icon)
		end
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  VFXController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/VFXController
	DEPENDENCIES: Shared.Net, Shared.Config.VFXConfig

	Renders VFXConfig effects locally with POOLED emitters and parts (no
	Instances are created per effect after warm-up; far effects are skipped).
	Everything is procedural, so it works without uploaded art:

	  Burst   particles (sparkles, chips, leaves, hearts, stars...)
	  Ring    expanding neon ring
	  Puff    cartoon dust clouds: soft balls swell, drift and fade
	  Debris  chunks fly out, bounce on the ground and shrink (rock shatter),
	          or colourful confetti that flutters down
	  Pop     quick neon flash sphere at an impact
	  Jiggle  cartoon squash / tilt / pop / hop / nudge of a MODEL (trees
	          wobble when chopped, rocks squash, crops and buildings pop,
	          whatever you hover gives a tiny boing)

	Jiggles move / scale the model LOCALLY and put it back exactly where it
	was, so they never fight the server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local VFXConfig = require(Shared.Config.VFXConfig)

local BURST_POOL = 12
local RING_POOL = 8
local PUFF_POOL = 40
local DEBRIS_POOL = 60
local POP_POOL = 8
local GRAVITY = Vector3.new(0, -70, 0)

type BurstEmitter = { Part: Part, Emitter: ParticleEmitter, BusyUntil: number }
type PooledPart = { Part: Part, BusyUntil: number, Token: number }
type Chunk = {
	Item: PooledPart,
	Token: number,
	Position: Vector3,
	Velocity: Vector3,
	Spin: Vector3,
	Rotation: CFrame,
	Size: Vector3,
	Born: number,
	Life: number,
	Ground: number,
	Flutter: boolean,
}
type Jiggle = {
	Model: Model,
	Style: string,
	Start: number,
	Duration: number,
	BasePivot: CFrame,
	BaseScale: number,
	Axis: Vector3,
	Amplitude: number,
}

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 90, 110),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(90, 210, 120),
	Color3.fromRGB(80, 170, 255),
	Color3.fromRGB(190, 120, 255),
	Color3.fromRGB(255, 150, 70),
}

local VFXController = {}

local bursts: { BurstEmitter } = {}
local rings: { PooledPart } = {}
local puffs: { PooledPart } = {}
local debris: { PooledPart } = {}
local pops: { PooledPart } = {}
local chunks: { Chunk } = {}
local jiggles: { [Model]: Jiggle } = {}
local folder: Folder
local groundParams = RaycastParams.new()
groundParams.FilterType = Enum.RaycastFilterType.Include
groundParams.IgnoreWater = false
local random = Random.new()

local function newAnchorPart(name: string): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = folder
	return part
end

local function acquire(pool: { any }): any
	local now = os.clock()
	local oldest = nil
	for _, item in pool do
		if item.BusyUntil <= now then
			return item
		end
		if not oldest or item.BusyUntil < oldest.BusyUntil then
			oldest = item
		end
	end
	return oldest -- steal the oldest rather than allocate
end

local function isVisible(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - position).Magnitude <= VFXConfig.MaxDistance
end

local function groundHeight(position: Vector3): number
	groundParams.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(position + Vector3.new(0, 6, 0), Vector3.new(0, -40, 0), groundParams)
	return if hit then hit.Position.Y else position.Y - 3
end

---------------------------------------------------------------------------
-- Effect types
---------------------------------------------------------------------------

local function playBurst(def: any, position: Vector3, options: any)
	local item = acquire(bursts)
	if not item then
		return
	end
	local emitter = item.Emitter
	local scale = options.Scale or 1
	item.Part.CFrame = CFrame.new(position)
	emitter.Color = ColorSequence.new(options.Color or def.Color)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, def.Size * scale),
		NumberSequenceKeypoint.new(0.2, def.Size * scale * 1.15),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.7, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(def.Lifetime * 0.7, def.Lifetime)
	emitter.Speed = NumberRange.new(def.Speed * 0.6, def.Speed)
	emitter.SpreadAngle = Vector2.new(def.Spread, def.Spread)
	emitter.Acceleration = def.Acceleration or Vector3.zero
	emitter.LightEmission = def.LightEmission or 0
	emitter:Emit(options.Count or def.Count)
	item.BusyUntil = os.clock() + def.Lifetime + 0.1
end

local function playRing(def: any, position: Vector3, options: any)
	local item = acquire(rings)
	if not item then
		return
	end
	local part = item.Part
	local scale = options.Scale or 1
	part.Color = options.Color or def.Color
	part.Transparency = 0.15
	part.Size = Vector3.new(def.Height, def.StartSize * scale, def.StartSize * scale)
	part.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	TweenService:Create(part, TweenInfo.new(def.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(def.Height * 0.3, def.EndSize * scale, def.EndSize * scale),
		Transparency = 1,
	}):Play()
	item.BusyUntil = os.clock() + def.Duration
end

local function playPuff(def: any, position: Vector3, options: any)
	local scale = options.Scale or 1
	local count = options.Count or def.Count
	local color = options.Color or def.Color
	local ground = groundHeight(position)
	for index = 1, count do
		local item = acquire(puffs)
		if not item then
			return
		end
		local part = item.Part
		local angle = (index / count) * math.pi * 2 + random:NextNumber(-0.4, 0.4)
		local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local startSize = def.Size * scale * random:NextNumber(0.35, 0.55)
		local endSize = def.Size * scale * random:NextNumber(0.9, 1.35)
		local start = Vector3.new(position.X, math.max(ground + startSize * 0.4, position.Y - 1), position.Z) + direction * 0.6 * scale
		part.Color = color:Lerp(Color3.new(1, 1, 1), random:NextNumber(0, 0.25))
		part.Size = Vector3.one * startSize
		part.CFrame = CFrame.new(start)
		part.Transparency = 0.05
		local duration = def.Duration * random:NextNumber(0.8, 1.15)
		TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
			Size = Vector3.one * endSize,
			CFrame = CFrame.new(start + direction * def.Radius * scale + Vector3.new(0, endSize * 0.45, 0)),
		}):Play()
		TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		item.BusyUntil = os.clock() + duration + 0.05
	end
end

local function playDebris(def: any, position: Vector3, options: any)
	local scale = options.Scale or 1
	local count = options.Count or def.Count
	local color = options.Color or def.Color
	local ground = groundHeight(position)
	local now = os.clock()
	for _ = 1, count do
		local item = acquire(debris)
		if not item then
			return
		end
		local part = item.Part
		local size: Vector3
		if def.Confetti then
			size = Vector3.new(0.5, 0.05, 0.3) * def.Size * 2 * scale
			part.Color = CONFETTI_COLORS[random:NextInteger(1, #CONFETTI_COLORS)]
			part.Material = Enum.Material.SmoothPlastic
		else
			local s = def.Size * scale * random:NextNumber(0.55, 1.2)
			size = Vector3.new(s, s * random:NextNumber(0.6, 1), s * random:NextNumber(0.7, 1.1))
			local shade = random:NextNumber(-0.12, 0.12)
			part.Color = if shade > 0 then color:Lerp(Color3.new(1, 1, 1), shade) else color:Lerp(Color3.new(0, 0, 0), -shade)
			part.Material = Enum.Material.SmoothPlastic
		end
		part.Size = size
		part.Transparency = 0
		local horizontal = random:NextUnitVector() * Vector3.new(1, 0, 1)
		local speed = def.Speed * random:NextNumber(0.5, 1)
		local velocity = horizontal * speed * 0.55 + Vector3.new(0, speed * random:NextNumber(0.6, 1.1), 0)
		local chunk: Chunk = {
			Item = item,
			Token = 0,
			Position = position + horizontal * 0.4,
			Velocity = velocity,
			Spin = Vector3.new(random:NextNumber(-12, 12), random:NextNumber(-12, 12), random:NextNumber(-12, 12)),
			Rotation = CFrame.Angles(random:NextNumber(0, 6.28), random:NextNumber(0, 6.28), random:NextNumber(0, 6.28)),
			Size = size,
			Born = now,
			Life = def.Duration * random:NextNumber(0.8, 1.2),
			Ground = ground,
			Flutter = def.Confetti == true,
		}
		item.BusyUntil = now + chunk.Life + 0.1
		item.Token += 1
		chunk.Token = item.Token
		table.insert(chunks, chunk)
	end
end

local function playPop(def: any, position: Vector3, options: any)
	local item = acquire(pops)
	if not item then
		return
	end
	local scale = options.Scale or 1
	local part = item.Part
	part.Color = options.Color or def.Color
	part.Size = Vector3.one * def.StartSize * scale
	part.CFrame = CFrame.new(position)
	part.Transparency = 0.1
	TweenService:Create(part, TweenInfo.new(def.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.one * def.EndSize * scale,
		Transparency = 1,
	}):Play()
	item.BusyUntil = os.clock() + def.Duration
end

---------------------------------------------------------------------------
-- Jiggles (local-only squash / tilt / pop of a model)
---------------------------------------------------------------------------

local function restore(jiggle: Jiggle)
	local model = jiggle.Model
	if not model.Parent then
		return
	end
	if jiggle.Style == "Tilt" or jiggle.Style == "Hop" then
		model:PivotTo(jiggle.BasePivot)
	else
		pcall(model.ScaleTo, model, jiggle.BaseScale)
	end
end

local function playJiggle(options: any)
	local model = options.Target
	if typeof(model) ~= "Instance" or not model:IsA("Model") or not model.Parent then
		return
	end
	local existing = jiggles[model]
	if existing then
		restore(existing)
		jiggles[model] = nil
	end
	local style = if type(options.Style) == "string" then options.Style else "Squash"
	local pivot = model:GetPivot()
	local axis = Vector3.new(1, 0, 0)
	if style == "Tilt" then
		local away = if typeof(options.From) == "Vector3" then (pivot.Position - options.From) * Vector3.new(1, 0, 1) else Vector3.new(1, 0, 0)
		if away.Magnitude < 0.1 then
			away = Vector3.new(1, 0, 0)
		end
		axis = Vector3.new(0, 1, 0):Cross(away.Unit).Unit
	end
	jiggles[model] = {
		Model = model,
		Style = style,
		Start = os.clock(),
		Duration = if style == "Pop" then 0.55 elseif style == "Tilt" then 0.7 elseif style == "Hop" then 0.5 elseif style == "Nudge" then 0.3 else 0.45,
		BasePivot = pivot,
		BaseScale = model:GetScale(),
		Axis = axis,
		Amplitude = if style == "Tilt" then math.rad(7) elseif style == "Pop" then 0.4 elseif style == "Nudge" then 0.045 else 0.14,
	}
end

local function stepJiggle(jiggle: Jiggle, now: number): boolean
	local model = jiggle.Model
	if not model.Parent then
		return false
	end
	local t = now - jiggle.Start
	if t >= jiggle.Duration then
		restore(jiggle)
		return false
	end
	local decay = math.exp(-t * 7)
	if jiggle.Style == "Tilt" then
		local angle = jiggle.Amplitude * decay * math.sin(t * 26)
		local base = jiggle.BasePivot
		model:PivotTo(CFrame.fromAxisAngle(jiggle.Axis, angle) * (base - base.Position) + base.Position)
	elseif jiggle.Style == "Hop" then
		local height = math.max(0, math.sin(t / jiggle.Duration * math.pi)) * 1.2
		model:PivotTo(jiggle.BasePivot + Vector3.new(0, height, 0))
	elseif jiggle.Style == "Pop" then
		-- Grow in from small with a springy overshoot.
		local alpha = t / jiggle.Duration
		local s = 1 - jiggle.Amplitude * math.exp(-alpha * 6) * math.cos(alpha * 14)
		pcall(model.ScaleTo, model, jiggle.BaseScale * math.max(0.05, s))
	else
		-- Squash: quick dip then springy bounce back.
		local s = 1 - jiggle.Amplitude * decay * math.sin(t * 30 + 0.6)
		pcall(model.ScaleTo, model, jiggle.BaseScale * s)
	end
	return true
end

---------------------------------------------------------------------------
-- Per-frame simulation
---------------------------------------------------------------------------

local function step(dt: number)
	dt = math.min(dt, 1 / 20)
	local now = os.clock()
	for index = #chunks, 1, -1 do
		local chunk = chunks[index]
		local age = now - chunk.Born
		local part = chunk.Item.Part
		if chunk.Item.Token ~= chunk.Token then
			table.remove(chunks, index) -- the part was reused by a newer chunk
		elseif age >= chunk.Life then
			part.Transparency = 1
			table.remove(chunks, index)
		else
			if chunk.Flutter then
				-- Confetti: heavy drag, gentle fall, side-to-side flutter.
				chunk.Velocity += (GRAVITY * 0.18 - chunk.Velocity * 2.2) * dt
				chunk.Velocity += Vector3.new(math.sin(age * 9 + chunk.Spin.X), 0, math.cos(age * 7 + chunk.Spin.Z)) * 6 * dt
			else
				chunk.Velocity += GRAVITY * dt
			end
			chunk.Position += chunk.Velocity * dt
			local bottom = chunk.Ground + chunk.Size.Y * 0.5
			if chunk.Position.Y < bottom then
				chunk.Position = Vector3.new(chunk.Position.X, bottom, chunk.Position.Z)
				if chunk.Flutter then
					chunk.Velocity = Vector3.zero
					chunk.Spin = Vector3.zero
				else
					chunk.Velocity = Vector3.new(chunk.Velocity.X * 0.55, -chunk.Velocity.Y * 0.35, chunk.Velocity.Z * 0.55)
					chunk.Spin *= 0.6
				end
			end
			chunk.Rotation *= CFrame.Angles(chunk.Spin.X * dt, chunk.Spin.Y * dt, chunk.Spin.Z * dt)
			local fade = math.clamp((chunk.Life - age) / 0.35, 0, 1)
			part.Size = chunk.Size * math.max(0.05, fade)
			part.CFrame = CFrame.new(chunk.Position) * chunk.Rotation
		end
	end
	for model, jiggle in jiggles do
		if not stepJiggle(jiggle, now) then
			jiggles[model] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Public
---------------------------------------------------------------------------

function VFXController.Play(effectName: string, position: Vector3, options: any?)
	local def = VFXConfig.Effects[effectName]
	if not def then
		warn("[VFX] Unknown effect '" .. tostring(effectName) .. "'")
		return
	end
	if not isVisible(position) then
		return
	end
	local opts = if type(options) == "table" then options else {}
	if def.Type == "Burst" then
		playBurst(def, position, opts)
	elseif def.Type == "Ring" then
		playRing(def, position, opts)
	elseif def.Type == "Puff" then
		playPuff(def, position, opts)
	elseif def.Type == "Debris" then
		playDebris(def, position, opts)
	elseif def.Type == "Pop" then
		playPop(def, position, opts)
	elseif def.Type == "Jiggle" then
		playJiggle(opts)
	end
end

-- Cartoon squash / tilt / pop / hop of a model on this client only.
function VFXController.Jiggle(model: Model, style: string, from: Vector3?)
	playJiggle({ Target = model, Style = style, From = from })
end

function VFXController.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientEffects"
	folder.Parent = workspace

	for _ = 1, BURST_POOL do
		local part = newAnchorPart("BurstAnchor")
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Drag = 2
		emitter.RotSpeed = NumberRange.new(-90, 90)
		emitter.Parent = part
		table.insert(bursts, { Part = part, Emitter = emitter, BusyUntil = 0 })
	end
	for _ = 1, RING_POOL do
		local part = newAnchorPart("Ring")
		part.Shape = Enum.PartType.Cylinder
		part.Material = Enum.Material.Neon
		table.insert(rings, { Part = part, BusyUntil = 0, Token = 0 })
	end
	for _ = 1, PUFF_POOL do
		local part = newAnchorPart("Puff")
		part.Shape = Enum.PartType.Ball
		part.Material = Enum.Material.SmoothPlastic
		table.insert(puffs, { Part = part, BusyUntil = 0, Token = 0 })
	end
	for _ = 1, DEBRIS_POOL do
		local part = newAnchorPart("Debris")
		part.CastShadow = true
		table.insert(debris, { Part = part, BusyUntil = 0, Token = 0 })
	end
	for _ = 1, POP_POOL do
		local part = newAnchorPart("Pop")
		part.Shape = Enum.PartType.Ball
		part.Material = Enum.Material.Neon
		table.insert(pops, { Part = part, BusyUntil = 0, Token = 0 })
	end
end

function VFXController.Start()
	Net.OnClientEvent("PlayVFX", function(effectName: string, position: Vector3, options: any)
		if typeof(position) == "Vector3" then
			VFXController.Play(effectName, position, options)
		end
	end)
	RunService.RenderStepped:Connect(step)
end

return VFXController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="126">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Main
	SCRIPT TYPE:  LocalScript (client entry point)
	WHERE:        StarterPlayer/StarterPlayerScripts/Client/Main
	DEPENDENCIES: every ModuleScript in Client/Controllers, Client/ClientState

	Boots the client: waits for the game to load, hides the default Roblox
	backpack (we use our own hotbar), then Init()s and Start()s controllers in
	dependency order. No gameplay logic lives here.

	CONTROLLER LAYERS (a controller may only require ones ABOVE it):
		ClientState, InputController, AudioController, VFXController, CameraController
		AnimationController
		UIController
		MovementController, ToolController
		InteractionController
		InventoryController, BuildController (+ Client/Build/LandEditor)
		IslandController, QuestController, FarmController, FishingController,
		AnimalController, ShopController, TradeController
		PlayersController, SocialController, IslandCreatorController
]]

local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end

-- The custom hotbar replaces Roblox's Backpack UI.
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local Client = script.Parent
local Controllers = Client.Controllers

local ORDER: { ModuleScript } = {
	Client.ClientState,
	Controllers.InputController,
	Controllers.AudioController,
	Controllers.VFXController,
	Controllers.CameraController,
	Controllers.AnimationController,
	Controllers.UIController,
	Controllers.MovementController,
	Controllers.ToolController,
	Controllers.InteractionController,
	Controllers.InventoryController,
	Controllers.BuildController,
	Controllers.IslandController,
	Controllers.QuestController,
	Controllers.FarmController,
	Controllers.FishingController,
	Controllers.AnimalController,
	Controllers.ShopController,
	Controllers.TradeController,
	Controllers.PlayersController,
	Controllers.SocialController,
	Controllers.IslandCreatorController,
}

-- One broken controller must not take the whole client down with it:
-- each step is protected and reported in the Output window.
local function run(label: string, callback: () -> ()): boolean
	local ok, message = xpcall(callback, debug.traceback)
	if not ok then
		warn(("[Client] %s failed:\n%s"):format(label, tostring(message)))
	end
	return ok
end

local loaded: { { Name: string, Controller: any } } = {}
for _, module in ORDER do
	run("require " .. module.Name, function()
		table.insert(loaded, { Name = module.Name, Controller = require(module) :: any })
	end)
end

for _, entry in loaded do
	if type(entry.Controller.Init) == "function" then
		run(entry.Name .. ".Init", entry.Controller.Init)
	end
end

for _, entry in loaded do
	if type(entry.Controller.Start) == "function" then
		run(entry.Name .. ".Start", entry.Controller.Start)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="127">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Components
	SCRIPT TYPE:  ModuleScript (client UI kit)
	WHERE:        StarterPlayerScripts/Client/UI/Components
	DEPENDENCIES: Client.UI.Theme

	Tiny UI kit so every screen looks consistent and nothing is rebuilt from
	scratch: Create(), rounded panels with drop shadows and glossy headers,
	chunky cartoon buttons (glossy gradient + 3D bevel + springy hover grow /
	press squash + click sound), currency pills, progress bars, tab rows.
	Frames are created once and updated in place (spec §116).
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Components = {}

local clickSound: (() -> ())? = nil
local hoverSound: (() -> ())? = nil

function Components.SetClickSound(callback: () -> ())
	clickSound = callback
end

function Components.SetHoverSound(callback: () -> ())
	hoverSound = callback
end

-- Create("Frame", { Size = ..., Parent = ... }, { children })
function Components.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local Create = Components.Create

function Components.Corner(parent: Instance, radius: UDim?): UICorner
	return Create("UICorner", { CornerRadius = radius or Theme.Corner, Parent = parent })
end

function Components.Stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return Create("UIStroke", {
		Color = color or Theme.Colors.Outline,
		Thickness = thickness or Theme.StrokeThickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Components.TextStroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return Create("UIStroke", {
		Color = color or Theme.Colors.Outline,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = parent,
	})
end

-- Vertical gradient from `top` to `bottom` (multiplies the object's colour).
function Components.Gradient(parent: Instance, top: Color3, bottom: Color3): UIGradient
	return Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(top, bottom),
		Parent = parent,
	})
end

-- Cartoon "gloss": bright top half with a soft horizon line (multiplies the colour).
function Components.Gloss(parent: Instance, strength: number?): UIGradient
	local s = strength or 1
	local function shade(value: number): Color3
		local v = 1 - (1 - value) * s
		return Color3.new(v, v, v)
	end
	return Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, shade(1)),
			ColorSequenceKeypoint.new(0.46, shade(0.94)),
			ColorSequenceKeypoint.new(0.54, shade(0.82)),
			ColorSequenceKeypoint.new(1, shade(0.74)),
		}),
		Parent = parent,
	})
end

-- A thin glossy highlight along the top inside edge (sits above the text line).
function Components.Shine(parent: GuiObject, inset: number?)
	local pad = inset or 8
	local shine = Create("Frame", {
		Name = "Shine",
		Size = UDim2.new(1, -pad * 2, 0, 3),
		Position = UDim2.fromOffset(pad, 3),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Active = false,
		Parent = parent,
	})
	Components.Corner(shine, UDim.new(1, 0))
	return shine
end

-- A darker "3D lip" along the bottom inside edge of a card or pill.
function Components.Lip(parent: GuiObject, color: Color3, height: number?)
	local h = height or 6
	local lip = Create("Frame", {
		Name = "Lip",
		Size = UDim2.new(1, 0, 0, h),
		Position = UDim2.new(0, 0, 1, -h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Active = false,
		Parent = parent,
	})
	Components.Corner(lip, Theme.Corner)
	return lip
end

-- Soft, layered drop shadow as SIBLINGS behind `target` (inside `container`).
function Components.SoftShadow(container: Instance, target: GuiObject, radius: UDim?)
	for index, spec in { { 6, 0.8 }, { 12, 0.88 }, { 20, 0.94 } } do
		local shadow = Create("Frame", {
			Name = "Shadow" .. index,
			Size = target.Size + UDim2.fromOffset(spec[1], spec[1]),
			Position = target.Position + UDim2.fromOffset(0, 4 + spec[1] * 0.3),
			AnchorPoint = target.AnchorPoint,
			BackgroundColor3 = Theme.Colors.Shadow,
			BackgroundTransparency = spec[2],
			ZIndex = target.ZIndex - 1,
			Active = false,
			Parent = container,
		})
		shadow.Position -= UDim2.fromOffset(spec[1] / 2, spec[1] / 2)
		Components.Corner(shadow, UDim.new(0, (radius or Theme.Corner).Offset + spec[1] / 2))
	end
end

-- Springy scale helper (one UIScale per object, shared with Bounce / PopIn).
local function scaleOf(guiObject: GuiObject): UIScale
	local scale = guiObject:FindFirstChild("BounceScale")
	if not scale then
		scale = Create("UIScale", { Name = "BounceScale", Parent = guiObject })
	end
	return scale :: UIScale
end

function Components.SpringScale(guiObject: GuiObject, target: number, time: number?)
	TweenService:Create(scaleOf(guiObject), TweenInfo.new(time or 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = target }):Play()
end

function Components.Padding(parent: Instance, pixels: number)
	return Create("UIPadding", {
		PaddingTop = UDim.new(0, pixels),
		PaddingBottom = UDim.new(0, pixels),
		PaddingLeft = UDim.new(0, pixels),
		PaddingRight = UDim.new(0, pixels),
		Parent = parent,
	})
end

function Components.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Medium,
		TextWrapped = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Create("TextLabel", defaults)
end

-- Quick "pop" on any GuiObject (uses/creates a UIScale child).
function Components.Bounce(guiObject: GuiObject, amount: number?)
	local scale = scaleOf(guiObject)
	scale.Scale = 1 + (amount or 0.15)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Fade + scale a window in (and optionally out).
function Components.PopIn(guiObject: GuiObject)
	local scale = scaleOf(guiObject)
	scale.Scale = 0.7
	TweenService:Create(scale, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	if guiObject:IsA("GuiObject") then
		guiObject.Rotation = -3
		TweenService:Create(guiObject, TweenInfo.new(0.45, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	end
end

export type ButtonProps = {
	Text: string,
	Color: Color3?,
	TextColor: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	TextSize: number?,
	Parent: Instance?,
	Name: string?,
	OnClick: (() -> ())?,
	Flat: boolean?, -- no bevel / text outline (tabs, list rows)
}

-- Sets a button's base colour (keeps the gradient + bevel consistent).
function Components.SetButtonColor(button: GuiButton, color: Color3)
	button.BackgroundColor3 = color
	button:SetAttribute("BaseColor", color)
	local bevel = button:FindFirstChild("Bevel")
	if bevel and bevel:IsA("Frame") then
		bevel.BackgroundColor3 = Theme.Darken(color, 0.28)
	end
end

function Components.Button(props: ButtonProps): TextButton
	local color = props.Color or Theme.Colors.Green
	local button = Create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text,
		Font = Theme.Fonts.Title,
		TextSize = props.TextSize or Theme.TextSize.Medium,
		TextColor3 = props.TextColor or Theme.Colors.TextLight,
		Parent = props.Parent,
	})
	button:SetAttribute("BaseColor", color)
	Components.Corner(button, Theme.SmallCorner)
	Components.Stroke(button, Theme.Colors.Outline, if props.Flat then 2 else 3)
	Components.Gloss(button, if props.Flat then 0.5 else 1)
	if not props.Flat then
		Components.Shine(button, 10)
	end
	if not props.Flat then
		Components.TextStroke(button, Theme.Colors.Outline, 1.6)
		-- Darker bevel along the bottom edge gives the "chunky" 3D look.
		local bevel = Create("Frame", {
			Name = "Bevel",
			Size = UDim2.new(1, 0, 0, 6),
			Position = UDim2.new(0, 0, 1, -6),
			BackgroundColor3 = Theme.Darken(color, 0.28),
			BorderSizePixel = 0,
			Parent = button,
		})
		Components.Corner(bevel, Theme.SmallCorner)
	end

	local function base(): Color3
		local value = button:GetAttribute("BaseColor")
		return if typeof(value) == "Color3" then value else color
	end
	-- Cartoon feel: grow on hover, squash on press, spring back on release.
	local hovered = false
	button.MouseEnter:Connect(function()
		hovered = true
		button.BackgroundColor3 = Theme.Lighten(base(), 0.14)
		Components.SpringScale(button, 1.06)
		if hoverSound and button.Active then
			hoverSound()
		end
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		button.BackgroundColor3 = base()
		Components.SpringScale(button, 1)
	end)
	button.MouseButton1Down:Connect(function()
		button.BackgroundColor3 = Theme.Darken(base(), 0.08)
		Components.SpringScale(button, 0.92, 0.08)
	end)
	button.MouseButton1Up:Connect(function()
		button.BackgroundColor3 = if hovered then Theme.Lighten(base(), 0.14) else base()
		Components.SpringScale(button, if hovered then 1.06 else 1, 0.3)
	end)
	button.Activated:Connect(function()
		if not hovered then
			Components.Bounce(button, 0.1)
		end
		if clickSound then
			clickSound()
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return button
end

-- Round icon button (HUD menu): big emoji + small caption under it.
function Components.IconButton(props: { Icon: string, Caption: string, Color: Color3, Parent: Instance, LayoutOrder: number?, OnClick: () -> (), Key: string? }): TextButton
	local button = Components.Button({
		Name = props.Caption .. "Button",
		Text = props.Icon,
		Color = props.Color,
		Size = UDim2.fromOffset(64, 64),
		TextSize = 34,
		Parent = props.Parent,
		OnClick = props.OnClick,
	})
	if props.Key then
		local badge = Create("Frame", {
			Name = "KeyBadge",
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.new(1, -14, 0, -8),
			BackgroundColor3 = Theme.Colors.Panel,
			ZIndex = 3,
			Parent = button,
		})
		Components.Corner(badge, UDim.new(1, 0))
		Components.Stroke(badge, Theme.Colors.Outline, 2)
		Components.Label({ Text = props.Key, Size = UDim2.fromScale(1, 1), Font = Theme.Fonts.Heavy, TextSize = 13, TextColor3 = Theme.Colors.Text, ZIndex = 4, Parent = badge })
	end
	button.LayoutOrder = props.LayoutOrder or 0
	Components.Corner(button, UDim.new(0, 22))
	local bevel = button:FindFirstChild("Bevel")
	if bevel then
		Components.Corner(bevel, UDim.new(0, 22))
	end
	local caption = Components.Label({
		Name = "Caption",
		Text = props.Caption,
		Size = UDim2.new(1, 16, 0, 18),
		Position = UDim2.new(0.5, 0, 1, 3),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 15,
		TextColor3 = Theme.Colors.TextLight,
		Parent = button,
	})
	Components.TextStroke(caption, Theme.Colors.Outline, 2)
	return button
end

-- Top-bar style pill: [icon] value. Returns (frame, valueLabel).
function Components.Pill(props: { Icon: string, Color: Color3, Width: number?, Parent: Instance?, LayoutOrder: number? }): (Frame, TextLabel)
	local frame = Create("Frame", {
		Size = UDim2.fromOffset(props.Width or 150, 48),
		BackgroundColor3 = Theme.Colors.Panel,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Components.Corner(frame, UDim.new(1, 0))
	Components.Stroke(frame)
	Components.Gloss(frame, 0.45)

	local iconBubble = Create("Frame", {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(0, -10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = props.Color,
		Parent = frame,
	})
	Components.Corner(iconBubble, UDim.new(1, 0))
	Components.Stroke(iconBubble)
	Components.Gloss(iconBubble)
	-- The icon gently rocks back and forth (cartoon idle).
	iconBubble.Rotation = -6
	TweenService:Create(iconBubble, TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = 6 }):Play()
	Components.Label({
		Text = props.Icon,
		Size = UDim2.fromScale(1, 1),
		TextSize = 28,
		Parent = iconBubble,
	})

	local value = Components.Label({
		Name = "Value",
		Text = "0",
		Size = UDim2.new(1, -52, 1, 0),
		Position = UDim2.fromOffset(46, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = Theme.TextSize.Large,
		TextWrapped = false,
		Parent = frame,
	})
	return frame, value
end

export type ProgressBar = { Frame: Frame, Fill: Frame, SetProgress: (alpha: number, animate: boolean?) -> () }

function Components.ProgressBar(props: { Size: UDim2, Position: UDim2?, Color: Color3, Parent: Instance? }): ProgressBar
	local frame = Create("Frame", {
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = Theme.Colors.PanelDark,
		ClipsDescendants = true,
		Parent = props.Parent,
	})
	Components.Corner(frame, UDim.new(1, 0))
	Components.Stroke(frame, Theme.Colors.Outline, 2)
	local fill = Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = props.Color,
		Parent = frame,
	})
	Components.Corner(fill, UDim.new(1, 0))
	Components.Gloss(fill)

	local function setProgress(alpha: number, animate: boolean?)
		local target = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
		if animate then
			TweenService:Create(fill, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = target }):Play()
		else
			fill.Size = target
		end
	end
	return { Frame = frame, Fill = fill, SetProgress = setProgress }
end

-- A cream "paper" window: soft layered shadow, glossy coloured header band
-- with a highlight line and decorative bubbles, big Fredoka title, and a
-- round red close button that overhangs the top-right corner (it spins on
-- hover). Returns (window, content, closeButton). `window` is a transparent
-- container (shadows + body + close) so it can be shown / hidden / bounced
-- as one piece.
function Components.Panel(props: { Title: string, Size: UDim2, Parent: Instance?, OnClose: (() -> ())?, Color: Color3? }): (Frame, Frame, TextButton)
	local headerColor = props.Color or Theme.Colors.Header
	local window = Create("Frame", {
		Size = props.Size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		Parent = props.Parent,
	})
	local body = Create("Frame", {
		Name = "Body",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Colors.Panel,
		ZIndex = 2,
		Parent = window,
	})
	Components.SoftShadow(window, body, UDim.new(0, 24))
	Components.Corner(body, UDim.new(0, 24))
	Components.Stroke(body, Theme.Colors.Outline, 4)
	Components.Gradient(body, Color3.new(1, 1, 1), Color3.fromRGB(240, 230, 210))

	local header = Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = headerColor,
		Parent = body,
	})
	Components.Corner(header, UDim.new(0, 24))
	Components.Gloss(header)
	-- Square off the header's bottom corners (matching the gloss shade there).
	local squareOff = Create("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 1, -24),
		BackgroundColor3 = headerColor,
		BorderSizePixel = 0,
		Parent = header,
	})
	Components.Gradient(squareOff, Color3.fromRGB(196, 196, 196), Color3.fromRGB(189, 189, 189))
	-- Dark seam under the header and a highlight line along its top.
	Create("Frame", {
		Name = "Seam",
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Darken(headerColor, 0.35),
		BorderSizePixel = 0,
		Parent = header,
	})
	Components.Shine(header, 18)
	-- Decorative bubbles on the right of the header.
	for index, spec in { { 34, -96, 8 }, { 18, -128, 30 }, { 12, -70, 38 } } do
		local bubble = Create("Frame", {
			Name = "Bubble" .. index,
			Size = UDim2.fromOffset(spec[1], spec[1]),
			Position = UDim2.new(1, spec[2], 0, spec[3]),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.78,
			Parent = header,
		})
		Components.Corner(bubble, UDim.new(1, 0))
	end
	local title = Components.Label({
		Name = "Title",
		Text = props.Title,
		Size = UDim2.new(1, -170, 1, -6),
		Position = UDim2.fromOffset(24, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = Theme.TextSize.Title + 2,
		TextColor3 = Theme.Colors.TextLight,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = header,
	})
	Components.TextStroke(title, Theme.Colors.Outline, 3)

	-- Round close button overhanging the corner.
	local closeButton = Components.Button({
		Name = "Close",
		Text = "✕",
		Color = Theme.Colors.Red,
		Size = UDim2.fromOffset(50, 50),
		Position = UDim2.new(1, 14, 0, -14),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = Theme.TextSize.Large + 2,
		Parent = window,
		OnClick = props.OnClose,
	})
	closeButton.ZIndex = 5
	Components.Corner(closeButton, UDim.new(1, 0))
	local bevel = closeButton:FindFirstChild("Bevel")
	if bevel then
		Components.Corner(bevel, UDim.new(1, 0))
	end
	local shine = closeButton:FindFirstChild("Shine")
	if shine then
		shine:Destroy()
	end
	closeButton.MouseEnter:Connect(function()
		TweenService:Create(closeButton, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Rotation = 90 }):Play()
	end)
	closeButton.MouseLeave:Connect(function()
		TweenService:Create(closeButton, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Rotation = 0 }):Play()
	end)

	local content = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -32, 1, -84),
		Position = UDim2.fromOffset(16, 74),
		BackgroundTransparency = 1,
		Parent = body,
	})
	return window, content, closeButton
end

-- A HUD card (right side panels): cream body with a coloured header tab,
-- glossy header, 3D lip, icon bubble and title. Returns (card, header, body, titleLabel).
function Components.Card(props: { Title: string, Icon: string, Color: Color3, Size: UDim2, Parent: Instance?, LayoutOrder: number?, HeaderHeight: number? }): (Frame, Frame, Frame, TextLabel)
	local headerHeight = props.HeaderHeight or 40
	local card = Create("Frame", {
		Name = "Card",
		Size = props.Size,
		BackgroundColor3 = Theme.Colors.Panel,
		LayoutOrder = props.LayoutOrder or 0,
		ClipsDescendants = false,
		Parent = props.Parent,
	})
	Components.Corner(card)
	Components.Stroke(card, Theme.Colors.Outline, 3)
	Components.Gradient(card, Color3.new(1, 1, 1), Color3.fromRGB(242, 232, 212))
	local header = Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, headerHeight),
		BackgroundColor3 = props.Color,
		Parent = card,
	})
	Components.Corner(header)
	Components.Gloss(header)
	Components.Shine(header, 14)
	local squareOff = Create("Frame", {
		Name = "SquareOff",
		Size = UDim2.new(1, 0, 0, 12),
		Position = UDim2.new(0, 0, 1, -12),
		BackgroundColor3 = props.Color,
		BorderSizePixel = 0,
		Parent = header,
	})
	Components.Gradient(squareOff, Color3.fromRGB(194, 194, 194), Color3.fromRGB(189, 189, 189))
	local bubble = Create("Frame", {
		Name = "IconBubble",
		Size = UDim2.fromOffset(headerHeight + 6, headerHeight + 6),
		Position = UDim2.new(0, -8, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		ZIndex = 2,
		Parent = header,
	})
	Components.Corner(bubble, UDim.new(1, 0))
	Components.Stroke(bubble, Theme.Colors.Outline, 3)
	Components.Label({ Text = props.Icon, Size = UDim2.fromScale(1, 1), TextSize = headerHeight - 12, ZIndex = 3, Parent = bubble })
	local title = Components.Label({
		Name = "Title",
		Text = props.Title,
		Size = UDim2.new(1, -(headerHeight + 50), 1, 0),
		Position = UDim2.fromOffset(headerHeight + 4, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Medium + 1,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = header,
	})
	Components.TextStroke(title, Theme.Colors.Outline, 2.5)
	local body = Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -20, 1, -(headerHeight + 12)),
		Position = UDim2.fromOffset(10, headerHeight + 6),
		BackgroundTransparency = 1,
		Parent = card,
	})
	return card, header, body, title
end

-- Recolour a Card header (and set its icon).
function Components.SetCardHeader(header: Frame, color: Color3, icon: string?)
	header.BackgroundColor3 = color
	local squareOff = header:FindFirstChild("SquareOff")
	if squareOff and squareOff:IsA("Frame") then
		squareOff.BackgroundColor3 = color
	end
	local bubble = header:FindFirstChild("IconBubble")
	local label = bubble and bubble:FindFirstChildOfClass("TextLabel")
	if icon and label then
		label.Text = icon
	end
end

-- A row of tab buttons. onSelect(id) is called on click; returns { [id] = button } and a setter.
function Components.Tabs(parent: Instance, tabs: { { Id: string, Text: string } }, width: number, onSelect: (string) -> ()): ({ [string]: TextButton }, (string) -> ())
	-- A recessed "segmented control" tray holding the tab buttons.
	local row = Create("Frame", { Name = "Tabs", Size = UDim2.new(0, #tabs * (width + 6) + 6, 0, 48), BackgroundColor3 = Theme.Colors.Inset, Parent = parent }, {
		Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }),
	})
	Components.Corner(row, UDim.new(0, 16))
	Components.Stroke(row, Theme.Colors.PanelDark, 2)
	local buttons = {}
	for index, tab in tabs do
		local button = Components.Button({
			Name = tab.Id,
			Text = tab.Text,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.fromOffset(width, 38),
			TextSize = Theme.TextSize.Small,
			Parent = row,
			Flat = true,
			OnClick = function()
				onSelect(tab.Id)
			end,
		})
		button.LayoutOrder = index
		buttons[tab.Id] = button
	end
	local function setSelected(id: string)
		for tabId, button in buttons do
			local selected = tabId == id
			Components.SetButtonColor(button, if selected then Theme.Colors.Coins else Theme.Colors.PanelAlt)
		end
	end
	return buttons, setSelected
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  HUD
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/HUD
	DEPENDENCIES: Client.UI.{Theme, Components}

	Builds the main HUD layout once (spec §83), "Island Pop" style:
		Top-left  PLAYER CARD: round avatar with a level badge, your name and
		          an XP bar
		Top       coin + gem pills
		Right     slot for the island / quest cards (IslandController, QuestController)
		Left      frosted menu DOCK (Bag, Build, Players, Emotes, Settings)
		Bottom    frosted tray + slot for the hotbar (ToolController)
		Touch     touch-only action buttons
	Controllers fill the slots; UIController updates the values.
]]

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local HUD = {}

export type HUDRefs = {
	Root: Frame,
	TopBar: Frame,
	PlayerCard: Frame,
	PlayerAvatar: ImageLabel,
	PlayerName: TextLabel,
	PlayerLevel: TextLabel,
	PlayerLevelBadge: Frame,
	PlayerXP: Components.ProgressBar,
	PlayerXPText: TextLabel,
	CoinsPill: Frame,
	CoinsLabel: TextLabel,
	GemsPill: Frame,
	GemsLabel: TextLabel,
	Slots: { [string]: Frame },
}

local function frosted(frame: Frame)
	frame.BackgroundColor3 = Theme.Colors.Glass
	frame.BackgroundTransparency = 0.45
	Components.Corner(frame, UDim.new(0, 24))
	local stroke = Components.Stroke(frame, Color3.new(1, 1, 1), 2)
	stroke.Transparency = 0.75
end

local function playerCard(root: Frame)
	local card = Create("Frame", {
		Name = "PlayerCard",
		Size = UDim2.fromOffset(262, 74),
		Position = UDim2.fromOffset(52, 14),
		BackgroundColor3 = Theme.Colors.Panel,
		Parent = root,
	})
	Components.Corner(card, UDim.new(0, 20))
	Components.Stroke(card, Theme.Colors.Outline, 3)
	Components.Gloss(card, 0.4)
	Components.Lip(card, Theme.Colors.PanelDark, 6)

	-- Round avatar overhanging the left edge.
	local avatarRing = Create("Frame", {
		Name = "AvatarRing",
		Size = UDim2.fromOffset(84, 84),
		Position = UDim2.new(0, -42, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Colors.Level,
		ZIndex = 2,
		Parent = card,
	})
	Components.Corner(avatarRing, UDim.new(1, 0))
	Components.Stroke(avatarRing, Theme.Colors.Outline, 3)
	Components.Gloss(avatarRing)
	local avatar = Create("ImageLabel", {
		Name = "Avatar",
		Size = UDim2.new(1, -12, 1, -12),
		Position = UDim2.fromOffset(6, 6),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		Image = "",
		ZIndex = 3,
		Parent = avatarRing,
	})
	Components.Corner(avatar, UDim.new(1, 0))

	-- Level badge on the avatar.
	local badge = Create("Frame", {
		Name = "LevelBadge",
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.new(1, 4, 1, 4),
		AnchorPoint = Vector2.new(1, 1),
		BackgroundColor3 = Theme.Colors.Coins,
		ZIndex = 4,
		Parent = avatarRing,
	})
	Components.Corner(badge, UDim.new(1, 0))
	Components.Stroke(badge, Theme.Colors.Outline, 3)
	Components.Gloss(badge)
	local level = Components.Label({
		Name = "Level",
		Text = "1",
		Size = UDim2.fromScale(1, 1),
		TextSize = 20,
		TextColor3 = Theme.Colors.TextLight,
		ZIndex = 5,
		Parent = badge,
	})
	Components.TextStroke(level, Theme.Colors.Outline, 2)

	local name = Components.Label({
		Name = "PlayerName",
		Text = "Player",
		Size = UDim2.new(1, -62, 0, 28),
		Position = UDim2.fromOffset(52, 7),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = 21,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = card,
	})
	local xp = Components.ProgressBar({
		Size = UDim2.new(1, -66, 0, 18),
		Position = UDim2.fromOffset(52, 40),
		Color = Theme.Colors.Level,
		Parent = card,
	})
	local xpText = Components.Label({
		Name = "XPText",
		Text = "",
		Size = UDim2.fromScale(1, 1),
		Font = Theme.Fonts.Heavy,
		TextSize = 12,
		TextColor3 = Theme.Colors.TextLight,
		ZIndex = 3,
		Parent = xp.Frame,
	})
	Components.TextStroke(xpText, Theme.Colors.Outline, 1.5)
	return card, avatar, name, level, badge, xp, xpText
end

function HUD.Create(parent: Instance): HUDRefs
	local root = Create("Frame", {
		Name = "HUD",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local card, avatar, name, level, badge, xp, xpText = playerCard(root)

	local topBar = Create("Frame", {
		Name = "TopBar",
		Size = UDim2.fromOffset(440, 60),
		Position = UDim2.new(0.5, 0, 0, 14),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 34),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local coinsPill, coinsLabel = Components.Pill({ Icon = "🪙", Color = Theme.Colors.Coins, Width = 200, Parent = topBar, LayoutOrder = 1 })
	local gemsPill, gemsLabel = Components.Pill({ Icon = "💎", Color = Theme.Colors.Gems, Width = 160, Parent = topBar, LayoutOrder = 2 })

	local dock = Create("Frame", {
		Name = "LeftSlot",
		Size = UDim2.fromOffset(92, 476),
		Position = UDim2.new(0, 12, 0.5, 30),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = root,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 28),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
		Create("UIPadding", { PaddingBottom = UDim.new(0, 16) }),
	})
	frosted(dock)

	local bottom = Create("Frame", {
		Name = "BottomSlot",
		Size = UDim2.fromOffset(720, 96),
		Position = UDim2.new(0.5, 0, 1, -12),
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local tray = Create("Frame", {
		Name = "Tray",
		Size = UDim2.new(1, 16, 0, 62),
		Position = UDim2.new(0.5, 0, 1, 6),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 0,
		Parent = bottom,
	})
	frosted(tray)

	local slots = {
		Right = Create("Frame", {
			Name = "RightSlot",
			Size = UDim2.fromOffset(256, 560),
			Position = UDim2.new(1, -14, 0, 86),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Parent = root,
		}, {
			Create("UIListLayout", {
				Padding = UDim.new(0, 12),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		}),
		Bottom = bottom,
		Left = dock,
		-- Touch-only action buttons (bottom-right, above the jump button).
		Touch = Create("Frame", {
			Name = "TouchSlot",
			Size = UDim2.fromOffset(120, 120),
			Position = UDim2.new(1, -30, 1, -200),
			AnchorPoint = Vector2.new(1, 1),
			BackgroundTransparency = 1,
			Parent = root,
		}),
	}

	return {
		Root = root,
		TopBar = topBar,
		PlayerCard = card,
		PlayerAvatar = avatar,
		PlayerName = name,
		PlayerLevel = level,
		PlayerLevelBadge = badge,
		PlayerXP = xp,
		PlayerXPText = xpText,
		CoinsPill = coinsPill,
		CoinsLabel = coinsLabel,
		GemsPill = gemsPill,
		GemsLabel = gemsLabel,
		Slots = slots,
	}
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">Hotbar</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Hotbar
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/Hotbar
	DEPENDENCIES: Client.UI.{Theme, Components}, Shared.Config.{ToolConfig, ItemConfig}, Shared.Util.Format

	The bottom hotbar: tools AND holdable items (seed sacks, crops to feed
	animals). Slots are created ONCE and updated in place. Big touch-friendly
	glossy buttons with a round key badge, a tier strip for tools and a count
	for items, each on a soft drop shadow. The slot in your hands LIFTS up,
	grows, glows gold and wiggles.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ToolConfig = require(Shared.Config.ToolConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Format = require(Shared.Util.Format)

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local SLOT_SIZE = 68

local TIER_COLORS = {
	Wooden = Color3.fromRGB(196, 146, 94),
	Stone = Color3.fromRGB(160, 160, 168),
	Iron = Color3.fromRGB(218, 224, 234),
	Gold = Color3.fromRGB(255, 205, 60),
	Crystal = Color3.fromRGB(120, 225, 255),
	Mythic = Color3.fromRGB(200, 100, 255),
}

type Slot = { Button: TextButton, Glow: Frame, Icon: TextLabel, Name: TextLabel, Count: TextLabel, Stroke: UIStroke, Strip: Frame, Id: string?, Equipped: boolean }

local LIFT = 12
local REST_POSITION = UDim2.new(0.5, 0, 1, -6)
local LIFT_POSITION = UDim2.new(0.5, 0, 1, -6 - LIFT)

local Hotbar = {}
Hotbar.__index = Hotbar

function Hotbar.new(parent: Instance, onSelect: (index: number) -> ())
	local self = setmetatable({}, Hotbar)
	self.Frame = Create("Frame", {
		Name = "Hotbar",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.Slots = {} :: { Slot }
	self.Counts = {} :: { [string]: number }

	for index = 1, ToolConfig.HotbarSize do
		-- Container keeps the list layout still while the button lifts.
		local holder = Create("Frame", {
			Name = "Slot" .. index,
			Size = UDim2.fromOffset(SLOT_SIZE + 4, SLOT_SIZE + LIFT + 12),
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = self.Frame,
		})
		local shadow = Create("Frame", {
			Name = "Shadow",
			Size = UDim2.fromOffset(SLOT_SIZE - 4, 12),
			Position = UDim2.new(0.5, 0, 1, -2),
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.72,
			Parent = holder,
		})
		Components.Corner(shadow, UDim.new(1, 0))
		local glow = Create("Frame", {
			Name = "Glow",
			Size = UDim2.fromOffset(SLOT_SIZE + 16, SLOT_SIZE + 16),
			Position = LIFT_POSITION + UDim2.fromOffset(0, 8),
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = Theme.Colors.Coins,
			BackgroundTransparency = 1,
			Parent = holder,
		})
		Components.Corner(glow, UDim.new(0, 20))
		local button = Create("TextButton", {
			Name = "Button",
			Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
			Position = REST_POSITION,
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundColor3 = Theme.Colors.Panel,
			BackgroundTransparency = 0.05,
			AutoButtonColor = false,
			Text = "",
			Parent = holder,
		})
		Components.Corner(button, UDim.new(0, 16))
		local stroke = Components.Stroke(button)
		Components.Gloss(button, 0.55)
		local strip = Create("Frame", {
			Name = "TierStrip",
			Size = UDim2.new(1, -14, 0, 5),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Theme.Colors.PanelDark,
			BorderSizePixel = 0,
			Parent = button,
		})
		Components.Corner(strip, UDim.new(1, 0))
		local icon = Components.Label({
			Name = "Icon",
			Size = UDim2.new(1, 0, 0, 40),
			Position = UDim2.fromOffset(0, 5),
			TextSize = 32,
			Text = "",
			Parent = button,
		})
		local name = Components.Label({
			Name = "ItemName",
			Size = UDim2.new(1, -6, 0, 13),
			Position = UDim2.new(0, 3, 1, -23),
			Font = Theme.Fonts.Bold,
			TextColor3 = Theme.Colors.TextMuted,
			TextScaled = true,
			Text = "",
			Parent = button,
		})
		local count = Components.Label({
			Name = "Count",
			Size = UDim2.fromOffset(40, 18),
			Position = UDim2.new(1, -4, 0, 2),
			AnchorPoint = Vector2.new(1, 0),
			Font = Theme.Fonts.Heavy,
			TextSize = 15,
			TextColor3 = Theme.Colors.TextLight,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = "",
			ZIndex = 2,
			Parent = button,
		})
		Components.TextStroke(count, Theme.Colors.Outline, 2)
		local badge = Create("Frame", {
			Name = "KeyBadge",
			Size = UDim2.fromOffset(22, 22),
			Position = UDim2.fromOffset(-6, -6),
			BackgroundColor3 = Theme.Colors.Outline,
			ZIndex = 3,
			Parent = button,
		})
		Components.Corner(badge, UDim.new(1, 0))
		Components.Label({
			Name = "Key",
			Size = UDim2.fromScale(1, 1),
			Font = Theme.Fonts.Heavy,
			TextSize = 13,
			Text = tostring(index),
			TextColor3 = Theme.Colors.TextLight,
			ZIndex = 4,
			Parent = badge,
		})
		button.MouseEnter:Connect(function()
			Components.SpringScale(button, 1.08)
		end)
		button.MouseLeave:Connect(function()
			Components.SpringScale(button, 1)
		end)
		button.Activated:Connect(function()
			onSelect(index)
		end)
		table.insert(self.Slots, { Button = button, Glow = glow, Icon = icon, Name = name, Count = count, Stroke = stroke, Strip = strip, Id = nil, Equipped = false })
	end
	return self
end

local function describe(id: string?): (string, string, Color3?)
	if not id then
		return "", "", nil
	end
	local tool = ToolConfig.Get(id)
	if tool then
		return tool.Icon, tool.DisplayName, TIER_COLORS[tool.Tier]
	end
	local item = ItemConfig.Get(id)
	if item then
		return item.Icon, item.DisplayName, Theme.Colors.Green
	end
	return "", "", nil
end

function Hotbar:SetTools(ids: { string }, counts: { [string]: number }?)
	self.Counts = counts or self.Counts
	for index, slot in self.Slots do
		local id = ids[index]
		local icon, name, strip = describe(id)
		slot.Id = if icon ~= "" then id else nil
		slot.Icon.Text = icon
		slot.Name.Text = name
		slot.Strip.BackgroundColor3 = strip or Theme.Colors.PanelDark
		slot.Strip.Visible = strip ~= nil
		slot.Button.BackgroundTransparency = if slot.Id then 0.05 else 0.45
		local count = slot.Id and not ToolConfig.Get(slot.Id) and self.Counts[slot.Id]
		slot.Count.Text = if count then "x" .. Format.Abbreviate(count) else ""
	end
end

function Hotbar:SetCounts(counts: { [string]: number })
	self.Counts = counts
	for _, slot in self.Slots do
		local count = slot.Id and not ToolConfig.Get(slot.Id) and counts[slot.Id]
		slot.Count.Text = if count then "x" .. Format.Abbreviate(count) else ""
	end
end

function Hotbar:SetEquipped(id: string?)
	for _, slot in self.Slots do
		local equipped = id ~= nil and slot.Id == id
		slot.Stroke.Color = if equipped then Color3.fromRGB(255, 170, 30) else Theme.Colors.Outline
		slot.Stroke.Thickness = if equipped then 4 else Theme.StrokeThickness
		slot.Button.BackgroundColor3 = if equipped then Color3.fromRGB(255, 244, 200) else Theme.Colors.Panel
		if equipped ~= slot.Equipped then
			slot.Equipped = equipped
			local info = TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			TweenService:Create(slot.Button, info, {
				Position = if equipped then LIFT_POSITION else REST_POSITION,
				Size = if equipped then UDim2.fromOffset(SLOT_SIZE + 6, SLOT_SIZE + 6) else UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
			}):Play()
			TweenService:Create(slot.Glow, TweenInfo.new(0.25), { BackgroundTransparency = if equipped then 0.55 else 1 }):Play()
			if equipped then
				-- A happy little wiggle.
				slot.Button.Rotation = -10
				TweenService:Create(slot.Button, TweenInfo.new(0.6, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
			end
		end
	end
end

function Hotbar:GetToolAt(index: number): string?
	local slot = self.Slots[index]
	return slot and slot.Id
end

return Hotbar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">InventoryPanel</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InventoryPanel
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/InventoryPanel
	DEPENDENCIES: Client.UI.{Theme, Components}, Shared.Config.{ItemConfig, ToolConfig, RarityConfig},
	              Shared.Util.Format

	The backpack window (spec §66/§67): category tabs, search, sort, a pooled
	item grid and a details pane (rarity, value, description; Equip for tools).
	Cards are pooled and reused — the grid never rebuilds from scratch.
	Sell buttons arrive with the market in Phase 7.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemConfig = require(Shared.Config.ItemConfig)
local ToolConfig = require(Shared.Config.ToolConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local Format = require(Shared.Util.Format)

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local SORT_MODES = { "Name", "Amount", "Value" }

type Entry = {
	Id: string,
	Kind: string, -- "Item" | "Tool"
	Name: string,
	Icon: string,
	Rarity: string,
	Category: string,
	Count: number,
	Value: number,
	Description: string,
	ToolDef: any?,
}

type Card = { Button: TextButton, Icon: TextLabel, Name: TextLabel, Count: TextLabel, Stroke: UIStroke, Band: Frame }

local InventoryPanel = {}
InventoryPanel.__index = InventoryPanel

export type Callbacks = {
	OnClose: () -> (),
	OnEquip: (toolId: string?) -> (),
}

function InventoryPanel.new(parent: Instance, callbacks: Callbacks)
	local self = setmetatable({}, InventoryPanel)
	self.Callbacks = callbacks
	self.Category = "All"
	self.SortIndex = 1
	self.Search = ""
	self.SelectedId = nil :: string?
	self.Entries = {} :: { Entry }
	self.Cards = {} :: { Card }
	self.State = { Items = {}, Capacity = 0, OwnedTools = {}, Equipped = "" }

	local panel, content = Components.Panel({
		Title = "🎒 BACKPACK",
		Size = UDim2.fromOffset(760, 470),
		Parent = parent,
		OnClose = callbacks.OnClose,
	})
	panel.Visible = false
	self.Panel = panel

	self.CapacityLabel = Components.Label({
		Size = UDim2.fromOffset(160, 54),
		Position = UDim2.new(1, -70, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextLight,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "0 / 0",
		Parent = panel:FindFirstChild("Header", true),
	})
	Components.TextStroke(self.CapacityLabel)

	-- Tabs (left column)
	local tabs = Create("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.new(0, 130, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = content,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	self.TabButtons = {}
	for index, category in ItemConfig.Categories do
		local button = Components.Button({
			Name = category.Id,
			Text = category.Icon .. " " .. category.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.new(1, -8, 0, 40),
			TextSize = Theme.TextSize.Small,
			Parent = tabs,
			OnClick = function()
				self.Category = category.Id
				self:Render()
			end,
		})
		button.LayoutOrder = index
		-- Dark text on light tabs doesn't need the white-text outline.
		for _, child in button:GetChildren() do
			if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
				child:Destroy()
			end
		end
		self.TabButtons[category.Id] = button
	end

	-- Search + sort row
	local middle = Create("Frame", {
		Name = "Middle",
		Size = UDim2.new(1, -350, 1, 0),
		Position = UDim2.fromOffset(140, 0),
		BackgroundTransparency = 1,
		Parent = content,
	})
	local searchBox = Create("TextBox", {
		Name = "Search",
		Size = UDim2.new(1, -120, 0, 38),
		BackgroundColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "🔍 Search...",
		PlaceholderColor3 = Theme.Colors.TextMuted,
		Text = "",
		ClearTextOnFocus = false,
		Font = Theme.Fonts.Body,
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = middle,
	})
	Components.Corner(searchBox, Theme.SmallCorner)
	Components.Stroke(searchBox, Theme.Colors.Outline, 2)
	Components.Padding(searchBox, 8)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self.Search = string.lower(searchBox.Text)
		self:Render()
	end)

	self.SortButton = Components.Button({
		Name = "Sort",
		Text = "Sort: Name",
		Color = Theme.Colors.Blue,
		Size = UDim2.fromOffset(110, 38),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = Theme.TextSize.Small,
		Parent = middle,
		OnClick = function()
			self.SortIndex = self.SortIndex % #SORT_MODES + 1
			self.SortButton.Text = "Sort: " .. SORT_MODES[self.SortIndex]
			self:Render()
		end,
	})

	self.Grid = Create("ScrollingFrame", {
		Name = "Grid",
		Size = UDim2.new(1, 0, 1, -48),
		Position = UDim2.fromOffset(0, 48),
		BackgroundColor3 = Theme.Colors.Inset,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Colors.Outline,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = middle,
	}, {
		Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(84, 96),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Components.Corner(self.Grid, UDim.new(0, 16))
	Components.Stroke(self.Grid, Theme.Colors.PanelDark, 2)
	Components.Padding(self.Grid, 8)

	self.EmptyLabel = Components.Label({
		Size = UDim2.new(1, -20, 0, 80),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = Theme.Colors.TextMuted,
		Text = "Nothing here yet!\nGather resources to fill your backpack.",
		Visible = false,
		Parent = middle,
	})

	-- Details (right column)
	local details = Create("Frame", {
		Name = "Details",
		Size = UDim2.new(0, 200, 1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Colors.Inset,
		Parent = content,
	})
	Components.Corner(details, UDim.new(0, 16))
	Components.Stroke(details, Theme.Colors.PanelDark, 2)
	Components.Padding(details, 10)
	-- Big icon in a glossy bubble tinted by rarity.
	self.DetailBubble = Create("Frame", {
		Name = "IconBubble",
		Size = UDim2.fromOffset(76, 76),
		Position = UDim2.new(0.5, 0, 0, -2),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Panel,
		Parent = details,
	})
	Components.Corner(self.DetailBubble, UDim.new(1, 0))
	Components.Stroke(self.DetailBubble, Theme.Colors.Outline, 3)
	Components.Gloss(self.DetailBubble, 0.5)
	self.DetailIcon = Components.Label({ Size = UDim2.new(1, 0, 0, 70), TextSize = 52, Text = "", ZIndex = 2, Parent = details })
	self.DetailName = Components.Label({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 72), TextSize = Theme.TextSize.Large, Text = "Select an item", Parent = details })
	self.DetailRarity = Components.Label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 102), TextSize = Theme.TextSize.Small, Text = "", Parent = details })
	self.DetailStats = Components.Label({
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 126),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.Text,
		Text = "",
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = details,
	})
	self.DetailDescription = Components.Label({
		Size = UDim2.new(1, 0, 0, 110),
		Position = UDim2.fromOffset(0, 190),
		Font = Theme.Fonts.Body,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "",
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = details,
	})
	self.EquipButton = Components.Button({
		Name = "Equip",
		Text = "EQUIP",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.new(0, 0, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		Parent = details,
		OnClick = function()
			local entry = self:_selectedEntry()
			if entry and entry.Kind == "Tool" then
				local equipped = self.State.Equipped == entry.Id
				self.Callbacks.OnEquip(if equipped then nil else entry.Id)
			end
		end,
	})
	self.EquipButton.Visible = false

	return self
end

function InventoryPanel:_selectedEntry(): Entry?
	for _, entry in self.Entries do
		if entry.Id == self.SelectedId then
			return entry
		end
	end
	return nil
end

function InventoryPanel:_buildEntries()
	local entries = {}
	for itemId, count in self.State.Items do
		local def = ItemConfig.Get(itemId)
		if def and count > 0 then
			table.insert(entries, {
				Id = itemId,
				Kind = "Item",
				Name = def.DisplayName,
				Icon = def.Icon,
				Rarity = def.Rarity,
				Category = def.Category,
				Count = count,
				Value = def.SellValue,
				Description = def.Description,
			})
		end
	end
	for toolId in self.State.OwnedTools do
		local def = ToolConfig.Get(toolId)
		if def then
			table.insert(entries, {
				Id = toolId,
				Kind = "Tool",
				Name = def.DisplayName,
				Icon = def.Icon,
				Rarity = "Common",
				Category = "Tools",
				Count = 1,
				Value = def.Price,
				Description = def.Description,
				ToolDef = def,
			})
		end
	end
	self.Entries = entries
end

function InventoryPanel:_getCard(index: number): Card
	local card = self.Cards[index]
	if card then
		return card
	end
	local button = Create("TextButton", {
		Name = "Card",
		BackgroundColor3 = Theme.Colors.Panel,
		AutoButtonColor = false,
		Text = "",
		Parent = self.Grid,
	})
	Components.Corner(button, UDim.new(0, 14))
	local stroke = Components.Stroke(button, Theme.Colors.Outline, 2.5)
	Components.Gloss(button, 0.35)
	local icon = Components.Label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 6), TextSize = 40, Parent = button })
	-- Rarity-coloured name band along the bottom.
	local band = Create("Frame", {
		Name = "RarityBand",
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 1, -24),
		BackgroundColor3 = Theme.Colors.Level,
		Parent = button,
	})
	Components.Corner(band, UDim.new(0, 12))
	local name = Components.Label({
		Size = UDim2.new(1, -8, 1, -4),
		Position = UDim2.fromOffset(4, 2),
		Font = Theme.Fonts.Heavy,
		TextSize = 12,
		TextScaled = true,
		TextColor3 = Theme.Colors.TextLight,
		Parent = band,
	})
	Components.TextStroke(name, Theme.Colors.Outline, 1.5)
	local count = Components.Label({
		Size = UDim2.fromOffset(60, 18),
		Position = UDim2.new(1, -5, 0, 3),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = 16,
		TextColor3 = Theme.Colors.TextLight,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 2,
		Parent = button,
	})
	Components.TextStroke(count, Theme.Colors.Outline, 2)
	button.MouseEnter:Connect(function()
		Components.SpringScale(button, 1.07)
	end)
	button.MouseLeave:Connect(function()
		Components.SpringScale(button, 1)
	end)
	local newCard: Card = { Button = button, Icon = icon, Name = name, Count = count, Stroke = stroke, Band = band }
	button.Activated:Connect(function()
		local entryId = button:GetAttribute("EntryId")
		if type(entryId) == "string" then
			self.SelectedId = entryId
			self:_renderDetails()
			self:_renderSelection()
		end
	end)
	self.Cards[index] = newCard
	return newCard
end

function InventoryPanel:_visibleEntries(): { Entry }
	local visible = {}
	for _, entry in self.Entries do
		local inCategory = self.Category == "All" or entry.Category == self.Category
		local matches = self.Search == "" or string.find(string.lower(entry.Name), self.Search, 1, true) ~= nil
		if inCategory and matches then
			table.insert(visible, entry)
		end
	end
	local mode = SORT_MODES[self.SortIndex]
	table.sort(visible, function(a, b)
		if mode == "Amount" and a.Count ~= b.Count then
			return a.Count > b.Count
		elseif mode == "Value" and a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.Name < b.Name
	end)
	return visible
end

function InventoryPanel:_renderSelection()
	for _, card in self.Cards do
		local selected = card.Button.Visible and card.Button:GetAttribute("EntryId") == self.SelectedId
		card.Stroke.Thickness = if selected then 4.5 else 2.5
		card.Button.BackgroundColor3 = if selected then Color3.fromRGB(255, 240, 190) else Theme.Colors.Panel
	end
end

function InventoryPanel:_renderDetails()
	local entry = self:_selectedEntry()
	if not entry then
		self.DetailIcon.Text = ""
		self.DetailName.Text = "Select an item"
		self.DetailRarity.Text = ""
		self.DetailStats.Text = ""
		self.DetailDescription.Text = ""
		self.EquipButton.Visible = false
		return
	end
	local rarity = RarityConfig.Get(entry.Rarity)
	self.DetailBubble.BackgroundColor3 = rarity.Color:Lerp(Color3.new(1, 1, 1), 0.55)
	self.DetailIcon.Text = entry.Icon
	self.DetailName.Text = entry.Name
	self.DetailRarity.Text = rarity.DisplayName
	self.DetailRarity.TextColor3 = rarity.Color
	self.DetailDescription.Text = entry.Description
	if entry.Kind == "Tool" and entry.ToolDef then
		local def = entry.ToolDef
		self.DetailStats.Text = ("Power %d · Speed x%.2f\nBonus %d%%"):format(def.Power, def.Speed, math.floor(def.ResourceBonus * 100))
		local equipped = self.State.Equipped == entry.Id
		self.EquipButton.Visible = true
		self.EquipButton.Text = if equipped then "UNEQUIP" else "EQUIP"
	else
		self.DetailStats.Text = ("Amount: %s\nSells for: %s 🪙 each"):format(Format.Commas(entry.Count), Format.Commas(entry.Value))
		-- Seeds and crops can be held: plant by clicking soil, feed animals.
		local holdable = ItemConfig.IsHoldable(entry.Id)
		local held = self.State.Equipped == entry.Id
		self.EquipButton.Visible = holdable
		self.EquipButton.Text = if held then "PUT AWAY" else "✋ HOLD"
	end
end

function InventoryPanel:Render()
	for id, button in self.TabButtons do
		Components.SetButtonColor(button, if id == self.Category then Theme.Colors.Coins else Theme.Colors.PanelAlt)
	end
	self.CapacityLabel.Text = ("%s / %s"):format(Format.Commas(self.State.Used or 0), Format.Commas(self.State.Capacity or 0))

	local visible = self:_visibleEntries()
	for index, entry in visible do
		local card = self:_getCard(index)
		local rarity = RarityConfig.Get(entry.Rarity)
		card.Button.Visible = true
		card.Button.LayoutOrder = index
		card.Button:SetAttribute("EntryId", entry.Id)
		card.Icon.Text = entry.Icon
		card.Name.Text = entry.Name
		card.Band.BackgroundColor3 = rarity.Color:Lerp(Theme.Colors.Outline, 0.15)
		card.Count.Text = if entry.Kind == "Tool" then (if self.State.Equipped == entry.Id then "✔" else "") else "x" .. Format.Abbreviate(entry.Count)
	end
	for index = #visible + 1, #self.Cards do
		self.Cards[index].Button.Visible = false
	end
	self.EmptyLabel.Visible = #visible == 0
	self:_renderSelection()
	self:_renderDetails()
end

-- state = { Items, Capacity, Used, OwnedTools, Equipped }
function InventoryPanel:SetState(state: { [string]: any })
	self.State = state
	self:_buildEntries()
	if self.Panel.Visible then
		self:Render()
	end
end

function InventoryPanel:Open()
	self.Panel.Visible = true
	self:Render()
	Components.Bounce(self.Panel, 0.06)
end

function InventoryPanel:Close()
	self.Panel.Visible = false
end

function InventoryPanel:IsOpen(): boolean
	return self.Panel.Visible
end

return InventoryPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Notifications
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/Notifications
	DEPENDENCIES: Client.UI.{Theme, Components}

	"Did that work?" feedback (spec §151/§152), cartoon style:
	  Toast   glossy pill with an icon bubble; pops in, fades out (max 4)
	  Banner  big title on a ribbon that bounces + wobbles in (queued)
	  Float   pooled floating text ("+25 🪙", "+3 Wood") that pops, tilts,
	          rises and fades
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local MAX_TOASTS = 4
local TOAST_TIME = 3
local BANNER_TIME = 2.6
local FLOAT_POOL = 12

local TOAST_STYLES = {
	Toast = { Background = Theme.Colors.Panel, Text = Theme.Colors.Text, Bubble = Theme.Colors.Blue, Icon = "💬" },
	Success = { Background = Theme.Colors.Green, Text = Theme.Colors.TextLight, Bubble = Theme.Colors.Panel, Icon = "✔" },
	Error = { Background = Theme.Colors.Red, Text = Theme.Colors.TextLight, Bubble = Theme.Colors.Panel, Icon = "✖" },
}

local BANNER_COLORS = {
	LevelUp = Theme.Colors.Level,
	IslandLevelUp = Theme.Colors.Coins,
	AreaUnlock = Theme.Colors.Blue,
	Reward = Theme.Colors.Orange,
	Build = Theme.Colors.Green,
	Error = Theme.Colors.Red,
}

local Notifications = {}
Notifications.__index = Notifications

function Notifications.new(parent: Instance)
	local self = setmetatable({}, Notifications)

	self.ToastContainer = Create("Frame", {
		Name = "Toasts",
		Size = UDim2.fromOffset(460, 220),
		Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	self.Banner = Create("CanvasGroup", {
		Name = "Banner",
		Size = UDim2.fromOffset(760, 140),
		Position = UDim2.fromScale(0.5, 0.3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = parent,
	})
	self.BannerScale = Create("UIScale", { Parent = self.Banner })
	-- Ribbon behind the title (colour follows the banner style).
	self.BannerRibbon = Create("Frame", {
		Name = "Ribbon",
		Size = UDim2.new(0.86, 0, 0, 74),
		Position = UDim2.new(0.5, 0, 0, 6),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Theme.Colors.Coins,
		Parent = self.Banner,
	})
	Components.Corner(self.BannerRibbon, UDim.new(0, 22))
	Components.Stroke(self.BannerRibbon, Theme.Colors.Outline, 4)
	Components.Gloss(self.BannerRibbon)
	for index, side in { -1, 1 } do
		Components.Label({
			Name = "Star" .. index,
			Text = "✦",
			Size = UDim2.fromOffset(60, 60),
			Position = UDim2.new(0.5 + side * 0.47, 0, 0, 13),
			AnchorPoint = Vector2.new(0.5, 0),
			TextSize = 48,
			TextColor3 = Color3.fromRGB(255, 245, 170),
			Parent = self.Banner,
		})
	end
	self.BannerTitle = Components.Label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromOffset(0, 2),
		TextSize = Theme.TextSize.Huge + 8,
		TextColor3 = Theme.Colors.TextLight,
		TextWrapped = false,
		Parent = self.Banner,
	})
	Components.TextStroke(self.BannerTitle, Theme.Colors.Outline, 4)
	self.BannerSubtitle = Components.Label({
		Name = "Subtitle",
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromOffset(0, 86),
		TextSize = Theme.TextSize.Large + 2,
		TextColor3 = Theme.Colors.TextLight,
		Parent = self.Banner,
	})
	Components.TextStroke(self.BannerSubtitle, Theme.Colors.Outline, 2.5)
	self.BannerQueue = {}
	self.BannerBusy = false

	self.FloatLayer = Create("Frame", {
		Name = "Floats",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	self.Floats = {}
	for index = 1, FLOAT_POOL do
		local label = Components.Label({
			Name = "Float" .. index,
			Size = UDim2.fromOffset(260, 40),
			AnchorPoint = Vector2.new(0.5, 0.5),
			TextSize = Theme.TextSize.Large + 6,
			TextWrapped = false,
			Visible = false,
			Parent = self.FloatLayer,
		})
		Components.TextStroke(label, Theme.Colors.Outline, 3)
		Create("UIScale", { Name = "PopScale", Parent = label })
		table.insert(self.Floats, label)
	end
	self.NextFloat = 1
	self.ToastCount = 0

	return self
end

function Notifications:Toast(kind: string, text: string, icon: string?)
	local style = TOAST_STYLES[kind] or TOAST_STYLES.Toast
	local toasts = self.ToastContainer:GetChildren()
	local existing = {}
	for _, child in toasts do
		if child:IsA("CanvasGroup") then
			table.insert(existing, child)
		end
	end
	if #existing >= MAX_TOASTS then
		table.sort(existing, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		existing[1]:Destroy()
	end

	self.ToastCount += 1
	local toast = Create("CanvasGroup", {
		Size = UDim2.fromOffset(450, 48),
		BackgroundColor3 = style.Background,
		GroupTransparency = 1,
		LayoutOrder = self.ToastCount,
		Parent = self.ToastContainer,
	})
	Components.Corner(toast, UDim.new(1, 0))
	Components.Stroke(toast, Theme.Colors.Outline, 3)
	Components.Gloss(toast, 0.5)
	local bubble = Create("Frame", {
		Size = UDim2.fromOffset(38, 38),
		Position = UDim2.new(0, 5, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = style.Bubble,
		Parent = toast,
	})
	Components.Corner(bubble, UDim.new(1, 0))
	Components.Gloss(bubble, 0.6)
	Components.Label({
		Text = icon or style.Icon,
		Size = UDim2.fromScale(1, 1),
		TextSize = 22,
		TextColor3 = if style.Bubble == Theme.Colors.Panel then style.Background else Theme.Colors.TextLight,
		Parent = bubble,
	})
	local label = Components.Label({
		Text = text,
		Size = UDim2.new(1, -62, 1, 0),
		Position = UDim2.fromOffset(50, 0),
		TextColor3 = style.Text,
		TextSize = Theme.TextSize.Medium,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = toast,
	})
	Create("UITextSizeConstraint", { MaxTextSize = Theme.TextSize.Medium + 1, Parent = label })

	Components.PopIn(toast)
	TweenService:Create(toast, TweenInfo.new(0.18), { GroupTransparency = 0 }):Play()
	task.delay(TOAST_TIME, function()
		if toast.Parent then
			local fade = TweenService:Create(toast, TweenInfo.new(0.35), { GroupTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			toast:Destroy()
		end
	end)
end

function Notifications:_showNextBanner()
	local nextBanner = table.remove(self.BannerQueue, 1)
	if not nextBanner then
		self.BannerBusy = false
		return
	end
	self.BannerBusy = true
	self.BannerTitle.Text = nextBanner.Title
	self.BannerRibbon.BackgroundColor3 = BANNER_COLORS[nextBanner.Style] or Theme.Colors.Coins
	self.BannerSubtitle.Text = nextBanner.Subtitle or ""
	self.Banner.Visible = true
	self.Banner.GroupTransparency = 1
	self.BannerScale.Scale = 0.4
	self.Banner.Rotation = -8
	TweenService:Create(self.Banner, TweenInfo.new(0.2), { GroupTransparency = 0 }):Play()
	TweenService:Create(self.BannerScale, TweenInfo.new(0.55, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(self.Banner, TweenInfo.new(0.9, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	task.delay(BANNER_TIME, function()
		local fade = TweenService:Create(self.Banner, TweenInfo.new(0.35), { GroupTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		self.Banner.Visible = false
		self:_showNextBanner()
	end)
end

function Notifications:Banner(title: string, subtitle: string?, style: string?)
	table.insert(self.BannerQueue, { Title = title, Subtitle = subtitle, Style = style })
	if not self.BannerBusy then
		self:_showNextBanner()
	end
end

-- Floating text at a screen position (UDim2 inside the float layer).
function Notifications:Float(text: string, color: Color3, position: UDim2, rise: number?)
	local label = self.Floats[self.NextFloat]
	self.NextFloat = self.NextFloat % FLOAT_POOL + 1
	label.Text = text
	label.TextColor3 = color
	label.Position = position
	label.TextTransparency = 0
	label.Visible = true
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	local target = position - UDim2.fromOffset(0, rise or 60)
	local info = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	-- Pop in big with a little tilt, then rise and fade.
	local pop = label:FindFirstChild("PopScale")
	if pop and pop:IsA("UIScale") then
		pop.Scale = 1.6
		TweenService:Create(pop, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	label.Rotation = math.random(-10, 10)
	TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	TweenService:Create(label, info, { Position = target, TextTransparency = 1 }):Play()
	if stroke then
		TweenService:Create(stroke, info, { Transparency = 1 }):Play()
	end
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Theme
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/Theme
	DEPENDENCIES: none

	The single source of UI colours, fonts and sizes ("Island Pop" style):
	warm cream paper panels with a chocolate outline, candy-bright accent
	colours with glossy highlights and a 3D lip, soft layered drop shadows,
	Fredoka One titles and Builder Sans text.
]]

local Theme = {}

Theme.Colors = {
	-- Paper
	Panel = Color3.fromRGB(255, 251, 240),
	PanelAlt = Color3.fromRGB(248, 239, 220),
	PanelDark = Color3.fromRGB(230, 214, 186),
	Inset = Color3.fromRGB(239, 227, 203), -- recessed wells (lists, grids)
	-- Chrome
	Header = Color3.fromRGB(58, 162, 242),
	HeaderDark = Color3.fromRGB(36, 116, 200),
	Outline = Color3.fromRGB(56, 38, 26),
	Text = Color3.fromRGB(62, 42, 28),
	TextMuted = Color3.fromRGB(140, 112, 86),
	TextLight = Color3.fromRGB(255, 255, 255),
	-- Accents
	Coins = Color3.fromRGB(255, 200, 40),
	Gems = Color3.fromRGB(86, 204, 255),
	Level = Color3.fromRGB(112, 210, 86),
	Blue = Color3.fromRGB(62, 164, 255),
	Green = Color3.fromRGB(86, 204, 96),
	Red = Color3.fromRGB(242, 86, 86),
	Orange = Color3.fromRGB(255, 156, 52),
	Purple = Color3.fromRGB(162, 112, 255),
	Pink = Color3.fromRGB(255, 118, 172),
	Teal = Color3.fromRGB(38, 196, 184),
	-- Effects
	Shadow = Color3.fromRGB(20, 12, 6),
	Glass = Color3.fromRGB(26, 32, 50),
}

Theme.Fonts = {
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.BuilderSansMedium,
	Bold = Enum.Font.BuilderSansBold,
	Heavy = Enum.Font.BuilderSansExtraBold,
}

Theme.Corner = UDim.new(0, 18)
Theme.SmallCorner = UDim.new(0, 12)
Theme.StrokeThickness = 3

Theme.TextSize = {
	Huge = 44,
	Title = 28,
	Large = 22,
	Medium = 18,
	Small = 15,
	Tiny = 12,
}

-- Design resolution: the whole UI is built at this size and scaled by UIScale.
Theme.DesignSize = Vector2.new(1280, 720)

-- Brighter / darker versions of a colour (for gradients and hover states).
function Theme.Lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

function Theme.Darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

return Theme
]]></string>
            </Properties>
          </Item>
