		ProgressFill = progressFill,
		ReelHint = reelHint,
		Card = card,
		CardIcon = cardIcon,
		CardTitle = cardTitle,
		CardRarity = cardRarity,
		CardInfo = cardInfo,
		CardNew = cardNew,
	}
end

---------------------------------------------------------------------------
-- Reel minigame
---------------------------------------------------------------------------

local function finishReel(success: boolean)
	local current = minigame
	if not current or current.Finished then
		return
	end
	current.Finished = true
	Net.FireServer("FishingRequest", { Op = "Reel", Success = success, Token = current.Token })
	refs.Reel.Visible = false
	setStatus(if success then "🎣 Landing it..." else nil, Theme.Colors.Green)
end

local function stepMinigame(dt: number)
	local current = minigame
	if not current or current.Finished then
		return
	end
	dt = math.min(dt, 0.1)
	local tuning = FishConfig.Minigame
	current.Elapsed += dt

	-- Player zone: hold to lift, gravity pulls it down.
	local held = InputController.IsHeld("UseTool")
	current.ZoneVel = math.clamp(current.ZoneVel + (if held then tuning.Lift else -tuning.Gravity) * dt, -tuning.MaxSpeed, tuning.MaxSpeed)
	current.ZonePos += current.ZoneVel * dt
	local top = 1 - current.ZoneSize
	if current.ZonePos <= 0 then
		current.ZonePos = 0
		current.ZoneVel = math.max(0, current.ZoneVel)
	elseif current.ZonePos >= top then
		current.ZonePos = top
		current.ZoneVel = math.min(0, current.ZoneVel)
	end

	-- Fish: darts to a new target every so often; harder fish dart more.
	current.FishTimer -= dt
	if current.FishTimer <= 0 then
		current.FishTarget = random:NextNumber(0.04, 0.96)
		current.FishTimer = random:NextNumber(0.6, 1.6) / (0.6 + current.Difficulty * 0.25)
	end
	current.FishPos += (current.FishTarget - current.FishPos) * math.min(1, dt * (1.1 + current.Difficulty * 0.45))

	local inside = current.FishPos >= current.ZonePos and current.FishPos <= current.ZonePos + current.ZoneSize
	local gain = tuning.GainRate / (1 + current.Difficulty * tuning.DifficultyScale)
	if inside then
		current.Progress += gain * dt
	elseif current.Elapsed > START_GRACE then
		current.Progress -= tuning.LossRate * dt
	end

	refs.Zone.Size = UDim2.fromScale(1, current.ZoneSize)
	refs.Zone.Position = UDim2.fromScale(0, 1 - current.ZonePos)
	refs.Zone.BackgroundColor3 = if inside then Theme.Colors.Green else Theme.Colors.Orange
	refs.Fish.Position = UDim2.fromScale(0.5, 1 - current.FishPos)
	refs.ProgressFill.Size = UDim2.fromScale(1, math.clamp(current.Progress, 0, 1))

	if current.Progress >= 1 then
		finishReel(true)
	elseif current.Progress <= 0 then
		finishReel(false)
	end
end

local function startMinigame(rarityName: string, difficulty: number, token: any)
	local tuning = FishConfig.Minigame
	local rarity = RarityConfig.Get(rarityName)
	minigame = {
		Token = token,
		Difficulty = difficulty,
		Rarity = rarityName,
		ZoneSize = math.max(0.14, tuning.ZoneSize - 0.03 * difficulty),
		ZonePos = 0.35,
		ZoneVel = 0,
		FishPos = 0.5,
		FishTarget = 0.5,
		FishTimer = 0.6,
		Progress = tuning.StartProgress,
		Elapsed = 0,
		Finished = false,
	}
	refs.ReelTitle.Text = string.upper(rarity.DisplayName) .. "!"
	refs.ReelTitle.TextColor3 = rarity.Color
	refs.ProgressFill.BackgroundColor3 = rarity.Color
	refs.ReelHint.Text = ("HOLD %s to lift the zone.\nKeep the 🐟 inside!"):format(useHint())
	refs.Reel.Visible = true
	Components.Bounce(refs.Reel, 0.1)
	setStatus(nil)
end

---------------------------------------------------------------------------
-- Server events
---------------------------------------------------------------------------

local function onFishingEvent(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local op = payload.Op
	if op == "Cast" then
		state = "Waiting"
		if not resumePrompts then
			resumePrompts = InteractionController.PausePrompts()
		end
		startBobber()
		AudioController.Play("FishingCast")
		setStatus("🎣 Waiting for a bite...  (X to stop)", Theme.Colors.Outline)
	elseif op == "Bite" then
		if state ~= "Waiting" then
			return
		end
		state = "Bite"
		showBiteMark(true)
		VFXController.Play("WaterSplash", bobberBase)
		AudioController.Play("FishBite")
		CameraController.Shake(0.25, 0.25)
		setStatus(("❗ BITE! %s NOW!"):format(useHint()), Theme.Colors.Red)
	elseif op == "Reel" then
		state = "Reeling"
		showBiteMark(false)
		AudioController.Play("Reel")
		startMinigame(tostring(payload.Rarity), tonumber(payload.Difficulty) or 1, payload.Token)
	elseif op == "Caught" then
		local fishId = payload.FishId
		local position = bobberBase
		resetAll()
		VFXController.Play("WaterSplash", position)
		if type(fishId) == "string" then
			showCatch(fishId, tonumber(payload.Weight) or 0, payload.New == true)
		end
	elseif op == "End" then
		resetAll()
		if type(payload.Reason) == "string" then
			UIController.Notify("Error", payload.Reason, "🎣")
		end
	end
end

-- No Cast reply → the server refused (no spot nearby, cooldown...): allow a new cast.
local function expireCast(requestedAt: number)
	if state == "Casting" and castRequestedAt == requestedAt then
		state = "Idle"
	end
end

-- USE while holding a rod. Returns true = handled (no tool swing).
local function onUse(_def: any): boolean
	local now = os.clock()
	if state == "Idle" then
		if now - castRequestedAt < FishConfig.CastCooldown then
			return true
		end
		castRequestedAt = now
		state = "Casting"
		Net.FireServer("FishingRequest", { Op = "Cast" })
		task.delay(CAST_TIMEOUT, expireCast, now)
	elseif state == "Waiting" then
		-- Too early: the server scares the fish off and tells us why.
		Net.FireServer("FishingRequest", { Op = "Hook" })
	elseif state == "Bite" then
		state = "Hooking"
		showBiteMark(false)
		setStatus("🎣 Hooked!", Theme.Colors.Green)
		Net.FireServer("FishingRequest", { Op = "Hook" })
	end
	return true
end

function FishingController.IsFishing(): boolean
	return state ~= "Idle"
end

function FishingController.Init()
	buildUI()
end

function FishingController.Start()
	ToolController.SetUseOverride("FishingRod", onUse)
	Net.OnClientEvent("FishingEvent", onFishingEvent)
	RunService.RenderStepped:Connect(stepMinigame)

	InputController.On("Cancel", cancelFishing)
	ToolController.EquippedChanged:Connect(function(def: any)
		if (not def or def.Type ~= "FishingRod") and state ~= "Idle" and state ~= "Casting" then
			resetAll()
		end
	end)
	player.CharacterRemoving:Connect(function()
		rodAttachment = nil
		resetAll()
	end)
end

return FishingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">GatherController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  GatherController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/GatherController
	DEPENDENCIES: Shared.Net, ToolController, Shared.Util.R15, Shared.Config.{BuildingConfig, BuildConfig},
	              Client.UI.{Theme, Components}

	What a tool swing HITS. When ToolController reports the swing's impact
	marker (Hit / Dig / HammerHit), this finds the node or construction site
	in front of you and asks the server to apply it:
	  Axe / Pickaxe / Shovel -> GatherRequest(nodeId)
	  Hammer                 -> BuildRequest{Op="Hammer", UniqueId}
	The server re-validates distance, tool and ownership.

	Feedback (client-only, no network): a health bar over a hit node and a
	quick wobble so every hit visibly lands (spec §15 "each chop gives progress").
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local R15 = require(Shared.Util.R15)
local BuildingConfig = require(Shared.Config.BuildingConfig)
local BuildConfig = require(Shared.Config.BuildConfig)

local Client = script.Parent.Parent
local ToolController = require(script.Parent.ToolController)
local Theme = require(Client.UI.Theme)
local Components = require(Client.UI.Components)

local NODE_TAG = "ResourceNode"
local SITE_TAG = "ConstructionSite"
local SWING_REACH = 10
local BAR_VISIBLE_TIME = 3

local GatherController = {}

local bars: { [Model]: { Gui: BillboardGui, Fill: Frame, HideAt: number } } = {}

local function rootPart(): BasePart?
	return R15.GetRootPart(Players.LocalPlayer.Character)
end

-- Nearest tagged model in front of the character within reach.
local function findTarget(tag: string, reach: number, filter: (Model) -> boolean): Model?
	local root = rootPart()
	if not root then
		return nil
	end
	local best, bestScore = nil, math.huge
	for _, instance in CollectionService:GetTagged(tag) do
		if instance:IsA("Model") and filter(instance) then
			local pivot = instance:GetPivot().Position
			local offset = Vector3.new(pivot.X - root.Position.X, 0, pivot.Z - root.Position.Z)
			local distance = offset.Magnitude
			local facing = if distance > 0.1 then root.CFrame.LookVector:Dot(offset.Unit) else 1
			if distance <= reach and facing > -0.2 then
				local score = distance - facing * 3
				if score < bestScore then
					best, bestScore = instance, score
				end
			end
		end
	end
	return best
end

local function onImpact(toolDef: any)
	if toolDef.Type == "Hammer" then
		-- Same reach rule as BuildService: HammerRange + half the footprint.
		local root = rootPart()
		local site = findTarget(SITE_TAG, 80, function(model)
			local def = BuildingConfig.Get(model:GetAttribute("BuildingId"))
			if not def or not root then
				return false
			end
			local reach = BuildConfig.HammerRange + math.max(def.Footprint.X, def.Footprint.Y) / 2
			return (model:GetPivot().Position - root.Position).Magnitude <= reach
		end)
		if site then
			Net.FireServer("BuildRequest", { Op = "Hammer", UniqueId = site:GetAttribute("UniqueId") })
		end
		return
	end
	local node = findTarget(NODE_TAG, SWING_REACH, function(model)
		return model:GetAttribute("Depleted") ~= true and model:GetAttribute("ToolType") == toolDef.Type
	end)
	if node then
		Net.FireServer("GatherRequest", node:GetAttribute("NodeId"))
	end
end

local function barFor(model: Model)
	local existing = bars[model]
	if existing then
		return existing
	end
	local anchor = model.PrimaryPart
	if not anchor then
		return nil
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "HealthBar"
	gui.Size = UDim2.fromOffset(110, 16)
	gui.StudsOffset = Vector3.new(0, anchor.Size.Y / 2 + 1.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 60
	gui.Enabled = false
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Theme.Colors.Outline
	back.Parent = gui
	Components.Corner(back, UDim.new(1, 0))
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Theme.Colors.Green
	fill.Parent = back
	Components.Corner(fill, UDim.new(1, 0))
	gui.Parent = anchor
	local bar = { Gui = gui, Fill = fill, HideAt = 0 }
	bars[model] = bar
	model.Destroying:Once(function()
		bars[model] = nil
	end)
	return bar
end

local function wobble(model: Model)
	local base = model:GetPivot()
	local driver = Instance.new("NumberValue")
	driver.Changed:Connect(function(alpha)
		if model.Parent then
			model:PivotTo(base * CFrame.Angles(math.sin(alpha * math.pi * 3) * 0.05 * (1 - alpha), 0, 0))
		end
	end)
	local tween = TweenService:Create(driver, TweenInfo.new(0.3), { Value = 1 })
	tween.Completed:Once(function()
		driver:Destroy()
		if model.Parent and model:GetAttribute("Depleted") ~= true then
			model:PivotTo(base)
		end
	end)
	tween:Play()
end

local function onHealthChanged(model: Model)
	local health = model:GetAttribute("Health")
	local maxHealth = model:GetAttribute("MaxHealth")
	if type(health) ~= "number" or type(maxHealth) ~= "number" or maxHealth <= 1 then
		return
	end
	local bar = barFor(model)
	if not bar then
		return
	end
	local alpha = math.clamp(health / maxHealth, 0, 1)
	bar.Gui.Enabled = health > 0 and health < maxHealth
	bar.Fill.BackgroundColor3 = Theme.Colors.Red:Lerp(Theme.Colors.Green, alpha)
	TweenService:Create(bar.Fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(alpha, 1) }):Play()
	bar.HideAt = os.clock() + BAR_VISIBLE_TIME
	if health > 0 and health < maxHealth then
		wobble(model)
	end
end

local function watchNode(instance: Instance)
	if not instance:IsA("Model") then
		return
	end
	instance:GetAttributeChangedSignal("Health"):Connect(function()
		onHealthChanged(instance)
	end)
end

function GatherController.Start()
	ToolController.ToolImpact:Connect(onImpact)
	for _, node in CollectionService:GetTagged(NODE_TAG) do
		watchNode(node)
	end
	CollectionService:GetInstanceAddedSignal(NODE_TAG):Connect(watchNode)

	-- Hide idle health bars (one cheap loop, not per-node timers).
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			for _, bar in bars do
				if bar.Gui.Enabled and now > bar.HideAt then
					bar.Gui.Enabled = false
				end
			end
		end
	end)
end

return GatherController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InputController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/InputController
	DEPENDENCIES: Shared.Config.InputConfig, Shared.Util.Signal

	Turns raw input into named ACTIONS (see InputConfig). Keyboard, mouse and
	gamepad are mapped here; touch UI buttons call InputController.Trigger().
	Gameplay controllers only ever listen with InputController.On(action, fn),
	which is what makes every feature work on desktop, mobile and console.

	Also tracks the active device ("KeyboardMouse" | "Touch" | "Gamepad") so
	the UI can show touch buttons only when needed.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local InputConfig = require(Shared:WaitForChild("Config"):WaitForChild("InputConfig"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))

local InputController = {}

InputController.DeviceChanged = Signal.new() -- (deviceType)

local actionSignals: { [string]: any } = {}
local held: { [string]: number } = {} -- action -> number of inputs holding it
local bindings: { [any]: { string } } = {} -- KeyCode/UserInputType -> actions
local device = "KeyboardMouse"
local blocked: { [string]: number } = {} -- action -> block count

local function signalFor(action: string)
	local signal = actionSignals[action]
	if not signal then
		assert(InputConfig.Actions[action], "Unknown input action " .. action)
		signal = Signal.new()
		actionSignals[action] = signal
	end
	return signal
end

local function bind(input: any, action: string)
	local list = bindings[input]
	if not list then
		list = {}
		bindings[input] = list
	end
	table.insert(list, action)
end

local function classify(inputType: Enum.UserInputType): string?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.find(inputType.Name, "Gamepad") then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Keyboard or string.find(inputType.Name, "Mouse") then
		return "KeyboardMouse"
	end
	return nil
end

local function setDevice(newDevice: string)
	if newDevice ~= device then
		device = newDevice
		InputController.DeviceChanged:Fire(device)
	end
end

function InputController.On(action: string, callback: () -> ())
	return signalFor(action):Connect(callback)
end

function InputController.Trigger(action: string)
	if (blocked[action] or 0) > 0 then
		return
	end
	signalFor(action):Fire()
end

-- Temporarily block an action (e.g. UseTool while a menu is open). Returns an unblock function.
function InputController.Block(action: string): () -> ()
	blocked[action] = (blocked[action] or 0) + 1
	local released = false
	return function()
		if not released then
			released = true
			blocked[action] = math.max(0, (blocked[action] or 1) - 1)
		end
	end
end

-- True while an input bound to the action is held down (used by the fishing reel).
function InputController.IsHeld(action: string): boolean
	return (held[action] or 0) > 0
end

-- Touch buttons report press/release through this.
function InputController.SetHeld(action: string, isHeld: boolean)
	held[action] = math.max(0, (held[action] or 0) + (if isHeld then 1 else -1))
	if not isHeld and held[action] == 0 then
		held[action] = nil
	end
end

function InputController.GetDevice(): string
	return device
end

function InputController.IsTouch(): boolean
	return device == "Touch"
end

function InputController.Init()
	for action, def in InputConfig.Actions do
		signalFor(action)
		for _, input in def.Inputs do
			bind(input, action)
		end
		for _, input in def.Gamepad do
			bind(input, action)
		end
	end

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		device = "Touch"
	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
		device = "Gamepad"
	end
end

function InputController.Start()
	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		local newDevice = classify(inputType)
		if newDevice then
			setDevice(newDevice)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return -- typing in chat, clicking a GUI button, a ProximityPrompt key...
		end
		-- Keys/buttons bind by KeyCode; mouse buttons bind by UserInputType.
		local actions = bindings[input.KeyCode] or bindings[input.UserInputType]
		if actions then
			for _, action in actions do
				InputController.SetHeld(action, true)
				InputController.Trigger(action)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local actions = bindings[input.KeyCode] or bindings[input.UserInputType]
		if actions then
			for _, action in actions do
				if (held[action] or 0) > 0 then
					InputController.SetHeld(action, false)
				end
			end
		end
	end)
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">InteractionController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InteractionController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/InteractionController
	DEPENDENCIES: AudioController

	Client polish for the server's ProximityPrompt interactions:
	  * outlines the object whose prompt is showing (one pooled Highlight),
	  * hides owner-only prompts on islands you don't own (visual only — the
	    server still rejects the action),
	  * can pause all prompts while a menu or build mode is open,
	  * turns your character to FACE what you interact with, so chopping,
	    milking or planting animations line up with the target.
	Prompt text / keys / touch buttons come from the server's prompt itself.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local R15 = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("R15"))

local AudioController = require(script.Parent.AudioController)

local OWNER_ONLY_TAG = "OwnerOnlyPrompt"

local InteractionController = {}

local highlight: Highlight
local shownPrompt: ProximityPrompt? = nil
local pauseCount = 0

local function adorneeFor(prompt: ProximityPrompt): Instance?
	local parent = prompt.Parent
	if not parent then
		return nil
	end
	-- Outline the whole object (tree, building, cow...) — but never the whole island.
	local model = parent:FindFirstAncestorOfClass("Model")
	local islands = workspace:FindFirstChild("Islands")
	if model and model.Parent ~= islands then
		return model
	end
	if parent:IsA("Attachment") then
		return parent.Parent
	end
	return parent
end

local function hideIfNotOwner(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local ownerUserId = prompt:GetAttribute("OwnerUserId")
	if ownerUserId == nil or ownerUserId == Players.LocalPlayer.UserId then
		return
	end
	prompt.Enabled = false
	prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
		if prompt.Enabled then
			prompt.Enabled = false
		end
	end)
end

local function targetPosition(prompt: ProximityPrompt): Vector3?
	local adornee = adorneeFor(prompt)
	if not adornee then
		return nil
	end
	if adornee:IsA("Model") then
		return adornee:GetPivot().Position
	elseif adornee:IsA("BasePart") then
		return adornee.Position
	elseif adornee:IsA("Attachment") then
		return adornee.WorldPosition
	end
	return nil
end

-- Snap the character's yaw toward the thing being used (the client owns its
-- character's physics, so this replicates; the server never trusts it).
local function faceTarget(prompt: ProximityPrompt)
	local character = Players.LocalPlayer.Character
	local root = R15.GetRootPart(character)
	local target = targetPosition(prompt)
	if not root or not target then
		return
	end
	local flat = Vector3.new(target.X, root.Position.Y, target.Z)
	if (flat - root.Position).Magnitude < 0.5 then
		return
	end
	root.CFrame = CFrame.lookAt(root.Position, flat)
end

-- Pause/resume every prompt locally (menus, build mode). Returns a resume function.
function InteractionController.PausePrompts(): () -> ()
	pauseCount += 1
	ProximityPromptService.Enabled = false
	local resumed = false
	return function()
		if resumed then
			return
		end
		resumed = true
		pauseCount = math.max(0, pauseCount - 1)
		ProximityPromptService.Enabled = pauseCount == 0
	end
end

function InteractionController.Init()
	highlight = Instance.new("Highlight")
	highlight.Name = "InteractHighlight"
	highlight.FillTransparency = 1
	highlight.OutlineColor = Color3.fromRGB(255, 245, 200)
	highlight.OutlineTransparency = 0.15
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	-- Under the camera: local-only, and always inside Workspace so it renders.
	highlight.Parent = workspace.CurrentCamera
end

function InteractionController.Start()
	for _, prompt in CollectionService:GetTagged(OWNER_ONLY_TAG) do
		hideIfNotOwner(prompt)
	end
	CollectionService:GetInstanceAddedSignal(OWNER_ONLY_TAG):Connect(hideIfNotOwner)

	ProximityPromptService.PromptShown:Connect(function(prompt)
		shownPrompt = prompt
		highlight.Adornee = adorneeFor(prompt)
		highlight.Enabled = highlight.Adornee ~= nil
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		if shownPrompt == prompt then
			shownPrompt = nil
			highlight.Enabled = false
			highlight.Adornee = nil
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		AudioController.Play("UIClick")
		faceTarget(prompt)
	end)
end

return InteractionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InventoryController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/InventoryController
	DEPENDENCIES: Client.ClientState, InputController, UIController, ToolController,
	              InteractionController, Client.UI.{InventoryPanel, Components, Theme}

	Opens/closes the backpack (I / G / gamepad Y / 🎒 button) and keeps it in
	sync with replicated Inventory + Tools state. While open, tool use and
	world prompts are paused so clicks don't leak into the world.
]]

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local InputController = require(script.Parent.InputController)
local UIController = require(script.Parent.UIController)
local ToolController = require(script.Parent.ToolController)
local InteractionController = require(script.Parent.InteractionController)
local InventoryPanel = require(Client.UI.InventoryPanel)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local InventoryController = {}

local panel: any
local releaseBlocks: { () -> () } = {}

local function buildState()
	local inventory = ClientState.Get("Inventory") or {}
	local tools = ClientState.Get("Tools") or {}
	local items = inventory.Items or {}
	local used = 0
	for _, count in items do
		used += count
	end
	return {
		Items = items,
		Capacity = inventory.Capacity or 0,
		Used = used,
		OwnedTools = tools.Owned or {},
		Equipped = tools.Equipped or "",
	}
end

function InventoryController.IsOpen(): boolean
	return panel ~= nil and panel:IsOpen()
end

function InventoryController.Open()
	if InventoryController.IsOpen() then
		return
	end
	panel:SetState(buildState())
	panel:Open()
	UIController.SetModalOpen("Inventory", true)
	table.insert(releaseBlocks, InputController.Block("UseTool"))
	table.insert(releaseBlocks, InteractionController.PausePrompts())
end

function InventoryController.Close()
	if not InventoryController.IsOpen() then
		return
	end
	panel:Close()
	UIController.SetModalOpen("Inventory", false)
	for _, release in releaseBlocks do
		release()
	end
	table.clear(releaseBlocks)
end

function InventoryController.Toggle()
	if InventoryController.IsOpen() then
		InventoryController.Close()
	else
		InventoryController.Open()
	end
end

function InventoryController.Init()
	panel = InventoryPanel.new(UIController.GetModalLayer(), {
		OnClose = InventoryController.Close,
		OnEquip = function(toolId: string?)
			ToolController.RequestEquip(toolId)
		end,
	})

	local bagButton = Components.Button({
		Name = "BagButton",
		Text = "🎒",
		Color = Theme.Colors.Orange,
		Size = UDim2.fromOffset(76, 76),
		TextSize = 40,
		Parent = UIController.GetSlot("Left"),
		OnClick = InventoryController.Toggle,
	})
	bagButton.LayoutOrder = 1
	Components.Corner(bagButton, UDim.new(1, 0))
	Components.Label({
		Text = "Bag",
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -4),
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextLight,
		Parent = bagButton,
	})
end

function InventoryController.Start()
	InputController.On("ToggleInventory", InventoryController.Toggle)
	InputController.On("Cancel", InventoryController.Close)
	local function refresh()
		panel:SetState(buildState())
	end
	ClientState.Observe("Inventory", refresh)
	ClientState.Observe("Tools", refresh)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">IslandController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  IslandController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/IslandController
	DEPENDENCIES: Shared.Net, Shared.Config.{IslandConfig, ProgressionConfig}, Shared.Util.Format,
	              Client.ClientState, UIController, InputController, Client.UI.{Components, Theme}

	The right-hand ISLAND PANEL, answering the core-loop questions at a glance
	(spec "MOST IMPORTANT REQUIREMENT"):
	  * which island this is and how developed it is (name, level, XP),
	  * WHAT TO UNLOCK NEXT (next expansion + live ✔/✖ requirement checklist
	    and an Unlock button that asks the server).
	WHAT TO DO NEXT lives in the QuestController card right below it.
	Also shows the "Welcome to <island>" banner when the player arrives.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local IslandConfig = require(Shared.Config.IslandConfig)
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local PANEL_HEIGHT = 262

local IslandController = {}

type Refs = {
	Card: Frame,
	Body: Frame,
	Name: TextLabel,
	Title: TextLabel,
	XPBar: Components.ProgressBar,
	XPText: TextLabel,
	AreaName: TextLabel,
	Requirements: { TextLabel },
	UnlockButton: TextButton,
	Toggle: TextButton,
}

local refs: Refs
local nextAreaId: string? = nil
local collapsed = false
local welcomed = false

local function nextLockedArea(unlocked: { [string]: boolean }): string?
	for _, areaId in IslandConfig.AreaOrder do
		if not unlocked[areaId] and IslandConfig.Areas[areaId].Unlock then
			return areaId
		end
	end
	return nil
end

local function requirementRows(areaId: string): { { Met: boolean, Text: string } }
	local unlock = IslandConfig.Areas[areaId].Unlock
	local coins = ClientState.Get("Coins") or 0
	local level = ClientState.Get("Island", "Level") or 1
	local unlocked = ClientState.Get("Island", "UnlockedAreas") or {}
	local rows = {
		{ Met = coins >= (unlock.Coins or 0), Text = ("%s / %s 🪙"):format(Format.Abbreviate(coins), Format.Abbreviate(unlock.Coins or 0)) },
		{ Met = level >= (unlock.IslandLevel or 1), Text = ("Island Level %d"):format(unlock.IslandLevel or 1) },
	}
	if unlock.RequiresArea then
		table.insert(rows, {
			Met = unlocked[unlock.RequiresArea] == true,
			Text = "Unlock " .. IslandConfig.Areas[unlock.RequiresArea].DisplayName,
		})
	end
	return rows
end

local function refresh()
	if not ClientState.IsReady() then
		return
	end
	local island = ClientState.Get("Island") or {}
	local level = island.Level or 1
	local xp = island.XP or 0
	local needed = ProgressionConfig.IslandXPForLevel(level)
	refs.Name.Text = island.Name or "My Island"
	refs.Title.Text = ("%s · Lv %d"):format(ProgressionConfig.GetIslandTitle(level), level)
	refs.XPBar.SetProgress(xp / needed, true)
	refs.XPText.Text = ("%s / %s XP"):format(Format.Commas(xp), Format.Commas(needed))

	nextAreaId = nextLockedArea(island.UnlockedAreas or {})
	local canUnlock = false
	if nextAreaId then
		local rows = requirementRows(nextAreaId)
		canUnlock = true
		refs.AreaName.Text = "🔒 Next: " .. IslandConfig.Areas[nextAreaId].DisplayName
		for index, label in refs.Requirements do
			local row = rows[index]
			label.Visible = row ~= nil
			if row then
				label.Text = (if row.Met then "✔ " else "✖ ") .. row.Text
				label.TextColor3 = if row.Met then Theme.Colors.Green else Theme.Colors.Red
				canUnlock = canUnlock and row.Met
			end
		end
		refs.UnlockButton.Visible = true
		refs.UnlockButton.BackgroundColor3 = if canUnlock then Theme.Colors.Green else Theme.Colors.PanelDark
		refs.UnlockButton.Text = if canUnlock then "UNLOCK!" else "LOCKED"
	else
		refs.AreaName.Text = "🌟 Every area unlocked!"
		for _, label in refs.Requirements do
			label.Visible = false
		end
		refs.UnlockButton.Visible = false
	end
end

local function buildPanel(parent: Frame): Refs
	local card = Create("Frame", {
		Name = "IslandPanel",
		Size = UDim2.new(1, 0, 0, PANEL_HEIGHT),
		BackgroundColor3 = Theme.Colors.Panel,
		LayoutOrder = 1,
		Parent = parent,
	})
	Components.Corner(card)
	Components.Stroke(card)

	local header = Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = Theme.Colors.Level,
		Parent = card,
	})
	Components.Corner(header)
	local headerLabel = Components.Label({
		Text = "🏝️ MY ISLAND",
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Medium,
		Parent = header,
	})
	Components.TextStroke(headerLabel)
	local toggle = Create("TextButton", {
		Name = "Toggle",
		Size = UDim2.fromOffset(32, 32),
		Position = UDim2.new(1, -4, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		Text = "–",
		Font = Theme.Fonts.Title,
		TextSize = Theme.TextSize.Large,
		TextColor3 = Theme.Colors.Text,
		Parent = header,
	})
	Components.Corner(toggle, UDim.new(1, 0))
	Components.Stroke(toggle, Theme.Colors.Outline, 2)

	local body = Create("Frame", {
		Name = "Body",
		Size = UDim2.new(1, -20, 1, -50),
		Position = UDim2.fromOffset(10, 46),
		BackgroundTransparency = 1,
		Parent = card,
	})

	local name = Components.Label({ Size = UDim2.new(1, 0, 0, 26), TextSize = Theme.TextSize.Medium, TextScaled = true, Text = "", Parent = body })
	local title = Components.Label({
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 26),
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "",
		Parent = body,
	})
	local xpBar = Components.ProgressBar({ Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 50), Color = Theme.Colors.Level, Parent = body })
	local xpText = Components.Label({
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 64),
		Font = Theme.Fonts.Bold,
		TextSize = 12,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "",
		Parent = body,
	})

	Create("Frame", { Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromOffset(0, 84), BackgroundColor3 = Theme.Colors.PanelDark, BorderSizePixel = 0, Parent = body })
	local areaName = Components.Label({ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 88), TextSize = Theme.TextSize.Medium, TextScaled = true, Text = "", Parent = body })
	local requirements = {}
	for index = 1, 3 do
		table.insert(requirements, Components.Label({
			Size = UDim2.new(1, 0, 0, 18),
			Position = UDim2.fromOffset(0, 112 + (index - 1) * 18),
			Font = Theme.Fonts.Bold,
			TextSize = Theme.TextSize.Small,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = "",
			Parent = body,
		}))
	end
	local unlockButton = Components.Button({
		Name = "Unlock",
		Text = "LOCKED",
		Color = Theme.Colors.PanelDark,
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 168),
		Parent = body,
		OnClick = function()
			if nextAreaId then
				Net.FireServer("UnlockAreaRequest", nextAreaId)
			end
		end,
	})

	return {
		Card = card,
		Body = body,
		Name = name,
		Title = title,
		XPBar = xpBar,
		XPText = xpText,
		AreaName = areaName,
		Requirements = requirements,
		UnlockButton = unlockButton,
		Toggle = toggle,
	}
end

local function setCollapsed(value: boolean)
	collapsed = value
	refs.Body.Visible = not collapsed
	refs.Card.Size = if collapsed then UDim2.new(1, 0, 0, 40) else UDim2.new(1, 0, 0, PANEL_HEIGHT)
	refs.Toggle.Text = if collapsed then "+" else "–"
end

function IslandController.Init()
	refs = buildPanel(UIController.GetSlot("Right"))
	refs.Toggle.Activated:Connect(function()
		setCollapsed(not collapsed)
	end)
	-- Phones have little room: start collapsed on touch devices.
	if InputController.IsTouch() then
		setCollapsed(true)
	end
end

function IslandController.Start()
	for _, key in { "Island", "Coins" } do
		ClientState.Observe(key, refresh)
	end

	ClientState.Observe("Island", function(island)
		if welcomed or type(island) ~= "table" or not island.Name or island.Name == "" then
			return
		end
		welcomed = true
		task.delay(1, function()
			UIController.Banner("Welcome to " .. island.Name .. "!", "Your island adventure begins", "Reward")
		end)
	end)
end

return IslandController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">QuestController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  QuestController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/QuestController
	DEPENDENCIES: Shared.Config.QuestConfig, Shared.Util.Format, Client.ClientState,
	              UIController, InputController, AudioController, Client.UI.{Components, Theme}

	The QUEST CARD on the right of the HUD (spec §43, §118-§119): the
	current tutorial quest, every task with ✔ / progress counts, a 💡 hint
	for the next unfinished task and the reward. It is the game's answer to
	"what do I do next?" at every moment of the first session.

	Read-only: progress arrives through replicated state (Quests.*), which
	the server only changes from real gameplay events.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestConfig = require(Shared.Config.QuestConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local AudioController = require(script.Parent.AudioController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create

local MAX_TASKS = 6
local ROW_HEIGHT = 20
local HEADER_HEIGHT = 40

local QuestController = {}

type Refs = {
	Card: Frame,
	Body: Frame,
	Toggle: TextButton,
	QuestName: TextLabel,
	Rows: { TextLabel },
	Counts: { TextLabel },
	Hint: TextLabel,
	Reward: TextLabel,
}

local refs: Refs
local collapsed = false
local bodyHeight = 0
local lastDone: { [string]: boolean } = {}
local lastQuestId: string? = nil

local function hintFor(quest: any, progress: { [string]: number }): string
	local flags = ClientState.Get("Flags") or {}
	if not flags.StarterChestClaimed then
		return "📦 Open your Starter Chest near the spawn!"
	end
	if not flags.FirstEquip then
		return if InputController.IsTouch() then "🪓 Tap a tool in your hotbar to equip it." else "🪓 Press 1-6 to equip a tool, then click to use it."
	end
	for _, questTask in quest.Tasks do
		if (progress[questTask.Id] or 0) < questTask.Amount then
			return "💡 " .. questTask.Hint
		end
	end
	return "🎉 Quest complete!"
end

local function rewardText(reward: any): string
	local parts = {}
	if reward.Coins then
		table.insert(parts, Format.Commas(reward.Coins) .. " 🪙")
	end
	if reward.IslandXP then
		table.insert(parts, Format.Commas(reward.IslandXP) .. " Island XP")
	end
	if reward.XP then
		table.insert(parts, Format.Commas(reward.XP) .. " XP")
	end
	return "🎁 " .. table.concat(parts, " · ")
end

local function layout(taskCount: number)
	-- name 22 + rows + hint 36 + reward 16 + gaps
	bodyHeight = 26 + taskCount * ROW_HEIGHT + 6 + 36 + 18
	refs.Hint.Position = UDim2.fromOffset(0, 26 + taskCount * ROW_HEIGHT + 4)
	refs.Reward.Position = UDim2.fromOffset(0, 26 + taskCount * ROW_HEIGHT + 42)
	refs.Card.Size = UDim2.new(1, 0, 0, if collapsed then HEADER_HEIGHT else HEADER_HEIGHT + 8 + bodyHeight)
end

local function refresh()
	if not ClientState.IsReady() then
		return
	end
	local quests = ClientState.Get("Quests") or {}
	local questId = quests.Current
	local quest = type(questId) == "string" and QuestConfig.Quests[questId] or nil
	local progress = quests.Progress or {}

	if not quest then
		refs.QuestName.Text = "🎉 ALL QUESTS DONE!"
		for index = 1, MAX_TASKS do
			refs.Rows[index].Visible = false
			refs.Counts[index].Visible = false
		end
		refs.Hint.Text = "Keep growing your island — more adventures coming soon."
		refs.Reward.Text = ""
		layout(0)
		return
	end

	if questId ~= lastQuestId then
		lastQuestId = questId
		table.clear(lastDone)
		Components.Bounce(refs.Card, 0.06)
	end
	refs.QuestName.Text = quest.DisplayName
	for index = 1, MAX_TASKS do
		local questTask = quest.Tasks[index]
		local row, count = refs.Rows[index], refs.Counts[index]
		row.Visible = questTask ~= nil
		count.Visible = questTask ~= nil
		if questTask then
			local value = math.min(progress[questTask.Id] or 0, questTask.Amount)
			local done = value >= questTask.Amount
			row.Text = (if done then "✔ " else "• ") .. questTask.Text
			row.TextColor3 = if done then Theme.Colors.Green else Theme.Colors.Text
			count.Text = if done then "" else ("%d/%d"):format(value, questTask.Amount)
			if done and lastDone[questTask.Id] == false then
				-- Just finished this task: a little pop + sound.
				Components.Bounce(row, 0.25)
				AudioController.Play("ItemGain")
			end
			lastDone[questTask.Id] = done
		end
	end
	refs.Hint.Text = hintFor(quest, progress)
	refs.Reward.Text = rewardText(quest.Reward)
	layout(#quest.Tasks)
end

local function buildCard(parent: Frame): Refs
	local card = Create("Frame", {
		Name = "QuestCard",
		Size = UDim2.new(1, 0, 0, 250),
		BackgroundColor3 = Theme.Colors.Panel,
		LayoutOrder = 2,
		Parent = parent,
	})
	Components.Corner(card)
	Components.Stroke(card)

	local header = Create("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, HEADER_HEIGHT), BackgroundColor3 = Theme.Colors.Purple, Parent = card })
	Components.Corner(header)
	local headerLabel = Components.Label({
		Text = "📜 QUEST",
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Colors.TextLight,
		TextSize = Theme.TextSize.Medium,
		Parent = header,
	})
	Components.TextStroke(headerLabel)
	local toggle = Create("TextButton", {
		Name = "Toggle",
		Size = UDim2.fromOffset(32, 32),
		Position = UDim2.new(1, -4, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		Text = "–",
		Font = Theme.Fonts.Title,
		TextSize = Theme.TextSize.Large,
		TextColor3 = Theme.Colors.Text,
		Parent = header,
	})
	Components.Corner(toggle, UDim.new(1, 0))
	Components.Stroke(toggle, Theme.Colors.Outline, 2)

	local body = Create("Frame", { Name = "Body", Size = UDim2.new(1, -20, 1, -(HEADER_HEIGHT + 8)), Position = UDim2.fromOffset(10, HEADER_HEIGHT + 4), BackgroundTransparency = 1, Parent = card })
	local questName = Components.Label({ Size = UDim2.new(1, 0, 0, 22), TextSize = Theme.TextSize.Medium, TextScaled = true, Text = "", Parent = body })
	local rows, counts = {}, {}
	for index = 1, MAX_TASKS do
		local y = 26 + (index - 1) * ROW_HEIGHT
		table.insert(rows, Components.Label({
			Size = UDim2.new(1, -50, 0, ROW_HEIGHT - 2),
			Position = UDim2.fromOffset(0, y),
			Font = Theme.Fonts.Bold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Text = "",
			Parent = body,
		}))
		table.insert(counts, Components.Label({
			Size = UDim2.new(0, 50, 0, ROW_HEIGHT - 2),
			Position = UDim2.new(1, -50, 0, y),
			Font = Theme.Fonts.Bold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextColor3 = Theme.Colors.TextMuted,
			Text = "",
			Parent = body,
		}))
	end
	local hint = Components.Label({
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(255, 240, 200),
		Font = Theme.Fonts.Bold,
		TextSize = 13,
		Text = "",
		Parent = body,
	})
	Components.Corner(hint, Theme.SmallCorner)
	local reward = Components.Label({ Size = UDim2.new(1, 0, 0, 16), Font = Theme.Fonts.Bold, TextSize = 12, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = body })

	return { Card = card, Body = body, Toggle = toggle, QuestName = questName, Rows = rows, Counts = counts, Hint = hint, Reward = reward }
end

local function setCollapsed(value: boolean)
	collapsed = value
	refs.Body.Visible = not collapsed
	refs.Toggle.Text = if collapsed then "+" else "–"
	refs.Card.Size = UDim2.new(1, 0, 0, if collapsed then HEADER_HEIGHT else HEADER_HEIGHT + 8 + bodyHeight)
end

function QuestController.Init()
	refs = buildCard(UIController.GetSlot("Right"))
	refs.Toggle.Activated:Connect(function()
		setCollapsed(not collapsed)
	end)
	layout(MAX_TASKS)
end

function QuestController.Start()
	for _, key in { "Quests", "Flags" } do
		ClientState.Observe(key, refresh)
	end
	InputController.DeviceChanged:Connect(refresh)
end

return QuestController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ShopController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/ShopController
	DEPENDENCIES: Shared.Net, Shared.Config.{ShopConfig, ItemConfig, EconomyConfig},
	              Shared.Util.{Format, R15}, Client.ClientState, UIController, InputController,
	              InteractionController, Client.UI.{Components, Theme}

	The ISLAND MARKET window (spec §33, §64-§65, §88-§89). Opened by the
	market stall's prompts ([E] Sell / [F] Shop → OpenUI{Screen="Market"}).

	SELL tab   today's demand bonus, one big "SELL ALL PRODUCE" button, and
	           every sellable item you own with Sell 1 / Sell All.
	BUY tab    Seeds · Animals · Tools · Upgrades from ShopConfig, showing
	           ✔ affordable / 🔒 level / OWNED / MAX states.

	Prices shown are an ESTIMATE using the same formula as the server
	(SellValue x GlobalSellMultiplier x demand). The server recomputes every
	price itself and re-checks distance, stock and funds — the client only
	sends SellItemRequest(itemId, qty) / PurchaseRequest(shopItemId, qty).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ShopConfig = require(Shared.Config.ShopConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local EconomyConfig = require(Shared.Config.EconomyConfig)
local Format = require(Shared.Util.Format)
local R15 = require(Shared.Util.R15)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local UIController = require(script.Parent.UIController)
local InputController = require(script.Parent.InputController)
local InteractionController = require(script.Parent.InteractionController)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local Create = Components.Create
local player = Players.LocalPlayer

local SELL_ALL = "__ALL__"
local WALK_AWAY_DISTANCE = ShopConfig.MarketRange + 8

local ShopController = {}

type Refs = {
	Panel: Frame,
	SellTab: TextButton,
	BuyTab: TextButton,
	SellPage: Frame,
	BuyPage: Frame,
	Demand: TextLabel,
	SellAll: TextButton,
	SellList: ScrollingFrame,
	SellEmpty: TextLabel,
	CategoryButtons: { [string]: TextButton },
	BuyList: ScrollingFrame,
}

local refs: Refs
local open = false
local tab = "Sell"
local buyCategory = "Seeds"
local releases: { () -> () } = {}
local sellRows: { Frame } = {}
local buyCards: { Frame } = {}

---------------------------------------------------------------------------
-- Pricing / demand (display only)
---------------------------------------------------------------------------

local function demandTable(): { [string]: number }
	local raw = ReplicatedStorage:GetAttribute("MarketDemand")
	local result = {}
	if type(raw) ~= "string" or raw == "" then
		return result
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and type(decoded) == "table" then
		for _, entry in decoded do
			if type(entry) == "table" and type(entry.Item) == "string" and type(entry.Bonus) == "number" then
				result[entry.Item] = entry.Bonus
			end
		end
	end
	return result
end

local function priceOf(itemId: string, demand: { [string]: number }): number
	local def = ItemConfig.Get(itemId)
	if not def or def.SellValue <= 0 then
		return 0
	end
	return math.max(1, math.floor(def.SellValue * EconomyConfig.GlobalSellMultiplier * (1 + (demand[itemId] or 0))))
end

local function demandText(demand: { [string]: number }): string
	local parts = {}
	for itemId, bonus in demand do
		local def = ItemConfig.Get(itemId)
		if def then
			table.insert(parts, ("%s %s +%d%%"):format(def.Icon, def.DisplayName, math.floor(bonus * 100 + 0.5)))
		end
	end
	table.sort(parts)
	if #parts == 0 then
		return "📈 No special demand right now."
	end
	local endsAt = ReplicatedStorage:GetAttribute("MarketDemandEndsAt")
	local remaining = if type(endsAt) == "number" then math.max(0, endsAt - workspace:GetServerTimeNow()) else 0
	return ("📈 In demand: %s   ·   changes in %s"):format(table.concat(parts, "  ·  "), Format.Duration(math.ceil(remaining)))
end

---------------------------------------------------------------------------
-- Small UI helpers
---------------------------------------------------------------------------

local function plainButton(props: Components.ButtonProps): TextButton
	local button = Components.Button(props)
	for _, child in button:GetChildren() do
		if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
			child:Destroy()
		end
	end
	return button
end

local function setButtonEnabled(button: TextButton, enabled: boolean, color: Color3)
	button.Active = enabled
	button.AutoButtonColor = false
	button.BackgroundColor3 = if enabled then color else Theme.Colors.PanelDark
	button.TextColor3 = if enabled then Theme.Colors.TextLight else Theme.Colors.TextMuted
end

---------------------------------------------------------------------------
-- SELL page
---------------------------------------------------------------------------

local function sellRow(index: number): Frame
	local row = sellRows[index]
	if row then
		return row
	end
	row = Create("Frame", { Name = "Row", Size = UDim2.new(1, -10, 0, 58), BackgroundColor3 = Theme.Colors.PanelAlt, Parent = refs.SellList })
	Components.Corner(row, Theme.SmallCorner)
	Components.Stroke(row, Theme.Colors.Outline, 2)
	Components.Label({ Name = "Icon", Size = UDim2.fromOffset(48, 48), Position = UDim2.fromOffset(6, 5), TextSize = 34, Text = "", Parent = row })
	Components.Label({ Name = "Title", Size = UDim2.new(0.45, -60, 0, 26), Position = UDim2.fromOffset(60, 4), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, Text = "", Parent = row })
	Components.Label({ Name = "Count", Size = UDim2.new(0.45, -60, 0, 20), Position = UDim2.fromOffset(60, 30), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = 13, TextColor3 = Theme.Colors.TextMuted, Text = "", Parent = row })
	Components.Label({ Name = "Price", Size = UDim2.new(0.25, 0, 1, 0), Position = UDim2.fromScale(0.42, 0), Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Text = "", Parent = row })
	plainButton({
		Name = "SellOne",
		Text = "Sell 1",
		Color = Theme.Colors.Blue,
		Size = UDim2.new(0.15, 0, 0, 40),
		Position = UDim2.new(0.68, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextSize = Theme.TextSize.Small,
		Parent = row,
		OnClick = function()
			local itemId = row:GetAttribute("ItemId")
			if type(itemId) == "string" then
				Net.FireServer("SellItemRequest", itemId, 1)
			end
		end,
	})
	plainButton({
		Name = "SellAll",
		Text = "Sell All",
		Color = Theme.Colors.Green,
		Size = UDim2.new(0.15, 0, 0, 40),
		Position = UDim2.new(1, -8, 0.5, 0),
		AnchorPoint = Vector2.new(1, 0.5),
		TextSize = Theme.TextSize.Small,
		Parent = row,
		OnClick = function()
			local itemId = row:GetAttribute("ItemId")
			if type(itemId) == "string" then
				Net.FireServer("SellItemRequest", itemId, "All")
			end
		end,
	})
	sellRows[index] = row
	return row
end

local function categoryOrder(): { [string]: number }
	local order = {}
	for index, category in ItemConfig.Categories do
		order[category.Id] = index
	end
	return order
end
local CATEGORY_ORDER = categoryOrder()

local function renderSell()
	local demand = demandTable()
	refs.Demand.Text = demandText(demand)
	local items = ClientState.Get("Inventory", "Items") or {}

	local owned = {}
	local sellAllTotal, sellAllCount = 0, 0
	for itemId, count in items do
		local def = ItemConfig.Get(itemId)
		if def and count > 0 and def.SellValue > 0 then
			table.insert(owned, def)
			if ShopConfig.SellAllCategories[def.Category] then
				sellAllTotal += priceOf(itemId, demand) * count
				sellAllCount += count
			end
		end
	end
	table.sort(owned, function(a, b)
		local orderA, orderB = CATEGORY_ORDER[a.Category] or 99, CATEGORY_ORDER[b.Category] or 99
		if orderA ~= orderB then
			return orderA < orderB
		end
		return a.DisplayName < b.DisplayName
	end)

	setButtonEnabled(refs.SellAll, sellAllCount > 0, Theme.Colors.Green)
	refs.SellAll.Text = if sellAllCount > 0
		then ("💰 SELL ALL PRODUCE  (%d items ≈ %s 🪙)"):format(sellAllCount, Format.Commas(sellAllTotal))
		else "💰 SELL ALL PRODUCE  (crops, fish, milk & eggs)"

	for index, def in owned do
		local row = sellRow(index)
		row.Visible = true
		row.LayoutOrder = index
		row:SetAttribute("ItemId", def.Id)
		local count = items[def.Id] or 0
		local price = priceOf(def.Id, demand)
		local bonus = demand[def.Id]
		;(row:FindFirstChild("Icon") :: TextLabel).Text = def.Icon
		;(row:FindFirstChild("Title") :: TextLabel).Text = def.DisplayName
		;(row:FindFirstChild("Count") :: TextLabel).Text = ("x%d owned"):format(count)
		local priceLabel = row:FindFirstChild("Price") :: TextLabel
		priceLabel.Text = if bonus
			then ("%s 🪙 each\n📈 +%d%%"):format(Format.Commas(price), math.floor(bonus * 100 + 0.5))
			else ("%s 🪙 each"):format(Format.Commas(price))
		priceLabel.TextColor3 = if bonus then Theme.Colors.Orange else Theme.Colors.Text
		row.BackgroundColor3 = if bonus then Color3.fromRGB(255, 238, 200) else Theme.Colors.PanelAlt
	end
	for index = #owned + 1, #sellRows do
		sellRows[index].Visible = false
	end
	refs.SellEmpty.Visible = #owned == 0
end

---------------------------------------------------------------------------
-- BUY page
---------------------------------------------------------------------------

local function buyCard(index: number): Frame
	local card = buyCards[index]
	if card then
		return card
	end
	card = Create("Frame", { Name = "Card", BackgroundColor3 = Theme.Colors.PanelAlt, Parent = refs.BuyList })
	Components.Corner(card, Theme.SmallCorner)
	Components.Stroke(card, Theme.Colors.Outline, 2)
	Components.Label({ Name = "Icon", Size = UDim2.fromOffset(52, 52), Position = UDim2.fromOffset(6, 6), TextSize = 38, Text = "", Parent = card })
	Components.Label({ Name = "Title", Size = UDim2.new(1, -66, 0, 24), Position = UDim2.fromOffset(60, 8), TextXAlignment = Enum.TextXAlignment.Left, TextSize = Theme.TextSize.Medium, TextScaled = true, Text = "", Parent = card })
	Components.Label({ Name = "Price", Size = UDim2.new(1, -66, 0, 22), Position = UDim2.fromOffset(60, 32), TextXAlignment = Enum.TextXAlignment.Left, Font = Theme.Fonts.Bold, TextSize = Theme.TextSize.Small, Text = "", Parent = card })
	Components.Label({
		Name = "Description",
		Size = UDim2.new(1, -14, 0, 48),
		Position = UDim2.fromOffset(7, 60),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Theme.Fonts.Body,
		TextSize = 12,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "",
		Parent = card,
	})
	local function buy(quantity: number)
		local shopId = card:GetAttribute("ShopId")
		if type(shopId) == "string" and card:GetAttribute("CanBuy") == true then
			Net.FireServer("PurchaseRequest", shopId, quantity)
		elseif card:GetAttribute("Reason") then
			UIController.Notify("Error", tostring(card:GetAttribute("Reason")))
		end
	end
	plainButton({
		Name = "Buy",
		Text = "BUY",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, -14, 0, 36),
		Position = UDim2.new(0, 7, 1, -8),
		AnchorPoint = Vector2.new(0, 1),
		TextSize = Theme.TextSize.Small,
		Parent = card,
		OnClick = function()
			buy(1)
		end,
	})
	plainButton({
		Name = "BuyBulk",
		Text = "x5",
		Color = Theme.Colors.Blue,
		Size = UDim2.new(0.35, -8, 0, 36),
		Position = UDim2.new(1, -7, 1, -8),
		AnchorPoint = Vector2.new(1, 1),
		TextSize = Theme.TextSize.Small,
		Parent = card,
		OnClick = function()
			local bulk = card:GetAttribute("Bulk")
			if type(bulk) == "number" then
				buy(bulk)
			end
		end,
	})
	buyCards[index] = card
	return card
end

local function costText(def: any, quantity: number, coins: number, items: { [string]: number }): (string, boolean)
	local canAfford = coins >= def.Price * quantity
	local parts = { Format.Commas(def.Price * quantity) .. " 🪙" }
	for itemId, amount in def.Items or {} do
		local item = ItemConfig.Get(itemId)
		local need = amount * quantity
		canAfford = canAfford and (items[itemId] or 0) >= need
		table.insert(parts, ("%d %s"):format(need, if item then item.Icon else itemId))
	end
	return table.concat(parts, " + "), canAfford
end

local function renderBuy()
	for id, button in refs.CategoryButtons do
		button.BackgroundColor3 = if id == buyCategory then Theme.Colors.Coins else Theme.Colors.PanelAlt
	end
	local coins = ClientState.Get("Coins") or 0
	local items = ClientState.Get("Inventory", "Items") or {}
	local ownedTools = ClientState.Get("Tools", "Owned") or {}
	local upgrades = ClientState.Get("Island", "Upgrades") or {}
	local level = ClientState.Get("Island", "Level") or 1

	local defs = {}
	for _, def in ShopConfig.Items do
		if def.Category == buyCategory then
			table.insert(defs, def)
		end
	end
	table.sort(defs, function(a, b)
		return a.Order < b.Order
	end)

	for index, def in defs do
		local card = buyCard(index)
		card.Visible = true
		card.LayoutOrder = index
		card:SetAttribute("ShopId", def.Id)
		card:SetAttribute("Bulk", def.Bulk)
		local price, canAfford = costText(def, 1, coins, items)
		local reason: string? = nil
		local status: string? = nil
		if level < (def.UnlockLevel or 1) then
			reason = ("Unlocks at Island Level %d."):format(def.UnlockLevel)
			status = ("🔒 Level %d"):format(def.UnlockLevel)
		elseif def.Grant.Tool and ownedTools[def.Grant.Tool] then
			reason = "You already own that."
			status = "✔ OWNED"
		elseif def.Grant.Upgrade and def.MaxOwned and (upgrades[def.Grant.Upgrade] or 0) >= def.MaxOwned then
			reason = "Fully upgraded."
			status = "✔ MAX"
		elseif not canAfford then
			reason = "You can't afford that yet."
		end
		card:SetAttribute("CanBuy", reason == nil)
		card:SetAttribute("Reason", reason)

		;(card:FindFirstChild("Icon") :: TextLabel).Text = def.Icon
		;(card:FindFirstChild("Title") :: TextLabel).Text = def.DisplayName
		local priceLabel = card:FindFirstChild("Price") :: TextLabel
		priceLabel.Text = if def.Grant.Upgrade and def.MaxOwned
			then ("%s  ·  %d/%d"):format(price, upgrades[def.Grant.Upgrade] or 0, def.MaxOwned)
			else price
		priceLabel.TextColor3 = if canAfford then Theme.Colors.Green else Theme.Colors.Red
		;(card:FindFirstChild("Description") :: TextLabel).Text = def.Description or ""

		local buyButton = card:FindFirstChild("Buy") :: TextButton
		local bulkButton = card:FindFirstChild("BuyBulk") :: TextButton
		local hasBulk = type(def.Bulk) == "number"
		buyButton.Size = if hasBulk then UDim2.new(0.65, -10, 0, 36) else UDim2.new(1, -14, 0, 36)
		buyButton.Text = status or "BUY"
		setButtonEnabled(buyButton, reason == nil, Theme.Colors.Green)
		bulkButton.Visible = hasBulk and status == nil
		if hasBulk then
			local _, bulkAffordable = costText(def, def.Bulk, coins, items)
			bulkButton.Text = "x" .. def.Bulk
			setButtonEnabled(bulkButton, bulkAffordable and status == nil, Theme.Colors.Blue)
		end
		card.BackgroundColor3 = if status then Theme.Colors.PanelDark else Theme.Colors.PanelAlt
	end
	for index = #defs + 1, #buyCards do
		buyCards[index].Visible = false
	end
end

---------------------------------------------------------------------------
-- Window
---------------------------------------------------------------------------

local function render()
	if not open then
		return
	end
	refs.SellPage.Visible = tab == "Sell"
	refs.BuyPage.Visible = tab == "Buy"
	refs.SellTab.BackgroundColor3 = if tab == "Sell" then Theme.Colors.Green else Theme.Colors.PanelDark
	refs.BuyTab.BackgroundColor3 = if tab == "Buy" then Theme.Colors.Blue else Theme.Colors.PanelDark
	if tab == "Sell" then
		renderSell()
	else
		renderBuy()
	end
end

local function setTab(newTab: string)
	tab = newTab
	render()
end

function ShopController.IsOpen(): boolean
	return open
end

function ShopController.Close()
	if not open then
		return
	end
	open = false
	refs.Panel.Visible = false
	UIController.SetModalOpen("Market", false)
	for _, release in releases do
		release()
	end
	table.clear(releases)
end

function ShopController.Open(newTab: string?)
	if newTab == "Sell" or newTab == "Buy" then
		tab = newTab
	end
	if open then
		render()
		return
	end
	if UIController.IsAnyModalOpen() then
		return
	end
	open = true
	refs.Panel.Visible = true
	Components.Bounce(refs.Panel, 0.05)
	UIController.SetModalOpen("Market", true)
	table.insert(releases, InputController.Block("UseTool"))
	table.insert(releases, InteractionController.PausePrompts())
	render()
end

local function buildUI()
	local panel, content = Components.Panel({
		Title = "🛒 ISLAND MARKET",
		Size = UDim2.fromOffset(780, 520),
		Parent = UIController.GetModalLayer(),
		OnClose = ShopController.Close,
	})
	panel.Name = "Market"
	panel.Visible = false

	local sellTab = plainButton({ Name = "SellTab", Text = "💰 SELL", Color = Theme.Colors.Green, Size = UDim2.fromOffset(150, 42), Parent = content, OnClick = function()
		setTab("Sell")
	end })
	local buyTab = plainButton({ Name = "BuyTab", Text = "🛍️ BUY", Color = Theme.Colors.Blue, Size = UDim2.fromOffset(150, 42), Position = UDim2.fromOffset(160, 0), Parent = content, OnClick = function()
		setTab("Buy")
	end })

	-- SELL page ---------------------------------------------------------------
	local sellPage = Create("Frame", { Name = "SellPage", Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1, Parent = content })
	local demand = Components.Label({
		Name = "Demand",
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(255, 232, 180),
		Font = Theme.Fonts.Bold,
		TextSize = 14,
		TextColor3 = Theme.Colors.Text,
		TextScaled = true,
		Text = "",
		Parent = sellPage,
	})
	Components.Corner(demand, Theme.SmallCorner)
	Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4), Parent = demand })
	local sellAll = plainButton({
		Name = "SellEverything",
		Text = "💰 SELL ALL PRODUCE",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromOffset(0, 38),
		TextSize = Theme.TextSize.Medium,
		Parent = sellPage,
		OnClick = function()
			Net.FireServer("SellItemRequest", SELL_ALL, 1)
		end,
	})
	local sellList = Create("ScrollingFrame", {
		Name = "Items",
		Size = UDim2.new(1, 0, 1, -98),
		Position = UDim2.fromOffset(0, 98),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = sellPage,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local sellEmpty = Components.Label({
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 120),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "Nothing to sell yet — harvest crops, catch fish or collect milk & eggs!",
		Visible = false,
		Parent = sellPage,
	})

	-- BUY page ----------------------------------------------------------------
	local buyPage = Create("Frame", { Name = "BuyPage", Size = UDim2.new(1, 0, 1, -52), Position = UDim2.fromOffset(0, 52), BackgroundTransparency = 1, Visible = false, Parent = content })
	local categoryRow = Create("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Parent = buyPage }, {
		Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local categoryButtons = {}
	for index, category in ShopConfig.Categories do
		local button = plainButton({
			Name = category.Id,
			Text = category.Icon .. " " .. category.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.fromOffset(140, 36),
			TextSize = Theme.TextSize.Small,
			Parent = categoryRow,
			OnClick = function()
				buyCategory = category.Id
				renderBuy()
			end,
		})
		button.LayoutOrder = index
		categoryButtons[category.Id] = button
	end
	local buyList = Create("ScrollingFrame", {
		Name = "Items",
		Size = UDim2.new(1, 0, 1, -46),
		Position = UDim2.fromOffset(0, 46),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = buyPage,
	}, {
		Create("UIGridLayout", { CellSize = UDim2.fromOffset(236, 158), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		Create("UIPadding", { PaddingTop = UDim.new(0, 4), PaddingLeft = UDim.new(0, 4) }),
	})

	refs = {
		Panel = panel,
		SellTab = sellTab,
		BuyTab = buyTab,
		SellPage = sellPage,
		BuyPage = buyPage,
		Demand = demand,
		SellAll = sellAll,
		SellList = sellList,
		SellEmpty = sellEmpty,
		CategoryButtons = categoryButtons,
		BuyList = buyList,
	}
end

local function marketStallPosition(): Vector3?
	local islands = workspace:FindFirstChild("Islands")
	local island = islands and islands:FindFirstChild("Island_" .. player.UserId)
	local stall = island and island:FindFirstChild("MarketStall", true)
	return if stall and stall:IsA("Model") then stall:GetPivot().Position else nil
end

function ShopController.Init()
	buildUI()
end

function ShopController.Start()
	Net.OnClientEvent("OpenUI", function(payload: any)
		if type(payload) == "table" and payload.Screen == "Market" then
			ShopController.Open(payload.Tab)
		end
	end)
	InputController.On("Cancel", ShopController.Close)
	for _, key in { "Coins", "Inventory", "Tools", "Island" } do
		ClientState.Observe(key, render)
	end
	ReplicatedStorage:GetAttributeChangedSignal("MarketDemand"):Connect(render)

	-- Close when the player walks away; keep the demand timer ticking.
	task.spawn(function()
		while true do
			task.wait(1)
			if open then
				local root = R15.GetRootPart(player.Character)
				local stall = marketStallPosition()
				if root and stall and (root.Position - stall).Magnitude > WALK_AWAY_DISTANCE then
					ShopController.Close()
				elseif tab == "Sell" then
					refs.Demand.Text = demandText(demandTable())
				end
			end
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  ToolController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/ToolController
	DEPENDENCIES: Shared.Net, Shared.Config.ToolConfig, Client.ClientState, InputController,
	              AnimationController, UIController, Client.UI.{Hotbar, Components, Theme}

	Client side of the tool framework:
	  * renders the hotbar from replicated Tools state,
	  * number keys / taps / gamepad bumpers REQUEST equips (server decides),
	  * reacts to the character's EquippedTool attribute (set by the server)
	    by playing the tool's hold animation,
	  * UseTool plays the tool's Use animation; the FIRST gameplay marker of
	    that animation fires ToolController.ToolImpact — Phase 2's gathering
	    hooks in there (spec §173: interaction + animation + marker together),
	  * shows a big USE button on touch devices while a tool is equipped.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ToolConfig = require(Shared.Config.ToolConfig)
local AnimationConfig = require(Shared.Config.AnimationConfig)
local Signal = require(Shared.Util.Signal)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local InputController = require(script.Parent.InputController)
local AnimationController = require(script.Parent.AnimationController)
local UIController = require(script.Parent.UIController)
local Hotbar = require(Client.UI.Hotbar)
local Components = require(Client.UI.Components)
local Theme = require(Client.UI.Theme)

local EQUIP_DEBOUNCE = 0.15

local ToolController = {}

ToolController.EquippedChanged = Signal.new() -- (toolDef | nil)
ToolController.ToolImpact = Signal.new() -- (toolDef, markerName) the moment a swing connects

local hotbar: any
local useButton: TextButton
local equippedId: string? = nil
local holdAnimation: string? = nil
local lastEquipRequest = 0
local nextUseTime = 0
local characterConnection: RBXScriptConnection? = nil
-- toolType -> handler(def) returning true if it handled USE (e.g. fishing rod casts instead of swinging)
local useOverrides: { [string]: (any) -> boolean } = {}

-- Lets a higher-level controller take over USE for one tool type.
function ToolController.SetUseOverride(toolType: string, handler: (any) -> boolean)
	useOverrides[toolType] = handler
end

function ToolController.GetEquipped(): any
	return equippedId and ToolConfig.Get(equippedId)
end

function ToolController.RequestEquip(toolId: string?)
	local now = os.clock()
	if now - lastEquipRequest < EQUIP_DEBOUNCE then
		return
	end
	lastEquipRequest = now
	Net.FireServer("EquipToolRequest", toolId or "")
end

local function selectSlot(index: number)
	local toolId = hotbar:GetToolAt(index)
	if not toolId then
		return
	end
	ToolController.RequestEquip(if toolId == equippedId then nil else toolId)
end

local function cycle(direction: number)
	local hotbarIds = ClientState.Get("Tools", "Hotbar") or {}
	if #hotbarIds == 0 then
		return
	end
	local currentIndex = if equippedId then table.find(hotbarIds, equippedId) else nil
	local nextIndex = if currentIndex then (currentIndex - 1 + direction) % #hotbarIds + 1 else 1
	ToolController.RequestEquip(hotbarIds[nextIndex])
end

local function onEquippedChanged(toolId: string?)
	if toolId == "" then
		toolId = nil
	end
	equippedId = toolId
	if holdAnimation then
		AnimationController.StopAnimation(holdAnimation, 0.2)
		holdAnimation = nil
	end
	local def = toolId and ToolConfig.Get(toolId)
	if def and def.Animations.Idle then
		holdAnimation = def.Animations.Idle
		AnimationController.PlayAnimation(def.Animations.Idle)
	end
	hotbar:SetEquipped(toolId)
	useButton.Visible = def ~= nil and InputController.IsTouch()
	if def then
		useButton.Text = def.Icon .. "\nUSE"
	end
	ToolController.EquippedChanged:Fire(def)
end

local function useTool()
	if UIController.IsAnyModalOpen() then
		return
	end
	local def = ToolController.GetEquipped()
	if not def then
		return
	end
	local override = useOverrides[def.Type]
	if override and override(def) then
		return
	end
	local now = os.clock()
	if now < nextUseTime then
		return
	end
	nextUseTime = now + def.UseCooldown

	local animationName = def.Animations.Use
	local animationDef = animationName and AnimationConfig.Get(animationName)
	if not animationDef then
		return
	end
	local handle = AnimationController.PlayAnimation(animationName, { Speed = def.Speed })
	if not handle then
		return
	end
	-- The first configured marker is the gameplay moment (Hit / Dig / Till / HammerHit...).
	local impactFired = false
	for markerName in animationDef.Markers do
		handle:OnMarker(markerName, function()
			if not impactFired then
				impactFired = true
				ToolController.ToolImpact:Fire(def, markerName)
			end
		end)
	end
end

local function watchCharacter(character: Model)
	if characterConnection then
		characterConnection:Disconnect()
	end
	characterConnection = character:GetAttributeChangedSignal("EquippedTool"):Connect(function()
		onEquippedChanged(character:GetAttribute("EquippedTool") :: string?)
	end)
	-- Wait for the AnimationPlayer so the hold pose can play.
	task.defer(function()
		onEquippedChanged(character:GetAttribute("EquippedTool") :: string?)
	end)
end

function ToolController.Init()
	hotbar = Hotbar.new(UIController.GetSlot("Bottom"), selectSlot)
	useButton = Components.Button({
		Name = "UseButton",
		Text = "USE",
		Color = Theme.Colors.Orange,
		Size = UDim2.fromOffset(110, 110),
		TextSize = Theme.TextSize.Large,
		Parent = UIController.GetSlot("Touch"),
		OnClick = function()
			InputController.Trigger("UseTool")
		end,
	})
	Components.Corner(useButton, UDim.new(1, 0))
	useButton.Visible = false
	-- Hold support (the fishing reel is "hold to pull").
	useButton.MouseButton1Down:Connect(function()
		InputController.SetHeld("UseTool", true)
	end)
	useButton.MouseButton1Up:Connect(function()
		if InputController.IsHeld("UseTool") then
			InputController.SetHeld("UseTool", false)
		end
	end)
	useButton.MouseLeave:Connect(function()
		if InputController.IsHeld("UseTool") then
			InputController.SetHeld("UseTool", false)
		end
	end)
end

function ToolController.Start()
	ClientState.Observe("Tools", function(tools)
		if type(tools) == "table" then
			hotbar:SetTools(tools.Hotbar or {})
			hotbar:SetEquipped(equippedId)
		end
	end)

	for index = 1, ToolConfig.HotbarSize do
		InputController.On("Hotbar" .. index, function()
			selectSlot(index)
		end)
	end
	InputController.On("HotbarNext", function()
		cycle(1)
	end)
	InputController.On("HotbarPrevious", function()
		cycle(-1)
	end)
	InputController.On("UseTool", useTool)
	InputController.DeviceChanged:Connect(function()
		useButton.Visible = equippedId ~= nil and InputController.IsTouch()
	end)

	AnimationController.CharacterReady:Connect(watchCharacter)
	local character = Players.LocalPlayer.Character
	if character then
		watchCharacter(character)
	end
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  UIController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/UIController
	DEPENDENCIES: Client.ClientState, AudioController, CameraController, Client.UI.{HUD, Notifications, Components, Theme},
	              Shared.Net, Shared.Config.ProgressionConfig, Shared.Config.ItemConfig, Shared.Util.Format

	Owns the ScreenGui, UI scaling, the HUD layout, notifications and modal
	windows. Every UI in the game is created through here once and updated in
	place when replicated state changes (spec §82, §116).

	Automatic reward feedback (spec §68): whenever the replicated Coins value
	rises, the counter animates, bounces and a "+N 🪙" floats up with a coin
	sound; whenever an item count rises, "+N Wood" floats above the hotbar.
	No system has to remember to send its own popup.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local ProgressionConfig = require(Shared.Config.ProgressionConfig)
local ItemConfig = require(Shared.Config.ItemConfig)
local Format = require(Shared.Util.Format)

local Client = script.Parent.Parent
local ClientState = require(Client.ClientState)
local AudioController = require(script.Parent.AudioController)
local CameraController = require(script.Parent.CameraController)
local Theme = require(Client.UI.Theme)
local Components = require(Client.UI.Components)
local HUD = require(Client.UI.HUD)
local Notifications = require(Client.UI.Notifications)

local UIController = {}

local screen: ScreenGui
local uiScale: UIScale
local hud: HUD.HUDRefs
local notifications: any
local modalLayer: Frame
local openModals: { [string]: boolean } = {}
local lastItems: { [string]: number }? = nil

local function updateScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.min(viewport.X / Theme.DesignSize.X, viewport.Y / Theme.DesignSize.Y)
	uiScale.Scale = math.clamp(scale, 0.55, 1.35)
end

local function animateCounter(label: TextLabel, from: number, to: number)
	local value = Instance.new("NumberValue")
	value.Value = from
	value.Changed:Connect(function(current)
		label.Text = Format.Abbreviate(math.floor(current + 0.5))
	end)
	local tween = TweenService:Create(value, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Value = to })
	tween.Completed:Once(function()
		label.Text = Format.Abbreviate(to)
		value:Destroy()
	end)
	tween:Play()
end

local function pillFloatPosition(pill: Frame): UDim2
	-- Floats appear just under a top-bar pill (positions are in design space).
	local absolute = pill.AbsolutePosition + pill.AbsoluteSize / 2
	local scale = uiScale.Scale
	local screenOffset = screen.AbsolutePosition
	return UDim2.fromOffset((absolute.X - screenOffset.X) / scale, (absolute.Y - screenOffset.Y) / scale + 50)
end

local function watchCurrency(key: string, label: TextLabel, pill: Frame, color: Color3, icon: string)
	local last: number? = nil
	ClientState.Observe(key, function(value)
		if type(value) ~= "number" then
			return
		end
		if last == nil then
			label.Text = Format.Abbreviate(value)
		elseif value ~= last then
			animateCounter(label, last, value)
			local delta = value - last
			Components.Bounce(pill, 0.12)
			if delta > 0 then
				notifications:Float(("+%s %s"):format(Format.Abbreviate(delta), icon), color, pillFloatPosition(pill))
				AudioController.Play("CoinGain")
			else
				notifications:Float(("-%s %s"):format(Format.Abbreviate(-delta), icon), Theme.Colors.Red, pillFloatPosition(pill))
				AudioController.Play("CoinSpend")
			end
		end
		last = value
	end)
end

local function refreshIslandPill()
	local level = ClientState.Get("Island", "Level") or 1
	local xp = ClientState.Get("Island", "XP") or 0
	hud.IslandLabel.Text = "Island Lv " .. tostring(level)
	hud.IslandXP.SetProgress(xp / ProgressionConfig.IslandXPForLevel(level), true)
end

local function watchItems()
	ClientState.Observe("Inventory", function(inventory)
		if type(inventory) ~= "table" or type(inventory.Items) ~= "table" then
			return
		end
		local items = inventory.Items
		if lastItems then
			local offset = 0
			for itemId, count in items do
				local previous = lastItems[itemId] or 0
				if count > previous then
					local def = ItemConfig.Get(itemId)
					if def then
						notifications:Float(
							("+%d %s %s"):format(count - previous, def.Icon, def.DisplayName),
							Theme.Colors.TextLight,
							UDim2.new(0.5, 0, 1, -150 - offset),
							50
						)
						offset += 34
					end
				end
			end
			if offset > 0 then
				AudioController.Play("ItemGain")
			end
		end
		lastItems = table.clone(items)
	end)
end

-- Public API ---------------------------------------------------------------

function UIController.GetScreen(): ScreenGui
	return screen
end

function UIController.GetSlot(name: string): Frame
	local slot = hud.Slots[name]
	assert(slot, "Unknown HUD slot " .. name)
	return slot
end

function UIController.GetModalLayer(): Frame
	return modalLayer
end

function UIController.Notify(kind: string, text: string, icon: string?)
	notifications:Toast(kind, text, icon)
	AudioController.Play(if kind == "Error" then "UIError" else "UINotify")
end

function UIController.Banner(title: string, subtitle: string?, style: string?)
	notifications:Banner(title, subtitle, style)
	CameraController.Punch(3)
end

function UIController.Float(text: string, color: Color3, position: UDim2)
	notifications:Float(text, color, position)
end

-- Modal bookkeeping so gameplay can ask "is a menu open?"
function UIController.SetModalOpen(name: string, open: boolean)
	if open then
		openModals[name] = true
	else
		openModals[name] = nil
	end
	AudioController.Play(if open then "UIOpen" else "UIClose")
end

function UIController.IsAnyModalOpen(): boolean
	return next(openModals) ~= nil
end

function UIController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	screen = Components.Create("ScreenGui", {
		Name = "IslandUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = playerGui,
	})
	-- Everything is authored at Theme.DesignSize and scaled to the device.
	local designRoot = Components.Create("Frame", {
		Name = "DesignRoot",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	uiScale = Components.Create("UIScale", { Parent = designRoot })
	updateScale()
	-- With UIScale the root must be sized in design units.
	local function resizeRoot()
		updateScale()
		designRoot.Size = UDim2.fromOffset(screen.AbsoluteSize.X / uiScale.Scale, screen.AbsoluteSize.Y / uiScale.Scale)
	end
	screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(resizeRoot)
	resizeRoot()

	hud = HUD.Create(designRoot)
	modalLayer = Components.Create("Frame", {
		Name = "Modals",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = designRoot,
	})
	local overlay = Components.Create("Frame", {
		Name = "Overlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = designRoot,
	})
	notifications = Notifications.new(overlay)
	Components.SetClickSound(function()
		AudioController.Play("UIClick")
	end)
end

-- If the server failed to boot, say so on screen instead of showing an empty world.
local function watchServerHealth()
	local shown = ""
	local function showBootErrors()
		local errors = ReplicatedStorage:GetAttribute("ServerBootErrors")
		if type(errors) == "string" and errors ~= "" and errors ~= shown then
			shown = errors
			local firstLine = string.split(errors, "\n")[1]
			UIController.Notify("Error", "Server error: " .. string.sub(firstLine, 1, 120))
			UIController.Banner("SERVER ERROR", "Open View → Output in Studio and send the red text", "Error")
		end
	end
	showBootErrors()
	ReplicatedStorage:GetAttributeChangedSignal("ServerBootErrors"):Connect(showBootErrors)

	task.delay(20, function()
		if not ClientState.IsReady() then
			UIController.Notify("Error", "Still waiting for the server to load your island…")
			UIController.Banner("LOADING TROUBLE", "Open View → Output in Studio and check for red errors", "Error")
		end
	end)
end

function UIController.Start()
	watchServerHealth()
	watchCurrency("Coins", hud.CoinsLabel, hud.CoinsPill, Theme.Colors.Coins, "🪙")
	watchCurrency("Gems", hud.GemsLabel, hud.GemsPill, Theme.Colors.Gems, "💎")
	ClientState.Observe("Island", refreshIslandPill)
	watchItems()

	Net.OnClientEvent("Notify", function(payload: any)
		if type(payload) ~= "table" or type(payload.Text) ~= "string" then
			return
		end
		if payload.Kind == "Banner" then
			UIController.Banner(payload.Text, payload.Subtitle, payload.Style)
		else
			UIController.Notify(payload.Kind or "Toast", payload.Text, payload.Icon)
		end
	end)
end

return UIController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  VFXController
	SCRIPT TYPE:  ModuleScript (client controller)
	WHERE:        StarterPlayerScripts/Client/Controllers/VFXController
	DEPENDENCIES: Shared.Net, Shared.Config.VFXConfig

	Renders VFXConfig effects locally with pooled emitters/parts (spec §79):
	no Instances are created per effect after warm-up, effects far from the
	camera are skipped, and everything uses the engine's default particle
	texture so it works without uploaded art.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared:WaitForChild("Net"))
local VFXConfig = require(Shared.Config.VFXConfig)

local BURST_POOL = 10
local RING_POOL = 6

type BurstEmitter = { Part: Part, Emitter: ParticleEmitter, BusyUntil: number }
type Ring = { Part: Part, BusyUntil: number }

local VFXController = {}

local bursts: { BurstEmitter } = {}
local rings: { Ring } = {}
local folder: Folder

local function newAnchorPart(name: string): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Parent = folder
	return part
end

local function acquire(pool: { any }): any
	local now = os.clock()
	local oldest = nil
	for _, item in pool do
		if item.BusyUntil <= now then
			return item
		end
		if not oldest or item.BusyUntil < oldest.BusyUntil then
			oldest = item
		end
	end
	return oldest -- steal the oldest rather than allocate
end

local function isVisible(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	return camera ~= nil and (camera.CFrame.Position - position).Magnitude <= VFXConfig.MaxDistance
end

local function playBurst(def: any, position: Vector3)
	local item = acquire(bursts)
	if not item then
		return
	end
	local emitter = item.Emitter
	item.Part.CFrame = CFrame.new(position)
	emitter.Color = ColorSequence.new(def.Color)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, def.Size),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.7, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(def.Lifetime * 0.7, def.Lifetime)
	emitter.Speed = NumberRange.new(def.Speed * 0.6, def.Speed)
	emitter.SpreadAngle = Vector2.new(def.Spread, def.Spread)
	emitter.Acceleration = def.Acceleration or Vector3.zero
	emitter.LightEmission = def.LightEmission or 0
	emitter:Emit(def.Count)
	item.BusyUntil = os.clock() + def.Lifetime + 0.1
end

local function playRing(def: any, position: Vector3)
	local item = acquire(rings)
	if not item then
		return
	end
	local part = item.Part
	part.Color = def.Color
	part.Transparency = 0.2
	part.Size = Vector3.new(def.Height, def.StartSize, def.StartSize)
	part.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90))
	TweenService:Create(part, TweenInfo.new(def.Duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(def.Height * 0.3, def.EndSize, def.EndSize),
		Transparency = 1,
	}):Play()
	item.BusyUntil = os.clock() + def.Duration
end

function VFXController.Play(effectName: string, position: Vector3)
	local def = VFXConfig.Effects[effectName]
	if not def then
		warn("[VFX] Unknown effect '" .. tostring(effectName) .. "'")
		return
	end
	if not isVisible(position) then
		return
	end
	if def.Type == "Burst" then
		playBurst(def, position)
	elseif def.Type == "Ring" then
		playRing(def, position)
	end
end

function VFXController.Init()
	folder = Instance.new("Folder")
	folder.Name = "ClientEffects"
	folder.Parent = workspace

	for _ = 1, BURST_POOL do
		local part = newAnchorPart("BurstAnchor")
		local emitter = Instance.new("ParticleEmitter")
		emitter.Enabled = false
		emitter.Rate = 0
		emitter.Drag = 2
		emitter.RotSpeed = NumberRange.new(-90, 90)
		emitter.Parent = part
		table.insert(bursts, { Part = part, Emitter = emitter, BusyUntil = 0 })
	end
	for _ = 1, RING_POOL do
		local part = newAnchorPart("Ring")
		part.Shape = Enum.PartType.Cylinder
		part.Material = Enum.Material.Neon
		part.Transparency = 1
		table.insert(rings, { Part = part, BusyUntil = 0 })
	end
end

function VFXController.Start()
	Net.OnClientEvent("PlayVFX", function(effectName: string, position: Vector3)
		if typeof(position) == "Vector3" then
			VFXController.Play(effectName, position)
		end
	end)
end

return VFXController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="118">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Main
	SCRIPT TYPE:  LocalScript (client entry point)
	WHERE:        StarterPlayer/StarterPlayerScripts/Client/Main
	DEPENDENCIES: every ModuleScript in Client/Controllers, Client/ClientState

	Boots the client: waits for the game to load, hides the default Roblox
	backpack (we use our own hotbar), then Init()s and Start()s controllers in
	dependency order. No gameplay logic lives here.

	CONTROLLER LAYERS (a controller may only require ones ABOVE it):
		ClientState, InputController, AudioController, VFXController, CameraController
		AnimationController
		UIController
		InteractionController, ToolController
		InventoryController, IslandController, QuestController
		GatherController, BuildController, FarmController, FishingController,
		AnimalController, ShopController
]]

local StarterGui = game:GetService("StarterGui")

if not game:IsLoaded() then
	game.Loaded:Wait()
end

-- The custom hotbar replaces Roblox's Backpack UI.
task.spawn(function()
	for _ = 1, 10 do
		local ok = pcall(StarterGui.SetCoreGuiEnabled, StarterGui, Enum.CoreGuiType.Backpack, false)
		if ok then
			break
		end
		task.wait(0.5)
	end
end)

local Client = script.Parent
local Controllers = Client.Controllers

local ORDER: { ModuleScript } = {
	Client.ClientState,
	Controllers.InputController,
	Controllers.AudioController,
	Controllers.VFXController,
	Controllers.CameraController,
	Controllers.AnimationController,
	Controllers.UIController,
	Controllers.InteractionController,
	Controllers.ToolController,
	Controllers.InventoryController,
	Controllers.IslandController,
	Controllers.QuestController,
	Controllers.GatherController,
	Controllers.BuildController,
	Controllers.FarmController,
	Controllers.FishingController,
	Controllers.AnimalController,
	Controllers.ShopController,
}

-- One broken controller must not take the whole client down with it:
-- each step is protected and reported in the Output window.
local function run(label: string, callback: () -> ()): boolean
	local ok, message = xpcall(callback, debug.traceback)
	if not ok then
		warn(("[Client] %s failed:\n%s"):format(label, tostring(message)))
	end
	return ok
end

local loaded: { { Name: string, Controller: any } } = {}
for _, module in ORDER do
	run("require " .. module.Name, function()
		table.insert(loaded, { Name = module.Name, Controller = require(module) :: any })
	end)
end

for _, entry in loaded do
	if type(entry.Controller.Init) == "function" then
		run(entry.Name .. ".Init", entry.Controller.Init)
	end
end

for _, entry in loaded do
	if type(entry.Controller.Start) == "function" then
		run(entry.Name .. ".Start", entry.Controller.Start)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="119">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Components
	SCRIPT TYPE:  ModuleScript (client UI kit)
	WHERE:        StarterPlayerScripts/Client/UI/Components
	DEPENDENCIES: Client.UI.Theme

	Tiny UI kit so every screen looks consistent and nothing is rebuilt from
	scratch: Create(), rounded panels, chunky buttons with press bounce,
	currency pills, progress bars. Frames are created once and updated in
	place (spec §116).
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)

local Components = {}

local clickSound: (() -> ())? = nil

function Components.SetClickSound(callback: () -> ())
	clickSound = callback
end

-- Create("Frame", { Size = ..., Parent = ... }, { children })
function Components.Create(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local Create = Components.Create

function Components.Corner(parent: Instance, radius: UDim?): UICorner
	return Create("UICorner", { CornerRadius = radius or Theme.Corner, Parent = parent })
end

function Components.Stroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return Create("UIStroke", {
		Color = color or Theme.Colors.Outline,
		Thickness = thickness or Theme.StrokeThickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Components.TextStroke(parent: Instance, color: Color3?, thickness: number?): UIStroke
	return Create("UIStroke", {
		Color = color or Theme.Colors.Outline,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Parent = parent,
	})
end

function Components.Padding(parent: Instance, pixels: number)
	return Create("UIPadding", {
		PaddingTop = UDim.new(0, pixels),
		PaddingBottom = UDim.new(0, pixels),
		PaddingLeft = UDim.new(0, pixels),
		PaddingRight = UDim.new(0, pixels),
		Parent = parent,
	})
end

function Components.Label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.Fonts.Title,
		TextColor3 = Theme.Colors.Text,
		TextSize = Theme.TextSize.Medium,
		TextWrapped = true,
	}
	for key, value in props do
		defaults[key] = value
	end
	return Create("TextLabel", defaults)
end

-- Quick "pop" on any GuiObject (uses/creates a UIScale child).
function Components.Bounce(guiObject: GuiObject, amount: number?)
	local scale = guiObject:FindFirstChild("BounceScale")
	if not scale then
		scale = Create("UIScale", { Name = "BounceScale", Parent = guiObject })
	end
	scale.Scale = 1 + (amount or 0.15)
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

export type ButtonProps = {
	Text: string,
	Color: Color3?,
	TextColor: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	TextSize: number?,
	Parent: Instance?,
	Name: string?,
	OnClick: (() -> ())?,
}

function Components.Button(props: ButtonProps): TextButton
	local color = props.Color or Theme.Colors.Green
	local button = Create("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 48),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = props.Text,
		Font = Theme.Fonts.Title,
		TextSize = props.TextSize or Theme.TextSize.Medium,
		TextColor3 = props.TextColor or Theme.Colors.TextLight,
		Parent = props.Parent,
	})
	Components.Corner(button, Theme.SmallCorner)
	Components.Stroke(button)
	Components.TextStroke(button, Theme.Colors.Outline, 1.5)

	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = color:Lerp(Color3.new(1, 1, 1), 0.15)
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = color
	end)
	button.Activated:Connect(function()
		Components.Bounce(button, 0.08)
		if clickSound then
			clickSound()
		end
		if props.OnClick then
			props.OnClick()
		end
	end)
	return button
end

-- Top-bar style pill: [icon] value. Returns (frame, valueLabel).
function Components.Pill(props: { Icon: string, Color: Color3, Width: number?, Parent: Instance?, LayoutOrder: number? }): (Frame, TextLabel)
	local frame = Create("Frame", {
		Size = UDim2.fromOffset(props.Width or 150, 44),
		BackgroundColor3 = Theme.Colors.Panel,
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	Components.Corner(frame, UDim.new(1, 0))
	Components.Stroke(frame)

	local iconBubble = Create("Frame", {
		Size = UDim2.fromOffset(52, 52),
		Position = UDim2.new(0, -10, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = props.Color,
		Parent = frame,
	})
	Components.Corner(iconBubble, UDim.new(1, 0))
	Components.Stroke(iconBubble)
	Components.Label({
		Text = props.Icon,
		Size = UDim2.fromScale(1, 1),
		TextSize = 28,
		Parent = iconBubble,
	})

	local value = Components.Label({
		Name = "Value",
		Text = "0",
		Size = UDim2.new(1, -52, 1, 0),
		Position = UDim2.fromOffset(46, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = Theme.TextSize.Large,
		TextWrapped = false,
		Parent = frame,
	})
	return frame, value
end

export type ProgressBar = { Frame: Frame, Fill: Frame, SetProgress: (alpha: number, animate: boolean?) -> () }

function Components.ProgressBar(props: { Size: UDim2, Position: UDim2?, Color: Color3, Parent: Instance? }): ProgressBar
	local frame = Create("Frame", {
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		BackgroundColor3 = Theme.Colors.PanelDark,
		ClipsDescendants = true,
		Parent = props.Parent,
	})
	Components.Corner(frame, UDim.new(1, 0))
	Components.Stroke(frame, Theme.Colors.Outline, 2)
	local fill = Create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = props.Color,
		Parent = frame,
	})
	Components.Corner(fill, UDim.new(1, 0))

	local function setProgress(alpha: number, animate: boolean?)
		local target = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
		if animate then
			TweenService:Create(fill, TweenInfo.new(0.4, Enum.EasingStyle.Quad), { Size = target }):Play()
		else
			fill.Size = target
		end
	end
	return { Frame = frame, Fill = fill, SetProgress = setProgress }
end

-- Rounded cream panel with a title and close button. Returns (panel, content, closeButton).
function Components.Panel(props: { Title: string, Size: UDim2, Parent: Instance?, OnClose: (() -> ())? }): (Frame, Frame, TextButton)
	local panel = Create("Frame", {
		Size = props.Size,
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Theme.Colors.Panel,
		Parent = props.Parent,
	})
	Components.Corner(panel)
	Components.Stroke(panel, Theme.Colors.Outline, 4)

	local header = Create("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = Theme.Colors.Blue,
		Parent = panel,
	})
	Components.Corner(header)
	-- Square off the header's bottom corners.
	Create("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.new(0, 0, 1, -16),
		BackgroundColor3 = Theme.Colors.Blue,
		BorderSizePixel = 0,
		Parent = header,
	})
	local title = Components.Label({
		Name = "Title",
		Text = props.Title,
		Size = UDim2.new(1, -140, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextSize = Theme.TextSize.Title,
		TextColor3 = Theme.Colors.TextLight,
		Parent = header,
	})
	Components.TextStroke(title)

	local closeButton = Components.Button({
		Name = "Close",
		Text = "✕",
		Color = Theme.Colors.Red,
		Size = UDim2.fromOffset(44, 44),
		Position = UDim2.new(1, -8, 0, 5),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = Theme.TextSize.Large,
		Parent = header,
		OnClick = props.OnClose,
	})

	local content = Create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, -24, 1, -70),
		Position = UDim2.fromOffset(12, 62),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	return panel, content, closeButton
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  HUD
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/HUD
	DEPENDENCIES: Client.UI.{Theme, Components}

	Builds the main HUD layout once (spec §83):
		Top     island level, coins, gems
		Right   slot for the island/quest panel (IslandController)
		Bottom  slot for the tool hotbar (ToolController)
		Left    slot for menu buttons (InventoryController)
	Controllers fill the slots; UIController updates the values.
]]

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local HUD = {}

export type HUDRefs = {
	Root: Frame,
	TopBar: Frame,
	IslandPill: Frame,
	IslandLabel: TextLabel,
	IslandXP: Components.ProgressBar,
	CoinsPill: Frame,
	CoinsLabel: TextLabel,
	GemsPill: Frame,
	GemsLabel: TextLabel,
	Slots: { [string]: Frame },
}

function HUD.Create(parent: Instance): HUDRefs
	local root = Create("Frame", {
		Name = "HUD",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	local topBar = Create("Frame", {
		Name = "TopBar",
		Size = UDim2.fromOffset(620, 60),
		Position = UDim2.new(0.5, 0, 0, 10),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = root,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 30),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	local islandPill, islandLabel = Components.Pill({ Icon = "🏝️", Color = Theme.Colors.Level, Width = 170, Parent = topBar, LayoutOrder = 1 })
	islandLabel.Size = UDim2.new(1, -56, 0, 28)
	islandLabel.Position = UDim2.fromOffset(46, 2)
	islandLabel.TextSize = Theme.TextSize.Medium
	local islandXP = Components.ProgressBar({
		Size = UDim2.new(1, -60, 0, 8),
		Position = UDim2.fromOffset(46, 30),
		Color = Theme.Colors.Level,
		Parent = islandPill,
	})

	local coinsPill, coinsLabel = Components.Pill({ Icon = "🪙", Color = Theme.Colors.Coins, Width = 170, Parent = topBar, LayoutOrder = 2 })
	local gemsPill, gemsLabel = Components.Pill({ Icon = "💎", Color = Theme.Colors.Gems, Width = 130, Parent = topBar, LayoutOrder = 3 })

	local slots = {
		Right = Create("Frame", {
			Name = "RightSlot",
			Size = UDim2.fromOffset(250, 540),
			Position = UDim2.new(1, -12, 0, 80),
			AnchorPoint = Vector2.new(1, 0),
			BackgroundTransparency = 1,
			Parent = root,
		}, {
			Create("UIListLayout", {
				Padding = UDim.new(0, 10),
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		}),
		Bottom = Create("Frame", {
			Name = "BottomSlot",
			Size = UDim2.fromOffset(720, 96),
			Position = UDim2.new(0.5, 0, 1, -12),
			AnchorPoint = Vector2.new(0.5, 1),
			BackgroundTransparency = 1,
			Parent = root,
		}),
		Left = Create("Frame", {
			Name = "LeftSlot",
			Size = UDim2.fromOffset(90, 300),
			Position = UDim2.new(0, 12, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundTransparency = 1,
			Parent = root,
		}, {
			Create("UIListLayout", {
				Padding = UDim.new(0, 12),
				VerticalAlignment = Enum.VerticalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		}),
		-- Touch-only action buttons (bottom-right, above the jump button).
		Touch = Create("Frame", {
			Name = "TouchSlot",
			Size = UDim2.fromOffset(120, 120),
			Position = UDim2.new(1, -30, 1, -200),
			AnchorPoint = Vector2.new(1, 1),
			BackgroundTransparency = 1,
			Parent = root,
		}),
	}

	return {
		Root = root,
		TopBar = topBar,
		IslandPill = islandPill,
		IslandLabel = islandLabel,
		IslandXP = islandXP,
		CoinsPill = coinsPill,
		CoinsLabel = coinsLabel,
		GemsPill = gemsPill,
		GemsLabel = gemsLabel,
		Slots = slots,
	}
end

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">Hotbar</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Hotbar
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/Hotbar
	DEPENDENCIES: Client.UI.{Theme, Components}, Shared.Config.{ToolConfig, RarityConfig}

	The bottom tool hotbar. Slots are created ONCE and updated in place.
	Big (72px design size) touch-friendly buttons with a key-number badge.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ToolConfig = require(Shared.Config.ToolConfig)

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local SLOT_SIZE = 72

local TIER_COLORS = {
	Wooden = Color3.fromRGB(190, 140, 90),
	Stone = Color3.fromRGB(160, 160, 165),
	Iron = Color3.fromRGB(215, 220, 230),
	Gold = Color3.fromRGB(255, 205, 60),
	Crystal = Color3.fromRGB(120, 225, 255),
	Mythic = Color3.fromRGB(200, 100, 255),
}

type Slot = { Button: TextButton, Icon: TextLabel, Name: TextLabel, Stroke: UIStroke, Strip: Frame, ToolId: string? }

local Hotbar = {}
Hotbar.__index = Hotbar

function Hotbar.new(parent: Instance, onSelect: (index: number) -> ())
	local self = setmetatable({}, Hotbar)
	self.Frame = Create("Frame", {
		Name = "Hotbar",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	self.Slots = {} :: { Slot }

	for index = 1, ToolConfig.HotbarSize do
		local button = Create("TextButton", {
			Name = "Slot" .. index,
			Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
			BackgroundColor3 = Theme.Colors.Panel,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = index,
			Parent = self.Frame,
		})
		Components.Corner(button, Theme.SmallCorner)
		local stroke = Components.Stroke(button)
		local strip = Create("Frame", {
			Name = "TierStrip",
			Size = UDim2.new(1, -12, 0, 5),
			Position = UDim2.new(0.5, 0, 1, -8),
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Theme.Colors.PanelDark,
			BorderSizePixel = 0,
			Parent = button,
		})
		Components.Corner(strip, UDim.new(1, 0))
		local icon = Components.Label({
			Name = "Icon",
			Size = UDim2.new(1, 0, 0, 44),
			Position = UDim2.fromOffset(0, 4),
			TextSize = 34,
			Text = "",
			Parent = button,
		})
		local name = Components.Label({
			Name = "ToolName",
			Size = UDim2.new(1, -6, 0, 14),
			Position = UDim2.new(0, 3, 1, -24),
			TextSize = 12,
			Font = Theme.Fonts.Bold,
			TextColor3 = Theme.Colors.TextMuted,
			TextScaled = true,
			Text = "",
			Parent = button,
		})
		local badge = Components.Label({
			Name = "Key",
			Size = UDim2.fromOffset(20, 20),
			Position = UDim2.fromOffset(4, 2),
			TextSize = 14,
			Text = tostring(index),
			TextColor3 = Theme.Colors.TextMuted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = button,
		})
		badge.ZIndex = 2
		button.Activated:Connect(function()
			onSelect(index)
		end)
		table.insert(self.Slots, { Button = button, Icon = icon, Name = name, Stroke = stroke, Strip = strip, ToolId = nil })
	end
	return self
end

function Hotbar:SetTools(toolIds: { string })
	for index, slot in self.Slots do
		local toolId = toolIds[index]
		local def = toolId and ToolConfig.Get(toolId)
		slot.ToolId = if def then toolId else nil
		slot.Icon.Text = if def then def.Icon else ""
		slot.Name.Text = if def then def.DisplayName else ""
		slot.Strip.BackgroundColor3 = if def then (TIER_COLORS[def.Tier] or Theme.Colors.PanelDark) else Theme.Colors.PanelDark
		slot.Button.BackgroundTransparency = if def then 0 else 0.35
	end
end

function Hotbar:SetEquipped(toolId: string?)
	for _, slot in self.Slots do
		local equipped = toolId ~= nil and slot.ToolId == toolId
		slot.Stroke.Color = if equipped then Theme.Colors.Coins else Theme.Colors.Outline
		slot.Stroke.Thickness = if equipped then 5 else Theme.StrokeThickness
		slot.Button.BackgroundColor3 = if equipped then Color3.fromRGB(255, 240, 190) else Theme.Colors.Panel
		if equipped then
			Components.Bounce(slot.Button, 0.1)
		end
	end
end

function Hotbar:GetToolAt(index: number): string?
	local slot = self.Slots[index]
	return slot and slot.ToolId
end

return Hotbar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">InventoryPanel</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  InventoryPanel
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/InventoryPanel
	DEPENDENCIES: Client.UI.{Theme, Components}, Shared.Config.{ItemConfig, ToolConfig, RarityConfig},
	              Shared.Util.Format

	The backpack window (spec §66/§67): category tabs, search, sort, a pooled
	item grid and a details pane (rarity, value, description; Equip for tools).
	Cards are pooled and reused — the grid never rebuilds from scratch.
	Sell buttons arrive with the market in Phase 7.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ItemConfig = require(Shared.Config.ItemConfig)
local ToolConfig = require(Shared.Config.ToolConfig)
local RarityConfig = require(Shared.Config.RarityConfig)
local Format = require(Shared.Util.Format)

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local SORT_MODES = { "Name", "Amount", "Value" }

type Entry = {
	Id: string,
	Kind: string, -- "Item" | "Tool"
	Name: string,
	Icon: string,
	Rarity: string,
	Category: string,
	Count: number,
	Value: number,
	Description: string,
	ToolDef: any?,
}

type Card = { Button: TextButton, Icon: TextLabel, Name: TextLabel, Count: TextLabel, Stroke: UIStroke }

local InventoryPanel = {}
InventoryPanel.__index = InventoryPanel

export type Callbacks = {
	OnClose: () -> (),
	OnEquip: (toolId: string?) -> (),
}

function InventoryPanel.new(parent: Instance, callbacks: Callbacks)
	local self = setmetatable({}, InventoryPanel)
	self.Callbacks = callbacks
	self.Category = "All"
	self.SortIndex = 1
	self.Search = ""
	self.SelectedId = nil :: string?
	self.Entries = {} :: { Entry }
	self.Cards = {} :: { Card }
	self.State = { Items = {}, Capacity = 0, OwnedTools = {}, Equipped = "" }

	local panel, content = Components.Panel({
		Title = "🎒 BACKPACK",
		Size = UDim2.fromOffset(760, 470),
		Parent = parent,
		OnClose = callbacks.OnClose,
	})
	panel.Visible = false
	self.Panel = panel

	self.CapacityLabel = Components.Label({
		Size = UDim2.fromOffset(160, 54),
		Position = UDim2.new(1, -70, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.TextLight,
		TextXAlignment = Enum.TextXAlignment.Right,
		Text = "0 / 0",
		Parent = panel:FindFirstChild("Header"),
	})
	Components.TextStroke(self.CapacityLabel)

	-- Tabs (left column)
	local tabs = Create("ScrollingFrame", {
		Name = "Tabs",
		Size = UDim2.new(0, 130, 1, 0),
		BackgroundTransparency = 1,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = content,
	}, {
		Create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	self.TabButtons = {}
	for index, category in ItemConfig.Categories do
		local button = Components.Button({
			Name = category.Id,
			Text = category.Icon .. " " .. category.DisplayName,
			Color = Theme.Colors.PanelAlt,
			TextColor = Theme.Colors.Text,
			Size = UDim2.new(1, -8, 0, 40),
			TextSize = Theme.TextSize.Small,
			Parent = tabs,
			OnClick = function()
				self.Category = category.Id
				self:Render()
			end,
		})
		button.LayoutOrder = index
		-- Dark text on light tabs doesn't need the white-text outline.
		for _, child in button:GetChildren() do
			if child:IsA("UIStroke") and child.ApplyStrokeMode == Enum.ApplyStrokeMode.Contextual then
				child:Destroy()
			end
		end
		self.TabButtons[category.Id] = button
	end

	-- Search + sort row
	local middle = Create("Frame", {
		Name = "Middle",
		Size = UDim2.new(1, -350, 1, 0),
		Position = UDim2.fromOffset(140, 0),
		BackgroundTransparency = 1,
		Parent = content,
	})
	local searchBox = Create("TextBox", {
		Name = "Search",
		Size = UDim2.new(1, -120, 0, 38),
		BackgroundColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "🔍 Search...",
		PlaceholderColor3 = Theme.Colors.TextMuted,
		Text = "",
		ClearTextOnFocus = false,
		Font = Theme.Fonts.Body,
		TextSize = Theme.TextSize.Medium,
		TextColor3 = Theme.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = middle,
	})
	Components.Corner(searchBox, Theme.SmallCorner)
	Components.Stroke(searchBox, Theme.Colors.Outline, 2)
	Components.Padding(searchBox, 8)
	searchBox:GetPropertyChangedSignal("Text"):Connect(function()
		self.Search = string.lower(searchBox.Text)
		self:Render()
	end)

	self.SortButton = Components.Button({
		Name = "Sort",
		Text = "Sort: Name",
		Color = Theme.Colors.Blue,
		Size = UDim2.fromOffset(110, 38),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = Theme.TextSize.Small,
		Parent = middle,
		OnClick = function()
			self.SortIndex = self.SortIndex % #SORT_MODES + 1
			self.SortButton.Text = "Sort: " .. SORT_MODES[self.SortIndex]
			self:Render()
		end,
	})

	self.Grid = Create("ScrollingFrame", {
		Name = "Grid",
		Size = UDim2.new(1, 0, 1, -48),
		Position = UDim2.fromOffset(0, 48),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		BorderSizePixel = 0,
		Parent = middle,
	}, {
		Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(84, 96),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Components.Corner(self.Grid, Theme.SmallCorner)
	Components.Padding(self.Grid, 8)

	self.EmptyLabel = Components.Label({
		Size = UDim2.new(1, -20, 0, 80),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = Theme.Colors.TextMuted,
		Text = "Nothing here yet!\nGather resources to fill your backpack.",
		Visible = false,
		Parent = middle,
	})

	-- Details (right column)
	local details = Create("Frame", {
		Name = "Details",
		Size = UDim2.new(0, 200, 1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		AnchorPoint = Vector2.new(1, 0),
		BackgroundColor3 = Theme.Colors.PanelAlt,
		Parent = content,
	})
	Components.Corner(details, Theme.SmallCorner)
	Components.Padding(details, 10)
	self.DetailIcon = Components.Label({ Size = UDim2.new(1, 0, 0, 70), TextSize = 58, Text = "", Parent = details })
	self.DetailName = Components.Label({ Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 72), TextSize = Theme.TextSize.Large, Text = "Select an item", Parent = details })
	self.DetailRarity = Components.Label({ Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 102), TextSize = Theme.TextSize.Small, Text = "", Parent = details })
	self.DetailStats = Components.Label({
		Size = UDim2.new(1, 0, 0, 60),
		Position = UDim2.fromOffset(0, 126),
		Font = Theme.Fonts.Bold,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.Text,
		Text = "",
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = details,
	})
	self.DetailDescription = Components.Label({
		Size = UDim2.new(1, 0, 0, 110),
		Position = UDim2.fromOffset(0, 190),
		Font = Theme.Fonts.Body,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Colors.TextMuted,
		Text = "",
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = details,
	})
	self.EquipButton = Components.Button({
		Name = "Equip",
		Text = "EQUIP",
		Color = Theme.Colors.Green,
		Size = UDim2.new(1, 0, 0, 44),
		Position = UDim2.new(0, 0, 1, 0),
		AnchorPoint = Vector2.new(0, 1),
		Parent = details,
		OnClick = function()
			local entry = self:_selectedEntry()
			if entry and entry.Kind == "Tool" then
				local equipped = self.State.Equipped == entry.Id
				self.Callbacks.OnEquip(if equipped then nil else entry.Id)
			end
		end,
	})
	self.EquipButton.Visible = false

	return self
end

function InventoryPanel:_selectedEntry(): Entry?
	for _, entry in self.Entries do
		if entry.Id == self.SelectedId then
			return entry
		end
	end
	return nil
end

function InventoryPanel:_buildEntries()
	local entries = {}
	for itemId, count in self.State.Items do
		local def = ItemConfig.Get(itemId)
		if def and count > 0 then
			table.insert(entries, {
				Id = itemId,
				Kind = "Item",
				Name = def.DisplayName,
				Icon = def.Icon,
				Rarity = def.Rarity,
				Category = def.Category,
				Count = count,
				Value = def.SellValue,
				Description = def.Description,
			})
		end
	end
	for toolId in self.State.OwnedTools do
		local def = ToolConfig.Get(toolId)
		if def then
			table.insert(entries, {
				Id = toolId,
				Kind = "Tool",
				Name = def.DisplayName,
				Icon = def.Icon,
				Rarity = "Common",
				Category = "Tools",
				Count = 1,
				Value = def.Price,
				Description = def.Description,
				ToolDef = def,
			})
		end
	end
	self.Entries = entries
end

function InventoryPanel:_getCard(index: number): Card
	local card = self.Cards[index]
	if card then
		return card
	end
	local button = Create("TextButton", {
		Name = "Card",
		BackgroundColor3 = Theme.Colors.Panel,
		AutoButtonColor = false,
		Text = "",
		Parent = self.Grid,
	})
	Components.Corner(button, Theme.SmallCorner)
	local stroke = Components.Stroke(button, Theme.Colors.Outline, 2.5)
	local icon = Components.Label({ Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, 4), TextSize = 38, Parent = button })
	local name = Components.Label({
		Size = UDim2.new(1, -6, 0, 18),
		Position = UDim2.new(0, 3, 1, -22),
		Font = Theme.Fonts.Bold,
		TextSize = 12,
		TextScaled = true,
		Parent = button,
	})
	local count = Components.Label({
		Size = UDim2.fromOffset(60, 18),
		Position = UDim2.new(1, -4, 0, 2),
		AnchorPoint = Vector2.new(1, 0),
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = button,
	})
	local newCard: Card = { Button = button, Icon = icon, Name = name, Count = count, Stroke = stroke }
	button.Activated:Connect(function()
		local entryId = button:GetAttribute("EntryId")
		if type(entryId) == "string" then
			self.SelectedId = entryId
			self:_renderDetails()
			self:_renderSelection()
		end
	end)
	self.Cards[index] = newCard
	return newCard
end

function InventoryPanel:_visibleEntries(): { Entry }
	local visible = {}
	for _, entry in self.Entries do
		local inCategory = self.Category == "All" or entry.Category == self.Category
		local matches = self.Search == "" or string.find(string.lower(entry.Name), self.Search, 1, true) ~= nil
		if inCategory and matches then
			table.insert(visible, entry)
		end
	end
	local mode = SORT_MODES[self.SortIndex]
	table.sort(visible, function(a, b)
		if mode == "Amount" and a.Count ~= b.Count then
			return a.Count > b.Count
		elseif mode == "Value" and a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.Name < b.Name
	end)
	return visible
end

function InventoryPanel:_renderSelection()
	for _, card in self.Cards do
		local selected = card.Button.Visible and card.Button:GetAttribute("EntryId") == self.SelectedId
		card.Stroke.Thickness = if selected then 4.5 else 2.5
		card.Button.BackgroundColor3 = if selected then Color3.fromRGB(255, 240, 190) else Theme.Colors.Panel
	end
end

function InventoryPanel:_renderDetails()
	local entry = self:_selectedEntry()
	if not entry then
		self.DetailIcon.Text = ""
		self.DetailName.Text = "Select an item"
		self.DetailRarity.Text = ""
		self.DetailStats.Text = ""
		self.DetailDescription.Text = ""
		self.EquipButton.Visible = false
		return
	end
	local rarity = RarityConfig.Get(entry.Rarity)
	self.DetailIcon.Text = entry.Icon
	self.DetailName.Text = entry.Name
	self.DetailRarity.Text = rarity.DisplayName
	self.DetailRarity.TextColor3 = rarity.Color
	self.DetailDescription.Text = entry.Description
	if entry.Kind == "Tool" and entry.ToolDef then
		local def = entry.ToolDef
		self.DetailStats.Text = ("Power %d · Speed x%.2f\nBonus %d%%"):format(def.Power, def.Speed, math.floor(def.ResourceBonus * 100))
		local equipped = self.State.Equipped == entry.Id
		self.EquipButton.Visible = true
		self.EquipButton.Text = if equipped then "UNEQUIP" else "EQUIP"
	else
		self.DetailStats.Text = ("Amount: %s\nSells for: %s 🪙 each"):format(Format.Commas(entry.Count), Format.Commas(entry.Value))
		self.EquipButton.Visible = false
	end
end

function InventoryPanel:Render()
	for id, button in self.TabButtons do
		button.BackgroundColor3 = if id == self.Category then Theme.Colors.Coins else Theme.Colors.PanelAlt
	end
	self.CapacityLabel.Text = ("%s / %s"):format(Format.Commas(self.State.Used or 0), Format.Commas(self.State.Capacity or 0))

	local visible = self:_visibleEntries()
	for index, entry in visible do
		local card = self:_getCard(index)
		local rarity = RarityConfig.Get(entry.Rarity)
		card.Button.Visible = true
		card.Button.LayoutOrder = index
		card.Button:SetAttribute("EntryId", entry.Id)
		card.Icon.Text = entry.Icon
		card.Name.Text = entry.Name
		card.Name.TextColor3 = rarity.Color:Lerp(Theme.Colors.Text, 0.45)
		card.Count.Text = if entry.Kind == "Tool" then (if self.State.Equipped == entry.Id then "✔" else "") else "x" .. Format.Abbreviate(entry.Count)
	end
	for index = #visible + 1, #self.Cards do
		self.Cards[index].Button.Visible = false
	end
	self.EmptyLabel.Visible = #visible == 0
	self:_renderSelection()
	self:_renderDetails()
end

-- state = { Items, Capacity, Used, OwnedTools, Equipped }
function InventoryPanel:SetState(state: { [string]: any })
	self.State = state
	self:_buildEntries()
	if self.Panel.Visible then
		self:Render()
	end
end

function InventoryPanel:Open()
	self.Panel.Visible = true
	self:Render()
	Components.Bounce(self.Panel, 0.06)
end

function InventoryPanel:Close()
	self.Panel.Visible = false
end

function InventoryPanel:IsOpen(): boolean
	return self.Panel.Visible
end

return InventoryPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Notifications
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/Notifications
	DEPENDENCIES: Client.UI.{Theme, Components}

	"Did that work?" feedback (spec §151/§152):
	  Toast   small message under the top bar (max 4, auto-fade)
	  Banner  big centred title for milestones (queued, one at a time)
	  Float   pooled floating text ("+25 🪙", "+3 Wood") that rises and fades
]]

local TweenService = game:GetService("TweenService")

local Theme = require(script.Parent.Theme)
local Components = require(script.Parent.Components)

local Create = Components.Create

local MAX_TOASTS = 4
local TOAST_TIME = 3
local BANNER_TIME = 2.6
local FLOAT_POOL = 12

local TOAST_STYLES = {
	Toast = { Background = Theme.Colors.Panel, Text = Theme.Colors.Text },
	Success = { Background = Theme.Colors.Green, Text = Theme.Colors.TextLight },
	Error = { Background = Theme.Colors.Red, Text = Theme.Colors.TextLight },
}

local BANNER_COLORS = {
	LevelUp = Theme.Colors.Level,
	IslandLevelUp = Theme.Colors.Coins,
	AreaUnlock = Theme.Colors.Blue,
	Reward = Theme.Colors.Orange,
	Build = Theme.Colors.Green,
	Error = Theme.Colors.Red,
}

local Notifications = {}
Notifications.__index = Notifications

function Notifications.new(parent: Instance)
	local self = setmetatable({}, Notifications)

	self.ToastContainer = Create("Frame", {
		Name = "Toasts",
		Size = UDim2.fromOffset(460, 220),
		Position = UDim2.new(0.5, 0, 0, 78),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 1,
		Parent = parent,
	}, {
		Create("UIListLayout", {
			Padding = UDim.new(0, 6),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})

	self.Banner = Create("CanvasGroup", {
		Name = "Banner",
		Size = UDim2.fromOffset(760, 140),
		Position = UDim2.fromScale(0.5, 0.3),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Visible = false,
		Parent = parent,
	})
	self.BannerScale = Create("UIScale", { Parent = self.Banner })
	self.BannerTitle = Components.Label({
		Name = "Title",
		Size = UDim2.new(1, 0, 0, 80),
		TextSize = Theme.TextSize.Huge + 12,
		TextColor3 = Theme.Colors.Coins,
		TextWrapped = false,
		Parent = self.Banner,
	})
	Components.TextStroke(self.BannerTitle, Theme.Colors.Outline, 4)
	self.BannerSubtitle = Components.Label({
		Name = "Subtitle",
		Size = UDim2.new(1, 0, 0, 50),
		Position = UDim2.fromOffset(0, 82),
		TextSize = Theme.TextSize.Large,
		TextColor3 = Theme.Colors.TextLight,
		Parent = self.Banner,
	})
	Components.TextStroke(self.BannerSubtitle, Theme.Colors.Outline, 2.5)
	self.BannerQueue = {}
	self.BannerBusy = false

	self.FloatLayer = Create("Frame", {
		Name = "Floats",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	self.Floats = {}
	for index = 1, FLOAT_POOL do
		local label = Components.Label({
			Name = "Float" .. index,
			Size = UDim2.fromOffset(260, 40),
			AnchorPoint = Vector2.new(0.5, 0.5),
			TextSize = Theme.TextSize.Large + 4,
			TextWrapped = false,
			Visible = false,
			Parent = self.FloatLayer,
		})
		Components.TextStroke(label, Theme.Colors.Outline, 2.5)
		table.insert(self.Floats, label)
	end
	self.NextFloat = 1
	self.ToastCount = 0

	return self
end

function Notifications:Toast(kind: string, text: string, icon: string?)
	local style = TOAST_STYLES[kind] or TOAST_STYLES.Toast
	local toasts = self.ToastContainer:GetChildren()
	local existing = {}
	for _, child in toasts do
		if child:IsA("CanvasGroup") then
			table.insert(existing, child)
		end
	end
	if #existing >= MAX_TOASTS then
		table.sort(existing, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		existing[1]:Destroy()
	end

	self.ToastCount += 1
	local toast = Create("CanvasGroup", {
		Size = UDim2.fromOffset(440, 44),
		BackgroundColor3 = style.Background,
		GroupTransparency = 1,
		LayoutOrder = self.ToastCount,
		Parent = self.ToastContainer,
	})
	Components.Corner(toast, UDim.new(1, 0))
	Components.Stroke(toast, Theme.Colors.Outline, 2.5)
	local label = Components.Label({
		Text = if icon then icon .. "  " .. text else text,
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		TextColor3 = style.Text,
		TextSize = Theme.TextSize.Medium,
		TextScaled = true,
		Parent = toast,
	})
	Create("UITextSizeConstraint", { MaxTextSize = Theme.TextSize.Medium, Parent = label })

	TweenService:Create(toast, TweenInfo.new(0.2), { GroupTransparency = 0 }):Play()
	task.delay(TOAST_TIME, function()
		if toast.Parent then
			local fade = TweenService:Create(toast, TweenInfo.new(0.35), { GroupTransparency = 1 })
			fade:Play()
			fade.Completed:Wait()
			toast:Destroy()
		end
	end)
end

function Notifications:_showNextBanner()
	local nextBanner = table.remove(self.BannerQueue, 1)
	if not nextBanner then
		self.BannerBusy = false
		return
	end
	self.BannerBusy = true
	self.BannerTitle.Text = nextBanner.Title
	self.BannerTitle.TextColor3 = BANNER_COLORS[nextBanner.Style] or Theme.Colors.Coins
	self.BannerSubtitle.Text = nextBanner.Subtitle or ""
	self.Banner.Visible = true
	self.Banner.GroupTransparency = 1
	self.BannerScale.Scale = 0.6
	TweenService:Create(self.Banner, TweenInfo.new(0.25), { GroupTransparency = 0 }):Play()
	TweenService:Create(self.BannerScale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(BANNER_TIME, function()
		local fade = TweenService:Create(self.Banner, TweenInfo.new(0.35), { GroupTransparency = 1 })
		fade:Play()
		fade.Completed:Wait()
		self.Banner.Visible = false
		self:_showNextBanner()
	end)
end

function Notifications:Banner(title: string, subtitle: string?, style: string?)
	table.insert(self.BannerQueue, { Title = title, Subtitle = subtitle, Style = style })
	if not self.BannerBusy then
		self:_showNextBanner()
	end
end

-- Floating text at a screen position (UDim2 inside the float layer).
function Notifications:Float(text: string, color: Color3, position: UDim2, rise: number?)
	local label = self.Floats[self.NextFloat]
	self.NextFloat = self.NextFloat % FLOAT_POOL + 1
	label.Text = text
	label.TextColor3 = color
	label.Position = position
	label.TextTransparency = 0
	label.Visible = true
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Transparency = 0
	end
	local target = position - UDim2.fromOffset(0, rise or 60)
	local info = TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(label, info, { Position = target, TextTransparency = 1 }):Play()
	if stroke then
		TweenService:Create(stroke, info, { Transparency = 1 }):Play()
	end
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	SCRIPT NAME:  Theme
	SCRIPT TYPE:  ModuleScript (client UI)
	WHERE:        StarterPlayerScripts/Client/UI/Theme
	DEPENDENCIES: none

	The single source of UI colours, fonts and sizes: bright, friendly,
	kid-readable (cream panels, chunky brown outlines, saturated accents).
]]

local Theme = {}

Theme.Colors = {
	Panel = Color3.fromRGB(255, 249, 236),
	PanelAlt = Color3.fromRGB(246, 233, 208),
	PanelDark = Color3.fromRGB(226, 208, 176),
	Outline = Color3.fromRGB(74, 52, 34),
	Text = Color3.fromRGB(66, 45, 28),
	TextMuted = Color3.fromRGB(140, 112, 85),
	TextLight = Color3.fromRGB(255, 255, 255),
	Coins = Color3.fromRGB(255, 196, 40),
	Gems = Color3.fromRGB(80, 200, 255),
	Level = Color3.fromRGB(110, 205, 85),
	Blue = Color3.fromRGB(70, 160, 255),
	Green = Color3.fromRGB(85, 195, 90),
	Red = Color3.fromRGB(235, 85, 85),
	Orange = Color3.fromRGB(255, 150, 60),
	Purple = Color3.fromRGB(165, 110, 255),
	Shadow = Color3.fromRGB(0, 0, 0),
}

Theme.Fonts = {
	Title = Enum.Font.FredokaOne,
	Body = Enum.Font.GothamMedium,
	Bold = Enum.Font.GothamBold,
}

Theme.Corner = UDim.new(0, 14)
Theme.SmallCorner = UDim.new(0, 10)
Theme.StrokeThickness = 3

Theme.TextSize = {
	Huge = 44,
	Title = 26,
	Large = 22,
	Medium = 18,
	Small = 15,
}

-- Design resolution: the whole UI is built at this size and scaled by UIScale.
Theme.DesignSize = Vector2.new(1280, 720)

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
